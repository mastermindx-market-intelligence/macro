+    def _expiry_policy(self, spec, model, task_class):
+        """The account owner supplies a qualified hard claim ceiling, not an estimate."""
+        policy = spec.get("expiry_admission")
+        if policy is None:
+            return None
+        fields = {"schema", "required_windows", "reserve_units", "reserved_slots", "urgent_classes", "claims"}
+        if (type(policy) is not dict or set(policy) != fields
+                or policy["schema"] != "mastermind.expiry_account_admission.v1"):
+            raise ValueError("account_policy_invalid")
+        required = policy["required_windows"]
+        if (type(required) is not list or not 1 <= len(required) <= 8
+                or any(not isinstance(k, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}", k) for k in required)
+                or len(set(required)) != len(required)):
+            raise ValueError("account_policy_invalid")
+        reserve = policy["reserve_units"]
+        if (type(reserve) is not dict or set(reserve) != set(required)
+                or any(type(v) is not int or not 0 <= v <= 2**63-1 for v in reserve.values())
+                or type(policy["reserved_slots"]) is not int or not 0 <= policy["reserved_slots"] <= 4096):
+            raise ValueError("account_policy_invalid")
+        urgent = policy["urgent_classes"]
+        if (type(urgent) is not list or len(urgent) > 16 or len(set(urgent)) != len(urgent)
+                or any(not isinstance(k, str) or not re.fullmatch(r"[a-z][a-z0-9_-]{0,63}", k) for k in urgent)):
+            raise ValueError("account_policy_invalid")
+        claim = policy["claims"][model][task_class]
+        if (type(claim) is not dict or set(claim) != {"budget_ref", "units"}
+                or not isinstance(claim["budget_ref"], str) or not 1 <= len(claim["budget_ref"]) <= 256
+                or any(ord(c) < 33 or ord(c) > 126 for c in claim["budget_ref"])
+                or type(claim["units"]) is not dict or set(claim["units"]) != set(required)):
+            raise ValueError("account_claim_budget_unqualified")
