+  selections[kind+':'+value] = snapshot();
+}
+IOS.filter = {};
+click(initial.chips.output_class.null,'null');
+click(initial.chips.output_class.null,'null');
+const cleared = snapshot();
+IOS.filter = {};
+click(initial.chips.output_class.ranking,'ranking');
+click(initial.chips.authority.display,'display');
