+/* Native browse controls: one compact desk, keyboard/touch parity in both themes. */
+.shelf summary.dp-desk-summary{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:4px 12px}
+.dp-desk-summary .si{grid-column:1;grid-row:1 / span 2}
+.dp-desk-summary .dp-desk-title{grid-column:2;min-width:0}
+.shelf summary.dp-desk-summary .sh{grid-column:2;grid-row:2;margin-left:0}
+.dp-desk-summary .sc{grid-column:3;grid-row:1 / span 2}
+.presets-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}
+.presets-row .chip.preset{min-height:40px;white-space:normal;text-align:center;justify-content:center;padding:6px 8px;font:inherit;font-size:12px;line-height:1.3;touch-action:manipulation}
+.presets-row .chip.preset.active{color:var(--ink);background:var(--panel2);border-color:var(--dpb);font-weight:700}
+.filters-row{display:grid;grid-template-columns:minmax(120px,1.2fr) minmax(100px,.8fr) repeat(2,minmax(145px,1fr)) auto auto;align-items:end}
+.dp-filter{display:flex;flex-direction:column;gap:4px;min-width:0}
+.dp-filter label{font-size:11px;font-weight:600;color:var(--muted)}
+.dp-filter .dp-input,.dp-filter .dp-select{width:100%;min-width:0;min-height:40px}
+.filters-row .clear-btn,.filters-row .export-btn{min-height:40px;touch-action:manipulation}
+.dp-sort{border:0;padding:4px 0;min-height:40px;background:transparent;color:inherit;font:inherit;letter-spacing:inherit;text-transform:inherit;cursor:pointer;touch-action:manipulation}
+#dp-table th[data-col]{cursor:default}
+/* Keep the stock identity visible while browsing the wide data table. */
+#dp-table th:first-child,#dp-table tr:not(.dp-empty)>td:first-child{position:sticky;left:0;z-index:1;background:var(--panel);box-shadow:1px 0 0 var(--line)}
+#dp-table th:first-child{z-index:2}
+#dp-table tr:not(.dp-empty):hover>td:first-child{background:var(--panel2)}
+.presets-row .preset:focus-visible,.filters-row :is(input,select,button):focus-visible,#dp-table .dp-sort:focus-visible,.dp-desk-summary:focus-visible{outline:2px solid currentColor;outline-offset:2px}
+#dp-table .dp-empty td{text-align:left;padding:16px 8px;font-weight:400;white-space:normal;color:var(--muted)}
+@media(max-width:820px){.filters-row{grid-template-columns:repeat(2,minmax(0,1fr))}}
+@media(max-width:600px){.presets-row{grid-template-columns:repeat(2,minmax(0,1fr))}}
