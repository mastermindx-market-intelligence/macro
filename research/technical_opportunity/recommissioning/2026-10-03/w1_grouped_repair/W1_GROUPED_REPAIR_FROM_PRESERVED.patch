+# Grouped repair regression coverage. These are metadata/source checks only.
+@pytest.mark.parametrize("extra_first", [False, True])
+def test_equivalence_first_class_cardinality_has_its_own_guard(extra_first):
+    ids, aliases = equiv._methods()
+    payload = json.loads(equiv.EQUIV.read_text(encoding="utf-8"))
+    bad = copy.deepcopy(payload)
+    if extra_first:
+        copied = copy.deepcopy(bad["classes"][0]["members"][0])
+        bad["classes"][1]["members"].append(copied)
+    else:
+        for member in bad["classes"][0]["members"]:
+            if member["relationship"] == "first_class":
+                member["relationship"] = "subtype"
