+    assert represented == {r["method_id"] for r in rows if r["local_implementation"]["status"] in {"exact", "partial"}}
+    for priority in ["P0", "P1", "P2", "archive"]:
+        counts = Counter(r["local_implementation"]["status"] for r in rows if r["research_priority"] == priority)
+        for status, count in counts.items():
+            assert summary[priority.lower()+"_"+status+"_local"] == count
+    assert not summary["outcomes_read"] and not summary["model_fit"] and not summary["trade_authority"]
