+    def _account_source_scope(self):
+        """Original broker lock -> nonblocking native publication lock -> SQLite.
+
+        Never wait for publication while holding the broker lock. Legacy offline
+        fixtures may exercise non-strict admission without claiming atomicity.
+        Installed/external-gated or strict claims require the original topology.
+        Existing result recovery, settlement and release do not enter this scope.
+        """
+        import quota_remote
+        document = _read_accounts_document(self.accounts_path)
+        strict = any(isinstance(spec, dict) and "expiry_admission" in spec
+                     for spec in document.get("providers", {}).values())
+        if not self.external_gates and not strict:
+            yield None
+            return
+        from pathlib import Path
+        stable = Path(os.path.realpath(quota_remote.CACHE_PATH)).parent
+        if (Path(os.path.realpath(self.lock_path)).parent != stable / "broker"
+                or Path(os.path.realpath(self.db_path)).parent != stable / "broker"
+                or Path(os.path.realpath(self.accounts_path)).parent != stable.parent / "orch" / "fabric"):
+            raise AccountPublicationUnavailable("account_publication_topology_unqualified")
+        manager = quota_remote.quota_publication_scope(require_native=True)
+        try:
+            scope = manager.__enter__()
+        except quota_remote.QuotaPublicationUnavailable as exc:
+            reason = "account_publication_busy" if "busy" in str(exc) else "account_publication_unqualified"
+            raise AccountPublicationUnavailable(reason) from None
+        token = _ACCOUNT_SOURCE_GUARD.set(scope)
+        try:
+            yield scope
+        finally:
+            _ACCOUNT_SOURCE_GUARD.reset(token)
+            manager.__exit__(*sys.exc_info())
