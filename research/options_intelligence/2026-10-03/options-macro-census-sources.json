  "findings": [
    {
      "id": "collector_provenance",
      "level": "source_observed",
      "summary": "Real trade_quote/bulk_trade_quote retain both source clocks and raw conditions/venues/sizes; old lossy helper is not the inspected poller call path."
    },
    {
      "id": "greek_provenance",
      "level": "source_observed",
      "summary": "EOD Greek time normalizes to date; underlying timestamp and model/rate/TTE/unit-version metadata are absent from output projection."
    },
    {
      "id": "receipt_boundary",
      "level": "source_observed",
      "summary": "Poller observation time is assigned after fetch-future completion; it is a root-payload receipt, not per-print SIP or exchange time."
    },
    {
      "id": "resolver",
      "level": "source_observed",
      "summary": "Provably empty stores rejected; unreadability resolves as unknown with warning; directory presence is not data health."
    },
    {
      "id": "sign_measurement_split",
      "level": "source_observed",
      "summary": "Measured NBBO excludes future/locked/crossed quotes and keeps presign denominator; soft signing checks bid>0 ask>=bid without quote-time or condition policy."
    },
    {
      "id": "sequence_policy",
      "level": "static_inference",
      "summary": "Per-contract max-sequence watermark does not implement an amendment ledger and has no explicit same-batch identity dedup in inspected block."
    },
    {
      "id": "chain_heat_proxy",
      "level": "source_observed",
      "summary": "Missing ask_share is reconstructed from side as .8/.2/.5; not literal at_ask_share."
    },
    {
      "id": "prophet_gex_boundary",
      "level": "source_observed",
      "summary": "Committed stock_score GEX gate false does not govern separate US Prophet F5 fusion registration/admission; nightly influence unproved."
    },
    {
      "id": "ad1",
      "level": "source_observed",
      "summary": "Producer hard-disables GEX; directional classifier is Q_oi/Q_skew+salience heuristic; no Q_flow implementation."
    },
    {
      "id": "candidate_extension",
      "level": "source_observed",
      "summary": "Head-pinned inactive candidate schema has no options_context slot, additionalProperties=false, 15 false authority flags; existing outcome stores/schemas preserve null option P&L."
    }
