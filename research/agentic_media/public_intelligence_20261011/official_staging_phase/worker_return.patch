+def _emit_snapshot(root: Path) -> dict:
+    def _digest(path: Path) -> str:
+        return hashlib.sha256(path.read_bytes()).hexdigest() if path.exists() else ""
+    return {
+        "tree": _snapshot(root),
+        "ledger": _digest(root / "data/press/published.jsonl"),
+    }
