+def _stage(candidate: dict, monkeypatch=None, **kw) -> dict:
+    if monkeypatch is not None:
+        monkeypatch.delenv("PRESS_RUN_TOKEN_BUDGET", raising=False)
+        monkeypatch.delenv("PRESS_CIRCUIT_BREAKER_FAILURES", raising=False)
