+def test_doj_historical_issuer_context_keeps_external_tier_and_source_vintage(doj_inputs):
+    from tests.test_press_issuer_baseline import baseline_inputs
+    b = baseline_inputs(doj_inputs['root'])
+    change(doj_inputs, lambda q: q.update(issuer_baseline_context=b['review']))
+    r = invoke(doj_inputs)
+    facts = r['validation_context']['facts']
+    assert len(facts) == 12 and all(f['tier'] == 'third_party' for f in facts)
+    assert len(r['source_revisions']) == 9
+    assert all(f['dated'] == '2025-12-31' for f in facts if f.get('id','').startswith('issuer_'))
+    assert r['allow_stage'] is r['allow_emit'] is False
+
+
+def test_doj_baseline_cannot_supply_first_party_writer_admission(doj_inputs, monkeypatch):
+    from tests.test_press_issuer_baseline import baseline_inputs
+    from scripts.stage_official_feed_press import stage_official_feed_candidate
+    from engine.press import desk_planner as P
+    from engine.press import writer
+    from datetime import datetime, timezone
+    b = baseline_inputs(doj_inputs['root'])
+    change(doj_inputs, lambda q: q.update(issuer_baseline_context=b['review']))
+    before = {str(p): p.read_bytes() for p in doj_inputs['root'].rglob('*') if p.is_file()}
+    def forbidden(*a, **kw): raise AssertionError('provider must never be called')
+    monkeypatch.setattr(writer, 'write', forbidden)
+    args = {k:v for k,v in doj_inputs.items() if k not in ('as_of', 'root')}
+    result = stage_official_feed_candidate(doj_inputs['root'], P.load_config(doj_inputs['root']), **args, now=datetime(2026,10,14,4,tzinfo=timezone.utc))
+    assert result['staged'] is False and result['public_article_approved'] is False
+    assert 'first-party' in str(result)
+    assert before == {str(p): p.read_bytes() for p in doj_inputs['root'].rglob('*') if p.is_file()}
+
+
+def test_occ_does_not_gain_a_new_retry_route_through_issuer_context(inputs):
+    from tests.test_press_issuer_baseline import baseline_inputs
+    b = baseline_inputs(inputs['root'])
+    change(inputs, lambda q: q.update(issuer_baseline_context=b['review']))
+    with pytest.raises(ValueError): invoke(inputs)
