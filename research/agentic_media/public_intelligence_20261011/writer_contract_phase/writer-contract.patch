+    # Mirrors validators.check_our_value's own default for an absent floor.
+    floor = float(v.get("our_value_min") or 0.40)
+    return (
+        _HOUSE_STYLE_HEAD.format(floor_pct=_pct_text(floor))
+        + "\n" + "\n".join(_banned_language_lines(cfg))
+        + "\n" + _HOUSE_STYLE_TAIL
+    )
