 "provenance": {
  "census_version": "v7",
  "command": "python3 research/prophet_v4/entry_timing_w2_t1_census.py --receipt-sessions <W1 r3 receipt map> --commit-walk --document-walk --server-arrival --k 10 --buffer-minutes 30 --r-from 2026-08-26 --r-to 2026-10-23",
  "receipt_sessions_source": "turn_watch_receipt_sessions(data_root, git_ref='origin/main') from scripts/report_us_candidate_episode_waterfall.py at PR #10277 head d03acfd075d9 (54 receipts); re-derived at freeze, never hand-edited",
  "lane_state": "first-parent ARRIVAL on origin/main pinned at a7eef2ce9737 (resolved once at start-up and passed to every git read of both walks) (156 commits of the four monthly candidates parquets 2026-07..10): the first blob carrying each stamp_date fixes its BUY rows, curated coverage and signal_asof; a later blob that changes that date's BUY set is a HEAL and the session is a GAP (09-14 +50 BUY rows healed 09-16; 10-19 +104 healed 10-21); HEAD never read for lane state; HEAD disagreement reported (154 BUY rows exist only in the two heals)",
  "identity_join": "security-first: candidate symbols from the membership alias records, EVERY candidate confirmed by VendorAliasTable.resolve('membership', symbol, on=session) == security_id, tested on every healthy window session for every unit (uniform span); alias parquet sha256 pinned",
  "columns_read": "candidates: stamp_date, ticker, tier, lane, eligible, buyable, featured, signal_asof; OPENED episode_id/source_receipt/recorded_at/payload.{ticker_at_observation,opened_session,security_id,identity_epoch}; turn_watch documents (digest-verified) for receipt and commit time; data/reference/vendor_aliases.parquet; data/yahoo/SPY.parquet DATE INDEX only",
  "outcome_columns_read": "none",
  "generated": "2026-10-31",
  "knowable_session": "first NYSE session whose 16:00 ET close is strictly after the first-parent arrival instant + 30 min; applied per stamp_date (BUY arm) and per receipt (discovery arm); T1 is executable inside K only when k(c_cur) <= t_disc + K",
