{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/news_impact/transfer_edge.v1.schema.json",
  "title": "Transfer edge v1 \u2014 one-hop issuer transfer with abstention default",
  "description": "One-hop issuer transfer of a validated source fact to a second issuer. An emitted transfer_edge.v1 requires a cited two-party source_span.v1 naming both issuers, Graph-1 provenance, hop_count=1, and prophet_flags all false. Abstention is the default (transfer_absence.v1). Macro shocks are analysed once as macro_shock_fanout.v1 and fanned by documented exposure. Output is context_only and never authorizes a trade, size, entry or rank.",
  "oneOf": [
    {
      "$ref": "#/$defs/transfer_edge.v1"
    },
    {
      "$ref": "#/$defs/transfer_absence.v1"
    },
    {
      "$ref": "#/$defs/macro_shock_fanout.v1"
    }
  ],
  "$defs": {
    "text_safe": {
      "type": "string",
      "not": {
        "anyOf": [
          {
            "pattern": "(?i)\\b(ignore|disregard|forget|override)\\s+(all\\s+|any\\s+|the\\s+|every\\s+)?(previous|prior|above|preceding|earlier)\\b"
          },
          {
            "pattern": "(?i)(^|[\\n\\r>\\\"'\\]\\[}{|])\\s*(system|assistant|developer|user|tool|function)\\s*[:\uff1a]"
          },
          {
            "pattern": "(?i)system\\s*prompt"
          },
          {
            "pattern": "(?i)\\b(https?|ftps?|wss?|file|javascript|vbscript|gopher|hxxps?|hxtp)\\s*:"
          },
          {
            "pattern": "(?i)^\\s*(?=^[^_\\s]*$)(www\\.)?[a-z0-9][a-z0-9\\-]*(\\.[a-z0-9][a-z0-9\\-]*)*\\.[a-z]{2,4}(:\\d+)?(/[^\\s]*)?\\s*$"
          },
          {
            "pattern": "(?i)(~\\/\\.|/(etc|usr|bin|sbin|tmp|var|root|home|opt|dev|proc|lib)\\b|\\$\\(|`|\\brm\\s+-rf\\b|\\bcurl\\b|\\bwget\\b|\\bchmod\\b|\\bbash\\s+-c\\b|\\bsh\\s+-c\\b|\\bpowershell\\b|\\bnc\\s+-e\\b|\\|\\s*sh\\b)"
          },
          {
            "pattern": "[A-Za-z0-9+/=]{40,}"
          },
          {
            "pattern": "(!\\[|\\]\\(\\s*[a-z0-9.])"
          },
          {
            "pattern": "[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f\u200b-\u200f\u202a-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb]"
          },
          {
            "pattern": "(?i)(<\\||\\[/?inst\\]|<<\\s*sys\\s*>>|<\\s*/?\\s*system\\s*>|###\\s*(system|assistant|instruction|user)\\b)"
          },
          {
            "pattern": "(?i)\\b(switch|swap|route|redirect)\\s+(to\\s+)?(the\\s+)?(provider|model|llm|api|endpoint|engine)\\b|\\buse\\s+(the\\s+|another\\s+)?(provider|model|llm)\\s+\\S+\\s+(instead|exclusively)\\b|\\binstead\\s+(use|call|switch|route)\\b|\\buse\\s+(the\\s+|another\\s+)?(provider|model|llm)\\b(?:\\s+\\S+){0,3}\\s+(this|extraction|task|instead|only)\\b"
          },
          {
            "pattern": "(?i)(new|updated|revised|obey)\\s+(the\\s+)?(instructions?|directives?|commands?)\\b|\\byou\\s+are\\s+now\\b|\\brespond\\s+(with|only)\\b|\\bdo\\s+not\\s+tell\\b|\\bkeep\\s+(this|it)\\s+(secret|confidential)\\b|exfiltrat|\\bwebhook\\b|\\bapi[_ ]?key\\b|\\bsecret\\s+key\\b|\\bbearer\\s+[a-z0-9._\\-]{8,}\\b|\\bset\\s+(may_rank|may_size|may_gate|prophet_authority)\\b|\\bmaster\\s+prompt\\b|\\b(reveal|print|dump|repeat|output)\\s+(the\\s+)?(master\\s+|system\\s+)?prompt\\b"
          },
          {
            "pattern": "(?i)[s\u0455]ystem\\s*[:\uff1a]|[a\u0430]ssistant\\s*[:\uff1a]"
          }
        ]
      }
    },
    "company_id": {
      "type": "string",
      "minLength": 14,
      "maxLength": 14,
      "pattern": "^cik:(?!0{10}$)[0-9]{10}$"
    },
    "locator_text_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sub_kind",
        "segment_index",
        "span_start_byte",
        "span_end_byte"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "text_span"
        },
        "sub_kind": {
          "$ref": "#/$defs/text_safe",
          "minLength": 1,
          "maxLength": 64
        },
        "segment_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "span_start_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000000
        },
        "span_end_byte": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000000
        },
        "chapter": {
          "$ref": "#/$defs/text_safe",
          "minLength": 1,
          "maxLength": 64
        },
        "speaker": {
          "$ref": "#/$defs/text_safe",
          "minLength": 1,
          "maxLength": 64
        },
        "role": {
          "$ref": "#/$defs/text_safe",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "locator_table_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "table_cell"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "table": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "$ref": "#/$defs/text_safe",
              "minLength": 1,
              "maxLength": 32
            }
          ]
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "cell_ref": {
          "$ref": "#/$defs/text_safe",
          "minLength": 1,
          "maxLength": 32
        },
        "note": {
          "$ref": "#/$defs/text_safe",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "locator_slide_region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "slide_region"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "region": {
          "$ref": "#/$defs/text_safe",
          "minLength": 1,
          "maxLength": 64
        },
        "note": {
          "$ref": "#/$defs/text_safe",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "segment_index",
        "segment_sha256",
        "segment_bytes",
        "span_start_byte",
        "span_end_byte",
        "text_sha256"
      ],
      "properties": {
        "source_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "segment_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "segment_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "segment_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000000
        },
        "span_start_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000000
        },
        "span_end_byte": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000000
        },
        "text_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source_span_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authority",
        "span_id",
        "document_id",
        "document_version",
        "locator",
        "text_sha256",
        "display_excerpt",
        "rights_profile",
        "receipt_state",
        "receipt",
        "unreplayable_reason"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "const": "source_span.v1"
        },
        "authority": {
          "type": "string",
          "const": "context_only"
        },
        "span_id": {
          "$ref": "#/$defs/text_safe",
          "minLength": 1,
          "maxLength": 128
        },
        "document_id": {
          "$ref": "#/$defs/text_safe",
          "minLength": 1,
          "maxLength": 128
        },
        "document_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "locator": {
          "oneOf": [
            {
              "$ref": "#/$defs/locator_text_span"
            },
            {
              "$ref": "#/$defs/locator_table_cell"
            },
            {
              "$ref": "#/$defs/locator_slide_region"
            }
          ]
        },
        "text_sha256": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "display_excerpt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text_safe"
            }
          ],
          "maxLength": 500
        },
        "rights_profile": {
          "$ref": "#/$defs/text_safe",
          "minLength": 1,
          "maxLength": 64
        },
        "receipt_state": {
          "type": "string",
          "enum": [
            "byte_replayed",
            "address_only"
          ]
        },
        "receipt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/receipt"
            }
          ]
        },
        "unreplayable_reason": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text_safe"
            }
          ],
          "maxLength": 240
        }
      },
      "if": {
        "properties": {
          "receipt_state": {
            "const": "byte_replayed"
          }
        },
        "required": [
          "receipt_state"
        ]
      },
      "then": {
        "properties": {
          "receipt": {
            "$ref": "#/$defs/receipt"
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "unreplayable_reason": {
            "type": "null"
          }
        },
        "required": [
          "receipt",
          "text_sha256"
        ]
      },
      "else": {
        "properties": {
          "receipt": {
            "type": "null"
          },
          "text_sha256": {
            "type": "null"
          },
          "unreplayable_reason": {
            "$ref": "#/$defs/text_safe",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "unreplayable_reason"
        ]
      }
    },
    "field_absence.v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authority",
        "reason",
        "subject",
        "detail",
        "missing_fields"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "const": "field_absence.v1"
        },
        "authority": {
          "type": "string",
          "const": "context_only"
        },
        "reason": {
          "type": "string",
          "maxLength": 32,
          "enum": [
            "not_stated",
            "stated_without_number",
            "range_only",
            "redacted_rights",
            "parse_failed"
          ]
        },
        "owner_reason": {
          "type": "string",
          "maxLength": 48,
          "enum": [
            "no_source_document",
            "no_transcript",
            "no_primary_release",
            "no_span_addressable_evidence",
            "document_bytes_not_held",
            "scanned_image_no_text_layer",
            "unjoinable_filing_identity",
            "speaker_unresolvable",
            "slide_family_discontinued",
            "superseded_by_duplicate",
            "missing_basis",
            "missing_units",
            "unit_mismatch",
            "cross_check_conflict",
            "missing_period",
            "missing_source"
          ]
        },
        "subject": {
          "$ref": "#/$defs/text_safe",
          "minLength": 1,
          "maxLength": 64
        },
        "detail": {
          "$ref": "#/$defs/text_safe",
          "maxLength": 240
        },
        "missing_fields": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/text_safe",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "owner_typed_absence_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authority",
        "reason",
        "subject",
        "detail",
        "missing_fields",
        "event_id",
        "document_id"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "const": "typed_absence.v1"
        },
        "authority": {
          "type": "string",
          "const": "context_only"
        },
        "reason": {
          "type": "string",
          "maxLength": 48,
          "enum": [
            "no_source_document",
            "no_transcript",
            "no_primary_release",
            "no_span_addressable_evidence",
            "document_bytes_not_held",
            "scanned_image_no_text_layer",
            "unjoinable_filing_identity",
            "speaker_unresolvable",
            "slide_family_discontinued",
            "superseded_by_duplicate",
            "missing_basis",
            "missing_units",
            "unit_mismatch",
            "cross_check_conflict",
            "missing_period",
            "missing_source"
          ]
        },
        "subject": {
          "$ref": "#/$defs/text_safe",
          "minLength": 1,
          "maxLength": 64
        },
        "detail": {
          "$ref": "#/$defs/text_safe",
          "maxLength": 240
        },
        "missing_fields": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/text_safe",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "event_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text_safe",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        },
        "document_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text_safe",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        }
      }
    },
    "absence_union": {
      "oneOf": [
        {
          "$ref": "#/$defs/field_absence.v1"
        },
        {
          "$ref": "#/$defs/owner_typed_absence_v1"
        }
      ]
    },
    "evidence_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimed_quote",
        "span"
      ],
      "properties": {
        "claimed_quote": {
          "$ref": "#/$defs/text_safe",
          "minLength": 1,
          "maxLength": 500
        },
        "span": {
          "$ref": "#/$defs/source_span_v1"
        }
      }
    },
    "evidence_absence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimed_quote",
        "absence"
      ],
      "properties": {
        "claimed_quote": {
          "$ref": "#/$defs/text_safe",
          "minLength": 1,
          "maxLength": 500
        },
        "absence": {
          "$ref": "#/$defs/field_absence.v1"
        }
      }
    },
    "evidence": {
      "oneOf": [
        {
          "$ref": "#/$defs/evidence_span"
        },
        {
          "$ref": "#/$defs/evidence_absence"
        }
      ]
    },
    "prophet_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_rank",
        "may_size",
        "may_gate",
        "prophet_authority"
      ],
      "properties": {
        "may_rank": {
          "const": false
        },
        "may_size": {
          "const": false
        },
        "may_gate": {
          "const": false
        },
        "prophet_authority": {
          "const": false
        }
      }
    },
    "channel_hint": {
      "type": "string",
      "maxLength": 40,
      "enum": [
        "revenue_demand",
        "margin_cost",
        "capital_allocation",
        "moat_duration",
        "strategic_option",
        "financial_incentives_survival",
        "market_only"
      ]
    },
    "fiscal_period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "quarter",
        "calendar_end",
        "period_kind"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100
        },
        "quarter": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            1,
            2,
            3,
            4,
            null
          ]
        },
        "calendar_end": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "period_kind": {
          "type": "string",
          "maxLength": 16,
          "enum": [
            "quarter",
            "half_year",
            "nine_months",
            "fiscal_year",
            "multi_year"
          ]
        },
        "end_year": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100
        }
      },
      "if": {
        "properties": {
          "period_kind": {
            "const": "quarter"
          }
        },
        "required": [
          "period_kind"
        ]
      },
      "then": {
        "properties": {
          "quarter": {
            "enum": [
              1,
              2,
              3,
              4
            ]
          }
        },
        "required": [
          "quarter"
        ]
      },
      "else": {
        "properties": {
          "quarter": {
            "type": "null"
          }
        }
      }
    },
    "transfer_id": {
      "type": "string",
      "minLength": 29,
      "maxLength": 29,
      "pattern": "^xfer_[0-9a-f]{24}$"
    },
    "fact_id": {
      "type": "string",
      "minLength": 29,
      "maxLength": 29,
      "pattern": "^fact_[0-9a-f]{24}$"
    },
    "shock_id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^shock_[0-9a-f]{24}$"
    },
    "iso_datetime": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "target_role": {
      "type": "string",
      "maxLength": 16,
      "enum": [
        "customer",
        "supplier",
        "competitor",
        "partner"
      ]
    },
    "operating_effect_on_target": {
      "type": "string",
      "maxLength": 16,
      "enum": [
        "positive",
        "negative",
        "mixed",
        "unknown"
      ]
    },
    "edge_direction": {
      "type": "string",
      "maxLength": 24,
      "enum": [
        "source_to_target",
        "target_to_source"
      ]
    },
    "graph_name": {
      "type": "string",
      "maxLength": 32,
      "enum": [
        "economic_relationship",
        "fundamental_comparability",
        "residual_market"
      ]
    },
    "generator_kind": {
      "type": "string",
      "maxLength": 40,
      "enum": [
        "source_span_two_party",
        "gmi_member_of",
        "gmi_supplies_reserved",
        "gmi_expresses",
        "gmi_tracks",
        "group_reads_basket",
        "group_linked_outsiders",
        "demand_chain_hardcoded",
        "gics_peer",
        "residual_comovement",
        "tagged_ticker_list",
        "shock_exposure_roster"
      ]
    },
    "abstention_reason": {
      "type": "string",
      "maxLength": 48,
      "enum": [
        "no_two_party_span",
        "span_names_one_party_only",
        "target_identity_unresolved",
        "source_equals_target",
        "hop_exceeds_one",
        "cycle_on_source_fact",
        "graph2_membership_only",
        "graph3_residual_only",
        "participation_only_refused",
        "gmi_member_of_only",
        "demand_chain_list_only",
        "linked_outsider_role_unlabeled",
        "role_incidental_or_unknown",
        "channel_market_only_no_graph1",
        "source_fact_not_validated",
        "source_fact_negated",
        "source_fact_superseded_stale_cite",
        "body_unavailable",
        "rights_redacted",
        "parse_failed",
        "name_resolution_ambiguous",
        "instruction_detected",
        "llm_relatedness_tag_refused",
        "structure_learner_refused",
        "causal_dag_refused",
        "peer_selected_by_rally",
        "no_documented_exposure_for_shock",
        "competitor_without_competitive_claim",
        "second_hop_refused",
        "k3d_participation_only_hold"
      ]
    },
    "lag_kind": {
      "type": "string",
      "maxLength": 24,
      "enum": [
        "immediate",
        "intra_day",
        "next_session",
        "next_quarter",
        "multi_quarter",
        "unknown"
      ]
    },
    "exposure_unit": {
      "type": "string",
      "maxLength": 32,
      "enum": [
        "percent_of_revenue",
        "percent_of_cogs",
        "usd",
        "units",
        "unknown"
      ]
    },
    "graph_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph",
        "generator_kind",
        "generator_id",
        "as_of",
        "belief_time",
        "hop_count",
        "path"
      ],
      "properties": {
