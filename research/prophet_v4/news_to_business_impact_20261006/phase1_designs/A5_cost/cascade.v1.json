      "stage_id": "compact_extraction",
      "input": "distinct material-delta packet (body + template id + prior fact ids)",
      "output": "news_impact_event.v1 candidate or field_absence.v1",
      "model_tier_class": "cheap",
      "volume_formula": "n_extract = n_material_delta",
      "token_envelope": {
        "input": 2200,
        "output": 250
      },
      "ceiling": "min(remaining proposed day usd, remaining month usd, envelope, key_pool not cooling)",
      "at_ceiling": "defer_budget or defer_capacity; inputs preserved; inference_state=deferred"
    },
    {
      "stage_index": 3,
      "stage_id": "validation",
      "input": "candidate packet",
      "output": "accept or validate_reject with closed reason",
      "model_tier_class": "deterministic",
      "volume_formula": "n_extract_complete",
      "token_envelope": {
        "input": 0,
        "output": 0
      },
      "ceiling": "none",
      "at_ceiling": "n/a"
    },
    {
      "stage_index": 4,
      "stage_id": "issuer_exposure_lookup",
      "input": "accepted packet",
      "output": "company_id cik: + 10 digits, issuer_role, exposure facts or typed absence",
      "model_tier_class": "deterministic",
      "volume_formula": "n_validate_complete",
      "token_envelope": {
        "input": 0,
        "output": 0
      },
      "ceiling": "none",
      "at_ceiling": "n/a; D12 ladder; no web search"
    },
    {
      "stage_index": 5,
      "stage_id": "deterministic_mechanism",
      "input": "accepted packet plus lookup",
      "output": "channel_hint from closed 7-enum or mechanism_absence",
      "model_tier_class": "deterministic",
      "volume_formula": "n_lookup_terminal",
      "token_envelope": {
        "input": 0,
        "output": 0
      },
      "ceiling": "none",
      "at_ceiling": "n/a"
    },
    {
      "stage_index": 6,
      "stage_id": "stronger_adjudication",
      "input": "news_impact.review_packet.v1",
      "output": "adjudicated packet or abstention; never a score",
      "model_tier_class": "stronger",
      "volume_formula": "n_escalate + n_audit <= stronger_slot_cap",
      "token_envelope": {
        "input": 4500,
        "output": 700
      },
      "ceiling": "usd ceilings plus slot cap",
      "at_ceiling": "remain at last deterministic output; defer_budget; not rewritten as no-change"
    },
    {
      "stage_index": 7,
      "stage_id": "frontier_thesis_review",
      "input": "review packet plus alternative mechanisms",
      "output": "thesis-review note (describe/cite/abstain)",
      "model_tier_class": "frontier",
      "volume_formula": "n_frontier <= frontier_slot_cap",
      "token_envelope": {
        "input": 12000,
        "output": 1500
      },
      "ceiling": "usd ceilings plus slot cap",
      "at_ceiling": "defer; keep deterministic/cheap outputs visible"
    },
    {
      "stage_index": 8,
      "stage_id": "consumers",
      "input": "terminal packet with inference_state in completed|deferred|rejected",
      "output": "Prophet context_only read; B4 unchanged",
      "model_tier_class": "deterministic",
      "volume_formula": "n_terminal",
      "token_envelope": {
        "input": 0,
        "output": 0
      },
      "ceiling": "none",
      "at_ceiling": "render deferred as deferred with window; never as silence"
    }
