      "model_tier_class": "deterministic",
      "volume_formula": "n_raw",
      "token_envelope": {
        "input": 0,
        "output": 0
      },
      "ceiling": "none",
      "at_ceiling": "keep writing; never drop"
    },
    {
      "stage_index": 1,
      "stage_id": "deterministic_screen_dedup",
      "input": "qbus row",
      "output": "routing_disposition plus optional event_key/cluster id",
      "model_tier_class": "deterministic",
      "volume_formula": "n_raw",
      "token_envelope": {
        "input": 0,
        "output": 0
      },
      "ceiling": "none",
      "at_ceiling": "n/a"
