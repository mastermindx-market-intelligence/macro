<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema
        targetNamespace="http://www.treasurydirect.gov/"
        xmlns:xsd="http://www.w3.org/2001/XMLSchema"
        xmlns:td="http://www.treasurydirect.gov/"
        elementFormDefault="unqualified"
        attributeFormDefault="unqualified">
    <xsd:annotation>
        <xsd:documentation>TreasuryDirect.gov Auction Schema</xsd:documentation>
    </xsd:annotation>
    <xsd:element name="AuctionData">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="AuctionAnnouncement" type="td:AuctionAnnouncementType" minOccurs="1"/>
                <xsd:element name="AuctionResults" type="td:AuctionResultsType" minOccurs="0"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>
    <xsd:complexType name="AuctionAnnouncementType">
        <xsd:sequence>
            <xsd:element name="SecurityTermWeekYear" type="td:EmptyMaxTenCharacterStringType"/>
            <xsd:element name="SecurityTermDayMonth" type="td:EmptyMaxTenCharacterStringType"/>
            <xsd:element name="SecurityType" type="xsd:string" nillable="true"/>
            <xsd:element name="CUSIP" type="td:NineCharacterStringType"/>
            <xsd:element name="AnnouncementDate" type="xsd:date"/>
            <xsd:element name="AuctionDate" type="xsd:date"/>
            <xsd:element name="IssueDate" type="xsd:date"/>
            <xsd:element name="MaturityDate" type="xsd:date"/>
            <xsd:element name="OfferingAmount" type="td:GreaterThanZeroFloatType"/>
            <xsd:element name="CompetitiveTenderAccepted" type="td:EmptyYesNoType"/>
            <xsd:element name="NonCompetitiveTenderAccepted" type="td:EmptyYesNoType"/>
            <xsd:element name="TreasuryRetailTenderAccepted" type="td:EmptyYesNoType"/>
            <xsd:element name="TypeOfAuction" type="xsd:string" nillable="true"/>
            <xsd:element name="CompetitiveClosingTime" type="td:MilitaryTimeType"/>
            <xsd:element name="NonCompetitiveClosingTime" type="td:EmptyMilitaryTimeType"/>
            <xsd:element name="NetLongPositionReport" type="td:EmptyFloatType"/>
            <xsd:element name="MaxAward" type="td:EmptyIntegerType"/>
            <xsd:element name="MaxSingleBid" type="td:EmptyIntegerType"/>
            <xsd:element name="CompetitiveBidDecimals" type="td:EmptyIntegerType"/>
            <xsd:element name="CompetitiveBidIncrement" type="td:GreaterThanZeroFloatType"/>
            <xsd:element name="AllocationPercentageDecimals" type="td:EmptyZeroToThreeValueIntegerType"/>
            <xsd:element name="MinBidAmount" type="td:EmptyIntegerType"/>
            <xsd:element name="MultiplesToBid" type="td:EmptyIntegerType"/>
            <xsd:element name="MinToIssue" type="td:EmptyIntegerType"/>
            <xsd:element name="MultiplesToIssue" type="td:EmptyIntegerType"/>
            <xsd:element name="MatureSecurityAmount" type="td:EmptyFloatType"/>
            <xsd:element name="CurrentlyOutstanding" type="td:EmptyIntegerType"/>
            <xsd:element name="SOMAIncluded" type="td:EmptyYesNoType"/>
            <xsd:element name="SOMAHoldings" type="td:EmptyFloatType"/>
            <xsd:element name="MaturingDate" type="td:EmptyDateType"/>
            <xsd:element name="FIMAIncluded" type="td:EmptyYesNoType"/>
            <xsd:element name="Series" type="td:EmptyMaxTwentyThreeCharacterStringType"/>
            <xsd:element name="InterestRate" type="td:EmptyFloatType"/>
            <xsd:element name="Spread" type="td:EmptyFloatType"/>
            <xsd:element name="FirstInterestPaymentDate" type="td:EmptyDateType"/>
            <xsd:element name="StandardInterestPayment" type="td:EmptyFloatType"/>
            <xsd:element name="FrequencyInterestPayment" type="xsd:string" nillable="true"/>
            <xsd:element name="StrippableIndicator" type="td:EmptyYesNoType"/>
            <xsd:element name="MinStripAmount" type="td:EmptyIntegerType"/>
            <xsd:element name="CorpusCUSIP" type="td:EmptyNineCharacterStringType"/>
            <xsd:element name="TINTCUSIP1" type="td:EmptyNineCharacterStringType"/>
            <xsd:element name="TINTCUSIP1DueDate" type="td:EmptyDateType"/>
            <xsd:element name="TINTCUSIP2" type="td:EmptyNineCharacterStringType"/>
            <xsd:element name="TINTCUSIP2DueDate" type="td:EmptyDateType"/>
            <xsd:element name="ReOpeningIndicator" type="td:EmptyYesNoType"/>
            <xsd:element name="OriginalIssueDate" type="td:EmptyDateType"/>
            <xsd:element name="BackDated" type="td:EmptyYesNoType"/>
            <xsd:element name="BackDatedDate" type="td:EmptyDateType"/>
            <xsd:element name="LongShortNormalCoupon" type="td:EmptyLongShortNormalType"/>
            <xsd:element name="LongShortCouponFirstIntPmt" type="td:EmptyFloatType"/>
            <xsd:element name="InflationIndexSecurity" type="td:EmptyYesNoType"/>
            <xsd:element name="FloatingRate" type="td:EmptyYesNoType"/>
            <xsd:element name="RefCPIIssueDate" type="td:EmptyFiveDigitDecimalType"/>
            <xsd:element name="RefCPIDatedDate" type="td:EmptyFiveDigitDecimalType"/>
            <xsd:element name="IndexRatioOnIssueDate" type="td:EmptyFiveDigitDecimalType"/>
            <xsd:element name="CPIBasePeriod" type="xsd:string" nillable="true"/>
            <xsd:element name="TIINConversionFactor" type="td:EmptyDecimalType"/>
            <xsd:element name="AccruedInterest" type="td:EmptyFloatType"/>
            <xsd:element name="DatedDate" type="td:EmptyDateType"/>
            <xsd:element name="AnnouncedCUSIP" type="td:EmptyNineCharacterStringType"/>
            <xsd:element name="UnadjustedPrice" type="td:EmptyFloatType"/>
            <xsd:element name="UnadjustedAccruedInterest" type="td:EmptyFloatType"/>
            <xsd:element name="AnnouncementPDFName" type="xsd:string" nillable="true"/>
            <xsd:element name="OriginalDatedDate" type="td:EmptyDateType"/>
            <xsd:element name="AdjustedAmountCurrentlyOutstanding" type="td:EmptyFloatType"/>
            <xsd:element name="NLPExclusionAmount" type="td:EmptyFloatType"/>
            <xsd:element name="MaximumNonCompAward" type="td:EmptyFloatType"/>
            <xsd:element name="AdjustedAccruedInterest" type="td:EmptyFloatType"/>
            <xsd:element name="Callable" type="td:EmptyYesNoType"/>
            <xsd:element name="CallDate" type="td:EmptyDateType"/>
        </xsd:sequence>
    </xsd:complexType>


    <xsd:complexType name="AuctionResultsType">
        <xsd:sequence>
            <xsd:element name="LongShortCouponFirstIntPmt" type="td:EmptyFloatType"/>
            <xsd:element name="PrimaryDealerTendered" type="xsd:nonNegativeInteger"/>
            <xsd:element name="PrimaryDealerAccepted" type="xsd:nonNegativeInteger"/>
            <xsd:element name="DirectBidderTendered" type="xsd:nonNegativeInteger"/>
            <xsd:element name="DirectBidderAccepted" type="xsd:nonNegativeInteger"/>
            <xsd:element name="IndirectBidderTendered" type="xsd:nonNegativeInteger"/>
            <xsd:element name="IndirectBidderAccepted" type="xsd:nonNegativeInteger"/>
            <xsd:element name="CompetitiveTendered" type="xsd:nonNegativeInteger"/>
            <xsd:element name="CompetitiveAccepted" type="xsd:nonNegativeInteger"/>
            <xsd:element name="NonCompetitiveAccepted" type="xsd:nonNegativeInteger"/>
            <xsd:element name="SOMATendered" type="xsd:nonNegativeInteger"/>
            <xsd:element name="SOMAAccepted" type="xsd:nonNegativeInteger"/>
            <xsd:element name="FIMATendered" type="xsd:nonNegativeInteger"/>
            <xsd:element name="FIMAAccepted" type="xsd:nonNegativeInteger"/>
            <xsd:element name="TotalTendered" type="xsd:nonNegativeInteger"/>
            <xsd:element name="TotalAccepted" type="xsd:nonNegativeInteger"/>
            <xsd:element name="BidToCoverRatio" type="td:TwoDigitDecimalType"/>
            <xsd:element name="ReleaseTime" type="td:EmptyMilitaryTimeType"/>
            <xsd:element name="AmountAcceptedBelowLowRate" type="td:EmptyNonNegativeIntegerType"/>
            <xsd:element name="HighAllocationPercentage" type="xsd:float"/>
            <xsd:element name="LowDiscountRate" type="td:EmptyFloatType"/>
            <xsd:element name="HighDiscountRate" type="td:EmptyFloatType"/>
            <xsd:element name="MedianDiscountRate" type="td:EmptyFloatType"/>
            <xsd:element name="LowYield" type="td:EmptyFloatType"/>
            <xsd:element name="HighYield" type="td:EmptyFloatType"/>
            <xsd:element name="MedianYield" type="td:EmptyFloatType"/>
            <xsd:element name="LowDiscountMargin" type="td:EmptyFloatType"/>
            <xsd:element name="HighDiscountMargin" type="td:EmptyFloatType"/>
            <xsd:element name="MedianDiscountMargin" type="td:EmptyFloatType"/>
            <xsd:element name="LowPrice" type="td:EmptyFloatType"/>
            <xsd:element name="HighPrice" type="td:GreaterThanZeroFloatType"/>
            <xsd:element name="MedianPrice" type="td:EmptyFloatType"/>
            <xsd:element name="TIINConversionFactor" type="td:EmptyDecimalType"/>
            <xsd:element name="AccruedInterest" type="td:EmptyFloatType"/>
            <xsd:element name="StandardInterestPayment" type="td:EmptyFloatType"/>
            <xsd:element name="InterestRate" type="td:EmptyFloatType"/>
            <xsd:element name="Spread" type="td:EmptyFloatType"/>
            <xsd:element name="OriginalCUSIP" type="xsd:string" nillable="true"/>
            <xsd:element name="UnadjustedPrice" type="td:EmptyFloatType"/>
            <xsd:element name="UnadjustedAccruedInterest" type="td:EmptyFloatType"/>
            <xsd:element name="TreasuryRetailAccepted" type="xsd:nonNegativeInteger"/>
            <xsd:element name="InvestmentRate" type="td:EmptyFloatType"/>
            <xsd:element name="AdjustedPrice" type="td:EmptyFloatType"/>
            <xsd:element name="AdjustedAccruedInterest" type="td:EmptyFloatType"/>
            <xsd:element name="IndexRatio" type="td:EmptyFloatType"/>
            <xsd:element name="FRNIndexDeterminationDate" type="td:EmptyDateType"/>
            <xsd:element name="FRNIndexDeterminationRate" type="td:EmptyFloatType"/>
            <xsd:element name="ResultsPDFName" type="xsd:string" nillable="true"/>

        </xsd:sequence>
    </xsd:complexType>
    <!-- Standard customized types -->
    <xsd:simpleType name="GreaterThanZeroFloatType">
        <xsd:restriction base="xsd:float">
            <xsd:minExclusive value="0.0"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="ZeroToThreeValueIntegerType">
        <xsd:restriction base="xsd:integer">
            <xsd:minInclusive value="0"/>
            <xsd:maxInclusive value="3"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="TwoDigitDecimalType">
        <xsd:restriction base="xsd:decimal">
            <xsd:fractionDigits value="2"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="FiveDigitDecimalType">
        <xsd:restriction base="xsd:decimal">
            <xsd:fractionDigits value="5"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="MaxSevenCharacterStringType">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="7"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="NineCharacterStringType">
        <xsd:restriction base="xsd:string">
            <xsd:length value="9"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="MaxTenCharacterStringType">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="10"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="MaxTwentyThreeCharacterStringType">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="23"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="MilitaryTimeType">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="([0-1][0-9]|[2][0-3]):[0-5][0-9]"/>
        </xsd:restriction>
    </xsd:simpleType>
    <!-- Empty standard customized types -->
    <xsd:simpleType name="EmptyZeroToThreeValueIntegerType">
        <xsd:union memberTypes="td:ZeroToThreeValueIntegerType">
            <xsd:simpleType>
                <xsd:restriction base="xsd:token">
                    <xsd:enumeration value=""/>
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:union>
    </xsd:simpleType>
    <xsd:simpleType name="EmptyTwoDigitDecimalType">
        <xsd:union memberTypes="td:TwoDigitDecimalType">
            <xsd:simpleType>
                <xsd:restriction base="xsd:token">
                    <xsd:enumeration value=""/>
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:union>
    </xsd:simpleType>
    <xsd:simpleType name="EmptyFiveDigitDecimalType">
        <xsd:union memberTypes="td:FiveDigitDecimalType">
            <xsd:simpleType>
                <xsd:restriction base="xsd:token">
                    <xsd:enumeration value=""/>
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:union>
    </xsd:simpleType>
    <xsd:simpleType name="EmptyMaxSevenCharacterStringType">
        <xsd:union memberTypes="td:MaxSevenCharacterStringType">
            <xsd:simpleType>
                <xsd:restriction base="xsd:token">
                    <xsd:enumeration value=""/>
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:union>
    </xsd:simpleType>
    <xsd:simpleType name="EmptyMaxTwentyThreeCharacterStringType">
        <xsd:union memberTypes="td:MaxTwentyThreeCharacterStringType">
            <xsd:simpleType>
                <xsd:restriction base="xsd:token">
                    <xsd:enumeration value=""/>
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:union>
    </xsd:simpleType>
    <xsd:simpleType name="EmptyNineCharacterStringType">
        <xsd:union memberTypes="td:NineCharacterStringType">
            <xsd:simpleType>
                <xsd:restriction base="xsd:token">
                    <xsd:enumeration value=""/>
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:union>
    </xsd:simpleType>
    <xsd:simpleType name="EmptyMaxTenCharacterStringType">
        <xsd:union memberTypes="td:MaxTenCharacterStringType">
            <xsd:simpleType>
                <xsd:restriction base="xsd:token">
                    <xsd:enumeration value=""/>
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:union>
    </xsd:simpleType>
    <xsd:simpleType name="EmptyMilitaryTimeType">
        <xsd:union memberTypes="td:MilitaryTimeType">
            <xsd:simpleType>
                <xsd:restriction base="xsd:token">
                    <xsd:enumeration value=""/>
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:union>
    </xsd:simpleType>
    <xsd:simpleType name="EmptyCashIndicatorType">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="PD"/>
            <xsd:enumeration value="NC"/>
            <xsd:enumeration value=""/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="EmptyLongShortNormalType">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="L"/>
            <xsd:enumeration value="S"/>
            <xsd:enumeration value="N"/>
            <xsd:enumeration value=""/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="EmptyYesNoType">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="Y"/>
            <xsd:enumeration value="N"/>
            <xsd:enumeration value=""/>
        </xsd:restriction>
    </xsd:simpleType>
    <!-- Empty standard types -->
    <xsd:simpleType name="EmptyDateType">
        <xsd:union memberTypes="xsd:date">
            <xsd:simpleType>
                <xsd:restriction base="xsd:token">
                    <xsd:enumeration value=""/>
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:union>
    </xsd:simpleType>
    <xsd:simpleType name="EmptyDecimalType">
        <xsd:union memberTypes="xsd:decimal">
            <xsd:simpleType>
                <xsd:restriction base="xsd:token">
                    <xsd:enumeration value=""/>
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:union>
    </xsd:simpleType>
    <xsd:simpleType name="EmptyFloatType">
        <xsd:union memberTypes="xsd:float">
            <xsd:simpleType>
                <xsd:restriction base="xsd:token">
                    <xsd:enumeration value=""/>
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:union>
    </xsd:simpleType>
    <xsd:simpleType name="EmptyIntegerType">
        <xsd:union memberTypes="xsd:integer">
            <xsd:simpleType>
                <xsd:restriction base="xsd:token">
                    <xsd:enumeration value=""/>
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:union>
    </xsd:simpleType>
    <xsd:simpleType name="EmptyNonNegativeIntegerType">
        <xsd:union memberTypes="xsd:nonNegativeInteger">
            <xsd:simpleType>
                <xsd:restriction base="xsd:token">
                    <xsd:enumeration value=""/>
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:union>
    </xsd:simpleType>
</xsd:schema>
