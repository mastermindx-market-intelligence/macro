; PRODUCTION wiring — the macro dashboard is a PINNED submodule so the bot
; reproduces every past decision against the exact engine version that produced it.
;
;   git submodule add git@github.com:mastermindx-market-intelligence/macro.git vendor/macro
;   git -C vendor/macro checkout 2495a9dfe   ; pin (explicit, never floating)
;
; NOTE: for local Phase 0, vendor/macro is a SYMLINK to the working macro
; checkout instead of a clone, because the parquet data store under data/ is
; gitignored in the macro repo and a fresh clone would have no data to read.
; In CI the data is regenerated by the daily pipeline, so the real submodule works.
[submodule "vendor/macro"]
	path = vendor/macro
	url = git@github.com:mastermindx-market-intelligence/macro.git
	branch = main
