        {
          "key": "header",
          "html": "<div layer-name=\"Directory header\" style=\"display:flex;flex-direction:column;padding:20px 35px;gap:12px;width:390px;color:var(--mx-light-text);font-family:Inter;border-bottom:1px solid var(--mx-light-line);\"><div style=\"display:flex;justify-content:space-between;align-items:center;width:100%;gap:16px;\"><div style=\"font-size:12px;line-height:1.5;color:var(--mx-light-text);font-weight:650;overflow-wrap:anywhere;\">MASTERMIND / DESIGN</div><div style=\"font-size:12px;line-height:1.5;color:var(--mx-light-muted);font-weight:400;overflow-wrap:anywhere;\">EN</div></div></div>"
