+  assert.strictEqual(seg.api().sameDocumentFragment(projected(seg, { href: '?a=1&&b=2&#panel' }, 'a-seg-ok')), 'panel');
+  assert.strictEqual(seg.api().sameDocumentFragment(projected(seg, { href: '?a=1&b=2&#panel' }, 'a-seg-collapsed')), null);
