+/* Paper research workbench: one clear tool rail and compact, persistent context.
+   The existing controller retains every view, selection and availability gate. */
+body.imc-page #intl-analysis-tools>.imc-tools-heading,
+body.imc-page #intl-analysis-tools .imc-tools-heading{display:grid;gap:3px;padding-block:14px}
+body.imc-page #intl-analysis-tools .imc-tools-heading small{font-size:var(--fs-label);font-weight:400;color:var(--muted);line-height:1.6}
+body.imc-page .intl-workspace>header{margin-bottom:16px}
+body.imc-page .intl-workspace [data-im-heading]{font-size:var(--fs-num-lg);font-weight:650;letter-spacing:-.025em;margin:0 0 5px}
+body.imc-page .intl-workspace>header>p{font-size:var(--fs-sm);color:var(--muted);margin:0}
+body.imc-page .intl-workspace [data-im-eod-disclosure]{font-size:var(--fs-label);line-height:1.7;color:var(--muted);background:var(--panel2);border:1px solid var(--line-quiet,var(--line));border-radius:var(--r-ctl,8px);padding:12px 16px;margin:0 0 16px}
+body.imc-page .intl-workspace__toolbar{display:flex;gap:12px 20px;align-items:center;padding:0;margin:0 0 20px}
+body.imc-page .intl-workspace__toolbar legend{font-size:var(--fs-label);font-weight:500;color:var(--muted);margin-bottom:8px}
+body.imc-page .intl-workspace__view-nav{flex:1 0 100%;display:flex;flex-wrap:nowrap;gap:3px;overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:thin;padding:4px;border:1px solid var(--line-quiet,var(--line));border-radius:var(--r-btn,10px);background:var(--panel2)}
+body.imc-page .intl-workspace__view-nav button{flex:1 0 auto;white-space:nowrap;min-height:44px;padding:8px 12px;background:transparent;box-shadow:none;border:1px solid transparent;border-radius:var(--r-ctl,8px);font-size:var(--fs-sm);font-weight:500;color:var(--muted)}
+body.imc-page .intl-workspace__view-nav button:not(:disabled):hover{background:var(--panel);color:var(--text)}
+body.imc-page .intl-workspace__view-nav button[aria-pressed="true"]{background:var(--panel);border-color:var(--line);color:var(--text);font-weight:600}
+body.imc-page .intl-workspace__view-nav button:disabled{opacity:.55}
+body.imc-page .intl-workspace__toolbar>label{display:flex;flex-direction:row;align-items:center;gap:10px;font-size:var(--fs-label)}
+body.imc-page .intl-workspace__toolbar>label.intl-workspace__view-select{display:none}
+body.imc-page .intl-workspace__toolbar select{min-height:40px;width:auto;min-width:100px;padding:8px 30px 8px 12px;background:var(--panel);box-shadow:none;font-size:var(--fs-sm)}
+body.imc-page .intl-overview__context{font-size:var(--fs-label)}
+body.imc-page .intl-overview__summary,
+body.imc-page .intl-overview__focus,
+body.imc-page .intl-overview__market{border-radius:var(--r-btn,10px);box-shadow:none}
+body.imc-page .intl-workspace>.intl-gs:has(>[data-im-panel]):not(:has(>[data-im-panel]:not([hidden]))){display:none}
+body.imc-page .intl-inspectors{margin-top:20px}
+body.imc-page .intl-inspector__fallback>summary{font-size:var(--fs-sm)}
+@media(max-width:768px){
+ body.imc-page .intl-workspace__view-nav{display:none}
+ body.imc-page .intl-workspace__toolbar{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
+ body.imc-page .intl-workspace__toolbar>label{display:flex;flex-direction:column;align-items:stretch;gap:5px}
+ body.imc-page .intl-workspace__toolbar>label.intl-workspace__view-select{display:flex;grid-column:1/-1}
+ body.imc-page .intl-workspace__toolbar select{width:100%;min-width:0;min-height:44px;padding-right:25px}
+ body.imc-page .intl-workspace [data-im-eod-disclosure]{padding:12px;font-size:var(--fs-micro)}
+ body.imc-page .intl-workspace [data-im-heading]{font-size:var(--fs-h2)}
