+export const GOVREV_DECLARATION_SCHEMA = "government_revenue.monitor_declaration.v1" as const;
+export const MAX_GOVREV_DECLARATION_BYTES = 24 * 1024;
+export const MAX_GOVREV_INPUT_REFS = 16;
+export const MAX_GOVREV_BASELINE_EVENTS = 100;
+export const MAX_GOVREV_Q = 120;
+export const MAX_GOVREV_AGENCY = 100;
+export const MAX_GOVREV_TICKER = 10;
+export const MAX_GOVREV_BASELINE_ID = 128;
+export const GOVREV_MODES = ["changes", "awards", "opportunities", "recompetes"] as const;
+export const GOVREV_TRUTHS = ["all", "official", "linked", "defense"] as const;
+export const GOVREV_ISSUERS = ["LMT", "RTX", "NOC", "LHX"] as const;
+
+export type GovRevMode = typeof GOVREV_MODES[number];
+export type GovRevTruth = typeof GOVREV_TRUTHS[number];
+export type GovRevIssuer = typeof GOVREV_ISSUERS[number];
+export type GovRevSelection = {
+  mode: GovRevMode;
+  truth: GovRevTruth;
+  q: string | null;
+  agency: string | null;
+  ticker: string | null;
+  issuer: GovRevIssuer | null;
+};
+export type GovRevBaselineEvent = { recordId: string; eventId: string; version: number; knownAt: string };
+export type GovernmentRevenueMonitorDeclaration = {
+  schema: typeof GOVREV_DECLARATION_SCHEMA;
+  enabled: boolean;
+  subject: ThesisSubjectRef;
+  selection: GovRevSelection;
+  window: { start: string; end: string };
+  knowledgeCutoff: string;
+  inputRefs: string[];
+  baselineEvents: GovRevBaselineEvent[];
+};
+
+const CONTROL = /[\u0000-\u001f\u007f]/;
+const CANONICAL_UTC = /^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$/;
+const INPUT_REF = /^(?:workspace-sha256:[0-9a-f]{64}|grw2-[0-9a-f]{24})$/;
+const CANONICAL_TICKER = /^[A-Z0-9]+(?:[.-][A-Z0-9]+)*$/;
+
+function objectRecord(value: unknown): Record<string, unknown> | null {
+  return value !== null && typeof value === "object" && !Array.isArray(value)
+    ? value as Record<string, unknown> : null;
+}
+function hasExactKeys(raw: Record<string, unknown>, keys: readonly string[]): boolean {
+  const allowed = new Set(keys);
+  return Object.keys(raw).length === keys.length && Object.keys(raw).every(key => allowed.has(key));
+}
+/** Canonical UTC wall clock, millisecond precision, `Z` zone only — the same
+ * closed timestamp subset the existing thesis content contract uses. */
+export function canonicalUtcTimestamp(value: unknown): string | null {
+  if (typeof value !== "string" || value.startsWith("0000-") || !CANONICAL_UTC.test(value)) return null;
+  const parsed = Date.parse(value);
+  return Number.isFinite(parsed) && new Date(parsed).toISOString() === value ? value : null;
+}
+/** PostgreSQL btrim(text, ' ') semantics: U+0020 only, never ECMAScript trim(). */
+function boundedLine(value: unknown, max: number): string | null {
+  if (typeof value !== "string") return null;
+  const trimmed = value.replace(/^ +| +$/g, "");
+  return trimmed.length > 0 && trimmed.length <= max && !CONTROL.test(trimmed) ? trimmed : null;
+}
+/** Sentinel distinguishing "invalid text" from a legitimate `null`. */
+const INVALID: unique symbol = Symbol("invalid");
+
+/** Optional nullable bounded text: `null` passes through, anything invalid is
+ * reported as the `INVALID` sentinel so callers can reject it. */
+function nullableBoundedLine(value: unknown, max: number): string | null | typeof INVALID {
+  if (value === null) return null;
+  return boundedLine(value, max) ?? INVALID;
+}
+
+function normalizeSelection(value: unknown): GovRevSelection | null {
+  const raw = objectRecord(value);
+  if (!raw || !hasExactKeys(raw, ["mode", "truth", "q", "agency", "ticker", "issuer"])) return null;
+  if (typeof raw.mode !== "string" || !GOVREV_MODES.includes(raw.mode as GovRevMode)) return null;
+  if (typeof raw.truth !== "string" || !GOVREV_TRUTHS.includes(raw.truth as GovRevTruth)) return null;
+  const q = nullableBoundedLine(raw.q, MAX_GOVREV_Q);
+  const agency = nullableBoundedLine(raw.agency, MAX_GOVREV_AGENCY);
+  if (q === INVALID || agency === INVALID) return null;
+  const tickerRaw = nullableBoundedLine(raw.ticker, MAX_GOVREV_TICKER);
+  if (tickerRaw === INVALID) return null;
+  const ticker = tickerRaw === null ? null : tickerRaw.toUpperCase();
+  if (ticker !== null && (ticker.length > MAX_GOVREV_TICKER || !CANONICAL_TICKER.test(ticker))) return null;
+  const issuer = raw.issuer === null ? null
+    : typeof raw.issuer === "string" && GOVREV_ISSUERS.includes(raw.issuer as GovRevIssuer) ? raw.issuer as GovRevIssuer : null;
+  if (raw.issuer !== null && issuer === null) return null;
+  return { mode: raw.mode as GovRevMode, truth: raw.truth as GovRevTruth, q, agency, ticker, issuer };
+}
+
+function normalizeBaselineEvents(value: unknown): GovRevBaselineEvent[] | null {
+  if (!Array.isArray(value) || value.length > MAX_GOVREV_BASELINE_EVENTS) return null;
+  const events: GovRevBaselineEvent[] = [];
+  for (const item of value) {
+    const raw = objectRecord(item);
+    if (!raw || !hasExactKeys(raw, ["recordId", "eventId", "version", "knownAt"])) return null;
+    const recordId = boundedLine(raw.recordId, MAX_GOVREV_BASELINE_ID);
+    const eventId = boundedLine(raw.eventId, MAX_GOVREV_BASELINE_ID);
+    const knownAt = canonicalUtcTimestamp(raw.knownAt);
+    if (!recordId || !eventId || !knownAt
+      || typeof raw.version !== "number" || !Number.isSafeInteger(raw.version) || raw.version < 1 || raw.version > 999_999_999) return null;
+    events.push({ recordId, eventId, version: raw.version, knownAt });
+  }
+  return new Set(events.map(event => `${event.recordId}\u0000${event.eventId}`)).size === events.length ? events : null;
+}
+
+/**
+ * Validate and canonicalize one declaration. `null` return means reject: unknown
+ * keys, malformed clocks, non-finite versions, free-form URLs/bodies/private
+ * fields and over-limit payloads are all refused here, before any DB write.
+ */
+export function normalizeGovernmentRevenueMonitor(value: unknown): GovernmentRevenueMonitorDeclaration | null {
+  const raw = objectRecord(value);
+  if (!raw || !hasExactKeys(raw, ["schema", "enabled", "subject", "selection", "window", "knowledgeCutoff", "inputRefs", "baselineEvents"])) return null;
+  if (raw.schema !== GOVREV_DECLARATION_SCHEMA || typeof raw.enabled !== "boolean") return null;
+  // Canonical identity only: the existing normalizer rejects display-only keys
+  // and closed owner/kind vocabularies, exactly as for the thesis subject itself,
+  // without inventing a casing rule for the owning resolver's opaque keys.
+  const subject = normalizeThesisSubject(raw.subject);
+  if (!subject) return null;
+  const selection = normalizeSelection(raw.selection);
+  if (!selection) return null;
+  const window = objectRecord(raw.window);
+  if (!window || !hasExactKeys(window, ["start", "end"])) return null;
+  const start = canonicalUtcTimestamp(window.start), end = canonicalUtcTimestamp(window.end);
+  const knowledgeCutoff = canonicalUtcTimestamp(raw.knowledgeCutoff);
+  if (!start || !end || start > end || !knowledgeCutoff) return null;
+  if (!Array.isArray(raw.inputRefs) || raw.inputRefs.length < 1 || raw.inputRefs.length > MAX_GOVREV_INPUT_REFS
+    || !raw.inputRefs.every(ref => typeof ref === "string" && ref === ref.trim() && INPUT_REF.test(ref))
+    || new Set(raw.inputRefs).size !== raw.inputRefs.length) return null;
+  const baselineEvents = normalizeBaselineEvents(raw.baselineEvents);
+  if (!baselineEvents || baselineEvents.some(event => event.knownAt > knowledgeCutoff)) return null;
+  const declaration: GovernmentRevenueMonitorDeclaration = {
+    schema: GOVREV_DECLARATION_SCHEMA,
+    enabled: raw.enabled,
+    subject,
+    selection,
+    window: { start, end },
+    knowledgeCutoff,
+    inputRefs: [...raw.inputRefs] as string[],
+    baselineEvents,
+  };
+  return new TextEncoder().encode(JSON.stringify(declaration)).byteLength <= MAX_GOVREV_DECLARATION_BYTES ? declaration : null;
+}
+
+/** Wire form mirrors the existing thesis content mapping (snake_case on the wire,
+ * camelCase in application space). Key order is fixed so callers may compare
+ * canonical bytes directly. */
+export function governmentRevenueMonitorToWire(declaration: GovernmentRevenueMonitorDeclaration): Record<string, unknown> {
+  return {
+    schema: declaration.schema,
+    enabled: declaration.enabled,
+    subject: subjectToWire(declaration.subject),
+    selection: {
+      mode: declaration.selection.mode,
+      truth: declaration.selection.truth,
+      q: declaration.selection.q,
+      agency: declaration.selection.agency,
+      ticker: declaration.selection.ticker,
+      issuer: declaration.selection.issuer,
+    },
+    window: { start: declaration.window.start, end: declaration.window.end },
+    knowledge_cutoff: declaration.knowledgeCutoff,
+    input_refs: [...declaration.inputRefs],
+    baseline_events: declaration.baselineEvents.map(event => ({
+      record_id: event.recordId, event_id: event.eventId, version: event.version, known_at: event.knownAt,
+    })),
+  };
+}
