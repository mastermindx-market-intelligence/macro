+ * declaration is carried by EXISTING owners — either as the payload of the new
+ * `government_revenue` saved-view kind (workspace_settings owner) or as the
+ * optional `governmentRevenueMonitor` member of the existing immutable thesis
+ * content — and is applied only through the existing optimistic
+ * `applyThesisVersion` RPC. Canonical identity always comes from the existing
+ * normalized ThesisSubjectRef; a display-only ticker is never substituted for
+ * the canonical subject key.
+ */
+import { normalizeThesisSubject, subjectToWire } from "@/lib/theses";
+import type { ThesisSubjectRef } from "@/lib/theses";
