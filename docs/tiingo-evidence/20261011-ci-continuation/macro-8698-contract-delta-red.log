2026-10-11T23:04:28.4405249Z fi
2026-10-11T23:04:28.4405584Z # `actions/checkout` uses fetch-depth: 1 above, so Git marks this merge
2026-10-11T23:04:28.4406108Z # commit as a shallow boundary and revision-walking formats such as `%P`
2026-10-11T23:04:28.4406610Z # hide its parents. Read the immutable raw commit headers instead; they
2026-10-11T23:04:28.4407112Z # retain the exact parent OIDs even before either parent object is fetched.
2026-10-11T23:04:28.4407621Z parents=$(git cat-file -p HEAD | sed -n 's/^parent //p')
2026-10-11T23:04:28.4407969Z set -- $parents
2026-10-11T23:04:28.4408196Z if [ "$#" -ne 2 ]; then
2026-10-11T23:04:28.4408625Z   echo "::error title=contract-delta::PR checkout is not an exact two-parent tested merge" >&2
