2026-10-11T23:04:28.4411225Z   exit 1
2026-10-11T23:04:28.4411426Z fi
2026-10-11T23:04:28.4411666Z echo "base_sha=$tested_base" >> "$GITHUB_OUTPUT"
2026-10-11T23:04:28.4412019Z echo "head_sha=$tested_head" >> "$GITHUB_OUTPUT"
