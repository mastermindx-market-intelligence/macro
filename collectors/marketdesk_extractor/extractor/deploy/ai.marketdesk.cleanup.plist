<?xml version="1.0" encoding="UTF-8"?>
<!--
  MarketDesk extractor — weekly local cleanup (prune PDFs already archived in R2).
  Sundays 03:00 local. Replace __HOME__ and __USER__ before installing.
  Install:  cp deploy/ai.marketdesk.cleanup.plist ~/Library/LaunchAgents/
            launchctl load ~/Library/LaunchAgents/ai.marketdesk.cleanup.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.marketdesk.cleanup</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/marketdesk_paper_extractor/.venv/bin/marketdesk</string>
        <string>cleanup</string>
        <string>--older-than-days</string>
        <string>14</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__HOME__/marketdesk_paper_extractor</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/marketdesk_paper_extractor/logs/launchd.cleanup.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/marketdesk_paper_extractor/logs/launchd.cleanup.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
