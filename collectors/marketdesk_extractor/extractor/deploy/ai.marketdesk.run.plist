<?xml version="1.0" encoding="UTF-8"?>
<!--
  MarketDesk extractor — daily fetch/download/parse/upload run.
  Replace __HOME__ (e.g. /Users/chriswong) and __USER__ (e.g. chriswong) before installing.
  Install:  cp deploy/ai.marketdesk.run.plist ~/Library/LaunchAgents/
            launchctl load ~/Library/LaunchAgents/ai.marketdesk.run.plist
  Runs every 30 minutes; --since-hours 36 + SQLite dedup make off-hours runs cheap no-ops.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.marketdesk.run</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/marketdesk_paper_extractor/.venv/bin/marketdesk</string>
        <string>run</string>
        <string>--since-hours</string>
        <string>36</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__HOME__/marketdesk_paper_extractor</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/marketdesk_paper_extractor/logs/launchd.run.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/marketdesk_paper_extractor/logs/launchd.run.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
