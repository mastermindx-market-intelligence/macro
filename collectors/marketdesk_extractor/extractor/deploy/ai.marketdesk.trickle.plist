<?xml version="1.0" encoding="UTF-8"?>
<!--
  Always-on, fail-closed MarketDesk puller. The application reads .env from the
  WorkingDirectory and enforces MARKETDESK_STORAGE_* before mutable work.
  Install after replacing __HOME__:
    cp deploy/ai.marketdesk.trickle.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ai.marketdesk.trickle.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.marketdesk.trickle</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/marketdesk_paper_extractor/.venv/bin/marketdesk</string>
        <string>trickle</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__HOME__/marketdesk_paper_extractor</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <!-- Routine logs rotate under external LOG_DIR. This small internal log is
         only for preflight/fatal messages when the external volume is absent. -->
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/ai.marketdesk.trickle.guard.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/ai.marketdesk.trickle.guard.log</string>

    <key>ProcessType</key>
    <string>Standard</string>
</dict>
</plist>
