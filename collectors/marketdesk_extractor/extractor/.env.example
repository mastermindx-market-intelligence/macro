# ---------------------------------------------------------------------------
# MarketDesk Paper Extractor — configuration
# Copy to .env and fill in. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- MarketDesk / browser ---------------------------------------------------
MARKETDESK_BASE_URL=https://marketdesk.ai
# Persistent Playwright profile dir (holds the logged-in session after `auth`).
MARKETDESK_PROFILE_DIR=./browser_profile
# Run discovery/download headless (true) or visible (false). `auth` is always headed.
MARKETDESK_HEADLESS=true

# Multi-account "trickle" loop: comma-separated list of profile dirs, one per
# MarketDesk account. Each entry is `name:path` or just `path` (name derived from
# the dir). Blank => a single profile at MARKETDESK_PROFILE_DIR (works today with
# one account). Add a second account by running `auth` against a NEW profile dir,
# e.g. MARKETDESK_PROFILES=acct1:./browser_profile,acct2:./browser_profile_2
MARKETDESK_PROFILES=

# --- storage / paths --------------------------------------------------------
# Production external-volume guard (optional, but recommended for a daemon).
# Setting it makes startup and every download fail CLOSED unless:
# - this exact mounted volume UUID is present, external, and writable;
# - every mutable path below (including browser profiles) is under ROOT; and
# - at least MIN_FREE_GIB remains. The guard never creates the mount/root itself.
# Find the UUID on macOS with: diskutil info /Volumes/STORAGE | grep 'Volume UUID'
MARKETDESK_STORAGE_VOLUME=
MARKETDESK_STORAGE_ROOT=
MARKETDESK_STORAGE_VOLUME_UUID=
MARKETDESK_STORAGE_MIN_FREE_GIB=100
# Set false under launchd to keep routine output only in the rotating LOG_DIR file;
# fatal preflight errors still go to launchd's small guard log on the internal disk.
MARKETDESK_LOG_CONSOLE=true

DATABASE_URL=./db/marketdesk.sqlite
OUTPUT_DIR=./data
RAW_PDF_DIR=./data/raw_pdfs
MARKDOWN_DIR=./data/markdown
METADATA_DIR=./data/metadata
MANIFEST_DIR=./data/manifests
LOG_DIR=./logs

# --- Cloudflare R2 (primary destination; S3-compatible) ---------------------
R2_ENABLED=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=marketdesk

# --- Dropbox (optional secondary/fallback destination) ----------------------
DROPBOX_ENABLED=false
DROPBOX_ACCESS_TOKEN=
DROPBOX_PREFIX=/marketdesk

# --- Research Vault (downstream dashboard hand-off; PRIVATE R2 bucket) -------
# Publishes each COMPLETE paper as <id>.pdf + <id>.json (research_vault.sidecar.v1)
# into research_inbox/ of a PRIVATE R2 bucket for an hourly ingest to consume.
# The vault bucket may live in its OWN Cloudflare account — set the VAULT_R2_*
# credentials below; each falls back to the matching R2_* value above when blank
# (same-account case).
VAULT_ENABLED=false
VAULT_R2_ACCOUNT_ID=
VAULT_R2_ACCESS_KEY_ID=
VAULT_R2_SECRET_ACCESS_KEY=
VAULT_R2_BUCKET=
VAULT_R2_PREFIX=research_inbox
# top_pick = is_top_pick OR local_priority_score >= this threshold.
VAULT_TOP_PICK_MIN_SCORE=85

# --- run limits / politeness ------------------------------------------------
MAX_ARTICLES_PER_RUN=300
MAX_CONCURRENT_PAGES=5
MAX_CONCURRENT_DOWNLOADS=5
MAX_CONCURRENT_PARSE_WORKERS=2
# Default lookback for `run --since-hours` when the flag is omitted.
DEFAULT_SINCE_HOURS=24

# --- trickle allocator (marketdesk trickle) ---------------------------------
# MarketDesk throttles PDF downloads to ~75 per ROLLING 24h window per account
# (the read/discovery API is uncapped). The trickle loop pulls newest research
# first, uses leftover quota for backfill, and never re-trips the cap.
# Per-account safety cap (< the observed 75). The loop is ALSO self-calibrating:
# an over-cap HTML bounce puts the account into cooldown regardless of this value.
DOWNLOAD_CAP_PER_ACCOUNT_24H=70
# Papers published within this many hours are "new" (drained first); older =
# backfill (newest-history first).
NEW_WINDOW_HOURS=48
# Main loop tick interval (seconds) — downloads are spaced across ticks.
TRICKLE_INTERVAL_SEC=60
# How often to refresh the new-post queue via the uncapped discovery API (seconds).
DISCOVER_EVERY_SEC=900
# Hold back quota for new posts expected in the next N hours before backfilling.
BACKFILL_RESERVE_HOURS=4
# Pacing token-bucket capacity per account. The daily budget refills smoothly at
# cap/24h; this is the small burst allowance to catch a fresh spike of new posts
# quickly without exhausting the 24h window (which would starve later new posts).
TRICKLE_BURST=10
# WIDE discovery pass. The periodic refresh above only looks back NEW_WINDOW_HOURS
# + 24h, and self-healing (late-arriving AI summaries, truncated titles) only
# re-examines papers INSIDE the window it walks — so nothing older can ever be
# healed by it. This pass re-walks a much longer window on a slow cadence and
# also resets FAILED rows to DISCOVERED, replacing the manual wide `discover`.
# It runs on the FIRST refresh after start (so a restart heals immediately),
# then once per interval. Discovery is uncapped: this costs API calls, not quota.
TRICKLE_WIDE_DISCOVER_EVERY_SEC=86400
TRICKLE_WIDE_DISCOVER_HOURS=336
TRICKLE_WIDE_HEAL_LIMIT=300
# Scan budget for the wide pass. walk_papers' limit caps SCANNED items and the
# narrow default (MAX_ARTICLES_PER_RUN=300) covers ~1.5 days at ~210 posts/day,
# which would silently truncate the 14-day walk (~3000 items).
TRICKLE_WIDE_DISCOVER_LIMIT=5000

# --- priority scoring -------------------------------------------------------
# Only download items scoring above PRIORITY_THRESHOLD when this is true.
DOWNLOAD_ONLY_ABOVE_PRIORITY=false
PRIORITY_THRESHOLD=60
# Comma-separated tickers/watchlist to boost (optional).
WATCHLIST=

# --- exclusion filter (marketdesk filter / discovery) -----------------------
# Low-value papers are marked SKIPPED_EXCLUDED at discovery so they never enter
# the download queue (the account is download-capped ~75/rolling-24h — a wasted
# pull is expensive). `marketdesk filter --dry-run` previews the effect against
# the existing DB, and `marketdesk filter` reclassifies existing rows (also
# restoring any that no longer match when the list shrinks).
#
# Comma-separated institutions (blogs/newsletters) to exclude. Matched
# case-insensitively against the paper's institution. UNSET => the embedded
# default set: "the market ear, tme, zero hedge". Set your own list to override.
EXCLUDE_INSTITUTIONS=the market ear,tme,zero hedge
# Apply the embedded default TITLE patterns (fx_daily / minor_geo). These drop
# daily FX snapshots and single-country notes on minor economies while KEEPING
# real FX strategy and every major economy (US/China/Japan/Korea/Taiwan/India/
# UK/Germany/France/Italy/Spain/Eurozone/Singapore, etc.). Set false to disable.
EXCLUDE_TITLE_PATTERNS_ENABLED=true

# --- PDF parsing ------------------------------------------------------------
# Parser backend: marker | mineru | none
PARSER_BACKEND=marker
