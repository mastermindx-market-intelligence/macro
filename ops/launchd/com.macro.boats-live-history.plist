  <key>KeepAlive</key><false/>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Volumes/Mastermind/market-data/tiingo-runtime/logs/live-history.stdout.log</string>
  <key>StandardErrorPath</key><string>/Volumes/Mastermind/market-data/tiingo-runtime/logs/live-history.stderr.log</string>
</dict></plist>
