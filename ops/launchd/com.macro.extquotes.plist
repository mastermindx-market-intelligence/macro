<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.macro.extquotes.plist — launchd agent for the overnight BOATS session runner.

  Fires ONCE per evening at 17:00 in the Mac's real timezone (America/Vancouver),
  which is exactly 20:00 America/New_York (both zones observe DST, so the 3-hour
  offset holds year-round, including across DST transitions).  Sunday through
  Thursday evenings — those open the overnight sessions tied to Monday through
  Friday's US cash sessions.  The wrapper (run_ext_quotes_loop.sh) execs the
  bounded Python runner scripts.run_boats_session in publish mode, which covers one
  real overnight session (20:00→04:00 ET) as sequential bounded incumbent
  publish_boats_stream segments and then exits.  launchd fires the next session
  at the next StartCalendarInterval; there is no KeepAlive, no RunAtLoad and no
  StartInterval, so a failed process is not respawned. launchd may coalesce a missed
  calendar event at wake; the runner still requires the current overnight window
  and an unused session start receipt.

  The Python runner validates the expected host timezone/offset equivalence and
  the real NYSE calendar (holidays, DST) before any effect, takes a nonblocking
  kernel lock plus a permanent O_EXCL per-trading-session start receipt in the
  archive's run-receipts area, and writes a durable final receipt with segment
  counts and an explicit terminal reason.  A crashed run leaves its start
  receipt in place and therefore blocks same-session replay until lawful
  manual reconciliation.

  This relay runs on the Mac (residential IP) and publishes to R2, bypassing
  Yahoo 429 errors that the VPS (DigitalOcean IP) encounters.  The hub fetches
  the R2 file via the 'r2file' ext feed mode.

  DO NOT touch the other flow lanes (com.mastermind.liveflow, com.mastermind.prophetmarks)
  — this is an independent, additive job.

  INSTALL (as the mac user — not root):
    cp ops/launchd/com.macro.extquotes.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.macro.extquotes.plist

  UNINSTALL:
    launchctl unload ~/Library/LaunchAgents/com.macro.extquotes.plist
    rm ~/Library/LaunchAgents/com.macro.extquotes.plist

  DO NOT load this plist directly from the repo — copy first (launchd requires the
  exact plist path when unloading).

  ENV FILE (sourced from /Users/chriswong/flow-ops-wt/.env via run_with_env.sh):
    R2_ENDPOINT, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET  (incumbent storage)
    BOATS_SYMBOLS_FILE        bounded line-oriented BOATS coverage file
    BOATS_ARCHIVE_ROOT        the existing mounted Tiingo archive root
    BOATS_TOTAL_MAX_MESSAGES  explicit night message budget (<= 80000000)
    BOATS_MAX_SEGMENTS        optional (default 32, hard cap 32)
    BOATS_SEGMENT_MAX_SECONDS optional (default 3600, hard cap 3600)
    The wrapper fails closed when any required value is missing.

  LOG TAILING:
    tail -f /tmp/extquotes.stdout.log /tmp/extquotes.stderr.log

  MANUAL DRY-RUN PLAN (no stream, no R2, no receipts):
    cd '/Users/chriswong/Documents/Cluade/Macro Dashboard'
    python -m scripts.run_boats_session   # pass the symbols-file and
      # archive-root options with $BOATS_SYMBOLS_FILE / $BOATS_ARCHIVE_ROOT

  MANUAL ONE-SESSION RUN (same gate as launchd):
    set -a && source /Users/chriswong/flow-ops-wt/.env && set +a
    ops/launchd/run_ext_quotes_loop.sh
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.macro.extquotes</string>

  <!--
    run_with_env.sh sources .env then launches the wrapper, which execs the
    bounded Python session runner (scripts.run_boats_session, publish mode).
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/chriswong/flow-ops-wt/ops/launchd/run_with_env.sh</string>
    <string>/Users/chriswong/flow-ops-wt/.env</string>
    <string>/bin/sh</string>
    <string>/Users/chriswong/flow-ops-wt/ops/launchd/run_ext_quotes_loop.sh</string>
  </array>

  <!-- Working directory = flow-ops-wt (launchd law: never ~/Documents). -->
  <key>WorkingDirectory</key>
  <string>/Users/chriswong/flow-ops-wt</string>

  <!--
    Fire ONCE at 17:00 in the Mac's real timezone (America/Vancouver) = 20:00 ET,
    opening the overnight session tied to the NEXT US cash session.  Sunday
    evening opens Monday's session ... Thursday evening opens Friday's.  Friday
    and Saturday evenings would target non-sessions, so they are absent; the
    Python runner independently re-checks the real NYSE calendar (holidays,
    DST) and exits outside a real overnight window.  launchd Weekday: 0=Sunday.
    System timezone must remain America/Vancouver (the runner refuses a
    mismatched host timezone instead of guessing).
  -->
  <key>StartCalendarInterval</key>
  <array>
    <!-- Sunday evening → Monday overnight session -->
    <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
    <!-- Monday evening → Tuesday overnight session -->
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
    <!-- Tuesday evening → Wednesday overnight session -->
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
    <!-- Wednesday evening → Thursday overnight session -->
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
    <!-- Thursday evening → Friday overnight session -->
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>/Users/chriswong/Documents/Cluade/Macro Dashboard</string>
    <!-- R2_* secrets and the BOATS_* deployment configuration are sourced from
         .env via run_with_env.sh above; the wrapper fails closed on missing
         configuration and the Python runner fails closed on a mismatched host
         timezone. -->
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/extquotes.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/extquotes.stderr.log</string>

  <!-- Do NOT set KeepAlive (and never RunAtLoad/StartInterval): the session
       runner is finite; launchd respawns at the next StartCalendarInterval. -->
  <key>KeepAlive</key>
  <false/>

  <!-- ThrottleInterval: if the job exits within 10 s, wait 60 s before the
       next launch attempt (launchd's own throttle; there is no in-job retry). -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

</dict>
</plist>
