[Unit]
Description=Mastermind Ubuntu fleet storage pressure sentinel
Documentation=https://github.com/mastermindx-market-intelligence/macro
After=local-fs.target systemd-journald.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/libexec/mastermind-ubuntu-storage-guard.py --vacuum
TimeoutStartSec=420s
# The optional generated-pytest maintainer stays disarmed until separately qualified.
Nice=15
IOSchedulingClass=idle
MemoryMax=128M
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=no
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
