<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mastermind.runner-connectivity-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__HOME__/.local/share/mastermind-runtime/runner-watchdog/runner_connectivity_watchdog.py</string>
    <string>--repo</string>
    <string>mastermindx-market-intelligence/macro</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>120</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/mastermind-runner-connectivity-watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/mastermind-runner-connectivity-watchdog.err.log</string>
</dict>
</plist>
