[Unit]
Description=Update the Mastermind shared CI Git object cache
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/libexec/mastermind-ci-cache-update
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/cache/mastermind-ci /run/lock
UMask=0027

# The cache is disposable acceleration and must always yield to CI and render.
# The incremental validator normally stays below 300 MiB; these ceilings prevent
# an accidental return to the former 14+ GiB full-estate scan from jamming the host.
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
CPUQuota=100%
MemoryHigh=2G
MemoryMax=4G
TimeoutStartSec=5min
