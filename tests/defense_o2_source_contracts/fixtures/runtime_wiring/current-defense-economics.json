                "receipt_state": "byte_replayed",
                "source_url": "https://investors.l3harris.com/news/news-details/2026/L3Harris-Completes-Sale-of-Majority-Stake-in-Commercial-Space-Propulsion-Power-and-Electronics-Businesses-to-AE-Industrial-Partners/default.aspx",
                "span_id": "span_8f869313f284954d3309",
                "text_sha256": "08429a2994a26d3fd604d7edeec175e7b36f93b37bcab155f293522c179f3900"
              },
              "unit": "source_reported_terms",
              "value": "MELBOURNE, Fla.--(BUSINESS WIRE)-- L3Harris Technologies (NYSE: LHX) has completed the sale of a majority stake in its commercial space propulsion, power and electronics businesses to AE Industrial Partners at a total enterprise value of $845 million."
            },
            {
              "accounting_basis": "business_disposal:completed:retained_interest_scope",
              "fact_class": "reported_shareholder_terms",
              "fact_id": "evt_cik0000202058_2026q2_results:space_business_sale_retained_scope",
              "owner_ref": "event_workspace:883fb5c69607c3d248b45f7e:evt_cik0000202058_2026q2_results:disclosure_document_76b6defc800105f62704c435f4ea803c84a0cd2d8fa2fa055752b1a4ad70ab12",
              "period": "2026-08-04",
              "source_span": {
                "document_id": "disclosure_document_76b6defc800105f62704c435f4ea803c84a0cd2d8fa2fa055752b1a4ad70ab12",
                "receipt_state": "byte_replayed",
                "source_url": "https://investors.l3harris.com/news/news-details/2026/L3Harris-Completes-Sale-of-Majority-Stake-in-Commercial-Space-Propulsion-Power-and-Electronics-Businesses-to-AE-Industrial-Partners/default.aspx",
                "span_id": "span_6e87348dd609672e1f59",
                "text_sha256": "417ceaa97ccaeb7c6f7cf046e7f233932d16b89f939712ab1cc6bb4f96f53329"
              },
              "unit": "source_reported_terms",
              "value": "L3Harris\u2019 RS-25 rocket engine operations were excluded from the sale, and the company will maintain a ~40% ownership stake in AE Industrial Partners\u2019 new space technologies business, which will be named Rocketdyne."
            }
