{
  "schema": "global-regime-fragment.v1",
  "source_asof": "2026-09-24",
  "sha256": "37085581dc729b70ce6cf09c5ad232f1f58e16a966914a317b4792da9e43c24d",
  "html": "<style>\n/* ════════════════════════════════════════════════════════════════════════════════\n   .ud-hero — Unified Macro Dashboard hero (UD-B1, spec §1 / §3 / §5 / §7)\n\n   Verdict hero + score + progress bar + verdict rows + arc gauge (#3/#4/#5/#9/#10)\n   plus the regime spine (#11 quad map subsumed per spec §3) plus spec §6\n   \"What changed\" / \"Drivers\" / \"Watching\" / \"Go deeper\" blocks. Dark and light\n   are TWO art directions (per CLAUDE.md §Theme art direction): dark = command\n   center with luminance depth and restrained glow; light = research workspace\n   with cool canvas, hairline discipline, shadow instead of glow. Token swap\n   alone is never proof of a light design — the bloom→ring on the subject\n   marker is one of three intentionally differing mechanisms (see spec §5).\n   ════════════════════════════════════════════════════════════════════════════════ */\nbody.page-intl #ud-hero{ margin-top:0; }\nbody.page-intl .ud-hero-panel{\n  display:flex; flex-direction:column; gap:var(--sp-5,20px);\n}\nbody.page-intl .ud-hero-head{\n  display:flex; align-items:center; gap:var(--sp-3,12px);\n  font-family:var(--num,var(--font-mono));\n}\nbody.page-intl .ud-eyebrow{\n  font-size:11px; font-weight:700; letter-spacing:.2em; text-transform:uppercase;\n  color:var(--ink-2,var(--muted));\n}\nhtml[data-lang=\"zh\"] body.page-intl .ud-eyebrow{ letter-spacing:0; text-transform:none; }\n/* 390 floor — the EN uppercase + tracking still shreds the small eyebrow;\n   drop the tracking and uppercase so both locales render at the same weight. */\n@media (max-width:390px){\n  body.page-intl .ud-eyebrow{ letter-spacing:.04em; text-transform:none; font-size:10.5px; }\n}\nbody.page-intl .ud-live{\n  display:inline-flex; align-items:center; gap:6px;\n  font-size:11px; font-weight:700; letter-spacing:.04em;\n  color:var(--ink-2,var(--muted));\n}\nbody.page-intl .ud-live i{\n  width:7px; height:7px; border-radius:var(--r-pill,999px);\n  background:var(--ink-3,var(--muted));\n  box-shadow:0 0 0 3px color-mix(in srgb, var(--ink-3,var(--muted)) 18%, transparent);\n}\n/* R-D: live dot uses HEALTH tokens (ok/warn) — never direction tokens\n   (up/down), so it cannot flip red under the ZH 红涨绿跌 convention. */\nbody.page-intl .ud-live--ok i{\n  background:var(--ink-ok,var(--up));\n  box-shadow:0 0 0 3px color-mix(in srgb, var(--ink-ok,var(--up)) 22%, transparent);\n}\nbody.page-intl .ud-live--warn i{\n  background:var(--ink-warn,var(--warn));\n  box-shadow:0 0 0 3px color-mix(in srgb, var(--ink-warn,var(--warn)) 22%, transparent);\n}\nbody.page-intl .ud-asof{\n  margin-left:auto;\n  font-size:11px; letter-spacing:.04em; color:var(--ink-3,var(--muted));\n  font-variant-numeric:tabular-nums;\n}\n\n/* ── §1 grid: 660 copy + 316 gauge, space-between ────────────────────── */\nbody.page-intl .ud-hero-grid{\n  display:grid; grid-template-columns:660px 316px;\n  justify-content:space-between;\n  gap:var(--sp-5,20px) 36px; align-items:start;\n}\n@media (max-width:1280px){ body.page-intl .ud-hero-grid{ grid-template-columns:minmax(0,1fr) 316px; } }\n@media (max-width:860px){ body.page-intl .ud-hero-grid{ grid-template-columns:1fr; } }\n\nbody.page-intl .ud-verdict{\n  display:flex; flex-wrap:wrap; align-items:baseline; gap:0 10px;\n  font-size:var(--fs-display,46px); font-weight:800; line-height:.95;\n  letter-spacing:-.03em;\n  margin:4px 0 8px;\n}\nbody.page-intl .ud-verdict > .l-en,\nbody.page-intl .ud-verdict > .l-zh{\n  /* Per-locale phrase is its own flex item; the comma + qualifier are inline\n     within it so the gap can never strand the comma on its own line. The\n     inline-flex gap stays >0 so the comma hugs the verdict word with a real\n     word-space, never glued onto the next qualifier. */\n  display:inline-flex; align-items:baseline; flex-wrap:wrap;\n  row-gap:0; column-gap:0;\n}\nbody.page-intl .ud-verdict > .l-en .ud-verdict-comma{ margin-right:.25em; }\nbody.page-intl .ud-verdict > .l-en .ud-verdict-qualifier{ margin-left:.25em; }\nbody.page-intl .ud-verdict-comma{ font-weight:800; color:var(--ink-1,var(--text)); }\nhtml[data-lang=\"zh\"] body.page-intl .ud-verdict-comma{ display:none; }\nhtml[data-lang=\"zh\"] body.page-intl .ud-verdict{ letter-spacing:0; }\n@media (max-width:390px){\n  /* Spec §7 390: two-tone pair wraps to 2 lines at 36px, gauge below. */\n  body.page-intl .ud-verdict{ font-size:36px; }\n  body.page-intl .ud-verdict > .l-en, body.page-intl .ud-verdict > .l-zh{\n    flex-basis:100%;\n  }\n}\nbody.page-intl .ud-verdict-word--up{ color:var(--ink-up,var(--up)); }\nbody.page-intl .ud-verdict-word--down{ color:var(--ink-down,var(--down)); }\nbody.page-intl .ud-verdict-word--warn{ color:var(--ink-warn,var(--warn)); }\nbody.page-intl .ud-verdict-comma{ font-size:var(--fs-display,46px); font-weight:800; color:var(--ink-1,var(--text)); }\nbody.page-intl .ud-verdict-qualifier--warn{ color:var(--ink-warn,var(--warn)); }\nbody.page-intl .ud-verdict-qualifier--down{ color:var(--ink-down,var(--down)); }\nbody.page-intl .ud-verdict-qualifier--muted{ color:var(--ink-3,var(--muted)); }\n\nbody.page-intl .ud-clause,\nbody.page-intl .ud-flip{\n  margin:4px 0 0; max-width:62ch;\n  font-size:var(--fs-md,15px); color:var(--text);\n}\nbody.page-intl .ud-flip{ color:var(--ink-2,var(--muted)); font-size:var(--fs-sm,12.5px); }\n\nbody.page-intl .ud-meta{\n  display:flex; flex-wrap:wrap; gap:8px; margin-top:14px;\n}\nbody.page-intl .ud-fired-chip{\n  display:inline-flex; align-items:center; gap:6px;\n  font-size:var(--fs-label,11px); font-weight:700;\n  padding:4px 11px; border-radius:var(--r-pill,999px);\n  background:color-mix(in srgb, var(--act,var(--down)) 12%, var(--panel));\n  border:1px solid color-mix(in srgb, var(--act,var(--down)) 28%, var(--line));\n  color:color-mix(in srgb, var(--act,var(--down)) 78%, var(--text));\n}\n\n/* ── Gauge column ─────────────────────────────────────────────────────── */\nbody.page-intl .ud-hero-gauge{\n  display:flex; flex-direction:column; align-items:center; gap:8px;\n  padding:8px 6px 0;\n  border-left:1px solid var(--line);\n  padding-left:var(--sp-4,16px);\n}\n@media (max-width:860px){ body.page-intl .ud-hero-gauge{ border-left:0; padding-left:0; } }\nbody.page-intl .ud-score{\n  display:flex; align-items:baseline; gap:6px;\n  font-family:var(--num,var(--font-mono));\n}\nbody.page-intl .ud-score-num{ font-size:var(--fs-num-xl,38px); font-weight:800; color:var(--ink-1,var(--text)); line-height:1; font-variant-numeric:tabular-nums; }\nbody.page-intl .ud-score-out{ font-size:18px; font-weight:500; color:var(--muted); }\nbody.page-intl .ud-score-label{ font-size:11px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); }\nhtml[data-lang=\"zh\"] body.page-intl .ud-score-label{ letter-spacing:0; text-transform:none; }\n\nbody.page-intl .ud-prog-wrap{ width:100%; margin-top:10px; }\nbody.page-intl .ud-prog{\n  position:relative; height:8px; border-radius:var(--r-ctl,8px);\n  background:var(--tile,var(--panel2));\n}\nbody.page-intl .ud-prog-fill{\n  position:absolute; top:0; left:0; height:100%;\n  background:var(--up); border-radius:var(--r-ctl,8px);\n}\nbody.page-intl .ud-prog-tick{\n  position:absolute; top:-3px; width:1px; height:14px;\n  background:var(--ink-3,var(--muted)); opacity:.55;\n}\nbody.page-intl .ud-prog-pin{\n  position:absolute; top:50%; transform:translate(-50%,-50%);\n  width:3px; height:16px; background:var(--ink-1,var(--text)); border-radius:var(--r-ctl,8px);\n}\nbody.page-intl .ud-prog-anchors{\n  display:flex; justify-content:space-between;\n  margin-top:6px; font-size:var(--fs-micro,10px);\n  font-weight:600; color:var(--ink-3,var(--muted));\n  font-family:var(--num,var(--font-mono));\n}\nbody.page-intl .ud-prog-mid{ margin:0 auto; }\nhtml[data-lang=\"zh\"] body.page-intl .ud-prog-anchors{ letter-spacing:0; }\n\nbody.page-intl .ud-arc{ width:100%; max-width:220px; height:auto; margin-top:6px; }\nbody.page-intl .ud-arc-solid{ transition:stroke-dasharray .35s var(--ease-std,ease); }\nbody.page-intl .ud-arc-track{ stroke:var(--line); }\nbody.page-intl .ud-arc-stroke{ stroke:var(--up); }\n\n/* ── §3 spine host — namespaced, governed in theme.css ────────────────── */\nbody.page-intl .ud-spine-wrap{ margin-top:6px; }\nbody.page-intl .ud-spine-foot{\n  margin:8px 0 0;\n  font-size:var(--fs-micro,10px); color:var(--ink-3,var(--muted));\n  font-weight:400; line-height:1.5;\n}\n\n/* ── §6 What changed ──────────────────────────────────────────────────── */\nbody.page-intl .ud-changed{ margin-top:4px; }\nbody.page-intl .ud-changed .mx-chg-row{ padding:9px 0; }\n\n/* ── §6 Drivers 2×2 ───────────────────────────────────────────────────── */\nbody.page-intl .ud-drivers{ margin-top:8px; }\nbody.page-intl .ud-driver-grid{\n  display:grid; grid-template-columns:repeat(2,minmax(0,1fr));\n  gap:var(--gap-grid,18px);\n}\n@media (max-width:860px){ body.page-intl .ud-driver-grid{ grid-template-columns:1fr; } }\nbody.page-intl .ud-driver{\n  padding:14px 16px;\n  display:flex; flex-direction:column; gap:8px;\n}\nbody.page-intl .ud-driver-head{ font-size:var(--fs-h3,14px); font-weight:800; color:var(--ink-1,var(--text)); margin:0; }\nbody.page-intl .ud-driver-body{ margin:0; font-size:var(--fs-sm,12.5px); color:var(--ink-2,var(--muted)); }\nbody.page-intl .ud-driver--locked{ position:relative; padding:0; min-height:90px; overflow:hidden; }\nbody.page-intl .ud-driver--locked .mx-tier-blurred--spec{ padding:14px 16px; }\nbody.page-intl .ud-driver-lock{\n  position:absolute; inset:auto 0 0 0;\n  padding:6px 16px; font-size:11px; font-weight:700;\n  background:color-mix(in srgb, var(--panel) 88%, transparent);\n  text-align:center; color:var(--ink-2,var(--muted));\n}\n\n/* ── §6 Watching list — three if→what rows ───────────────────────────── */\nbody.page-intl .ud-watching{ margin-top:6px; }\nbody.page-intl .ud-watch-list{ list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:8px; }\nbody.page-intl .ud-watch-item{\n  padding:10px 14px;\n  border:1px solid color-mix(in srgb, var(--line) 60%, transparent);\n  border-radius:var(--r-ctl,8px);\n  background:var(--panel2);\n  font-size:var(--fs-sm,12.5px); color:var(--ink-2,var(--muted));\n  line-height:1.5;\n}\n/* Per-cell locale display law: BOTH head AND body cells paint in each locale.\n   EN locale hides ZH spans (global .l-zh{display:none}); ZH locale hides EN.\n   Pre-fix only unhide one head + one body, leaving the other two blank. */\nbody.page-intl .ud-watch-item-head{ display:none; font-weight:700; color:var(--ink-1,var(--text)); margin-bottom:4px; }\nbody.page-intl .ud-watch-item-body{ display:none; font-weight:400; line-height:1.5; color:var(--ink-2,var(--muted)); }\nhtml:not([data-lang=\"zh\"]) body.page-intl .ud-watch-item-head.l-en{ display:block; }\nhtml:not([data-lang=\"zh\"]) body.page-intl .ud-watch-item-body.l-en{ display:block; }\nhtml[data-lang=\"zh\"] body.page-intl .ud-watch-item-head.l-zh{ display:block; }\nhtml[data-lang=\"zh\"] body.page-intl .ud-watch-item-body.l-zh{ display:block; }\n/* Each .ud-watch-item is a flex row carrying head + body cells. */\nbody.page-intl .ud-watch-item{ display:flex; flex-direction:column; gap:2px; }\n/* Desktop: full list visible (force-open via specificity that beats the UA\n   `details:not([open]) > :not(summary) { display: none }` rule — this selector\n   has (0,3,3) vs the UA's (0,2,2)), summary row hidden, <details> marker\n   hidden so the summary doesn't render its disclosure triangle at 1440. R-J\n   round 7 — the wrapper is now <details><summary>…</summary><ul>…</ul></details>\n   for tap-open semantics at 390, but desktop forces the list open via CSS. */\nbody.page-intl .ud-watch-details:not([open]) .ud-watch-list{ list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:8px; }\nbody.page-intl .ud-watch-summary{ display:none; }\nbody.page-intl .ud-watch-details > summary::-webkit-details-marker{ display:none; }\nbody.page-intl .ud-watch-details > summary{ list-style:none; }\nbody.page-intl .ud-driver-count{ display:none; }\n\n/* ── §6 Go deeper chip rail ──────────────────────────────────────────── */\nbody.page-intl .ud-deeper{ margin-top:6px; }\nbody.page-intl .ud-deeper-rail{\n  display:flex; flex-wrap:wrap; gap:8px;\n}\nbody.page-intl .ud-depth{\n  display:inline-flex; align-items:center;\n  padding:6px 12px;\n  font-size:var(--fs-sm,12.5px); font-weight:600;\n  background:var(--panel2); border:1px solid var(--line);\n  border-radius:var(--r-pill,999px); color:var(--text);\n  text-decoration:none;\n  transition:border-color .14s var(--ease-std,ease), background .14s var(--ease-std,ease);\n}\nbody.page-intl .ud-depth:hover{\n  border-color:color-mix(in srgb, var(--link) 50%, var(--line));\n  background:color-mix(in srgb, var(--link) 6%, var(--panel2));\n}\n\n/* ── Page footer (spec §6) ────────────────────────────────────────────── */\nbody.page-intl .ud-foot{\n  margin-top:8px; padding-top:14px;\n  border-top:1px solid var(--line);\n  font-size:var(--fs-micro,10px); color:var(--ink-3,var(--muted));\n  text-align:center;\n}\n\n/* ── Light theme: depth + bloom→ring + ink rungs (spec §5 row 2/3/8) ──\n   Three mechanisms intentionally differ:\n     • panel surface switches from panel2-tinted to pure panel-white with\n       a 1px ring + soft cast shadow (the canvas stays perceptibly cooler).\n     • the subject marker bloom becomes a 2px ring (a pastel stain on white).\n     • the arc stroke darkens to --up-light for 4.5:1 on white. */\nhtml[data-theme=\"light\"] body.page-intl .ud-hero-panel{\n  background:var(--panel);\n  box-shadow:0 1px 3px color-mix(in srgb, var(--text) 7%, transparent),\n             0 0 0 1px color-mix(in srgb, var(--text) 6%, transparent);\n}\nhtml[data-theme=\"light\"] body.page-intl .ud-arc-stroke{ stroke:var(--up); }\n\n/* ── Mobile 390 reduction (spec §7) — declarative re-composition ────── */\n@media (max-width:390px){\n  body.page-intl .ud-hero-grid{ grid-template-columns:1fr; gap:var(--sp-4,16px); }\n  body.page-intl .ud-verdict{ font-size:36px; }\n  body.page-intl .ud-driver-grid{ gap:var(--sp-3,12px); }\n}\n/* ── Mobile 640 reduction — spine as stacked cards (spec §7 row 1) ────\n   Stance chip joins the name on row 1; the rail + travel form row 2;\n   column heads hide. The .mockup-spine-390 wrapper class also forces the\n   640 layout at any viewport so the specimen page previews the floor. */\n@media (max-width:640px){\n  body.page-intl .mx-spine-head{ display:none; }\n  body.page-intl .mx-spine-row{\n    grid-template-columns:1fr;\n    grid-template-areas:\n      \"name stance\"\n      \"rail  rail\"\n      \"travel travel\";\n    gap:6px 10px;\n    padding:12px 4px;\n  }\n  body.page-intl .mx-spine-row[data-null=\"1\"]{ grid-template-areas:\"name stance\" \"rail rail\"; }\n  body.page-intl .mx-spine-name{ grid-area:name; }\n  body.page-intl .mx-spine-rail-wrap{ grid-area:rail; }\n  body.page-intl .mx-spine-travel{ grid-area:travel; justify-content:flex-end; }\n  body.page-intl .mx-spine-stance{ grid-area:stance; justify-content:flex-end; }\n  /* Display the same in the specimen via .mockup-spine-390 wrapper class. */\n  .mockup-spine-390 .mx-spine-head{ display:none; }\n  .mockup-spine-390 .mx-spine-row{\n    grid-template-columns:1fr;\n    grid-template-areas:\n      \"name stance\"\n      \"rail  rail\"\n      \"travel travel\";\n    gap:6px 10px;\n    padding:12px 4px;\n  }\n  .mockup-spine-390 .mx-spine-row[data-null=\"1\"]{ grid-template-areas:\"name stance\" \"rail rail\"; }\n  .mockup-spine-390 .mx-spine-name{ grid-area:name; }\n  .mockup-spine-390 .mx-spine-rail-wrap{ grid-area:rail; }\n  .mockup-spine-390 .mx-spine-travel{ grid-area:travel; justify-content:flex-end; }\n  .mockup-spine-390 .mx-spine-stance{ grid-area:stance; justify-content:flex-end; }\n}\n\n/* ── Mobile 390 reduction (spec §7) — declarative re-composition ──────\n   1. Verdict two-tone pair wraps to 2 lines at 36px (no mid-word hyphen).\n   2. Drivers become a horizontal SWIPE STRIP — cards at ~86% width, with a\n      `1 / 3` counter overlay; the clipped second card is the affordance.\n      Locked (#4) hidden — same demotion rule as the desktop locked content.\n   3. Watching collapses to ONE DISCLOSURE ROW — title, count `3`, chevron,\n      plus a one-line preview of the first condition. Windows footnote stays. */\n@media (max-width:390px){\n  body.page-intl .ud-hero-grid{ grid-template-columns:1fr; gap:var(--sp-4,16px); }\n  body.page-intl .ud-verdict{ font-size:36px; }\n\n  /* Drivers → swipe strip. */\n  body.page-intl .ud-driver-grid{\n    display:flex; flex-wrap:nowrap; gap:12px; overflow-x:auto;\n    grid-template-columns:none;\n    scroll-snap-type:x mandatory;\n    padding-bottom:4px;\n    margin:0 -8px; padding-left:8px; padding-right:8px;\n  }\n  body.page-intl .ud-driver{\n    flex:0 0 86%; scroll-snap-align:start; min-width:0;\n  }\n  body.page-intl .ud-driver--locked{ display:none; }\n\n  /* Driver counter chip — `1 / 3` badge that floats over the strip's right\n     edge. Hidden at desktop; the swipe strip at 390 is the affordance. */\n  body.page-intl .ud-driver-count{ display:inline-flex; }\n}\n/* end .ud-hero — UD-B1 §1/§3/§6 */\n\n/* ── Mobile ≤640px watching disclosure (R-L BLOCKER-1 fix) ─────────────\n   At ≤640px the inline state JS in templates/dashboard.html.j2 removes the\n   `open` attribute on .ud-watch-details so the <summary> disclosure row takes\n   over. The summary chrome shows by default; the list is hidden until the\n   user taps the disclosure row (the UA `:not([open])` rule handles that —\n   CSS cannot override it, which is why the DOM state is the lawful fix). */\n@media (max-width:640px){\n  body.page-intl .ud-watch-item{ display:none; }\n  body.page-intl .ud-watch-details[open] .ud-watch-item{ display:flex; }\n  body.page-intl .ud-watch-summary{\n    display:flex; flex-direction:column; align-items:stretch; gap:6px;\n    padding:10px 14px;\n    border:1px solid color-mix(in srgb, var(--line) 60%, transparent);\n    border-radius:var(--r-ctl,8px);\n    background:var(--panel2);\n    cursor:pointer;\n  }\n  body.page-intl .ud-watch-summary-row{\n    display:flex; align-items:center; gap:10px;\n  }\n  body.page-intl .ud-watch-summary-h{ flex:1; font-weight:700; color:var(--ink-1,var(--text)); }\n  body.page-intl .ud-watch-summary-ct{\n    font-size:var(--fs-sm,12.5px); font-weight:600;\n    color:var(--ink-2,var(--muted));\n  }\n  body.page-intl .ud-watch-summary-chev{\n    color:var(--ink-2,var(--muted)); font-size:18px;\n  }\n  body.page-intl .ud-watch-summary-preview{\n    font-size:var(--fs-sm,12.5px); line-height:1.5;\n    color:var(--ink-2,var(--muted));\n  }\n}\n</style>\n\n\n<style>\n#ud-hero .ud-live--snapshot i{background:var(--muted);box-shadow:none;}\n/* UD-B2-W2: spine caveat disclosure — engine-verbatim lighter-evidence note.\n   Scope-narrowed to this hero template (the spine is a UD-B1 + UD-B2-W2\n   construct, never re-used elsewhere). Token-scoped only: every value is\n   a var() reference, no hex / rgba / colour-function / radius literal /\n   inline custom-property literal. This stays in the template (not\n   templates/theme.css) to keep the THEME-CLOSURE re-bind sweep out of\n   this PR's scope — the new rule only fires on the new .mx-spine-caveat\n   class, which is unique to the HK + CN bound rows. */\n.mx-spine-caveat{\n  margin-top:6px;\n  padding: 4px 8px;\n  border-left: 2px solid var(--line);\n  border-radius: var(--r-ctl,8px);\n  font-size: var(--fs-micro);\n  line-height: 1.45;\n  color: var(--ink-2);\n}\nhtml[data-theme=\"light\"] .mx-spine-caveat{ color: var(--ink-3); }\n\n/* UD-B2-W3 Drivers fold (R1 leadership tile, #33+#34 sentiment counterpart,\n   R6 breadth chip). Token-scoped only: every value is a var() reference.\n   Dark: luminance step on --panel2 rails. Light: hairline ring on the same\n   rails so the two treatments are not a token recolour. Scope-narrowed to\n   this hero so THEME-CLOSURE does not pull templates/theme.css into the PR. */\n.ud-driver-chip{ align-self:flex-start; margin-top:auto; }\n.ud-driver-leg{ display:flex; flex-direction:column; gap:var(--sp-2,8px); }\n/* Spec §7: 390 hides the locked fourth card so the swipe is 1 / 3.\n   theme.css already declares this under body.page-macro; repeat it here\n   so the isolated evidence fixture (hero partial + theme.css) cannot\n   lose the hide if the live class ever drifts. */\n@media (max-width:390px){\n  .ud-driver--locked{ display:none; }\n}\n.ud-sent-lenses{ display:flex; flex-direction:column; gap:var(--sp-2,8px); }\n.ud-sent-lens{ display:flex; flex-direction:column; gap:4px; }\n.ud-sent-lens-name{\n  font-size:var(--fs-micro);\n  font-weight:700;\n  color:var(--ink-3);\n}\n.ud-sent-rail{\n  position:relative;\n  height:6px;\n  background:var(--panel2);\n  border-radius:var(--r-ctl);\n}\n.ud-sent-pin{\n  position:absolute;\n  top:-2px;\n  width:2px;\n  height:10px;\n  background:var(--ink-1);\n}\nhtml[data-theme=\"light\"] .ud-sent-rail{\n  background:var(--panel);\n  box-shadow:0 0 0 1px var(--line);\n}\n.ud-froth-row{ display:flex; align-items:center; gap:8px; }\n.ud-froth-lbl{\n  font-size:var(--fs-micro);\n  color:var(--ink-3);\n  flex:0 0 auto;\n}\n.ud-froth-track{\n  flex:1;\n  height:4px;\n  background:var(--panel2);\n  border-radius:var(--r-ctl);\n  overflow:hidden;\n}\n.ud-froth-fill{ height:100%; background:var(--warn); }\n.ud-froth-fill--b{ background:var(--act); }\nhtml[data-theme=\"light\"] .ud-froth-track{\n  background:var(--panel);\n  box-shadow:0 0 0 1px var(--line);\n}\n</style>\n\n<section class=\"ud-hero panel span12 ud-hero-panel\" id=\"ud-hero\" data-regime-scope=\"us-reference\" aria-labelledby=\"ud-hero-h\">\n  <div class=\"ud-hero-inner\">\n\n    \n    <header class=\"ud-hero-head\">\n      <span class=\"ud-eyebrow\">\n        <span class=\"l-en\">Global markets · Regime read</span><span class=\"l-zh\">全球市场 · 状态判读</span>\n      </span>\n      <span class=\"ud-live ud-live--snapshot\">\n        <i aria-hidden=\"true\"></i><span class=\"l-en\">Snapshot</span><span class=\"l-zh\">快照</span>\n      </span>\n      <span class=\"ud-asof tnum\" aria-label=\"as-of\"><span class=\"l-en\">2026-09-24</span><span class=\"l-zh\">2026-09-24</span></span>\n    </header>\n\n    \n    <div class=\"ud-hero-grid\">\n      <div class=\"ud-hero-copy\">\n        \n        <p class=\"ud-clause ud-scope-note\"><span class=\"l-en\">Headline and dial: US regime (SPY / QQQ / IWM), not a global composite. Each market row retains its own evidence and date.</span><span class=\"l-zh\">标题与仪表反映美国市场状态（SPY / QQQ / IWM），并非全球综合评分。各市场行保留独立证据与日期。</span></p>\n        \n        \n        <h1 class=\"ud-verdict\" id=\"ud-hero-h\">\n          \n          <span class=\"l-en\"><span class=\"l-en ud-verdict-word ud-verdict-word--warn\">Mixed</span><span class=\"ud-verdict-comma l-en\">,</span> <span class=\"ud-verdict-qualifier ud-verdict-qualifier--muted l-en\">steady</span></span>\n          <span class=\"l-zh\"><span class=\"l-zh ud-verdict-word ud-verdict-word--warn\">混合</span><span class=\"ud-verdict-qualifier ud-verdict-qualifier--muted l-zh\">趋稳</span></span>\n        </h1>\n        <p class=\"ud-clause l-en\">Mixed / transition — the signals disagree. Trade smaller, favour quality, take profits faster; don&#39;t position aggressively.</p>\n        <p class=\"ud-clause l-zh\">混合 / 转换 — 信号分歧。缩小仓位、偏好质量、更快获利了结；勿激进布局。</p>\n        <p class=\"ud-flip l-en\">→ Green if the act-level alert clears. → Red if trend &amp; technicals and risk appetite both break down (now 65, 85/100).</p>\n        <p class=\"ud-flip l-zh\">→ 若行动级警报解除，则转「偏多」。→ 若趋势与技术与风险偏好同时走坏（现 65、85/100），则转「避险」。</p>\n\n        <div class=\"ud-meta\">\n          <span class=\"mx-stance mx-stance--warn\">\n            <span class=\"l-en\">Watch — don’t chase</span><span class=\"l-zh\">观察，勿追</span>\n          </span>\n          <span class=\"ud-fired-chip\" data-tip-en=\"65 fired conditions today.\" data-tip-zh=\"今日有 65 条触发。\">\n            <span class=\"l-en\">65 fired conditions today.</span><span class=\"l-zh\">今日有 65 条触发。</span>\n          </span>\n        </div>\n\n        \n        <div class=\"ud-callout mx-callout\">\n          <b class=\"l-en\">Read the dial with care:</b><b class=\"l-zh\">读数注意：</b>\n          <span class=\"l-en\"> the composite is capped this week while one input rebuilds — see the dial on the right.</span>\n          <span class=\"l-zh\">本周综合读数封顶——一项输入正在重建，请查看右侧仪表。</span>\n        </div>\n      </div>\n\n      \n      <div class=\"ud-hero-gauge\" aria-label=\"regime score\">\n        <div class=\"ud-score\">\n          <span class=\"ud-score-num tnum\" data-role=\"score\">59</span><span class=\"ud-score-out tnum\">/100</span>\n        </div>\n        <div class=\"ud-score-label\">\n          <span class=\"l-en\">US regime score</span><span class=\"l-zh\">美国状态评分</span>\n        </div>\n\n        \n        <div class=\"ud-prog-wrap\" aria-hidden=\"true\">\n          <div class=\"ud-prog\">\n            <span class=\"ud-prog-tick\" style=\"left:42%\"></span>\n            <span class=\"ud-prog-tick\" style=\"left:60%\"></span>\n            <span class=\"ud-prog-tick\" style=\"left:25%\"></span>\n            <span class=\"ud-prog-tick\" style=\"left:75%\"></span>\n            <i class=\"ud-prog-pin\" style=\"left:59.0%\"></i>\n            <span class=\"ud-prog-fill\" style=\"width:59%\"></span>\n          </div>\n          <div class=\"ud-prog-anchors\">\n            <span class=\"l-en\">Risk-off</span><span class=\"l-zh\">避险</span>\n            <span class=\"ud-prog-mid\"><span class=\"l-en\">Mixed</span><span class=\"l-zh\">混合</span></span>\n            <span class=\"l-en\">Risk-on</span><span class=\"l-zh\">趋险</span>\n          </div>\n        </div>\n\n        \n        <svg class=\"ud-arc\" viewBox=\"0 0 220 130\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\"\n             aria-label=\"regime score arc, value 59 of 100\">\n          \n          <path d=\"M 20 110 A 90 90 0 0 1 200 110\" fill=\"none\"\n                class=\"ud-arc-track\" stroke-width=\"6\" stroke-linecap=\"round\" opacity=\".55\"/><path d=\"M 20 110 A 90 90 0 0 1 200 110\" fill=\"none\"\n                class=\"ud-arc-stroke\" stroke-width=\"6\" stroke-linecap=\"round\"\n                stroke-dasharray=\"166.82 999\"/>\n          <path d=\"M 20 110 A 90 90 0 0 1 200 110\" fill=\"none\"\n                class=\"ud-arc-stroke\" stroke-width=\"6\" stroke-linecap=\"round\"\n                stroke-dasharray=\"2.83 999\"\n                stroke-dashoffset=\"-166.82\"\n                opacity=\".26\"/>\n        </svg>\n      </div>\n    </div>\n\n    \n    <div class=\"ud-spine-wrap\">\n      <div class=\"mx-sec\">\n        <h3 class=\"l-en\">Where this shows up</h3><h3 class=\"l-zh\">这一状态体现在哪里</h3>\n        <small class=\"mx-asof l-en\">One scale, five markets — where each sits, and which way it moved.</small>\n        <small class=\"mx-asof l-zh\">同一标尺，五个市场——各自位置，以及本月移动方向。</small>\n      </div>\n\n      <div class=\"mx-spine\" data-spec=\"ud-b1\">\n        <div class=\"mx-spine-head\" aria-hidden=\"true\">\n          <span><span class=\"l-en\">Market</span><span class=\"l-zh\">市场</span></span>\n          <span><span class=\"l-en\">Where it sits today</span><span class=\"l-zh\">今日位置</span></span>\n          <span><span class=\"l-en\">Moved</span><span class=\"l-zh\">本月移动</span></span>\n          <span><span class=\"l-en\">What to do</span><span class=\"l-zh\">该怎么做</span></span>\n        </div>\n\n        \n        <div class=\"mx-spine-row\" data-subject=\"1\" data-state=\"real\" data-stance=\"watch\">\n          <div class=\"mx-spine-name\"><span class=\"l-en\">US stocks</span><span class=\"l-zh\">美股</span></div>\n          <div class=\"mx-spine-rail-wrap\">\n            <div class=\"mx-spine-rail\">\n              <div class=\"mx-spine-n25\"></div><div class=\"mx-spine-n50\"></div><div class=\"mx-spine-n75\"></div><div class=\"mx-spine-prev\" style=\"left:76%\"></div>\n              <div class=\"mx-spine-conn\" style=\"left:59%;width:17%\"></div>\n              <div class=\"mx-spine-mark\" style=\"left:59%\"></div>\n            </div>\n            <div class=\"mx-spine-anchors\"><span class=\"l-en\">Risk-off</span><span class=\"l-zh\">避险</span><span class=\"mx-spine-a-mid\"><span class=\"l-en\">Neutral</span><span class=\"l-zh\">中性</span></span><span><span class=\"l-en\">Risk-on</span><span class=\"l-zh\">趋险</span></span></div>\n          </div>\n          <div class=\"mx-spine-travel\"><span class=\"mx-spine-arrow\" aria-hidden=\"true\">←</span><span class=\"tnum\">−17</span></div>\n          <div class=\"mx-spine-stance\"><span class=\"mx-stance mx-stance--warn\"><span class=\"l-en\">Watch — don’t chase</span><span class=\"l-zh\">观察，勿追</span></span></div>\n        </div>\n\n        <div class=\"mx-spine-row\" data-market=\"hk\" data-state=\"real\" data-blocked-feed=\"hk_market_state\"\n             data-stance=\"stand-aside\"\n             data-caveat-en=\"Display-only and lighter than the US read: HK has no leading Risk Radar, no VIX term structure (VHSI stands in), and the downturn gauges are uncalibrated. HK is heavily globally driven — US/EM beta and the HKD peg. Context, not a forecast.\" data-caveat-zh=\"仅供展示，较美股版更轻量：港股没有领先的风险雷达、没有 VIX 期限结构（以 VHSI 替代），下行指标未经校准。港股高度受全球驱动 — 美股／新兴市场贝塔与港元联汇。是背景，而非预测。\">\n          <div class=\"mx-spine-name\">\n            <span class=\"l-en\">Hong Kong</span><span class=\"l-zh\">香港</span>\n          </div>\n          <div class=\"mx-spine-rail-wrap\">\n            <div class=\"mx-spine-rail\">\n              <div class=\"mx-spine-n25\"></div><div class=\"mx-spine-n50\"></div><div class=\"mx-spine-n75\"></div><div class=\"mx-spine-prev\" style=\"left:55.0%\"></div>\n              <div class=\"mx-spine-conn\" style=\"left:38%;width:17.0%\"></div>\n              <div class=\"mx-spine-mark\" style=\"left:38%\"></div>\n            </div>\n            <div class=\"mx-spine-anchors\"><span class=\"l-en\">Risk-off</span><span class=\"l-zh\">避险</span><span class=\"mx-spine-a-mid\"><span class=\"l-en\">Neutral</span><span class=\"l-zh\">中性</span></span><span><span class=\"l-en\">Risk-on</span><span class=\"l-zh\">趋险</span></span></div><div class=\"mx-spine-caveat\">\n              <span class=\"l-en\" aria-label=\"As of 2026-09-24. Display-only and lighter than the US read: HK has no leading Risk Radar, no VIX term structure (VHSI stands in), and the downturn gauges are uncalibrated. HK is heavily globally driven — US/EM beta and the HKD peg. Context, not a forecast.\">As of 2026-09-24. Display-only and lighter than the US read: HK has no leading Risk Radar, no VIX term structure (VHSI stands in), and the downturn gauges are uncalibrated. HK is heavily globally driven — US/EM beta and the HKD peg. Context, not a forecast.</span><span class=\"l-zh\" aria-label=\"截至 2026-09-24。仅供展示，较美股版更轻量：港股没有领先的风险雷达、没有 VIX 期限结构（以 VHSI 替代），下行指标未经校准。港股高度受全球驱动 — 美股／新兴市场贝塔与港元联汇。是背景，而非预测。\">截至 2026-09-24。仅供展示，较美股版更轻量：港股没有领先的风险雷达、没有 VIX 期限结构（以 VHSI 替代），下行指标未经校准。港股高度受全球驱动 — 美股／新兴市场贝塔与港元联汇。是背景，而非预测。</span>\n            </div>\n          </div>\n          <div class=\"mx-spine-travel\"><span class=\"mx-spine-arrow\" aria-hidden=\"true\">←</span><span class=\"tnum\">−17</span></div>\n          <div class=\"mx-spine-stance\"><span class=\"mx-stance mx-stance--muted\"><span class=\"l-en\">Stand aside</span><span class=\"l-zh\">暂时观望</span></span></div>\n        </div>\n\n        <div class=\"mx-spine-row\" data-market=\"cn\" data-state=\"real\" data-blocked-feed=\"cn_market_state\"\n             data-stance=\"stand-aside\"\n             data-caveat-en=\"Display-only and lighter than the US read: China has no leading Risk Radar, no VIX term structure (QVIX + margin froth stand in), no HY credit spread, and the downturn gauges are uncalibrated. It reads what has already turned — context, not a forecast.\" data-caveat-zh=\"仅供展示，较美股版更轻量：A股没有领先的风险雷达、没有 VIX 期限结构（以 QVIX 与融资拥挤替代）、没有高收益信用利差，且下行指标未经校准。它读取的是已经转向的信号 — 是背景，而非预测。\">\n          <div class=\"mx-spine-name\">\n            <span class=\"l-en\">China A-shares</span><span class=\"l-zh\">A股</span>\n          </div>\n          <div class=\"mx-spine-rail-wrap\">\n            <div class=\"mx-spine-rail\">\n              <div class=\"mx-spine-n25\"></div><div class=\"mx-spine-n50\"></div><div class=\"mx-spine-n75\"></div><div class=\"mx-spine-prev\" style=\"left:39%\"></div>\n              <div class=\"mx-spine-conn\" style=\"left:38%;width:1%\"></div>\n              <div class=\"mx-spine-mark\" style=\"left:38%\"></div>\n            </div>\n            <div class=\"mx-spine-anchors\"><span class=\"l-en\">Risk-off</span><span class=\"l-zh\">避险</span><span class=\"mx-spine-a-mid\"><span class=\"l-en\">Neutral</span><span class=\"l-zh\">中性</span></span><span><span class=\"l-en\">Risk-on</span><span class=\"l-zh\">趋险</span></span></div><div class=\"mx-spine-caveat\">\n              <span class=\"l-en\" aria-label=\"As of 2026-09-24. Display-only and lighter than the US read: China has no leading Risk Radar, no VIX term structure (QVIX + margin froth stand in), no HY credit spread, and the downturn gauges are uncalibrated. It reads what has already turned — context, not a forecast.\">As of 2026-09-24. Display-only and lighter than the US read: China has no leading Risk Radar, no VIX term structure (QVIX + margin froth stand in), no HY credit spread, and the downturn gauges are uncalibrated. It reads what has already turned — context, not a forecast.</span><span class=\"l-zh\" aria-label=\"截至 2026-09-24。仅供展示，较美股版更轻量：A股没有领先的风险雷达、没有 VIX 期限结构（以 QVIX 与融资拥挤替代）、没有高收益信用利差，且下行指标未经校准。它读取的是已经转向的信号 — 是背景，而非预测。\">截至 2026-09-24。仅供展示，较美股版更轻量：A股没有领先的风险雷达、没有 VIX 期限结构（以 QVIX 与融资拥挤替代）、没有高收益信用利差，且下行指标未经校准。它读取的是已经转向的信号 — 是背景，而非预测。</span>\n            </div>\n          </div>\n          <div class=\"mx-spine-travel\"><span class=\"mx-spine-arrow\" aria-hidden=\"true\">←</span><span class=\"tnum\">−1</span></div>\n          <div class=\"mx-spine-stance\"><span class=\"mx-stance mx-stance--muted\"><span class=\"l-en\">Stand aside</span><span class=\"l-zh\">暂时观望</span></span></div>\n        </div>\n\n        \n        <div class=\"mx-spine-row\" data-null=\"1\" data-blocked-feed=\"gov_bonds_regime\">\n          <div class=\"mx-spine-name\"><span class=\"l-en\">Government bonds</span><span class=\"l-zh\">国债</span><small>—</small></div>\n          <div class=\"mx-spine-rail-wrap\"><div class=\"mx-spine-rail\"><div class=\"mx-spine-n25\"></div><div class=\"mx-spine-n50\"></div><div class=\"mx-spine-n75\"></div></div><div class=\"mx-spine-anchors\"><span class=\"l-en\">Risk-off</span><span class=\"l-zh\">避险</span><span class=\"mx-spine-a-mid\"><span class=\"l-en\">Neutral</span><span class=\"l-zh\">中性</span></span><span><span class=\"l-en\">Risk-on</span><span class=\"l-zh\">趋险</span></span></div></div>\n          <div class=\"mx-spine-travel\"><span class=\"muted l-en\">—</span><span class=\"muted l-zh\">—</span></div>\n          <div class=\"mx-spine-stance\"><span class=\"mx-stance mx-stance--muted\"><span class=\"l-en\">Read being updated</span><span class=\"l-zh\">判读更新中</span></span></div>\n        </div>\n        <div class=\"mx-spine-row\" data-null=\"1\" data-blocked-feed=\"commodities_regime\">\n          <div class=\"mx-spine-name\"><span class=\"l-en\">Commodities</span><span class=\"l-zh\">大宗商品</span><small>—</small></div>\n          <div class=\"mx-spine-rail-wrap\"><div class=\"mx-spine-rail\"><div class=\"mx-spine-n25\"></div><div class=\"mx-spine-n50\"></div><div class=\"mx-spine-n75\"></div></div><div class=\"mx-spine-anchors\"><span class=\"l-en\">Risk-off</span><span class=\"l-zh\">避险</span><span class=\"mx-spine-a-mid\"><span class=\"l-en\">Neutral</span><span class=\"l-zh\">中性</span></span><span><span class=\"l-en\">Risk-on</span><span class=\"l-zh\">趋险</span></span></div></div>\n          <div class=\"mx-spine-travel\"><span class=\"muted l-en\">—</span><span class=\"muted l-zh\">—</span></div>\n          <div class=\"mx-spine-stance\"><span class=\"mx-stance mx-stance--muted\"><span class=\"l-en\">Read being updated</span><span class=\"l-zh\">判读更新中</span></span></div>\n        </div>\n      </div>\n      <p class=\"ud-spine-foot\">\n        <span class=\"l-en\">Positions are this week’s read on a shared scale — not price performance.</span>\n        <span class=\"l-zh\">位置是本周在同一标尺上的判读，并非价格涨跌幅。</span>\n      </p>\n    </div>\n\n    \n    <div class=\"ud-changed\">\n      <div class=\"mx-sec\">\n        <h3 class=\"l-en\">What changed since last look</h3><h3 class=\"l-zh\">与上次相比的变化</h3>\n        <small class=\"mx-asof l-en\">Each row is one fired condition from the alert log.</small>\n        <small class=\"mx-asof l-zh\">每行对应触发日志中的一次触发。</small>\n      </div>\n        <div class=\"mx-chg-row\">\n          <span class=\"mx-chg-name tnum\"><span class=\"l-en\">Recent</span><span class=\"l-zh\">最近</span></span>\n          <span class=\"mx-chg-what\"><span class=\"l-en\">Hidden fragility: a calm surface (cheap VIX, contango) over weakening internals (thinning breadth, HY widening) — the classic complacent pre-drawdown setup</span><span class=\"l-zh\">隐性脆弱：平静表象（低VIX、contango）下内部走弱（宽度变薄、HY走阔）— 典型的自满型回撤前夜</span>\n          </span>\n          <span class=\"mx-stance mx-stance--warn\">\n            <span class=\"l-en\">Watch</span><span class=\"l-zh\">观察</span>\n          </span>\n          <span class=\"mx-chg-chev\">›</span>\n        </div>\n        <div class=\"mx-chg-row\">\n          <span class=\"mx-chg-name tnum\"><span class=\"l-en\">Recent</span><span class=\"l-zh\">最近</span></span>\n          <span class=\"mx-chg-what\"><span class=\"l-en\">Equity risk-state crossed into ELEVATED (69/100) — positioning/vol/breadth fragility building; de-gross, favor entries over chasing leaders</span><span class=\"l-zh\">股票风险状态进入偏高区（69/100）— 仓位/波动/宽度脆弱性上升；降低敞口、择优入场而非追高</span>\n          </span>\n          <span class=\"mx-stance mx-stance--warn\">\n            <span class=\"l-en\">Watch</span><span class=\"l-zh\">观察</span>\n          </span>\n          <span class=\"mx-chg-chev\">›</span>\n        </div>\n        <div class=\"mx-chg-row\">\n          <span class=\"mx-chg-name tnum\"><span class=\"l-en\">Recent</span><span class=\"l-zh\">最近</span></span>\n          <span class=\"mx-chg-what\"><span class=\"l-en\">XLE: XOM weight +3.21pp beyond price (≈+$1.3B est. rebalance flow) (accumulating), 2026-09-17..2026-09-22 — cycle BOTTOMING·BUY SETUP</span><span class=\"l-zh\">XLE：XOM 权重较价格多变动 +3.21pp（≈+$1.3B 估算再平衡资金流）（增持），2026-09-17..2026-09-22 — 周期 筑底中·买入预备</span>\n          </span>\n          <span class=\"mx-stance mx-stance--warn\">\n            <span class=\"l-en\">Watch</span><span class=\"l-zh\">观察</span>\n          </span>\n          <span class=\"mx-chg-chev\">›</span>\n        </div>\n        <div class=\"mx-chg-row\">\n          <span class=\"mx-chg-name tnum\"><span class=\"l-en\">Recent</span><span class=\"l-zh\">最近</span></span>\n          <span class=\"mx-chg-what\"><span class=\"l-en\">XLE: CVX weight +2.67pp beyond price (≈+$1.1B est. rebalance flow) (accumulating), 2026-09-17..2026-09-22 — cycle BOTTOMING·BUY SETUP</span><span class=\"l-zh\">XLE：CVX 权重较价格多变动 +2.67pp（≈+$1.1B 估算再平衡资金流）（增持），2026-09-17..2026-09-22 — 周期 筑底中·买入预备</span>\n          </span>\n          <span class=\"mx-stance mx-stance--warn\">\n            <span class=\"l-en\">Watch</span><span class=\"l-zh\">观察</span>\n          </span>\n          <span class=\"mx-chg-chev\">›</span>\n        </div>\n    </div>\n\n    \n    <div class=\"ud-drivers\">\n      <div class=\"mx-sec\">\n        <h3 class=\"l-en\">Why — the three things moving this read</h3><h3 class=\"l-zh\">为什么 — 推动本次判读的三件事</h3>\n        <span class=\"ud-driver-count\" aria-hidden=\"true\"><span class=\"l-en\">1 of 3</span><span class=\"l-zh\">1 / 3</span></span>\n      </div>\n      <div class=\"ud-driver-grid\">\n\n        <div class=\"panel ud-driver\" data-driver=\"mtf\">\n          <b class=\"ud-driver-head\"><span class=\"l-en\">Uptrend</span><span class=\"l-zh\">上升趋势</span></b>\n          <div class=\"ud-driver-leg\" data-driver=\"leadership\" data-contract=\"market_state.radar.cycle.sector_bias\">\n            <p class=\"ud-driver-body l-en\">Under the surface: Health Care / Staples / Utilities have held while Energy / Discretionary faded — a rotation read, not a chase cue.</p>\n            <p class=\"ud-driver-body l-zh\">表面之下：医疗保健／必需消费／公用事业相对坚挺，能源／可选消费走弱 — 这是轮动观察，并非追高的信号。</p>\n          </div>\n          \n          <a class=\"ud-depth ud-driver-chip\" href=\"advanced.html#vsb-breadth-split-section\">\n            <span class=\"l-en\">See how AI names compare with everyone else.</span><span class=\"l-zh\">查看 AI 相关个股与其他个股相比如何。</span>\n          </a>\n        </div>\n\n        <div class=\"panel ud-driver\" data-driver=\"risk_envelope\">\n          <b class=\"ud-driver-head\"><span class=\"l-en\">Market state</span><span class=\"l-zh\">市场状态</span></b>\n          <p class=\"ud-driver-body l-en\">Read being updated — three reads below, never a fused score.</p>\n          <p class=\"ud-driver-body l-zh\">判读更新中——下方为三项读数，非融合评分。</p>\n        </div>\n\n        <div class=\"panel ud-driver\" data-driver=\"fear_greed\" data-fold=\"sentiment-33-34\">\n          <b class=\"ud-driver-head\"><span class=\"l-en\">Neutral</span><span class=\"l-zh\">中性</span></b>\n          <div class=\"ud-sent-lenses\">\n            <div class=\"ud-sent-lens\" data-driver-leg=\"fear_euphoria\"\n                 data-tip-en=\"Fear and euphoria context — display only, not a signal.\"\n                 data-tip-zh=\"恐惧与亢奋背景——仅供展示，不是信号。\">\n              <span class=\"ud-sent-lens-name\"><span class=\"l-en\">Greed</span><span class=\"l-zh\">贪婪</span></span>\n              <div class=\"ud-sent-rail\" aria-hidden=\"true\"><span class=\"ud-sent-pin\" style=\"left:87%\"></span></div>\n            </div>\n            <div class=\"ud-sent