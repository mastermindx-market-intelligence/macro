u6613\u65e5\u3002","matches_board_wall":true,"board_wall":75.0},"spot_note_en":"Strike distances here are measured against the snapshot source's price of 99.37, which differs from this board's price by 24.7%.","spot_note_zh":"\u6b64\u5904\u7684\u884c\u6743\u4ef7\u8ddd\u79bb\u4ee5\u5feb\u7167\u6765\u6e90\u7684\u4ef7\u683c 99.37 \u4e3a\u57fa\u51c6\uff0c\u4e0e\u672c\u677f\u5757\u4ef7\u683c\u76f8\u5dee 24.7%\u3002"}}