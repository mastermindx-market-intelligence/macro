u4e2d\u6bcf\u4e00\u6b21\u90fd\u843d\u5728 130\uff0c\u5b9e\u9645\u6301\u7eed\u65f6\u95f4\u53ef\u80fd\u957f\u4e8e\u5df2\u4fdd\u5b58\u7684\u7a97\u53e3\u3002\u672a\u5e73\u4ed3\u91cf\u662f\u5408\u7ea6\u6570\u91cf\uff0c\u4e0d\u662f\u505a\u5e02\u5546\u6301\u4ed3\u3002\u6700\u65b0\u7684\u5df2\u5b58\u50a8\u5feb\u7167\u6bd4\u6700\u8fd1\u6536\u76d8\u843d\u540e 29 \u4e2a\u4ea4\u6613\u65e5\u3002","matches_board_wall":false,"board_wall":145.0}}}