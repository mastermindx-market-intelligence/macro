{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/company_intelligence/company_catalyst_public_evidence.v1.schema.json",
  "title": "Company catalyst public source context v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "company_catalyst_public_evidence.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "scope": {
      "const": "event_source_context"
    },
    "role": {
      "const": "source_context"
    },
    "rights_profile": {
      "const": "rp_public_primary_v1"
    },
    "rights_state": {
      "const": "public_primary"
    },
    "label": {
      "const": "SEC source document"
    },
    "excerpt": {
      "const": null
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_source_[0-9a-f]{64}$"
    },
    "event_revision_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:#-]{0,511}$"
    },
    "issuer_cik": {
      "type": "string",
      "pattern": "^[0-9]{10}$"
    },
    "document_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "document_revision": {
      "type": "integer",
      "minimum": 1
    },
    "accession": {
      "type": "string",
      "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"
    },
    "document_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "span_text_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "document_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "span_ref": {
      "type": "string",
      "pattern": "^span_[0-9a-f]{20}$"
    },
    "span_start_byte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777215
    },
    "span_end_byte": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "url": {
      "type": "string",
      "pattern": "^https://www\\.sec\\.gov/Archives/edgar/data/[1-9][0-9]*/[0-9]{18}/[A-Za-z0-9][A-Za-z0-9_.-]{0,255}\\.(?:htm|html|txt)$"
    },
    "source_class": {
      "enum": [
        "primary_filing",
        "issuer_release"
      ]
    },
    "filed_on": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source_available_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "projection_cutoff": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "decision_authority",
        "allowed_uses",
        "forbidden_uses"
      ],
      "properties": {
        "classification": {
          "const": "source_fact"
        },
        "decision_authority": {
          "const": false
        },
        "allowed_uses": {
          "const": [
            "display",
            "context",
            "explain"
          ]
        },
        "forbidden_uses": {
          "const": [
            "originate_signal",
            "rank_security",
            "select_security",
            "size_position",
            "gate_decision",
            "execute_trade",
            "raise_authority"
          ]
        }
      }
    }
  },
  "required": [
    "accession",
    "authority",
    "contract_id",
    "document_bytes",
    "document_content_sha256",
    "document_ref",
    "document_revision",
    "event_id",
    "event_revision_ref",
    "excerpt",
    "filed_on",
    "issuer_cik",
    "label",
    "observed_at",
    "projection_cutoff",
    "rights_profile",
    "rights_state",
    "role",
    "schema_version",
    "scope",
    "source_available_at",
    "source_class",
    "span_end_byte",
    "span_ref",
    "span_start_byte",
    "span_text_sha256",
    "url"
  ]
}
