{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/company_intelligence/company_catalyst_event.v1_1.schema.json",
  "title": "Company Intelligence Source-Anchored Catalyst Event v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "event_id",
    "company_id",
    "issuer_cik",
    "event_family",
    "native_identity",
    "revision_ref",
    "revision_is_current",
    "occurrence",
    "timing",
    "source_available_at",
    "observed_at",
    "document_refs",
    "public_evidence",
    "asset_mentions",
    "relationship_claims",
    "authority"
  ],
  "properties": {
    "contract_id": {
      "const": "company_catalyst_event.v1"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_source_[0-9a-f]{64}$"
    },
    "company_id": {
      "type": "string",
      "pattern": "^cik:[0-9]{10}$"
    },
    "issuer_cik": {
      "type": "string",
      "pattern": "^[0-9]{10}$"
    },
    "event_family": {
      "enum": [
        "issuer_readout_guidance",
        "regulatory_target_disclosed",
        "advisory_meeting_disclosed",
        "result_announced",
        "regulatory_action"
      ]
    },
    "native_identity": {
      "$ref": "#/$defs/nativeIdentity"
    },
    "revision_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "revision_is_current": {
      "type": "boolean"
    },
    "occurrence": {
      "enum": [
        "uncorroborated",
        "corroborated",
        "cancelled",
        "withdrawn"
      ]
    },
    "timing": {
      "$ref": "#/$defs/timing"
    },
    "source_available_at": {
      "$ref": "#/$defs/knowledgeTimestamp"
    },
    "observed_at": {
      "$ref": "#/$defs/knowledgeTimestamp"
    },
    "document_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "public_evidence": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/publicEvidence"
      }
    },
    "asset_mentions": {
      "const": []
    },
    "relationship_claims": {
      "const": []
    },
    "authority": {
      "$ref": "#/$defs/authority"
    }
  },
  "$defs": {
    "knowledgeTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.+(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nativeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_namespace",
        "native_event_key"
      ],
      "properties": {
        "source_namespace": {
          "const": "issuer_disclosure"
        },
        "native_event_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "source_class",
        "lower_date",
        "upper_date",
        "precision",
        "source_timezone",
        "source_wording",
        "evidence_refs"
      ],
      "properties": {
        "state": {
          "enum": [
            "consistent",
            "conflicted",
            "missing"
          ]
        },
        "source_class": {
          "enum": [
            "issuer_guided",
            "regulator_disclosed",
            "unresolved"
          ]
        },
        "lower_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "upper_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "precision": {
          "enum": [
            "day",
            "month",
            "quarter",
            "year",
            "window",
            "unknown"
          ]
        },
        "source_timezone": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80
        },
        "source_wording": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2000
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "conflicted",
                  "missing"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "lower_date": {
                "const": null
              },
              "upper_date": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "decision_authority",
        "allowed_uses",
        "forbidden_uses"
      ],
      "properties": {
        "classification": {
          "const": "source_fact"
        },
        "decision_authority": {
          "const": false
        },
        "allowed_uses": {
          "const": [
            "display",
            "context",
            "explain"
          ]
        },
        "forbidden_uses": {
          "const": [
            "originate_signal",
            "rank_security",
            "select_security",
            "size_position",
            "gate_decision",
            "execute_trade",
            "raise_authority"
          ]
        }
      }
    },
    "publicEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "const": "company_catalyst_public_evidence.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "scope": {
          "const": "event_source_context"
        },
        "role": {
          "const": "source_context"
        },
        "rights_profile": {
          "const": "rp_public_primary_v1"
        },
        "rights_state": {
          "const": "public_primary"
        },
        "label": {
          "const": "SEC source document"
        },
        "excerpt": {
          "const": null
        },
        "event_id": {
          "type": "string",
          "pattern": "^evt_source_[0-9a-f]{64}$"
        },
        "event_revision_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:#-]{0,511}$"
        },
        "issuer_cik": {
          "type": "string",
          "pattern": "^[0-9]{10}$"
        },
        "document_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "document_revision": {
          "type": "integer",
          "minimum": 1
        },
        "accession": {
          "type": "string",
          "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"
        },
        "document_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "span_text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "document_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "span_ref": {
          "type": "string",
          "pattern": "^span_[0-9a-f]{20}$"
        },
        "span_start_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777215
        },
        "span_end_byte": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "url": {
          "type": "string",
          "pattern": "^https://www\\.sec\\.gov/Archives/edgar/data/[1-9][0-9]*/[0-9]{18}/[A-Za-z0-9][A-Za-z0-9_.-]{0,255}\\.(?:htm|html|txt)$"
        },
        "source_class": {
          "enum": [
            "primary_filing",
            "issuer_release"
          ]
        },
        "filed_on": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "source_available_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
        },
        "observed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
        },
        "projection_cutoff": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "decision_authority",
            "allowed_uses",
            "forbidden_uses"
          ],
          "properties": {
            "classification": {
              "const": "source_fact"
            },
            "decision_authority": {
              "const": false
            },
            "allowed_uses": {
              "const": [
                "display",
                "context",
                "explain"
              ]
            },
            "forbidden_uses": {
              "const": [
                "originate_signal",
                "rank_security",
                "select_security",
                "size_position",
                "gate_decision",
                "execute_trade",
                "raise_authority"
              ]
            }
          }
        }
      },
      "required": [
        "accession",
        "authority",
        "contract_id",
        "document_bytes",
        "document_content_sha256",
        "document_ref",
        "document_revision",
        "event_id",
        "event_revision_ref",
        "excerpt",
        "filed_on",
        "issuer_cik",
        "label",
        "observed_at",
        "projection_cutoff",
        "rights_profile",
        "rights_state",
        "role",
        "schema_version",
        "scope",
        "source_available_at",
        "source_class",
        "span_end_byte",
        "span_ref",
        "span_start_byte",
        "span_text_sha256",
        "url"
      ]
    }
  }
}
