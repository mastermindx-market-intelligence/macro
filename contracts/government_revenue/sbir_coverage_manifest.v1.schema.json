{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/government_revenue/sbir_coverage_manifest.v1.schema.json",
  "title": "Existing SBIR coverage manifest v1",
  "description": "Canonical existing producer shape. Closed objects exclude source PII, abstracts and raw transport. Executable format checking and existing hash/generation/cross-field checks are required; JSON Schema alone does not prove bindings or source activation.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract": {
      "const": "government_revenue.sbir_coverage_manifest.v1"
    },
    "coverage_scope": {
      "const": "Bounded offset-paged SBIR.gov award observations for the declared agency/year query cells only; never a complete SBIR/STTR corpus, never issuer attribution, and never a production-conversion claim."
    },
    "endpoint": {
      "const": "https://api.www.sbir.gov/public/api/awards"
    },
    "documentation": {
      "const": [
        "https://www.sbir.gov/api",
        "https://www.sbir.gov/data-resources/data-dictionary/award"
      ]
    },
    "query_cells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agency": {
            "enum": [
              "DOW",
              "HHS",
              "NASA",
              "NSF",
              "DOE",
              "USDA",
              "EPA",
              "DOC",
              "ED",
              "DOT",
              "DHS"
            ]
          },
          "year": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(19|20)\\d{2}$"
          }
        },
        "required": [
          "agency",
          "year"
        ],
        "additionalProperties": false
      },
      "maxItems": 4,
      "uniqueItems": true
    },
    "probed_at": {
      "const": "2026-08-08"
    },
    "probed_valid_agency_query_codes": {
      "const": [
        "DOW",
        "HHS",
        "NASA",
        "NSF",
        "DOE",
        "USDA",
        "EPA",
        "DOC",
        "ED",
        "DOT",
        "DHS"
      ]
    },
    "legacy_response_agency_codes": {
      "const": [
        "DOD"
      ]
    },
    "paging": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "offset_based_start_parameter"
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_pages_per_cell": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "sort": {
          "const": "award_date_desc_fixed_by_source"
        },
        "sort_is_configurable": {
          "const": false
        },
        "pagination_metadata_available": {
          "const": false
        },
        "total_record_count_available": {
          "const": false
        },
        "source_exhaustion_signal": {
          "const": "short_page_only"
        }
      },
      "required": [
        "kind",
        "page_size",
        "max_pages_per_cell",
        "sort",
        "sort_is_configurable",
        "pagination_metadata_available",
        "total_record_count_available",
        "source_exhaustion_signal"
      ],
      "additionalProperties": false
    },
    "safety_caps": {
      "type": "object",
      "properties": {
        "max_cells_per_run": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "max_rows_per_run": {
          "const": 800
        },
        "max_requests_per_run": {
          "const": 8
        },
        "request_pacing_seconds": {
          "type": "number",
          "minimum": 0
        },
        "published_rate_limit_requests": {
          "const": 10
        },
        "published_rate_limit_window_seconds": {
          "const": 600
        }
      },
      "required": [
        "max_cells_per_run",
        "max_rows_per_run",
        "max_requests_per_run",
        "request_pacing_seconds",
        "published_rate_limit_requests",
        "published_rate_limit_window_seconds"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "source_native_key": {
          "const": "agency_tracking_number"
        },
        "key_definition": {
          "const": "unique across all of TECH-Net per the official Award data dictionary"
        },
        "rows_without_key_are_refused": {
          "const": true
        },
        "issuer_join": {
          "const": "exact_uei_only_against_reviewed_recipient_graph"
        },
        "name_association_is_attribution": {
          "const": false
        }
      },
      "required": [
        "source_native_key",
        "key_definition",
        "rows_without_key_are_refused",
        "issuer_join",
        "name_association_is_attribution"
      ],
      "additionalProperties": false
    },
    "clocks": {
      "type": "object",
      "properties": {
        "source_at": {
          "const": "proposal_award_date (first day of contract performance, per source)"
        },
        "effective_at": {
          "const": "proposal_award_date"
        },
        "observed_at": {
          "const": "collector retrieval instant"
        },
        "known_at": {
          "const": "collector retrieval instant; knowledge is observation-bound and never backdated"
        },
        "source_publication_clock_available": {
          "const": false
        },
        "source_reporting_lag_note": {
          "const": "SBIR.gov states newly added awards need at least 24 hours to appear and that annual completeness lags; absence of a recent award is not evidence of no award."
        }
      },
      "required": [
        "source_at",
        "effective_at",
        "observed_at",
        "known_at",
        "source_publication_clock_available",
        "source_reporting_lag_note"
      ],
      "additionalProperties": false
    },
    "omissions": {
      "type": "object",
      "properties": {
        "full_sbir_corpus": {
          "const": false
        },
        "bulk_download_used": {
          "const": false
        },
        "bulk_download_urls": {
          "const": [
            "https://data.www.sbir.gov/awarddatapublic/award_data.csv",
            "https://data.www.sbir.gov/mod_awarddatapublic_no_abstract/award_data_no_abstract.csv"
          ]
        },
        "abstract_persisted": {
          "const": false
        },
        "pii_source_fields_never_persisted": {
          "const": [
            "poc_name",
            "poc_title",
            "poc_phone",
            "poc_email",
            "pi_name",
            "pi_phone",
            "pi_email",
            "ri_poc_name",
            "ri_poc_phone",
            "address1",
            "address2",
            "city",
            "zip"
          ]
        }
      },
      "required": [
        "full_sbir_corpus",
        "bulk_download_used",
        "bulk_download_urls",
        "abstract_persisted",
        "pii_source_fields_never_persisted"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "const": [
        "Phase I to Phase II movement is progression evidence only. SBIR.gov publishes no parent/child link between a Phase I and a Phase II award, so phase movement is never production conversion, revenue, backlog, bookings, obligation, or outlay."
      ]
    }
  },
  "required": [
    "schema_version",
    "contract",
    "coverage_scope",
    "endpoint",
    "documentation",
    "query_cells",
    "probed_at",
    "probed_valid_agency_query_codes",
    "legacy_response_agency_codes",
    "paging",
    "safety_caps",
    "identity",
    "clocks",
    "omissions",
    "limitations"
  ],
  "additionalProperties": false
}
