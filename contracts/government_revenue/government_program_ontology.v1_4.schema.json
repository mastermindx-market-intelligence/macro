          "$ref": "#/$defs/strictDateTime"
        },
        "valid_to": {
          "$ref": "#/$defs/nullableStrictDateTime"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "retire_row"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "target_row_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "block"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "subject_type",
              "subject_id"
            ]
          }
        }
      ]
    },
    "publicCapacityAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "program_id",
        "product_scope",
        "product_label",
        "entity_id",
        "kind",
        "quantity",
        "comparator",
        "unit",
        "period_label",
        "known_at",
        "valid_from",
        "valid_to",
        "verification_state",
        "evidence_refs",
        "predecessor_id",
        "succession_reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^prog-capacity:[0-9a-f]{24}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "program_id": {
          "type": "string",
          "pattern": "^acq-program:[a-z0-9-]+$"
        },
        "product_scope": {
          "enum": [
            "whole_program",
            "component"
          ]
        },
        "product_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "entity_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "kind": {
          "enum": [
            "announced_target",
            "installed_capacity",
            "demonstrated_throughput"
          ]
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "comparator": {
          "enum": [
            "exact",
            "approximately",
            "greater_than"
          ]
        },
        "unit": {
          "enum": [
            "units",
            "units_per_year",
            "relative_multiplier"
          ]
        },
        "period_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "known_at": {
          "$ref": "#/$defs/strictDateTime"
        },
        "valid_from": {
          "$ref": "#/$defs/strictDateTime"
        },
        "valid_to": {
          "$ref": "#/$defs/nullableStrictDateTime"
        },
        "verification_state": {
          "$ref": "#/$defs/verificationState"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "predecessor_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^prog-capacity:[a-f0-9]{24}$"
        },
        "succession_reason": {
          "enum": [
            null,
            "superseded_evidence",
            "attribute_revision"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "installed_capacity"
              }
            }
          },
          "then": {
            "properties": {
              "unit": {
                "const": "units_per_year"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "demonstrated_throughput"
              }
            }
          },
          "then": {
            "properties": {
              "unit": {
                "enum": [
                  "units",
                  "units_per_year"
                ]
              }
            }
          }
        }
      ]
    },
    "publicOversightAssertion": {
      "type": "object",
      "additionalProperties": false,
      "description": "One closed oversight finding: exact reviewed program, stable content-derived id with revision/succession, report identity (series/document id/edition), official publication date, observation-period label, finding kind, source-attributed summary, reporter class, exact excerpt with its SHA-256, 1-based PDF page and printed-page label. Publication and edition fields bind the row's identity but never set its claim currency; only known_at/valid_from/valid_to do.",
      "required": [
        "id",
        "revision",
        "program_id",
        "finding_kind",
        "reported_by",
        "report_series",
        "report_document_id",
        "report_edition",
        "published_on",
        "period_label",
        "summary",
        "excerpt",
        "excerpt_sha256",
        "page",
        "printed_page_label",
        "known_at",
        "valid_from",
        "valid_to",
        "verification_state",
        "evidence_refs",
        "predecessor_id",
        "succession_reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^prog-oversight:[0-9a-f]{24}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "program_id": {
          "type": "string",
          "pattern": "^acq-program:[a-z0-9-]+$"
        },
        "finding_kind": {
