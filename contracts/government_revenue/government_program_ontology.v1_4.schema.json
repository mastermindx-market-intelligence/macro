          "type": "string",
          "minLength": 1
        },
        "subject_type": {
          "enum": [
            "program",
            "award_event",
            "source_evidence"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "verification_state": {
          "$ref": "#/$defs/verificationState"
        },
