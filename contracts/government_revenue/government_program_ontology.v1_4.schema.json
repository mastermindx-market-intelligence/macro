    "publicAgreementAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "source_url",
        "program_label",
        "umbrella_label",
        "agreement_form",
        "parties",
        "collective_value",
        "expected_launch_year",
        "published_on",
        "known_at",
        "verification_state",
        "evidence_refs",
        "predecessor_id",
        "succession_reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^prog-agreement:[a-f0-9]{24}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.sda\\.mil|www\\.l3harris\\.com)/"
        },
        "program_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "umbrella_label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "agreement_form": {
          "const": "firm_fixed_price_ota_prototype"
        },
        "parties": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name_literal",
              "entity_id",
              "potential_value",
              "announced_vehicles"
            ],
            "properties": {
              "name_literal": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "entity_id": {
                "type": "null"
              },
              "potential_value": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "unit",
                  "approximate"
                ],
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "enum": [
                      "USD_million",
                      "USD_billion"
                    ]
                  },
                  "approximate": {
                    "type": "boolean"
                  }
                }
              },
              "announced_vehicles": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              }
            }
          }
        },
        "collective_value": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit",
                "approximate",
                "overlaps_named_party_values"
              ],
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "enum": [
                    "USD_million",
                    "USD_billion"
                  ]
                },
                "approximate": {
                  "type": "boolean"
                },
                "overlaps_named_party_values": {
                  "const": true
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_launch_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1900,
          "maximum": 2200
        },
        "published_on": {
          "$ref": "#/$defs/fullDate"
        },
        "known_at": {
          "$ref": "#/$defs/strictDateTime"
        },
        "verification_state": {
          "const": "reviewed"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ev:[a-f0-9]{12}$"
          }
        },
        "predecessor_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^prog-agreement:[a-f0-9]{24}$"
        },
        "succession_reason": {
          "enum": [
            null,
            "corrected"
          ]
        }
      }
    }
  }
