        },
        "valid_to": {
          "$ref": "#/$defs/nullableStrictDateTime"
        },
        "verification_state": {
          "$ref": "#/$defs/verificationState"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "predecessor_id": {
