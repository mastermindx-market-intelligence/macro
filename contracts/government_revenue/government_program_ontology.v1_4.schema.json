            "schedule",
            "production_constraint",
            "contract_process",
            "protest_status"
          ]
        },
        "reported_by": {
          "enum": [
            "oversight_body",
            "quoted_program_office"
          ]
        },
        "report_series": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "report_document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "report_edition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "published_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "period_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
