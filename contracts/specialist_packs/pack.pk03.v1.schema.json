{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/specialist_packs/pack.pk03.v1.schema.json",
  "title": "Specialist pack PK03 v1 catalogue",
  "description": "Segments and geographic/product dimensions. Result instances validate against specialist_pack_result.v1. The field, check and reason-code catalogue is frozen by the FIF K1/K2 seat spec; pack results remain display-only context (attested: false) until a Q1 held-out evaluation under Q0.",
  "pack_schema_id": "pack.pk03/v1",
  "pack_id": "PK03",
  "name": "Segments and geographic/product dimensions",
  "boundary": "Dimensional maps, eliminations and reporting-definition changes; no theme or relationship graph.",
  "requires": [
    "schema",
    "source-qualified golden set",
    "independent domain review",
    "held-out quality test",
    "typed absences",
    "production source trace"
  ],
  "catalogue_state": "specified",
  "fields": [
    {
      "field_id": "number_of_operating_segments",
      "name": "Number of operating segments",
      "type": "integer",
      "unit": null,
      "period_kind": "duration",
      "allowed_evidence_kinds": [
        "xbrl_fact"
      ],
      "required": false
    },
    {
      "field_id": "segment_revenue",
      "name": "Segment revenue by business-segment member (PK03-owned axis)",
      "type": "decimal",
      "unit": "USD",
      "period_kind": "duration",
      "allowed_evidence_kinds": [
        "xbrl_fact"
      ],
      "required": true
    },
    {
      "field_id": "segment_profit_or_loss",
      "name": "Segment profit or loss",
      "type": "decimal",
      "unit": "USD",
      "period_kind": "duration",
      "allowed_evidence_kinds": [
        "xbrl_fact"
      ],
      "required": false
    },
    {
      "field_id": "unallocated_corporate_and_eliminations",
      "name": "Unallocated corporate items and intersegment eliminations",
      "type": "decimal",
      "unit": "USD",
      "period_kind": "duration",
      "allowed_evidence_kinds": [
        "xbrl_fact"
      ],
      "required": false
    },
    {
      "field_id": "geographic_revenue",
      "name": "Geographic revenue (read-only mirror of the PK04 axis)",
      "type": "decimal",
      "unit": "USD",
      "period_kind": "duration",
      "allowed_evidence_kinds": [
        "xbrl_fact"
      ],
      "required": false
    },
    {
      "field_id": "product_service_revenue",
      "name": "Product/service revenue (read-only mirror of the PK04 axis)",
      "type": "decimal",
      "unit": "USD",
      "period_kind": "duration",
      "allowed_evidence_kinds": [
        "xbrl_fact"
      ],
      "required": false
    },
    {
      "field_id": "segment_definition_change_note",
      "name": "Segment definition change note",
      "type": "text",
      "unit": null,
      "period_kind": "duration",
      "allowed_evidence_kinds": [
        "text_span"
      ],
      "required": false
    },
    {
      "field_id": "segment_reporting_text_block",
      "name": "Segment reporting text block",
      "type": "text",
      "unit": null,
      "period_kind": "duration",
      "allowed_evidence_kinds": [
        "text_span"
      ],
      "required": false
    }
  ],
  "checks": [
    {
      "check_id": "segment_sum_plus_eliminations_equals_consolidated",
      "kind": "reconcile_to_consolidated",
      "operands": [
        "segment_revenue",
        "unallocated_corporate_and_eliminations",
        "core:revenue"
      ]
    },
    {
      "check_id": "fp_internal_revenue_not_double_counted",
      "kind": "sum_identity",
      "operands": [
        "segment_revenue",
        "unallocated_corporate_and_eliminations"
      ]
    },
    {
      "check_id": "segment_count_consistent",
      "kind": "cross_statement",
      "operands": [
        "number_of_operating_segments",
        "segment_revenue"
      ]
    }
  ],
  "reason_codes": [
    {
      "code": "applicability_rule_satisfied",
      "parameter": null,
      "meaning": "the pack's versioned applicability rule (`applicability.rule_id`) evaluated true"
    },
    {
      "code": "form_outside_pack_forms",
      "parameter": null,
      "meaning": "the admitted form is outside the pack's Q0-frozen forms"
    },
    {
      "code": "missing_standard_fact",
      "parameter": "concept",
      "meaning": "the standard concept named by the parameter has no admitted fact for the period"
    },
    {
      "code": "extension_concept_unaliased",
      "parameter": "prefix",
      "meaning": "the value exists only under an extension prefix with no frozen alias"
    },
    {
      "code": "disallowed_dimension",
      "parameter": null,
      "meaning": "the only facts carry a dimension the field does not admit"
    },
    {
      "code": "missing_dependency",
      "parameter": null,
      "meaning": "a formula/check operand is not valued (R-K3: never an implied zero)"
    },
    {
      "code": "unit_mismatch",
      "parameter": null,
      "meaning": "operands differ in unit/currency/period basis"
    },
    {
      "code": "numeric_value_in_narrative_only",
      "parameter": null,
      "meaning": "the number appears only inside narrative text; R-K4' forbids extracting it"
    }
  ],
  "type": "object",
  "additionalProperties": false
}
