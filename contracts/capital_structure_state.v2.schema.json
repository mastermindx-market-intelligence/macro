          "then": {"properties": {"condition": {"$ref": "#/$defs/nonempty_string"}}}
        },
        {
          "if": {"properties": {"certainty": {"const": "contractual_dated"}}, "required": ["certainty"]},
          "then": {"properties": {"dated": {"$ref": "#/$defs/date"}}}
        }
      ]
