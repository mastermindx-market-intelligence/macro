        },
        "receipt": {"$ref": "#/$defs/calculation_receipt"},
        "cash_effects": {"type": "array", "items": {"$ref": "#/$defs/cash_effect"}},
        "double_count_guards": {"$ref": "#/$defs/string_array"},
        "unknowns": {"$ref": "#/$defs/unknown_array"}
      }
