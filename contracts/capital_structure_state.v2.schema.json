{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/capital_structure_state.v2.schema.json",
  "title": "Capital Structure Intelligence V2 — issuer state contract (capital_structure.state.v2)",
  "description": "Frozen same-owner state/scenario contract (masterplan research/capital_structure/e2e_20261013/MASTERPLAN.md §9, task C0). The root record is a CapitalState generation; $defs carry every planned-interface record (state_request, capital_inputs, rule_pack, financing_scenario, capacity_envelope, supply_envelope, funding_schedule, instrument_set, share_basis_result, calculation_receipt). Compatible with capital_structure.projection_bundle.v1, which is never renamed and keeps its observed-event reader. Unknown is never 0 or infinity; every share quantity names its basis; shared-pool maxima are never summed; a numeric bound without applicability evidence is rejected; a changed assumption is a different scenario identity. Context only: no rank, sizing, entry or Prophet authority.",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": {"$ref": "#/$defs/safe_property_name"},
  "required": [
    "schema",
    "contract_version",
    "state_id",
    "request",
    "as_of",
    "generated_at",
    "projection_generation_id",
    "compatibility",
    "families",
    "unavailable",
    "capabilities_proven",
    "receipt",
    "authority"
  ],
  "properties": {
    "schema": {"const": "capital_structure.state.v2"},
    "contract_version": {"const": "capital-structure-state-contracts/2.0.0"},
    "state_id": {"type": "string", "pattern": "^state:cs:[A-Fa-f0-9]{32}$"},
    "request": {"$ref": "#/$defs/state_request"},
    "as_of": {"$ref": "#/$defs/timestamp"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "projection_generation_id": {"$ref": "#/$defs/nullable_identifier"},
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/family_state"}
    },
    "unavailable": {"$ref": "#/$defs/unique_string_array"},
    "capabilities_proven": {
      "type": "array",
      "items": {"$ref": "#/$defs/capability_proof"}
    },
    "receipt": {"$ref": "#/$defs/calculation_receipt"},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "safe_property_name": {
      "type": "string",
      "not": {
        "pattern": "^(?:object_?keys?|raw_?(?:docs?|documents?)|scores?|probabilit(?:y|ies)|capacities|capacity|runway|overhang|fully_?diluted(?:_[a-z_]+)?|ranks?|ranking|sizing|position_?size|entry|prophet(?:_(?!authority$)[a-z_]+)?|likelihood|expected_dilution)$"
      }
    },
    "safe_value": {
      "anyOf": [
        {"$ref": "#/$defs/safe_object"},
        {"type": "array", "items": {"$ref": "#/$defs/safe_value"}},
        {"type": "string"},
        {"type": "number"},
        {"type": "boolean"},
        {"type": "null"}
      ]
    },
    "safe_object": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/safe_property_name"},
      "additionalProperties": {"$ref": "#/$defs/safe_value"}
    },
    "safe_record_array": {
      "type": "array",
      "items": {"$ref": "#/$defs/safe_object"}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_context_only", "rank_authority", "sizing_authority", "entry_authority", "prophet_authority"],
      "properties": {
        "is_context_only": {"const": true},
        "rank_authority": {"const": false},
        "sizing_authority": {"const": false},
        "entry_authority": {"const": false},
        "prophet_authority": {"const": false}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_bundle_schema",
        "projection_version_floor",
        "projection_version_prefix",
        "observed_event_reader",
        "observed_event_reader_status",
        "state_contract_version"
      ],
      "properties": {
        "projection_bundle_schema": {"const": "capital_structure.projection_bundle.v1"},
        "projection_version_floor": {"const": "capital-structure-event-projection/1.0.0"},
        "projection_version_prefix": {"const": "capital-structure-event-projection/1."},
        "observed_event_reader": {"const": "engine.capital_structure.projection.build_projection_bundle"},
        "observed_event_reader_status": {"const": "preserved"},
        "state_contract_version": {"const": "capital-structure-state-contracts/2.0.0"}
      }
    },
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "nullable_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"},
    "nullable_identifier": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
    "scenario_id": {"type": "string", "pattern": "^scenario:cs:[A-Fa-f0-9]{32}$"},
    "nullable_scenario_id": {"anyOf": [{"$ref": "#/$defs/scenario_id"}, {"type": "null"}]},
    "state_id": {"type": "string", "pattern": "^state:cs:[A-Fa-f0-9]{32}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "nullable_timestamp": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "nullable_date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
    "decimal": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
    "nullable_decimal": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
    "rate": {"type": "string", "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"},
    "nullable_rate": {"anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
    "nonempty_string": {"type": "string", "minLength": 1},
    "nullable_string": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "string_array": {"type": "array", "items": {"type": "string"}},
    "unique_string_array": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "identifier_array": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
    "input_family": {
      "enum": [
        "event_projection",
        "events",
        "event_edges",
        "registration_lifecycle",
        "document_terms",
        "covenant_terms",
        "instrument_candidate_terms",
        "share_count_observations",
        "financials",
        "corrections"
      ]
    },
    "input_schema": {
      "enum": [
        "capital_structure.projection_bundle.v1",
        "capital_structure.event.v1",
        "capital_structure.event_edge.v1",
        "capital_structure.registration_lifecycle_bundle.v1",
        "capital_structure.document_term_observation.v1",
        "capital_structure.covenant_term_observation.v1",
        "capital_structure.instrument_candidate_term.v1",
        "capital_structure.share_count_observation.v1",
        "capital_structure.share_count_observation.v2"
      ]
    },
    "nullable_input_schema": {"anyOf": [{"$ref": "#/$defs/input_schema"}, {"type": "null"}]},
    "state_family": {
      "enum": [
        "identity",
        "share_basis",
        "registration",
        "instruments",
        "cash_funding",
        "transactions",
        "uncertainty",
        "change_events"
      ]
    },
    "support": {"enum": ["supported", "partial", "unavailable", "not_built"]},
    "unit": {"enum": ["usd", "shares", "votes", "percent", "ratio", "days"]},
    "quantity_status": {"enum": ["known", "unknown", "not_applicable", "contradicted", "withheld"]},
    "share_basis": {
      "enum": [
        "issued_and_outstanding",
        "assumed_as_converted",
        "scenario_incremental_issuance",
        "potentially_resalable_existing",
        "weighted_average_eps",
        "non_affiliate_public_float",
        "authorized_unissued",
        "reserved_for_issuance",
        "treasury",
        "preferred_as_converted_equivalent"
      ]
    },
    "view_mode": {"enum": ["current", "then_known", "scenario"]},
    "scenario_view": {"enum": ["then_known", "counterfactual"]},
    "rule_class": {"enum": ["binding_rule", "staff_interpretation", "issuer_assertion", "proposed_reform"]},
    "constraint_kind": {
      "enum": [
        "dollars",
        "shares",
        "voting_power",
        "holder_ownership",
        "registered_class",
        "programme_balance",
        "reserved_authorized_shares",
        "covenant_headroom",
        "time_window"
      ]
    },
    "constraint_status": {"enum": ["binding", "slack", "unknown", "inapplicable"]},
    "stock_or_flow": {"enum": ["stock", "flow"]},
    "route_kind": {
      "enum": [
        "shelf_takedown",
        "at_the_market",
        "equity_line",
        "registered_direct",
        "pipe",
        "warrant_exercise",
        "conversion",
        "debt_draw",
        "repurchase",
        "redemption",
        "exchange",
        "other"
      ]
    },
    "route_status": {"enum": ["eligible", "conditional", "ineligible", "unknown"]},
    "settlement": {"enum": ["cash", "cashless", "net_share", "pre_funded", "unknown"]},
    "instrument_kind": {
      "enum": [
        "common",
        "warrant",
        "pre_funded_warrant",
        "convertible_note",
        "convertible_preferred",
        "preferred",
        "debt",
        "unit",
        "earnout",
        "option",
        "restricted_stock_unit",
        "other"
      ]
    },
    "instrument_status": {"enum": ["outstanding", "retired", "amended", "unresolved_candidate"]},
    "resolution_method": {"enum": ["supported_identity", "amendment_join", "retirement", "unresolved"]},
    "share_basis_status": {"enum": ["selected", "conflict", "refused", "unavailable"]},
    "corporate_action_kind": {"enum": ["none", "reverse_split", "forward_split"]},
    "flow_kind": {"enum": ["source", "use"]},
    "flow_certainty": {"enum": ["contractual_dated", "conditional", "assumed"]},
    "cash_basis": {
      "enum": [
        "unrestricted_cash",
        "unrestricted_cash_and_marketable_securities",
        "unrestricted_and_restricted_cash",
        "unknown"
      ]
    },
    "cash_effect_kind": {"enum": ["proceeds", "no_cash", "repayment", "fee"]},
    "price_kind": {"enum": ["fixed", "path"]},
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "span_id", "text_sha256"],
      "properties": {
        "manifest_id": {"$ref": "#/$defs/identifier"},
        "span_id": {"$ref": "#/$defs/identifier"},
        "text_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence_array": {"type": "array", "items": {"$ref": "#/$defs/evidence_ref"}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_family", "generation_id", "evidence", "available_at"],
      "properties": {
        "input_family": {"$ref": "#/$defs/input_family"},
        "generation_id": {"$ref": "#/$defs/nullable_identifier"},
        "evidence": {"$ref": "#/$defs/evidence_array"},
        "available_at": {"$ref": "#/$defs/nullable_timestamp"}
      }
    },
    "nullable_provenance": {"anyOf": [{"$ref": "#/$defs/provenance"}, {"type": "null"}]},
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "status", "value", "share_basis", "security_class_id", "applicability", "provenance", "note"],
      "properties": {
        "unit": {"$ref": "#/$defs/unit"},
        "status": {"$ref": "#/$defs/quantity_status"},
        "value": {"$ref": "#/$defs/nullable_decimal"},
        "share_basis": {"anyOf": [{"$ref": "#/$defs/share_basis"}, {"type": "null"}]},
        "security_class_id": {"$ref": "#/$defs/nullable_identifier"},
        "applicability": {"$ref": "#/$defs/nullable_string"},
        "provenance": {"$ref": "#/$defs/nullable_provenance"},
        "note": {"$ref": "#/$defs/nullable_string"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "known"}}, "required": ["status"]},
          "then": {"properties": {"value": {"$ref": "#/$defs/decimal"}}},
          "else": {"properties": {"value": {"type": "null"}}}
        },
        {
          "if": {"properties": {"unit": {"const": "shares"}}, "required": ["unit"]},
          "then": {"properties": {"share_basis": {"$ref": "#/$defs/share_basis"}}},
          "else": {"properties": {"share_basis": {"type": "null"}}}
        }
      ]
    },
    "nullable_quantity": {"anyOf": [{"$ref": "#/$defs/quantity"}, {"type": "null"}]},
    "usd_quantity": {
      "allOf": [{"$ref": "#/$defs/quantity"}, {"properties": {"unit": {"const": "usd"}}}]
    },
    "generation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_family", "schema", "support", "generation_id", "artifact_sha256", "as_of"],
      "properties": {
        "input_family": {"$ref": "#/$defs/input_family"},
        "schema": {"$ref": "#/$defs/nullable_input_schema"},
        "support": {"$ref": "#/$defs/support"},
        "generation_id": {"$ref": "#/$defs/nullable_identifier"},
        "artifact_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "as_of": {"$ref": "#/$defs/nullable_timestamp"}
      },
      "allOf": [
        {
          "if": {"properties": {"support": {"enum": ["supported", "partial"]}}, "required": ["support"]},
          "then": {
            "properties": {"schema": {"$ref": "#/$defs/input_schema"}},
            "anyOf": [
              {"properties": {"generation_id": {"$ref": "#/$defs/identifier"}}},
              {"properties": {"artifact_sha256": {"$ref": "#/$defs/sha256"}}}
            ]
          }
        },
        {
          "if": {"properties": {"input_family": {"enum": ["financials", "corrections"]}}, "required": ["input_family"]},
          "then": {"properties": {"support": {"const": "not_built"}, "schema": {"type": "null"}}}
        }
      ]
    },
    "rule_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "binding_class", "citation", "enforceable", "effective_from", "effective_to", "required_issuer_facts"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/identifier"},
        "binding_class": {"$ref": "#/$defs/rule_class"},
        "citation": {"$ref": "#/$defs/nonempty_string"},
        "enforceable": {"type": "boolean"},
        "effective_from": {"$ref": "#/$defs/nullable_date"},
        "effective_to": {"$ref": "#/$defs/nullable_date"},
        "required_issuer_facts": {"$ref": "#/$defs/string_array"}
      },
      "allOf": [
        {
          "if": {"properties": {"binding_class": {"enum": ["proposed_reform", "issuer_assertion"]}}, "required": ["binding_class"]},
          "then": {"properties": {"enforceable": {"const": false}}}
        },
        {
          "if": {"properties": {"binding_class": {"const": "binding_rule"}}, "required": ["binding_class"]},
          "then": {"properties": {"enforceable": {"const": true}}}
        }
      ]
    },
    "rule_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "rule_pack_id",
        "version",
        "source_edition",
        "jurisdiction",
        "effective_date",
        "interpretation_date",
        "rules",
        "venues",
        "forms",
        "digest"
      ],
      "properties": {
        "schema": {"const": "capital_structure.rule_pack.v2"},
        "rule_pack_id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/nonempty_string"},
        "source_edition": {"$ref": "#/$defs/nonempty_string"},
        "jurisdiction": {"$ref": "#/$defs/nonempty_string"},
        "effective_date": {"$ref": "#/$defs/date"},
        "interpretation_date": {"$ref": "#/$defs/date"},
        "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule_ref"}},
        "venues": {"$ref": "#/$defs/string_array"},
        "forms": {"$ref": "#/$defs/string_array"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "state_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "request_id",
        "issuer_id",
        "as_of",
        "view_mode",
        "input_generations",
        "rule_pack_id",
        "rule_pack_version",
        "rule_pack_digest",
        "security_class_id"
      ],
      "properties": {
        "schema": {"const": "capital_structure.state_request.v2"},
        "request_id": {"type": "string", "pattern": "^state-request:cs:[A-Fa-f0-9]{32}$"},
        "issuer_id": {"$ref": "#/$defs/identifier"},
        "as_of": {"$ref": "#/$defs/timestamp"},
        "view_mode": {"$ref": "#/$defs/view_mode"},
        "input_generations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/generation_binding"}},
        "rule_pack_id": {"$ref": "#/$defs/identifier"},
        "rule_pack_version": {"$ref": "#/$defs/nonempty_string"},
        "rule_pack_digest": {"$ref": "#/$defs/sha256"},
        "security_class_id": {"$ref": "#/$defs/nullable_identifier"}
      }
    },
    "capital_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "input_digest",
        "bindings",
        "events",
        "edges",
        "lifecycles",
        "document_terms",
        "covenant_terms",
        "candidate_terms",
        "share_observations",
        "financials",
        "corrections"
      ],
      "properties": {
        "schema": {"const": "capital_structure.capital_inputs.v2"},
        "input_digest": {"$ref": "#/$defs/sha256"},
        "bindings": {"type": "array", "items": {"$ref": "#/$defs/generation_binding"}},
        "events": {"$ref": "#/$defs/safe_record_array"},
        "edges": {"$ref": "#/$defs/safe_record_array"},
        "lifecycles": {"$ref": "#/$defs/safe_record_array"},
        "document_terms": {"$ref": "#/$defs/safe_record_array"},
        "covenant_terms": {"$ref": "#/$defs/safe_record_array"},
        "candidate_terms": {"$ref": "#/$defs/safe_record_array"},
        "share_observations": {"$ref": "#/$defs/safe_record_array"},
        "financials": {"type": "array", "maxItems": 0},
        "corrections": {"type": "array", "maxItems": 0}
      }
    },
    "calculation_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "receipt_id", "input_digest", "rule_digest", "implementation_digest", "computed_at", "scenario_id"],
      "properties": {
        "schema": {"const": "capital_structure.calculation_receipt.v2"},
        "receipt_id": {"type": "string", "pattern": "^receipt:cs:[A-Fa-f0-9]{32}$"},
        "input_digest": {"$ref": "#/$defs/sha256"},
        "rule_digest": {"$ref": "#/$defs/sha256"},
        "implementation_digest": {"$ref": "#/$defs/sha256"},
        "computed_at": {"$ref": "#/$defs/timestamp"},
        "scenario_id": {"$ref": "#/$defs/nullable_scenario_id"}
      }
    },
    "family_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "input_family",
        "input_schema",
        "support",
        "compiler_version",
        "generation_id",
        "artifact_sha256",
        "support_limits",
        "as_of",
        "available_at"
      ],
      "properties": {
        "family": {"$ref": "#/$defs/state_family"},
        "input_family": {"$ref": "#/$defs/input_family"},
        "input_schema": {"$ref": "#/$defs/nullable_input_schema"},
        "support": {"$ref": "#/$defs/support"},
        "compiler_version": {"$ref": "#/$defs/nullable_string"},
        "generation_id": {"$ref": "#/$defs/nullable_identifier"},
        "artifact_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "support_limits": {"$ref": "#/$defs/string_array"},
        "as_of": {"$ref": "#/$defs/nullable_timestamp"},
        "available_at": {"$ref": "#/$defs/nullable_timestamp"}
      },
      "allOf": [
        {
          "if": {"properties": {"support": {"enum": ["supported", "partial"]}}, "required": ["support"]},
          "then": {
            "properties": {
              "input_schema": {"$ref": "#/$defs/input_schema"},
              "compiler_version": {"$ref": "#/$defs/nonempty_string"}
            }
          }
        },
        {
          "if": {"properties": {"support": {"const": "partial"}}, "required": ["support"]},
          "then": {"properties": {"support_limits": {"type": "array", "minItems": 1}}}
        }
      ]
    },
    "family_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "provenance", "records", "unavailable"],
      "properties": {
        "family": {"$ref": "#/$defs/state_family"},
        "provenance": {"$ref": "#/$defs/family_provenance"},
        "records": {"$ref": "#/$defs/safe_record_array"},
        "unavailable": {"$ref": "#/$defs/unique_string_array"}
      }
    },
    "capability_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "generation_id", "test_reference", "proven_at"],
      "properties": {
        "capability": {"$ref": "#/$defs/nonempty_string"},
        "generation_id": {"$ref": "#/$defs/identifier"},
        "test_reference": {"type": "string", "pattern": "^tests/test_capital_structure_[A-Za-z0-9_]+\\.py(?:::[A-Za-z0-9_\\[\\]-]+)*$"},
        "proven_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "price_assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "currency", "fixed_price", "path"],
      "properties": {
        "kind": {"$ref": "#/$defs/price_kind"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "fixed_price": {"$ref": "#/$defs/nullable_decimal"},
        "path": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{"$ref": "#/$defs/date"}, {"$ref": "#/$defs/decimal"}],
            "items": false,
            "minItems": 2
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "fixed"}}, "required": ["kind"]},
          "then": {"properties": {"fixed_price": {"$ref": "#/$defs/decimal"}, "path": {"maxItems": 0}}},
          "else": {"properties": {"fixed_price": {"type": "null"}, "path": {"minItems": 1}}}
        }
      ]
    },
    "action_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "action", "settlement", "quantity", "conditions_assumed_met"],
      "properties": {
        "route_id": {"$ref": "#/$defs/identifier"},
        "action": {"$ref": "#/$defs/route_kind"},
        "settlement": {"$ref": "#/$defs/settlement"},
        "quantity": {"$ref": "#/$defs/nullable_quantity"},
        "conditions_assumed_met": {"$ref": "#/$defs/string_array"}
      }
    },
    "unknown_resolution": {
      "type": "object",
