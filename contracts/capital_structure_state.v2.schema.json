        "closing_balance": {"$ref": "#/$defs/usd_quantity"},
        "minimum_liquidity": {"$ref": "#/$defs/usd_quantity"},
        "gap": {"$ref": "#/$defs/usd_quantity"},
        "sources": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/flow"}, {"properties": {"kind": {"const": "source"}}}]}},
        "uses": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/flow"}, {"properties": {"kind": {"const": "use"}}}]}}
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value", "rationale"],
      "properties": {
        "key": {"$ref": "#/$defs/nonempty_string"},
        "value": {"$ref": "#/$defs/nonempty_string"},
        "rationale": {"$ref": "#/$defs/nonempty_string"}
      }
    },
