    "capacity_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "state_id",
        "scenario_id",
        "rule_pack_digest",
        "routes",
        "aggregate_bound",
        "receipt",
        "shared_pools",
        "binding_constraints",
        "unknown_constraints",
        "mutually_exclusive",
        "feasible_witness",
        "blockers",
        "unknowns"
      ],
      "properties": {
        "schema": {"const": "capital_structure.capacity_envelope.v2"},
        "state_id": {"$ref": "#/$defs/state_id"},
        "scenario_id": {"$ref": "#/$defs/scenario_id"},
        "rule_pack_digest": {"$ref": "#/$defs/sha256"},
        "routes": {"type": "array", "items": {"$ref": "#/$defs/route_bound"}},
        "aggregate_bound": {"$ref": "#/$defs/quantity"},
        "receipt": {"$ref": "#/$defs/calculation_receipt"},
        "shared_pools": {"type": "array", "items": {"$ref": "#/$defs/constraint"}},
        "binding_constraints": {"$ref": "#/$defs/identifier_array"},
        "unknown_constraints": {"$ref": "#/$defs/identifier_array"},
        "mutually_exclusive": {
          "type": "array",
          "items": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true}
        },
        "feasible_witness": {
          "anyOf": [
            {"type": "array", "items": {"$ref": "#/$defs/witness_allocation"}},
            {"type": "null"}
          ]
        },
        "blockers": {"$ref": "#/$defs/string_array"},
        "unknowns": {"$ref": "#/$defs/unknown_array"}
      },
      "allOf": [
        {
          "if": {"properties": {"aggregate_bound": {"properties": {"status": {"not": {"const": "known"}}}, "required": ["status"]}}, "required": ["aggregate_bound"]},
          "then": {
            "anyOf": [
              {"properties": {"unknown_constraints": {"minItems": 1}}},
              {"properties": {"unknowns": {"minItems": 1}}},
              {"properties": {"blockers": {"minItems": 1}}}
            ]
          }
        }
      ]
    },
    "cash_effect": {
      "type": "object",
      "additionalProperties": false,
