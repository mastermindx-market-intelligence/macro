    "share_basis_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "issuer_id",
        "security_class_id",
        "as_of",
        "status",
        "provenance",
        "receipt",
        "selected",
        "candidates",
        "conflicts",
        "corporate_action"
      ],
      "properties": {
        "schema": {"const": "capital_structure.share_basis_result.v2"},
        "issuer_id": {"$ref": "#/$defs/identifier"},
        "security_class_id": {"$ref": "#/$defs/identifier"},
        "as_of": {"$ref": "#/$defs/timestamp"},
        "status": {"$ref": "#/$defs/share_basis_status"},
        "provenance": {"allOf": [{"$ref": "#/$defs/family_provenance"}, {"properties": {"family": {"const": "share_basis"}}}]},
        "receipt": {"$ref": "#/$defs/calculation_receipt"},
        "selected": {"$ref": "#/$defs/nullable_quantity"},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/share_observation_ref"}},
        "conflicts": {"$ref": "#/$defs/string_array"},
        "corporate_action": {"$ref": "#/$defs/corporate_action_basis"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "selected"}}, "required": ["status"]},
          "then": {
            "properties": {
              "selected": {
                "allOf": [
                  {"$ref": "#/$defs/quantity"},
                  {"properties": {"status": {"const": "known"}, "unit": {"const": "shares"}, "share_basis": {"const": "issued_and_outstanding"}}}
                ]
              }
            }
          },
          "else": {"properties": {"selected": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"const": "conflict"}}, "required": ["status"]},
          "then": {"properties": {"candidates": {"minItems": 2}, "conflicts": {"minItems": 1}}}
        }
      ]
    }
  }
}
