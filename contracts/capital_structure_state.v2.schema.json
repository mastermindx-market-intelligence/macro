      }
    },
    "corporate_action_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ratio", "effective_date", "contract_adjustment_evidence"],
      "properties": {
        "kind": {"$ref": "#/$defs/corporate_action_kind"},
        "ratio": {"$ref": "#/$defs/nullable_decimal"},
        "effective_date": {"$ref": "#/$defs/nullable_date"},
        "contract_adjustment_evidence": {"$ref": "#/$defs/evidence_array"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "none"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "ratio": {"type": "null"},
              "effective_date": {"type": "null"},
              "contract_adjustment_evidence": {"maxItems": 0}
            }
          },
          "else": {
            "properties": {
              "ratio": {"$ref": "#/$defs/decimal"},
              "effective_date": {"$ref": "#/$defs/date"},
              "contract_adjustment_evidence": {"minItems": 1}
            }
          }
        }
      ]
