        "resolving_fact": {"$ref": "#/$defs/nonempty_string"},
        "affects": {"$ref": "#/$defs/string_array"}
      }
    },
    "unknown_array": {"type": "array", "items": {"$ref": "#/$defs/unknown"}},
    "witness_allocation": {
      "type": "object",
      "additionalProperties": false,
