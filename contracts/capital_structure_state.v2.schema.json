            "items": false,
            "minItems": 2
          }
        },
        "unknown_resolutions": {"type": "array", "items": {"$ref": "#/$defs/unknown_resolution"}},
        "label": {"$ref": "#/$defs/nullable_string"}
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "kind",
        "bound",
        "status",
        "stock_or_flow",
        "shared_by",
        "applicability",
        "evidence",
        "window_start",
        "window_end"
      ],
      "properties": {
        "constraint_id": {"$ref": "#/$defs/identifier"},
