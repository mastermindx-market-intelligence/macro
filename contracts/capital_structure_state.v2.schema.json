        "route_kind": {"$ref": "#/$defs/route_kind"},
        "limit": {"$ref": "#/$defs/quantity"},
        "status": {"$ref": "#/$defs/route_status"},
        "conditions": {"$ref": "#/$defs/string_array"},
        "consumes": {"$ref": "#/$defs/identifier_array"},
        "applicability": {"$ref": "#/$defs/nullable_string"},
        "evidence": {"$ref": "#/$defs/evidence_array"}
      },
      "allOf": [
        {
          "if": {"properties": {"limit": {"properties": {"status": {"const": "known"}}, "required": ["status"]}}, "required": ["limit"]},
          "then": {
            "properties": {
              "evidence": {"type": "array", "minItems": 1},
              "applicability": {"$ref": "#/$defs/nonempty_string"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "conditional"}}, "required": ["status"]},
          "then": {"properties": {"conditions": {"type": "array", "minItems": 1}}}
