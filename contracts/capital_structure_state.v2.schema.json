        "security_class_id",
        "kind",
        "status",
        "candidate_term_ids",
        "resolution",
        "amendments",
        "outstanding",
        "provenance"
      ],
      "properties": {
        "instrument_id": {"$ref": "#/$defs/identifier"},
        "security_class_id": {"$ref": "#/$defs/identifier"},
        "kind": {"$ref": "#/$defs/instrument_kind"},
        "status": {"$ref": "#/$defs/instrument_status"},
        "candidate_term_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "resolution": {"$ref": "#/$defs/resolution"},
        "amendments": {"$ref": "#/$defs/string_array"},
        "outstanding": {"$ref": "#/$defs/nullable_quantity"},
        "provenance": {"$ref": "#/$defs/nullable_provenance"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "unresolved_candidate"}}, "required": ["status"]},
          "then": {"properties": {"resolution": {"properties": {"method": {"const": "unresolved"}}}}},
          "else": {"properties": {"resolution": {"properties": {"method": {"not": {"const": "unresolved"}}}}}}
        }
      ]
    },
    "instrument_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "issuer_id", "as_of", "instruments", "provenance", "receipt", "unresolved_candidate_ids"],
      "properties": {
        "schema": {"const": "capital_structure.instrument_set.v2"},
        "issuer_id": {"$ref": "#/$defs/identifier"},
        "as_of": {"$ref": "#/$defs/timestamp"},
        "instruments": {"type": "array", "items": {"$ref": "#/$defs/instrument"}},
        "provenance": {"allOf": [{"$ref": "#/$defs/family_provenance"}, {"properties": {"family": {"const": "instruments"}}}]},
        "receipt": {"$ref": "#/$defs/calculation_receipt"},
        "unresolved_candidate_ids": {"$ref": "#/$defs/identifier_array"}
      }
    },
    "share_observation_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "basis", "as_of_date", "security_class_id", "value", "source"],
