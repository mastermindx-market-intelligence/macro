        "stock_or_flow": {"$ref": "#/$defs/stock_or_flow"},
        "shared_by": {"$ref": "#/$defs/identifier_array"},
        "applicability": {"$ref": "#/$defs/nullable_string"},
        "evidence": {"$ref": "#/$defs/evidence_array"},
        "window_start": {"$ref": "#/$defs/nullable_date"},
        "window_end": {"$ref": "#/$defs/nullable_date"}
      },
      "allOf": [
        {
          "if": {"properties": {"bound": {"properties": {"status": {"const": "known"}}, "required": ["status"]}}, "required": ["bound"]},
          "then": {
            "properties": {
              "evidence": {"type": "array", "minItems": 1},
              "applicability": {"$ref": "#/$defs/nonempty_string"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["binding", "slack"]}}, "required": ["status"]},
          "then": {"properties": {"bound": {"properties": {"status": {"const": "known"}}}}}
        }
      ]
    },
    "route_bound": {
      "type": "object",
