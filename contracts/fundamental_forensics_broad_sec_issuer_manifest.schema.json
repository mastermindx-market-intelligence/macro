{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/fundamental_forensics_broad_sec_issuer_manifest.schema.json",
  "title": "Filing Forensics broad SEC issuer source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_id",
    "cik",
    "ticker",
    "submissions_sha256",
    "submissions_url",
    "submissions_object_key",
    "submissions_retrieved_at",
    "companyfacts_sha256",
    "companyfacts_url",
    "companyfacts_object_key",
    "companyfacts_retrieved_at",
    "companyfacts_snapshot_kind",
    "relevant_filings",
    "withheld_filings",
    "cumulative_relevant_accessions",
    "previous_manifest_id",
    "recorded_at",
    "sec_accepted_at",
    "filed_on"
  ],
  "properties": {
    "schema": {"const": "fundamental_forensics.broad_sec.issuer_manifest.v1"},
    "manifest_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
    "ticker": {"type": "string", "minLength": 1},
    "submissions_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "submissions_url": {"type": "string", "minLength": 20},
    "submissions_object_key": {"type": "string"},
    "submissions_retrieved_at": {"type": "string", "minLength": 20},
    "submissions_source_set_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "submissions_components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_kind",
          "source_name",
          "url",
          "sha256",
          "bytes",
          "object_key",
          "retrieved_at",
          "http_etag",
          "http_last_modified",
          "filing_from",
          "filing_to"
        ],
        "properties": {
          "source_kind": {"enum": ["recent", "historical"]},
          "source_name": {"type": ["string", "null"]},
          "url": {"type": "string", "minLength": 20},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
          "object_key": {"type": "string"},
          "retrieved_at": {"type": "string", "minLength": 20},
          "http_etag": {"type": ["string", "null"]},
          "http_last_modified": {"type": ["string", "null"]},
          "filing_from": {"type": ["string", "null"]},
          "filing_to": {"type": ["string", "null"]}
        }
      }
    },
    "companyfacts_sha256": {
      "anyOf": [
        {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        {"type": "null"}
      ]
    },
    "companyfacts_url": {"type": ["string", "null"]},
    "companyfacts_object_key": {"type": ["string", "null"]},
    "companyfacts_retrieved_at": {"type": ["string", "null"]},
    "companyfacts_snapshot_kind": {"enum": ["current_observed", "not_fetched"]},
    "relevant_filings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cik",
          "ticker",
          "accession_number",
          "form",
          "filing_date",
          "report_date",
          "acceptance_datetime",
          "primary_document",
          "is_xbrl",
          "is_inline_xbrl"
        ],
        "properties": {
          "cik": {"type": "string"},
          "ticker": {"type": "string"},
          "accession_number": {"type": "string"},
          "form": {"type": "string"},
          "filing_date": {"type": ["string", "null"]},
          "report_date": {"type": ["string", "null"]},
          "acceptance_datetime": {"type": ["string", "null"]},
          "primary_document": {"type": ["string", "null"]},
          "is_xbrl": {"type": ["boolean", "null"]},
          "is_inline_xbrl": {"type": ["boolean", "null"]}
        }
      }
    },
    "withheld_filings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cik",
          "ticker",
          "accession_number",
          "form",
          "filing_date",
          "report_date",
          "acceptance_datetime",
          "primary_document",
          "is_xbrl",
          "is_inline_xbrl",
          "withheld_reason",
          "withheld_cause"
        ],
        "properties": {
          "cik": {"type": "string"},
          "ticker": {"type": "string"},
          "accession_number": {"type": ["string", "null"]},
          "form": {"type": "string"},
          "filing_date": {"type": ["string", "null"]},
          "report_date": {"type": ["string", "null"]},
          "acceptance_datetime": {"type": ["string", "null"]},
          "primary_document": {"type": ["string", "null"]},
          "is_xbrl": {"type": ["boolean", "null"]},
          "is_inline_xbrl": {"type": ["boolean", "null"]},
          "withheld_reason": {"type": "string"},
          "withheld_cause": {"type": "string"}
        }
      }
    },
    "cumulative_relevant_accessions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "previous_manifest_id": {"type": ["string", "null"]},
    "filing_corrections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "correction_id",
          "rule_id",
          "decision_id",
          "accession_number",
          "field",
          "prior_value",
          "current_value",
          "prior_comparison_key",
          "current_comparison_key",
          "classification",
          "source_timezone",
          "applied_offset_seconds",
          "offset_kind",
          "prior_manifest_id",
          "prior_component_sha256",
          "current_component_sha256",
          "admitting_source_set_sha256",
          "non_time_facts_sha256"
        ],
        "properties": {
          "correction_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "rule_id": {"const": "FF-1-SEC-ACCEPTANCE-SOURCE-CORRECTION-LINEAGE"},
          "decision_id": {"const": "DEC:FF-1-SEC-ACCEPTANCE-SOURCE-CORRECTION-LINEAGE"},
          "accession_number": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
          "field": {"enum": ["acceptance_datetime"]},
          "prior_value": {"type": "string", "minLength": 20},
          "current_value": {"type": "string", "minLength": 20},
          "prior_comparison_key": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "string"}
          },
          "current_comparison_key": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "string"}
          },
          "classification": {"const": "sec_acceptance_timezone_restatement"},
          "source_timezone": {"const": "America/New_York"},
          "applied_offset_seconds": {"enum": [14400, 18000]},
          "offset_kind": {"enum": ["EDT", "EST"]},
          "prior_manifest_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "prior_component_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "current_component_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "admitting_source_set_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "non_time_facts_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "recorded_at": {"type": "string", "minLength": 20},
    "sec_accepted_at": {"type": ["string", "null"]},
    "filed_on": {"type": ["string", "null"]}
  }
}
