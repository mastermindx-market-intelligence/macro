{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/risk_envelope.schema.json",
  "title": "Mastermind Risk Envelope v1 (Grey Deer settled projection)",
  "description": "Three orthogonal answers carried side by side and never blended: measured slow trend, descriptive transition hazard, and capital posture as a display projection of active policies. Birth authority is DESCRIPTIVE ONLY - every authority boolean is false and hazard_stage may never be ARMED or TRIGGERING.",
  "type": "object",
  "required": [
    "schema", "definition_id", "market", "revision", "bundle_id", "source_session",
    "as_of", "observed_at", "produced_at", "stale_after", "measured_state",
    "hazard_summary", "episodes", "policies", "policy_summary", "data_state",
    "coherence", "coverage", "freshness", "correction", "provenance", "authority"
  ],
  "properties": {
    "schema": {"const": "mastermind.risk_envelope/v1"},
    "definition_id": {"type": "string", "minLength": 1},
    "market": {"type": "string", "minLength": 1},
    "revision": {"enum": ["settled", "live_provisional", "corrected"]},
    "bundle_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "source_session": {"type": ["string", "null"]},
    "as_of": {"type": ["string", "null"]},
    "observed_at": {"type": "string"},
    "produced_at": {"type": "string"},
    "stale_after": {"type": ["string", "null"]},

    "measured_state": {
      "type": "object",
      "description": "The slow trend organ carried verbatim. verdict/score are null when the organ is missing or stale - never substituted with a default.",
      "required": ["source_artifact", "verdict", "score", "role", "as_of", "usable"],
      "properties": {
        "source_artifact": {"type": ["string", "null"]},
        "verdict": {"type": ["string", "null"], "enum": ["RISK_ON", "MIXED", "RISK_OFF", null]},
        "score": {"type": ["number", "null"]},
        "role": {"const": "slow_confirmed_trend"},
        "as_of": {"type": ["string", "null"]},
        "usable": {"type": "boolean"}
      }
    },

    "hazard_summary": {
      "type": "object",
      "description": "Descriptive transition hazard. stage null means NOT LAWFULLY KNOWABLE with current coverage - it is neither NONE nor 0. ARMED/TRIGGERING are anticipatory claims reserved for separately promoted experts and are absent from this enum by construction.",
      "required": [
        "stage", "stage_reason", "unreadable_sources", "contributing_sources",
        "primary_episode_id", "active_episode_count", "stage_since", "display_only"
      ],
      "properties": {
        "stage": {"enum": ["NONE", "FRAGILE", "TRANSMITTING", "BREAKDOWN", null]},
        "stage_reason": {
          "description": "Why the stage is what it is. `required_source_state_unmapped` was added by GD-2R1: a required source that is FRESH but publishes a state this build cannot map nulls the stage, so an optional calm source can never decide the answer alone. Widening an enum within v1 - no version bump.",
          "enum": [
            "observed_settled_evidence",
            "required_coverage_unavailable",
            "required_source_state_unmapped",
            "no_usable_hazard_evidence"
          ]
        },
        "unmapped_required_sources": {"type": "array", "items": {"type": "string"}},
        "capped_sources": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Sources whose stage claim exceeded the stage they are competent to observe; admitted at their ceiling, named here so the demotion is auditable."
        },
        "stage_since_basis": {
          "const": "no_episode_lifecycle_in_v0",
          "description": "V0 owns no episode lifecycle, so there is no lawful first-observed transition instant and stage_since is always null. A source's own retrospective onset stays in provenance.sources[].detail."
        },
        "unreadable_sources": {"type": "array", "items": {"type": "string"}},
        "contributing_sources": {"type": "array", "items": {"type": "string"}},
        "primary_episode_id": {"type": ["string", "null"]},
        "active_episode_count": {"type": "integer", "minimum": 0},
        "stage_since": {"type": ["string", "null"]},
        "display_only": {"const": true}
      }
    },

    "episodes": {
      "type": "array",
      "description": "V0 mints no episodes - the Risk Envelope owns no forward ledger.",
      "maxItems": 0
    },
    "policies": {
      "type": "array",
      "description": "V0 carries no policies - no registered policy object exists yet.",
      "maxItems": 0
    },
    "policy_summary": {
      "type": "object",
      "description": "Display projection of active policies. NORMAL with zero policies means nothing is restricted, NOT a judgement that conditions are normal.",
      "required": ["posture", "active_policy_ids", "policy_count", "basis", "display_only"],
      "properties": {
        "posture": {
          "enum": ["NORMAL", "SELECTIVE", "PROTECTIVE", "DEFENSIVE_ONLY", "NO_NEW_RISK", "EMERGENCY"]
        },
        "active_policy_ids": {"type": "array", "maxItems": 0},
        "policy_count": {"type": "integer", "minimum": 0, "maximum": 0},
        "basis": {"const": "zero_active_policies"},
        "display_only": {"const": true}
      }
    },

    "data_state": {"enum": ["FRESH", "PARTIAL", "DEGRADED", "STALE", "UNKNOWN"]},
    "repair_state": {
      "enum": ["NONE", "IMPULSE", "BROADENING", "CONFIRMED", "FAILED", null],
      "description": "V0 tracks no repair lifecycle (needs an episode store); always null."
    },

    "coherence": {
      "type": "object",
      "description": "Do the answers agree? A structural verdict, never a severity and never a score.",
      "required": ["state", "scope", "contradictions", "contradiction_count", "display_only"],
      "properties": {
        "state": {"enum": ["ALIGNED", "MIXED", "CONTRADICTORY"]},
        "scope": {
          "const": "market_reads",
          "description": "GD-2R1: coherence compares the measured trend against the hazard evidence and NOTHING else. Capital policy is orthogonal - a posture built from zero policies cannot agree or disagree with a market reading - so it never participates."
        },
        "compares": {"type": "array", "items": {"type": "string"}},
        "excludes": {"type": "array", "items": {"type": "string"}},
        "contradictions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "left", "left_state", "right", "right_state"],
            "properties": {
              "kind": {"enum": ["trend_vs_hazard", "hazard_split"]},
              "left": {"type": ["string", "null"]},
              "left_state": {"type": ["string", "null"]},
              "right": {"type": ["string", "null"]},
              "right_state": {"type": ["string", "null"]}
            }
          }
        },
        "contradiction_count": {"type": "integer", "minimum": 0},
        "display_only": {"const": true}
      }
    },

    "coverage": {
      "type": "object",
      "required": ["required", "optional", "fresh", "stale", "missing", "source_count"],
      "properties": {
        "required": {"type": "array", "items": {"type": "string"}},
        "optional": {"type": "array", "items": {"type": "string"}},
        "fresh": {"type": "array", "items": {"type": "string"}},
        "stale": {"type": "array", "items": {"type": "string"}},
        "missing": {"type": "array", "items": {"type": "string"}},
        "source_count": {"type": "integer", "minimum": 0}
      }
    },

    "freshness": {
      "type": "object",
      "description": "Per-source clocks kept separate. Three separate truths need three separate clocks; collapsing them to one page timestamp is what makes a stale organ look current.",
      "required": ["source_session", "per_source", "off_session_sources", "all_on_session"],
      "properties": {
        "source_session": {"type": ["string", "null"]},
        "per_source": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["as_of", "state", "matches_session"],
            "properties": {
              "as_of": {"type": ["string", "null"]},
              "state": {"enum": ["FRESH", "STALE", "MISSING"]},
              "matches_session": {"type": ["boolean", "null"]}
            }
          }
        },
        "off_session_sources": {"type": "array", "items": {"type": "string"}},
        "all_on_session": {"type": "boolean"}
      }
    },

    "correction": {"type": ["object", "null"]},

    "provenance": {
      "type": "object",
      "required": ["sources", "composer", "excludes"],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id", "role", "state", "score", "as_of", "coverage", "required", "hazard_stage"],
            "properties": {
              "source_id": {"type": "string"},
              "role": {"enum": ["measured_state", "hazard_evidence", "context"]},
              "state": {"type": ["string", "null"]},
              "score": {"type": ["number", "null"]},
              "as_of": {"type": ["string", "null"]},
              "coverage": {"enum": ["FRESH", "STALE", "MISSING"]},
              "required": {"type": "boolean"},
              "hazard_stage": {"enum": ["NONE", "FRAGILE", "TRANSMITTING", "BREAKDOWN", null]},
              "label_en": {"type": ["string", "null"]},
              "label_zh": {"type": ["string", "null"]},
              "detail": {"type": "object"}
            }
          }
        },
        "composer": {"const": "engine/risk_envelope.py"},
        "excludes": {"type": "array", "items": {"type": "string"}}
      }
    },

    "multi_asset_context": {
      "type": "object",
      "description": "Optional non-voting US-listed cross-asset proxy comparison. Session-labelled current-cache observations, not intraday signals, original-vintage backtests, fund flows, forecasts or allocations. Capture time is a read receipt excluded from the envelope semantic bundle; source corrections and freshness remain included.",
      "required": [
        "schema",
        "method_version",
        "captured_at",
        "context_digest",
        "alignment_basis",
        "status",
        "base_currency",
        "benchmark_instrument_id",
        "display_only",
        "no_predictive_claim",
        "historical_original_availability_proven",
        "provider_available_at",
        "rows",
        "coverage",
        "window",
        "authority",
        "reasons",
        "benchmark_return",
        "source_kind",
        "capture_coherence",
        "limitations"
      ],
      "properties": {
        "schema": {
          "const": "mastermind.multi_asset_daily_context/v1"
        },
        "method_version": {
          "const": "same_us_cash_session_snapshot.v1"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "context_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "alignment_basis": {
          "const": "US_CASH_SESSION_LABEL_NOT_QUOTE_TIMESTAMP"
        },
        "status": {
          "enum": [
            "AVAILABLE",
            "PARTIAL",
            "STALE",
            "UNAVAILABLE"
          ]
        },
        "base_currency": {
          "const": "USD"
        },
        "benchmark_instrument_id": {
          "const": "SPY"
        },
        "display_only": {
          "const": true
        },
        "no_predictive_claim": {
          "const": true
        },
        "historical_original_availability_proven": {
          "const": false
        },
        "provider_available_at": {
          "type": "null"
        },
        "rows": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instrument_id",
              "label_en",
              "label_zh",
              "asset_class",
              "exposure_region",
              "listing_market",
              "currency",
              "return_basis",
              "start_session",
              "end_session",
              "last_source_session",
              "status",
              "reasons",
              "absolute_return",
              "relative_return",
              "classification",
              "source_ref",
              "source_digest",
              "evidence_family_id"
            ],
            "properties": {
              "instrument_id": {
                "enum": [
                  "SPY",
                  "EFA",
                  "EEM",
                  "FXI",
                  "KWEB",
                  "GLD",
                  "HYG",
                  "TLT",
                  "SHY",
                  "USO",
                  "IBIT"
                ]
              },
              "label_en": {
                "type": "string",
                "maxLength": 160
              },
              "label_zh": {
                "type": "string",
                "maxLength": 160
              },
              "asset_class": {
                "enum": [
                  "equity",
                  "gold",
                  "credit",
                  "rates",
                  "energy",
                  "crypto"
                ]
              },
              "exposure_region": {
                "enum": [
                  "US",
                  "DM_EX_US",
                  "EM",
                  "CHINA_HK",
                  "CHINA_OFFSHORE",
                  "GLOBAL"
                ]
              },
              "listing_market": {
                "const": "US"
              },
              "currency": {
                "const": "USD"
              },
              "return_basis": {
                "const": "total_return"
              },
              "start_session": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "end_session": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "last_source_session": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": [
                  "OBSERVED",
                  "UNAVAILABLE"
                ]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 128
                },
                "maxItems": 16
              },
              "absolute_return": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": -1
              },
              "relative_return": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": -1
              },
              "classification": {
                "enum": [
                  "POSITIVE_AND_OUTPERFORMING",
                  "RELATIVE_RESILIENCE_ONLY",
                  "UNDERPERFORMING",
                  "IN_LINE",
                  null
                ]
              },
              "source_ref": {
                "type": "string",
                "pattern": "^data/yahoo/(SPY|EFA|EEM|FXI|KWEB|GLD|HYG|TLT|SHY|USO|IBIT)\\.parquet$"
              },
              "source_digest": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidence_family_id": {
                "const": "yahoo_daily_adjusted_prices"
              },
              "comparison_status": {
                "enum": [
                  "OBSERVED",
                  "UNAVAILABLE"
                ]
              }
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requested",
            "observed",
            "comparable",
            "invalid_sources"
          ],
          "properties": {
            "requested": {
              "const": 11
            },
            "observed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 11
            },
            "comparable": {
              "type": "integer",
              "minimum": 0,
              "maximum": 11
            },
            "invalid_sources": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            }
          }
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_session",
            "end_session",
            "expected_session",
            "horizon_sessions",
            "calendar_owner",
            "listing_timezone"
          ],
          "properties": {
            "start_session": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "end_session": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "expected_session": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "horizon_sessions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 252
            },
            "calendar_owner": {
              "const": "lib.nyse_calendar"
            },
            "listing_timezone": {
              "const": "America/New_York"
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "can_rank",
            "can_gate",
            "can_size",
            "can_trade"
          ],
          "properties": {
            "can_rank": {
              "const": false
            },
            "can_gate": {
              "const": false
            },
            "can_size": {
              "const": false
            },
            "can_trade": {
              "const": false
            }
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          },
          "maxItems": 16
        },
        "benchmark_return": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1
        },
        "source_kind": {
          "const": "captured_mutable_daily_cache"
        },
        "capture_coherence": {
          "const": "individually_hashed_not_atomic_bundle"
        },
        "limitations": {
          "const": [
            "not_intraday",
            "not_native_foreign_market_returns",
            "not_observed_fund_flows",
            "not_point_in_time_backtest_evidence",
            "funds_may_overlap",
            "cash_is_separate_from_short_duration_funds",
            "not_an_allocation_recommendation"
          ]
        }
      },
      "additionalProperties": false
    },
    "rotation_context": {
      "type": "object",
      "required": [
        "source_artifact",
        "state",
        "as_of",
        "usable",
        "coverage",
        "early_context",
        "confirmed_events",
        "excluded_reason",
        "display_only"
      ],
      "properties": {
        "source_artifact": {
          "const": "site-marketdata-rotation-events"
        },
        "state": {
          "enum": [
            "DEFENSIVE_RELATIVE_STRENGTH",
            "BROADENING",
            "MIXED_ROTATION",
            "NO_EARLY_SHIFT",
            null
          ]
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "usable": {
          "type": "boolean"
        },
        "coverage": {
          "enum": [
            "FRESH",
            "STALE",
            "MISSING"
          ]
        },
        "early_context": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "schema",
                "definition_id",
                "as_of",
                "display_only",
                "state",
                "coverage",
                "pairs",
                "source_pair_count",
                "pairs_omitted",
                "omitted_pair_ids",
                "lineage_source"
              ],
              "properties": {
                "schema": {
                  "const": "rotation_early_context/v1"
                },
                "definition_id": {
                  "type": "string",
                  "minLength": 1
                },
                "as_of": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "generated_utc": {"type": ["string", "null"]},
                "stale_after": {"type": ["string", "null"]},
                "freshness": {
                  "type": ["object", "null"],
                  "properties": {"stale": {"type": "boolean"}},
                  "additionalProperties": false
                },
                "produced_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "available_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "availability": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "display_only": {
                  "const": true
                },
                "state": {
                  "enum": [
                    "DEFENSIVE_RELATIVE_STRENGTH",
                    "BROADENING",
                    "MIXED_ROTATION",
                    "NO_EARLY_SHIFT",
                    null
                  ]
                },
                "reason_codes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "coverage": {
                  "type": "object"
                },
                "prior_loser_constituent_claim": {
                  "type": [
                    "boolean",
                    "string",
                    "null"
                  ]
                },
                "pairs": {
                  "type": "array",
                "maxItems": 12,
                  "items": {
                    "type": "object"
                  }
                },
                "source_pair_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "pairs_omitted": {
                  "type": "integer",
                  "minimum": 0
                },
                "omitted_pair_ids": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "lineage_source": {
                  "const": "site-marketdata-rotation-events"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "source_clock_receipt": {
          "type": "object",
          "properties": {
            "generated_utc": {"type": ["string", "null"]},
            "produced_at": {"type": ["string", "null"]},
            "available_at": {"type": ["string", "null"]},
            "stale_after": {"type": ["string", "null"]},
            "availability": {
              "type": ["object", "null"],
              "properties": {
                "status": {"type": ["string", "null"]},
                "available_at": {"type": ["string", "null"]}
              },
              "additionalProperties": false
            },
            "freshness": {
              "type": ["object", "null"],
              "properties": {"stale": {"type": "boolean"}},
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "confirmed_events": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "active_count",
                "active_ids",
                "active_ids_omitted",
                "as_of",
                "usable"
              ],
              "properties": {
                "active_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "active_ids": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "string"
                  }
                },
                "active_ids_omitted": {
                  "type": "integer",
                  "minimum": 0
                },
                "as_of": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "usable": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "excluded_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_only": {
          "const": true
        },
        "latest_observation": {
          "description": "Optional display-only rotation_observation_view/v1 wrapper lifted verbatim from the rotation artifact's early_context.latest_observation. The consumer mirror (V1-V8) validates it; a present non-object renders unreadable. It is never a stage, hazard, confluence or policy input."
        }
      },
      "additionalProperties": false
    },

    "confluence": {
      "type": "object",
      "required": [
        "definition_id",
        "state",
        "measured_backdrop",
        "rotation_state",
        "source_relationships",
        "nonredundant_components",
        "nonredundant_component_count",
        "unknown_lineage_sources",
        "excluded_sources",
        "lineage_status",
        "statistical_independence_established",
        "changes_hazard_stage",
        "changes_policy",
        "display_only"
      ],
      "properties": {
        "definition_id": {
          "const": "rotation-risk-confluence-v1"
        },
        "state": {
          "enum": [
            "DEFENSIVE_RELATIVE_STRENGTH__RISK_ON",
