{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/capital_structure_state_changes.v1.schema.json",
  "title": "Capital Structure Intelligence V2 — state change ledger (capital_structure.state_changes.v1)",
  "description": "One derived change ledger between two published capital-structure state generations (SPEC_U2 §1.1). The ledger is the nightly producer's second state artifact: every change inside it carries a closed kind and reason, a stable change identity, the exact published records as before/after, and the closed five-key evidence block with every key present. A baseline generation is stated, never padded with synthesized changes. Facts and historical knowledge only: no rank, size, entry, score, probability or recommendation.",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": {"$ref": "#/$defs/safe_property_name"},
  "required": [
    "schema",
    "contract_version",
    "from_generation_id",
    "to_generation_id",
    "from_as_of",
    "to_as_of",
    "baseline",
    "changes",
    "counts",
    "generated_at"
  ],
  "properties": {
    "schema": {"const": "capital_structure.state_changes.v1"},
    "contract_version": {
      "type": "string",
      "pattern": "^capital-structure-state-contracts/[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "from_generation_id": {
      "anyOf": [{"$ref": "#/$defs/generation_id"}, {"type": "null"}]
    },
    "to_generation_id": {"$ref": "#/$defs/generation_id"},
    "from_as_of": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "to_as_of": {"$ref": "#/$defs/timestamp"},
    "baseline": {"type": "boolean"},
    "changes": {"type": "array", "items": {"$ref": "#/$defs/state_change"}},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new_event",
        "corrected_observation",
        "withdrawn_observation",
        "input_support_changed",
        "rule_pack_changed",
        "horizon_moved"
      ],
      "properties": {
        "new_event": {"type": "integer", "minimum": 0},
        "corrected_observation": {"type": "integer", "minimum": 0},
        "withdrawn_observation": {"type": "integer", "minimum": 0},
        "input_support_changed": {"type": "integer", "minimum": 0},
        "rule_pack_changed": {"type": "integer", "minimum": 0},
        "horizon_moved": {"type": "integer", "minimum": 0}
      }
    },
    "generated_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "safe_property_name": {
      "type": "string",
      "not": {
        "pattern": "^(?:object_?keys?|raw_?(?:docs?|documents?)|scores?|probabilit(?:y|ies)|capacities|capacity|runway|overhang|fully_?diluted(?:_[a-z_]+)?|ranks?|ranking|sizing|position_?size|entry|prophet(?:_(?!authority$)[a-z_]+)?|likelihood|expected_dilution)$"
      }
    },
    "generation_id": {
      "type": "string",
      "pattern": "^state_bundle:cs:[A-Fa-f0-9]{32}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
    },
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "change_kind": {
      "enum": [
        "new_event",
        "corrected_observation",
        "withdrawn_observation",
        "input_support_changed",
        "rule_pack_changed",
        "horizon_moved"
      ]
    },
    "change_reason": {
      "enum": [
        "new_accession",
        "correction_version_incremented",
        "observation_absent_in_current",
        "family_support_transition",
        "rule_pack_digest_changed",
        "source_observation_horizon_moved",
        "material_filing_horizon_moved"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {"$ref": "#/$defs/safe_property_name"},
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "event_id": {"$ref": "#/$defs/identifier"},
        "logical_observation_id": {"$ref": "#/$defs/identifier"},
        "family": {"type": "string", "minLength": 1},
        "rule_pack_id": {"$ref": "#/$defs/identifier"},
        "horizon": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {"$ref": "#/$defs/safe_property_name"},
      "required": ["accession", "form", "source_manifest_id", "available_at", "correction_version"],
      "properties": {
        "accession": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "form": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "source_manifest_id": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "available_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "correction_version": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]}
      }
    },
    "published_record": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/safe_property_name"}
    },
    "state_change": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {"$ref": "#/$defs/safe_property_name"},
      "required": [
        "change_id",
        "kind",
        "reason",
        "issuer_id",
        "subject",
        "before",
        "after",
        "evidence",
        "from_generation_id",
        "to_generation_id"
      ],
      "properties": {
        "change_id": {
          "type": "string",
          "pattern": "^state_change:cs:[A-Fa-f0-9]{32}$"
        },
        "kind": {"$ref": "#/$defs/change_kind"},
        "reason": {"$ref": "#/$defs/change_reason"},
        "issuer_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "subject": {"$ref": "#/$defs/subject"},
        "before": {"anyOf": [{"$ref": "#/$defs/published_record"}, {"type": "null"}]},
        "after": {"anyOf": [{"$ref": "#/$defs/published_record"}, {"type": "null"}]},
        "evidence": {"$ref": "#/$defs/evidence"},
        "from_generation_id": {
          "anyOf": [{"$ref": "#/$defs/generation_id"}, {"type": "null"}]
        },
        "to_generation_id": {"$ref": "#/$defs/generation_id"}
      }
    }
  }
}
