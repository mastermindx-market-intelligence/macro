{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_schema",
    "availability",
    "unavailable_reason",
    "authority_ceiling",
    "can_rank",
    "can_size",
    "can_gate",
    "can_originate_signal",
    "can_add_candidates",
    "can_escalate",
    "explanation_id",
    "selection_sha256",
    "generation_id",
    "cohort_scope",
    "effective_at",
    "known_at",
    "version",
    "n_selected",
    "selected",
    "coverage",
    "concept_rights",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "mastermind.selection_cohort_projection.v1"
    },
    "source_schema": {
      "const": "mastermind.selection_cohort_read.v1"
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "overlap"],
      "properties": {
        "status": {
          "enum": ["EMPTY_SELECTION", "PARTIAL", "OK", "UNAVAILABLE"]
        },
        "overlap": {
          "enum": [
            "EMPTY_SELECTION",
            "OBSERVED_SHARED_CONCEPTS",
            "UNDETERMINED",
            "NO_MEANINGFUL_OVERLAP",
            "UNAVAILABLE"
          ]
        }
      }
    },
    "unavailable_reason": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ]
    },
    "authority_ceiling": {
      "const": "research_internal_only"
    },
    "can_rank": {"const": false},
    "can_size": {"const": false},
    "can_gate": {"const": false},
    "can_originate_signal": {"const": false},
    "can_add_candidates": {"const": false},
    "can_escalate": {"const": false},
    "explanation_id": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      ]
    },
    "selection_sha256": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "generation_id": {
      "anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
    },
    "cohort_scope": {
      "anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
    },
    "effective_at": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+(?:Z|[+-]\\d{2}:\\d{2})$"
        }
      ]
    },
    "known_at": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+(?:Z|[+-]\\d{2}:\\d{2})$"
        }
      ]
    },
    "version": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "corrects", "basis"],
          "properties": {
            "number": {"type": "integer", "minimum": 1},
            "corrects": {
              "anyOf": [
                {"type": "null"},
                {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              ]
            },
            "basis": {"const": "AS_KNOWN_AT_SELECTION"}
          }
        }
      ]
    },
    "n_selected": {"type": "integer", "minimum": 0},
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selection_id",
          "original_identity",
          "security_id",
          "reason_codes",
          "original_reasons",
          "n_concepts",
          "concepts_display",
          "n_concepts_withheld"
        ],
        "properties": {
          "selection_id": {"type": "string", "minLength": 1},
          "original_identity": {},
          "security_id": {
            "anyOf": [
              {"type": "string", "pattern": "^SEC:.+"},
              {"type": "null"}
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {"type": "string"}
          },
          "original_reasons": {},
          "n_concepts": {"type": "integer", "minimum": 0},
          "concepts_display": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["node_id", "kind"],
              "properties": {
                "node_id": {"type": "string", "minLength": 1},
                "kind": {"type": "string", "minLength": 1}
              }
            }
          },
          "n_concepts_withheld": {"type": "integer", "minimum": 0}
        }
      }
    },
    "coverage": {"type": "object"},
    "concept_rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n_concepts_total",
        "n_concepts_displayable",
        "n_concepts_withheld",
        "withheld_reasons"
      ],
      "properties": {
        "n_concepts_total": {"type": "integer", "minimum": 0},
        "n_concepts_displayable": {"type": "integer", "minimum": 0},
        "n_concepts_withheld": {"type": "integer", "minimum": 0},
        "withheld_reasons": {
          "type": "object",
          "additionalProperties": false,
          "required": ["RIGHTS_INTERNAL_ONLY", "RIGHTS_FAMILY_UNRESOLVED"],
          "properties": {
            "RIGHTS_INTERNAL_ONLY": {"type": "integer", "minimum": 0},
            "RIGHTS_FAMILY_UNRESOLVED": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
