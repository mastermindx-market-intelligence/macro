{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "query",
    "use_at",
    "subject_id",
    "state_generation_id",
    "state_sha256",
    "state_generated_at",
    "status",
    "subject",
    "reason_codes",
    "authority_caps"
  ],
  "properties": {
    "schema": {
      "const": "gmi.theme_state_read/v3"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective_at",
        "known_at"
      ],
      "properties": {
        "effective_at": {
          "type": "string",
          "minLength": 1
        },
        "known_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "state_generation_id": {
      "type": "string",
      "pattern": "^theme-state-v2:[0-9a-f]{20}$"
    },
    "state_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state_generated_at": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DESCRIPTIVE",
        "UNAVAILABLE"
      ]
    },
    "subject": {
      "anyOf": [
        {
          "$ref": "#/$defs/subject"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "authority_caps": {
      "$ref": "#/$defs/flags"
    },
    "use_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "UNAVAILABLE"
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "type": "null"
          },
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "DESCRIPTIVE"
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "$ref": "#/$defs/subject"
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gmi.theme_state_use_read.v1",
  "title": "Production ThemeState subject at actual use time",
  "description": "Exact source capture query is distinct from availability at use; no publication or rights authority is conveyed.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "grain",
        "null_reason"
      ],
      "properties": {
        "value": {},
        "grain": {
          "enum": [
            "DATE",
            "INSTANT",
            "UNAVAILABLE",
            "INVALID"
          ]
        },
        "null_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "null_reason"
      ],
      "properties": {
        "value": {},
        "null_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "availability",
        "null_reason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "availability": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ]
        },
        "null_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "code_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "receipt_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "schema",
        "generation_id",
        "sha256",
        "availability",
        "effective_at",
        "known_at",
        "available_at",
        "recorded_at",
        "subject_id",
        "graph_generation_id",
        "query"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "generation_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "availability": {
          "enum": [
            "AVAILABLE",
            "VALID_EMPTY",
            "UNAVAILABLE"
          ]
        },
        "effective_at": {
          "type": "string",
          "minLength": 1
        },
        "known_at": {
          "type": "string",
          "minLength": 1
        },
        "available_at": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "graph_generation_id": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effective_at",
            "known_at"
          ],
          "properties": {
            "effective_at": {
              "type": "string",
              "minLength": 1
            },
            "known_at": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ranking",
        "gating",
        "sizing",
        "insertion",
        "origination",
        "escalation",
        "trade",
        "predictive",
        "may_publish"
      ],
      "properties": {
        "ranking": {
          "type": "boolean",
          "const": false
        },
        "gating": {
          "type": "boolean",
          "const": false
        },
        "sizing": {
          "type": "boolean",
          "const": false
        },
        "insertion": {
          "type": "boolean",
          "const": false
        },
        "origination": {
          "type": "boolean",
          "const": false
        },
        "escalation": {
          "type": "boolean",
          "const": false
        },
        "trade": {
          "type": "boolean",
          "const": false
        },
        "predictive": {
          "type": "boolean",
          "const": false
        },
        "may_publish": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "theme_node_ids"
      ],
      "properties": {
        "state": {
          "enum": [
            "MAPPED",
            "UNMAPPED",
            "SUBJECT_IS_CANONICAL"
          ]
        },
        "theme_node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^theme:.+"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "MAPPED"
              }
            }
          },
          "then": {
            "properties": {
              "theme_node_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "UNMAPPED",
                  "SUBJECT_IS_CANONICAL"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "theme_node_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "source_position",
        "native_key",
        "value",
        "native_clocks",
        "units",
        "period",
        "window",
        "scenario",
        "compatibility_aliases",
        "usable_at_query",
        "reason_codes"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_position": {
          "type": "integer",
          "minimum": 0
        },
        "native_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "type": "object"
        },
        "native_clocks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effective_at",
            "known_at",
            "available_at",
            "recorded_at",
            "emitted_at"
          ],
          "properties": {
            "effective_at": {
              "$ref": "#/$defs/clock"
            },
            "known_at": {
              "$ref": "#/$defs/clock"
            },
            "available_at": {
              "$ref": "#/$defs/clock"
            },
            "recorded_at": {
              "$ref": "#/$defs/clock"
            },
            "emitted_at": {
              "$ref": "#/$defs/clock"
            }
          }
        },
        "units": {
          "$ref": "#/$defs/slot"
        },
        "period": {
          "$ref": "#/$defs/slot"
        },
        "window": {
          "$ref": "#/$defs/slot"
        },
        "scenario": {
          "$ref": "#/$defs/slot"
        },
        "compatibility_aliases": {
          "type": "object"
        },
        "usable_at_query": {
          "type": "boolean"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared",
        "observed",
        "completeness",
        "basis"
      ],
      "properties": {
        "declared": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "completeness": {
          "enum": [
            "UNPROVEN",
            "QUALIFIED_COMPLETE"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "family",
        "purpose",
        "native_read",
        "null_reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "UNAVAILABLE",
            "REJECTED",
            "QUALIFIED"
          ]
        },
        "family": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "purpose": {
          "const": "research_internal"
        },
        "native_read": {
          "type": "object"
        },
        "null_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_receipt",
        "rights",
        "historical_knowability",
        "identity_membership"
      ],
      "properties": {
        "status": {
          "enum": [
            "UNQUALIFIED",
            "SOURCE_QUALIFIED_RIGHTS_UNAVAILABLE"
          ]
        },
        "source_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/receipt_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "rights": {
          "$ref": "#/$defs/rights"
        },
        "historical_knowability": {
          "enum": [
            "UNPROVEN",
            "OWNER_RECEIPT_BOUND"
          ]
        },
        "identity_membership": {
          "enum": [
            "UNPROVEN",
            "OWNER_RECEIPT_BOUND",
            "NOT_APPLICABLE"
          ]
        }
      }
    },
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "presence",
        "freshness",
        "scope",
        "records",
        "conflicts",
        "coverage",
        "qualification",
        "null_reason",
        "freshness_policy",
        "observed_at",
        "overlap_observation"
      ],
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/source_ref"
        },
        "presence": {
          "enum": [
            "AVAILABLE",
            "VALID_EMPTY",
            "UNAVAILABLE",
            "INVALID"
          ]
        },
        "freshness": {
          "enum": [
            "FRESH",
            "STALE",
            "FUTURE",
            "UNKNOWN"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "basis",
            "selectors"
          ],
          "properties": {
            "status": {
              "enum": [
                "EXACT_OWNER_SCOPE",
                "REGIONAL_CONTEXT_ONLY",
                "UNSUPPORTED"
              ]
            },
            "basis": {
              "type": "string",
              "minLength": 1
            },
            "selectors": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "null_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "freshness_policy": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "minLength": 1
        },
        "overlap_observation": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "kind",
        "name_en",
        "name_zh",
        "source_family",
        "native_id",
        "canonical_mapping",
        "eligibility",
        "legs",
        "aggregation",
        "reason_codes"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "local_theme",
            "canonical_theme"
          ]
        },
        "name_en": {
          "type": "string",
          "minLength": 1
        },
        "name_zh": {
          "type": "string",
          "minLength": 1
        },
        "source_family": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "native_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "canonical_mapping": {
          "$ref": "#/$defs/mapping"
        },
        "eligibility": {
          "const": "NOT_QUALIFIED"
        },
        "legs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "foresight_cascade",
            "baskets",
            "radar_enriched",
            "radar",
            "subsector_rotation",
            "divergence_log",
            "narrative_emergence",
            "narrative_emergence_cn"
          ],
          "properties": {
            "foresight_cascade": {
              "$ref": "#/$defs/leg"
            },
            "baskets": {
              "$ref": "#/$defs/leg"
            },
            "radar_enriched": {
              "$ref": "#/$defs/leg"
            },
            "radar": {
              "$ref": "#/$defs/leg"
            },
            "subsector_rotation": {
              "$ref": "#/$defs/leg"
            },
            "divergence_log": {
              "$ref": "#/$defs/leg"
            },
            "narrative_emergence": {
              "$ref": "#/$defs/leg"
            },
            "narrative_emergence_cn": {
              "$ref": "#/$defs/leg"
            }
          }
        },
        "aggregation": {
          "type": "null"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "prior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_id",
        "state_sha256",
        "generated_at"
      ],
      "properties": {
        "generation_id": {
          "type": "string",
          "pattern": "^theme-state-v2:[0-9a-f]{20}$"
        },
        "state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generated_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "read_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "query",
        "subject_id",
        "state_generation_id",
        "state_sha256",
        "state_generated_at",
        "status",
        "subject",
        "reason_codes",
        "authority_caps"
      ],
      "properties": {
        "schema": {
          "const": "gmi.theme_state_read/v2"
        },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effective_at",
            "known_at"
          ],
          "properties": {
            "effective_at": {
              "type": "string",
              "minLength": 1
            },
            "known_at": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "state_generation_id": {
          "type": "string",
          "pattern": "^theme-state-v2:[0-9a-f]{20}$"
        },
        "state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "state_generated_at": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "DESCRIPTIVE",
            "UNAVAILABLE"
          ]
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/subject"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "authority_caps": {
          "$ref": "#/$defs/flags"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNAVAILABLE"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "type": "null"
              },
              "reason_codes": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "DESCRIPTIVE"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "$ref": "#/$defs/subject"
              }
            }
          }
        }
      ]
    }
  }
}
