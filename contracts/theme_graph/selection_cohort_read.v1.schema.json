                  "type": "string",
                  "pattern": "^theme:[^\\s:]+$"
                },
                "kind": {
                  "const": "theme"
                },
                "receipt_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "receipt_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "uniqueItems": true
