  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macro.local/contracts/theme_graph/selection_cohort_read.v1.schema.json",
  "title": "Immutable owner selection cohort explanation (W3C)",
  "description": "Pure internal-only compiler output. Original owner rows are opaque and preserved verbatim, including incumbent owner fields. Closed W3C fields confer no selection or trading authority. Inputs require precise source-owner cutoff and qualified PIT identity, membership, rights and state receipts. Natural events and consumer/consequence wiring are separate acceptance obligations.",
  "$defs": {
    "owner_state_read_contract": {
      "$id": "https://mastermind-x.com/contracts/theme_graph/theme_state.v1.schema.json?read-receipt-schema=a792ce31c36bc6df",
      "$defs": {
        "observation": {
          "additionalProperties": false,
          "properties": {
            "conflicts": {
              "items": {},
              "type": "array"
            },
            "coverage": {
              "additionalProperties": false,
              "properties": {
                "basis": {
                  "minLength": 1,
                  "type": "string"
                },
                "declared": {
                  "minimum": 0,
                  "type": "integer"
                },
                "observed": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "declared",
                "observed",
                "basis"
              ],
              "type": "object"
            },
            "freshness": {
              "enum": [
                "FRESH",
                "STALE",
                "FUTURE",
                "UNKNOWN"
              ]
            },
            "freshness_policy": {
              "additionalProperties": false,
              "properties": {
                "max_age_hours": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "owner_policy_revision": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "max_age_hours",
                "owner_policy_revision"
              ],
              "type": "object"
            },
            "null_reason": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "minLength": 1,
                  "type": "string"
                }
              ]
            },
            "owner": {
              "minLength": 1,
              "type": "string"
            },
            "presence": {
              "enum": [
                "POSITIVE",
                "VALID_EMPTY",
                "UNAVAILABLE",
                "INVALID"
              ]
            },
            "schema": {
              "minLength": 1,
              "type": "string"
            },
            "source_receipts": {
              "items": {
                "$ref": "#/$defs/receipt"
              },
              "minItems": 1,
              "type": "array"
            },
            "units": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "minLength": 1,
                  "type": "string"
                }
              ]
            },
            "value": {},
            "window": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "minLength": 1,
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "owner",
            "schema",
            "presence",
            "freshness",
            "value",
            "null_reason",
            "units",
            "window",
            "coverage",
            "conflicts",
            "source_receipts",
            "freshness_policy"
          ],
          "type": "object"
        },
        "read_receipt": {
          "additionalProperties": false,
          "allOf": [
            {
              "else": {
                "properties": {
                  "reason_codes": {
                    "maxItems": 0
                  },
                  "subject": {
                    "$ref": "#/$defs/subject"
                  }
                }
              },
              "if": {
                "properties": {
                  "status": {
                    "const": "UNAVAILABLE"
                  }
                }
              },
              "then": {
                "properties": {
                  "reason_codes": {
