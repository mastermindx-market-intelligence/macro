              ],
              "properties": {
                "selection_id": {
                  "type": "string",
                  "minLength": 1
                },
                "security_id": {
                  "type": "string",
                  "pattern": "^SEC:[^\\s]+$"
                },
                "member_node_id": {
                  "type": "string",
                  "pattern": "^co:[^\\s]+$"
                },
                "evidence_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "rights_receipt_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "minItems": 1
          },
