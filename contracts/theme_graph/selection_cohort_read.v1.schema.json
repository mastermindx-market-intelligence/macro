          },
          "state_reason": {
            "type": "string",
            "minLength": 1
          },
          "node_kind": {
            "enum": [
              "local_theme",
              "theme"
            ]
          },
          "native_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "canonical_nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "node_id",
                "kind",
                "receipt_ref",
                "receipt_sha256"
              ],
              "properties": {
