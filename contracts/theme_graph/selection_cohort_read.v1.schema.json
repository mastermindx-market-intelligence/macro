            "type": "integer",
            "minimum": 1
          },
          "fraction_of_selected": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "state": {
            "anyOf": [
              {
                "$ref": "#/$defs/owner_state_read_contract"
