{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermindx.ai/contracts/theme_graph/activity_membership_history.v1.schema.json",
  "title": "GMI native activity membership history event (v1)",
  "$comment": "2026-10-21 additive amendment: second admitted activity species principal_business_activity (role operator, lifecycle current, segment-only scope, activity: fact ids); C01 shape unchanged via species-conditional allOf. Base evidence_lineage.fact_id keeps its existing minLength and adds the single regex alternation ^(integration|activity):[0-9a-f]{64}$; each species-conditional allOf branch pins its own prefix.",
  "description": "One versioned event in the history of a native activity membership (recovery 2026-10-16 section 9 step 3). APPEND, CORRECT and REMOVE are events; belief is folded by engine.theme_graph.materialize.apply_activity_membership_events for a knowledge cutoff, with knowledge-cutoff filtering before selection. A REMOVE takes effect only on a complete authoritative empty observation of an exhaustive roster; a timeout, partial read, changed shape or non-exhaustive roster never removes. The fold grants no materialize, publish or rank authority and is not wired into any build; edges.v1 is unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "event_sha256",
    "action",
    "membership_id",
    "species",
    "endpoints",
    "scope",
    "role",
    "lifecycle",
    "evidence_lineage",
    "use_qualification",
    "curation",
    "observation",
    "supersedes_event_sha256",
    "clocks"
  ],
  "properties": {
    "schema": {
      "const": "gmi.activity_membership_history_event/v1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^actevt:[0-9a-f]{24}$",
      "description": "actevt: plus the first 24 hex characters of event_sha256."
    },
    "event_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "sha256 of the canonical JSON of the event without event_id and event_sha256."
    },
    "action": {
      "enum": [
        "APPEND",
        "CORRECT",
        "REMOVE"
      ]
    },
    "membership_id": {
      "type": "string",
      "pattern": "^actmem:[0-9a-f]{24}$",
      "description": "actmem: plus sha256(canonical {source_node_id, target_node_id, species, scope})[:24]."
    },
    "species": {
      "enum": [
        "planned_product_integration",
        "principal_business_activity"
      ]
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_node_id",
        "target_node_id",
        "direction"
      ],
      "properties": {
        "source_node_id": {
          "type": "string",
          "pattern": "^co:[a-z]{2}:[A-Za-z0-9._-]+$"
        },
        "target_node_id": {
          "type": "string",
          "pattern": "^theme:[a-z0-9_]+$"
        },
        "direction": {
          "const": "SOURCE_TO_TARGET"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment"
      ],
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "counterparty_issuer_id": {
          "type": "string",
          "pattern": "^ISS:[A-Z0-9:._-]+$"
        },
        "segment": {
          "$ref": "#/$defs/segment"
        }
      }
    },
    "role": {
      "enum": [
        "component_supplier",
        "platform_owner",
        "operator"
      ]
    },
    "lifecycle": {
      "enum": [
        "planned",
        "current"
      ]
    },
    "evidence_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "fact_id",
        "fact_revision",
        "source_sha256",
        "span_text_sha256",
        "owner_bindings"
      ],
      "properties": {
        "proposal_id": {
          "type": "string",
          "pattern": "^actprop:[0-9a-f]{24}$"
        },
        "fact_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(integration|activity):[0-9a-f]{64}$"
        },
        "fact_revision": {
          "type": "integer",
          "minimum": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "span_text_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "owner_bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spec",
            "purpose",
            "adoption"
          ],
          "properties": {
            "spec": {
              "$ref": "#/$defs/sha256"
            },
            "purpose": {
              "$ref": "#/$defs/sha256"
            },
            "adoption": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "use_qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_membership_use"
      ],
      "properties": {
        "graph_membership_use": {
          "enum": [
            "GRANTED",
            "NOT_GRANTED"
          ]
        }
      }
    },
    "curation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/curation"
        }
      ]
    },
    "observation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/observation"
        }
      ]
    },
    "supersedes_event_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "clocks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge_at",
        "effective_at",
        "recorded_at"
      ],
      "properties": {
        "knowledge_at": {
          "$ref": "#/$defs/zoned_instant",
          "description": "When this event became known; the fold filters on it before selection."
        },
        "effective_at": {
          "$ref": "#/$defs/effective_at"
        },
        "recorded_at": {
          "$ref": "#/$defs/zoned_instant"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "APPEND"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "curation": {
            "$ref": "#/$defs/curation"
          },
          "supersedes_event_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "CORRECT"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "curation": {
            "$ref": "#/$defs/curation"
          },
          "supersedes_event_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "REMOVE"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "observation": {
            "$ref": "#/$defs/observation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "species": {
            "const": "planned_product_integration"
          }
        },
        "required": [
          "species"
        ]
      },
      "then": {
        "properties": {
          "role": {
            "enum": [
              "component_supplier",
              "platform_owner"
            ]
          },
          "lifecycle": {
            "const": "planned"
          },
          "scope": {
            "required": [
              "product",
              "platform",
              "counterparty_issuer_id",
              "segment"
            ]
          },
          "evidence_lineage": {
            "properties": {
              "fact_id": {
                "pattern": "^integration:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "species": {
            "const": "principal_business_activity"
          }
        },
        "required": [
          "species"
        ]
      },
      "then": {
        "properties": {
          "role": {
            "const": "operator"
          },
          "lifecycle": {
            "const": "current"
          },
          "scope": {
            "properties": {
              "product": false,
              "platform": false,
              "counterparty_issuer_id": false
            }
          },
          "evidence_lineage": {
            "properties": {
              "fact_id": {
                "pattern": "^activity:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "zoned_instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "state"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "KNOWN",
            "UNDISCLOSED",
            "NOT_APPLICABLE",
            "UNAVAILABLE",
            "STALE"
          ]
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "KNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      }
    },
    "effective_at": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "state"
      ],
      "properties": {
        "value": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          ]
        },
        "state": {
          "enum": [
            "KNOWN",
            "UNDISCLOSED",
            "NOT_APPLICABLE"
          ]
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "KNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      }
    },
    "curation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curator",
        "decision",
        "decided_at",
        "receipt_sha256"
      ],
      "properties": {
        "curator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "decision": {
          "enum": [
            "ACCEPT",
            "REJECT"
          ]
        },
        "decided_at": {
          "$ref": "#/$defs/zoned_instant"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completeness",
        "roster_exhaustive",
        "subject_present",
        "observed_at",
        "source_sha256"
      ],
      "properties": {
        "completeness": {
          "enum": [
            "COMPLETE_AUTHORITATIVE",
            "TIMEOUT",
            "PARTIAL",
            "CHANGED_SHAPE"
          ]
        },
        "roster_exhaustive": {
          "type": "boolean"
        },
        "subject_present": {
          "type": "boolean"
        },
        "observed_at": {
          "$ref": "#/$defs/zoned_instant"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
