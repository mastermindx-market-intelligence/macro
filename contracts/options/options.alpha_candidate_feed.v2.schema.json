{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "options.alpha_candidate_feed/v2",
  "title": "Derived options-alpha research-candidate feed v2 (inactive source-only core)",
  "description": "Pure source-only derived view composing canonical campaign evidence and measured microstructure. Formation retains immutable physical evidence while current revision and disposition vary. No caller durability or publication clock is accepted; generated_at is only the composition clock.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "generated_at",
    "feed_id",
    "header",
    "policy",
    "activation",
    "source_receipts",
    "formed_candidates",
    "abstentions",
    "publication_claim",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "options.alpha_candidate_feed/v2"
    },
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "feed_id": {
      "type": "string",
      "pattern": "^oacf_[a-f0-9]{24}$"
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composer_id",
        "implementation_carrier",
        "eligibility_state",
        "deterministic_seed",
        "formed_candidate_count",
        "abstention_count",
        "header_digest_sha256"
      ],
      "properties": {
        "composer_id": {
          "type": "string",
          "pattern": "^oacf_composer_[a-f0-9]{24}$"
        },
        "implementation_carrier": {
          "type": "string",
          "minLength": 1
        },
        "eligibility_state": {
          "enum": [
            "synthetic_until_publisher_validates_activation",
            "preregistered_inactive_until_activation"
          ]
        },
        "deterministic_seed": {
          "type": "string",
          "minLength": 1
        },
        "formed_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "abstention_count": {
          "type": "integer",
          "minimum": 0
        },
        "header_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "activation": {
      "$ref": "#/$defs/activation"
    },
    "source_receipts": {
      "$ref": "#/$defs/sourceReceipts"
    },
    "formed_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/formedCandidate"
      }
    },
    "abstentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/abstention"
      }
    },
    "publication_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "claim_reason"
      ],
      "properties": {
        "claim": {
          "const": "source_only_no_publication_effect"
        },
        "claim_reason": {
          "const": "The composition is pure and does not prove local durability, upload, consumer publication, or activation."
        }
      }
    },
    "authority": {
      "$ref": "#/$defs/falseAuthority"
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "policy_digest_sha256",
        "policy_path",
        "policy_schema"
      ],
      "properties": {
        "policy_id": {
          "const": "oa_member_persistent_measured_campaign/v2"
        },
        "policy_version": {
          "const": 1
        },
        "policy_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_path": {
          "const": "research/options_estate/options_alpha_candidate_formation_policy_v2.json"
        },
        "policy_schema": {
          "const": "options.alpha_candidate_formation_policy/v2"
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_receipt_id",
        "activation_receipt_digest_sha256",
        "activation_receipt_schema",
        "activation_receipt_path",
        "activation_preconditions",
        "all_preconditions_cleared",
        "fence_state",
        "policy_freeze_at",
        "activation_boundary_at"
      ],
      "properties": {
        "activation_receipt_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "activation_receipt_digest_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "activation_receipt_schema": {
          "const": "options.alpha_candidate_feed_activation_receipt/v1"
        },
        "activation_receipt_path": {
          "const": "research/options_estate/options_alpha_candidate_feed_activation_receipt_v1.json"
        },
        "activation_preconditions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "oa1t_measured_source_consumer_proven",
              "ad1t2_consumer_availability_production_accepted",
              "campaign_integrity_publication_runtime_accepted",
              "source_collision_review_clear"
            ]
          },
          "allOf": [
            {
              "contains": {
                "const": "oa1t_measured_source_consumer_proven"
              }
            },
            {
              "contains": {
                "const": "ad1t2_consumer_availability_production_accepted"
              }
            },
            {
              "contains": {
                "const": "campaign_integrity_publication_runtime_accepted"
              }
            },
            {
              "contains": {
                "const": "source_collision_review_clear"
              }
            }
          ]
        },
        "all_preconditions_cleared": {
          "type": "boolean"
        },
        "fence_state": {
          "enum": [
            "pre_policy_freeze",
            "post_policy_freeze_pre_activation",
            "post_activation"
          ]
        },
        "policy_freeze_at": {
          "type": "string",
          "format": "date-time"
        },
        "activation_boundary_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        }
      }
    },
    "sourceReceipts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaigns",
        "microstructure_map",
        "prior_feed"
      ],
      "properties": {
        "campaigns": {
          "$ref": "#/$defs/prefixReceipt"
        },
        "microstructure_map": {
          "$ref": "#/$defs/microstructureReceipt"
        },
        "prior_feed": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/priorFeedReceipt"
            }
          ]
        }
      }
    },
    "prefixReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "records",
        "prefix_sha256",
        "schema"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "records": {
          "type": "integer",
          "minimum": 0
        },
        "prefix_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema": {
          "const": "options.signal_campaign/v2"
        }
      }
    },
    "microstructureReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "entries_count",
        "entries_digest_sha256"
      ],
      "properties": {
        "schema": {
          "const": "options.trade_nbbo_microstructure/v1"
        },
        "entries_count": {
          "type": "integer",
          "minimum": 0
        },
        "entries_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "priorFeedReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feed_id",
        "schema",
        "feed_digest_sha256",
        "policy_id",
        "policy_digest_sha256",
        "composed_at",
        "first_observation_preserved",
        "candidate_identity_preserved"
      ],
      "properties": {
        "feed_id": {
          "type": "string",
          "pattern": "^oacf_[a-f0-9]{24}$"
        },
        "schema": {
          "const": "options.alpha_candidate_feed/v2"
        },
        "feed_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_id": {
          "const": "oa_member_persistent_measured_campaign/v2"
        },
        "policy_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "first_observation_preserved": {
          "type": "boolean"
        },
        "candidate_identity_preserved": {
          "type": "boolean"
        },
        "composed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "formedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "campaign_id",
        "first_qualifying_campaign_revision_id",
        "formation_micro",
        "current_campaign_revision_id",
        "source_formed_at",
        "first_observed_at",
        "decision_at",
        "frozen_formation",
        "current_revision",
        "current_disposition",
        "measured",
        "evidence_digests",
        "missingness",
        "contradictions",
        "state",
        "reasons",
        "versioned_updates"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^oacnd_[a-f0-9]{24}$"
        },
        "campaign_id": {
          "type": "string",
          "pattern": "^ocam_[a-f0-9]{24}$"
        },
        "first_qualifying_campaign_revision_id": {
          "type": "string",
          "pattern": "^ocrev_[a-f0-9]{24}$"
        },
        "current_campaign_revision_id": {
          "type": "string",
          "pattern": "^ocrev_[a-f0-9]{24}$"
        },
        "source_formed_at": {
          "type": "string",
          "format": "date-time"
        },
        "first_observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision_at": {
          "type": "string",
          "format": "date-time"
        },
        "formation_micro": {
          "$ref": "#/$defs/candidate/properties/measured"
        },
        "frozen_formation": {
          "$ref": "#/$defs/candidate/properties/frozen_formation"
        },
        "current_revision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/candidate/properties/current_revision"
            }
          ]
        },
        "current_disposition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reasons"
          ],
          "properties": {
            "state": {
              "enum": [
                "research_candidate",
                "abstain",
                "degraded"
              ]
            },
            "reasons": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "BEFORE_POLICY_FREEZE",
                  "BEFORE_ACTIVATION_BOUNDARY",
                  "CAMPAIGN_RECEIPT_INVALID",
                  "CAMPAIGN_NOT_PROSPECTIVE",
                  "INSUFFICIENT_CAMPAIGN_MEMBERS",
                  "FINAL_MEMBER_MICROSTRUCTURE_MISSING",
                  "NO_VALID_NBBO_MEASUREMENT",
                  "EVIDENCE_CLOCK_INVALID",
                  "SOURCE_EXPLICITLY_STALE_OR_UNAVAILABLE",
                  "UPSTREAM_AUTHORITY_VIOLATION",
                  "FORMATION_EVIDENCE_MISSING"
                ]
              }
            }
          }
        },
        "measured": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/candidate/properties/measured"
            }
          ]
        },
        "evidence_digests": {
          "$ref": "#/$defs/candidate/properties/evidence_digests"
        },
        "missingness": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "state": {
          "enum": [
            "research_candidate",
            "abstain",
            "degraded"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "versioned_updates": {
          "$ref": "#/$defs/candidate/properties/versioned_updates"
        },
        "post_formation_outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "join_revision_id",
            "horizons"
          ],
          "properties": {
            "schema": {
              "const": "options.alpha_candidate_post_formation_outcomes/v1"
            },
            "join_revision_id": {
              "type": "string",
              "pattern": "^ocrev_[a-f0-9]{24}$"
            },
            "horizons": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "h60",
                "eod",
                "1d",
                "3d",
                "5d",
                "10d"
              ],
              "properties": {
                "h60": {
                  "$ref": "#/$defs/postFormationOutcome"
                },
                "eod": {
                  "$ref": "#/$defs/postFormationOutcome"
                },
                "1d": {
                  "$ref": "#/$defs/postFormationOutcome"
                },
                "3d": {
                  "$ref": "#/$defs/postFormationOutcome"
                },
                "5d": {
                  "$ref": "#/$defs/postFormationOutcome"
                },
                "10d": {
                  "$ref": "#/$defs/postFormationOutcome"
                }
              }
            }
          }
        },
        "campaign_context": {
          "$ref": "#/$defs/campaignContext"
        }
      }
    },
    "postFormationOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "campaign_outcome_id",
        "campaign_revision_id",
        "horizon",
        "source_physical_ordinal",
        "source_physical_row_sha256",
        "status",
        "reason",
        "campaign_available_at",
        "computed_at",
        "target_time",
        "matured_at",
        "underlying",
        "source_outcome",
        "source_outcome_prefix"
      ],
      "properties": {
        "state": {
          "enum": [
            "available",
            "pending",
            "unavailable"
          ]
        },
        "campaign_outcome_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^ocout_[a-f0-9]{24}$"
        },
        "campaign_revision_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^ocrev_[a-f0-9]{24}$"
        },
        "horizon": {
          "enum": [
            "h60",
            "eod",
            "1d",
            "3d",
            "5d",
            "10d"
          ]
        },
        "source_physical_ordinal": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "source_physical_row_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "campaign_available_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "computed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "target_time": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "matured_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "underlying": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "ret",
                "mfe",
                "mae"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "complete",
                    "unavailable"
                  ]
                },
                "ret": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "mfe": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "mae": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "source_outcome": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "row",
                "row_sha256",
                "schema",
                "outcome_id",
                "episode_id",
                "horizon_anchor",
                "price_receipt_sha256",
                "price_source",
                "price_vintage",
                "source_receipt_schema"
              ],
              "properties": {
                "path": {
                  "enum": [
                    "data/options_signal_episode/outcomes_h60.jsonl",
                    "data/options_signal_episode/outcomes_session.jsonl"
                  ]
                },
                "row": {
                  "type": "integer",
                  "minimum": 1
                },
                "row_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "schema": {
                  "enum": [
                    "options.signal_episode_outcome/v1",
                    "options.signal_episode_session_outcome/v1"
                  ]
                },
                "outcome_id": {
                  "type": "string",
                  "pattern": "^oout_[a-f0-9]{24}$"
                },
                "episode_id": {
                  "type": "string",
                  "pattern": "^osep_[a-f0-9]{24}$"
                },
                "horizon_anchor": {
                  "type": "string",
                  "format": "date-time"
                },
                "price_receipt_sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{64}$"
                },
                "price_source": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "price_vintage": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "source_receipt_schema": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "source_outcome_prefix": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "records",
                "prefix_sha256"
              ],
              "properties": {
                "path": {
                  "enum": [
                    "data/options_signal_episode/outcomes_h60.jsonl",
                    "data/options_signal_episode/outcomes_session.jsonl"
                  ]
                },
                "records": {
                  "type": "integer",
                  "minimum": 1
                },
                "prefix_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "campaign_id",
        "first_qualifying_campaign_revision_id",
        "formation_micro",
        "current_campaign_revision_id",
        "source_formed_at",
        "first_observed_at",
        "decision_at",
        "frozen_formation",
        "current_revision",
        "measured",
        "evidence_digests",
        "missingness",
        "contradictions",
        "state",
        "reasons",
        "versioned_updates"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^oacnd_[a-f0-9]{24}$"
        },
        "campaign_id": {
          "type": "string",
          "pattern": "^ocam_[a-f0-9]{24}$"
        },
        "first_qualifying_campaign_revision_id": {
          "type": "string",
          "pattern": "^ocrev_[a-f0-9]{24}$"
        },
        "current_campaign_revision_id": {
          "type": "string",
          "pattern": "^ocrev_[a-f0-9]{24}$"
        },
        "source_formed_at": {
          "type": "string",
          "format": "date-time"
        },
        "first_observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision_at": {
          "type": "string",
          "format": "date-time"
        },
        "formation_micro": {
          "$ref": "#/$defs/candidate/properties/measured"
        },
        "frozen_formation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "campaign_revision_id",
            "formed_at",
            "policy_id",
            "policy_version",
            "policy_digest_sha256",
            "policy_freeze_at",
            "activation_boundary_at",
            "policy_freeze_cleared",
            "activation_boundary_cleared",
            "campaign_member_count",
            "final_member_event_id",
            "measured_source_print_count",
            "measured_nbbo_valid_print_count",
            "measured_nbbo_premium_coverage",
            "all_evidence_legs_within_decision_cutoff",
            "evidence_digest_sha256",
            "source_prefix_receipt",
            "candidate_identity_schema"
          ],
          "properties": {
            "campaign_revision_id": {
              "type": "string",
              "pattern": "^ocrev_[a-f0-9]{24}$"
            },
            "formed_at": {
              "type": "string",
              "format": "date-time"
            },
            "policy_id": {
              "const": "oa_member_persistent_measured_campaign/v2"
            },
            "policy_version": {
              "const": 1
            },
            "policy_digest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "policy_freeze_at": {
              "type": "string",
              "format": "date-time"
            },
            "activation_boundary_at": {
              "type": "string",
              "format": "date-time"
            },
            "policy_freeze_cleared": {
              "type": "boolean"
            },
            "activation_boundary_cleared": {
              "type": "boolean"
            },
            "campaign_member_count": {
              "type": "integer",
              "minimum": 2
            },
            "final_member_event_id": {
              "type": "string",
              "minLength": 1
            },
            "measured_source_print_count": {
              "type": "integer",
              "minimum": 1
            },
            "measured_nbbo_valid_print_count": {
              "type": "integer",
              "minimum": 1
            },
            "measured_nbbo_premium_coverage": {
              "type": "number",
              "exclusiveMinimum": 0.0,
              "maximum": 1.0
            },
            "all_evidence_legs_within_decision_cutoff": {
              "type": "boolean"
            },
            "evidence_digest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "source_prefix_receipt": {
              "$ref": "#/$defs/prefixReceipt"
            },
            "candidate_identity_schema": {
              "const": "options.alpha_candidate_identity/v1"
            }
          }
        },
        "measured": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_print_count",
            "nbbo_valid_print_count",
            "nbbo_premium_coverage",
            "source_premium_usd",
            "nbbo_covered_premium_usd",
            "schema",
            "schema_digest_sha256"
          ],
          "properties": {
            "source_print_count": {
              "type": "integer",
              "minimum": 1
            },
            "nbbo_valid_print_count": {
              "type": "integer",
              "minimum": 1
            },
            "nbbo_premium_coverage": {
              "type": "number",
              "exclusiveMinimum": 0.0,
              "maximum": 1.0
            },
            "source_premium_usd": {
              "type": "number",
              "minimum": 0.0
            },
            "nbbo_covered_premium_usd": {
              "type": "number",
              "minimum": 0.0
            },
            "schema": {
              "const": "options.trade_nbbo_microstructure/v1"
            },
            "schema_digest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "evidence_digests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "campaign_row_digest_sha256",
            "microstructure_row_digest_sha256",
            "policy_digest_sha256"
          ],
          "properties": {
            "campaign_row_digest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "microstructure_row_digest_sha256": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "policy_digest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "missingness": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "state": {
          "const": "research_candidate"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "current_revision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "campaign_revision_id",
            "revision_number",
            "formed_at"
          ],
          "properties": {
            "campaign_revision_id": {
              "type": "string",
              "pattern": "^ocrev_[a-f0-9]{24}$"
            },
            "revision_number": {
              "type": "integer",
              "minimum": 1
            },
            "formed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "versioned_updates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "campaign_revision_id",
              "revision_number",
              "revision_digest_sha256",
              "formed_at",
              "candidate_identity_unchanged",
              "observed_at"
            ],
            "properties": {
              "campaign_revision_id": {
                "type": "string",
                "pattern": "^ocrev_[a-f0-9]{24}$"
              },
              "revision_number": {
                "type": "integer",
                "minimum": 1
              },
              "revision_digest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "formed_at": {
                "type": "string",
                "format": "date-time"
              },
              "candidate_identity_unchanged": {
                "type": "boolean"
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "abstention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "campaign_revision_id",
        "formed_at",
        "reasons",
        "state",
        "first_observed_at"
      ],
      "properties": {
        "campaign_id": {
          "type": "string",
          "pattern": "^ocam_[a-f0-9]{24}$"
        },
        "campaign_revision_id": {
          "type": "string",
          "pattern": "^ocrev_[a-f0-9]{24}$"
        },
        "formed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "BEFORE_POLICY_FREEZE",
              "BEFORE_ACTIVATION_BOUNDARY",
              "CAMPAIGN_RECEIPT_INVALID",
              "CAMPAIGN_NOT_PROSPECTIVE",
              "INSUFFICIENT_CAMPAIGN_MEMBERS",
              "FINAL_MEMBER_MICROSTRUCTURE_MISSING",
              "NO_VALID_NBBO_MEASUREMENT",
              "EVIDENCE_CLOCK_INVALID",
              "SOURCE_EXPLICITLY_STALE_OR_UNAVAILABLE",
              "UPSTREAM_AUTHORITY_VIOLATION"
            ]
          }
        },
        "state": {
          "const": "abstain"
        },
        "first_observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "degraded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "campaign_revision_id",
        "formed_at",
        "first_observed_at",
        "retained_candidate_id",
        "reasons",
        "state",
        "first_observation_preserved",
        "decision_preserved"
      ],
      "properties": {
        "campaign_id": {
          "type": "string",
          "pattern": "^ocam_[a-f0-9]{24}$"
        },
        "campaign_revision_id": {
          "type": "string",
          "pattern": "^ocrev_[a-f0-9]{24}$"
        },
        "formed_at": {
          "type": "string",
          "format": "date-time"
        },
        "first_observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "retained_candidate_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^oacnd_[a-f0-9]{24}$"
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "BEFORE_POLICY_FREEZE",
              "BEFORE_ACTIVATION_BOUNDARY",
              "CAMPAIGN_RECEIPT_INVALID",
              "CAMPAIGN_NOT_PROSPECTIVE",
              "INSUFFICIENT_CAMPAIGN_MEMBERS",
              "FINAL_MEMBER_MICROSTRUCTURE_MISSING",
              "NO_VALID_NBBO_MEASUREMENT",
              "EVIDENCE_CLOCK_INVALID",
              "SOURCE_EXPLICITLY_STALE_OR_UNAVAILABLE",
              "UPSTREAM_AUTHORITY_VIOLATION"
            ]
          }
        },
        "state": {
          "const": "degraded"
        },
        "first_observation_preserved": {
          "type": "boolean"
        },
        "decision_preserved": {
          "type": "boolean"
        }
      }
    },
    "falseAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_originate",
        "may_rank",
        "may_score",
        "may_gate",
        "may_size",
        "may_issue",
        "may_trade",
        "may_publish_pick",
        "may_train_prophet",
        "may_feed_neural_web",
        "may_select",
        "may_escalate",
        "may_compute_option_pnl",
        "may_infer_bullish_bearish_probability",
        "may_create_tactical_event"
      ],
      "properties": {
        "may_originate": {
          "const": false
        },
        "may_rank": {
          "const": false
        },
        "may_score": {
          "const": false
        },
        "may_gate": {
          "const": false
        },
        "may_size": {
          "const": false
        },
        "may_issue": {
          "const": false
        },
        "may_trade": {
          "const": false
        },
        "may_publish_pick": {
          "const": false
        },
        "may_train_prophet": {
          "const": false
        },
        "may_feed_neural_web": {
          "const": false
        },
        "may_select": {
          "const": false
        },
        "may_escalate": {
          "const": false
        },
        "may_compute_option_pnl": {
          "const": false
        },
        "may_infer_bullish_bearish_probability": {
          "const": false
        },
        "may_create_tactical_event": {
          "const": false
        }
      }
    },
    "campaignContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "campaign_revision_id",
        "group",
        "flow_side_counts",
        "intent"
      ],
      "properties": {
        "schema": {
          "const": "options.alpha_candidate_campaign_context/v1"
        },
        "campaign_revision_id": {
          "type": "string",
          "pattern": "^ocrev_[a-f0-9]{24}$"
        },
        "group": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_date",
            "ticker",
            "right",
            "expiration",
            "strike",
            "strike_key"
          ],
          "properties": {
            "session_date": {
              "type": "string",
              "format": "date"
            },
            "ticker": {
              "type": "string",
              "pattern": "^[A-Z0-9.^=-]+$"
            },
            "right": {
              "enum": [
                "C",
                "P"
              ]
            },
            "expiration": {
              "type": "string",
              "format": "date"
            },
            "strike": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "strike_key": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
            }
          }
        },
        "flow_side_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "~buy",
            "~sell",
            "mixed"
          ],
          "properties": {
            "~buy": {
              "type": "integer",
              "minimum": 0
            },
            "~sell": {
              "type": "integer",
              "minimum": 0
            },
            "mixed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "opening_closing",
            "direction_reliability",
            "accumulation_distribution"
          ],
          "properties": {
            "opening_closing": {
              "const": "unavailable"
            },
            "direction_reliability": {
              "const": "soft"
            },
            "accumulation_distribution": {
              "const": "unavailable"
            }
          }
        }
      }
    }
