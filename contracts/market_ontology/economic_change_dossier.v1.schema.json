{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/market_ontology/economic_change_dossier.v1.schema.json",
  "title": "market_ontology.economic_change_dossier/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "definition_version", "domain_profile", "asof", "knowledge_cutoff",
    "authority_ceiling", "display_only", "authority", "scope", "subjects", "roles",
    "changes", "comparisons", "bridge", "capital_ownership", "expectations",
    "market_context", "counterevidence", "relationships", "native_context", "coverage",
    "unavailable", "continuation", "provenance"
  ],
  "properties": {
    "schema": {"const": "market_ontology.economic_change_dossier/v1"},
    "definition_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "domain_profile": {"enum": ["energy", "technology", "healthcare", "basic_materials", "consumer_defensive", "semiconductors", "robotics", "other"]},
    "asof": {"type": "string", "format": "date"},
    "knowledge_cutoff": {"type": "string", "format": "date"},
    "authority_ceiling": {"const": "research_display_only"},
    "display_only": {"const": true},
    "authority": {"$ref": "#/$defs/authority"},
    "scope": {"$ref": "#/$defs/scope"},
    "subjects": {"type": "array", "minItems": 0, "maxItems": 50, "items": {"$ref": "#/$defs/subject"}},
    "roles": {"type": "array", "minItems": 0, "maxItems": 200, "items": {"$ref": "#/$defs/role"}},
    "changes": {"type": "array", "minItems": 0, "maxItems": 400, "items": {"$ref": "#/$defs/change"}},
    "comparisons": {"type": "array", "minItems": 0, "maxItems": 100, "items": {"$ref": "#/$defs/comparison"}},
    "bridge": {"type": "array", "items": {"$ref": "#/$defs/bridge_step"}},
    "capital_ownership": {"type": "array", "items": {"$ref": "#/$defs/capital_ownership_item"}},
    "expectations": {"type": "array", "items": {"$ref": "#/$defs/expectation"}},
    "market_context": {"type": "array", "items": {"$ref": "#/$defs/market_context"}},
    "counterevidence": {"type": "array", "items": {"$ref": "#/$defs/counterevidence"}},
    "relationships": {"type": "array", "minItems": 0, "maxItems": 100, "items": {"$ref": "#/$defs/relationship"}},
    "native_context": {"type": "array", "items": {"$ref": "#/$defs/native_context"}},
    "coverage": {"$ref": "#/$defs/coverage"},
    "unavailable": {"type": "array", "items": {"$ref": "#/$defs/unavailable"}},
    "continuation": {"const": null},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "vocabularies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "energy_mechanism_families.v1": {"const": ["upstream_oil_resource_production", "natural_gas_production_basis", "gathering_processing_ngl", "pipelines_reserved_capacity", "lng_liquefaction_marketing", "refining_conversion", "oilfield_services", "energy_equipment_long_cycle_manufacturing", "merchant_generation_retail", "regulated_utility_investment_recovery", "contracted_generation_asset_ownership", "nuclear_resource_procurement", "nuclear_conversion_enrichment_fuel_services", "nuclear_components_services", "nuclear_reactor_technology_development", "solar_manufacturing", "solar_wind_development_capital_recycling", "renewable_contracted_asset_ownership", "storage_integration", "storage_asset_operation", "grid_electrical_equipment", "epc_construction", "geothermal", "renewable_fuels", "hydrogen_fuel_cells", "carbon_capture_transport_storage", "waste_to_energy_other_transition", "other"]},
        "core_milestone_flags.v1": {"const": ["establishes_current_operation", "establishes_period_revenue", "establishes_definitive_agreement", "establishes_delivered_volume", "establishes_present_cash", "establishes_measured_consumption"]},
        "energy_milestone_flags.v1": {"const": ["site_operating_license", "commercial_grid_generation", "operating_generation", "universal_haleu_dependence"]}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["can_rank", "can_gate", "can_size", "can_originate", "can_open_entry", "can_veto"],
      "properties": {"can_rank": {"const": false}, "can_gate": {"const": false}, "can_size": {"const": false}, "can_originate": {"const": false}, "can_open_entry": {"const": false}, "can_veto": {"const": false}}
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_theme_id", "primary_basket_id", "supplemental_basket_ids", "research_facet", "geography", "currency"],
      "properties": {
        "canonical_theme_id": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^theme:[a-z][a-z0-9_-]*$"}]},
        "primary_basket_id": {"anyOf": [{"type": "null"}, {"type": "string"}]},
        "supplemental_basket_ids": {"type": "array", "items": {"type": "string"}},
        "research_facet": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["label", "authority", "source_refs"], "properties": {"label": {"$ref": "#/$defs/bilingual"}, "authority": {"const": "research_facet_only"}, "source_refs": {"type": "array", "items": {"type": "string"}}}}]},
        "geography": {"anyOf": [{"type": "null"}, {"type": "string"}]},
        "currency": {"anyOf": [{"type": "null"}, {"type": "string"}]}
      }
    },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["subject_id", "issuer_label", "identity_state", "basket_memberships", "security_link_allowed", "structural_classification"],
      "properties": {
        "subject_id": {"anyOf": [{"type": "string", "pattern": "^co:[a-z]{2}:[A-Za-z0-9_-]+$"}, {"type": "string", "pattern": "^unresolved:[a-z0-9][a-z0-9_-]*$"}]},
        "issuer_label": {"$ref": "#/$defs/bilingual"},
        "identity_state": {"enum": ["resolved", "unresolved", "ambiguous"]},
        "basket_memberships": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["basket_id", "relation", "receipt"], "properties": {"basket_id": {"type": "string"}, "relation": {"enum": ["primary_member", "supplemental_member", "none", "unknown"]}, "receipt": {"anyOf": [{"type": "null"}, {"type": "string"}]}}}},
        "security_link_allowed": {"type": "boolean"},
        "structural_classification": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["provider", "version", "code", "label"], "properties": {"provider": {"type": "string"}, "version": {"type": "string"}, "code": {"type": "string"}, "label": {"$ref": "#/$defs/bilingual"}}}]}
      }
    },
    "role": {
      "type": "object", "additionalProperties": false,
      "required": ["role_id", "subject_id", "role_vocabulary", "role_kind", "role_facets", "business_label", "relationship_basis", "exposure", "rights_state", "source_refs", "limitations", "status", "authored_by", "attribution"],
      "properties": {
        "role_id": {"type": "string"}, "subject_id": {"type": "string"},
        "role_vocabulary": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.v[0-9]+$"}, "role_kind": {"type": "string"},
        "role_facets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["vocabulary", "kind"], "properties": {"vocabulary": {"type": "string"}, "kind": {"type": "string"}}}},
        "business_label": {"$ref": "#/$defs/bilingual"}, "relationship_basis": {"enum": ["source_backed", "hypothesis"]},
        "exposure": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["kind", "value", "unit", "source_ref"], "properties": {"kind": {"enum": ["revenue", "gross_profit", "operational_dependence", "narrative", "unknown"]}, "value": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/decimal"}]}, "unit": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "source_ref": {"anyOf": [{"type": "null"}, {"type": "string"}]}}}]},
        "rights_state": {"enum": ["admitted", "restricted", "unavailable"]}, "source_refs": {"type": "array", "items": {"type": "string"}}, "limitations": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["ready", "degraded", "unavailable", "refused"]}, "authored_by": {"enum": ["deterministic", "model_attributed"]}, "attribution": {"anyOf": [{"type": "null"}, {"type": "string"}]}
      },
      "allOf": [
        {"if":{"properties":{"role_vocabulary":{"const":"energy_mechanism_families.v1"}},"required":["role_vocabulary"]},"then":{"properties":{"role_kind":{"enum":["upstream_oil_resource_production","natural_gas_production_basis","gathering_processing_ngl","pipelines_reserved_capacity","lng_liquefaction_marketing","refining_conversion","oilfield_services","energy_equipment_long_cycle_manufacturing","merchant_generation_retail","regulated_utility_investment_recovery","contracted_generation_asset_ownership","nuclear_resource_procurement","nuclear_conversion_enrichment_fuel_services","nuclear_components_services","nuclear_reactor_technology_development","solar_manufacturing","solar_wind_development_capital_recycling","renewable_contracted_asset_ownership","storage_integration","storage_asset_operation","grid_electrical_equipment","epc_construction","geothermal","renewable_fuels","hydrogen_fuel_cells","carbon_capture_transport_storage","waste_to_energy_other_transition","other"]}},"required":["role_kind"]}},
        {"if": {"properties": {"role_kind": {"const": "other"}}, "required": ["role_kind"]}, "then": {"properties": {"limitations": {"minItems": 1}, "business_label": {"required": ["en", "zh"]}, "properties": {"en": {"minLength": 1}, "zh": {"minLength": 1}}}, "required": ["limitations", "business_label"]}}
      ]
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["change_id", "subject_id", "kind", "status", "revision_kind", "supersedes", "contained_in", "additive_with_siblings", "clocks", "definition", "contract_terms", "value", "milestone_assertions", "evidenced_by", "rights_state", "source_class", "source_refs", "limitations"],
      "properties": {
        "change_id": {"type": "string"}, "subject_id": {"type": "string"}, "kind": {"enum": ["reported_measure", "contract", "financing", "milestone", "ownership_event", "guidance"]}, "status": {"enum": ["observed", "forward", "contingent", "historical"]},
        "revision_kind": {"anyOf": [{"type": "null"}, {"enum": ["source_correction", "restatement", "contract_amendment", "interpretation_revision"]}]}, "supersedes": {"anyOf": [{"type": "null"}, {"type": "string"}]},
        "contained_in": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "additive_with_siblings": {"type": ["boolean", "null"]},
        "clocks": {"$ref": "#/$defs/change_clocks"}, "definition": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/metric_definition"}]}, "contract_terms": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/contract_terms"}]}, "value": {"$ref": "#/$defs/change_value"},
        "milestone_assertions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["vocabulary", "flag", "value"], "properties": {"vocabulary": {"type": "string"}, "flag": {"type": "string"}, "value": {"type": ["boolean", "null"]}}}},
        "evidenced_by": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "rights_state": {"enum": ["admitted", "restricted", "unavailable"]}, "source_class": {"enum": ["issuer_primary", "regulator_filing", "counsel_or_third_party_confirmation", "issuer_web_summary", "secondary_press", "unknown"]}, "source_refs": {"type": "array", "items": {"type": "string"}}, "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {"if": {"properties": {"revision_kind": {"type": "string"}}, "required": ["revision_kind"]}, "then": {"properties": {"supersedes": {"type": "string", "minLength": 1}}, "required": ["supersedes"]}},
        {"if":{"properties":{"rights_state":{"const":"admitted"}},"required":["rights_state"]},"then":{"properties":{"value":{"properties":{"kind":{"not":{"const":"null"}}},"required":["kind"]}}}}
      ]
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["comparison_id", "subject_id", "kind", "kind_vocabulary", "inputs", "compatibility", "formula_id", "formula_version", "result", "rounding", "unavailable_code", "authored_by", "limitations"],
      "properties": {
        "comparison_id": {"type": "string"}, "subject_id": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "kind": {"type": "string"}, "kind_vocabulary": {"anyOf": [{"type": "null"}, {"type": "string"}]},
        "inputs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["role", "change_id"], "properties": {"role": {"type": "string"}, "change_id": {"type": "string"}}}},
        "compatibility": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["check", "outcome"], "properties": {"check": {"enum": ["metric", "unit", "currency", "horizon", "ownership_basis", "period", "containment", "evidence_time"]}, "outcome": {"enum": ["passed", "failed", "unknown"]}}}},
        "formula_id": {"type": "string"}, "formula_version": {"type": "string"}, "result": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["value", "unit", "currency"], "properties": {"value": {"$ref": "#/$defs/decimal"}, "unit": {"type": "string"}, "currency": {"anyOf": [{"type": "null"}, {"type": "string"}]}}}]},
        "rounding": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "unavailable_code": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "authored_by": {"const": "deterministic"}, "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [{"if":{"properties":{"compatibility":{"items":{"properties":{"outcome":{"not":{"const":"passed"}}},"required":["outcome"]}},"required":["compatibility"]}},"then":{"properties":{"result":{"const":null},"unavailable_code":{"type":"string","minLength":1}},"required":["result","unavailable_code"]}}]
    },
    "bridge_step": {
      "type": "object", "additionalProperties": false,
      "required": ["subject_id", "step_order", "step_kind", "state", "value_ref", "narrative", "authored_by", "attribution", "rights_state", "source_refs", "assumptions"],
      "properties": {"subject_id": {"type": "string"}, "step_order": {"type": "integer", "minimum": 0, "maximum": 6}, "step_kind": {"enum": ["demand", "commercial_exposure", "unit_economics", "operating_contribution", "capital_financing", "ownership_claims", "shareholder_cash"]}, "state": {"enum": ["observed", "forward", "unavailable", "restricted"]}, "value_ref": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "narrative": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/bilingual"}]}, "authored_by": {"enum": ["deterministic", "model_attributed"]}, "attribution": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "rights_state": {"enum": ["admitted", "restricted", "unavailable"]}, "source_refs": {"type": "array", "items": {"type": "string"}}, "assumptions": {"type": "array", "items": {"type": "string"}}}
    },
    "capital_ownership_item": {
      "type": "object", "additionalProperties": false,
      "required": ["subject_id", "item_kind", "state", "value_refs", "narrative", "authored_by", "rights_state", "source_refs"],
      "properties": {"subject_id": {"type": "string"}, "item_kind": {"enum": ["consolidated_vs_proportionate", "project_vs_corporate_debt", "common_vs_convertible_warrant", "repurchase_authorized_vs_retired", "customer_advance", "sale_proceeds_vs_future_cash", "contributed_asset", "investee_equity_method"]}, "state": {"enum": ["observed", "forward", "unavailable", "restricted"]}, "value_refs": {"type": "array", "items": {"type": "string"}}, "narrative": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/bilingual"}]}, "authored_by": {"enum": ["deterministic", "model_attributed"]}, "rights_state": {"enum": ["admitted", "restricted", "unavailable"]}, "source_refs": {"type": "array", "items": {"type": "string"}}}
    },
    "expectation": {
      "type": "object", "additionalProperties": false,
      "required": ["expectation_id", "subject_id", "horizon", "status", "evidence_grade", "metric_definition", "fiscal_horizon", "ownership_basis", "aggregate_method", "contributor_count", "panel_turnover", "estimate", "first_known_at", "revision_kind", "surprise_vector", "forced_beat_miss_bit", "source_ref", "limitations"],
      "properties": {"expectation_id": {"type": "string"}, "subject_id": {"type": "string"}, "horizon": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "status": {"enum": ["AVAILABLE", "UNAVAILABLE", "RESTRICTED", "INCOMPATIBLE"]}, "evidence_grade": {"enum": ["PRE_EVENT_TIMESTAMPED_VALUE", "ISSUER_PROCESS_PLUS_ARCHIVE", "ARCHIVAL_CONTEXT_ONLY", "POST_EVENT_ONLY", "UNAVAILABLE"]}, "metric_definition": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "fiscal_horizon": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "ownership_basis": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "aggregate_method": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "contributor_count": {"type": ["integer", "null"]}, "panel_turnover": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "estimate": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["value", "unit", "currency"], "properties": {"value": {"$ref": "#/$defs/decimal"}, "unit": {"type": "string"}, "currency": {"anyOf": [{"type": "null"}, {"type": "string"}]}}}]}, "first_known_at": {"type": ["string", "null"]}, "revision_kind": {"anyOf": [{"type": "null"}, {"enum": ["panel_change", "within_analyst", "forecast_year_rollover", "none"]}]}, "surprise_vector": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["metric", "direction"], "properties": {"metric": {"type": "string"}, "direction": {"enum": ["beat", "miss", "inline", "mixed", "unavailable"]}}}}, "forced_beat_miss_bit": {"const": false}, "source_ref": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "limitations": {"type": "array", "items": {"type": "string"}}},
      "allOf": [
        {"if": {"properties": {"status": {"const": "AVAILABLE"}}, "required": ["status"]}, "then": {"properties": {"evidence_grade": {"enum": ["PRE_EVENT_TIMESTAMPED_VALUE", "ISSUER_PROCESS_PLUS_ARCHIVE"]}, "first_known_at": {"type": "string", "format": "date-time"}}, "required": ["evidence_grade", "first_known_at"]}},
        {"if": {"properties": {"status": {"not": {"const": "AVAILABLE"}}}, "required": ["status"]}, "then": {"properties": {"estimate": {"const": null}}, "required": ["estimate"]}}
      ]
    },
    "market_context": {
      "type": "object", "additionalProperties": false,
      "required": ["subject_id", "event_ref", "return_window", "raw_return", "total_return", "benchmark_residual", "residual_is_alpha", "external_reported", "commodity_context", "confounds", "source_refs"],
      "properties": {"subject_id": {"type": "string"}, "event_ref": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "return_window": {"enum": ["before_open_prior_close_to_event_close", "after_close_event_close_to_next_close", "unavailable"]}, "raw_return": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/decimal"}]}, "total_return": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/decimal"}]}, "benchmark_residual": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/decimal"}]}, "residual_is_alpha": {"const": false}, "external_reported": {"type": "boolean"}, "commodity_context": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "confounds": {"type": "array", "items": {"type": "string"}}, "source_refs": {"type": "array", "items": {"type": "string"}}}
    },
    "counterevidence": {"type": "object", "additionalProperties": false, "required": ["counter_id", "subject_id", "against_ref", "kind", "narrative", "authored_by", "attribution", "rights_state", "source_refs", "state"], "properties": {"counter_id": {"type": "string"}, "subject_id": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "against_ref": {"type": "string"}, "kind": {"enum": ["demand_revised_lower", "cost_outpaces_price", "contingent_or_unfunded", "existing_output_not_new_supply", "temporary_item", "acquisition_or_dilution", "competed_away", "test_asset_not_commercial", "duration_costs_capital", "already_public", "missing_requirement", "other"]}, "narrative": {"$ref": "#/$defs/bilingual"}, "authored_by": {"enum": ["deterministic", "model_attributed"]}, "attribution": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "rights_state": {"enum": ["admitted", "restricted", "unavailable"]}, "source_refs": {"type": "array", "items": {"type": "string"}}, "state": {"enum": ["observed", "hypothesis"]}}},
    "relationship": {"type": "object", "additionalProperties": false, "required": ["relationship_id", "src", "dst", "kind", "basis", "magnitude", "source_refs"], "properties": {"relationship_id": {"type": "string"}, "src": {"type": "string"}, "dst": {"type": "string"}, "kind": {"enum": ["physical_containment", "commercial_relationship", "ownership", "conditional_transmission_hypothesis", "supply_exposure"]}, "basis": {"enum": ["source_backed", "hypothesis"]}, "magnitude": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["value", "unit", "source_ref"], "properties": {"value": {"$ref": "#/$defs/decimal"}, "unit": {"type": "string"}, "source_ref": {"type": "string"}}}]}, "source_refs": {"type": "array", "items": {"type": "string"}}}, "allOf": [{"if": {"properties": {"basis": {"const": "hypothesis"}}, "required": ["basis"]}, "then": {"properties": {"magnitude": {"const": null}}, "required": ["magnitude"]}}]},
    "native_context": {"type": "object", "additionalProperties": false, "required": ["owner", "object", "clock", "label", "authority_note"], "properties": {"owner": {"type": "string"}, "object": {"type": "string"}, "clock": {"anyOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]}, "label": {"$ref": "#/$defs/bilingual"}, "authority_note": {"type": "string"}}, "required": ["owner", "object", "clock", "label", "authority_note"]},
