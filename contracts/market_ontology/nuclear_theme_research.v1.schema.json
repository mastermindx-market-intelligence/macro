{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/market_ontology/nuclear_theme_research.v1.schema.json",
  "title": "GMI nuclear theme research composition v1",
  "description": "The closed response of the pure Nuclear research composer. It uses the shared theme-research envelope, public synthetic assertions only, fail-closed shared rights resolution, no arithmetic, no ranking and no authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "definition_version",
    "generation",
    "request",
    "native_subjects",
    "summary",
    "companies",
    "industrial_views",
    "economics",
    "expectations",
    "evidence_refs",
    "authorized_coverage",
    "limitations",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "nuclear_theme_research.v1"
    },
    "definition_version": {
      "const": "2026-09-25.1"
    },
    "generation": {
      "type": "string",
      "pattern": "^gen_[0-9a-f]{32}$",
      "description": "'gen_' + sha256(canonical JSON of {definition_version, rights_revision, sorted revision_tuple, slice_key, view, time_mode, source_cutoff, recorded_cutoff, anchor_theme_id})[:32]. offset/limit/expected_generation are EXCLUDED — pagination never changes the fingerprint, and an out-of-scope assertion never perturbs it."
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_theme_id",
        "slice_key",
        "view",
        "time_mode",
        "source_cutoff",
        "recorded_cutoff",
        "offset",
        "limit",
        "expected_generation"
      ],
      "properties": {
        "anchor_theme_id": {
          "type": "string",
          "minLength": 1
        },
        "slice_key": {
          "enum": [
            "reactor_technology",
            "nuclear_components",
            "fuel_cycle"
          ]
        },
        "view": {
          "enum": [
            "composition",
            "manufacturing",
            "commercial",
            "capacity",
            "economics"
          ]
        },
        "time_mode": {
          "enum": [
            "latest",
            "source_history",
            "system_replay"
          ]
        },
        "source_cutoff": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/when"
            }
          ]
        },
        "recorded_cutoff": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/when"
            }
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "expected_generation": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^gen_[0-9a-f]{32}$"
            }
          ]
        }
      }
    },
    "native_subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selector",
          "kind",
          "source_label",
          "company_node_id"
        ],
        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "business",
              "product",
              "platform",
              "application",
              "facet"
            ]
          },
          "source_label": {
            "type": "string",
            "minLength": 1
          },
          "company_node_id": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        }
      },
      "description": "Source-local selectors only — a selector is unique within its source namespace and two similar labels from different sources are never merged. No global product id exists anywhere in this response."
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "companies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "input_refs",
        "rows"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/section_status"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "input_refs": {
          "$ref": "#/$defs/input_refs"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_business_label",
              "company_node_id",
              "navigation",
              "roles",
              "security"
            ],
            "properties": {
              "source_business_label": {
                "type": "string",
                "minLength": 1
              },
              "company_node_id": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              },
              "navigation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "href",
                  "reason"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "ready",
                      "unavailable"
                    ]
                  },
                  "href": {
                    "type": "null",
                    "description": "The client owns hrefs; the composition emits only the native ids."
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "enum": [
                          "identity_unresolved",
                          "identity_not_yet_learned"
                        ]
                      }
                    ]
                  }
                }
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "role",
                    "predicate",
                    "statement_mode",
                    "assertion_ref"
                  ],
                  "properties": {
                    "role": {
                      "type": "string",
                      "minLength": 1,
                      "description": "'subject' for ordinary rows; 'announced_party' for announced ownership without an evidenced effective date; 'owner_from:<date>' only when a REPORTED_FACT carries business_valid_from; 'owner_reported_effective_date_unknown' for a reported completion whose effective date is unstated. Never 'supplier_to' from a catalog capability. v1 serves NO directional announced side: 'announced_seller' and 'announced_acquirer' are retired and unreachable - eleven independent reviews each inverted a parse of the curator's free text, so the direction is not derived at all rather than derived wrongly. Do not branch on them. A direction returns only when the shared curation assertion carries it as a structured curated enum (object.subject_role), the standing v1.1 request."
                    },
                    "predicate": {
                      "type": "string",
                      "minLength": 1
                    },
                    "statement_mode": {
                      "type": "string",
                      "minLength": 1
                    },
                    "assertion_ref": {
                      "type": "string",
                      "pattern": "^gmi-curation://.+/gmirca_[0-9a-f]{32}$"
                    }
                  }
                }
              },
              "security": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "security_id",
                      "listing_valid_from",
                      "listing_valid_to"
                    ],
                    "properties": {
                      "security_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "listing_valid_from": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "string",
                            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                          }
                        ]
                      },
                      "listing_valid_to": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "string",
                            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                          }
                        ]
                      }
                    }
                  }
                ],
                "description": "Non-null ONLY for an identity row with resolution RESOLVED and a non-null security_id; every unresolved shape keeps evidence and roles but no price/valuation/portfolio join."
              }
            }
          },
          "description": "Ordered by (source_business_label, company_node_id) — stable source order, never by any magnitude."
        }
      }
    },
    "industrial_views": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition",
        "manufacturing",
        "commercial",
        "capacity",
        "economics"
      ],
      "properties": {
        "composition": {
          "$ref": "#/$defs/view"
        },
        "manufacturing": {
          "$ref": "#/$defs/view"
        },
        "commercial": {
          "$ref": "#/$defs/view"
        },
        "capacity": {
          "$ref": "#/$defs/view"
        },
        "economics": {
          "$ref": "#/$defs/view"
        }
      }
    },
    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "input_refs",
        "management",
        "witness_gate"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/section_status"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "input_refs": {
          "$ref": "#/$defs/input_refs"
        },
        "management": {
          "type": "null",
          "description": "Nuclear v1 has no management-sequence witness: the economics VIEW carries the financial observation rows, this SECTION stays the guidance witness slot and is unavailable."
        },
        "witness_gate": {
          "const": "missing"
        }
      }
    },
    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "management",
        "external_consensus",
        "house_forecast",
        "market_incorporation"
      ],
      "properties": {
        "management": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "input_refs",
            "roles"
          ],
          "properties": {
            "status": {
              "$ref": "#/$defs/section_status"
            },
            "reason": {
              "$ref": "#/$defs/reason"
            },
            "input_refs": {
              "$ref": "#/$defs/input_refs"
            },
            "roles": {
              "type": "null"
            }
          }
        },
        "external_consensus": {
          "$ref": "#/$defs/always_unavailable"
        },
        "house_forecast": {
          "$ref": "#/$defs/always_unavailable"
        },
        "market_incorporation": {
          "$ref": "#/$defs/always_unavailable"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "assertion_ref",
              "curation_revision",
              "kind"
            ],
            "properties": {
              "assertion_ref": {
                "type": "string",
                "pattern": "^gmi-curation://.+/gmirca_[0-9a-f]{32}$"
              },
              "curation_revision": {
                "type": "string",
                "pattern": "^gmirca_[0-9a-f]{32}$"
              },
              "kind": {
                "const": "assertion"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owner_store",
              "native_identity",
              "reference_id",
              "kind"
            ],
            "properties": {
              "owner_store": {
                "type": "string",
                "minLength": 1
              },
              "native_identity": {
                "$ref": "#/$defs/opaque_object"
              },
              "reference_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "native"
              }
            }
          }
        ]
      },
      "description": "Only SELECTED (authorized) assertions — including rows excluded from current views by review state, supersession or syndication collapse — plus the caller's opaque native refs passed through. Never a withheld count."
    },
    "authorized_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "input_refs",
        "selected",
        "industry_total",
        "note"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/section_status"
        },
        "input_refs": {
          "$ref": "#/$defs/input_refs"
        },
        "selected": {
          "type": "integer",
          "minimum": 0
        },
        "industry_total": {
          "type": "null"
        },
        "note": {
          "const": "counts only what this principal may know exists"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+(?::[A-Za-z0-9_.-]+)?$"
      },
      "description": "Every composer limitation token. Nuclear-specific codes include `supplemental_basket_witnesses`, `milestone_predicate_unavailable`, `syndicated_collapsed`, `target_windows_judged_at:`, `witness_cohort_excluded:`, and `unmapped_rights_source_excluded:`; parameterized tokens retain the shared wire grammar."
    },
    "authority": {
      "$ref": "#/$defs/authority"
    }
  },
  "$defs": {
    "when": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      ]
    },
    "section_status": {
      "enum": [
        "ready",
        "degraded",
        "unavailable",
        "refused"
      ]
    },
    "reason": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "The exact revision strings the section consumed — sorted, never ranked."
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can_rank",
        "can_gate",
        "can_size",
        "can_originate",
        "can_open_entry"
      ],
      "properties": {
        "can_rank": {
          "const": false
        },
        "can_gate": {
          "const": false
        },
        "can_size": {
          "const": false
        },
        "can_originate": {
          "const": false
        },
        "can_open_entry": {
          "const": false
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "input_refs",
        "what_changed",
        "why_it_matters",
        "offset",
        "next_evidence"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/section_status"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "input_refs": {
          "$ref": "#/$defs/input_refs"
        },
        "what_changed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary_item"
          }
        },
        "why_it_matters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary_item"
          }
        },
        "offset": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary_item"
          }
        },
        "next_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary_item"
          }
        }
      }
    },
    "summary_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "label",
        "input_refs"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Assertion summaries use only limitations.coverage; establishes and does_not_establish stay on their rows."
        },
        "label": {
          "enum": [
            "fact",
            "target",
            "interpretation"
          ]
        },
        "input_refs": {
          "$ref": "#/$defs/input_refs"
        },
        "stale": {
          "type": "boolean",
          "const": true,
          "description": "Present only on stale interpretations: text is prefixed '[stale interpretation] ' while the newly supported observation stays visible elsewhere in the response."
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "input_refs",
        "rows",
        "graph",
        "limitations",
        "total"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/section_status"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "input_refs": {
          "$ref": "#/$defs/input_refs"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/industrial_row"
          }
        },
        "graph": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodes",
            "edges"
          ],
          "properties": {
            "nodes": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "label",
                  "company_node_id"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "enum": [
                      "business",
                      "product",
                      "platform",
                      "application",
                      "facet"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "company_node_id": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ]
                  }
                }
              }
            },
            "edges": {
              "type": "array",
              "maxItems": 80,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "src",
                  "dst",
                  "relation_kind",
                  "assertion_ref",
                  "statement_mode"
                ],
                "properties": {
                  "src": {
                    "type": "string",
                    "minLength": 1
                  },
                  "dst": {
                    "type": "string",
                    "minLength": 1
                  },
                  "relation_kind": {
                    "enum": [
                      "catalog_capability",
                      "documented_inclusion",
                      "announced_development",
                      "deployment_target",
                      "reported_deployment",
                      "ownership_event",
                      "operating_observation",
                      "financial_observation"
                    ]
                  },
                  "assertion_ref": {
                    "type": "string",
                    "pattern": "^gmi-curation://.+/gmirca_[0-9a-f]{32}$"
                  },
                  "statement_mode": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "description": "One directed edge per (assertion, relation); reciprocal roles stay separate directed edges with different relation_kind — never merged, never deleted as a cycle. The label carries the meaning; color is not a field."
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(?::[A-Za-z0-9_.-]+)?$"
          }
        },
        "total": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "type": "null",
              "description": "Always null — the composer never sums rows; mixed configurations, periods, denominators, units and bases make any total a double-count hazard."
            },
            "reason": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "const": "totals_not_computed"
                }
              ],
              "description": "'totals_not_computed' when the view carries rows; null when there is nothing to compute."
            }
          }
        }
      }
    },
    "industrial_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_ref",
        "curation_revision",
        "source_business_label",
        "source_product_label",
        "selector",
        "object_selector",
        "kind",
        "model",
        "configuration",
        "stage",
        "stage_source_language",
        "relation_kind",
        "predicate",
        "statement_mode",
        "retrospective",
        "observation",
        "measure_scope",
        "purchase_total",
        "purchase_total_reason",
        "object_product_label",
        "object_configuration",
        "application",
        "technology_facet",
        "region",
        "period",
        "denominator",
        "source_clocks",
        "review",
        "independent_source_count",
        "corroboration_refs",
        "correction",
        "establishes",
        "does_not_establish",
        "coverage",
        "source_dependence"
      ],
      "properties": {
        "assertion_ref": {
          "type": "string",
          "pattern": "^gmi-curation://.+/gmirca_[0-9a-f]{32}$"
        },
        "curation_revision": {
          "type": "string",
          "pattern": "^gmirca_[0-9a-f]{32}$"
        },
        "source_business_label": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "source_product_label": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "selector": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "description": "Source-local subject selector (subject product when labelled, else the subject business)."
        },
        "object_selector": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "description": "Source-local object selector, scoped by publisher — two similar labels from different documents never merge."
        },
        "kind": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "business",
                "product"
              ]
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "description": "Always null in Nuclear v1: no structured publisher model field exists on the assertion yet."
        },
        "configuration": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "stage": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "description": "Null in Nuclear v1 unless derivable verbatim from the source."
        },
        "stage_source_language": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "relation_kind": {
          "enum": [
            "catalog_capability",
            "documented_inclusion",
            "announced_development",
            "deployment_target",
            "reported_deployment",
            "ownership_event",
            "operating_observation",
            "financial_observation"
          ]
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "statement_mode": {
          "type": "string",
          "minLength": 1
        },
        "retrospective": {
          "type": "boolean",
          "description": "True only in source_history mode for archival sources recorded later than their publication."
        },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "value_high",
            "unit",
            "quantity_basis",
            "gross_net_basis",
            "stock_flow",
            "estimate_status",
            "precision"
          ],
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "value_high": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "unit": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "quantity_basis": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "gross_net_basis": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "stock_flow": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ],
              "description": "Copied verbatim — a backlog stock is never relabelled a lead time."
            },
            "estimate_status": {
              "type": "string",
              "minLength": 1
            },
            "precision": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "measure_scope": {
          "type": "null",
          "description": "Always null in Nuclear v1; the financial basis lives in period/denominator/unit/gross_net_basis, kept as separate row fields."
        },
        "purchase_total": {
          "type": "null",
          "description": "Always null in Nuclear v1 — the composer never builds a cost total."
        },
        "purchase_total_reason": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "const": "purchase_boundary"
            }
          ],
          "description": "'purchase_boundary' marks the integrated-assembly/contained-component double-count refusal for later consumers that attempt totals."
        },
        "object_product_label": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "object_configuration": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "description": "A quantity row is bound to THIS configuration; a row for another configuration never inherits it."
        },
        "application": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "technology_facet": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "region": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "period": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "denominator": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "source_clocks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "published_at",
            "published_at_grain",
            "observed_at",
            "retained_at",
            "business_valid_from",
            "business_valid_to"
          ],
          "properties": {
            "published_at": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2}))?$"
                }
              ]
            },
            "published_at_grain": {
              "enum": [
                "unknown",
                "date",
                "instant"
              ]
            },
            "observed_at": {
              "type": "string",
              "minLength": 1
            },
            "retained_at": {
              "type": "string",
              "minLength": 1
            },
            "business_valid_from": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                }
              ]
            },
            "business_valid_to": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                }
              ]
            }
          },
          "description": "Source publication, observation and retention clocks plus the business-validity window — publication is never collapsed into business validity and an unknown publication stays null at its grain."
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "disposition",
            "reviewed_at",
            "review_due_at",
            "current"
          ],
          "properties": {
            "disposition": {
              "enum": [
                "accepted",
                "held",
                "rejected"
              ]
            },
            "reviewed_at": {
              "type": "string",
              "minLength": 1
            },
            "review_due_at": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "current": {
              "type": "boolean",
              "description": "False exactly when a successor correction inside this selection supersedes the row; held/expired rows are excluded from views entirely and survive in evidence_refs."
            }
          }
        },
        "independent_source_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Syndicated copies collapse into the original's count and are listed under corroboration_refs, never counted."
        },
        "corroboration_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^gmi-curation://.+/gmirca_[0-9a-f]{32}$"
          }
        },
        "correction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "predecessor_revision",
            "reason"
          ],
          "properties": {
            "predecessor_revision": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^gmirca_[0-9a-f]{32}$"
                }
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            }
          }
        },
        "establishes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "does_not_establish": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "source_dependence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "always_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        }
      }
    },
    "opaque_object": {
      "type": "object"
    },
    "any_json": {}
  }
}
