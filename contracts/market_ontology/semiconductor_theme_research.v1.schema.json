{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/market_ontology/semiconductor_theme_research.v1.schema.json",
  "title": "GMI semiconductor theme research composition v1",
  "description": "The closed response of the pure F04 composition module (T07+T08, operation gmi-semiconductors-fable-ceo-e2e-20260923-chairman-001). Pure in-memory composition over caller-supplied native objects: no I/O, no store, no LLM, no scoring, no ranking by magnitude. Authority is structurally absent (all can_* flags literal false). `generation` is a CONTENT fingerprint — sha256 over definition_version, rights_revision, the sorted revision tuple and the time-scoping query fields — never an access token and never a simultaneity claim. Rows carry source labels verbatim; configurations with different stages are never merged; mixed units are never converted; native utilization is never overwritten by a computed quotient.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "definition_version",
    "generation",
    "request",
    "native_subjects",
    "summary",
    "companies",
    "industrial_views",
    "economics",
    "expectations",
    "evidence_refs",
    "authorized_coverage",
    "limitations",
    "authority"
  ],
  "properties": {
    "schema": {"const": "semiconductor_theme_research.v1"},
    "definition_version": {"const": "2026-09-24.1"},
    "generation": {
      "type": "string",
      "pattern": "^gen_[0-9a-f]{32}$",
      "description": "'gen_' + sha256(canonical JSON of {definition_version, rights_revision, sorted revision_tuple, slice_key, view, time_mode, source_cutoff, recorded_cutoff, anchor_theme_id})[:32]. offset/limit/expected_generation are EXCLUDED — pagination never changes the fingerprint."
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_theme_id", "slice_key", "view", "time_mode",
        "source_cutoff", "recorded_cutoff", "offset", "limit", "expected_generation"
      ],
      "properties": {
        "anchor_theme_id": {"type": "string", "minLength": 1},
        "slice_key": {"enum": ["hbm_packaging", "sic_gan_specialty"]},
        "view": {"enum": ["composition", "manufacturing", "commercial", "capacity", "economics"]},
        "time_mode": {"enum": ["latest", "source_history", "system_replay"]},
        "source_cutoff": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/when"}]},
        "recorded_cutoff": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/when"}]},
        "offset": {"type": "integer", "minimum": 0},
        "limit": {"type": "integer", "minimum": 1},
        "expected_generation": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^gen_[0-9a-f]{32}$"}]}
      }
    },
    "native_subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selector", "kind", "source_label", "company_node_id"],
        "properties": {
          "selector": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "source_label": {"type": "string", "minLength": 1},
          "company_node_id": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}
        }
      },
      "description": "Source-local selectors only — no global product ids exist anywhere in this response."
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "companies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "input_refs", "rows"],
      "properties": {
        "status": {"$ref": "#/$defs/section_status"},
        "reason": {"$ref": "#/$defs/reason"},
        "input_refs": {"$ref": "#/$defs/input_refs"},
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_business_label", "company_node_id", "navigation", "roles"],
            "properties": {
              "source_business_label": {"type": "string", "minLength": 1},
              "company_node_id": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
              "navigation": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "href", "reason"],
                "properties": {
                  "status": {"enum": ["ready", "unavailable"]},
                  "href": {"type": "null", "description": "T10 owns hrefs; the composition emits only the native id."},
                  "reason": {
                    "anyOf": [
                      {"type": "null"},
                      {"enum": ["identity_unresolved", "identity_not_yet_learned"]}
                    ]
                  }
                }
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["role", "relation_kind", "stage", "assertion_ref"],
                  "properties": {
                    "role": {"type": "string", "minLength": 1},
                    "relation_kind": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
                    "stage": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
                    "assertion_ref": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          },
          "description": "Ordered by (source_business_label, company_node_id) — stable owner/source order, never by any magnitude."
        }
      }
    },
    "industrial_views": {
      "type": "object",
      "additionalProperties": false,
      "required": ["composition", "manufacturing", "commercial", "capacity", "economics"],
      "properties": {
        "composition": {"$ref": "#/$defs/view"},
        "manufacturing": {"$ref": "#/$defs/view"},
        "commercial": {"$ref": "#/$defs/view"},
        "capacity": {"$ref": "#/$defs/view"},
        "economics": {"$ref": "#/$defs/view"}
      }
    },
    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "input_refs", "management", "witness_gate"],
      "properties": {
        "status": {"$ref": "#/$defs/section_status"},
        "reason": {"$ref": "#/$defs/reason"},
        "input_refs": {"$ref": "#/$defs/input_refs"},
        "management": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema", "roles", "comparisons", "derived", "display", "limitations", "authority"],
              "properties": {
                "schema": {"const": "management_sequence_assessment.v1"},
                "roles": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["prior_outlook", "actual", "new_outlook"],
                  "properties": {
                    "prior_outlook": {"$ref": "#/$defs/mgmt_outlook_role"},
                    "actual": {"$ref": "#/$defs/mgmt_actual_role"},
                    "new_outlook": {"$ref": "#/$defs/mgmt_outlook_role"}
                  }
                },
                "comparisons": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["prior_vs_actual", "actual_vs_new_outlook"],
                  "properties": {
                    "prior_vs_actual": {"$ref": "#/$defs/opaque_object"},
                    "actual_vs_new_outlook": {"$ref": "#/$defs/opaque_object"}
                  }
                },
                "derived": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["prior_midpoint", "next_outlook_midpoint"],
                  "properties": {
                    "prior_midpoint": {"$ref": "#/$defs/opaque_object"},
                    "next_outlook_midpoint": {"$ref": "#/$defs/opaque_object"}
                  }
                },
                "display": {"$ref": "#/$defs/opaque_object"},
                "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "authority": {"$ref": "#/$defs/authority"}
              },
              "$comment": "Forwarded verbatim from engine.company_intelligence.guidance_history.assess_management_sequence (owner T06); leaves are pinned by key set with opaque native values (receipts, source spans)."
            }
          ]
        },
        "witness_gate": {"enum": ["positive", "missing"]}
      }
    },
    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["management", "external_consensus", "house_forecast", "market_incorporation"],
      "properties": {
        "management": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "input_refs", "roles"],
          "properties": {
            "status": {"$ref": "#/$defs/section_status"},
            "reason": {"$ref": "#/$defs/reason"},
            "input_refs": {"$ref": "#/$defs/input_refs"},
            "roles": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/opaque_object"}]}
          }
        },
        "external_consensus": {"$ref": "#/$defs/always_unavailable"},
        "house_forecast": {"$ref": "#/$defs/always_unavailable"},
        "market_incorporation": {"$ref": "#/$defs/always_unavailable"}
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["assertion_ref", "curation_revision", "kind"],
            "properties": {
              "assertion_ref": {"type": "string", "pattern": "^gmi-curation://.+/gmirca_[0-9a-f]{32}$"},
              "curation_revision": {"type": "string", "pattern": "^gmirca_[0-9a-f]{32}$"},
              "kind": {"const": "assertion"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["owner_store", "native_identity", "reference_id", "kind"],
            "properties": {
              "owner_store": {"type": "string", "minLength": 1},
              "native_identity": {"$ref": "#/$defs/opaque_object"},
              "reference_id": {"type": "string", "minLength": 1},
              "kind": {"const": "native"}
            }
          }
        ]
      },
      "description": "Only SELECTED (authorized) assertions, plus the caller's opaque native refs passed through. Never a withheld count."
    },
    "authorized_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "input_refs", "selected", "industry_total", "note"],
      "properties": {
        "status": {"$ref": "#/$defs/section_status"},
        "input_refs": {"$ref": "#/$defs/input_refs"},
        "selected": {"type": "integer", "minimum": 0},
        "industry_total": {"type": "null"},
        "note": {"const": "counts only what this principal may know exists"}
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9_]+(?::[A-Za-z0-9_.-]+)?$"},
      "description": "Sorted snake_case strings (colon-suffixed forms carry an index or an omission name)."
    },
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "when": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"}
      ]
    },
    "section_status": {"enum": ["ready", "degraded", "unavailable", "refused"]},
    "reason": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "input_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "description": "The exact revision strings the section consumed — sorted, never ranked."
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["can_rank", "can_gate", "can_size", "can_originate", "can_open_entry"],
      "properties": {
        "can_rank": {"const": false},
        "can_gate": {"const": false},
        "can_size": {"const": false},
        "can_originate": {"const": false},
        "can_open_entry": {"const": false}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "input_refs", "what_changed", "why_it_matters", "offset", "next_evidence"],
      "properties": {
        "status": {"$ref": "#/$defs/section_status"},
        "reason": {"$ref": "#/$defs/reason"},
        "input_refs": {"$ref": "#/$defs/input_refs"},
        "what_changed": {"type": "array", "items": {"$ref": "#/$defs/summary_item"}},
        "why_it_matters": {"type": "array", "items": {"$ref": "#/$defs/summary_item"}},
        "offset": {"type": "array", "items": {"$ref": "#/$defs/summary_item"}},
        "next_evidence": {"type": "array", "items": {"$ref": "#/$defs/summary_item"}}
      }
    },
    "summary_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "label", "input_refs"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "label": {"enum": ["fact", "target", "interpretation"]},
        "input_refs": {"$ref": "#/$defs/input_refs"},
        "stale": {
          "type": "boolean",
          "const": true,
          "description": "Present only on stale interpretations: text is prefixed '[stale interpretation] ' while the newly supported observation stays visible elsewhere in the response."
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "input_refs", "rows", "graph", "limitations"],
      "properties": {
        "status": {"$ref": "#/$defs/section_status"},
        "reason": {"$ref": "#/$defs/reason"},
        "input_refs": {"$ref": "#/$defs/input_refs"},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/industrial_row"}},
        "graph": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodes", "edges"],
          "properties": {
            "nodes": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label", "kind"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "label": {"type": "string", "minLength": 1},
                  "kind": {"type": "string", "minLength": 1}
                }
              }
            },
            "edges": {
              "type": "array",
              "maxItems": 80,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["src", "dst", "kind", "width"],
                "properties": {
                  "src": {"type": "string", "minLength": 1},
                  "dst": {"type": "string", "minLength": 1},
                  "kind": {"type": "string", "minLength": 1},
                  "width": {"type": "null", "description": "Never a width: mixed units are never converted, so no magnitude may drive presentation."}
                }
              }
            }
          }
        },
        "limitations": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_]+(?::[A-Za-z0-9_.-]+)?$"}},
        "total": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reason"],
          "properties": {
            "value": {"type": "null", "description": "Always null — the composition never sums scoped constructions."},
            "reason": {"anyOf": [{"type": "null"}, {"const": "mixed_construction_scope"}]}
          },
          "description": "Present only on the capacity view."
        }
      }
    },
    "industrial_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_ref", "curation_revision", "source_business_label", "source_product_label",
        "selector", "object_selector", "kind", "model", "configuration", "stage",
        "stage_source_language", "relation_kind", "predicate", "statement_mode", "retrospective",
        "observation", "measure_scope", "purchase_total", "purchase_total_reason",
        "utilization", "company_node_id"
      ],
      "properties": {
        "assertion_ref": {"type": "string", "pattern": "^gmi-curation://.+/gmirca_[0-9a-f]{32}$"},
        "curation_revision": {"type": "string", "pattern": "^gmirca_[0-9a-f]{32}$"},
        "source_business_label": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "source_product_label": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "selector": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "object_selector": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "kind": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "model": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "configuration": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "stage": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "stage_source_language": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "relation_kind": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "predicate": {"type": "string", "minLength": 1},
        "statement_mode": {"type": "string", "minLength": 1},
        "retrospective": {
          "type": "boolean",
          "description": "True only in source_history mode for archival sources recorded later than their publication (recorded_later)."
        },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "value_high", "unit", "quantity_basis", "gross_net_basis", "stock_flow", "estimate_status", "precision"],
          "properties": {
            "value": {"anyOf": [{"type": "null"}, {"type": "number"}]},
            "value_high": {"anyOf": [{"type": "null"}, {"type": "number"}]},
            "unit": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
            "quantity_basis": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
            "gross_net_basis": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
            "stock_flow": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
            "estimate_status": {"type": "string", "minLength": 1},
            "precision": {"type": "string", "minLength": 1}
          }
        },
        "measure_scope": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value_basis", "denominator", "period_kind", "period_start", "period_end", "stock_flow", "gross_net", "wafer_diameter_mm", "currency", "precision", "estimate_status", "purchase_boundary"],
              "properties": {
                "value_basis": {"type": "string", "minLength": 1},
                "denominator": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
                "period_kind": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
                "period_start": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}]},
                "period_end": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}]},
                "stock_flow": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
                "gross_net": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
                "wafer_diameter_mm": {"anyOf": [{"type": "null"}, {"enum": [150, 200, 300]}]},
                "currency": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Z]{3}$"}]},
                "precision": {"type": "string", "minLength": 1},
                "estimate_status": {"type": "string", "minLength": 1},
                "purchase_boundary": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}
              }
            }
          ]
        },
        "purchase_total": {
          "anyOf": [{"type": "null"}, {"type": "number"}],
          "description": "The observation's purchase measure copied verbatim — null with purchase_total_reason 'purchase_boundary' when an integrated_assembly measure carries contained configuration objects (the double-count shape)."
        },
        "purchase_total_reason": {"anyOf": [{"type": "null"}, {"const": "purchase_boundary"}]},
        "utilization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["native_value", "native_unit", "quotient_value", "quotient_reason"],
          "properties": {
            "native_value": {"anyOf": [{"type": "null"}, {"type": "number"}], "description": "The NATIVE output-based utilization figure, copied verbatim when the measure is one."},
            "native_unit": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
            "quotient_value": {"type": "null", "description": "Always null: a shipment/capacity quotient never overwrites a native output-based utilization."},
            "quotient_reason": {"const": "not_computed"}
          }
        },
        "company_node_id": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}
      }
    },
    "always_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"const": "unavailable"},
        "reason": {"type": "string", "pattern": "^[a-z0-9_]+$"}
      }
    },
    "mgmt_outlook_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "low", "high", "unit", "horizon", "status", "basis", "currency", "perimeter", "definition", "source_span"],
      "properties": {
        "metric": {"$ref": "#/$defs/any_json"},
        "low": {"$ref": "#/$defs/any_json"},
        "high": {"$ref": "#/$defs/any_json"},
        "unit": {"$ref": "#/$defs/any_json"},
        "horizon": {"$ref": "#/$defs/any_json"},
        "status": {"$ref": "#/$defs/any_json"},
        "basis": {"$ref": "#/$defs/any_json"},
        "currency": {"$ref": "#/$defs/any_json"},
        "perimeter": {"$ref": "#/$defs/any_json"},
        "definition": {"$ref": "#/$defs/any_json"},
        "source_span": {"$ref": "#/$defs/any_json"}
      }
    },
    "mgmt_actual_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value", "unit", "fiscal_period", "basis", "currency", "perimeter", "definition", "source_span"],
      "properties": {
        "metric": {"$ref": "#/$defs/any_json"},
        "value": {"$ref": "#/$defs/any_json"},
        "unit": {"$ref": "#/$defs/any_json"},
        "fiscal_period": {"$ref": "#/$defs/any_json"},
        "basis": {"$ref": "#/$defs/any_json"},
        "currency": {"$ref": "#/$defs/any_json"},
        "perimeter": {"$ref": "#/$defs/any_json"},
        "definition": {"$ref": "#/$defs/any_json"},
        "source_span": {"$ref": "#/$defs/any_json"}
      }
    },
    "opaque_object": {"type": "object"},
    "any_json": {}
  }
}
