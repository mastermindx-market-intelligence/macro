{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/market_ontology/mining_theme_research.v1.schema.json",
  "title": "market_ontology.mining_theme_research/v1",
  "description": "Closed Mining per-sector research response. Two closed definitions (mining_copper_economics / mining_rare_earth_economics) bound to the kernel-side theme:copper_steel_electrify and theme:rare_earth_critical_min. No rank/gate/size/originate/open_entry semantic is representable here; authority is the literal five-key all-false const echoed on every response and every evidence object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "definition_version",
    "generation",
    "request",
    "native_subjects",
    "summary",
    "companies",
    "industrial_views",
    "economics",
    "expectations",
    "evidence_refs",
    "authorized_coverage",
    "limitations",
    "authority"
  ],
  "properties": {
    "schema": {"const": "market_ontology.mining_theme_research/v1"},
    "definition_version": {"type": "string", "minLength": 1},
    "generation": {"type": "string", "minLength": 1},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slice_key", "anchor_theme_id", "replay_cutoff", "page"],
      "properties": {
        "slice_key": {"enum": ["mining_copper_economics", "mining_rare_earth_economics"]},
        "anchor_theme_id": {"enum": ["theme:copper_steel_electrify", "theme:rare_earth_critical_min"]},
        "replay_cutoff": {"type": "string", "minLength": 1},
        "page": {"type": "integer", "minimum": 1}
      }
    },
    "native_subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stable_subject_id", "kind", "label"],
        "properties": {
          "stable_subject_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "headline", "selected_revisions"],
      "properties": {
        "status": {"enum": ["ready", "degraded", "refused"]},
        "headline": {"type": "string", "minLength": 1},
        "selected_revisions": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "string"}
          }
        }
      }
    },
    "companies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stable_subject_id", "name", "cik", "role"],
        "properties": {
          "stable_subject_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "cik": {"type": "string", "minLength": 1},
          "role": {"enum": ["issuer", "subject"]}
        }
      }
    },
    "industrial_views": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stable_subject_id", "view_kind", "description", "evidence_refs"],
        "properties": {
          "stable_subject_id": {"type": "string", "minLength": 1},
          "view_kind": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "native_blocks", "reported_economic_context", "derived"],
      "properties": {
        "status": {"enum": ["ready", "degraded", "refused"]},
        "native_blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stable_subject_id", "measure", "value", "sign", "basis", "source_label"],
            "properties": {
              "stable_subject_id": {"type": "string", "minLength": 1},
              "measure": {"type": "string", "minLength": 1},
              "value": {"type": ["number", "integer", "string"]},
              "sign": {"type": "string", "minLength": 1},
              "basis": {"type": "string", "minLength": 1},
              "source_label": {"type": "string", "minLength": 1}
            }
          }
        },
        "reported_economic_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "context_block_count"],
          "properties": {
            "policy": {"const": "reported_economic_context"},
            "context_block_count": {"type": "integer", "minimum": 0},
            "notes": {"type": "string"}
          }
        },
        "derived": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stable_subject_id", "kind", "value", "formula_version", "inputs"],
            "properties": {
              "stable_subject_id": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "minLength": 1},
              "value": {"type": ["number", "integer", "string"]},
              "formula_version": {"type": "string", "minLength": 1},
              "inputs": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "expectations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stable_subject_id", "comparison_kind", "earlier_point_estimate", "later_actual", "is_range", "is_consensus", "comparison"],
        "properties": {
          "stable_subject_id": {"type": "string", "minLength": 1},
          "comparison_kind": {"type": "string", "minLength": 1},
          "earlier_point_estimate": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["metric", "value", "basis", "source_label"],
            "properties": {
              "metric": {"type": "string", "minLength": 1},
              "value": {"type": ["number", "integer", "string"]},
              "basis": {"type": "string", "minLength": 1},
              "source_label": {"type": "string", "minLength": 1}
            }
          },
          "later_actual": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["metric", "value", "basis", "source_label"],
            "properties": {
              "metric": {"type": "string", "minLength": 1},
              "value": {"type": ["number", "integer", "string"]},
              "basis": {"type": "string", "minLength": 1},
              "source_label": {"type": "string", "minLength": 1}
            }
          },
          "comparison": {"type": "string", "minLength": 1},
          "definition_unqualified_fields": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "is_range": {"type": "boolean", "const": false},
          "is_consensus": {"type": "boolean", "const": false}
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stable_source_id", "url", "rights_revision", "native_subject_id"],
        "properties": {
          "stable_source_id": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "rights_revision": {"type": "string", "minLength": 1},
          "native_subject_id": {"type": "string", "minLength": 1},
          "rights_entitled": {"type": "boolean"},
          "digest": {"type": "string", "minLength": 1},
          "authority": {"$ref": "#/$defs/authority"}
        }
      }
    },
    "authorized_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count_scope", "industry_total"],
      "properties": {
        "count_scope": {"type": "string", "minLength": 1},
        "industry_total": {"type": "null"}
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "anyOf": [
          {"enum": [
            "missing_derivation",
            "stream_threshold_unknown",
            "missing_basis",
            "source_only",
            "missing_issuer",
            "changed_source",
            "denied_source",
            "page_generation_change",
            "industry_total_unknown"
          ]},
          {"type": "string", "pattern": "^(definition_unqualified|assertion_invalid|omitted):[A-Za-z0-9_.-]+$"}
        ]
      }
    },
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["can_rank", "can_gate", "can_size", "can_originate", "can_open_entry"],
      "properties": {
        "can_rank": {"const": false},
        "can_gate": {"const": false},
        "can_size": {"const": false},
        "can_originate": {"const": false},
        "can_open_entry": {"const": false}
      }
    }
  }
}