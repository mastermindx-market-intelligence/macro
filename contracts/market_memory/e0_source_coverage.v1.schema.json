{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/market_memory/e0_source_coverage.v1.schema.json",
  "title": "Market Memory E0 source coverage (display-only declarations)",
  "description": "Declared metadata only for market-memory E0 source coverage. Every value is a producer declaration; null always means unresolved and is never inferred, defaulted, or dated. This vocabulary performs no source authentication, establishes no source independence, proves no coverage completeness, and grants no operational admission; the parent resolves provenance and enforces membership and semantic joins.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "object_id",
    "authority",
    "study_id",
    "protocol_sha256",
    "membership_sha256",
    "tasks_ref",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "research_factory.market_memory_e0_source_coverage.v1"
    },
    "object_id": {
      "$ref": "#/$defs/id_string"
    },
    "authority": {
      "const": "display_only"
    },
    "study_id": {
      "$ref": "#/$defs/id_string"
    },
    "protocol_sha256": {
      "const": "5821074f0ad1564780759a7e5d7ca6595cd8d411f119629f31ee431f2a481ca6"
    },
    "membership_sha256": {
      "const": "76de9522d40c65c33de0dcde59f581a5c493f4be218df3221adb9c3af1495c8f"
    },
    "tasks_ref": {
      "$ref": "#/$defs/immutable_ref",
      "description": "Exact immutable reference to the declared tasks artifact."
    },
    "entries": {
      "type": "array",
      "minItems": 109,
      "maxItems": 109,
      "description": "Exactly 109 declared source-coverage metadata rows. Declarations only: no source authentication, no source independence, no coverage completeness, and no operational admission is established here. Null fields are unresolved and are never inferred.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capture_id",
          "context_id",
          "query_id",
          "packet_sha256",
          "receipt_sha256",
          "source_receipt_ids",
          "source_artifact_sha256s",
          "first_available_for_contextual_analysis",
          "source_measurement_session",
          "economic_episode",
          "feature_support_interval",
          "label_support_interval"
        ],
        "properties": {
          "capture_id": {
            "type": "string",
            "pattern": "^mmcapture_[a-f0-9]{64}$"
          },
          "context_id": {
            "type": "string",
            "pattern": "^mmctx_[a-f0-9]{64}$"
          },
          "query_id": {
            "type": "string",
            "pattern": "^mmquery_[a-f0-9]{64}$"
          },
          "packet_sha256": {
            "$ref": "#/$defs/lowerhex64"
          },
          "receipt_sha256": {
            "$ref": "#/$defs/lowerhex64"
          },
          "source_receipt_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^mmsrc_[a-f0-9]{64}$"
            }
          },
          "source_artifact_sha256s": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/lowerhex64"
            }
          },
          "first_available_for_contextual_analysis": {
            "$ref": "#/$defs/clock"
          },
          "source_measurement_session": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/named_provenance"
              }
            ],
            "description": "Null when unresolved; otherwise a declared session identifier with a provenance reference. Never inferred."
          },
          "economic_episode": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/named_provenance"
              }
            ],
            "description": "Null when unresolved; otherwise a declared economic-episode identifier with a provenance reference. Never inferred."
          },
          "feature_support_interval": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/support_interval"
              }
            ],
            "description": "Null when unresolved; otherwise the declared half-open support interval. Never inferred."
          },
          "label_support_interval": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/support_interval"
              },
              {
                "$ref": "#/$defs/label_not_applicable"
              }
            ],
            "description": "Null when unresolved; otherwise the declared half-open support interval, or a not-applicable declaration registered_no_outcome_labels. The not-applicable form is an unverified declaration whose provenance the parent binds to the existing outcome_definition_ref; this schema never authenticates it."
          }
        }
      }
    }
  },
  "$defs": {
    "id_string": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "maxLength": 128
    },
    "lowerhex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 digest rendered as exactly 64 lowercase hexadecimal characters."
    },
    "clock": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 27,
      "description": "UTC RFC 3339 date-time clock string of at most 27 characters; the parent enforces the canonical microsecond UTC form."
    },
    "immutable_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "object_id",
        "sha256",
        "bytes"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/id_string"
        },
        "object_id": {
          "$ref": "#/$defs/id_string"
        },
        "sha256": {
          "$ref": "#/$defs/lowerhex64"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        }
      }
    },
    "provenance_ref": {
      "$ref": "#/$defs/immutable_ref",
      "description": "Exact immutable evidence reference; byte closure does not authenticate source/session/episode truth."
    },
    "named_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provenance_ref"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id_string"
        },
        "provenance_ref": {
          "$ref": "#/$defs/provenance_ref"
        }
      }
    },
    "support_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_inclusive",
        "end_exclusive",
        "provenance_ref"
      ],
      "properties": {
        "start_inclusive": {
          "$ref": "#/$defs/clock"
        },
        "end_exclusive": {
          "$ref": "#/$defs/clock"
        },
        "provenance_ref": {
          "$ref": "#/$defs/provenance_ref"
        }
      }
    },
    "label_not_applicable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_applicable",
        "reason",
        "provenance_ref"
      ],
      "properties": {
        "not_applicable": {
          "const": true
        },
        "reason": {
          "const": "registered_no_outcome_labels"
        },
        "provenance_ref": {
          "$ref": "#/$defs/provenance_ref"
        }
      }
    }
  }
}
