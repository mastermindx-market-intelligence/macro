{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/market_memory/outcome_use_binding.v2.schema.json",
  "title": "Selected post-selection archived-mark outcome use v2",
  "description": "Closed metadata for two acyclic existing private roles. Rules bind registration purpose/definition; current access scope binds a later exact published generation. This schema alone grants no source use, independent study admission, publication or account access.",
  "oneOf": [
    {
      "$ref": "#/$defs/rules"
    },
    {
      "$ref": "#/$defs/binding"
    }
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "object_id",
        "sha256",
        "bytes"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "rules_id",
        "study_id",
        "purpose",
        "definition_ref",
        "source_authority",
        "technical_store_id",
        "subject_id",
        "scope_location",
        "economic_return",
        "corporate_action_adjusted",
        "RTH_close_authenticated"
      ],
      "properties": {
        "schema": {
          "const": "market_memory.outcome_access_rules.v2"
        },
        "rules_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "study_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "purpose": {
          "const": "read_published_archived_mark_comparisons_after_selection"
        },
        "definition_ref": {
          "$ref": "#/$defs/reference"
        },
        "source_authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "research/licenses/MASSIVE_ENTITLEMENT_RECORD.md"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "technical_store_id": {
          "type": "string",
          "pattern": "^mmactualstore_[a-f0-9]{64}$"
        },
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "scope_location": {
          "const": "current_selected_access.scope_ref"
        },
        "economic_return": {
          "const": false
        },
        "corporate_action_adjusted": {
          "const": false
        },
        "RTH_close_authenticated": {
          "const": false
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "binding_id",
        "registration_ref",
        "access_rules_ref",
        "installation_id",
        "installation_epoch",
        "observation_generation_ref",
        "observations",
        "permitted_actions"
      ],
      "properties": {
        "schema": {
          "const": "market_memory.outcome_use_binding.v2"
        },
        "binding_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "registration_ref": {
          "$ref": "#/$defs/reference"
        },
        "access_rules_ref": {
          "$ref": "#/$defs/reference"
        },
        "installation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "installation_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "observation_generation_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generation_id",
            "sha256",
            "bytes"
          ],
          "properties": {
            "generation_id": {
              "type": "string",
              "pattern": "^mmcontextualgeneration_[a-f0-9]{64}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2097152
            }
          }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "context_id",
              "capture_id",
              "packet_sha256",
              "observation_id"
            ],
            "properties": {
              "context_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "capture_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "packet_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "observation_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^mmcontextualobservation_[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "permitted_actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "read_retained_contextual_observation_metadata",
              "read_registered_contextual_outcome_labels",
              "read_retained_contextual_observation",
              "disclose_retained_contextual_observation",
              "read_retained_source_bar_marks",
              "disclose_retained_source_bar_marks",
              "read_retained_source_bar_generation_metadata",
              "read_retained_source_bar_metadata",
              "disclose_retained_source_bar_metadata"
            ]
          }
        }
      }
    }
  }
}
