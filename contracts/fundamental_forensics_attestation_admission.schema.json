{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/fundamental_forensics_attestation_admission.schema.json",
  "title": "Fundamental Forensics attestation admission status",
  "$comment": "Describes the output of engine/fundamental_forensics/attestation_admission.build_admission_status. In v1 'admitted' is reserved and unreachable (no verifiable signed trust anchor exists) and every lawful status carries attested=false with capture_basis='reconstruction'; the state enum keeps the full vocabulary so a future lawful admission path stays a contract change, not a silent drift.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "admission_id", "state", "attested", "capture_basis", "observed_at", "evidence", "gate", "nonclaims"],
  "properties": {
    "schema": {"const": "fundamental_forensics.attestation_admission/v1"},
    "admission_id": {"type": "string", "pattern": "^ffadm_[0-9a-f]{32}$"},
    "state": {"enum": ["admitted", "unresolved_human_gate", "refused"]},
    "attested": {"const": false},
    "capture_basis": {"const": "reconstruction"},
    "observed_at": {"$ref": "#/$defs/utc"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "gate": {"$ref": "#/$defs/gate"},
    "nonclaims": {"type": "array", "minItems": 6, "items": {"type": "string"}}
  },
  "$defs": {
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$", "format": "date-time"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "writer_secrets"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "environment": {"$ref": "#/$defs/environment"},
        "writer_secrets": {"$ref": "#/$defs/writerSecrets"},
        "last_seed_run": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/seedRun"}]},
        "candidate_sources": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "required_reviewers": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "writerSecrets": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "updated_at"],
        "properties": {
          "name": {"type": "string", "pattern": "^R2_ATTESTED_HISTORY_[A-Z0-9_]+$"},
          "updated_at": {"$ref": "#/$defs/utc"}
        }
      }
    },
    "seedRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "conclusion", "attempt_started_at"],
      "properties": {
        "run_id": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "integer"}]},
        "workflow": {"type": "string", "minLength": 1},
        "event": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "created_at": {"$ref": "#/$defs/utc"},
        "run_attempt": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "integer"}]},
        "attempt_started_at": {"$ref": "#/$defs/utc"},
        "completed_at": {"$ref": "#/$defs/utc"},
        "conclusion": {"type": "string", "minLength": 1},
        "failed_step": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "what", "who", "why", "next_lawful_action", "forbidden_agent_actions"],
      "properties": {
        "case": {"enum": ["no_post_rotation_attempt", "post_rotation_attempt_failed", "seed_succeeded"]},
        "what": {"type": "string", "minLength": 1},
        "who": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "why": {"type": "string", "minLength": 1},
        "next_lawful_action": {"type": "string", "minLength": 1},
        "forbidden_agent_actions": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
