{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/sector_intelligence/authority_manifest.v2.schema.json",
  "title": "Sector Intelligence Authority Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "manifest_id",
    "subject",
    "artifact_ref",
    "artifact_type",
    "publication_tier",
    "max_authority",
    "allowed_actions",
    "denied_actions",
    "consumers",
    "issued_by",
    "issued_at",
    "valid_from",
    "valid_to",
    "expires_at",
    "promotion_evidence_refs",
    "governance_decision_refs",
    "kill_switch",
    "transaction_from",
    "transaction_to"
  ],
  "properties": {
    "contract_id": {
      "const": "authority_manifest.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^authority:sector-dossier:(sector|canonical_theme|local_theme):[0-9a-f]{24}$"
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "const": "sector_intelligence_packet.v2"
    },
    "publication_tier": {
      "type": "string",
      "enum": [
        "DISPLAY",
        "SHADOW"
      ]
    },
    "max_authority": {
      "type": "string",
      "enum": [
        "A0_OBSERVE",
        "A1_EXPLAIN"
      ]
    },
    "allowed_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "observe",
          "explain"
        ]
      }
    },
    "denied_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "originate_signal",
          "raise_authority_from_llm",
          "rank_security",
          "select_security",
          "size_position",
          "gate_decision",
          "execute_trade"
        ]
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "issued_by": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "promotion_evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "governance_decision_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "kill_switch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "owner",
        "reason",
        "activated_at"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "activated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "transaction_from": {
      "type": "string",
      "format": "date-time"
    },
    "transaction_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "subject": {
      "$ref": "https://mastermind-x.com/contracts/sector_intelligence/sector_intelligence_packet.v2.schema.json#/$defs/subject"
    }
  }
}
