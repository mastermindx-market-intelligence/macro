{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/news_impact/prophet_evidence.v1.schema.json",
  "title": "Prophet news-impact evidence v1 — context_only display adapter",
  "description": "Closed display-tier evidence record. The adapter projects a validated news_impact_event.v1 fact (or a typed absence) into Prophet as context_only evidence. It never originates a rank, size, gate, score, confidence, probability, price target or fair value. additionalProperties is false on every object. Glance copy is template-rendered from allowlisted fields; model prose is refused.",
  "oneOf": [
    {
      "$ref": "#/$defs/prophet_evidence.v1"
    },
    {
      "$ref": "#/$defs/prophet_evidence_bundle.v1"
    }
  ],
  "$defs": {
    "text_safe": {
      "type": "string",
      "not": {
        "anyOf": [
          {
            "pattern": "(?i)\\b(ignore|disregard|forget|override)\\s+(all\\s+|any\\s+|the\\s+|every\\s+)?(previous|prior|above|preceding|earlier)\\b"
          },
          {
            "pattern": "(?i)(^|[\\n\\r>\\\"'\\]\\[}{|])\\s*(system|assistant|developer|user|tool|function)\\s*[:：]"
          },
          {
            "pattern": "(?i)system\\s*prompt"
          },
          {
            "pattern": "(?i)\\b(https?|ftps?|wss?|file|javascript|vbscript|gopher|hxxps?|hxtp)\\s*:"
          },
          {
            "pattern": "(?i)^\\s*(?=^[^_\\s]*$)(www\\.)?[a-z0-9][a-z0-9\\-]*(\\.[a-z0-9][a-z0-9\\-]*)*\\.[a-z]{2,4}(:\\d+)?(/[^\\s]*)?\\s*$"
          },
          {
            "pattern": "(?i)(~\\/\\.|/(etc|usr|bin|sbin|tmp|var|root|home|opt|dev|proc|lib)\\b|\\$\\(|`|\\brm\\s+-rf\\b|\\bcurl\\b|\\bwget\\b|\\bchmod\\b|\\bbash\\s+-c\\b|\\bsh\\s+-c\\b|\\bpowershell\\b|\\bnc\\s+-e\\b|\\|\\s*sh\\b)"
          },
          {
            "pattern": "[A-Za-z0-9+/=]{40,}"
          },
          {
            "pattern": "(!\\[|\\]\\(\\s*[a-z0-9.])"
          },
          {
            "pattern": "[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f\u200b-\u200f\u202a-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb]"
          },
          {
            "pattern": "(?i)(<\\||\\[/?inst\\]|<<\\s*sys\\s*>>|<\\s*/?\\s*system\\s*>|###\\s*(system|assistant|instruction|user)\\b)"
          },
          {
            "pattern": "(?i)\\b(switch|swap|route|redirect)\\s+(to\\s+)?(the\\s+)?(provider|model|llm|api|endpoint|engine)\\b"
          },
          {
            "pattern": "(?i)(new|updated|revised|obey)\\s+(the\\s+)?(instructions?|directives?|commands?)\\b|\\byou\\s+are\\s+now\\b|\\bset\\s+(may_rank|may_size|may_gate|prophet_authority)\\b"
          }
        ]
      }
    },
    "company_id": {
      "type": "string",
      "minLength": 14,
      "maxLength": 14,
      "pattern": "^cik:(?!0{10}$)[0-9]{10}$"
    },
    "fact_id": {
      "type": "string",
      "minLength": 29,
      "maxLength": 29,
      "pattern": "^fact_[0-9a-f]{24}$"
    },
    "datetime_utc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "iso_date": {
      "type": "string",
      "minLength": 10,
      "maxLength": 10,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "copy_key": {
      "$ref": "#/$defs/text_safe",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{2,62}$"
    },
    "authority": {
      "type": "string",
      "const": "context_only",
      "maxLength": 16
    },
    "prophet_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_rank", "may_size", "may_gate", "prophet_authority"],
      "properties": {
        "may_rank": { "const": false },
        "may_size": { "const": false },
        "may_gate": { "const": false },
        "prophet_authority": { "const": false }
      }
    },
    "channel": {
      "type": "string",
      "maxLength": 40,
      "enum": [
        "revenue_demand",
        "margin_cost",
        "capital_allocation",
        "moat_duration",
        "strategic_option",
        "financial_incentives_survival",
        "market_only"
      ]
    },
    "template_schema": {
      "type": "string",
      "maxLength": 48,
      "enum": [
        "capital_allocation_event.v1",
        "demand_guidance_contract_event.v1",
        "strategic_product_partnership_event.v1"
      ]
    },
    "display_state": {
      "type": "string",
      "maxLength": 32,
      "enum": [
        "current",
        "superseded",
        "deferred",
        "rights_restricted",
        "no_change",
        "not_yet_quantifiable",
        "absence"
      ]
    },
    "record_kind": {
      "type": "string",
      "maxLength": 24,
      "enum": ["fact", "thesis_view", "transfer_edge", "absence"]
    },
    "issuer_role": {
      "type": "string",
      "maxLength": 16,
      "enum": ["subject", "counterparty", "competitor", "supplier", "customer", "incidental"]
    },
    "novelty": {
      "type": "string",
      "maxLength": 64,
      "enum": [
        "new_reporting_of_old_fact",
        "corrected_fact",
        "new_magnitude_timing_commitment_counterparty",
        "independently_observed_milestone",
        "commentary"
      ]
    },
    "commitment_status": {
      "type": "string",
      "maxLength": 16,
      "enum": ["authorized", "announced", "planned", "executed", "completed", "withdrawn", "conditional"]
    },
    "cluster_grain": {
      "type": "string",
      "maxLength": 32,
      "enum": ["article_manifestation", "fact_revision", "thesis_link"]
    },
    "field_absence.v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "authority", "reason", "subject", "detail", "missing_fields"],
      "properties": {
        "schema": { "type": "string", "const": "field_absence.v1" },
        "authority": { "$ref": "#/$defs/authority" },
        "reason": {
          "type": "string",
          "maxLength": 32,
          "enum": ["not_stated", "stated_without_number", "range_only", "redacted_rights", "parse_failed"]
        },
        "owner_reason": {
          "type": "string",
          "maxLength": 48,
          "enum": [
            "no_source_document",
            "no_transcript",
            "no_primary_release",
            "no_span_addressable_evidence",
            "document_bytes_not_held",
            "scanned_image_no_text_layer",
            "unjoinable_filing_identity",
            "speaker_unresolvable",
            "slide_family_discontinued",
            "superseded_by_duplicate",
            "missing_basis",
            "missing_units",
            "unit_mismatch",
            "cross_check_conflict",
            "missing_period",
            "missing_source"
          ]
        },
        "subject": { "$ref": "#/$defs/text_safe", "minLength": 1, "maxLength": 64 },
        "detail": { "$ref": "#/$defs/text_safe", "maxLength": 240 },
        "missing_fields": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/text_safe", "minLength": 1, "maxLength": 64 }
        }
      }
    },
    "locator_text_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sub_kind", "segment_index", "span_start_byte", "span_end_byte"],
      "properties": {
        "kind": { "type": "string", "const": "text_span" },
        "sub_kind": { "$ref": "#/$defs/text_safe", "minLength": 1, "maxLength": 32 },
        "segment_index": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "span_start_byte": { "type": "integer", "minimum": 0, "maximum": 100000000 },
        "span_end_byte": { "type": "integer", "minimum": 0, "maximum": 100000000 }
      }
    },
    "locator_table_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "const": "table_cell" },
        "page": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "table": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 100000 },
            { "$ref": "#/$defs/text_safe", "minLength": 1, "maxLength": 64 }
          ]
        },
        "row": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "column": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "cell_ref": { "$ref": "#/$defs/text_safe", "maxLength": 32 },
        "note": { "$ref": "#/$defs/text_safe", "maxLength": 120 }
      }
    },
    "locator_slide_region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "const": "slide_region" },
        "page": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "region": { "$ref": "#/$defs/text_safe", "maxLength": 64 },
        "note": { "$ref": "#/$defs/text_safe", "maxLength": 120 }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "segment_index",
        "segment_sha256",
        "segment_bytes",
        "span_start_byte",
        "span_end_byte",
        "text_sha256"
      ],
      "properties": {
        "source_sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" },
        "segment_index": { "type": "integer", "minimum": 0 },
        "segment_sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" },
        "segment_bytes": { "type": "integer", "minimum": 0 },
        "span_start_byte": { "type": "integer", "minimum": 0 },
        "span_end_byte": { "type": "integer", "minimum": 0 },
        "text_sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "projected_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authority",
        "span_id",
        "document_id",
        "document_version",
        "locator",
        "text_sha256",
        "display_excerpt",
        "rights_profile",
        "receipt_state",
        "receipt",
        "unreplayable_reason"
      ],
      "properties": {
        "schema": { "type": "string", "const": "source_span.v1" },
        "authority": { "$ref": "#/$defs/authority" },
        "span_id": { "$ref": "#/$defs/text_safe", "minLength": 1, "maxLength": 128 },
        "document_id": { "$ref": "#/$defs/text_safe", "minLength": 1, "maxLength": 128 },
        "document_version": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "locator": {
          "oneOf": [
            { "$ref": "#/$defs/locator_text_span" },
            { "$ref": "#/$defs/locator_table_cell" },
            { "$ref": "#/$defs/locator_slide_region" }
          ]
        },
        "text_sha256": {
          "type": ["string", "null"],
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "display_excerpt": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/text_safe", "minLength": 1, "maxLength": 500 }
          ]
        },
        "rights_profile": { "$ref": "#/$defs/text_safe", "minLength": 1, "maxLength": 64 },
        "receipt_state": { "type": "string", "enum": ["byte_replayed", "address_only"] },
        "receipt": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/receipt" }
          ]
        },
        "unreplayable_reason": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/text_safe", "maxLength": 240 }
          ]
        }
      }
    },
    "drilldown_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "claimed_quote", "span"],
      "properties": {
        "slot": { "$ref": "#/$defs/text_safe", "minLength": 1, "maxLength": 64 },
        "claimed_quote": { "$ref": "#/$defs/text_safe", "minLength": 1, "maxLength": 500 },
        "span": { "$ref": "#/$defs/projected_span" }
      }
    },
    "display_quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "form"],
      "properties": {
        "slot": { "$ref": "#/$defs/text_safe", "minLength": 1, "maxLength": 64 },
        "form": { "type": "string", "enum": ["point", "range", "absent"] },
        "value": { "type": "number", "minimum": -1e15, "maximum": 1e15 },
        "low": { "type": "number", "minimum": -1e15, "maximum": 1e15 },
        "high": { "type": "number", "minimum": -1e15, "maximum": 1e15 },
        "bound": { "type": "string", "enum": ["exact", "approximately", "up_to", "at_least"] },
        "unit": { "$ref": "#/$defs/text_safe", "minLength": 1, "maxLength": 32 },
        "currency": { "type": "string", "maxLength": 3, "pattern": "^([A-Z]{3}|NA)$" },
        "basis": { "type": "string", "enum": ["total", "incremental", "run_rate", "per_share", "percent"] },
        "absence": { "$ref": "#/$defs/field_absence.v1" }
      },
      "allOf": [
        {
          "if": { "properties": { "form": { "const": "point" } }, "required": ["form"] },
          "then": { "required": ["value", "bound", "unit", "currency", "basis"] }
        },
        {
          "if": { "properties": { "form": { "const": "range" } }, "required": ["form"] },
          "then": { "required": ["low", "high", "bound", "unit", "currency", "basis"] }
        },
        {
          "if": { "properties": { "form": { "const": "absent" } }, "required": ["form"] },
          "then": { "required": ["absence"] }
        }
      ]
    },
    "glance_copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "title_key",
        "subtitle_key",
        "window_key",
        "watching_key",
        "stance_key",
        "slots"
      ],
      "properties": {
        "template_id": {
          "type": "string",
          "enum": [
            "T1_authorization",
            "T1_execution",
            "T1_no_change",
            "T2_guidance",
            "T2_contract",
            "T2_no_change",
            "T3_option",
            "T3_milestone",
            "T3_no_change",
            "ABSENCE_defer",
            "ABSENCE_rights",
            "SUPERSEDED"
          ]
        },
        "title_key": { "$ref": "#/$defs/copy_key" },
        "subtitle_key": { "$ref": "#/$defs/copy_key" },
        "window_key": { "$ref": "#/$defs/copy_key" },
        "watching_key": { "$ref": "#/$defs/copy_key" },
        "stance_key": { "type": "string", "const": "stance_heads_up" },
        "slots": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action_plain": { "$ref": "#/$defs/text_safe", "maxLength": 40 },
            "amount_plain": { "$ref": "#/$defs/text_safe", "maxLength": 48 },
            "remaining_plain": { "$ref": "#/$defs/text_safe", "maxLength": 48 },
            "window_plain": { "$ref": "#/$defs/text_safe", "maxLength": 40 },
            "status_plain": { "$ref": "#/$defs/text_safe", "maxLength": 32 },
            "metric_plain": { "$ref": "#/$defs/text_safe", "maxLength": 32 },
            "revision_plain": { "$ref": "#/$defs/text_safe", "maxLength": 32 },
            "object_plain": { "$ref": "#/$defs/text_safe", "maxLength": 48 },
            "event_plain": { "$ref": "#/$defs/text_safe", "maxLength": 40 },
            "prior_amount_plain": { "$ref": "#/$defs/text_safe", "maxLength": 48 }
          }
        }
      }
    },
    "fact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fact_id", "template_schema", "document_id"],
      "properties": {
        "kind": { "type": "string", "const": "fact" },
        "fact_id": { "$ref": "#/$defs/fact_id" },
        "template_schema": { "$ref": "#/$defs/template_schema" },
        "document_id": { "$ref": "#/$defs/text_safe", "minLength": 1, "maxLength": 128 },
        "supersedes_fact_id": {
          "type": ["string", "null"],
          "pattern": "^fact_[0-9a-f]{24}$"
        }
      }
    },
    "thesis_view_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "thesis_id",
        "cluster_grain",
        "supporting_fact_ids",
        "contrary_fact_ids",
        "next_observation_key",
        "deadline_date",
        "watching_key"
      ],
      "properties": {
        "kind": { "type": "string", "const": "thesis_view" },
        "thesis_id": {
          "type": "string",
          "minLength": 31,
          "maxLength": 31,
          "pattern": "^thesis_[0-9a-f]{24}$"
        },
        "cluster_grain": { "type": "string", "const": "thesis_link" },
        "supporting_fact_ids": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/fact_id" }
        },
        "contrary_fact_ids": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/fact_id" }
        },
        "next_observation_key": { "$ref": "#/$defs/copy_key" },
        "deadline_date": {
          "oneOf": [
            { "$ref": "#/$defs/iso_date" },
            { "$ref": "#/$defs/field_absence.v1" }
          ]
        },
        "watching_key": { "$ref": "#/$defs/copy_key" }
      }
    },
    "transfer_edge_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_company_id",
        "target_company_id",
        "target_role",
        "direction",
        "mechanism_channel",
        "exposure",
        "one_hop",
        "edge_span"
      ],
      "properties": {
        "kind": { "type": "string", "const": "transfer_edge" },
        "source_company_id": { "$ref": "#/$defs/company_id" },
        "target_company_id": { "$ref": "#/$defs/company_id" },
        "target_role": { "type": "string", "enum": ["supplier", "customer", "counterparty", "competitor"] },
        "direction": { "type": "string", "enum": ["helps", "hurts", "unknown"] },
        "mechanism_channel": { "$ref": "#/$defs/channel" },
        "exposure": { "type": "string", "enum": ["UNKNOWN"] },
        "one_hop": { "const": true },
        "edge_span": { "$ref": "#/$defs/drilldown_span" }
      }
    },
    "subject_ref": {
      "oneOf": [
        { "$ref": "#/$defs/fact_ref" },
        { "$ref": "#/$defs/thesis_view_ref" },
        { "$ref": "#/$defs/transfer_edge_ref" },
        { "$ref": "#/$defs/field_absence.v1" }
      ]
    },
    "listing_join": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "state"],
      "properties": {
        "ticker": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/text_safe", "minLength": 1, "maxLength": 16, "pattern": "^[A-Z0-9][A-Z0-9.-]{0,14}$" }
          ]
        },
        "state": { "type": "string", "enum": ["resolved", "unresolved_listing"] },
        "absence": { "$ref": "#/$defs/field_absence.v1" }
      }
    },
    "prophet_evidence.v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authority",
        "prophet_flags",
        "record_kind",
        "company_id",
        "as_of",
        "observed_at",
        "source_available_at",
        "issuer_role",
        "channel",
        "display_state",
        "subject_ref",
        "glance",
        "source_spans",
        "quantities",
        "absence",
        "listing_join",
        "unsolicited_instruction_detected"
      ],
      "properties": {
        "schema": { "type": "string", "const": "prophet_evidence.v1", "maxLength": 32 },
        "authority": { "$ref": "#/$defs/authority" },
        "prophet_flags": { "$ref": "#/$defs/prophet_flags" },
        "record_kind": { "$ref": "#/$defs/record_kind" },
        "company_id": { "$ref": "#/$defs/company_id" },
        "as_of": { "$ref": "#/$defs/iso_date" },
        "observed_at": { "$ref": "#/$defs/datetime_utc" },
        "source_available_at": { "$ref": "#/$defs/datetime_utc" },
        "issuer_role": { "$ref": "#/$defs/issuer_role" },
        "channel": { "$ref": "#/$defs/channel" },
        "display_state": { "$ref": "#/$defs/display_state" },
        "novelty": { "$ref": "#/$defs/novelty" },
        "commitment_status": { "$ref": "#/$defs/commitment_status" },
        "negated": { "type": "boolean" },
        "cluster_grain": { "$ref": "#/$defs/cluster_grain" },
        "subject_ref": { "$ref": "#/$defs/subject_ref" },
        "glance": { "$ref": "#/$defs/glance_copy" },
        "source_spans": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/drilldown_span" }
        },
        "quantities": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/display_quantity" }
        },
        "absence": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/field_absence.v1" }
          ]
        },
        "listing_join": { "$ref": "#/$defs/listing_join" },
        "unsolicited_instruction_detected": { "type": "boolean", "const": false }
      },
      "allOf": [
        {
          "if": { "properties": { "display_state": { "const": "absence" } }, "required": ["display_state"] },
          "then": {
            "properties": { "absence": { "$ref": "#/$defs/field_absence.v1" } },
            "required": ["absence"]
          }
        },
        {
          "if": { "properties": { "display_state": { "const": "rights_restricted" } }, "required": ["display_state"] },
          "then": {
            "properties": {
              "source_spans": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "span": {
                      "type": "object",
                      "properties": { "display_excerpt": { "type": "null" } }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "subject_ref": { "properties": { "kind": { "const": "fact" } }, "required": ["kind"] }
            },
            "required": ["subject_ref"]
          },
          "then": { "required": ["novelty", "commitment_status", "negated", "cluster_grain"] }
        }
      ]
    },
    "prophet_evidence_bundle.v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authority",
        "prophet_flags",
        "as_of",
        "n_records",
        "records",
        "disclaimer_key"
      ],
      "properties": {
        "schema": { "type": "string", "const": "prophet_evidence_bundle.v1", "maxLength": 40 },
        "authority": { "$ref": "#/$defs/authority" },
        "prophet_flags": { "$ref": "#/$defs/prophet_flags" },
        "as_of": { "$ref": "#/$defs/iso_date" },
        "n_records": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "records": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/prophet_evidence.v1" }
        },
        "disclaimer_key": { "type": "string", "const": "stance_heads_up" }
      }
    }
  }
}
