 "dividend_sentence": "Before about 2000 the two price vendors (this download and the Tiingo archive behind the sector history) apply dividend adjustment differently in old history; neither is shown to be right. The yearly name-week disagreement table below states the rate.",
 "group_size_sentence": "In a group of n members the share moves in steps of 100/n; read a small group's share as a count (n_above_200 of n_counted_200). A 13-week change differences two such shares, so in a small group one name moves it a lot.",
 "floors": {
  "share_change_rank_state": 2,
  "index": 2,
  "counts": "any size",
  "single_name": "a one-member group has no series; the links table marks it single_name (the stock is the series)",
  "size_class": "small under 10 counted members on that date, else standard",
  "rank": "within the same family and size class on each date; no rank across classes",
  "source": "COO ruling 34 s2 (replaces the floors of rulings 27, 31 and 32 for these files); the live engine's floor is unchanged"
 },
 "single_name_groups": {},
 "index": {
  "rebalance_rule": "engine.baskets._ew_level: each session the index return is the plain mean of the daily total returns of the members priced that session (daily rebalance to equal weight), chained from 1.0 on the group's first valid session",
  "return": "total return (auto_adjust closes)",
  "floor_gap": "On a session with fewer than 2 priced members the level is missing (reason below_index_member_floor) and that session carries no return; the chain resumes from the last valid level.",
  "dividend_effect": "A difference in dividend method shifts the long-run level of a total-return index, not the timing of its turns.",
  "survivors_only_effect": "The index holds only names alive today, so its past returns are overstated, more so the further back and in themes with high failure rates; relative turns between groups are less affected than levels, and that is not tested here.",
  "daily_committed": false,
  "daily_note": "the daily index of this class is not committed (it would take the committed files over 25 MB); weekly is committed and the daily rebuilds from the scratch download with --daily"
 },
