{
  "description": "Macro Dashboard Codex lifecycle hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/worktree_sparse.py\" auto",
            "timeout": 180,
            "statusMessage": "Applying the Macro sparse-worktree profile"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; [ -f \"$root/.claude/hooks/gh_quota_guard.py\" ] || exit 0; MACRO_CODEX_HOOK=1 exec python3 \"$root/.claude/hooks/gh_quota_guard.py\"'",
            "timeout": 30,
            "statusMessage": "Preventing blocking Codex CI watches"
          }
        ]
      }
    ]
  }
}
