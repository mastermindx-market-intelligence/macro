{
  "description": "Macro Dashboard Codex lifecycle hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/worktree_sparse.py\" auto",
            "timeout": 180,
            "statusMessage": "Applying the Macro sparse-worktree profile"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/gh_quota_guard.py\"",
            "timeout": 30,
            "statusMessage": "Enforcing asynchronous CI observation"
          }
        ]
      }
    ]
  }
}
