{#- FROZEN SPEC B-F07-2 -- Valuation under YOUR assumptions.
    Additive sandbox under the V1 panel. Client-side recompute of the same
    three free parameters V1 hard-codes. Nothing is saved or sent.
    Governed CSS lives in this partial's own <style> block -- never authored
    as a runtime JS stylesheet. Whole file gated on valuation_assumptions
    (CSS included). -#}
{% if valuation_assumptions %}
<style>
.va-lede{margin:2px 0 16px;font-size:13px;line-height:1.55;color:var(--muted);max-width:62ch;}
.va-ctls{display:flex;flex-direction:column;gap:14px;margin:4px 0 18px;}
.va-ctl{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px 12px;align-items:center;}
.va-ctl label{font-size:12.5px;font-weight:650;color:var(--text);}
.va-ctl .va-readout{font-variant-numeric:tabular-nums;font-weight:700;color:var(--link);font-size:12.5px;text-align:right;}
.va-ctl .va-unit{font-size:11px;font-weight:500;color:var(--muted);text-align:right;}
.va-ctl input[type=range]{grid-column:1 / -1;width:100%;accent-color:var(--link);height:22px;margin:0;background:transparent;}
[data-theme="light"] .va-ctl input[type=range]{accent-color:var(--link);}
.va-out{margin:4px 0 14px;padding:14px 16px;background:color-mix(in srgb,var(--panel2) 55%,transparent);border:1px solid var(--hair);border-radius:var(--r-card,13px);}
[data-theme="light"] .va-out{background:var(--panel);border:1px solid var(--hair);box-shadow:0 6px 18px -12px color-mix(in srgb,var(--text) 18%,transparent);}
.va-out-k{font-size:10.5px;font-weight:650;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;}
[data-lang="zh"] .va-out-k{letter-spacing:0;text-transform:none;}
.va-out-num{margin-top:6px;font-size:28px;font-weight:800;letter-spacing:-.02em;font-variant-numeric:tabular-nums;text-shadow:0 0 12px color-mix(in srgb,var(--link) 35%,transparent);}
[data-theme="light"] .va-out-num{text-shadow:none;}
.va-out-null{margin-top:8px;font-size:13px;line-height:1.5;color:var(--muted);font-weight:600;}
.va-bridge{margin:8px 0 0;font-size:12px;line-height:1.5;color:var(--muted);}
.va-presets{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 12px;}
.va-presets .va-preset-on{border-color:var(--link);color:var(--link);}
.va-nojs{margin:0 0 12px;font-size:12px;line-height:1.5;color:var(--muted);}
.va-note{margin:0 0 6px;font-size:11.5px;line-height:1.5;color:var(--muted);}
.va-floor{margin:8px 0 12px;font-size:13px;line-height:1.55;color:var(--muted);}
.va-is-null .va-out-num,.va-is-null .va-bridge{display:none;}
.va-is-null .va-out-null{display:block;}
@media(max-width:390px){
  .va-ctl{grid-template-columns:1fr;gap:4px;}
  .va-ctl .va-readout,.va-ctl .va-unit{text-align:left;}
  .va-out-num{font-size:22px;}
}
</style>
{% set va = valuation_assumptions %}
{% set inp = va.inputs %}
{% set sd = va.server_default %}
{% set nmb = inp.net_margin_base %}
{% set floor = va.margin_base_floor %}
<section class="mod rv" id="valuation-assumptions" data-valuation-assumptions="v1">
  <div class="mod-hd">
    <h2>{{ t('Try your own assumptions', '试试你自己的假设') }}</h2>
    <span class="hint">{{ t('same reported figures · FY' ~ va.fy, '同一批披露数据 · ' ~ va.fy ~ '财年') }}</span>
  </div>
  <p class="va-lede">{{ t('Move the three inputs below. The per-share number updates as you move them. Nothing you set here is saved or sent anywhere.', '调整下面三项输入，每股数值会随之更新。你在这里设置的内容不会被保存，也不会被发送到任何地方。') }}</p>
  {% if nmb is not none and (nmb | abs) < floor %}
  <p class="va-floor">{{ t('Not enough reported margin to run this.', '披露的利润率基数不足，无法进行试算。') }}</p>
  {% else %}
  <script type="application/json" id="vs-assumption-inputs">{{ va | tojson }}</script>
  <div class="va-ctls">
    {% for c in va.controls %}
      {% if c.key == 'sales_growth_pct' %}
    <div class="va-ctl">
      <label for="va-ctl-sales_growth_pct">{{ t('Sales growth next year', '下一年销售增长') }}</label>
      <span class="va-readout" id="va-read-sales_growth_pct">{{ '%+.1f'|format(sd.sales_growth_pct) }}%</span>
      <input type="range" id="va-ctl-sales_growth_pct" min="{{ c.min }}" max="{{ c.max }}" step="{{ c.step }}" value="{{ sd.sales_growth_pct }}">
    </div>
      {% elif c.key == 'margin_delta_pp' %}
    <div class="va-ctl">
      <label for="va-ctl-margin_delta_pp">{{ t('Margin change', '利润率变化') }}</label>
      <span>
        <span class="va-readout" id="va-read-margin_delta_pp">{{ '%+.1f'|format(sd.margin_delta_pp) }}</span>
        <span class="va-unit">{{ t('percentage points', '个百分点') }}</span>
      </span>
      <input type="range" id="va-ctl-margin_delta_pp" min="{{ c.min }}" max="{{ c.max }}" step="{{ c.step }}" value="{{ sd.margin_delta_pp }}">
    </div>
      {% else %}
    <div class="va-ctl">
      <label for="va-ctl-earnings_multiple">{{ t('Earnings multiple', '市盈率倍数') }}</label>
      <span class="va-readout" id="va-read-earnings_multiple">{{ '%d'|format(sd.earnings_multiple) }}×</span>
      <input type="range" id="va-ctl-earnings_multiple" min="{{ c.min }}" max="{{ c.max }}" step="{{ c.step }}" value="{{ sd.earnings_multiple }}">
    </div>
      {% endif %}
    {% endfor %}
  </div>
  <div class="va-out" id="va-out" aria-live="polite" aria-label="Per-share value computed from the assumptions you set">
    <div class="va-out-k">{{ t('Per share, on your assumptions', '按你的假设计算的每股价值') }}</div>
    <div class="va-out-num num" id="va-out-num">${{ '%.2f'|format(sd.per_share) }}</div>
    <div class="va-out-null" id="va-out-null" hidden>{{ t('Margins are too thin at this setting to produce a number.', '在该设置下利润率过低，无法算出数值。') }}</div>
    <p class="va-bridge" id="va-bridge">{{ t('Base case is $' ~ ('%.2f'|format(sd.per_share)) ~ '. Your assumptions give $' ~ ('%.2f'|format(sd.per_share)) ~ ' (+0.0%).', '基准情景为 $' ~ ('%.2f'|format(sd.per_share)) ~ '，你的假设得出 $' ~ ('%.2f'|format(sd.per_share)) ~ '（+0.0%）。') }}</p>
  </div>
  <div class="va-presets" id="va-presets">
    <button type="button" class="gbtn gbtn-sm va-preset" data-va-preset="cautious">{{ t('Cautious', '保守') }}</button>
    <button type="button" class="gbtn gbtn-sm va-preset va-preset-on" data-va-preset="base">{{ t('Base', '基准') }}</button>
    <button type="button" class="gbtn gbtn-sm va-preset" data-va-preset="upbeat">{{ t('Upbeat', '乐观') }}</button>
    <button type="button" class="gbtn gbtn-sm" id="va-reset">{{ t('Reset to base', '恢复基准') }}</button>
  </div>
  <p class="va-nojs" id="va-nojs">{{ t('Interactive controls need JavaScript. The three cases above are computed on the server and always shown.', '交互控件需要启用 JavaScript。上方三个情景由服务器计算，始终显示。') }}</p>
  <p class="va-note">{{ t('Applied to FY' ~ va.fy ~ ' as disclosed to the SEC — revenue, net income and share count come straight from the disclosure, and are not editable here.', '套用在按 SEC 披露的' ~ va.fy ~ '财年数据上——营业收入、净利润与股数均直接取自披露文件，此处不可修改。') }}</p>
  <p class="va-note">{{ t('Sales growth −10% to +20%; margin change −3.0 to +3.0 percentage points; earnings multiple 8× to 35×.', '销售增长 −10% 至 +20%；利润率变化 −3.0 至 +3.0 个百分点；市盈率倍数 8 倍至 35 倍。') }}</p>
  <script>
(function (root) {
  function round2(v) {
    if (!(v > 0) || v !== v || v === Infinity) return null;
    return Math.floor(v * 100 + 0.5) / 100;
  }
  function perShareAt(ni, revenue, shares, g, mPp, mult) {
    ni = Number(ni); revenue = Number(revenue); shares = Number(shares);
    g = Number(g); mPp = Number(mPp); mult = Number(mult);
    if (![ni, revenue, shares, g, mPp, mult].every(function (x) {
      return typeof x === "number" && x === x && x !== Infinity && x !== -Infinity;
    })) return null;
    if (!(ni > 0) || revenue === 0 || shares === 0) return null;
    var nmb = ni / revenue;
    if (Math.abs(nmb) < 0.01) return null;
    if (nmb + mPp / 100 <= 0) return null;
    var raw = ni * (1 + g / 100) * (1 + (mPp / 100) / nmb) * mult / shares;
    return round2(raw);
  }
  function format2(v) {
    var r = round2(v);
    return r == null ? null : r.toFixed(2);
  }
  root.vsAssumptionMath = { round2: round2, perShareAt: perShareAt, format2: format2 };
  if (typeof module !== "undefined" && module.exports) {
    module.exports = root.vsAssumptionMath;
  }
  if (typeof document === "undefined") return;

  var island = document.getElementById("vs-assumption-inputs");
  if (!island) return;
  var data;
  try { data = JSON.parse(island.textContent); } catch (e) { return; }
  var inp = data.inputs || {};
  var sd = data.server_default || {};
  var presets = data.presets || {};
  var elG = document.getElementById("va-ctl-sales_growth_pct");
  var elM = document.getElementById("va-ctl-margin_delta_pp");
  var elX = document.getElementById("va-ctl-earnings_multiple");
  var outWrap = document.getElementById("va-out");
  var outNum = document.getElementById("va-out-num");
  var outNull = document.getElementById("va-out-null");
  var bridge = document.getElementById("va-bridge");
  var readG = document.getElementById("va-read-sales_growth_pct");
  var readM = document.getElementById("va-read-margin_delta_pp");
  var readX = document.getElementById("va-read-earnings_multiple");
  var nojs = document.getElementById("va-nojs");
  if (nojs) nojs.hidden = true;
  if (!elG || !elM || !elX || !outNum) return;

  var basePs = Number(sd.per_share);
  var zh = (document.documentElement.getAttribute("data-lang") || "") === "zh";

  function signedPct(v, digits) {
    var n = Number(v);
    var body = Math.abs(n).toFixed(digits);
    if (n > 0) return "+" + body;
    if (n < 0) return "-" + body;
    return "+" + body;
  }
  function paintReadouts(g, m, x) {
    if (readG) readG.textContent = signedPct(g, 1) + "%";
    if (readM) readM.textContent = signedPct(m, 1);
    if (readX) readX.textContent = String(Math.round(Number(x))) + "\u00d7";
  }
  function markPreset(name) {
    var btns = document.querySelectorAll("[data-va-preset]");
    for (var i = 0; i < btns.length; i++) {
      if (btns[i].getAttribute("data-va-preset") === name) btns[i].classList.add("va-preset-on");
      else btns[i].classList.remove("va-preset-on");
    }
  }
  function matchingPreset(g, m, x) {
    for (var key in presets) {
      if (!Object.prototype.hasOwnProperty.call(presets, key)) continue;
      var p = presets[key];
      if (Number(p.sales_growth_pct) === Number(g) &&
          Number(p.margin_delta_pp) === Number(m) &&
          Number(p.earnings_multiple) === Number(x)) return key;
    }
    return "";
  }
  function paint() {
    var g = Number(elG.value);
    var m = Number(elM.value);
    var x = Number(elX.value);
    paintReadouts(g, m, x);
    markPreset(matchingPreset(g, m, x));
    var y = perShareAt(inp.net_income, inp.revenue, inp.shares, g, m, x);
    var thin = !(y > 0);
    if (outWrap) {
      if (thin) outWrap.classList.add("va-is-null");
      else outWrap.classList.remove("va-is-null");
    }
    if (outNull) outNull.hidden = !thin;
    if (outNum) outNum.hidden = thin;
    if (bridge) bridge.hidden = thin;
    if (thin) return;
    var yStr = format2(y);
    outNum.textContent = "$" + yStr;
    if (bridge && basePs > 0) {
      var pct = ((y - basePs) / basePs) * 100;
      var pctStr = signedPct(pct, 1);
      var bStr = Number(basePs).toFixed(2);
      if (zh) {
        bridge.textContent = "基准情景为 $" + bStr + "，你的假设得出 $" + yStr + "（" + pctStr + "%）。";
      } else {
        bridge.textContent = "Base case is $" + bStr + ". Your assumptions give $" + yStr + " (" + pctStr + "%).";
      }
    }
  }
  function applyTriple(g, m, x) {
    elG.value = String(g);
    elM.value = String(m);
    elX.value = String(x);
    paint();
  }
  elG.addEventListener("input", paint);
  elM.addEventListener("input", paint);
  elX.addEventListener("input", paint);
  var presetBtns = document.querySelectorAll("[data-va-preset]");
  for (var i = 0; i < presetBtns.length; i++) {
    presetBtns[i].addEventListener("click", function (ev) {
      var key = ev.currentTarget.getAttribute("data-va-preset");
      var p = presets[key];
      if (!p) return;
      applyTriple(p.sales_growth_pct, p.margin_delta_pp, p.earnings_multiple);
    });
  }
  var reset = document.getElementById("va-reset");
  if (reset) {
    reset.addEventListener("click", function () {
      applyTriple(sd.sales_growth_pct, sd.margin_delta_pp, sd.earnings_multiple);
    });
  }
  document.documentElement.addEventListener("langchange", paint);
  paint();
})(typeof globalThis !== "undefined" ? globalThis : this);
  </script>
  {% endif %}
  <div class="mod-ft">{{ t('Research display only — not advice.', '仅供研究展示，非投资建议。') }}</div>
</section>
{% endif %}
