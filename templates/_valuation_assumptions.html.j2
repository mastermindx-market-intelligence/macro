{#- FROZEN SPEC B-F07-2 -- Valuation under YOUR assumptions.
    Additive sandbox under the V1 panel. Client-side recompute of the same
    three free parameters V1 hard-codes. Nothing is saved or sent.
    Governed CSS lives in this partial's own <style> block -- never authored
    as a runtime JS stylesheet. Whole file gated on valuation_assumptions
    (CSS included). too_thin_base renders ONLY the single-line copy.
    B-F07-3 adds the event-to-assumption bridge line: one Tier-2 plain-word
    line under the controls naming which of the three F07-2 inputs a
    freshly-classified filing would touch, with a single direction word
    only -- no magnitude, no score, no ranking, nothing applied
    automatically. -#}
{% if valuation_assumptions %}
{% set va = valuation_assumptions %}
{% if va.too_thin_base %}
<style>
.va-floor{margin:0;font-size:13px;line-height:1.55;color:var(--muted);}
</style>
<section class="mod rv" id="valuation-assumptions-floor" data-valuation-assumptions="floor">
  <div class="mod-hd">
    <h2>{{ t('Try your own assumptions', '试试你自己的假设') }}</h2>
  </div>
  <p class="va-floor">{{ t('Not enough reported margin to run this.', '披露的利润率基数不足，无法进行试算。') }}</p>
  <div class="mod-ft">{{ t('Research display only — not advice.', '仅供研究展示，非投资建议。') }}</div>
</section>
{% else %}
<style>
.va-lede{margin:2px 0 16px;font-size:13px;line-height:1.55;color:var(--muted);max-width:62ch;}
.va-ctls{display:flex;flex-direction:column;gap:14px;margin:4px 0 18px;}
.va-ctl{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px 12px;align-items:center;}
.va-ctl label{font-size:12.5px;font-weight:650;color:var(--text);}
.va-ctl .va-readout{font-variant-numeric:tabular-nums;font-weight:700;color:var(--link);font-size:12.5px;text-align:right;}
.va-ctl .va-unit{font-size:11px;font-weight:500;color:var(--muted);text-align:right;}
.va-ctl input[type=range]{grid-column:1 / -1;width:100%;accent-color:var(--link);height:22px;margin:0;background:transparent;}
.va-out{margin:4px 0 14px;padding:14px 16px;background:color-mix(in srgb,var(--panel2) 55%,transparent);border:1px solid var(--hair);border-radius:var(--r-card,13px);}
[data-theme="light"] .va-out{background:var(--panel);border:1px solid var(--hair);box-shadow:0 6px 18px -12px color-mix(in srgb,var(--text) 18%,transparent);}
.va-out-k{font-size:10.5px;font-weight:650;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;}
[data-lang="zh"] .va-out-k{letter-spacing:0;text-transform:none;}
/* Never louder than the server-computed authority it defers to: V1's
   .vs-card .vv is 20px/800 with no glow, and this sandbox figure matches it. */
.va-out-num{margin-top:6px;font-size:20px;font-weight:800;letter-spacing:-.02em;font-variant-numeric:tabular-nums;}
.va-out-null{margin-top:8px;font-size:13px;line-height:1.5;color:var(--muted);font-weight:600;}
.va-bridge{margin:8px 0 0;font-size:12px;line-height:1.5;color:var(--muted);}
.va-presets{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 12px;}
.va-presets .va-preset-on{border-color:var(--link);color:var(--link);}
.va-note{margin:0 0 6px;font-size:11.5px;line-height:1.5;color:var(--muted);}
.va-is-null .va-out-num,.va-is-null .va-bridge{display:none;}
.va-is-null .va-out-null{display:block;}
/* B-F07-3 event-to-assumption bridge — one Tier-2 plain-word line under
   the controls. Smaller than the FY footnote; same hairline color as
   the notes so the line is read as receipt, not as instruction. */
.va-event-bridge{margin:6px 0 0;font-size:11px;line-height:1.5;color:var(--muted);}
.va-event-bridge .va-event-target{color:var(--muted);}
.va-event-bridge .va-event-null{font-style:normal;}
/* F07 event -> AssumptionChange proposal. A quiet aside, never louder than the
   server-computed figure above it: no accent fill, no glow, one hairline rule
   to mark it as a separate voice (the filing's, not the page's). The guard
   sentence is deliberately the same size as the claim it qualifies.
   Two art directions: dark leans on a recessed panel and a hairline; light
   uses white material with a soft shadow and no fill, per the theme law. */
.va-event-proposal{margin:14px 0 0;padding:12px 14px;border:1px solid var(--hair);
  border-left:2px solid color-mix(in srgb,var(--muted) 55%,transparent);
  border-radius:var(--r-card,13px);
  background:color-mix(in srgb,var(--panel2) 45%,transparent);}
[data-theme="light"] .va-event-proposal{background:var(--panel);
  border-left:2px solid color-mix(in srgb,var(--text) 22%,transparent);
  box-shadow:0 6px 18px -14px color-mix(in srgb,var(--text) 20%,transparent);}
.va-event-proposal-head{margin:0 0 6px;font-size:11px;font-weight:700;color:var(--text);
  text-transform:uppercase;letter-spacing:.06em;}
[data-lang="zh"] .va-event-proposal-head{letter-spacing:0;text-transform:none;}
.va-event-proposal-body,.va-event-proposal-move,.va-event-proposal-guard,
.va-event-proposal-source{margin:0 0 6px;font-size:12px;line-height:1.55;color:var(--muted);
  max-width:62ch;}
.va-event-proposal-move{color:var(--text);font-variant-numeric:tabular-nums;}
.va-event-proposal-guard{color:var(--muted);}
.va-event-proposal-source{margin-bottom:0;}
.va-event-proposal-source a{color:var(--link);text-decoration:underline;
  text-underline-offset:2px;}
@media(max-width:390px){
  .va-ctl{grid-template-columns:1fr;gap:4px;}
  .va-ctl .va-readout,.va-ctl .va-unit{text-align:left;}
}
</style>
{% set sd = va.server_default %}
<section class="mod rv" id="valuation-assumptions" data-valuation-assumptions="v1">
  <div class="mod-hd">
    <h2>{{ t('Try your own assumptions', '试试你自己的假设') }}</h2>
    <span class="hint"><span class="l-en">same reported figures · FY{{ va.fy }}</span><span class="l-zh">同一批披露数据 · {{ va.fy }}财年</span></span>
  </div>
  <p class="va-lede" id="va-lede-nojs">{{ t('Interactive controls need JavaScript. The three cases above are computed on the server and always shown.', '交互控件需要启用 JavaScript。上方三个情景由服务器计算，始终显示。') }}</p>
  <p class="va-lede" id="va-lede-js" hidden>{{ t('Move the three inputs below. The per-share number updates as you move them. Nothing you set here is saved or sent anywhere.', '调整下面三项输入，每股数值会随之更新。你在这里设置的内容不会被保存，也不会被发送到任何地方。') }}</p>
  <script type="application/json" id="vs-assumption-inputs">{{ va | tojson }}</script>
  <div class="va-ctls">
    {% for c in va.controls %}
      {% if c.key == 'sales_growth_pct' %}
    <div class="va-ctl">
      <label for="va-ctl-sales_growth_pct">{{ t('Sales growth next year', '下一年销售增长') }}</label>
      <span class="va-readout" id="va-read-sales_growth_pct">{{ '%+.1f'|format(sd.sales_growth_pct) if sd.sales_growth_pct else '%.1f'|format(sd.sales_growth_pct) }}%</span>
      <input type="range" id="va-ctl-sales_growth_pct" min="{{ c.min }}" max="{{ c.max }}" step="{{ c.step }}" value="{{ sd.sales_growth_pct }}" autocomplete="off" disabled>
    </div>
      {% elif c.key == 'margin_delta_pp' %}
    <div class="va-ctl">
      <label for="va-ctl-margin_delta_pp">{{ t('Margin change', '利润率变化') }}</label>
      <span>
        <span class="va-readout" id="va-read-margin_delta_pp">{{ '%+.1f'|format(sd.margin_delta_pp) if sd.margin_delta_pp else '%.1f'|format(sd.margin_delta_pp) }}</span>
        <span class="va-unit">{{ t('percentage points', '个百分点') }}</span>
      </span>
      <input type="range" id="va-ctl-margin_delta_pp" min="{{ c.min }}" max="{{ c.max }}" step="{{ c.step }}" value="{{ sd.margin_delta_pp }}" autocomplete="off" disabled>
    </div>
      {% else %}
    <div class="va-ctl">
      <label for="va-ctl-earnings_multiple">{{ t('Earnings multiple', '市盈率倍数') }}</label>
      <span class="va-readout" id="va-read-earnings_multiple">{{ '%d'|format(sd.earnings_multiple) }}×</span>
      <input type="range" id="va-ctl-earnings_multiple" min="{{ c.min }}" max="{{ c.max }}" step="{{ c.step }}" value="{{ sd.earnings_multiple }}" autocomplete="off" disabled>
    </div>
      {% endif %}
    {% endfor %}
  </div>
  {#- The label sits inside the card but OUTSIDE the live region, so a slider
      tick announces the value and not the label again; role="status" is what
      makes the aria-labelledby name survive (role=generic prohibits a name). -#}
  <div class="va-out">
    <div class="va-out-k" id="va-out-k">{{ t('Per share, on your assumptions', '按你的假设计算的每股价值') }}</div>
    <div id="va-out" role="status" aria-live="polite" aria-labelledby="va-out-k">
      <div class="va-out-num num" id="va-out-num">${{ '%.2f'|format(sd.per_share) }}</div>
      <div class="va-out-null" id="va-out-null" hidden>{{ t('Margins are too thin at this setting to produce a number.', '在该设置下利润率过低，无法算出数值。') }}</div>
      <p class="va-bridge" id="va-bridge"><span class="l-en" lang="en">Base case is ${{ '%.2f'|format(sd.per_share) }}. Your assumptions give ${{ '%.2f'|format(sd.per_share) }} (0.0%).</span><span class="l-zh" lang="zh-CN">基准情景为 ${{ '%.2f'|format(sd.per_share) }}，你的假设得出 ${{ '%.2f'|format(sd.per_share) }}（0.0%）。</span></p>
    </div>
  </div>
  <div class="va-presets" id="va-presets">
    <button type="button" class="gbtn gbtn-sm va-preset" data-va-preset="cautious" disabled>{{ t('Cautious', '保守') }}</button>
    <button type="button" class="gbtn gbtn-sm va-preset va-preset-on" data-va-preset="base" disabled>{{ t('Base', '基准') }}</button>
    <button type="button" class="gbtn gbtn-sm va-preset" data-va-preset="upbeat" disabled>{{ t('Upbeat', '乐观') }}</button>
    <button type="button" class="gbtn gbtn-sm" id="va-reset" disabled>{{ t('Reset to base', '恢复基准') }}</button>
  </div>
  <p class="va-note"><span class="l-en">Applied to FY{{ va.fy }} as disclosed to the SEC — revenue, net income and share count come straight from the disclosure, and are not editable here.</span><span class="l-zh">套用在按 SEC 披露的{{ va.fy }}财年数据上——营业收入、净利润与股数均直接取自披露文件，此处不可修改。</span></p>
  {#- One minus-sign convention across the panel: the site's ASCII hyphen-minus,
      the same character the V1 cards and this panel's own readouts print. -#}
  <p class="va-note">{{ t('Sales growth -10% to +20%; margin change -3.0 to +3.0 percentage points; earnings multiple 8× to 35×.', '销售增长 -10% 至 +20%；利润率变化 -3.0 至 +3.0 个百分点；市盈率倍数 8 倍至 35 倍。') }}</p>
  {#- B-F07-3 event-to-assumption bridge. One plain-word line under the
      controls: the latest classified event on file usually touches growth,
      margin, or multiple — or a typed null. No magnitude, no score, no
      ranking, nothing applied automatically. The user moves the
      slider; the bridge never moves it. -#}
  {% set _va_event_bridge = va.latest_event_bridge if va and va.latest_event_bridge else None %}
  {% set _va_prop = va.event_assumption_proposal if va and va.event_assumption_proposal else None %}
  {% set _va_scen = va.event_assumption_scenario if va and va.event_assumption_scenario else None %}
  {#- When a lawful proposal renders below, it IS the statement about the
      latest filing — so this one-line summary yields entirely rather than
      claiming "no filing on file" directly above the filing it links. -#}
  {% set _va_shows_proposal = (_va_prop and _va_prop.status == 'PROPOSED'
                               and _va_scen and not _va_scen.refused) %}
  {% if not _va_shows_proposal %}
  <p class="va-event-bridge" id="va-event-bridge" data-valuation-event-bridge="v1">
    {% if _va_event_bridge %}
    {{ t(
      (
        'Latest filing on file (' ~ _va_event_bridge.event_class_en
        ~ ') <span class="va-event-target">' ~ _va_event_bridge.direction_word ~ '</span>.'
      ) | safe,
      (
        '最新备案（' ~ _va_event_bridge.event_class_zh
        ~ '）<span class="va-event-target">' ~ _va_event_bridge.direction_word_zh ~ '</span>。'
      ) | safe
    ) }}
    {% elif _va_prop and _va_prop.rationale_en and _va_prop.event and _va_prop.event.event_id %}
    {#- The class map has no entry for this event, but we still know what the
        event was and why it does not move an input. Saying "no filing on file"
        here would be false: there IS a filing, it just cannot lawfully set an
        assumption. Only for the abstaining case — when a proposal renders
        below, this line would repeat its first sentence verbatim. -#}
    {{ t(_va_prop.rationale_en, _va_prop.rationale_zh) }}
    {% else %}
    {{ t('No filing on file yet for this company.', '该公司暂无备案。') }}
    {% endif %}
  </p>
  {% endif %}
  {#- F07 event -> AssumptionChange proposal. A PROPOSAL, never our number and
      never applied: the panel shows what a recent filing would argue, what it
      would do to the per-share figure, and where to read the filing. The user
      moves the slider or ignores it. Plain words only (DESIGN_DOCTRINE Law 2):
      no status codes, no reason slugs, no refutation language. -#}
  {% if _va_shows_proposal %}
  {% set _va_ref = (_va_prop.event.source_refs or [None])[0] %}
  {% set _va_unit = {'sales_growth_pct': '%', 'margin_delta_pp': ' pp', 'earnings_multiple': '×'}.get(_va_prop.assumption_name, '') %}
  <div class="va-event-proposal" id="va-event-proposal" data-valuation-event-proposal="v1">
    <p class="va-event-proposal-head">
      {{ t('A recent filing argues this differently', '最近的一份备案给出了不同的看法') }}
    </p>
    <p class="va-event-proposal-body">
      {{ t(_va_prop.rationale_en, _va_prop.rationale_zh) }}
    </p>
    <p class="va-event-proposal-move">
      {{ t(
        'Moving that one input from ' ~ _va_prop.baseline_value ~ _va_unit ~ ' to '
          ~ _va_prop.proposed_value ~ _va_unit ~ ' takes the value per share from $'
          ~ _va_scen.baseline.per_share ~ ' to $' ~ _va_scen.proposed.per_share
          ~ '. The other two are untouched.',
        '仅将该项假设从 ' ~ _va_prop.baseline_value ~ _va_unit ~ ' 调整为 '
          ~ _va_prop.proposed_value ~ _va_unit ~ '，每股价值将从 $'
          ~ _va_scen.baseline.per_share ~ ' 变为 $' ~ _va_scen.proposed.per_share
          ~ '，另外两项不变。'
      ) }}
    </p>
    <p class="va-event-proposal-guard">
      {{ t(
        'That figure is this page\'s own more optimistic case, not a number the company gave. Nothing has been changed for you — move the slider yourself if you agree, or ignore it.',
        '该数值取自本页自身较乐观的情景设定，并非公司给出的数字。系统不会替您更改任何设置——您可以自行调整滑块，也可以忽略。'
      ) }}
    </p>
    {% if _va_ref and _va_ref.url %}
    <p class="va-event-proposal-source">
      <a href="{{ _va_ref.url }}" rel="noopener noreferrer" target="_blank">{{
        t('Read the ' ~ (_va_ref.form or 'filing') ~ ' filed ' ~ (_va_ref.file_date or ''),
          '查看 ' ~ (_va_ref.file_date or '') ~ ' 提交的 ' ~ (_va_ref.form or '备案')) }}</a>
    </p>
    {% endif %}
  </div>
  {% endif %}
  <script>
(function (root) {
  function round2(v) {
    if (!(v > 0) || v !== v || v === Infinity) return null;
    return Math.floor(v * 100 + 0.5) / 100;
  }
  function perShareAt(ni, revenue, shares, g, mPp, mult) {
    ni = Number(ni); revenue = Number(revenue); shares = Number(shares);
    g = Number(g); mPp = Number(mPp); mult = Number(mult);
    if (![ni, revenue, shares, g, mPp, mult].every(function (x) {
      return typeof x === "number" && x === x && x !== Infinity && x !== -Infinity;
    })) return null;
    if (!(ni > 0) || revenue === 0 || shares === 0) return null;
    var nmb = ni / revenue;
    if (Math.abs(nmb) < 0.01) return null;
    if (nmb + mPp / 100 <= 0) return null;
    var raw = ni * (1 + g / 100) * (1 + (mPp / 100) / nmb) * mult / shares;
    var out = round2(raw);
    // round2 collapses a positive sub-half-cent raw to 0; 0 is not a paintable
    // per-share value, so it is null here exactly as it is in Python.
    return (out == null || !(out > 0)) ? null : out;
  }
  function format2(v) {
    var r = round2(v);
    return r == null ? null : r.toFixed(2);
  }
  // One sign convention for every signed figure the panel prints. A value that
  // rounds to zero is neither a rise nor a fall, so it carries no sign at all:
  // "-0.0%" beside two equal dollar figures is a formatting artifact, not
  // plain language. The server render prints the same three strings.
  function signedPct(v, digits) {
    var n = Number(v);
    var body = Math.abs(n).toFixed(digits);
    if (Number(body) === 0) return body;
    return (n < 0 ? "-" : "+") + body;
  }
  root.vsAssumptionMath = {
    round2: round2,
    perShareAt: perShareAt,
    format2: format2,
    signedPct: signedPct
  };
  if (typeof module !== "undefined" && module.exports) {
    module.exports = root.vsAssumptionMath;
  }
  if (typeof document === "undefined") return;

  var island = document.getElementById("vs-assumption-inputs");
  if (!island) return;
  var data;
  try { data = JSON.parse(island.textContent); } catch (e) { return; }
  var inp = data.inputs || {};
  var sd = data.server_default || {};
  var presets = data.presets || {};
  var elG = document.getElementById("va-ctl-sales_growth_pct");
  var elM = document.getElementById("va-ctl-margin_delta_pp");
  var elX = document.getElementById("va-ctl-earnings_multiple");
  var outWrap = document.getElementById("va-out");
  var outNum = document.getElementById("va-out-num");
  var outNull = document.getElementById("va-out-null");
  var bridge = document.getElementById("va-bridge");
  var readG = document.getElementById("va-read-sales_growth_pct");
  var readM = document.getElementById("va-read-margin_delta_pp");
  var readX = document.getElementById("va-read-earnings_multiple");
  if (!elG || !elM || !elX || !outNum) return;
  elG.removeAttribute("disabled");
  elM.removeAttribute("disabled");
  elX.removeAttribute("disabled");
  var bootBtns = document.querySelectorAll("#va-presets button");
  for (var bi = 0; bi < bootBtns.length; bi++) bootBtns[bi].removeAttribute("disabled");
  var ledeNojs = document.getElementById("va-lede-nojs");
  var ledeJs = document.getElementById("va-lede-js");
  if (ledeNojs) ledeNojs.hidden = true;
  if (ledeJs) ledeJs.hidden = false;

  var basePs = Number(sd.per_share);

  function paintReadouts(g, m, x) {
    if (readG) readG.textContent = signedPct(g, 1) + "%";
    if (readM) readM.textContent = signedPct(m, 1);
    if (readX) readX.textContent = String(Math.round(Number(x))) + "\u00d7";
  }
  function markPreset(name) {
    var btns = document.querySelectorAll("[data-va-preset]");
    for (var i = 0; i < btns.length; i++) {
      if (btns[i].getAttribute("data-va-preset") === name) btns[i].classList.add("va-preset-on");
      else btns[i].classList.remove("va-preset-on");
    }
  }
  function matchingPreset(g, m, x) {
    for (var key in presets) {
      if (!Object.prototype.hasOwnProperty.call(presets, key)) continue;
      var p = presets[key];
      if (Number(p.sales_growth_pct) === Number(g) &&
          Number(p.margin_delta_pp) === Number(m) &&
          Number(p.earnings_multiple) === Number(x)) return key;
    }
    return "";
  }
  function paint() {
    var g = Number(elG.value);
    var m = Number(elM.value);
    var x = Number(elX.value);
    paintReadouts(g, m, x);
    markPreset(matchingPreset(g, m, x));
    var y = perShareAt(inp.net_income, inp.revenue, inp.shares, g, m, x);
    var thin = !(y > 0);
    if (outWrap) {
      // Each twin declares its own language in the markup (lang="en" /
      // lang="zh-CN"); nothing stamps one language on the node holding both.
      if (thin) outWrap.classList.add("va-is-null");
      else outWrap.classList.remove("va-is-null");
    }
    if (outNull) outNull.hidden = !thin;
    if (outNum) outNum.hidden = thin;
    if (bridge) bridge.hidden = thin;
    if (thin) return;
    var yStr = format2(y);
    outNum.textContent = "$" + yStr;
    if (bridge && basePs > 0) {
      var pct = ((y - basePs) / basePs) * 100;
      var pctStr = signedPct(pct, 1);
      var bStr = Number(basePs).toFixed(2);
      var enEl = bridge.querySelector(".l-en");
      var zhEl = bridge.querySelector(".l-zh");
      if (enEl) {
        enEl.textContent = "Base case is $" + bStr + ". Your assumptions give $" + yStr + " (" + pctStr + "%).";
      }
      if (zhEl) {
        zhEl.textContent = "基准情景为 $" + bStr + "，你的假设得出 $" + yStr + "（" + pctStr + "%）。";
      }
    }
  }
  function applyTriple(g, m, x) {
    elG.value = String(g);
    elM.value = String(m);
    elX.value = String(x);
    paint();
  }
  elG.addEventListener("input", paint);
  elM.addEventListener("input", paint);
  elX.addEventListener("input", paint);
  var presetBtns = document.querySelectorAll("[data-va-preset]");
  for (var i = 0; i < presetBtns.length; i++) {
    presetBtns[i].addEventListener("click", function (ev) {
      var key = ev.currentTarget.getAttribute("data-va-preset");
      var p = presets[key];
      if (!p) return;
      applyTriple(p.sales_growth_pct, p.margin_delta_pp, p.earnings_multiple);
    });
  }
  var reset = document.getElementById("va-reset");
  if (reset) {
    reset.addEventListener("click", function () {
      applyTriple(sd.sales_growth_pct, sd.margin_delta_pp, sd.earnings_multiple);
    });
  }
  document.addEventListener("langchange", paint);
  paint();
})(typeof globalThis !== "undefined" ? globalThis : this);
  </script>
  <div class="mod-ft">{{ t('Research display only — not advice.', '仅供研究展示，非投资建议。') }}</div>
