/* US Signals popup. Chart modes share a row order and keep a zero/neutral reference. */
#dlg-evidence .mx5-dlg-panel { width:min(948px,calc(100% - 40px)); max-height:min(92dvh,990px); color:var(--text); background:var(--panel); }
#dlg-evidence .mx5-dlg-header { flex-shrink:0; align-items:center; padding:16px 28px; border-bottom:1px solid var(--line); background:var(--panel); }
#dlg-evidence .mx5-dlg-close { min-width:44px; min-height:44px; background:var(--panel2); color:var(--text); border:1px solid var(--line); }
#dlg-evidence .mx5-dlg-body { min-height:0; overflow:auto; overscroll-behavior:contain; padding:0 28px 18px; }
#dlg-evidence h2, #dlg-evidence h3, #dlg-evidence p, #dlg-evidence dl, #dlg-evidence dd, #dlg-evidence fieldset { margin:0; }
#dlg-evidence h2 { font-size:var(--fs-num-lg); line-height:1.2; letter-spacing:-.035em; }
#dlg-evidence .ev-kicker, #dlg-evidence .ev-axis, #dlg-evidence .ev-equation small { font:600 var(--fs-label)/1.45 var(--font-mono); color:var(--muted); }
#dlg-evidence .ev-kicker { text-transform:uppercase; letter-spacing:.07em; }
#dlg-evidence .ev-meta { display:flex; align-items:baseline; flex-wrap:wrap; gap:4px 16px; padding-top:14px; font-size:var(--fs-sm); color:var(--muted); }
#dlg-evidence .ev-meta b { color:var(--text); font-weight:600; }
#dlg-evidence .ev-flag, #dlg-evidence .ev-meta strong, #dlg-evidence .ev-cap strong { color:var(--ink-warn); }
#dlg-evidence .ev-brief { display:grid; grid-template-columns:minmax(0,1.45fr) minmax(220px,.78fr); align-items:center; gap:28px; padding:17px 0 19px; }
#dlg-evidence #ev-verdict { font-size:clamp(38px,4vw,52px); line-height:1.08; font-weight:680; letter-spacing:-.055em; }
#dlg-evidence .ev-drivers, #dlg-evidence .ev-cap, #dlg-evidence .ev-scope { margin-top:7px; font-size:var(--fs-md); line-height:1.45; max-width:52ch; overflow-wrap:anywhere; }
#dlg-evidence .ev-drivers b { font-weight:650; }
#dlg-evidence .ev-drivers small { font:600 var(--fs-sm) var(--font-mono); white-space:nowrap; }
#dlg-evidence .ev-neg small, #dlg-evidence .ev-neg.ev-impact, #dlg-evidence .ev-equation .ev-neg b { color:var(--ink-down); }
#dlg-evidence .ev-pos small, #dlg-evidence .ev-pos.ev-impact, #dlg-evidence .ev-equation .ev-pos b { color:var(--ink-up); }
#dlg-evidence .ev-cap > span { display:block; }
#dlg-evidence .ev-scope { font-size:var(--fs-sm); color:var(--muted); }
#dlg-evidence .ev-instrument { align-self:center; padding:13px 16px; border-radius:var(--r-card,12px); background:var(--panel2); }
[data-theme="light"] #dlg-evidence .ev-instrument { background:var(--panel); border:1px solid var(--line); box-shadow:var(--card-shadow); }
#dlg-evidence .ev-scoreline { display:flex; align-items:baseline; gap:6px; color:var(--muted); font-size:var(--fs-sm); }
#dlg-evidence .ev-score { font:650 var(--fs-num-xl)/1.12 var(--font-mono); color:var(--text); letter-spacing:-.07em; }
#dlg-evidence .ev-scale { display:grid; grid-template-columns:42fr 18fr 40fr; gap:2px; position:relative; margin:11px 0 7px; }
#dlg-evidence .ev-scale i { height:5px; border-radius:var(--r-pill,999px); background:var(--ink-down); opacity:.65; }
#dlg-evidence .ev-scale i:nth-child(2) { background:var(--ink-warn); }
#dlg-evidence .ev-scale i:nth-child(3) { background:var(--ink-up); }
#dlg-evidence .ev-scale b { position:absolute; top:-4px; width:3px; height:13px; transform:translateX(-50%); background:var(--text); box-shadow:0 0 0 1px var(--panel); }
#dlg-evidence .ev-scale-labels { display:flex; justify-content:space-between; flex-wrap:wrap; gap:1px 4px; font-size:var(--fs-label); color:var(--muted); }
#dlg-evidence summary { cursor:pointer; list-style:none; }
#dlg-evidence summary::-webkit-details-marker { display:none; }
#dlg-evidence summary:focus-visible, #dlg-evidence .ev-switch label:has(input:focus-visible) { outline:2px solid var(--ink-link); outline-offset:-2px; border-radius:var(--r-ctl,8px); }
#dlg-evidence .ev-tools { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:6px; padding:5px 0; border-block:1px solid var(--line); }
#dlg-evidence .ev-tools details { min-width:0; border-radius:var(--r-ctl,8px); }
#dlg-evidence .ev-tools summary, #dlg-evidence .ev-tape summary, #dlg-evidence .ev-sources summary { display:flex; align-items:center; gap:10px; padding:8px 10px; min-height:44px; font-size:var(--fs-body); font-weight:650; }
#dlg-evidence .ev-tools details[open], #dlg-evidence .ev-tools summary:hover { background:var(--panel2); }
[data-theme="light"] #dlg-evidence .ev-tools details[open], [data-theme="light"] #dlg-evidence .ev-tools summary:hover { background:var(--bg); }
#dlg-evidence .ev-plus { position:relative; flex:none; width:12px; height:12px; margin-inline-start:auto; color:var(--muted); }
#dlg-evidence .ev-plus::before, #dlg-evidence .ev-plus::after { content:""; position:absolute; left:1px; top:5px; width:10px; height:2px; background:currentColor; }
#dlg-evidence .ev-plus::after { transform:rotate(90deg); }
#dlg-evidence details[open] > summary .ev-plus::after { display:none; }
#dlg-evidence .ev-tool-body { padding:0 10px 12px; }
#dlg-evidence .ev-tool-body p, #dlg-evidence .ev-note, #dlg-evidence .ev-flag, #dlg-evidence .ev-sources p { font-size:var(--fs-sm); line-height:1.45; }
#dlg-evidence .ev-tool-body p + p { margin-top:6px; }
#dlg-evidence .ev-equation { display:flex; flex-wrap:wrap; gap:6px 14px; margin-bottom:8px; }
#dlg-evidence .ev-equation > div { display:grid; }
#dlg-evidence .ev-equation b { font:650 var(--fs-h2)/1.4 var(--font-mono); }
#dlg-evidence .ev-section { padding:18px 0 12px; }
#dlg-evidence .ev-section-head { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:5px 10px; }
#dlg-evidence #ev-factor-title { font-size:var(--fs-num-lg); line-height:1.2; letter-spacing:-.035em; }
#dlg-evidence .ev-switch { display:flex; padding:2px; border:1px solid var(--line); border-radius:var(--r-ctl,8px); background:var(--panel2); }
#dlg-evidence .ev-switch label { position:relative; display:flex; align-items:center; min-height:32px; padding:0 10px; font-weight:600; font-size:var(--fs-sm); color:var(--muted); cursor:pointer; }
#dlg-evidence .ev-switch label:has(input:checked) { color:var(--text); background:var(--panel); border-radius:var(--r-ctl,8px); box-shadow:0 0 0 1px var(--line); }
#dlg-evidence .ev-switch label:has(input:disabled) { opacity:.65; cursor:default; }
#dlg-evidence .ev-switch input, #dlg-evidence .ev-sr { position:absolute; width:1px; height:1px; clip-path:inset(50%); overflow:hidden; }
#dlg-evidence .ev-note, #dlg-evidence .ev-sources p { color:var(--muted); margin:4px 0 9px; }
#dlg-evidence .ev-factor summary, #dlg-evidence .ev-axis { display:grid; grid-template-columns:minmax(120px,1fr) minmax(72px,1.5fr) 67px 13px; column-gap:12px; align-items:center; padding:0 7px; }
#dlg-evidence .ev-axis { min-height:28px; }
#dlg-evidence .ev-axis > div { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; }
#dlg-evidence .ev-axis > div > :last-child { justify-self:end; }
#dlg-evidence .ev-axis b { font-weight:500; }
#dlg-evidence .ev-unit, #dlg-evidence .ev-impact, #dlg-evidence .ev-factor-value { text-align:end; }
#dlg-evidence .ev-ledger { border-block:1px solid var(--line); }
#dlg-evidence .ev-factor + .ev-factor { border-top:1px solid var(--line-quiet); }
#dlg-evidence .ev-factor summary { min-height:44px; }
#dlg-evidence .ev-factor[open], #dlg-evidence .ev-factor summary:hover { background:var(--panel2); }
[data-theme="light"] #dlg-evidence .ev-factor[open], [data-theme="light"] #dlg-evidence .ev-factor summary:hover { background:var(--bg); }
#dlg-evidence .ev-factor-info { display:grid; gap:2px; padding-block:6px; font-size:var(--fs-body); line-height:1.3; }
#dlg-evidence .ev-factor-info b { font-weight:600; }
#dlg-evidence .ev-plot { position:relative; width:100%; height:2px; background:var(--line-quiet); }
#dlg-evidence .ev-plot::after { content:""; position:absolute; left:50%; top:-9px; height:20px; border-inline-start:1px solid var(--muted); }
#dlg-evidence .ev-plot i { position:absolute; top:-4px; height:10px; border-radius:var(--r-pill,999px); }
#dlg-evidence .ev-lower { right:50%; background:var(--ink-down); }
#dlg-evidence .ev-higher { left:50%; background:var(--ink-up); }
#dlg-evidence .ev-impact, #dlg-evidence .ev-factor-value { font:600 var(--fs-md)/1.2 var(--font-mono); font-variant-numeric:tabular-nums; }
#dlg-evidence .ev-chevron { color:var(--muted); }
#dlg-evidence .ev-factor[open] .ev-chevron { transform:rotate(180deg); }
#dlg-evidence .ev-section:not(:has(input[value="score"]:checked)) .ev-score-only,
#dlg-evidence .ev-section:has(input[value="score"]:checked) .ev-impact-only { display:none; }
#dlg-evidence .ev-detail { padding:4px 12px 14px; font-size:var(--fs-sm); }
#dlg-evidence .ev-read { font-size:var(--fs-body); line-height:1.45; }
#dlg-evidence .ev-detail-meta { display:flex; flex-wrap:wrap; gap:4px 16px; margin:7px 0; color:var(--muted); }
#dlg-evidence .ev-detail-meta b { color:var(--text); font-variant-numeric:tabular-nums; }
#dlg-evidence .ev-metrics { display:grid; grid-template-columns:repeat(auto-fit,minmax(122px,1fr)); gap:7px 14px; }
#dlg-evidence .ev-metrics dt { color:var(--muted); font-size:var(--fs-label); }
#dlg-evidence .ev-metrics dd { font-weight:600; overflow-wrap:anywhere; }
#dlg-evidence .ev-tape, #dlg-evidence .ev-sources { font-size:var(--fs-sm); border-bottom:1px solid var(--line-quiet); }
#dlg-evidence .ev-tape[open], #dlg-evidence .ev-sources[open] { padding-bottom:12px; }
#dlg-evidence .ev-sources p { margin-top:8px; }
#dlg-evidence .mx5-dlg-mtf-tbl { width:100%; table-layout:fixed; font-size:var(--fs-sm); }
#dlg-evidence .mx5-dlg-mtf-tbl th { font-size:var(--fs-label); }
#dlg-evidence .mx5-dlg-mtf-tbl th:first-child { width:22%; }
#dlg-evidence .mx5-dlg-mtf-tbl th:last-child { width:20%; }
#dlg-evidence .mx5-dlg-mtf-tbl td { overflow-wrap:anywhere; border-color:var(--line-quiet); }
@media(max-width:700px) {
  #dlg-evidence .mx5-dlg-panel { width:100%; max-height:95dvh; }
  #dlg-evidence .mx5-dlg-header { padding:10px 16px; }
  #dlg-evidence .mx5-dlg-body { padding:0 14px 18px; }
  #dlg-evidence .ev-meta { gap:4px 10px; padding-top:9px; }
  #dlg-evidence .ev-brief { grid-template-columns:minmax(0,1fr); gap:9px; padding:12px 0; }
  #dlg-evidence #ev-verdict { font-size:var(--fs-num-xl); }
  #dlg-evidence .ev-instrument { display:grid; grid-template-columns:auto minmax(0,1fr); column-gap:12px; align-items:center; padding:8px 10px; }
  #dlg-evidence .ev-scoreline { grid-row:1/3; }
  #dlg-evidence .ev-score { font-size:var(--fs-h1); }
  #dlg-evidence .ev-scale { margin:4px 0; }
  #dlg-evidence .ev-scale-labels { font-size:var(--fs-micro); }
  #dlg-evidence .ev-tools { display:block; }
  #dlg-evidence .ev-tools summary { padding-inline:4px; }
  #dlg-evidence .ev-section { padding-top:14px; }
  #dlg-evidence .ev-switch label { min-height:44px; }
  #dlg-evidence .ev-factor summary, #dlg-evidence .ev-axis { grid-template-columns:minmax(102px,1.3fr) minmax(42px,.9fr) 49px 10px; column-gap:5px; padding-inline:2px; }
  #dlg-evidence .ev-plot i { height:8px; top:-3px; }
  #dlg-evidence .mx5-dlg-mtf-tbl th, #dlg-evidence .mx5-dlg-mtf-tbl td { padding-inline:1px; }
}
