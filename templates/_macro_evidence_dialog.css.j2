/* Evidence dialog: one dated read, then the inputs behind it. All color is semantic ink. */
#dlg-evidence .mx5-dlg-panel { width:min(960px,calc(100% - 48px)); max-height:min(90dvh,980px); background:var(--panel); color:var(--text); }
#dlg-evidence .mx5-dlg-header { align-items:center; padding:16px 26px; flex-shrink:0; background:var(--panel); }
#dlg-evidence .mx5-dlg-close { min-width:44px; min-height:44px; }
#dlg-evidence h2, #dlg-evidence h3, #dlg-evidence p, #dlg-evidence dl, #dlg-evidence dd { margin:0; }
#dlg-evidence h2 { font-size:var(--fs-num-lg); letter-spacing:-.035em; line-height:1.2; }
#dlg-evidence h3:not(.ev-kicker) { font-size:var(--fs-h2); letter-spacing:-.02em; }
#dlg-evidence .mx5-dlg-body { min-height:0; overflow-y:auto; overscroll-behavior:contain; padding:0 26px 20px; }
#dlg-evidence .ev-kicker { font:600 var(--fs-label)/1.5 var(--font-mono); letter-spacing:.06em; text-transform:uppercase; color:var(--muted); }
#dlg-evidence .ev-meta { display:flex; align-items:baseline; flex-wrap:wrap; gap:4px 18px; padding:10px 0; color:var(--muted); font-size:var(--fs-sm); }
#dlg-evidence .ev-meta b { font:600 var(--fs-sm) var(--font-mono); color:var(--text); }
#dlg-evidence .ev-meta strong, #dlg-evidence .ev-flag { color:var(--ink-warn); }
#dlg-evidence .ev-brief { display:grid; grid-template-columns:minmax(220px,.82fr) minmax(0,1fr); gap:12px 30px; align-items:center; padding:18px 20px; border:1px solid var(--line); border-radius:var(--r-card,12px); background:var(--panel2); }
[data-theme="light"] #dlg-evidence .ev-brief { background:var(--bg); box-shadow:inset 0 1px 0 var(--panel); }
#dlg-evidence .ev-scoreline { display:flex; gap:7px; align-items:baseline; color:var(--muted); font-size:var(--fs-sm); }
#dlg-evidence .ev-score { font:650 var(--fs-display)/1.18 var(--font-mono); letter-spacing:-.07em; color:var(--text); }
#dlg-evidence .ev-verdict { margin-inline-start:5px; font-size:var(--fs-h2); }
#dlg-evidence .green, #dlg-evidence .ev-pos b { color:var(--ink-up); }
#dlg-evidence .red, #dlg-evidence .ev-neg b { color:var(--ink-down); }
#dlg-evidence .yellow { color:var(--ink-warn); }
#dlg-evidence .ev-scale { display:grid; grid-template-columns:42fr 18fr 40fr; gap:2px; position:relative; margin:10px 0 6px; }
#dlg-evidence .ev-scale i { height:4px; border-radius:var(--r-pill,999px); background:var(--ink-down); opacity:.55; }
#dlg-evidence .ev-scale i:nth-child(2) { background:var(--ink-warn); }
#dlg-evidence .ev-scale i:nth-child(3) { background:var(--ink-up); }
#dlg-evidence .ev-scale b { position:absolute; top:-4px; width:3px; height:12px; transform:translateX(-50%); background:var(--text); box-shadow:0 0 0 1px var(--panel2); }
#dlg-evidence .ev-scale-labels { display:flex; justify-content:space-between; flex-wrap:wrap; gap:0 4px; color:var(--muted); font-size:var(--fs-label); }
#dlg-evidence .ev-condition p { margin-top:5px; line-height:1.45; font-size:var(--fs-md); font-weight:550; }
#dlg-evidence .ev-cap, #dlg-evidence .ev-scope { grid-column:1/-1; border-top:1px solid var(--line); padding-top:8px; font-size:var(--fs-sm); }
#dlg-evidence .ev-cap strong { color:var(--ink-warn); margin-inline-end:6px; }
#dlg-evidence .ev-cap > span:not(.l-en):not(.l-zh) { display:block; }
#dlg-evidence .ev-drivers { grid-column:1/-1; display:flex; flex-wrap:wrap; gap:6px 24px; border-top:1px solid var(--line); padding-top:10px; }
#dlg-evidence .ev-drivers > div { font-size:var(--fs-sm); }
#dlg-evidence .ev-drivers .ev-kicker { margin-inline-end:4px; }
#dlg-evidence .ev-drivers b { font-family:var(--font-mono); }
#dlg-evidence .ev-section { margin:22px 0 0; }
#dlg-evidence .ev-section-head { display:flex; justify-content:space-between; align-items:end; gap:8px; }
#dlg-evidence .ev-quiet, #dlg-evidence .ev-note { color:var(--muted); font-size:var(--fs-sm); line-height:1.4; }
#dlg-evidence .ev-note { margin:4px 0 10px; }
#dlg-evidence .ev-ledger { border-block:1px solid var(--line); }
#dlg-evidence .ev-factor + .ev-factor { border-top:1px solid var(--line-quiet); }
#dlg-evidence summary { cursor:pointer; list-style:none; }
#dlg-evidence summary::-webkit-details-marker { display:none; }
#dlg-evidence summary:focus-visible { outline:2px solid var(--ink-link); outline-offset:-2px; border-radius:var(--r-ctl,8px); }
#dlg-evidence .ev-factor summary { display:grid; grid-template-columns:minmax(0,1fr) 110px 78px 16px; align-items:center; gap:14px; min-height:52px; padding:8px 8px; }
#dlg-evidence .ev-factor[open], #dlg-evidence .ev-factor summary:hover { background:var(--panel2); }
[data-theme="light"] #dlg-evidence .ev-factor[open], [data-theme="light"] #dlg-evidence .ev-factor summary:hover { background:var(--bg); }
#dlg-evidence .ev-factor-info { display:grid; gap:2px; }
#dlg-evidence .ev-factor-info > b { font-size:var(--fs-body); line-height:1.25; }
#dlg-evidence .ev-read, #dlg-evidence .ev-flag { font-size:var(--fs-sm); line-height:1.35; }
#dlg-evidence .ev-read { color:var(--muted); }
#dlg-evidence .ev-factor-value, #dlg-evidence .ev-impact { display:grid; gap:1px; align-content:center; font:600 var(--fs-md)/1.2 var(--font-mono); font-variant-numeric:tabular-nums; }
#dlg-evidence .ev-factor-value { grid-template-columns:1fr auto; align-items:center; gap:2px 7px; }
#dlg-evidence .ev-factor-value .ev-kicker { grid-column:1/-1; }
#dlg-evidence .ev-track { display:block; position:relative; height:4px; background:var(--line); border-radius:var(--r-pill,999px); }
#dlg-evidence .ev-track::before { content:""; position:absolute; left:50%; height:8px; top:-2px; border-inline-start:1px solid var(--muted); }
#dlg-evidence .ev-track i { position:absolute; height:100%; border-radius:var(--r-pill,999px); background:var(--text); }
#dlg-evidence .ev-impact { text-align:end; }
#dlg-evidence .ev-chevron, #dlg-evidence .ev-sources summary > span:last-child { color:var(--muted); display:inline-block; }
#dlg-evidence details[open] > summary .ev-chevron, #dlg-evidence .ev-sources[open] summary > span:last-child { transform:rotate(180deg); }
#dlg-evidence .ev-detail, #dlg-evidence .ev-sources { font-size:var(--fs-sm); line-height:1.5; }
#dlg-evidence .ev-detail { padding:2px 10px 12px; }
#dlg-evidence .ev-metrics { display:grid; grid-template-columns:repeat(auto-fit,minmax(118px,1fr)); gap:8px 14px; padding-top:7px; }
#dlg-evidence .ev-metrics dt { color:var(--muted); font-size:var(--fs-label); }
#dlg-evidence .ev-metrics dd { font-weight:650; overflow-wrap:anywhere; }
#dlg-evidence .mx5-dlg-mtf-tbl { width:100%; table-layout:fixed; font-size:var(--fs-sm); }
#dlg-evidence .mx5-dlg-mtf-tbl th { font-size:var(--fs-label); }
#dlg-evidence .mx5-dlg-mtf-tbl th:first-child { width:22%; }
#dlg-evidence .mx5-dlg-mtf-tbl th:last-child { width:20%; }
#dlg-evidence .mx5-dlg-mtf-tbl td { overflow-wrap:anywhere; border-color:var(--line-quiet); }
#dlg-evidence .ev-sources { margin-top:16px; border-top:1px solid var(--line); }
#dlg-evidence .ev-sources summary { display:flex; align-items:center; gap:8px; min-height:44px; font-weight:650; }
#dlg-evidence .ev-sources p { color:var(--muted); margin-top:8px; }
#dlg-evidence .ev-sr { position:absolute; width:1px; height:1px; clip-path:inset(50%); overflow:hidden; }
@media (max-width:700px) {
  #dlg-evidence .mx5-dlg-panel { width:100%; max-height:94dvh; }
  #dlg-evidence .mx5-dlg-header { padding:12px 16px; }
  #dlg-evidence .mx5-dlg-body { padding:0 14px 18px; }
  #dlg-evidence .ev-brief { grid-template-columns:minmax(0,1fr); padding:14px; gap:12px; }
  #dlg-evidence .ev-condition { border-top:1px solid var(--line); padding-top:9px; }
  #dlg-evidence .ev-section-head { display:block; }
  #dlg-evidence .ev-factor summary { grid-template-columns:minmax(0,1fr) 42px 59px 10px; gap:7px; padding:10px 2px; }
  #dlg-evidence .ev-factor-value { display:grid; grid-template-columns:1fr; text-align:end; }
  #dlg-evidence .ev-track { display:none; }
  #dlg-evidence .ev-quiet { display:none; }
  #dlg-evidence .mx5-dlg-mtf-tbl th, #dlg-evidence .mx5-dlg-mtf-tbl td { padding-inline:1px; }
}
