{% extends "_gmi_base.html.j2" %}
{% from "_gmi_macros.html.j2" import t, ic with context %}
{% from "_gmi_head.html.j2" import head %}
{% block title %}GMI Explorer — State reference{% endblock %}
{% block head_extra %}<meta name="robots" content="noindex">{% endblock %}
{% block body %}
{{ head([('Research','研究'),('Reference','参考')], 'State reference', '状态参考', 'Examples of clear feedback when research is incomplete or unavailable.', '研究不完整或不可用时的清晰反馈示例。') }}
<p class="gmi-note">{{ t('Design reference only. These examples do not report live incidents or imply unavailable services exist.', '仅供设计参考。这些示例并非实时故障报告，也不表示未提供的服务已经存在。') }}</p>
<div class="gmi-state-reference">
{% for key, en, zh, body_en, body_zh in [
('loading','Opening research','正在打开研究','Keep the page structure visible and announce progress.','保留页面结构，并告知进度。'),
('empty','No company evidence yet','暂无公司证据','The topic is mapped. No company connection has been published here.','此主题已列入体系，但尚未在此发布公司关联。'),
('fetch_failed','Research could not load','研究内容未能加载','Keep the last rendered answer available. Offer the full index as a working alternative.','保留已呈现的答案，并提供可用的完整索引。'),
('stale','Older snapshot','快照较旧','Show the actual snapshot date beside the content. Source publication dates remain separate.','在内容旁显示实际快照日期，并单独保留来源发布日期。'),
('rights_withheld','Publication clearance pending','待获得发布许可','Withhold the affected records and search payloads. Theme research remains available.','暂不输出受影响的记录及搜索数据。主题研究仍可使用。'),
('purpose_denied','This view is restricted','此视图受限','Explain the actual access restriction. Do not imply a sign-in will solve a publication restriction.','说明实际访问限制。不要暗示登录即可解决发布限制。'),
('source_paused','Source verification paused','来源核验暂停','Show the verified scope and explain what cannot currently be established.','显示已核实的范围，并说明目前无法证实的信息。'),
('unknown','Not recorded','未记录','Distinguish a missing record from a source that explicitly says not disclosed.','区分尚未记录与来源明确表示未披露。'),
('read_updated','Snapshot updated','快照已更新','Use the actual generation date. Never imply an older source is a new announcement.','使用实际生成日期。不要将旧来源呈现为新公告。'),
('path_template','Research path','研究路径','A taxonomy path describes research structure. It does not establish a company relationship.','分类路径描述研究结构，并不证明公司间存在关系。'),
('success','Link copied','链接已复制','Confirm only after the clipboard succeeds. Offer a selectable address when copying fails.','仅在剪贴板操作成功后确认；失败时提供可选取的地址。') ] %}
<article data-gmi-state="{{ key }}"><h2>{{ t(en,zh) }}</h2><p>{{ t(body_en,body_zh) }}</p></article>
{% endfor %}
</div>
<a class="gmi-action-secondary" href="{{ nav_prefix }}gmi.html">{{ t('Return to research', '返回研究') }}{{ ic('arrow',16) }}</a>
{% endblock %}
