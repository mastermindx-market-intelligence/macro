{# ABX3: one context-free escaped renderer for all lenses and dialogs. #}
{% macro _split(s) -%}{% autoescape true %}
{%- if s is string -%}
{%- if ':' in s -%}<b>{{ s.split(':', 1)[0] }}</b>:{{ s.split(':', 1)[1] }}
{%- elif '：' in s -%}<b>{{ s.split('：', 1)[0] }}</b>：{{ s.split('：', 1)[1] }}
{%- else -%}{{ s }}{%- endif -%}{%- endif -%}
{% endautoescape %}{%- endmacro %}
{% macro _copy(en, zh=none, split=false) -%}{% autoescape true %}
<span class="l-en">{% if split %}{{ _split(en) }}{% elif en is string %}{{ en }}{% endif %}</span><span class="l-zh">{% set z = zh if zh is string and zh|trim else en %}{% if split %}{{ _split(z) }}{% elif z is string %}{{ z }}{% endif %}</span>
{% endautoescape %}{%- endmacro %}
{% macro _items(values, translations=none, watch=false) -%}{% autoescape true %}
{%- if values is sequence and values is not string and values is not mapping -%}
<ul class="{{ 'aib2-watch' if watch else 'aib2-items' }}">
{%- for value in values -%}{%- if value is string and value|trim -%}
{%- set z = translations[loop.index0] if translations is sequence and translations is not string and loop.index0 < translations|length else none -%}
<li class="{{ 'aib2-watch-row' if watch else 'aib2-item' }}">{{ _copy(value, z, true) }}</li>
{%- endif -%}{%- endfor -%}</ul>{%- endif -%}
{% endautoescape %}{%- endmacro %}

{% macro aibrief_body(brief, lens='macro', show_catalysts=false) %}{% autoescape true %}
{%- set b = brief if brief is mapping else {} -%}
{%- set zh = b.get('zh') if b.get('zh') is mapping else {} -%}
{%- set titles = {'macro': ['Cross-asset outlook', '跨资产观察'], 'china': ['China & Hong Kong', '中国与香港'], 'btc': ['Bitcoin outlook', '比特币观察']} -%}
{%- set title = titles.get(lens, titles['macro']) -%}
{%- set source = b.get('state_asof') if b.get('state_asof') is string else '' -%}
{%- set generated = b.get('generated_at') if b.get('generated_at') is string else '' -%}
{%- set cadence = b.get('refresh_days') if b.get('refresh_days') is number and b.get('refresh_days') is not boolean and 1 <= b.get('refresh_days') <= 7 else none -%}
{%- set tldr = b.get('tldr') if b.get('tldr') is sequence and b.get('tldr') is not string and b.get('tldr') is not mapping else [] -%}
{%- set tldr_zh = zh.get('tldr') if zh.get('tldr') is sequence and zh.get('tldr') is not string else [] -%}
{%- set ns = namespace(stance=none, stance_zh=none, stance_index=-1) -%}
{%- for line in tldr -%}{%- if line is string and line.startswith('What to do:') -%}
{%- set rest = line.split(':', 1)[1]|trim -%}
{%- if rest in ['Act','Get ready',"Watch — don't chase",'Protect gains','Stand aside','Ignore'] or rest.startswith(('Act ', 'Act·', 'Get ready ', 'Watch ', 'Protect gains ', 'Stand aside ', 'Ignore ')) -%}
{%- set ns.stance = rest -%}{%- set ns.stance_index = loop.index0 -%}
{%- set ns.stance_zh = tldr_zh[loop.index0] if loop.index0 < tldr_zh|length else none -%}
{%- endif -%}{%- endif -%}{%- endfor -%}
<div class="aib2" data-lens="{{ lens }}" data-aib-source="{{ source }}" data-aib-generated="{{ generated }}" data-aib-cadence="{{ cadence or '' }}">
  <header class="aib2-hdr">
    <div class="aib2-hdr-meta">
      <div class="aib2-kicker">{{ _copy('RESEARCH BRIEF', '研究简报') }}</div>
      <h3 class="aib2-hdr-title">{{ _copy(title[0], title[1]) }}</h3>
      <div class="aib2-hdr-sub">
        <span>{{ _copy('Source date', '数据日期') }} <time>{{ source or '—' }}</time></span>
        {% if generated %}<span>{{ _copy('Written', '撰写于') }} <time data-aib-written>{{ generated }}</time></span>{% endif %}
        {% if cadence %}<span class="aib2-cadence">{{ _copy('Scheduled daily' if cadence == 1 else 'Scheduled every ' ~ cadence ~ ' days', '计划每日更新' if cadence == 1 else '计划每' ~ cadence ~ '天更新') }}</span>{% endif %}
      </div>
    </div>
    <span class="aib2-badge">{{ _copy('A read-through of existing signals — not a signal source', '仅为现有信号的汇总解读 — 非独立信号源') }}</span>
  </header>
  <div class="aib2-freshness" role="status" data-aib-freshness>{{ _copy('Freshness not verified. Check the source date before using this read.', '时效性尚未核实，请先查看数据日期。') }}</div>
  {% set attempt = b.get('last_attempt') if b.get('last_attempt') is mapping else {} %}
  {% if attempt.get('status') == 'retained' %}
  <div class="aib2-degraded">{{ _copy('The latest refresh did not produce a usable brief. This is the last valid edition, with its original dates.', '最新更新未生成可用简报，当前保留上期有效版本及原日期。') }}</div>
  {% elif b.get('degraded_reason') %}
  <div class="aib2-degraded">{{ _copy('This edition is incomplete. Available research remains below; verify it against the source dashboards.', '本期内容不完整，以下保留可用研究，请对照源看板核实。') }}</div>
  {% endif %}
  <section class="aib2-opening">
    <h3 class="aib2-sec-label">{{ _copy('The market read', '今日判断') }}</h3>
    {% if b.get('summary') is string and b.get('summary')|trim %}<p class="aib2-lead">{{ _copy(b.get('summary'), zh.get('summary')) }}</p>{% endif %}
    <ul class="aib2-gist-list">{% for line in tldr %}{% if line is string and line|trim and loop.index0 != ns.stance_index %}
      <li>{{ _copy(line, tldr_zh[loop.index0] if loop.index0 < tldr_zh|length else none, true) }}</li>
    {% endif %}{% endfor %}</ul>
    {% if ns.stance %}<div class="aib2-stance aib2-stance--neutral"><span class="aib2-eyebrow">{{ _copy('Research posture', '研究立场') }}</span><div class="aib2-stance-body">{{ _copy(ns.stance, ns.stance_zh) }}</div></div>{% endif %}
    {% if not b.get('summary') and not tldr and not b.get('regime_read') %}<p class="aib2-empty">{{ _copy('A usable synthesis is not available. Open the source dashboards for the underlying readings.', '暂无可用综合解读，请打开源看板查看底层读数。') }}</p>{% endif %}
    {% set conf = b.get('confidence') %}
    {% set conf_en = {'low':'Low','medium':'Medium','high':'High'}.get(conf) if conf is string else none %}
    {% set conf_zh = {'low':'低','medium':'中','high':'高'}.get(conf) if conf is string else none %}
    <div class="aib2-conf"><span>{{ _copy('Synthesis confidence', '综合判断把握') }}</span><strong>{{ _copy(conf_en or 'Not assessed', conf_zh or '未评估') }}</strong><span class="aib2-conf-note">{{ _copy('Qualitative assessment, not a probability', '定性评价，非概率') }}</span></div>
  </section>
  {% set change = b.get('reading_changes') if b.get('reading_changes') is mapping else {} %}
  <section class="aib2-section"><h3 class="aib2-sec-label">{{ _copy('What changed', '与上期相比') }}</h3>
    {% if change.get('status') == 'compared' and change.get('rows') is sequence and change.get('rows') is not string %}
    <p class="aib2-meta">{{ change.get('previous_asof') }} → {{ change.get('current_asof') }}</p>
    {% if change.get('rows') %}<ul class="aib2-items">{% for row in change.get('rows') %}{% if row is mapping %}<li><b>{{ _copy(row.get('label_en'), row.get('label_zh')) }}</b> {{ _copy(row.get('previous_en'), row.get('previous_zh')) }} → {{ _copy(row.get('value_en'), row.get('value_zh')) }}</li>{% endif %}{% endfor %}</ul>
    {% else %}<p class="aib2-meta">{{ _copy('The comparable underlying readings are unchanged. This does not mean the market is unchanged.', '可比底层读数未变，不代表市场没有变化。') }}</p>{% endif %}
    {% else %}<p class="aib2-meta">{{ _copy('No comparable previous edition is available. Changes cannot be established.', '缺少可比上期简报，无法确认变化。') }}</p>{% endif %}
  </section>
  {% set facts = b.get('key_facts') if b.get('key_facts') is sequence and b.get('key_facts') is not string else [] %}
  {% if facts %}<section class="aib2-section"><h3 class="aib2-sec-label">{{ _copy('Underlying readings', '底层读数') }}</h3>
    <dl class="aib2-kf-rail">{% for fact in facts %}{% if fact is mapping and fact.get('value_en') is string %}
      {% set tone = fact.get('tone') if fact.get('tone') in ['good','warn','bad','neutral','info'] else 'neutral' %}
      <div class="aib2-kf aib2-kf--{{ tone }}"><dt class="aib2-kf-k">{{ _copy(fact.get('label_en'), fact.get('label_zh')) }}</dt><dd class="aib2-kf-v">{% set legacy_zh = {'Normal':'正常','Risk-On':'偏积极','Risk-Off':'避险','Banks':'银行','AI / semis':'人工智能 / 半导体','Growth-Scare':'增长恐慌','Growth-scare':'增长恐慌','Growth scare':'增长恐慌'} %}{% set vz = fact.get('value_zh') %}{{ _copy(fact.get('value_en'), legacy_zh.get(fact.get('value_en'), vz) if not vz or vz == fact.get('value_en') else vz) }}</dd></div>
    {% endif %}{% endfor %}</dl>
  </section>{% endif %}
  {% if b.get('watch_items') is sequence and b.get('watch_items') is not string and b.get('watch_items') %}
  <section class="aib2-section aib2-watch-section"><h3 class="aib2-sec-label">{{ _copy('What to watch', '接下来关注') }}</h3>{{ _items(b.get('watch_items'), zh.get('watch_items'), true) }}</section>{% endif %}
  <section class="aib2-section"><h3 class="aib2-sec-label">{{ _copy('Test the thesis', '检验判断') }}</h3>
    <div class="aib2-grid"><div class="aib2-card aib2-card--conflicts"><h4 class="aib2-eyebrow">{{ _copy('Where signals disagree', '信号分歧') }}</h4>
      {% if b.get('conflicts') is sequence and b.get('conflicts') is not string and b.get('conflicts') %}{{ _items(b.get('conflicts'), zh.get('conflicts')) }}{% else %}<p class="aib2-meta">{{ _copy('No disagreement analysis is available. Agreement is not established.', '暂无分歧分析，不能据此认定信号一致。') }}</p>{% endif %}
    </div>{% if b.get('transmission') is sequence and b.get('transmission') is not string and b.get('transmission') %}<div class="aib2-card aib2-card--tx"><h4 class="aib2-eyebrow">{{ _copy('Possible spillovers', '可能传导') }}</h4>{{ _items(b.get('transmission'), zh.get('transmission')) }}</div>{% endif %}</div>
    {% if b.get('rotation_check') is string and b.get('rotation_check')|trim %}<div class="aib2-card aib2-card--playbook"><h4 class="aib2-eyebrow">{{ _copy('Playbook check', '剧本对照') }}</h4><p class="aib2-prose">{{ _copy(b.get('rotation_check'), zh.get('rotation_check')) }}</p></div>{% endif %}
  </section>
  {% if b.get('regime_read') is string and b.get('regime_read')|trim %}<details class="aib2-details"><summary>{{ _copy('Read the reasoning', '查看完整推理') }}<span>{{ _copy('Regime, drivers and uncertainty', '周期、驱动与不确定性') }}</span></summary><div class="aib2-regime">{{ _copy(b.get('regime_read'), zh.get('regime_read')) }}</div></details>{% endif %}
  {% set events = b.get('forward_watch') if b.get('forward_watch') is sequence and b.get('forward_watch') is not string else [] %}
  {% if show_catalysts and events %}<details class="aib2-details"><summary>{{ _copy('Edition calendar', '本期日程') }}<span>{{ _copy('Dates recorded when this brief was written', '简报撰写时记录的日期') }}</span></summary>
    <ul class="aib2-events">{% for event in events %}{% if event is mapping and event.get('date') is string and event.get('label') is string %}<li data-aib-event-date="{{ event.get('date') }}"><time>{{ event.get('date') }}</time><span>{{ event.get('label') }}</span><span class="aib2-event-state"></span></li>{% endif %}{% endfor %}</ul>
    {% if b.get('forward_read') is string %}<p class="aib2-prose">{{ _copy(b.get('forward_read'), zh.get('forward_read')) }}</p>{% endif %}
  </details>{% endif %}
  {% if b.get('degraded_reason') is string %}<details class="aib2-details"><summary>{{ _copy('Edition limitations', '本期限制') }}</summary><p class="aib2-meta">{{ b.get('degraded_reason') }}</p></details>{% endif %}
  {{ caller() if caller is defined else '' }}
</div>
{% endautoescape %}{% endmacro %}
