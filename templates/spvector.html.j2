<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% include "_interfonts.html.j2" %}
<script>try{var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',t||'dark');var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>S&amp;P 500 / T-bill model allocation — Mastermind</title>
{% set seo_title = "US Allocation Strategy: S&P Vector — Mastermind" %}{% set seo_desc = "Mechanical S&P 500 and T-bill model allocation, source dates, historical study and recorded shadow assessment." %}{% set seo_path = "spvector.html" %}
{% include "_seo_head.html.j2" %}
{% include '_plotly_head.html.j2' %}
<style>
:root{
  --blue:{{C.blue}}; --indigo:{{C.indigo}}; --r2:{{C.r2}}; --r3:{{C.r3}}; --ink:{{C.ink}};
  --text:{{C.text}}; --muted:{{C.muted}}; --faint:{{C.faint}}; --red:{{C.red}}; --amber:{{C.amber}};
  --grid:{{C.grid}}; --card:{{C.card}}; --bg:{{C.bg}}; --green:#1FA971;
}
*{box-sizing:border-box}
html:not([data-lang="zh"]) .l-zh{display:none}
html[data-lang="zh"] .l-en{display:none}
html[data-lang="zh"] body{font-family:"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",Inter,sans-serif}
body{margin:0;padding-top:18px;background:var(--bg);color:var(--text);font-family:Inter,sans-serif;font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px 60px}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:18px 0 14px;border-bottom:1px solid var(--grid);margin-bottom:24px;position:sticky;top:0;background:var(--bg);z-index:20}
/* unified primary nav — congruent with the macro dashboard (pill links, hover
   dropdowns, animated EN/中文 toggle, dark/light switch). Charts re-theme via
   theme.js (themeCharts) on load + toggle; trace colours are theme-neutral. */
.nav-links{display:flex;align-items:center;gap:2px;flex-wrap:wrap}
a.nav-link{padding:7px 11px;border-radius:9px;font-size:13.5px;font-weight:500;color:var(--muted);text-decoration:none;white-space:nowrap;transition:color .18s,background .18s}
a.nav-link:hover,a.nav-link.active{color:var(--ink);background:#eef1f6}
.nav-dd{position:relative;display:inline-flex}
.nav-dd>a.nav-link .caret{display:inline-block;margin-left:3px;font-size:9px;opacity:.6;transition:transform .2s}
.nav-dd:hover>a.nav-link .caret,.nav-dd:focus-within>a.nav-link .caret{transform:rotate(180deg)}
.nav-dd::after{content:"";position:absolute;left:0;right:0;top:100%;height:9px}
.nav-dd-menu{position:absolute;top:calc(100% + 7px);left:0;min-width:218px;background:var(--card);border:1px solid var(--grid);border-radius:13px;box-shadow:0 12px 34px rgba(16,24,40,.14);padding:6px;opacity:0;visibility:hidden;transform:translateY(-6px);transition:opacity .18s ease,transform .18s ease,visibility .18s;z-index:70}
.nav-dd:hover>.nav-dd-menu,.nav-dd:focus-within>.nav-dd-menu{opacity:1;visibility:visible;transform:translateY(0)}
.nav-dd-menu a{display:block;padding:9px 12px;border-radius:9px;font-size:13.5px;font-weight:600;color:var(--text);text-decoration:none;white-space:nowrap;transition:background .15s,color .15s}
.nav-dd-menu a .d{display:block;font-size:11.5px;font-weight:400;color:var(--muted);margin-top:2px}
.nav-dd-menu a:hover,.nav-dd-menu a.active{background:#eef1f6;color:var(--ink)}
.nav-ctrls{display:flex;align-items:center;gap:10px;flex:none}
.nav-ctrls .ai-brief-link{display:inline-flex;align-items:center;gap:5px;white-space:nowrap;flex:none;padding:5px 12px;border-radius:999px;background:var(--card);border:1px solid var(--grid);color:var(--text);font-size:12.5px;font-weight:600;line-height:1;text-decoration:none;transition:border-color .15s,color .15s}
.nav-ctrls .ai-brief-link:hover{border-color:var(--blue);color:var(--ink-link, var(--blue))}
.lang-toggle{display:inline-flex;position:relative;background:#eef1f6;border:1px solid var(--grid);border-radius:999px;padding:3px;cursor:pointer;flex:none}
.lang-toggle .pill{position:absolute;top:3px;left:3px;width:calc(50% - 3px);height:calc(100% - 6px);border-radius:999px;background:var(--blue);transition:transform .34s cubic-bezier(.34,1.4,.5,1)}
html[data-lang="zh"] .lang-toggle .pill{transform:translateX(100%)}
.lang-toggle .opt{position:relative;z-index:1;min-width:28px;text-align:center;padding:3px 9px;font-size:11.5px;font-weight:600;color:var(--muted);transition:color .25s;user-select:none}
html:not([data-lang="zh"]) .lang-toggle .en-opt{color:#fff}
html[data-lang="zh"] .lang-toggle .zh-opt{color:#fff}
/* animated dark / light switch — light = knob right + sun, dark = knob left + moon */
.theme-switch{width:56px;height:27px;border-radius:999px;background:#eef1f6;border:1px solid var(--grid);position:relative;cursor:pointer;padding:0;flex:none}
.theme-switch .ic{position:absolute;top:50%;transform:translateY(-50%);font-size:10.5px;opacity:.5;line-height:1}
.theme-switch .ic.sun{right:8px}.theme-switch .ic.moon{left:8px}
.theme-switch .knob{position:absolute;top:2px;left:2px;width:22px;height:22px;border-radius:50%;background:var(--blue);display:flex;align-items:center;justify-content:center;font-size:11px;box-shadow:0 2px 5px rgba(0,0,0,.3);transform:translateX(29px);transition:transform .34s cubic-bezier(.34,1.45,.5,1),background .3s}
.theme-switch .knob::before{content:"☀️"}
/* dark mode — html[data-theme="dark"] (the page default); :root above is the light state */
html[data-theme="dark"]{--bg:#0f1115;--card:#181b21;--grid:#2a2f3a;--ink:#e8edf4;--text:#d7dce3;--muted:#8b93a1;--faint:#828b9c;--red:#e06464}
html[data-theme="dark"] a.nav-link:hover,html[data-theme="dark"] a.nav-link.active{background:#222732}
html[data-theme="dark"] .nav-dd-menu a:hover,html[data-theme="dark"] .nav-dd-menu a.active{background:#222732}
html[data-theme="dark"] .lang-toggle{background:#222732}
html[data-theme="dark"] .theme-switch{background:#222732}
html[data-theme="dark"] .theme-switch .knob{transform:translateX(0);background:#e8c15a}
html[data-theme="dark"] .theme-switch .knob::before{content:"🌙"}
html[data-theme="dark"] .riskbar{background:repeating-linear-gradient(90deg,#222732,#222732 24px,#2a2f3a 24px,#2a2f3a 25px)}
html[data-theme="dark"] .gtable td.cur{background:#1b2740}
html[data-theme="dark"] .score .s>div{background:var(--grid)}
.grid{display:grid;gap:18px}
.cols-2{grid-template-columns:1.05fr .95fr}
.cols-3{grid-template-columns:repeat(3,1fr)}
.cols-4{grid-template-columns:repeat(4,1fr)}
@media(max-width:900px){.cols-2,.cols-3,.cols-4{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--grid);border-radius:16px;padding:22px}
.card h3{margin:0 0 14px;font-size:18px;font-weight:700;color:var(--ink)}
.sub{color:var(--muted);font-size:13px} .faint{color:var(--faint)}
.section-title{font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin:30px 4px 12px}
.h1{font-size:30px;font-weight:800;color:var(--ink);letter-spacing:-.02em;margin:6px 0 2px}
.tag{display:inline-block;background:#FFF4E0;color:#8a5a00;border-radius:8px;padding:3px 10px;font-size:12.5px;font-weight:700}
.allocbar{height:54px;border-radius:12px;overflow:hidden;display:flex;font-weight:700;color:#fff;margin:12px 0 4px}
.allocbar div{display:flex;align-items:center;justify-content:center;gap:8px;font-size:13.5px;min-width:0}
.seg-spy{background:linear-gradient(90deg,#4a86ff,var(--blue))}
.seg-cash{background:linear-gradient(90deg,#cfd4dc,#9aa4b2)}
.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:12px;color:var(--muted);margin-top:6px}
.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:middle}
.dialwrap{display:flex;align-items:center;gap:18px;margin-top:2px}
.dialnum{font-size:54px;font-weight:800;line-height:1;letter-spacing:-.02em}
.pill{display:inline-block;padding:5px 12px;border-radius:9px;font-weight:700;font-size:13px;color:#fff}
.mini{margin-top:8px}
.mini .lab{display:flex;justify-content:space-between;font-size:13px;color:var(--muted);padding:6px 0;border-top:1px solid var(--grid)}
.mini .lab b{color:var(--ink)}
.riskbar{height:26px;border-radius:8px;overflow:hidden;display:flex;background:repeating-linear-gradient(90deg,#f0f2f6,#f0f2f6 24px,#e9ecf1 24px,#e9ecf1 25px);border:1px solid var(--grid);margin:8px 0}
.riskbar div{height:100%}
.legtbl{width:100%;border-collapse:collapse;font-size:13px;margin-top:10px}
.legtbl td,.legtbl th{padding:7px 8px;border-bottom:1px solid var(--grid);text-align:right}
.legtbl td.l,.legtbl th.l{text-align:left}
.legtbl .dot{display:inline-block;width:9px;height:9px;border-radius:3px;margin-right:7px;vertical-align:middle}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.chip{display:inline-block;padding:5px 11px;border-radius:9px;font-weight:700;font-size:12.5px;border:1px solid var(--grid)}
.gtable{width:100%;border-collapse:collapse;font-size:13px;margin-top:6px}
.gtable td,.gtable th{padding:9px 8px;border:1px solid var(--grid);text-align:center}
.gtable th{background:var(--bg);color:var(--muted);font-weight:600;font-size:12px}
.gtable td.rh{text-align:left;font-weight:700;color:var(--ink);background:var(--bg)}
.gtable td.cur{background:#E8EEFF;font-weight:700;color:var(--ink);outline:2px solid var(--blue)}
.score .s{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:4px}
.score .s>div{background:var(--bg);border-radius:10px;padding:12px;text-align:center}
.score .k{font-size:11px;color:var(--muted);text-transform:uppercase;font-weight:600}
.score .v{font-size:21px;font-weight:800;color:var(--ink)}
.score .v small{font-size:12px;font-weight:600;color:var(--muted)}
.win{color:var(--ink-ok, var(--green))} .lose{color:var(--ink-act, var(--red))}
.tbl{width:100%;border-collapse:collapse;font-size:13.5px}
.tbl td,.tbl th{padding:7px 10px;border-bottom:1px solid var(--grid);text-align:left}
.tbl td.n{text-align:right;font-variant-numeric:tabular-nums}
.note{border-left:3px solid var(--amber);padding:6px 0 6px 14px;margin:8px 0;color:var(--text);font-size:13.5px}
.note.r{border-color:var(--red)} .note.b{border-color:var(--blue)}
.foot{margin-top:34px;padding-top:18px;border-top:1px solid var(--grid);font-size:12px;color:var(--faint);line-height:1.7}
/* zh 红涨绿跌 directional colour flips */
html[data-lang="zh"] .win{color:var(--ink-act, var(--red))}
html[data-lang="zh"] .lose{color:var(--ink-ok, var(--green))}
</style>
{% include "_state_inks.html.j2" %}{% include "_vector_polish.html.j2" %}
<style>
/* D06: quiet materials, one primary allocation, and readable depth. */
html body::before{display:none}
.wrap{max-width:1220px;padding:28px 28px 64px}
.wrap .grid>*{min-width:0}
.wrap .h1{font-size:clamp(27px,3vw,38px);line-height:1.2;margin:6px 0 12px;font-weight:650;letter-spacing:-.035em}
.wrap .section-title{font-size:12px;margin:28px 0 12px;letter-spacing:.06em}
.wrap .card{border-radius:var(--r-card,12px);padding:24px;box-shadow:none;background:var(--card)}
.wrap .card h2,.wrap .card h3{font-size:17px;font-weight:600;margin:0 0 12px}
.wrap .tag{background:transparent;color:var(--muted);padding:8px 0;font-weight:400}
.wrap .allocbar{height:12px;border-radius:var(--r-ctl,8px);margin:18px 0 10px}
.wrap .seg-spy{background:var(--blue)}.wrap .seg-cash{background:var(--muted)}
.wrap .allocation-number{font-size:64px;font-weight:600;letter-spacing:-.05em;line-height:1.05;color:var(--ink)}
.wrap .allocation-number small{font-size:16px;letter-spacing:0;font-weight:500}
.wrap .allocation-split{display:flex;align-items:baseline;gap:24px;flex-wrap:wrap;margin:18px 0 8px}
.wrap .cash-number{font-size:24px;font-weight:500;color:var(--muted)}
.wrap .source-line{font-size:12px;color:var(--muted);line-height:1.65;margin-top:10px}
.wrap .dialnum{font-size:44px;font-weight:600}
.wrap .pill{background:transparent!important;color:var(--text);padding:0;font-size:14px}
.wrap .chips{gap:8px;margin-top:16px}
.wrap .chip{font-size:12px;font-weight:400;padding:6px 10px;border-radius:var(--r-ctl,8px)}
.wrap .chip b{font-weight:600}
.wrap .note{border:0;background:var(--bg);padding:14px 16px;border-radius:var(--r-ctl,8px);line-height:1.6}
.wrap .spv-details{margin-top:16px;border:1px solid var(--grid);border-radius:var(--r-btn,10px);padding:0 18px;background:var(--card)}
.wrap .spv-details>summary{min-height:52px;display:list-item;align-content:center;cursor:pointer;font-weight:600;padding:14px 0;color:var(--ink)}
.wrap .spv-details[open]{padding-bottom:20px}
.wrap .spv-details .section-title:first-of-type{margin-top:10px}
.wrap .table-scroll{overflow-x:auto;max-width:100%;overscroll-behavior-inline:contain}
.wrap .legtbl{min-width:580px}.wrap .gtable{min-width:410px}.wrap .tbl{min-width:350px}
.wrap .legtbl th{font-weight:500;line-height:1.4}
.wrap .range-controls{display:flex;gap:6px;flex-wrap:wrap;margin:12px 0 4px}
.wrap .range-controls button{min-width:52px;min-height:44px;padding:8px 12px;border:1px solid var(--grid);border-radius:var(--r-ctl,8px);background:var(--card);color:var(--muted);font:inherit;font-size:13px;cursor:pointer}
.wrap .range-controls button[aria-pressed="true"]{background:var(--bg);color:var(--ink);border-color:var(--blue);font-weight:600}
.wrap .range-controls button:disabled{opacity:.55;cursor:default}
.wrap :is(button,a,summary,[tabindex]):focus-visible{outline:2px solid var(--blue);outline-offset:3px}
.wrap .js-plotly-plot{max-width:100%}
.wrap #spv-study > .spv-plot > .section-title,.wrap #spv-study > .spv-plot > .card > .sub{display:none}
.wrap #spv-study > .spv-plot > .card{padding:0;border:0;border-radius:0;box-shadow:none;background:transparent}
.wrap blockquote{margin:12px 0;padding:12px 16px;border:1px solid var(--grid);border-radius:var(--r-ctl,8px);font-size:13px;color:var(--muted);overflow-wrap:anywhere}
.wrap .shadow-state{font-weight:600;color:var(--ink)}
.wrap .study-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap}
.wrap .score .v{font-weight:600}
@media(max-width:640px){
 .wrap{padding:20px 16px 48px}.wrap .card{padding:18px 14px}
 .wrap .allocation-number{font-size:54px}.wrap .spv-details{padding-left:12px;padding-right:12px}
 .wrap .dialwrap{gap:14px;align-items:flex-start}.wrap .dialnum{font-size:38px}
 .wrap .grid{gap:12px}.wrap .section-title{margin-top:24px}
 .wrap .sub{font-size:13px;line-height:1.6}
}
@media(prefers-reduced-motion:reduce){.wrap *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>
{% include "_site_nav.html.j2" %}
<div class="wrap">
  <div class="section-title">{{ t('Allocation model · S&P Vector','仓位模型 · 标普向量') }}</div>
  <h1 class="h1">{{ t('S&P 500 / T-bill model allocation','标普500 / 短期国债模型仓位') }}</h1>
  <div class="sub">{{ t('Stored SPY close','已记录的 SPY 收盘价') }} · {{ as_of }} · {{ '$%s'|format('{:,.2f}'.format(price)) }}</div>
  {% if bench_start %}<div class="sub faint">{{ t('Backtest window','回测窗口') }}
    {{ bench_start }} → {{ as_of }} ({{ sc.years }}y)</div>{% endif %}
  <div class="tag">{{ t('Mechanical output and historical context. Source completeness is not certified by this page.','机械模型输出及历史背景。本页不认证数据源的完整性。') }}</div>

  <!-- ===== mechanical split + model readings ===== -->
  <div style="margin-top:16px">
    <section class="card" id="spv-allocation" aria-labelledby="spv-allocation-title">
      <h2 id="spv-allocation-title">{{ t('Mechanical strategy allocation','机械策略仓位') }}</h2>
      <div class="allocation-split">
        <div class="allocation-number" data-equity-weight="{{ equity_w }}">{{ equity_w }}% <small>{{ t('equity','股票') }}</small></div>
        <div class="cash-number">{{ cash_w }}% {{ t('T-bills','短债') }}</div>
      </div>
      <div class="allocbar" aria-hidden="true">
        {% if equity_w %}<div class="seg-spy" style="flex:{{ equity_w }}"></div>{% endif %}
        {% if cash_w %}<div class="seg-cash" style="flex:{{ cash_w }}"></div>{% endif %}
      </div>
      <div class="legend"><span><i style="background:var(--blue)"></i>{{ t('S&P 500 (SPY)','标普500 (SPY)') }}</span><span><i style="background:var(--muted)"></i>{{ t('3-month T-bills','3个月国债') }}</span></div>
      <div class="source-line">{{ t('Allocation model date','仓位模型日期') }} · {{ allocation_as_of or t('Unavailable','暂无数据') }}</div>
      {% if last_switch %}<div class="sub" style="margin-top:12px">{{ t('Last model weight change','最近模型权重变化') }} · {{ last_switch.date }} · {{ last_switch.frm }}% → {{ last_switch.to }}%</div>{% endif %}
      <div class="sub faint" style="margin-top:12px">{{ t(next_note, next_note_zh) }}</div>
    </section>

  </div>

  <!-- ===== strategy chart ===== -->
  <section class="card" id="spv-study" aria-labelledby="spv-study-title" style="margin-top:18px">
    <div class="study-head"><h2 id="spv-study-title">{{ t('Price, model risk and equity weight','价格、模型风险与股票权重') }}</h2><span class="sub">{{ t('Three panels · shared time axis','三个面板 · 同一时间轴') }}</span></div>
    <div class="range-controls" role="group" aria-label="{{ 'Model study range' }}">
      {% for label in ['1Y','5Y','10Y','All'] %}<button type="button" data-spv-range="{{ loop.index0 }}" aria-pressed="{{ 'true' if label == '5Y' else 'false' }}" disabled>{{ t(label, {'1Y':'1年','5Y':'5年','10Y':'10年','All':'全部'}[label]) }}</button>{% endfor %}
    </div>
    <div class="spv-plot">
  <div class="section-title">{{ t('The strategy in action · S&P 500 with the model on top','策略实战 · 标普500 叠加模型') }}</div>
  <div class="card">{{ charts.strategy|safe }}
    <div class="sub" style="margin-top:8px">{{ t('Green = fully invested, amber = trimmed, clear = defensive. ▲/▼ mark every allocation change. The strategy equity (blue) is rescaled onto the price axis so you can read protection vs participation directly. Use the range buttons to zoom.','绿色 = 满仓，琥珀 = 减仓，空白 = 防守。▲/▼ 标注每次仓位变动。策略净值（蓝）已缩放至价格轴，可直接对比保护与参与度。用范围按钮缩放。') }}</div>
  </div>
    </div>
    <p class="sub">{{ t('Green = fully invested; amber = trimmed; clear = defensive. Triangles mark model weight changes, not executed trades. Strategy equity is rescaled onto the price axis. Range controls update all three panels together. Older line samples may be thinned or rounded; change markers retain model dates.','绿色 = 满仓；琥珀色 = 减仓；无色 = 防守。三角标记表示模型权重变化，并非已执行交易。策略净值缩放至价格轴。范围控件同步更新三个面板。较早的折线样本可能抽稀或取整；变化标记保留模型日期。') }}</p>
  </section>

    <section class="card" id="spv-model-readings" style="margin-top:18px" aria-labelledby="spv-risk-title">
      <h2 id="spv-risk-title">{{ t('Model risk score','模型风险评分') }} <span class="faint">(0–100)</span></h2>
      <div class="dialwrap">
        <div class="dialnum" style="color:{{ band_color }}">{{ score if score is not none else '—' }}</div>
        <div>
          <span class="pill">{% if score is none %}{{ t('Unavailable','暂无数据') }}{% elif not score_current_available %}{{ t('Last available reading','最近可用读数') }}{% elif band_key == 'low' %}{{ t('Low model risk','模型风险低') }}{% elif band_key == 'elevated' %}{{ t('Elevated model risk','模型风险偏高') }}{% elif band_key == 'high' %}{{ t('High model risk','模型风险高') }}{% else %}{{ t('Extreme model risk','模型风险极高') }}{% endif %}</span>
          <div class="source-line">{{ t('Score contributor date','评分来源日期') }} · {{ score_as_of or t('Unavailable','暂无数据') }}<br>{{ t('Aligned SPY session','对齐的 SPY 交易日') }} · {{ score_aligned_as_of or t('Unavailable','暂无数据') }}</div>
        </div>
      </div>
      <div class="chips">
        <span class="chip">{{ t('Capitulation model','恐慌模型') }}: <b>{% if disloc.cap_available %}{{ disloc.capitulation }}/3{% else %}{{ t('Unavailable','暂无数据') }}{% endif %}</b></span>
        <span class="chip">{{ t('Fed-put absent flag','美联储看跌缺席标记') }}: <b>{% if disloc.put_available %}{{ t('true','真') if disloc.put_absent else t('false','假') }}{% else %}{{ t('Unavailable','暂无数据') }}{% endif %}</b></span>
      </div>
      <div class="source-line">{{ t('Capitulation date','恐慌模型日期') }} · {{ disloc.cap_as_of or '—' }}<br>{{ t('Fed-put model date','美联储看跌模型日期') }} · {{ disloc.put_as_of or '—' }}</div>
      <p class="sub">{{ t('Underlying input freshness and completeness are not supplied. A zero score or false model flag does not establish healthy feeds.','底层输入的新鲜度及完整性未提供。零分或假标记不能证明数据源正常。') }}</p>
      <details class="spv-details" id="spv-gate">
        <summary>{{ t('Re-deploy gate · model logic','再部署闸门 · 模型逻辑') }}</summary>
        <div class="sub">{{ t('Re-deploy gate','再部署闸门') }}: {% if disloc.gate_model_available %}<b>{{ t(disloc.verdict, disloc.verdict_zh) }}</b>{% else %}{{ t('Model output unavailable','模型输出暂无数据') }}{% endif %}</div>
        <p class="sub faint">{{ t('This is the rule output from the available model frames, not a verified assessment of live policy or market conditions.','这是可用模型数据产生的规则输出，并非对实时政策或市场状况的已验证判断。') }}</p>
        {% if disloc.put_legs %}<div class="sub">{{ t('Fed-put model components','美联储看跌模型分项') }} · {{ disloc.put_legs_as_of or t('Date unavailable','日期暂缺') }}<br>
          {{ t('Recession flag','衰退标记') }}: {{ t('true','真') if disloc.put_legs.recession else t('false','假') }} ·
          {{ t('Inflation restriction flag','通胀限制标记') }}: {{ t('true','真') if disloc.put_legs.fedput_off else t('false','假') }}</div>{% endif %}
      </details>
    </section>

  <!-- ===== LLM context / recorded shadow assessment ===== -->
  <section class="card" id="spv-shadow" aria-labelledby="spv-shadow-title" style="margin-top:18px">
    <h2 id="spv-shadow-title">{{ t('Shadow assessment · recorded only','影子评估 · 仅作记录') }}</h2>
    <div class="shadow-state">{{ t('Not applied to allocation','未应用于仓位') }}</div>
    <p class="sub">{{ t('The mechanical allocation above remains the model output. The shadow assessment does not change that weight, the score or the backtest.','上方机械仓位仍为模型输出。影子评估不会改变该权重、评分或回测。') }}</p>
    {% if overlay and overlay.enabled %}
      <div class="sub">{{ t('Recorded shadow equity weight','已记录的影子股票权重') }} · <b>{{ (overlay.overlay_weight*100)|round|int }}%</b> · {{ t('Mechanical equity weight','机械股票权重') }} · <b>{{ equity_w }}%</b></div>
      <div class="source-line">{{ t('Recorded veto flag','已记录的否决标记') }} · {{ t('true','真') if overlay.veto else t('false','假') }}</div>
      {% if overlay.veto_reason or overlay.note %}<div class="source-line">{{ t('Recorded shadow rationale','已记录的影子理由') }}</div><blockquote>{{ overlay.veto_reason if overlay.veto_reason else overlay.note }}</blockquote>{% endif %}
    {% else %}<p class="sub faint">{{ t('No shadow assessment is available for this page build.','本次页面构建没有可用的影子评估。') }}</p>{% endif %}
    {% if overlay_log %}<div class="source-line">{{ t('Forward log','向前记录') }}:
      {{ overlay_log.days }} {{ t('distinct model dates','个不同模型日期') }}
      ({{ overlay_log.first }} → {{ overlay_log.last }}; {{ overlay_log.rows }} {{ t('records','条记录') }}) —
      {% if overlay_log.vetoes %}{{ t('a veto flag was recorded on {v} dates.','其中 {v} 个日期记录了否决标记。')|replace('{v}', overlay_log.vetoes|string) }}{% else %}{{ t('no veto flag has been recorded.','尚未记录否决标记。') }}{% endif %}
    </div>{% endif %}
  </section>

  <!-- ===== risk-score leg breakdown ===== -->
  <details class="spv-details" id="spv-breakdown">
    <summary>{{ t('Risk-score breakdown and model lags','风险评分分解与模型滞后') }}</summary>
    <div class="source-line">{{ t('Breakdown contributor date','分解来源日期') }} · {{ legs_as_of or t('Unavailable','暂无数据') }} · {{ t('Independent of the headline aligned session','与顶部对齐交易日分别标注') }}</div>
    <p class="sub">{{ t('Contributions use the model’s renormalised weighted mean. Missing components remain unavailable; unfilled space is not evidence of calm markets.','分项贡献采用模型的归一化加权平均。缺失分项保持暂无数据；空白不代表市场平静。') }}</p>
    {% if legs_score is not none %}<div class="riskbar" aria-hidden="true">{% for lg in legs %}{% if lg.active and lg.points %}<div style="width:{{ lg.points }}%;background:{{ lg.color }}"></div>{% endif %}{% endfor %}</div>{% endif %}
    <div class="table-scroll" tabindex="0" role="region" aria-label="Risk-score component table">
      <table class="legtbl">
        <thead><tr><th class="l">{{ t('Risk leg','风险分项') }}</th><th>{{ t('Intensity','强度') }}</th><th>{{ t('Weight','权重') }}</th><th>{{ t('Model lag · trading days','模型滞后 · 交易日') }}</th><th>{{ t('Points','贡献分') }}</th></tr></thead>
        <tbody>{% for lg in legs %}<tr><td class="l"><span class="dot" style="background:{{ lg.color }}"></span>{{ t(lg.label, lg.label_zh) }}</td><td>{{ (lg.value|round|int ~ '/100') if lg.value is not none else '—' }}</td><td>{{ '%.1f'|format(lg.weight) }}</td><td>{{ lg.lag }}</td><td>{{ ('%.1f'|format(lg.points)) if lg.points is not none else '—' }}</td></tr>{% endfor %}
        <tr><td class="l"><b>{{ t('Breakdown composite','分解综合分') }}</b></td><td></td><td></td><td></td><td><b>{{ ('%g'|format(legs_score)) if legs_score is not none else '—' }}</b></td></tr></tbody>
      </table>
    </div>
  </details>

  <!-- ===== growth + drawdown ===== -->
  <details class="spv-details" id="spv-history">
    <summary>{{ t('Historical growth and drawdown','历史增长与回撤') }}</summary>
  <div class="grid cols-2">
    <div class="card"><h3>{{ t('Growth of $1 (log) — vs buy & hold','1美元增长（对数）— 对比买入持有') }}</h3>{{ charts.growth|safe }}</div>
    <div class="card"><h3>{{ t('Underwater (drawdown) — vs buy & hold','水下回撤 — 对比买入持有') }}</h3>{{ charts.dd|safe }}</div>
  </div>
    <div class="note b">{{ t('Historical results depend on this sample, inputs and assumptions. Headline CAGR includes T-bill carry on the defensive sleeve; ex-carry results are shown separately. Relative returns and drawdown protection can change across periods.','历史结果取决于样本、输入及假设。标题年化收益包含防守部分的短债利息；扣息结果另列。不同区间的相对收益和回撤保护可能变化。') }}</div>
  </details>

  <details class="spv-details" id="spv-scorecard"><summary>{{ t("Historical scorecard and resampling basis","历史记分卡与重抽样依据") }}</summary>
  <!-- ===== scorecard tiles ===== -->
  <div class="section-title">{{ t('Backtest scorecard · {y} years vs buy & hold'|replace('{y}', sc.years|string), '回测记分卡 · {y} 年对比买入持有'|replace('{y}', sc.years|string)) }}</div>
  <div class="grid cols-4">
    <div class="card score"><div class="k">CAGR</div><div class="v {{ 'win' if sc.cagr >= sc.hodl_cagr else 'lose' }}">{{ sc.cagr }}%</div><div class="sub">{{ t('buy & hold','买入持有') }} {{ sc.hodl_cagr }}% · {{ t('ex-carry','扣息') }} {{ sc.cagr_nocarry }}%</div></div>
    <div class="card score"><div class="k">Sharpe</div><div class="v {{ 'win' if sc.sharpe >= sc.hodl_sharpe else 'lose' }}">{{ sc.sharpe }}</div><div class="sub">{{ t('buy & hold','买入持有') }} {{ sc.hodl_sharpe }}{% if sc.bootstrap %} · CI {{ sc.boot_sharpe_lo }}–{{ sc.boot_sharpe_hi }}{% endif %}{% if sc.bootstrap and sc.bootstrap.sharpe_gt0_prob is number %} · {{ t('above 0 in {p}% of resamples','{p}% 的重抽样高于 0')|replace('{p}', '%g'|format(sc.bootstrap.sharpe_gt0_prob * 100)) }}{% endif %}</div></div>
    <div class="card score"><div class="k">{{ t('Max drawdown','最大回撤') }}</div><div class="v {{ 'win' if sc.maxdd >= sc.hodl_maxdd else 'lose' }}">{{ sc.maxdd }}%</div><div class="sub">{{ t('buy & hold','买入持有') }} {{ sc.hodl_maxdd }}%{% if sc.bootstrap and sc.bootstrap.maxdd_ci_pct %} · {{ t('CI','置信区间') }} {{ sc.bootstrap.maxdd_ci_pct[0] }}% {{ t('to','至') }} {{ sc.bootstrap.maxdd_ci_pct[2] }}%{% endif %}</div></div>
    <div class="card score"><div class="k">{{ t('Time invested','在场时间') }}</div><div class="v">{{ sc.time_in_market }}%</div><div class="sub">{{ sc.turnover_annual }}x {{ t('turnover/yr','换手/年') }}</div></div>
  </div>
  {% if sc.bootstrap and sc.bootstrap.B is number and sc.bootstrap.n is number
  and sc.bootstrap.block is number %}<div class="sub faint">{{ t(
  'CI = the middle 95% of {B} resamples of the {n} daily returns, drawn in {k}-session blocks.',
  '置信区间（CI）为 {n} 个日收益以 {k} 个交易日为一块重抽样 {B} 次后的中间 95%。')
  |replace('{B}', "{:,}".format(sc.bootstrap.B))
  |replace('{n}', "{:,}".format(sc.bootstrap.n))|replace('{k}', sc.bootstrap.block|string)
  }}</div>{% endif %}
  <div class="grid cols-3" style="margin-top:18px">
    <div class="card score"><div class="k">Sortino</div><div class="v {{ 'win' if sc.sortino >= sc.hodl_sortino else 'lose' }}">{{ sc.sortino }}</div><div class="sub">{{ t('buy & hold','买入持有') }} {{ sc.hodl_sortino }}</div></div>
    <div class="card score"><div class="k">{{ t('After-tax CAGR (35% scenario)','税后年化（35%情景）') }}</div><div class="v">{{ at.after_tax_cagr }}%</div><div class="sub">{{ t('buy & hold','买入持有') }} {{ at.hodl_cagr }}% · {{ t('cum. tax','累计税') }} {{ at.cumulative_tax_paid_x }}×</div></div>
    <div class="card score"><div class="k">{{ t('Carry contribution','套息贡献') }}</div><div class="v">+{{ sc.carry_pp }}pp</div><div class="sub">{{ t('rate-regime dependent (~0 in ZIRP)','取决于利率环境（零利率时≈0）') }}</div></div>
  </div>

  </details>

  <!-- ===== allocation rule-book ===== -->
  <details class="spv-details" id="spv-rules">
    <summary>{{ t('The rule-book · risk band to equity weight','规则手册 · 风险区间到股票权重') }}</summary>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Allocation bands">
      <table class="gtable"><thead><tr><th>{{ t('Risk band','风险区间') }}</th><th>{{ t('Score','分数') }}</th><th>{{ t('S&P 500 weight','标普500权重') }}</th><th>{{ t('T-bills','短债') }}</th></tr></thead><tbody>
        {% for b in bands %}<tr><td class="rh {{ 'cur' if b.cur }}">{{ t(b.label, b.label_zh) }}{% if b.cur %} ◀{% endif %}</td><td class="{{ 'cur' if b.cur }}">{{ b.rng }}</td><td class="{{ 'cur' if b.cur }}"><b>{{ b.weight }}%</b></td><td class="{{ 'cur' if b.cur }}">{{ 100 - b.weight }}%</td></tr>{% endfor %}
      </tbody></table>
    </div>
    <p class="sub">{{ t('The existing model requires a new band to persist for five trading days. Its re-deploy rule uses the capitulation and Fed-put model flags and a 42-session hold. Those rules can make the mechanical weight differ from the score’s simple band weight.','现有模型要求新区间持续五个交易日。其再部署规则使用恐慌与美联储看跌模型标记，并持有42个交易日。因此机械权重可能不同于评分对应的简单区间权重。') }}</p>
  </details>

  <!-- ===== bear ledger ===== -->
  <details class="spv-details" id="spv-ledger">
    <summary>{{ t('Historical bear-episode ledger','历史熊市事件台账') }}</summary>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Historical bear episodes"><table class="tbl">
      <thead><tr><th>{{ t('Peak','峰值') }}</th><th>{{ t('Trough','谷底') }}</th><th class="n">{{ t('S&P drawdown','标普回撤') }}</th></tr></thead><tbody>
      {% for e in episodes %}<tr><td>{{ e.peak }}</td><td>{{ e.trough }}</td><td class="n lose">{{ e.drawdown_pct }}%{% if e.ongoing %} ({{ t('ongoing','进行中') }}){% endif %}</td></tr>{% else %}<tr><td colspan="3">{{ t('No qualifying episodes in the supplied sample.','所提供样本中没有符合条件的事件。') }}</td></tr>{% endfor %}
      </tbody></table></div>
    <p class="sub faint">{{ t('Episodes are identified from the supplied price history using the existing 20% drawdown rule. Daily observations and overlapping regimes are not independent trials. This page does not certify point-in-time validity or out-of-sample performance.','事件采用现有20%回撤规则，从所提供的价格历史中识别。每日观测与重叠市场阶段并非独立试验。本页不认证时点有效性或样本外表现。') }}</p>
  </details>

  <details class="spv-details" id="spv-methods">
    <summary>{{ t('Costs, carry and tax assumptions','成本、利息与税务假设') }}</summary>
    <div class="note r">{{ t('Tax scenario: turnover is {x}×/yr. The comparison applies a 35% short-term gains assumption; it is a sensitivity scenario, not account-specific tax advice. Results are before final liquidation.','税务情景：换手率为 {x}×/年。对比采用35%的短期资本利得假设；这是敏感性情景，并非针对账户的税务建议。结果未计最终清算。')|replace('{x}', sc.turnover_annual|string) }}</div>
    <p class="sub">{{ t('Backtest holdings take effect on the next bar. Trading cost is 3 basis points per unit of turnover. Cash carry uses the existing calendar-day convention and bill-yield inputs. The shadow assessment is excluded.','回测持仓在下一根价格柱生效。每单位换手计3个基点交易成本。现金利息沿用现有自然日惯例及国债收益率输入。影子评估不计入。') }}</p>
  </details>

  <div class="foot">
    {{ t('Built', '生成于') }} {{ built }}<br>
    <span class="made">© 2026 Mastermind Inc</span>
  </div>
</div>
<!-- shared theme + language toggles: wires .theme-switch + .lang-toggle, persists
     the choice, and re-themes the Plotly charts (font + axes) on every toggle. -->
<script src="theme.js"></script>
<script>
(function(){
  function init(){
    var section=document.getElementById('spv-study'),plot=section&&section.querySelector('.js-plotly-plot');
    var buttons=section?Array.from(section.querySelectorAll('[data-spv-range]')):[];
    function sync(){var menu=plot&&plot.layout&&plot.layout.updatemenus&&plot.layout.updatemenus[0];if(!menu)return false;buttons.forEach(function(b,i){b.disabled=false;b.setAttribute('aria-pressed',String(i===menu.active));});return true;}
    if(plot&&plot.layout&&plot.layout.updatemenus){
      window.Plotly.relayout(plot,{'updatemenus[0].visible':false});sync();
      buttons.forEach(function(button,i){button.addEventListener('click',function(){var menu=plot.layout.updatemenus[0],args=Object.assign({},menu.buttons[i].args[0]);args['updatemenus[0].active']=i;window.Plotly.relayout(plot,args).then(sync);});});
      if(plot.on)plot.on('plotly_relayout',sync);
    }
    document.querySelectorAll('.spv-details').forEach(function(details){details.addEventListener('toggle',function(){if(details.open)requestAnimationFrame(function(){details.querySelectorAll('.js-plotly-plot').forEach(function(p){if(window.Plotly.Plots)window.Plotly.Plots.resize(p);});});});});
    function language(){var zh=document.documentElement.getAttribute('data-lang')==='zh';var ranges=section&&section.querySelector('.range-controls');if(ranges)ranges.setAttribute('aria-label',zh?'模型研究范围':'Model study range');var labels={'spv-breakdown':['Risk-score component table','风险评分分项表'],'spv-rules':['Allocation bands','仓位区间表'],'spv-ledger':['Historical bear episodes','历史熊市事件表']};Object.keys(labels).forEach(function(id){var table=document.querySelector('#'+id+' .table-scroll');if(table)table.setAttribute('aria-label',labels[id][zh?1:0]);});}
    language();document.addEventListener('langchange',language);
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>
</body></html>
