{% extends "report_base.html.j2" %}
{% macro t(en, zh='') -%}<span class="l-en" lang="en">{{ en|e }}</span><span class="l-zh" lang="{{ 'zh' if zh else 'en' }}">{{ (zh if zh else en)|e }}</span>{%- endmacro %}
{% macro icon(name) -%}
<svg class="nd-icon" viewBox="0 0 24 24" aria-hidden="true">{% if name == 'search' %}<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/>
{% elif name == 'globe' %}<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18"/>
{% elif name == 'filter' %}<path d="M4 7h16M7 12h10M10 17h4"/>
{% elif name == 'bookmark' %}<path d="M6 4h12v17l-6-4-6 4z"/>
{% elif name == 'clock' %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{% elif name == 'news' %}<path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5"/>
{% elif name == 'chart' %}<path d="M4 19V5m0 14h16M7 14l4-4 4 2 5-7"/>
{% elif name == 'bank' %}<path d="m3 8 9-5 9 5H3m2 3v7m7-7v7m7-7v7M3 21h18"/>
{% elif name == 'company' %}<path d="M5 21V3h14v18M9 7h1m4 0h1m-6 4h1m4 0h1m-6 4h1m4 0h1M3 21h18"/>
{% elif name == 'energy' %}<path d="m13 2-8 12h6l-1 8 9-13h-7z"/>
{% elif name == 'tech' %}<rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v4m6-4v4m-6 12v4m6-4v4M2 9h4m-4 6h4m12-6h4m-4 6h4"/>
{% elif name == 'close' %}<path d="m6 6 12 12M6 18 18 6"/>
{% elif name == 'plus' %}<path d="M12 5v14M5 12h14"/>
{% elif name == 'arrow' %}<path d="M5 12h14m-5-5 5 5-5 5"/>
{% elif name == 'keyboard' %}<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 10h.01M11 10h.01M15 10h.01M7 14h10"/>
{% else %}<circle cx="12" cy="12" r="9"/><path d="M12 11v6m0-10h.01"/>{% endif %}</svg>
{%- endmacro %}
{% set FEED = ((news_feed if news_feed is iterable and news_feed is not string else [])|select('mapping')|list) %}
{% set CATS = [('all','globe','All coverage','全部报道'),('markets','chart','Markets','市场'),('economy','chart','Economy','经济'),('central_banks','bank','Central banks','央行'),('companies','company','Companies','公司'),('geopolitics','globe','Geopolitics','地缘政治'),('energy','energy','Energy & materials','能源与原料'),('technology','tech','Technology','科技')] %}
{% block title %}News Intelligence · Mastermind{% endblock %}
{% block head_extra %}
{% set seo_title = "News Intelligence — Mastermind" %}
{% set seo_desc = "Explore global reporting, market news, policy and economic developments in a focused news workspace with source evidence and live desk updates." %}
{% set seo_path = "news.html" %}
{% include "_seo_head.html.j2" %}
{% endblock %}
{% block base_css %}{% include "news_desk.css" %}{% endblock %}
{% block content %}
<main class="news-desk" id="newsDesk" data-density="compact">
  <header class="nd-header">
    <div><p class="nd-eyebrow">{{ t('Intelligence / Global coverage','情报 / 全球报道') }}</p><h1>{{ t('News intelligence','新闻情报') }}</h1></div>
    <div class="nd-header-tools">
      <span class="nd-status dtp-asof" id="ndConnection" data-state="connecting">{{ t('Connecting','正在连接') }}</span>
      <button type="button" class="nd-btn nd-btn-quiet nd-mobile-only" data-open-panel="ndWorkspace" aria-label="Your workspace" data-label-zh="你的工作台">{{ icon('bookmark') }}</button>
      <button type="button" class="nd-btn nd-btn-quiet" id="ndCoverageOpen" aria-label="Coverage and freshness" data-label-zh="覆盖范围与时效">{{ icon('globe') }}<span>{{ t('Coverage','覆盖范围') }}</span></button>
      <button type="button" class="nd-btn" id="ndDensity" aria-pressed="false" aria-label="Reading view" data-label-zh="阅读视图">{{ icon('news') }}<span>{{ t('Reading view','阅读视图') }}</span></button>
    </div>
  </header>
  <div class="nd-shell">
    <aside class="nd-sidebar" aria-label="News navigation" data-label-zh="新闻导航">
      <div><h2 class="nd-nav-heading">{{ t('Coverage','报道领域') }}</h2>
        <div class="nd-categories">{% for key,ic,en,zh in CATS %}
          <button type="button" class="nd-category" data-category="{{ key }}" aria-pressed="{{ 'true' if key == 'all' else 'false' }}">{{ icon(ic) }}{{ t(en,zh) }}</button>
        {% endfor %}</div>
      </div>
      <div><h2 class="nd-nav-heading">{{ t('Your workspace','你的工作台') }}</h2>
        <button type="button" class="nd-category" id="ndSavedStories" aria-pressed="false">{{ icon('bookmark') }}{{ t('Saved stories','已收藏报道') }}</button>
        <button type="button" class="nd-category" data-company-news="">{{ icon('company') }}{{ t('Company news','公司新闻') }}</button>
        <div id="ndSavedViews"></div>
        <button type="button" class="nd-side-link" id="ndSaveView">{{ icon('plus') }}{{ t('Save this view','保存当前视图') }}</button>
      </div>
      <div class="nd-side-bottom">
        <button type="button" class="nd-side-link" data-open-panel="ndCalendar">{{ icon('clock') }}{{ t('Calendar','经济日历') }}</button>
        <button type="button" class="nd-side-link" data-open-panel="ndImpact">{{ icon('chart') }}{{ t('Event impact','事件影响') }}</button>
        <button type="button" class="nd-side-link" id="ndHelpOpen">{{ icon('keyboard') }}{{ t('Shortcuts','键盘与搜索') }}</button>
      </div>
    </aside>
    <section class="nd-center" aria-label="News feed" data-label-zh="新闻流">
      <div class="nd-tabs mx-tabset" role="tablist" aria-label="News views" data-label-zh="新闻视图">
        <button type="button" class="nd-tab" role="tab" id="ndTabLatest" data-view="latest" aria-selected="true" aria-controls="ndFeedPanel">{{ t('Latest','最新') }}</button>
        <button type="button" class="nd-tab" role="tab" id="ndTabImportant" data-view="important" aria-selected="false" aria-controls="ndFeedPanel" tabindex="-1">{{ t('Important','重点') }}</button>
        <button type="button" class="nd-tab" role="tab" id="ndTabFollowing" data-view="following" aria-selected="false" aria-controls="ndFeedPanel" tabindex="-1">{{ t('Following','关注') }}</button>
        <button type="button" class="nd-tab" role="tab" id="ndTabWorld" data-view="world" aria-selected="false" aria-controls="ndFeedPanel" tabindex="-1">{{ t('World & economy','全球与经济') }}</button>
      </div>
      <div class="nd-toolbar">
        <label class="nd-search">{{ icon('search') }}<span class="nd-sr">{{ t('Search news','搜索新闻') }}</span>
          <input id="ndSearch" type="search" maxlength="300" autocomplete="off" spellcheck="false" placeholder="Search a story, theme or ticker…" data-placeholder-zh="搜索报道、主题或股票代码…" aria-describedby="ndSearchHint"><kbd class="nd-key">/</kbd>
        </label>
        <span class="nd-sr" id="ndSearchHint">{{ t('Use quoted phrases, OR, -exclude, ticker:NVDA or source:Reuters.','支持引号短语、OR、-排除词、ticker:NVDA 或 source:Reuters。') }}</span>
        <div class="nd-filter-row">
          <label class="nd-sr" for="ndTime">{{ t('Time window','时间范围') }}</label>
          <select id="ndTime" class="nd-select"><option value="24" data-en="Past 24 hours" data-zh="过去24小时">Past 24 hours</option><option value="72" data-en="Past 3 days" data-zh="过去3天">Past 3 days</option><option value="168" selected data-en="Past 7 days" data-zh="过去7天">Past 7 days</option><option value="all" data-en="All loaded" data-zh="全部已载入">All loaded</option></select>
          <label class="nd-sr" for="ndRegion">{{ t('Region mentioned','提及地区') }}</label>
          <select id="ndRegion" class="nd-select"><option value="all" data-en="All regions" data-zh="全部地区">All regions</option><option value="americas" data-en="Americas" data-zh="美洲">Americas</option><option value="europe" data-en="Europe" data-zh="欧洲">Europe</option><option value="asia" data-en="Asia Pacific" data-zh="亚太">Asia Pacific</option><option value="middle_east" data-en="Middle East" data-zh="中东">Middle East</option><option value="africa" data-en="Africa" data-zh="非洲">Africa</option></select>
          <button type="button" class="nd-btn" id="ndFilterOpen">{{ icon('filter') }}{{ t('Filters','筛选') }}<span id="ndFilterCount"></span></button>
          <button type="button" class="nd-btn nd-btn-quiet nd-reset" id="ndReset" hidden>{{ t('Reset','重置') }}</button>
        </div>
      </div>
      <div class="nd-follow" id="ndFollowBar" hidden><label for="ndFollowInput">{{ t('Follow','关注') }}</label><input id="ndFollowInput" maxlength="200" placeholder="NVDA, oil, Federal Reserve" data-placeholder-zh="NVDA, 原油, 美联储"><button type="button" class="nd-btn" id="ndFollowSave">{{ t('Save','保存') }}</button></div>
      <div class="nd-banner" id="ndBanner" hidden><span id="ndBannerText"></span><a href="/?signin=1&amp;ret=news.html" id="ndSignIn" hidden>{{ t('Sign in','登录') }}</a><button type="button" class="nd-btn nd-btn-quiet" id="ndRetry" hidden>{{ t('Retry','重试') }}</button></div>
      <div class="nd-list-top"><span id="ndResultCount">{{ t('Latest reporting','最新报道') }}</span><span id="ndFreshness"></span><label><input type="checkbox" id="ndAutoFollow">{{ t('Follow live','跟随最新') }}</label><span class="nd-status nd-connection-mobile" id="ndConnectionMobile" data-state="connecting">{{ t('Connecting','正在连接') }}</span></div>
      <button type="button" class="nd-update-bar" id="ndUpdates" hidden></button>
      <div class="nd-feed-scroll" id="ndFeedPanel" role="tabpanel" aria-labelledby="ndTabLatest" tabindex="0">
        <ol class="nd-feed" id="ndFeed">
          {% for h in FEED[:30] %}{% set url = h.url if h.url is string else '' %}
          <li class="nd-row"><div class="nd-row-time"><span>{{ (h.seendate or '')[:10]|e }}</span></div><div class="nd-row-body">{% if url.startswith('https://') or url.startswith('http://') %}<a class="nd-title" href="{{ url|e }}" target="_blank" rel="noopener noreferrer">{{ (h.title or '')|e }}</a>{% else %}<span class="nd-title">{{ (h.title or '')|e }}</span>{% endif %}<div class="nd-row-meta">{{ (h.source_name or h.source or h.domain or '')|e }}</div></div></li>
          {% else %}<li class="nd-empty"><h3>{{ t('Your news workspace is ready','新闻工作台已就绪') }}</h3><p>{{ t('Connect to the desk to see the latest available reporting.','连接新闻台以查看最新可用报道。') }}</p></li>{% endfor %}
        </ol>
        <div id="ndEmpty" class="nd-empty" hidden><h3 id="ndEmptyTitle"></h3><p id="ndEmptyWhy" class="mx-empty-why"></p><button type="button" class="nd-btn" id="ndEmptyReset">{{ t('Reset filters','重置筛选') }}</button></div>
        <button type="button" class="nd-btn nd-load-more" id="ndMore" hidden>{{ t('Load more stories','载入更多报道') }}</button>
      </div>
    </section>
    <aside class="nd-detail" id="ndDetail" aria-label="Story workspace" data-label-zh="报道工作区" data-open="false">
      <div class="nd-detail-head"><span class="nd-detail-label">{{ t('Story workspace','报道工作区') }}</span><button type="button" class="nd-btn nd-btn-quiet" id="ndDetailClose" aria-label="Close story" data-label-zh="关闭报道">{{ icon('close') }}</button></div>
      <div class="nd-detail-scroll" id="ndDetailBody"><div class="nd-detail-empty">{{ icon('news') }}<h2>{{ t('Go beyond the headline','深入了解报道') }}</h2><p>{{ t('Select a story to explore the reporting, source evidence and how the story developed.','选择一条报道，查看报道内容、来源依据与事件进展。') }}</p></div></div>
    </aside>
  </div>
  <div class="nd-footer"><span>{{ t('Publication times are shown in your local time.','发布时间按你的本地时间显示。') }}</span><span>{{ t('Read without losing your place. New arrivals wait above the feed.','阅读位置保持不变，新报道在列表上方等待。') }}</span></div>
  <p class="nd-sr" role="status" aria-live="polite" id="ndAnnounce"></p>
</main>
<dialog class="nd-dialog" id="ndFilters" aria-labelledby="ndFiltersTitle">
  <div class="nd-dialog-header"><h2 id="ndFiltersTitle">{{ t('Refine your news','筛选你的新闻') }}</h2><button type="button" class="nd-btn nd-btn-quiet" data-close-dialog aria-label="Close filters" data-label-zh="关闭筛选">{{ icon('close') }}</button></div>
  <form id="ndFiltersForm" class="nd-dialog-body">
    <div class="nd-form-grid"><div class="nd-form-row"><label for="ndCategorySelect">{{ t('Coverage','报道领域') }}</label><select id="ndCategorySelect">{% for key,ic,en,zh in CATS %}<option value="{{ key }}" data-en="{{ en|e }}" data-zh="{{ zh|e }}">{{ en|e }}</option>{% endfor %}</select></div>
    <div class="nd-form-row"><label for="ndSourceKind">{{ t('Source type','来源类型') }}</label><select id="ndSourceKind"><option value="all" data-en="All reporting" data-zh="全部报道">All reporting</option><option value="official" data-en="Official sources" data-zh="官方来源">Official sources</option><option value="reporting" data-en="News reporting" data-zh="新闻报道">News reporting</option><option value="social" data-en="Social statements" data-zh="社交声明">Social statements</option></select></div></div>
    <div class="nd-form-row"><label class="nd-form-check"><input type="checkbox" id="ndUnread">{{ t('Unread stories only','仅未读报道') }}</label><label class="nd-form-check"><input type="checkbox" id="ndIncludeSocial">{{ t('Include social statements','包括社交声明') }}</label></div>
    <div class="nd-form-row"><label for="ndSourceSearch">{{ t('Source contains','来源包含') }}</label><input type="search" id="ndSourceSearch" maxlength="100" placeholder="Reuters, BBC, Federal Reserve"></div>
    <p class="nd-note">{{ t('Region filters match places mentioned in the reporting. Source labels describe provenance; they do not confirm a claim.','地区筛选匹配报道中提及的地点。来源标签描述出处，并不代表内容已核实。') }}</p>
    <button type="submit" class="nd-btn">{{ t('Apply filters','应用筛选') }}</button><button type="button" class="nd-btn nd-btn-quiet" id="ndSaveViewMobile">{{ t('Save this view','保存当前视图') }}</button>
  </form>
</dialog>
<dialog class="nd-dialog" id="ndCoverage" aria-labelledby="ndCoverageTitle"><div class="nd-dialog-header"><h2 id="ndCoverageTitle">{{ t('Coverage & freshness','覆盖范围与时效') }}</h2><button type="button" class="nd-btn nd-btn-quiet" data-close-dialog aria-label="Close coverage" data-label-zh="关闭覆盖范围">{{ icon('close') }}</button></div><div class="nd-dialog-body" id="ndCoverageBody"></div></dialog>
<dialog class="nd-dialog" id="ndViewDialog" aria-labelledby="ndViewTitle"><div class="nd-dialog-header"><h2 id="ndViewTitle">{{ t('Save this view','保存当前视图') }}</h2><button type="button" class="nd-btn nd-btn-quiet" data-close-dialog aria-label="Close saved view" data-label-zh="关闭保存视图">{{ icon('close') }}</button></div><form class="nd-dialog-body" id="ndViewForm"><p>{{ t('Keep these filters on this browser for your next visit.','在此浏览器中保留这些筛选条件，方便下次使用。') }}</p><div class="nd-form-row"><label for="ndViewName">{{ t('View name','视图名称') }}</label><input id="ndViewName" required maxlength="40" placeholder="Morning macro"></div><button type="submit" class="nd-btn">{{ t('Save view','保存视图') }}</button></form></dialog>
<dialog class="nd-dialog" id="ndHelp" aria-labelledby="ndHelpTitle"><div class="nd-dialog-header"><h2 id="ndHelpTitle">{{ t('Move through the news','高效浏览新闻') }}</h2><button type="button" class="nd-btn nd-btn-quiet" data-close-dialog aria-label="Close help" data-label-zh="关闭帮助">{{ icon('close') }}</button></div><div class="nd-dialog-body"><div class="nd-shortcuts"><span>{{ t('Search the feed','搜索新闻') }}</span><kbd>/</kbd><span>{{ t('Next / previous story','下一条 / 上一条') }}</span><kbd>J / K</kbd><span>{{ t('Close story or dialog','关闭报道或对话框') }}</span><kbd>Esc</kbd><span>{{ t('Save the selected story','收藏当前报道') }}</span><kbd>S</kbd></div><hr><p><code>"Federal Reserve" -speech</code><br>{{ t('Find an exact phrase and exclude a word.','匹配完整短语，并排除指定关键词。') }}</p><p><code>ticker:NVDA source:Reuters</code><br>{{ t('Combine an exact ticker with a source filter.','组合精确股票代码与来源筛选。') }}</p><p><code>oil OR energy -rumor</code><br>{{ t('Match either term. Exclusions apply across all alternatives.','匹配任一关键词；排除词对所有选项生效。') }}</p><p class="nd-note">{{ t('Saved views, following terms and read markers stay on this browser.','已保存视图、关注词与已读标记保留在此浏览器中。') }}</p></div></dialog>

<dialog class="nd-dialog nd-dialog-wide" id="ndImpact" aria-labelledby="ndImpactTitle"><div class="nd-dialog-header"><h2 id="ndImpactTitle">{{ t('Event impact','事件影响') }}</h2><button type="button" class="nd-btn nd-btn-quiet" data-close-dialog aria-label="Close event impact" data-label-zh="关闭事件影响">{{ icon('close') }}</button></div><div class="nd-dialog-body">
{% macro consequence_card(row) -%}
      <div class="nx-rel">
        <div class="nx-rel-top">
          {#- Glance titles are plain-word EN/ZH from the impact projector; raw
              spine titles (T1_HIT / Prophet close / Q3 Stagflation) stay off
              this surface (front-end clarity law). -#}
          <span class="nx-rel-name">{{ t((row.title_en or 'Chronicle event')|e, (row.title_zh or '大事记事件')|e) }}</span>
        </div>
        {% if row.event_time_en or row.direct_tickers %}
        <div class="nx-meta">
          {% if row.event_time_en %}
            <span class="num">{{ t(row.event_time_en, row.event_time_zh or row.event_time_en) }}</span>{% if row.direct_tickers %}<span class="sep">·</span>{% endif %}
          {% endif %}
          {% if row.direct_tickers %}
            <span>{{ t('Named','点名') }}</span>
            {% for tk in row.direct_tickers[:4] %}<a class="nx-tk" href="stock.html#{{ tk|e }}">{{ tk }}</a>{% endfor %}
          {% endif %}
        </div>
        {% endif %}
        {% if row.note_en %}
        <div class="nx-meta">
          <span>{{ t(row.note_en, row.note_zh or row.note_en) }}</span>
        </div>
        {% endif %}
        {# F05-017: rows are closed-key; no further-reach branch remains. #}
      </div>
{%- endmacro %}
{% set CI = chronicle_impact if chronicle_impact is mapping else none %}
{% set _tip_en = (CI.family_tally_tip_en if CI and CI.family_tally_tip_en else '') %}
{% set _tip_zh = (CI.family_tally_tip_zh if CI and CI.family_tally_tip_zh else '') %}
<section class="nx-consequence" id="nxConsequence" aria-label="Event consequences">
    <h2 class="nx-sec-hd">{{ t('Event consequences','事件影响') }}</h2>
    {% if CI and CI.window_label_en %}
    <p class="nx-sub">{{ t(CI.window_label_en, CI.window_label_zh or CI.window_label_en) }}{% if _tip_en %} <button type="button" class="lens-q" aria-label="{{ _tip_en|e }}" data-tip-en="{{ _tip_en|e }}" data-tip-zh="{{ _tip_zh|e }}">?</button>{% endif %}</p>
    {% endif %}
    {% if CI and CI.rows and CI.stance_en %}
    <p class="nx-sub">{{ t(CI.stance_en, CI.stance_zh or CI.stance_en) }}</p>
    {% endif %}
    {% if CI and CI.rows %}
    {#- NM-4: this panel names exposures only — it does not size. -#}
    <p class="nx-sub">{{ t('Named exposures only — no sizing, not a forecast.', '仅列出相关标的——不做幅度推算，非预测。') }}</p>
    {% endif %}
    {% if CI and CI.rows %}
    <div class="nx-rel-grid">
      {% for row in CI.rows[:8] %}
      {{ consequence_card(row) }}
      {% endfor %}
    </div>
    {% elif CI and CI.empty_kind == 'no_named_exposure' %}
    <div class="nx-empty">
      <p class="nx-empty-lead">{{ t(CI.reason_en, CI.reason_zh or CI.reason_en) }}</p>
      <p class="nx-empty-next">{{ t('Cards appear when an event maps to a named exposure.', '当事件对应到明确标的时，卡片会在此显示。') }}</p>
    </div>
    {% else %}
    <div class="nx-empty">
      {{ t('Not available yet', '暂不可用') }}
      {% if CI and CI.reason_en %} — {{ t(CI.reason_en, CI.reason_zh or CI.reason_en) }}{% else %}
      — {{ t('No chronicle events in this window yet.', '此窗口尚无大事记事件。') }}{% endif %}
    </div>
    {% endif %}
    {% if CI and CI.family_views %}
    <h3 class="nx-sec-hd">{{ t('Browse by event type', '按事件类型查看') }}</h3>
    {% for family in CI.family_views %}
    <details class="nx-depth nx-family">
      <summary class="nx-depth-summary">
        <span>{{ t(family.label_en|e, family.label_zh|e) }}</span>
        <span class="nx-depth-meta">{{ family.available_count }} {{ t('records', '条记录') }}</span>
      </summary>
      <div class="nx-depth-body">
        {% if family.rows %}
        <p class="nx-sub">{{ t('Showing ' ~ family.rows|length ~ ' of ' ~ family.available_count ~ ' records', '显示' ~ family.available_count ~ '条中的' ~ family.rows|length ~ '条') }}</p>
        <div class="nx-rel-grid">
          {% for row in family.rows %}{{ consequence_card(row) }}{% endfor %}
        </div>
        {% else %}
        <div class="nx-empty">
          <p class="nx-empty-lead">
            {% if family.in_window == 0 %}
            {{ t('No recorded events of this type in this window.', '该时段没有此类已记录事件。') }}
            {% elif family.state == 'none_named' %}
            {{ t('Recorded events do not name a market exposure.', '已记录事件未点名市场敞口。') }}
            {% else %}
            {{ t('No displayable records are available for this event type.', '此类事件暂无可展示记录。') }}
            {% endif %}
          </p>
        </div>
        {% endif %}
      </div>
    </details>
    {% endfor %}
    {% endif %}
</section>


<p class="nd-note"><a href="ontology.html">{{ t('Explore the WTI live path','探索WTI实时路径') }}</a></p>
</div></dialog>
{% set catalysts = ((macro_catalysts if macro_catalysts is iterable and macro_catalysts is not string else [])|select('mapping')|list) %}
{% set estrip = ((event_strip if event_strip is iterable and event_strip is not string else [])|select('mapping')|list) %}
{% set releases = (macro_releases.get('cards') if macro_releases is mapping else none) %}
{% set releases = ((releases if releases is iterable and releases is not string else [])|select('mapping')|list) %}
<dialog class="nd-dialog" id="ndCalendar" aria-labelledby="ndCalendarTitle"><div class="nd-dialog-header"><h2 id="ndCalendarTitle">{{ t('Economic calendar','经济日历') }}</h2><button type="button" class="nd-btn nd-btn-quiet" data-close-dialog aria-label="Close calendar" data-label-zh="关闭日历">{{ icon('close') }}</button></div><div class="nd-dialog-body">
<h3>{{ t('Calendar ahead','未来日程') }}</h3>
{% for c in catalysts[:15] %}<div class="nd-calendar-row"><span>{{ (c.date or '')|e }}{% if c.time_et %}<br>{{ c.time_et|e }} ET{% endif %}</span><strong>{{ t(c.label or '',c.label_zh or c.label or '') }}</strong></div>{% endfor %}
{% set labels=catalysts|map(attribute='label')|list %}
{% for c in estrip[:15] if c.label not in labels %}<div class="nd-calendar-row"><span>{{ (c.dow or '')|e }} {{ (c.md or '')|e }}</span><strong>{{ t(c.label or '',c.label_zh or c.label or '') }}</strong></div>{% endfor %}
{% if not catalysts and not estrip %}<p class="nd-note">{{ t('No scheduled events are available in the current edition.','当前版本暂无可用的已排定事件。') }}</p>{% endif %}
{% if releases %}<h3>{{ t('Latest releases','最新公布') }}</h3>{% for c in releases[:12] %}<article class="nd-release"><h4>{{ t(c.display_name or c.release or '',c.display_name_zh or c.display_name or c.release or '') }}</h4>{% if c.period %}<p class="nd-note">{{ c.period|e }}</p>{% endif %}{% if c.summary %}<p>{{ t(c.summary,c.summary_zh or c.summary) }}</p>{% endif %}{% if c.unit is string and c.unit and c.actual is number %}<dl><dt>{{ t('Actual','实际') }}</dt><dd>{{ c.actual }} {{ c.unit|e }}</dd>{% if c.prior is number %}<dt>{{ t('Prior','前值') }}</dt><dd>{{ c.prior }} {{ c.unit|e }}</dd>{% endif %}</dl>{% endif %}</article>{% endfor %}{% endif %}
<p class="nd-note">{{ t('Calendar and release details reflect the latest built edition. Times labelled ET follow US Eastern time.','日程与公布详情反映最近生成的版本，ET表示美国东部时间。') }}</p>
</div></dialog>
<dialog class="nd-dialog" id="ndWorkspace" aria-labelledby="ndWorkspaceTitle"><div class="nd-dialog-header"><h2 id="ndWorkspaceTitle">{{ t('Your workspace','你的工作台') }}</h2><button type="button" class="nd-btn nd-btn-quiet" data-close-dialog aria-label="Close workspace" data-label-zh="关闭工作台">{{ icon('close') }}</button></div><div class="nd-dialog-body nd-workspace-tools">
<button type="button" class="nd-btn" id="ndSavedStoriesMobile">{{ icon('bookmark') }}{{ t('Saved stories','已收藏报道') }}</button>
<button type="button" class="nd-btn" data-company-news="">{{ icon('company') }}{{ t('Company news','公司新闻') }}</button>
<button type="button" class="nd-btn" data-open-panel="ndCalendar">{{ icon('clock') }}{{ t('Economic calendar','经济日历') }}</button>
<button type="button" class="nd-btn" data-open-panel="ndImpact">{{ icon('chart') }}{{ t('Event impact','事件影响') }}</button>
<button type="button" class="nd-btn" data-open-panel="ndHelp">{{ icon('keyboard') }}{{ t('Keyboard & search','键盘与搜索') }}</button>
<div id="ndSavedViewsMobile"></div></div></dialog>

<dialog class="nd-dialog nd-company" id="ndCompany" aria-labelledby="ndCompanyTitle">
  <div class="nd-dialog-header"><div><p class="nd-eyebrow">{{ t('Company intelligence','公司情报') }}</p><h2 id="ndCompanyTitle">{{ t('Company news','公司新闻') }}</h2></div><button type="button" class="nd-btn nd-btn-quiet" data-close-dialog aria-label="Close company news" data-label-zh="关闭公司新闻">{{ icon('close') }}</button></div>
  <div class="nd-company-top">
    <form id="ndCompanyForm" class="nd-company-form"><label for="ndCompanyTicker">{{ t('Company ticker','公司股票代码') }}</label><div><input type="search" id="ndCompanyTicker" maxlength="12" placeholder="e.g. NVDA" data-placeholder-zh="例如 NVDA" autocomplete="off" autocapitalize="characters" spellcheck="false" required><button type="submit" class="nd-btn">{{ t('Open feed','打开新闻流') }}{{ icon('arrow') }}</button></div></form>
    <p class="nd-note">{{ t('Explore available source reports, grouped stories and news activity. Access follows your account and each source’s display permissions.','浏览可用来源报道、事件分组与新闻活跃度。访问权限遵循你的账户与各来源的展示许可。') }}</p>
    <div class="nd-company-status-row"><span id="ndCompanyStatus" role="status" aria-live="polite">{{ t('Choose a company','选择一家公司') }}</span><button type="button" class="nd-btn" id="ndCompanyRetry" hidden>{{ t('Retry','重试') }}</button><a class="nd-btn" id="ndCompanySignIn" href="/?signin=1&amp;ret=news.html" hidden>{{ t('Sign in','登录') }}</a><button type="button" class="nd-btn" id="ndCompanyLive" hidden>{{ t('Back to latest','返回最新') }}</button></div>
    <p class="nd-note" id="ndCompanyHealth"></p><div id="ndCompanyFlow"></div>
  </div>
  <button type="button" class="nd-update-bar" id="ndCompanyUpdates" hidden></button>
  <div class="nd-company-feed" id="ndCompanyRows" tabindex="0" aria-label="Company reporting" data-label-zh="公司报道"></div>
  <div class="nd-company-footer"><span>{{ t('New story groups wait until you choose to show them.','新增事件组在你选择显示前保持等待。') }}</span><button type="button" class="nd-btn" id="ndCompanyMore" hidden>{{ t('Earlier reporting','更早报道') }}{{ icon('arrow') }}</button></div>
</dialog>

<script type="application/json" id="ndSeed">{{ {'stories':FEED, 'updated_at':((macro_news or {}).get('fetched_at','') if macro_news is mapping else '')}|tojson }}</script>
{% endblock %}
{% block body_scripts %}<script>{% include "news_desk.js" %}</script><script>{% include "news_company.js" %}</script>{% endblock %}
