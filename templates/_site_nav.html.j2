{# Shared full navigation chrome for standalone pages.

   The search box is ONE unified universe: theme.js merges every market's nightly
   library (US + China + HK + Canada + Intl) and routes each pick to the analyzer
   that owns it, so pages no longer scope it to a single market.

   Optional page variables:
   - nav_prefix: "../" for pages rendered one directory below site root.
   - nav_search_placeholder_en/nav_search_placeholder_zh: optional placeholder copy.
   - nav_defer_enhancements: preserve logo/live script order while allowing a
     page's primary data bootstrap to execute before those enhancements.
#}
{% set NP = nav_prefix if (nav_prefix is defined and nav_prefix) else '' %}
<nav class="site-nav">
{% include "_navlinks.html.j2" %}
  <div class="nav-search">
    <span class="mag" aria-hidden="true"><svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="8.7" cy="8.7" r="5.6"></circle><path d="m12.9 12.9 4 4"></path></svg></span>
    <input type="text" autocomplete="off" aria-label="Search stocks"
      placeholder="{{ nav_search_placeholder_en | default('Search any stock — US, China, HK, Canada & more…') }}"
      data-ph-zh="{{ nav_search_placeholder_zh | default('搜索任意股票 — 美股、A 股、港股、加股等…') }}">
    <div class="nav-sugg"></div>
  </div>
  <div class="nav-ctrls">
    {# ── page-context links (optional) ────────────────────────────────────────
       The ONE sanctioned way for a page to add a link to this row. Set
       `nav_context_links` to a list of dicts before including this partial:

         {% set nav_context_links = [
              {'href': back_href | default('../baskets.html'),
               'icon': '🧺', 'en': 'All themes', 'zh': '全部主题'}
            ] %}

       Keys: href (required), en/zh (required), icon (optional emoji),
             icon_class (optional <span> class, e.g. a flag glyph).

       This exists because drill-down pages legitimately need a way back to
       their index — basket_detail and subsector_detail each carried an "All
       themes" / "All subsectors" back-link. What is NOT legitimate is a page
       hand-rolling its own <div class="nav-ctrls"> to get one; that is how the
       site reached 12 different headers. Contextual links vary by page; the
       header's structure, styling and product controls do not.
       Guarded by tests/test_product_chrome.py. #}
    {%- for l in (nav_context_links if nav_context_links is defined else []) %}
    <a class="ai-brief-link nav-context-link" href="{{ l.href }}">
      {%- if l.icon_class %}<span class="{{ l.icon_class }}" aria-hidden="true"></span>{% elif l.icon %}{{ l.icon }} {% endif -%}
      {{ t(l.en, l.zh) }}</a>
    {%- endfor %}
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener"><span class="product-icon product-icon-terminal" aria-hidden="true"></span>{{ t('Terminal', '终端') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode">
      <span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span>
    </button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
{# No-JS restore: theme.css now ships the compact 128px pre-enhance search
   footprint (it must match what theme.js converges to, or the upgrade shifts
   the page). With scripting disabled nothing ever upgrades the input, so give
   no-JS readers back the legacy wide desktop search placement — stretched
   across track 1 exactly as the sheet used to lay it out (justify-self:start
   + width:auto would shrink-wrap the input to its intrinsic ~234px). With JS
   on, <noscript> content is inert so this costs nothing; mobile keeps the
   full-width search row either way. Sits INSIDE <nav> because
   scripts/sync_chat_nav.py splices on the <nav>…</nav> element and its guard
   requires the partial to end at </nav>. #}
  <noscript>
  <style>
  /* Scripting off, the <noscript> element itself would land in the nav grid as
     an item and add an empty row (+ a row gap). display:contents keeps it
     box-free; the <style> inside still applies. */
  nav.site-nav noscript { display: contents; }
  /* With scripting disabled there is no hamburger. Keep the existing market
     links and nested destinations reachable, and let the full inventory wrap. */
  nav.site-nav:not(.nav-open) .nav-links { display: flex; flex-wrap: wrap; }
  @media (max-width: 900px) {
    nav.site-nav:not(.nav-open) .nav-dd { width: 100%; }
    nav.site-nav:not(.nav-open) .nav-dd-menu {
      position: static; width: 100%; min-width: 0; max-height: none;
      overflow: visible; opacity: 1; visibility: visible; transform: none;
      pointer-events: auto; box-sizing: border-box;
    }
    nav.site-nav:not(.nav-open) .nav-dd-menu a { white-space: normal; }
  }
  @media (min-width: 901px) {
    nav.site-nav .nav-search { grid-column: 1; grid-row: 2; justify-self: stretch;
      width: auto; max-width: 480px; height: auto; }
    nav.site-nav .nav-search input { height: auto; }
    nav.site-nav .nav-ctrls { grid-column: 2; min-height: 0; }
    nav.site-nav .nav-brand .brand-word { display: inline; }
    nav.site-nav { grid-template-columns: minmax(0, 1fr) auto; }
  }
  </style>
  </noscript>
</nav>
{% if all_tools_enabled is defined and all_tools_enabled is sameas true %}{% include "_all_tools_menu.html.j2" %}{% else %}{{ "\n" }}{% endif %}
