            {{ t('Group by setup', '按布局分组') }}
          </button>
        <div class="search-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
          <label for="ift-search" class="sr-only">{{ t('Search ticker', '搜索代码') }}</label>
          <input type="search" id="ift-search" placeholder="Find a ticker…" data-ph-zh="搜索代码…" autocomplete="off" spellcheck="false">
        </div>
