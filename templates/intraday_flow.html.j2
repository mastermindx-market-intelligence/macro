        <button type="button" class="chip" data-basket="ai_infra" aria-pressed="false">{{ t('AI Infra', 'AI基础') }}</button>
        <button type="button" class="chip" data-basket="ai_software" aria-pressed="false">{{ t('AI Software', 'AI软件') }}</button>
        <button type="button" class="chip" data-basket="ai_semiconductors" aria-pressed="false">{{ t('AI Semis', 'AI芯片') }}</button>
        <button type="button" class="chip" data-basket="semicap_equipment" aria-pressed="false">{{ t('Semicap', '设备') }}</button>
        <button type="button" class="chip" data-basket="reshoring" aria-pressed="false">{{ t('Reshoring', '回流') }}</button>
        <button type="button" class="chip" data-basket="defense" aria-pressed="false">{{ t('Defense', '国防') }}</button>
        <button type="button" class="chip" data-basket="power_grid" aria-pressed="false">{{ t('Power Grid', '电网') }}</button>
        </div>
        </details>
        <label class="ift-mobile-sort-control">
          <span class="sr-only">{{ t('Sort scan', '扫描排序') }}</span>
          <select id="ift-mobile-sort" aria-label="Sort scan">
            <option value="grouped" data-en="By setup" data-zh="按布局">By setup</option>
            <option value="ticker-asc" data-en="Name A–Z" data-zh="代码 A–Z">Name A–Z</option>
            <option value="ticker-desc" data-en="Name Z–A" data-zh="代码 Z–A">Name Z–A</option>
            <option value="stance-asc" data-en="Setup order" data-zh="布局正序">Setup order</option>
            <option value="stance-desc" data-en="Setup reverse" data-zh="布局倒序">Setup reverse</option>
            <option value="last-desc" data-en="Price high–low" data-zh="价格从高到低">Price high–low</option>
            <option value="last-asc" data-en="Price low–high" data-zh="价格从低到高">Price low–high</option>
            <option value="rvol-desc" data-en="Activity high–low" data-zh="活跃度从高到低">Activity high–low</option>
            <option value="rvol-asc" data-en="Activity low–high" data-zh="活跃度从低到高">Activity low–high</option>
          </select>
        </label>
          <button type="button" class="toggle-btn active" id="group-toggle" aria-pressed="true">
