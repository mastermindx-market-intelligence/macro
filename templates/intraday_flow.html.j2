  var date = new Date(value);
  if (!validType || !Number.isFinite(date.getTime())) return lz('time unavailable','时间不可用');
  var iso = date.toISOString();
  return esc(iso.slice(0,10)+' '+iso.slice(11,16)+' UTC');
}
