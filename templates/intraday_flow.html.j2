// ── Full render ────────────────────────────────────────────────────────────
// _rendering only guards SYNCHRONOUS reentrancy. Every fetch completion asks for a render
// — quotes, pulse, flow, and one per per-root flow payload (up to 20 roots) — and those
// land in separate promise callbacks spread over ~1s, so the flag never coalesces them:
// measured 19 full rebuilds inside 2.8s of page load. Async callers go through
// scheduleRender() so a burst collapses into a single render per 50ms window.
var _rendering = false, _renderQueued = false;
// A timer, NOT requestAnimationFrame: rAF is suspended while the tab is hidden, so an
// rAF-coalesced render would stall a backgrounded tab at its last paint until refocus.
// 50ms is below notice and collapses the per-root burst (arrivals land 30-90ms apart).
function scheduleRender() {
  if (_renderQueued) return;
  _renderQueued = true;
  setTimeout(function(){ _renderQueued = false; render(); }, 50);
}
function render() {
  if (_rendering) { scheduleRender(); return; }   // re-queue rather than drop the update
  _rendering = true;
  var tbody = document.getElementById('leaders-body');
  if (!tbody) { _rendering = false; return; }
  var focused = document.activeElement;
  var focusTicker = focused && focused.getAttribute && (focused.getAttribute('data-exp') || focused.getAttribute('data-select'));
  var focusKind = focused && focused.classList && focused.classList.contains('expander') ? 'data-exp' : 'data-select';
  var restoreBoardFocus = focusTicker && tbody.contains(focused);
  var focusId = focused && focused.id && ['leaders-body','ift-inspector','count-label'].some(function(id){
    var owner=document.getElementById(id); return owner && typeof owner.contains==='function' && owner.contains(focused);
  }) ? focused.id : null;
  var computed = computeAll();
  computedByTicker = {};
  computed.forEach(function(row){ computedByTicker[row.l.ticker]=row; });
  var counts = laneCounts(computed);

  // The scan and selected-name evidence share one computed dataset.
  buildHero(computed, counts);
  updateStanceCounts(counts);

  // board
  var html = '';
  computed.forEach(function(row){
    var d = row.d;
    if (d) { d._tk = row.l.ticker; d._eq = (row.l.options_entry||{}).evidence_quality; }
    html += buildRow(row, document.documentElement.getAttribute('data-lang'));
  });
  tbody.innerHTML = html || '<tr class="loading-row"><td colspan="7">'+lz('No data yet','暂无数据')+'</td></tr>';
  if (typeof iftSkelDone === 'function') iftSkelDone(document.getElementById('ift-board-skel'));
  applyView();
  if (window.__mmLang) window.__mmLang();
  localizeControls();
  var focusTarget = focusId ? document.getElementById(focusId) : null;
  if (!focusTarget && restoreBoardFocus) {
    var candidates = tbody.querySelectorAll('['+focusKind+']');
    for (var i=0;i<candidates.length;i++) if(candidates[i].getAttribute(focusKind)===focusTicker) { focusTarget=candidates[i]; break; }
  }
  if (focusTarget && focusTarget.getClientRects().length) focusTarget.focus({preventScroll:true});
  else if (focusId || restoreBoardFocus) {
    var fallback=document.getElementById('ift-search'); if(fallback) fallback.focus({preventScroll:true});
  }
  _rendering = false;
}

