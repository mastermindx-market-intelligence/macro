});
document.querySelectorAll('.chip[data-basket]').forEach(function(chip){
  chip.addEventListener('click', function(){
    document.querySelectorAll('.chip[data-basket]').forEach(function(c){ c.classList.remove('active'); });
    chip.classList.add('active'); activeBasket = chip.getAttribute('data-basket'); boardExpanded = false; applyView();
    var menu = document.getElementById('ift-theme-menu'); if (menu) { menu.open = false; menu.querySelector('summary').focus({preventScroll:true}); }
  });
});
document.querySelectorAll('.stance-card[data-stance]').forEach(function(card){
  card.addEventListener('click', function(){
    var s = card.getAttribute('data-stance');
    if (activeStance === s) { activeStance = 'all'; card.classList.remove('active'); }
    else { document.querySelectorAll('.stance-card').forEach(function(c){ c.classList.remove('active'); }); activeStance = s; card.classList.add('active'); }
    boardExpanded = false;
    applyView();
  });
});
var groupToggle = document.getElementById('group-toggle');
function setGroupToggle(on){ groupByStance = on; if (groupToggle) { groupToggle.classList.toggle('active', on); groupToggle.setAttribute('aria-pressed',String(on)); } }
if (groupToggle) groupToggle.addEventListener('click', function(){ setGroupToggle(!groupByStance); boardExpanded = false; applyView(); });
var _lb = document.getElementById('leaders-body');
if (_lb) _lb.addEventListener('click', function(e){
  if (!e.target.closest) return;
  if (e.target.closest('[data-reset-filters]')) { resetFilters(); return; }
  var exp = e.target.closest('.expander');
  if (exp) { toggleEvidence(exp.getAttribute('data-exp')); return; }
  var name = e.target.closest('[data-select]');
  if (name) {
    var ticker = name.getAttribute('data-select');
    selectName(ticker);
    if (window.matchMedia('(max-width:1199px)').matches) toggleEvidence(ticker, true);
    return;
  }
  var row = e.target.closest('tr.lead-row');
  if (row && !e.target.closest('a,button,input')) selectName(row.getAttribute('data-ticker'));
});
var inspector = document.getElementById('ift-inspector');
if (inspector) inspector.addEventListener('click',function(e){
  var btn = e.target.closest && e.target.closest('#ift-open-evidence');
  if (!btn) return;
  var tk = btn.getAttribute('data-exp'); toggleEvidence(tk);
  var dr = document.getElementById('ift-evidence-'+tk);
  if (!openRows[tk]) { var replacement = document.getElementById('ift-open-evidence'); if(replacement) replacement.focus({preventScroll:true}); }
  if (dr && openRows[tk]) {
    dr.setAttribute('tabindex','-1');
    dr.focus({preventScroll:true});
    dr.scrollIntoView({behavior:REDUCED_MOTION?'auto':'smooth',block:'nearest'});
  }
});
var mobileSort = document.getElementById('ift-mobile-sort');
if(mobileSort) mobileSort.addEventListener('change',function(){
  if(mobileSort.value === 'grouped') setGroupToggle(true);
  else {
    var parts=mobileSort.value.split('-'); setGroupToggle(false);
    sortCol=parts[0]; sortDir=parts[1]==='asc'?1:-1;
  }
  boardExpanded=false; applyView();
});
var themeMenu = document.getElementById('ift-theme-menu');
document.addEventListener('keydown',function(e){
  if (e.key === 'Escape' && themeMenu && themeMenu.open) {
    themeMenu.open = false; themeMenu.querySelector('summary').focus({preventScroll:true});
  }
});
document.addEventListener('click',function(e){
  if (themeMenu && themeMenu.open && !themeMenu.contains(e.target)) themeMenu.open = false;
});
var resetButton = document.getElementById('ift-reset');
if(resetButton) resetButton.addEventListener('click',resetFilters);
var refreshButton = document.getElementById('ift-refresh');
if(refreshButton) refreshButton.addEventListener('click',function(){
  fetchQuotes(); fetchPulse(); fetchFlow(); updateFlowStamp(flowAsof,flowMeta);
});
var countLabel = document.getElementById('count-label');
if (countLabel) countLabel.addEventListener('click', function(e){
  var btn = e.target && e.target.closest ? e.target.closest('.ift-see-all') : null;
  if (!btn) return;
  boardExpanded = btn.getAttribute('data-ift-collapse') !== '1';
  applyView();
  var replacement = document.getElementById('ift-see-all');
  if(boardExpanded) {
    var shown=Array.prototype.filter.call(document.querySelectorAll('tr.lead-row'),function(row){return row.style.display!=='none';});
    var firstNew=shown[BOARD_CAP] && shown[BOARD_CAP].querySelector('[data-select]');
    if(firstNew) replacement=firstNew;
  }
  if(replacement) { replacement.focus({preventScroll:true}); replacement.scrollIntoView({block:'nearest',behavior:REDUCED_MOTION?'auto':'smooth'}); }
});
var searchEl = document.getElementById('ift-search');
if (searchEl) {
  searchEl.addEventListener('input', function(){ searchQ = searchEl.value.trim(); boardExpanded = false; applyView(); });
  (function(){ var en=searchEl.placeholder, zh=searchEl.getAttribute('data-ph-zh')||en;
    function setPh(){ searchEl.placeholder = document.documentElement.getAttribute('data-lang')==='zh'?zh:en; }
    document.addEventListener('langchange',localizeControls);
    setPh(); document.addEventListener('langchange', setPh); })();
}
// No langchange→render needed: static bilingual spans swap via CSS (l-en/l-zh), and the
// composition ribbon's in_favour segment flips red in zh through the .lane-fav CSS var.

// ── Polling ────────────────────────────────────────────────────────────────
function startPolling() {
  fetchQuotes(); fetchPulse(); fetchFlow(); updateFlowStamp(null);
  setInterval(fetchQuotes, 60*1000);
  setInterval(fetchPulse, 5*60*1000);
  setInterval(function(){ if (isMarketHours()) fetchFlow(); }, 3*60*1000);
}
setGroupToggle(true);
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', startPolling);
else startPolling();
render();

})();
</script>
<script src="theme.js"></script>
</body>
</html>
