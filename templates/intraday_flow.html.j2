// ── Dealer compact (ceiling / floor / move / hole) ─────────────────────────
function dealerCompact(d, quote) {
  if (!d) return '<span class="dealer-na">'+lz('no chain','无期权链')+'</span>';
  var out = [];
  var regime = d.regime === 'long' ? 'rd-long' : (d.regime === 'short' ? 'rd-short' : 'rd-neutral');
  var regimeWord = d.regime === 'long' ? lz('pins / mean-reverts','磁吸/均值回归') : (d.regime === 'short' ? lz('trends / amplifies','趋势/放大') : lz('neutral','中性'));
  out.push('<div class="dealer-line"><span class="regime-dot '+regime+'"></span>'+regimeWord+'</div>');
  if (d.call_wall != null) {
    var hard = d.call_wall_hard ? lz(' (hard)',' (硬)') : '';
    out.push('<div class="dealer-line">'+lz('ceiling','天花板')+' ~$'+fmtNum(d.call_wall,0)+hard+'</div>');
  }
  if (d.put_wall != null) out.push('<div class="dealer-line">'+lz('floor','地板')+' ~$'+fmtNum(d.put_wall,0)+'</div>');
  if (d.expected_move_daily_pct != null) out.push('<div class="dealer-line muted">'+lz('~'+fmtNum(d.expected_move_daily_pct,1)+'% expected move','~预期波动约'+fmtNum(d.expected_move_daily_pct,1)+'%')+'</div>');
  if (d.vol_hole_state && d.vol_hole_state !== 'NONE') {
    var vh = { IN_HOLE: lz('pinned between walls','被夹在墙位间'), COILED_UP: lz('coiled — upward','蓄势向上'),
      COILED_DOWN: lz('coiled — downward','蓄势向下'), EXPANSION: lz('breaking out','正在扩张') }[d.vol_hole_state];
    if (vh) out.push('<div class="dealer-line" style="color:var(--ink-orange, var(--orange,#e08b45))">'+vh+'</div>');
  }
  return out.join('');
}

