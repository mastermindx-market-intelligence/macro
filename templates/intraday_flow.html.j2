            <th data-col="ticker" class="col-ticker" scope="col" aria-sort="none"><button type="button" class="ift-sort">{{ t('Name', '代码') }}<span class="sort-ic" aria-hidden="true"></span></button></th>
            <th data-col="stance" class="col-stance" scope="col" aria-sort="none"><button type="button" class="ift-sort">{{ t('Setup · next confirmation', '布局 · 下一确认') }}<span class="sort-ic" aria-hidden="true"></span></button></th>
            <th data-col="last" class="col-last" scope="col" aria-sort="none"><button type="button" class="ift-sort">{{ t('Price', '价格') }}<span class="sort-ic" aria-hidden="true"></span></button></th>
            <th data-col="rvol" class="col-rvol" scope="col" aria-sort="none"><button type="button" class="ift-sort">{{ t('Activity', '活跃度') }}<span class="sort-ic" aria-hidden="true"></span></button>{{ help('This session\'s volume vs a normal day at this exact time. “2.4× normal” means 2.4 times the usual pace. “Holding” = buyers keep closing bars in the upper half on above-normal volume.', '本时段成交量与同一时段正常水平之比。“2.4×正常”即为通常速度的2.4倍。“持稳”=买盘持续将K线收在上半段且量高于正常。') }}</th>
            <th data-col="tape" class="ift-detail-column" scope="col">{{ t('Tape', '盘口') }}</th>
            <th data-col="dealer" class="ift-detail-column" scope="col">{{ t('Dealer map', '做市商地图') }}</th>
            <th data-col="expand" class="col-expand" scope="col"><span class="sr-only">{{ t('Evidence', '依据') }}</span></th>
          </tr></thead>
