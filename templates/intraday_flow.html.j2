{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro help(en, zh='') -%}
<span class="help"><button type="button" class="help-trigger" id="ift-activity-help" popovertarget="ift-activity-tip" aria-controls="ift-activity-tip" aria-describedby="ift-activity-tip" aria-label="Explain activity">?</button><span class="tip" id="ift-activity-tip" popover role="note"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% set ift = intraday_flow if intraday_flow else {} %}
{% set leaders = ift.leaders if ift.leaders else [] %}
{% set rvol_confirm = ift.rvol_confirm if ift.rvol_confirm is defined else 1.30 %}
{% set dur_min = ift.durability_min if ift.durability_min is defined else 0.60 %}
{% set washout_lb = ift.washout_lookback if ift.washout_lookback is defined else 10 %}
