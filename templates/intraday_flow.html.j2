// ══ compute-once pipeline (shared by summary, scan and evidence) ═══════════════
function computeAll() {
  return leaders.map(function(l){
    var rawQ = quoteState[l.ticker], rawP = pulseState[l.ticker], rawF = flowState[l.ticker];
    var q = rawQ && typeof rawQ === 'object' ? rawQ : null;
    var p = rawP && typeof rawP === 'object' ? rawP : null;
    var f = rawF && typeof rawF === 'object' ? rawF : null;
    var conf = computeLegs(l, q, p, f);
    var st = computeStance(l, q, p, f, conf);
    return { l:l, q:q, p:p, f:f, conf:conf, st:st,
             rvol:computeRvol(l,q,p), vwapDelta:computeVwapDelta(q,p), rangePos:computeRangePos(q),
             d:dealerOf(l), meta:STANCE_META[st.key]||STANCE_META.stand_aside };
  });
}
function laneCounts(rows) {
  var c = { act:0, get_ready:0, in_favour:0, take_profits:0, watch:0, stand_aside:0 };
  rows.forEach(function(r){ if (c[r.st.key]!=null) c[r.st.key]++; });
  return c;
}

// ── count-up animation ─────────────────────────────────────────────────────
function animateCount(el, to) {
  if (!el) return;
  var from = parseInt(el.getAttribute('data-cv')||'0',10) || 0;
  el.setAttribute('data-cv', String(to));
  if (REDUCED_MOTION || from === to) { el.textContent = String(to); return; }
  var start = null, dur = 550;
  function step(ts){ if (start==null) start=ts; var k=Math.min((ts-start)/dur,1); var e=1-Math.pow(1-k,3);
    el.textContent = String(Math.round(from + (to-from)*e)); if (k<1) requestAnimationFrame(step); }
  requestAnimationFrame(step);
}

// ══ HERO — Session Pulse ═══════════════════════════════════════════════════
function buildHero(rows, counts) {
  var phase = sessionPhase();
  var pill = document.getElementById('sess-pill'), sstate = document.getElementById('sess-state');
  // SessionPhase is the existing ET clock window, not an exchange-calendar authority.
  var pmap = { live:['sess-live', lz('Regular-session window','常规交易时段')],
    pre:['sess-pre', lz('Pre-market window','盘前时段')],
    post:['sess-post', lz('After-hours window','盘后时段')],
    closed:['sess-closed', lz('Outside session hours','非交易时段')] };
  if (pill) pill.className = 'sess-pill '+pmap[phase][0];
  if (sstate) sstate.innerHTML = pmap[phase][1];
  var thesis, sub;
  if (!leaders.length) {
    thesis = lz('The scan is unavailable.','扫描暂不可用。');
    sub = lz('The watchlist could not be loaded. Refresh to check again.','观察名单未能加载。刷新后重试。');
  } else if (quotesStatus === 'connecting' || pulseStatus === 'connecting') {
    thesis = lz('Checking the latest observations.','正在检查最新观测。');
    sub = lz('Recorded classifications remain visible while the sources connect.','连接数据来源期间，仍显示已有分类供参考。');
  } else if (quotesStatus !== 'live') {
    thesis = lz('Current prices are unavailable.','当前价格暂不可用。');
    sub = lz('Recorded classifications only; current confirmation is unavailable.','已有分类仅供参考，当前确认依据不可用。');
  } else if (pulseStatus !== 'live' || pulseSourceStale === true) {
    thesis = lz('Price observations received. Confirmation is incomplete.','已收到价格观测，确认依据尚不完整。');
    sub = lz('Volume evidence is missing or marked stale. Recorded classifications are reference only.','成交量依据缺失或已标记过期，已有分类仅供参考。');
  } else if (phase !== 'live') {
    thesis = lz('Review the recorded scan.','查看已有扫描。');
    sub = lz('Outside the regular-session window. Check source times before interpreting a setup.','当前不在常规交易时段内。解读布局前，请核对来源时间。');
  } else {
    thesis = lz('The latest received observations, in one view.','一览最近收到的观测。');
    sub = lz('Prices are delayed. Source availability does not establish a fresh trading signal.','价格存在延迟。数据已收到，并不代表当前交易信号已确认。');
  }
  var thEl = document.getElementById('hero-thesis'); if (thEl) thEl.innerHTML = thesis;
  var subEl = document.getElementById('hero-sub'); if (subEl) subEl.innerHTML = sub;
  var mode = document.getElementById('ift-record-mode');
  if (mode) mode.innerHTML = lz('Recorded classifications · select to filter','已有分类 · 点击筛选');
  iftSkelDone(document.getElementById('ift-hero-copy'));
  updateFlowStamp(flowAsof, flowMeta);
  updateSourceTimes();
}
