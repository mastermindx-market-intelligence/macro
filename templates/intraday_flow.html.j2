var COL_ATTR = { ticker:'data-ticker', last:'data-last', rvol:'data-rvol', stance:'data-stance-order', dealer:'data-rvol' };
function sortRows(rows) {
  var attr = COL_ATTR[sortCol] || 'data-rvol';
  rows.sort(function(a,b){
    if (groupByStance) {
      var ao = Number(a.getAttribute('data-stance-order')||9), bo = Number(b.getAttribute('data-stance-order')||9);
      if (ao !== bo) return ao - bo;   // group order fixed; sort within by measured
      var ar = Number(a.getAttribute('data-rvol')||0), br = Number(b.getAttribute('data-rvol')||0);
      return br - ar;
    }
    var av = a.getAttribute(attr)||'0', bv = b.getAttribute(attr)||'0';
    var an = isNaN(av)?av:Number(av), bn = isNaN(bv)?bv:Number(bv);
    if (an < bn) return -sortDir; if (an > bn) return sortDir; return 0;
  });
  return rows;
}
