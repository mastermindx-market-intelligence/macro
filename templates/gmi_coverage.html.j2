{% extends "_gmi_base.html.j2" %}
{% from "_gmi_macros.html.j2" import t, ic, mark, d, sec with context %}
{% block title %}GMI Explorer — Coverage &amp; methodology{% endblock %}
{% block seo %}{% set seo_title = 'GMI Explorer — Coverage & methodology | Mastermind' %}{% set seo_desc = 'Core-theme company coverage by market, with company and listing populations kept separate, count definitions and source clocks.' %}{% set seo_path = 'gmi-coverage.html' %}{% include "_seo_head.html.j2" %}{% endblock %}
{% block body %}
{# The market proof counts resolved issuers and unresolved securities in one
   remainder map. Only IDENTITY_NOT_QUALIFIED contains both populations.
   Split its listing contribution before displaying company reasons. Keep the
   producer's bounds and admission decisions unchanged; never clamp a mismatch.
   Template tests account for every reason in the configured word-map order. #}
{% set core_ids = [] %}
{% set core = namespace(admitted=0, proposed_only=0) %}
{% for mid, m in model.micros.items() %}
  {% if m.tier == 'acceptance' %}
    {% set _ = core_ids.append(mid) %}
    {% if m.admitted > 0 %}{% set core.admitted = core.admitted + 1 %}{% endif %}
    {% if m.disposition == 'PROPOSED_ONLY' %}{% set core.proposed_only = core.proposed_only + 1 %}{% endif %}
  {% endif %}
{% endfor %}
<section class="gmi-coverage-overview" aria-labelledby="cov-h">
  <h2 id="cov-h">{{ t('Core-theme company coverage', '核心主题公司覆盖') }}</h2>
  <div class="gmi-coverage-markets">
  {% for mkt, mkt_en, mkt_zh in [('us', 'US', '美国'), ('cn', 'China', '中国')] %}
    {% set mrow = model.coverage[mkt] %}
    {% set bnds = mrow.denominator.issuer_count_bounds %}
    {% set unresolved = mrow.denominator.eligible_securities_unresolved_issuer %}
    {% set matched = mrow.denominator.eligible_issuers_resolved %}
    {% set parts = [] %}
    {% for code in model.reason_words %}
      {% if code in mrow.remainder_by_reason %}
        {% set count = mrow.remainder_by_reason[code] - (unresolved if code == 'IDENTITY_NOT_QUALIFIED' else 0) %}
        {% if count > 0 %}{% set _ = parts.append({'code': code, 'count': count}) %}{% endif %}
      {% endif %}
    {% endfor %}
    <article class="gmi-coverage-market" data-gmi-coverage-market="{{ mkt }}" aria-labelledby="cov-{{ mkt }}-h">
      <h3 id="cov-{{ mkt }}-h">{{ t(mkt_en, mkt_zh) }}</h3>
      <div class="gmi-coverage-admitted"><strong>{{ mrow.numerator_issuers|num }}</strong><span>{{ t('admitted companies', '家获准纳入的公司') }}</span></div>
      <dl class="gmi-coverage-counts">
        <div class="gmi-coverage-bound"><dt>{{ t('Company count range', '公司数量范围') }}</dt><dd>{{ bnds[0]|num }}{% if bnds[0] != bnds[1] %}–{{ bnds[1]|num }}{% endif %}</dd></div>
        <div class="gmi-coverage-matched"><dt>{{ t('Matched companies', '已匹配公司') }}</dt><dd>{{ matched|num }}</dd></div>
        {% if unresolved > 0 %}<div class="gmi-coverage-unmatched"><dt>{{ t('Listings without a company match', '未匹配到公司的上市证券') }}</dt><dd>{{ unresolved|num }}</dd></div>{% endif %}
      </dl>
      {% if parts %}
      <details class="gmi-coverage-reasons">
        <summary>{{ t((matched - mrow.numerator_issuers)|num ~ (' company not counted' if matched - mrow.numerator_issuers == 1 else ' companies not counted'), (matched - mrow.numerator_issuers)|num ~ ' 家公司未计入') }}{{ ic('arrow', 16) }}</summary>
        <dl class="gmi-coverage-reason-list">
        {% for part in parts %}<div><dt>{{ t(model.reason_words[part.code].en, model.reason_words[part.code].zh) }}</dt><dd><b>{{ part.count|num }}</b> {{ t('company' if part.count == 1 else 'companies', '家公司') }}</dd></div>{% endfor %}
        </dl>
      </details>
      {% endif %}
    </article>
  {% endfor %}
  </div>
</section>

<section class="gmi-panel gmi-coverage-themes" aria-labelledby="cov-themes-h">
  <h2 id="cov-themes-h">{{ t('Core-theme activity', '核心主题活动') }}</h2>
  <div class="gmi-coverage-theme-totals">
    <span><b>{{ core.admitted|num }}</b>{{ t('core theme with admitted activity' if core.admitted == 1 else 'core themes with admitted activity', '个核心主题有获准纳入的活动') }}</span>
    <span><b>{{ ((core_ids|length) - core.admitted)|num }}</b>{{ t('core theme without admitted activity' if (core_ids|length) - core.admitted == 1 else 'core themes without admitted activity', '个核心主题暂无获准纳入的活动') }}</span>
  </div>
  <div class="gmi-strip68" aria-hidden="true">{% for mid in core_ids | ordered %}{{ mark('adm' if model.micros[mid].admitted > 0 else 'acc') }}{% endfor %}</div>
  <p class="gmi-note gmi-coverage-scope">{{ t((core_ids|length)|num ~ ' core micro-themes counted. ' ~ (model.totals.extended|num) ~ ' extended micro-themes shown separately and excluded from coverage.', '统计 ' ~ (core_ids|length)|num ~ ' 个核心细分主题。' ~ (model.totals.extended|num) ~ ' 个扩展细分主题单独展示，不计入覆盖。') }}</p>
  {% if core.proposed_only %}<p class="gmi-note gmi-coverage-proposed">{{ t('Of those without admitted activity, ' ~ (core.proposed_only|num) ~ (' has proposals only.' if core.proposed_only == 1 else ' have proposals only.'), '尚无获准纳入活动的主题中，' ~ (core.proposed_only|num) ~ ' 个仅有待审核提议。') }}</p>{% endif %}
</section>

<details class="gmi-coverage-method">
  <summary><h2>{{ t('Method & sources', '方法与来源') }}</h2>{{ ic('arrow', 18) }}</summary>
  <div class="gmi-coverage-method-body">
    <section><h3>{{ t('What is counted', '计入条件') }}</h3><p>{{ t('Each market counts a company once when its identity qualifies and it has a current, admitted activity link to a core theme. Extended-theme links do not enter this count.', '公司身份核验通过，且与核心主题具有当前有效、获准纳入的活动关联时，才计入相应市场；每家公司仅计一次。扩展主题的关联不计入。') }}</p><p>{{ t('Theme counts measure themes with admitted activity, not distinct companies. Public company evidence has a separate publication check.', '主题计数衡量具有获准活动的主题数量，并非去重后的公司数量。公开公司证据另行经过发布核验。') }}</p></section>
    <section><h3>{{ t('Why a range', '区间的含义') }}</h3><p>{{ t('Matched companies are linked to company records; identity checks are separate. Unmatched listings cannot yet be counted as distinct companies.', '已匹配表示已关联公司记录；身份核验另行判断。未匹配的上市证券尚不能按独立公司计数。') }}</p><p>{{ t('The source adds between one and the number of unmatched listings to the matched-company count. With no unmatched listings, it reports one exact count.', '来源以已匹配公司数量为基础：存在未匹配证券时，增加 1 至未匹配证券数量，形成区间；没有未匹配证券时，显示确定的公司数量。') }}</p></section>
    <section class="gmi-coverage-sources"><h3>{{ t('Source clocks', '来源与时间') }}</h3><dl class="gmi-dl"><div><dt>{{ t('Snapshot as of', '快照截至') }}</dt><dd><time datetime="{{ model.asof }}">{{ d(model.asof) }}</time></dd></div><div><dt>{{ t('Coverage model generated', '覆盖模型生成于') }}</dt><dd><time datetime="{{ model.provenance.built_at_utc }}">{{ d(model.provenance.built_at_utc[:10]) }} · {{ model.provenance.built_at_utc[11:16] }} UTC</time></dd></div><div><dt>{{ t('Sources', '来源') }}</dt><dd>{{ t('Company filings · Exchange symbol directory · Review records', '公司披露文件 · 交易所证券代码目录 · 审核记录') }}</dd></div></dl></section>
    <section class="gmi-coverage-corrections"><h3>{{ t('Corrections log', '更正记录') }}</h3><dl class="gmi-dl"><div><dt>{{ t('Relationships', '公司关系') }}</dt><dd class="gmi-muted">{{ t('Public correction history is not available in this snapshot.', '此快照尚无可公开展示的更正历史。') }}</dd></div><div><dt>{{ t('Theme links', '主题关联') }}</dt><dd class="gmi-muted">{{ t('Changes are not tracked yet.', '变更尚未跟踪。') }}</dd></div></dl></section>
    <section class="gmi-coverage-accuracy"><h3>{{ t('Accuracy check', '准确性抽查') }}</h3><p><strong>{{ t('Not measured yet', '尚未衡量') }}</strong></p><p>{{ t('This snapshot does not include an accuracy sample or an accuracy rate.', '此快照不包含准确性样本或准确率。') }}</p></section>
  </div>
</details>
{% endblock %}
