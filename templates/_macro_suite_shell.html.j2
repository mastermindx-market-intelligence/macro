  {{ withheld(view) }}
</main>
{{ evidence_drawer(view) }}
{%- endif %}
{%- endmacro -%}

{# ─────────────── assembled page body — decision-first ordering ─────────────
   Authorized for the Liquidity Regime pattern-setter alone by the Sol ruling of
   2026-09-05 (research/market_intelligence_productization/
   MARKET_ONTOLOGY_F01_R1_DECISION_FIRST_AMENDMENT_2026-09-05.md).

   Same macros, same view model, same facts — a different order of ARRIVAL:

       state -> what changed -> why it matters -> next action
             -> diagnostics, drivers, history, components, evidence on demand

   Every page still enters through body()/degraded_body(), so the reuse contract
   in tests/test_macro_suite_pages.py is untouched and extending the pattern to a
   further workspace stays one flag in the builder.                            #}
{%- macro decision_first_body(view) -%}
<main class="mq-shell mq-shell-decision" id="mq-shell">
  {{ context_header_compact(view) }}
  {{ headline_band(view) }}
  {{ glance_brief(view) }}
  {{ next_action(view) }}

  {#- Study depth. The full change table and the complete implications ribbon are
      demoted, never removed, and never more than one deliberate action away.
      They sit BELOW the action in DOM order on purpose: putting them above it is
      what pushed the action 1377px down the desktop page and 2200px down mobile. -#}
  <details class="mq-study">
    <summary class="mq-study-summary">
      <span class="mq-study-summary-label">{{ t('Full change table and implications', '完整变化表与推论') }}</span>
      <span class="mq-study-summary-hint">{{ t('Every metric, every published implication', '全部指标与全部已发布推论') }}</span>
    </summary>
    <div class="mq-study-body">
      {{ what_changed(view) }}
      {{ implications_ribbon(view) }}
    </div>
  </details>

  <div class="mq-workspace">
    {{ tab_bar(view) }}
    <button type="button" class="mq-evidence-button" data-mq-open-evidence>
      <span aria-hidden="true">↗</span> {{ t('Evidence & sources', '证据与来源') }}
    </button>

    <section class="mq-panel" id="mq-panel-current" role="tabpanel"
             aria-labelledby="mq-tab-current" data-mq-panel="current" tabindex="0">
      {{ quadrant_map(view) }}
      {{ diagnostics(view) }}
      {{ component_metrics(view) }}
    </section>

    <section class="mq-panel" id="mq-panel-drivers" role="tabpanel"
             aria-labelledby="mq-tab-drivers" data-mq-panel="drivers" tabindex="0">
      {{ driver_tables(view) }}
      {{ axis_method(view) }}
    </section>

    <section class="mq-panel" id="mq-panel-history" role="tabpanel"
             aria-labelledby="mq-tab-history" data-mq-panel="history" tabindex="0">
      {{ component_histories(view) }}
      {{ lineage(view) }}
    </section>
  </div>

  {{ context_detail(view) }}
  {{ withheld(view) }}
</main>
{{ evidence_drawer(view) }}
{%- endmacro -%}

{# ───────────────────── honest refusal (fail-closed) body ───────────────── #}
{%- macro degraded_body(view) -%}
{{ suitenav.suite_bar(suite_nav) }}
<main class="mq-shell mq-shell-degraded" id="mq-shell">
  <header class="mq-context">
    <div class="mq-context-id">
      <p class="mq-kicker">{{ t('Macro & Monetary', '宏观与货币') }}</p>
      <h1>{{ bl(view.workspace.title) }}</h1>
      <p class="mq-deck">{{ bl(view.workspace.subtitle) }}</p>
      <div class="mq-idchips">
        <span class="mq-chip mq-chip-key">{{ t('Region', '地区') }} · {{ bl(view.region.display) }}</span>
        <span class="mq-chip mq-tone-bad">{{ bl(view.failure.label) }}</span>
      </div>
    </div>
    <div class="mq-context-state">
      <dl class="mq-context-meta">
        <div class="mq-nonclock"><dt>{{ t('Page refreshed', '页面更新于') }}</dt><dd>{{ t('Updated once a night — not live.', '每晚更新一次 — 非实时。') }}</dd></div>
      </dl>
    </div>
  </header>

  <section class="mq-refusal" aria-labelledby="mq-refusal-title">
    <span class="mq-refusal-mark" aria-hidden="true">⌁</span>
    <h2 id="mq-refusal-title">{{ bl(view.failure.headline) }}</h2>
    <p class="mq-refusal-body">{{ bl(view.failure.body) }}</p>
    <dl class="mq-method-grid">
      <div><dt>{{ t('Why', '原因') }}</dt><dd>{{ bl(view.failure.label) }}</dd></div>
    </dl>
    <p class="mq-refusal-next">{{ bl(view.failure.next) }}</p>
    {#- The reader is owed the refusal and what happens next. The paths, the
        contract id and the raw detail string are for whoever repairs it, so they
        are one deliberate action away rather than in the reading path. -#}
    <details class="mc-details">
      <summary>{{ t('Technical detail', '技术细节') }}</summary>
      <div class="mc-details-body mq-refusal-receipt">
      <p>{{ t('Technical detail for whoever repairs this', '供修复者查看的技术细节') }}</p>
      <p>{{ t('Typed reason', '类型化原因') }}</p>
      <p>{{ t('Page built', '页面生成') }}</p>
      <dl class="mq-method-grid">
        <div class="mq-nonclock"><dt>{{ t('Page built', '页面生成') }}</dt><dd><time>{{ view.page_built_at }}</time></dd></div>
        <div><dt>{{ t('Detail', '详情') }}</dt><dd><code class="mq-refusal-detail">{{ view.failure.detail }}</code></dd></div>
        <div><dt>{{ t('Artifact path', '产物路径') }}</dt><dd><code>{{ view.artifact.path }}</code></dd></div>
        <div><dt>{{ t('Manifest path', '清单路径') }}</dt><dd><code>{{ view.artifact.manifest_path }}</code></dd></div>
        <div><dt>{{ t('Client contract', '客户端契约') }}</dt><dd><code>{{ view.artifact.min_client_contract }}</code></dd></div>
      </dl>
      </div>
    </details>
  </section>
</main>
{%- endmacro -%}
