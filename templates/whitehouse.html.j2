{% extends "report_base.html.j2" %}
{% macro t(en, zh='') -%}
<span class="l-en" lang="en">{{ en|safe }}</span><span class="l-zh" lang="zh-Hans">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}

{# Existing liquidity-plumbing UI labels: canonical template owner committee.html.j2.
   Copy only labels, never its internal route, controls or model authority. #}
{% macro state_label(value, pairs) -%}
{% if value is string and value in pairs %}{{ t(pairs[value][0], pairs[value][1]) }}{% else %}{{ value }}{% endif %}
{%- endmacro %}
{% set PL_STATE = {'benign_liquidity_tailwind':['Benign Tailwind','良性顺风'],'mechanical_liquidity_tailwind':['Mechanical Tailwind','机械性顺风'],'stress_liquidity_expansion':['Stress Expansion','压力扩张'],'neutral_with_buffer':['Neutral — Buffer Intact','中性 — 缓冲充足'],'neutral_hollow':['Neutral — Hollow','中性 — 缓冲耗尽'],'orderly_drain':['Orderly Drain','有序收缩'],'data_degraded':['Data Degraded','数据降级']} %}
{% set RRP_STATE = {'abundant':['Abundant','充裕'],'adequate':['Adequate','充分'],'exhausted':['Exhausted','耗尽'],'unknown':['Unknown','未知']} %}
{% set RESERVE_STATE = {'comfortable':['Comfortable','宽松'],'normalizing':['Normalizing','正常化'],'tightening':['Tightening','趋紧'],'scarce':['Scarce','稀缺'],'unknown':['Unknown','未知']} %}
{% block title %}White House Watch{% endblock %}

{%- block head_extra %}
{% set seo_title = "White House Watch — Mastermind" %}
{% set seo_desc = "Policy moves from the White House read for markets — executive actions, trade policy and what reprices." %}
{% set seo_path = "whitehouse.html" %}
{%- include "_seo_head.html.j2" %}
{%- endblock %}

{% block base_css %}
  .wh-hero,.wh-tre,.wh-list,.wh-empty,.wh-pagedisc { max-width:1060px; margin:24px auto 0; }
  .wh-hero,.wh-tre,.wh-card,.wh-empty,.wh-pagedisc { background:var(--panel); border:1px solid var(--line); border-radius:var(--r-panel,14px); padding:24px; box-shadow:var(--card-shadow); }
  html[data-theme="dark"] :is(.wh-hero,.wh-tre,.wh-card,.wh-empty,.wh-pagedisc) { box-shadow:none; border-color:var(--line-quiet); }
  html[data-theme="light"] :is(.wh-hero,.wh-tre,.wh-card) { background:var(--panel); box-shadow:var(--card-shadow); }
  .wh-kick,.wh-tre .tk { font-size:var(--fs-label); color:var(--muted); margin:0 0 8px; font-weight:600; letter-spacing:.06em; }
  .wh-hero h1 { font-size:var(--fs-h1); line-height:1.2; margin:0 0 8px; font-weight:800; }
  .wh-hero .sub,.wh-tre p.sub { font-size:var(--fs-md); color:var(--text); margin:0; max-width:68ch; }
  .wh-method { margin-top:16px; color:var(--muted); max-width:72ch; }
  .wh-method summary,.wh-outline summary { cursor:pointer; font-weight:600; min-height:40px; align-content:center; }
  .wh-method p { font-size:var(--fs-sm); line-height:1.65; }
  .wh-list { display:flex; flex-direction:column; gap:24px; }
  .wh-card { scroll-margin-top:84px; min-width:0; }
  .wh-card .row1 { display:flex; flex-wrap:wrap; align-items:center; gap:8px 12px; margin-bottom:12px; }
  .wh-badge,.wh-chip { font-size:var(--fs-label); font-weight:600; padding:4px 8px; border-radius:var(--r-pill,999px); border:1px solid var(--line); white-space:nowrap; }
  .wh-badge.live,.wh-badge.tre,.wh-chip.mut { color:var(--text); background:var(--panel2); }
  .wh-badge.tone-tailwind,.wh-dir.benefit,.wh-chg.up,.wh-stat .up { color:var(--ink-up); }
  .wh-badge.tone-headwind,.wh-dir.hurt,.wh-chg.dn,.wh-stat .dn { color:var(--ink-down); }
  .wh-badge.tone-mixed,.wh-chip.amber { color:var(--ink-warn); }
  .wh-badge.tone-neutral,.wh-dir.neutral,.wh-when { color:var(--muted); }
  .wh-chip.green { color:var(--ink-ok); } .wh-chip.red { color:var(--ink-act); }
  .wh-when { font-size:var(--fs-sm); }
  .wh-card h2 { font-size:var(--fs-num-lg); line-height:1.3; margin:0 0 12px; max-width:48ch; font-weight:800; }
  .wh-summary { font-size:var(--fs-md); line-height:1.65; max-width:68ch; margin:0 0 20px; }
  .wh-reader-layout { display:grid; grid-template-columns:minmax(0,1fr) 220px; grid-template-areas:"reading rail"; gap:32px; align-items:start; }
  .wh-reading { grid-area:reading; min-width:0; }
  .wh-report-tools { grid-area:rail; min-width:0; }
  .wh-outline { background:var(--panel2); border:1px solid var(--line); border-radius:var(--r-card,12px); padding:8px 12px; }
  html[data-theme="light"] .wh-outline { background:var(--bg); }
  .wh-outline nav { display:flex; flex-direction:column; gap:4px; padding:8px 0; }
  .wh-outline a { display:block; padding:8px; min-height:40px; color:var(--ink-link); font-size:var(--fs-sm); text-decoration:none; border-radius:var(--r-ctl,8px); }
  .wh-outline a[aria-current="location"] { color:var(--text); background:var(--panel); font-weight:700; }
  .wh-outline a:focus-visible,.wh-method summary:focus-visible,.wh-outline summary:focus-visible,.wh-src a:focus-visible { outline:2px solid var(--ink-link); outline-offset:3px; }
  .wh-reading [id] { scroll-margin-top:96px; }
  .wh-reading [id]:target { outline:2px solid var(--ink-link); outline-offset:4px; }
  .wh-language,.wh-disc,.wh-pagedisc,.wh-tre .foot { color:var(--muted); font-size:var(--fs-sm); line-height:1.65; }
  .wh-language { margin:0 0 16px; }
  .wh-body { max-width:68ch; font-size:var(--fs-body); line-height:1.75; }
  .wh-body p { margin:0 0 16px; }
  .wh-sub-h { font-size:var(--fs-h3); color:var(--text); margin:24px 0 12px; font-weight:700; }
  table.wh-tbl { border-collapse:collapse; width:100%; font-size:var(--fs-sm); margin:4px 0 16px; }
  table.wh-tbl th { text-align:left; padding:8px 12px; background:var(--panel2); color:var(--muted); font-weight:600; border-bottom:1px solid var(--line); }
  table.wh-tbl td { padding:8px 12px; border-bottom:1px solid var(--line); vertical-align:top; line-height:1.6; }
  .wh-dir,.wh-chg,.wh-sym { font-weight:600; font-variant-numeric:tabular-nums; }
  .wh-dir { font-size:var(--fs-label); white-space:nowrap; }
  a.wh-sym { color: inherit; text-decoration: underline dotted; text-underline-offset:3px; padding-block:6px; }
  .wh-chg { font-size:var(--fs-sm); }
  .wh-src { font-size:var(--fs-sm); margin:24px 0 16px; }
  .wh-src a { color:var(--ink-link); overflow-wrap:anywhere; }
  .wh-disc { border-top:1px solid var(--line); padding-top:12px; max-width:72ch; }
  .wh-meter { color:var(--muted); font-size:var(--fs-sm); margin-top:16px; }
  .wh-meter .bar { display:block; width:100%; height:4px; margin:8px 0; border-radius:var(--r-ctl,8px); background:var(--line-quiet); overflow:hidden; }
  .wh-meter .bar > i { display:block; height:100%; background:var(--muted); }
  .wh-meter .wh-meter-label { display:block; line-height:1.6; }
  .wh-empty { text-align:left; color:var(--muted); }
  .wh-stats { display:flex; flex-wrap:wrap; gap:12px; margin:16px 0; }
  .wh-stat { flex:1 1 150px; min-width:138px; background:var(--panel2); border:1px solid var(--line); border-radius:var(--r-card,12px); padding:12px; }
  .wh-stat .lab { font-size:var(--fs-label); color:var(--muted); margin:0 0 4px; }
  .wh-stat .val { font-size:var(--fs-num-lg); font-weight:700; font-variant-numeric:tabular-nums; line-height:1.2; }
  .wh-stat .val .u,.wh-stat .delta { font-size:var(--fs-sm); }
  .wh-tre h2 { font-size:var(--fs-h2); margin:0 0 8px; }
  .wh-tre .impulse { font-size:var(--fs-body); line-height:1.65; margin:16px 0; padding:12px; background:var(--panel2); border:1px solid var(--line); border-radius:var(--r-card,12px); }
  .wh-tre .sparkwrap { margin:16px 0 4px; }
  .wh-tre .sparkcap { display:flex; justify-content:space-between; font-size:var(--fs-label); color:var(--muted); font-variant-numeric:tabular-nums; }
  .wh-spark { width:100%; height:64px; display:block; }
  .wh-tre .foot { border-top:1px solid var(--line); padding-top:12px; margin:16px 0 0; }
  html[data-lang="zh"] :is(.wh-kick,.wh-tre .tk) { letter-spacing:normal; }
  @media(max-width:820px) { .wh-reader-layout { grid-template-columns:minmax(0,1fr); grid-template-areas:"rail" "reading"; gap:20px; } }
  @media(max-width:480px) { .wh-hero,.wh-tre,.wh-card,.wh-empty,.wh-pagedisc { padding:16px; } .wh-list { gap:16px; } .wh-card h2 { overflow-wrap:anywhere; } }
{% endblock %}

{% block content %}
<header class="wh-hero">
  <p class="wh-kick">{{ t('White House Watch', '白宫快讯') }}</p>
  <h1>{{ t('Policy reports', '政策报告') }}</h1>
  <p class="sub">{{ t('Dated sources, AI context, and the original evidence to check.', '查看来源日期、AI解读与可核对的原文。') }}</p>
  <details class="mx-disc wh-method"><summary>{{ t('How to read this desk', '如何阅读本页') }}</summary><p>{{ t('Source publication and the date an AI read was written are separate. Original AI text is retained; translated titles and summaries appear where available. Named fallback models are shown when recorded. A live badge describes the banner period, not a new event or a verified conclusion.', '来源发布与AI解读撰写日期分别列示。AI正文保留原文；如有译文，将显示中文标题与摘要。流程记录了备用模型时会注明。生效标签指横幅展示期，不代表新事件或结论已获验证。') }}</p></details>
</header>

{% if treasury %}
{% set tg = treasury.tga %}
{% set nl = treasury.net_liquidity %}
{% set pl = treasury.plumbing %}
{% set imp = treasury.tga_impulse %}
{% set mc = treasury.market_context %}
{% set hs = (pl.headline_state if pl else '') or '' %}
{% set hcls = 'green' if hs.startswith('benign') else ('red' if (hs.startswith('orderly_drain') or hs.startswith('contract')) else ('amber' if hs.startswith('stress') else 'mut')) %}
<section class="wh-tre" id="treasury-watch">
  <p class="tk">{{ t('Treasury Watch', '财政部观察') }}</p>
  <h2>{{ t('Treasury liquidity — the TGA read', '财政部流动性 · TGA 解读') }}</h2>
  <p class="sub">{{ t('The Treasury General Account (TGA) is Treasury’s cash at the Fed. When it falls, that cash lands in bank reserves — a mechanical liquidity injection; when it rebuilds, reserves drain. Large quarter-end and debt-ceiling swings can backstop or tighten the tape.',
        '财政部一般账户（TGA）是财政部在美联储的现金余额。余额下降时，现金进入银行准备金——形成机械性的流动性注入；余额回补时，准备金被抽离。季末与债务上限相关的大幅波动可能托底或收紧市场。') }}</p>

  {% if tg %}
  <div class="wh-stats">
    <div class="wh-stat">
      <div class="lab">{{ t('TGA balance', 'TGA 余额') }}{% if tg.asof %} · {{ tg.asof }}{% endif %}</div>
      <div class="val">${{ '%.0f'|format(tg.level_bn) }}<span class="u">bn</span></div>
      {% if tg.chg_1d_bn is not none %}<div class="delta {{ 'up' if tg.chg_1d_bn >= 0 else 'dn' }}">{{ '%+.1f'|format(tg.chg_1d_bn) }} {{ t('1d','单日') }}</div>{% endif %}
      {% if tg.chg_20d_bn is number %}<div class="delta {{ 'up' if tg.chg_20d_bn >= 0 else 'dn' }}">{{ '%+.0f'|format(tg.chg_20d_bn) }} {{ t('20d','20日') }}</div>{% endif %}
    </div>

    {% set qe = tg.quarter_end %}
    {% if qe and qe.chg_since_bn is not none %}
    <div class="wh-stat">
      <div class="lab">{{ t('Δ since quarter-end', '较季末') }}{% if qe.date %} ({{ qe.date[5:] }}){% endif %}</div>
      <div class="val {{ 'up' if qe.chg_since_bn >= 0 else 'dn' }}">{{ '%+.0f'|format(qe.chg_since_bn) }}<span class="u">bn</span></div>
    </div>
    {% elif tg.chg_5d_bn is not none %}
    <div class="wh-stat">
      <div class="lab">{{ t('Δ 5 sessions', '5日变动') }}</div>
      <div class="val {{ 'up' if tg.chg_5d_bn >= 0 else 'dn' }}">{{ '%+.0f'|format(tg.chg_5d_bn) }}<span class="u">bn</span></div>
    </div>
    {% endif %}

    {% if nl and nl.netliq_bn is not none %}
    <div class="wh-stat">
      <div class="lab">{{ t('Net liquidity', '净流动性') }}</div>
      <div class="val">${{ '%.0f'|format(nl.netliq_bn) }}<span class="u">bn</span></div>
      {% if nl.chg_20d_bn is not none %}<div class="delta {{ 'up' if nl.chg_20d_bn >= 0 else 'dn' }}">{{ '%+.0f'|format(nl.chg_20d_bn) }} {{ t('20d','20日') }}{% if nl.pctile_expanding is not none %} · {{ (nl.pctile_expanding * 100)|round|int }}{{ t('th pct','分位') }}{% endif %}</div>{% endif %}
    </div>
    {% endif %}

    {% if pl and pl.rrp_buffer_state %}
    <div class="wh-stat">
      <div class="lab">{{ t('RRP buffer', '逆回购缓冲') }}{% if nl and nl.rrp_bn is number %} · ${{ '%.1f'|format(nl.rrp_bn) }}bn{% endif %}</div>
      <div class="val" style="font-size:var(--fs-md)">{{ state_label(pl.rrp_buffer_state, RRP_STATE) }}</div>
      {% if pl.reserve_scarcity_state %}<div class="delta">{{ t('reserves', '准备金') }}: {{ state_label(pl.reserve_scarcity_state, RESERVE_STATE) }}</div>{% endif %}
    </div>
    {% endif %}

    {% if hs %}
    <div class="wh-stat">
      <div class="lab">{{ t('Plumbing state', '流动性状态') }}</div>
      <div class="val" style="font-size:var(--fs-sm);padding-top:4px"><span class="wh-chip {{ hcls }}">{{ state_label(hs, PL_STATE) }}</span></div>
    </div>
    {% endif %}
  </div>
  {% endif %}

  {% if pl and pl.headline_summary_en %}
  {% if not pl.headline_summary_zh %}<p class="wh-language">{{ t('Retained context · original text', '已保留背景 · 原文展示') }}</p>{% endif %}
  <div class="impulse"><span class="l-en">{{ pl.headline_summary_en }}</span><span class="l-zh">{{ pl.headline_summary_zh or pl.headline_summary_en }}</span></div>
  {% endif %}

  {% if imp and imp.summary_en %}
  <div class="impulse"><span class="l-en">{{ imp.summary_en }}</span><span class="l-zh">{{ imp.summary_zh or imp.summary_en }}</span></div>
  {% endif %}

  {% if tg and tg.spark_points %}
  <div class="sparkwrap">
    <div class="sparkcap"><span>{{ t('TGA · last 60 sessions', 'TGA · 近60个交易日') }}</span>{% if tg.spark_60d %}<span>{{ tg.spark_60d[0][0] }} → {{ tg.spark_60d[-1][0] }}</span>{% endif %}</div>
    <svg class="wh-spark" viewBox="0 0 560 64" preserveAspectRatio="none" aria-hidden="true">
      <polyline fill="none" stroke="var(--link)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" points="{{ tg.spark_points }}"></polyline>
    </svg>
  </div>
  {% endif %}

  <p class="foot">{% if mc and mc.quad_name %}{{ t('Regime', '环境') }}: {{ mc.quad_name }}{% if mc.liquidity_overlay %} · {{ t('Fed liquidity overlay', '联储流动性') }}: {{ mc.liquidity_overlay }}{% endif %} · {% endif %}{{ t('Source: U.S. Treasury Daily Treasury Statement (fiscaldata.treasury.gov). Context only — feeds no score or allocation.',
        '来源：美国财政部每日报表（fiscaldata.treasury.gov）。仅供参考，不参与任何评分或配置。') }}</p>
</section>
{% endif %}

{% if not alerts %}
  <div class="wh-empty">{{ t('No retained reports are available.', '暂无可查看的已保留报告。') }}<p>{{ t('Source links appear with each report when available.', '如有原文链接，将随报告列出。') }}</p></div>
{% else %}
  <div class="wh-list">
  {% for a in alerts %}
    <section class="wh-card{{ ' live' if a.live else '' }}" id="{{ a.id }}">
      <div class="row1">
        {% if a.live %}<span class="wh-badge live">● {{ t('LIVE', '生效中') }}</span>{% endif %}
        {% if a.section == 'treasury' %}<span class="wh-badge tre">{{ t('Treasury', '财政部') }}</span>{% endif %}
        <span class="wh-badge tone-{{ a.tone }}">
          {% if a.tone == 'tailwind' %}{{ t('Tailwind', '顺风') }}
          {% elif a.tone == 'headwind' %}{{ t('Headwind', '逆风') }}
          {% elif a.tone == 'mixed' %}{{ t('Mixed', '涨跌互现') }}
          {% else %}{{ t('Neutral', '中性') }}{% endif %}
        </span>
        <span class="wh-when">{% if a.date_display %}{{ t('Published', '来源发布') }} {{ a.date_display }}{% else %}{{ t('Source date unavailable', '来源日期不可用') }}{% endif %}{% if a.section %} · {% if a.section == 'news' %}{{ t('news', '白宫公告') }}{% elif a.section == 'treasury' %}{{ t('treasury', '财政部') }}{% else %}{{ a.section }}{% endif %}{% endif %}</span>
        {% if a.live and a.expires_display %}<span class="wh-when">· {{ t('banner live until', '横幅有效至') }} {{ a.expires_display }}</span>{% endif %}
        {% if a.generated_display %}<span class="wh-when">· {{ t('read written', '解读撰写于') }} {{ a.generated_display }}</span>{% else %}<span class="wh-when">{{ t('AI read date unavailable', 'AI解读日期不可用') }}</span>{% endif %}
        {% if a.confidence %}<span class="wh-when">· {{ t('AI confidence', 'AI置信度') }}: {% if a.confidence == 'low' %}{{ t('low', '低') }}{% elif a.confidence == 'medium' %}{{ t('medium', '中') }}{% elif a.confidence == 'high' %}{{ t('high', '高') }}{% else %}{{ a.confidence }}{% endif %}</span>{% endif %}
        {% if a.served_by %}<span class="wh-when">· {{ t('read by fallback', '备用模型撰写') }}: {{ a.served_by }}</span>{% endif %}
      </div>

      <h2>{% if a.banner_title_zh %}<span class="l-en">{{ a.banner_title }}</span><span class="l-zh">{{ a.banner_title_zh }}</span>{% else %}{{ a.banner_title }}{% endif %}</h2>

      {% if a.summary %}<p class="wh-summary">{% if a.summary_zh %}<span class="l-en">{{ a.summary }}</span><span class="l-zh">{{ a.summary_zh }}</span>{% else %}{{ a.summary }}{% endif %}</p>{% endif %}

      <div class="wh-reader-layout">
      <aside class="wh-report-tools">
        <details class="mx-disc wh-outline" data-wh-outline><summary id="{{ a.id }}-outline-label">{{ t('On this report', '本篇目录') }}</summary>
          <nav aria-labelledby="{{ a.id }}-outline-label">
            {% if a.paragraphs %}<a href="#{{ a.id }}-analysis">{{ t('AI analysis', 'AI解读') }}</a>{% endif %}
            {% if a.sectors %}<a href="#{{ a.id }}-sectors">{{ t('Sector impact', '行业影响') }}</a>{% endif %}
            {% if a.benefit %}<a href="#{{ a.id }}-benefit">{{ t('Names that benefit', '受益标的') }}</a>{% endif %}
            {% if a.hurt %}<a href="#{{ a.id }}-hurt">{{ t('Names under pressure', '承压标的') }}</a>{% endif %}
            <a href="#{{ a.id }}-source">{{ t('Source and context', '来源与背景') }}</a>
          </nav>
        </details>
      {% if a.importance is not none %}
      <div class="wh-meter">
        <span class="wh-meter-label">{{ t('AI relevance · not a probability', 'AI重要性 · 非概率') }}</span>
        <span class="bar"><i style="width:{{ a.importance }}%"></i></span>
        <span>{{ a.importance }}/100</span>
      </div>
      {% endif %}

      </aside>
      {% set has_original = a.paragraphs or a.sectors or a.benefit or a.hurt %}
      <div class="wh-reading"{% if has_original %} data-ai-original{% endif %}>
      {% if has_original %}<p class="wh-language">{{ t('AI analysis · original text', 'AI解读 · 原文展示') }}<br>{{ t('This AI read is shown in its original language.', 'AI解读按生成时的原文展示。') }}</p>{% endif %}
      {% if a.paragraphs %}
      <h3 class="wh-sub-h" id="{{ a.id }}-analysis" tabindex="-1">{{ t('AI analysis', 'AI解读') }}</h3>
      <div class="wh-body">{% for p in a.paragraphs %}<p>{{ p }}</p>{% endfor %}</div>
      {% else %}<p>{{ t('An AI read is not available for this report. Check the original source.', '此报告暂无AI解读，请核对原文。') }}</p>{% endif %}

      {% if a.sectors %}
      <h3 class="wh-sub-h" id="{{ a.id }}-sectors" tabindex="-1">{{ t('Sector impact', '行业影响') }}</h3>
      <table class="mx-tbl wh-tbl">
        <thead><tr><th>{{ t('Sector', '行业') }}</th><th>{{ t('Impact', '影响') }}</th><th>{{ t('Why', '原因') }}</th></tr></thead>
        <tbody>
        {% for s in a.sectors %}
          <tr>
            <td>{{ s.name }}</td>
            <td>{% if s.impact == 'tailwind' %}<span class="wh-dir benefit">▲ {{ t('Tailwind', '顺风') }}</span>{% elif s.impact == 'headwind' %}<span class="wh-dir hurt">▼ {{ t('Headwind', '逆风') }}</span>{% else %}<span class="wh-dir neutral">◆ {{ t('Mixed', '涨跌互现') }}</span>{% endif %}</td>
            <td>{{ s.rationale }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      {% endif %}

      {% if a.benefit %}
      <h3 class="wh-sub-h" id="{{ a.id }}-benefit" tabindex="-1">{{ t('Names that benefit', '受益标的') }}</h3>
      <table class="mx-tbl wh-tbl">
        <thead><tr><th>{{ t('Ticker', '代码') }}</th><th>{{ t('Recent', '近期') }}</th><th>{{ t('Thesis', '逻辑') }}</th></tr></thead>
        <tbody>
        {% for tk in a.benefit %}
          <tr>
            <td><a class="wh-sym" href="stock.html#{{ tk.symbol }}">{{ tk.symbol }}</a>
            <span class="wh-dir benefit">▲</span></td>
            <td>{% if tk.chg_pct is not none %}<span class="wh-chg {{ 'up' if tk.chg_pct >= 0 else 'dn' }}">{{ '%+.2f'|format(tk.chg_pct) }}%</span>{% else %}<span class="mut">—</span>{% endif %}</td>
            <td>{{ tk.rationale }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      {% endif %}

      {% if a.hurt %}
      <h3 class="wh-sub-h" id="{{ a.id }}-hurt" tabindex="-1">{{ t('Names under pressure', '承压标的') }}</h3>
      <table class="mx-tbl wh-tbl">
        <thead><tr><th>{{ t('Ticker', '代码') }}</th><th>{{ t('Recent', '近期') }}</th><th>{{ t('Thesis', '逻辑') }}</th></tr></thead>
        <tbody>
        {% for tk in a.hurt %}
          <tr>
            <td><a class="wh-sym" href="stock.html#{{ tk.symbol }}">{{ tk.symbol }}</a>
            <span class="wh-dir hurt">▼</span></td>
            <td>{% if tk.chg_pct is not none %}<span class="wh-chg {{ 'up' if tk.chg_pct >= 0 else 'dn' }}">{{ '%+.2f'|format(tk.chg_pct) }}%</span>{% else %}<span class="mut">—</span>{% endif %}</td>
            <td>{{ tk.rationale }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      {% endif %}

      <h3 class="wh-sub-h" id="{{ a.id }}-source" tabindex="-1">{{ t('Source and context', '来源与背景') }}</h3>
      {% if a.source_url %}<p class="wh-src"><a href="{{ a.source_url }}" target="_blank" rel="noopener noreferrer">{% if a.section == 'treasury' %}{{ t('Read the primary Treasury source', '阅读财政部一手来源') }}{% else %}{{ t('Read the primary White House source', '阅读白宫一手来源') }}{% endif %} →</a></p>{% else %}<p class="wh-src">{{ t('Primary-source link unavailable.', '暂无一手来源链接。') }}</p>{% endif %}
      <div class="wh-disc">{{ a.display_disclaimer or a.disclaimer or disclaimer }}</div>
      </div></div>
    </section>
  {% endfor %}
  </div>
{% endif %}

<div class="wh-pagedisc">
  {{ t('Sources: the White House public RSS feeds and the U.S. Treasury Daily Treasury Statement (fiscaldata.treasury.gov, primary). Significance, titles and analysis are generated by',
       '来源：白宫公开 RSS 与美国财政部每日报表（fiscaldata.treasury.gov，一手）。重要性、标题与分析由') }}
  {{ provider or 'Claude' }}{% if n_fallback %} {{ t('(or by the fallback model named on a card)', '（或卡片上注明的备用模型）') }}{% endif %}
  {{ t('— context only, not investment advice. The tickers named are illustrative of plausible exposure, not recommendations, and feed no score or allocation.',
       '生成——仅供参考，不构成投资建议。所列标的仅为可能受影响的示例，并非推荐，且不参与任何评分或配置。') }}
</div>
{% endblock %}

{% block body_scripts %}
<script>
(function(){
  const small=window.matchMedia('(max-width:820px)');
  const outlines=Array.from(document.querySelectorAll('[data-wh-outline]'));
  function size(){outlines.forEach(o=>{if(!o.dataset.whOutlineTouched)o.open=!small.matches;});}
  function target(){outlines.forEach(o=>o.querySelectorAll('a[href^="#"]').forEach(a=>{if(a.hash===location.hash)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current');}));}
  size();target();
  outlines.forEach(o=>{const s=o.querySelector('summary');s.addEventListener('click',()=>{o.dataset.whOutlineTouched='1';});s.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' ')o.dataset.whOutlineTouched='1';});});
  small.addEventListener('change',size);window.addEventListener('hashchange',target);
})();
</script>
{% endblock %}
