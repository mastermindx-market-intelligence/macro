{% from "china_sector.html.j2" import render_regional_sector_detail with context %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro render_hk_sector_chart(s) -%}
  <div class="panel">
    <h2>{{ t('Chart — sector basket', '图表 — 板块篮子') }}</h2>
    <div id="lwchart" style="height:420px;width:100%"></div>
    <p class="muted" style="font-size:11.5px;margin:6px 0 0">{{ t('Equal-weight basket index (rebased) · 50/200-day moving averages · drawn from our stored EOD prices (the free TradingView widget gates HKEX data behind a login)', '等权篮子指数（再基准化）· 50/200 日均线 · 由我方存储的日线数据绘制（免费版 TradingView 组件需登录才能查看港股数据）') }}</p>
    <!-- self-hosted (was unpkg, blocked in mainland China); reuse the vendored v4 bundle at site/ -->
    <script src="../lightweight-charts.js"></script>
    <script>
    (function () {
      var ch = {{ s.chart_json | safe }};
      if (!window.LightweightCharts || !ch || !ch.t || !ch.t.length) return;
      var c = LightweightCharts.createChart(document.getElementById('lwchart'), {
        height: 420, autoSize: true,
        layout: { background: { type: 'solid', color: 'transparent' }, textColor: '#8b93a1',
                  fontFamily: 'Inter, -apple-system, sans-serif' },
        grid: { vertLines: { color: 'rgba(128,138,160,0.12)' }, horzLines: { color: 'rgba(128,138,160,0.12)' } },
        rightPriceScale: { borderColor: 'rgba(128,138,160,0.25)' },
        timeScale: { borderColor: 'rgba(128,138,160,0.25)', timeVisible: false }
      });
      var t = ch.t, v = ch.c;
      c.addAreaSeries({ lineColor: '#3b82f6', topColor: 'rgba(59,130,246,0.28)',
        bottomColor: 'rgba(59,130,246,0.02)', lineWidth: 2, priceLineVisible: false })
        .setData(t.map(function (x, i) { return { time: x, value: v[i] }; }));
      function sma(w) { var o = [], s = 0; for (var i = 0; i < v.length; i++) { s += v[i];
        if (i >= w) s -= v[i - w]; if (i >= w - 1) o.push({ time: t[i], value: +(s / w).toFixed(4) }); } return o; }
      if (v.length >= 50) c.addLineSeries({ color: '#f5a524', lineWidth: 1, priceLineVisible: false,
        lastValueVisible: false, crosshairMarkerVisible: false }).setData(sma(50));
      if (v.length >= 200) c.addLineSeries({ color: '#ef5350', lineWidth: 1, priceLineVisible: false,
        lastValueVisible: false, crosshairMarkerVisible: false }).setData(sma(200));
      c.timeScale().fitContent();
    })();
    </script>
  </div>
{%- endmacro %}
{{ render_regional_sector_detail(
  s,
  '../hk_lookup.html#',
  show_fund=false,
  show_eq_badge=false,
  member_show_name=true,
  holdings_help_en="Representative large-caps in this sector — this sector's curated large-caps (not a float-cap index). Each gets the same cycle/ladder treatment. Click a name for the full single-stock analysis.",
  holdings_help_zh='本板块中具代表性的大盘股 — 本板块精选的大盘股（并非按自由流通市值编制的指数）。每只都享有相同的周期／阶梯分析。点击名称查看完整个股分析。',
  chart_html=render_hk_sector_chart(s)
) }}
