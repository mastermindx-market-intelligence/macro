{#- ── US fresh-trigger rows (.topsetups tbody) (docs/TIER_PREVIEW_PATTERN.md) ─────────────────────────
   Extracted VERBATIM from the `_tsn.resid[:10]` loop that used to live inline in
   dashboard.html.j2 (:16364-16376). ONE source for both consumers so the free
   shell and the paid payload can never drift apart:
     · the shell {% with %}-binds `rows` to the PREVIEW slice and
       {% include %}s this file at the loop's original location;
     · scripts/build_site.py._write_us_payload renders it directly via
       env.get_template("_us_setups_rows.html.j2").render(...) for the LOCKED remainder
       that ships in site/premiumdata/us_stocks.json.
   Carries NO tier logic — the split happens before this partial is called.

   Params:
     rows — the top_setups residual rows to render, already sliced by the caller.
-#}
{#- Local copy of dashboard.html.j2's `t` display macro (:7). Extracted partials
   are self-contained by house convention (_us_board_cards.html.j2 header) — a
   macro from the includer's scope is NOT visible when build_site renders this
   file directly for the paid payload. -#}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% for r in rows %}
  <tr class="ts-row" data-tkr="{{ r.ticker }}">
    <td class="c-stock"><a class="ts-tk-a" href="stock.html#{{ r.ticker }}"><span class="ts-tk">{{ r.ticker }}</span></a> <span class="ts-nm">{{ r.name }}</span>{% if r.insider_buyers %} <span class="ts-ins" data-tip-en="{{ r.insider_buyers }} insider{{ '' if r.insider_buyers == 1 else 's' }} bought more shares than they sold in the last six months{% if r.insider_net_mn %}, worth about ${{ '%.1f'|format(r.insider_net_mn) }}M net{% endif %}. Supporting evidence, not a buy signal." data-tip-zh="过去六个月有 {{ r.insider_buyers }} 名内部人净买入{% if r.insider_net_mn %}，净额约 ${{ '%.1f'|format(r.insider_net_mn) }}M{% endif %}。可作辅助参考，并非买入信号。">👤 {{ r.insider_buyers }}</span>{% endif %}{% if r.sue_z %} <span class="ts-sue" data-tip-en="The latest earnings beat the stock's usual year-ago pattern. This clue has not held up over a long history, so treat it as supporting context only." data-tip-zh="最新盈利好于该股往年同期的常见表现。这个线索在长期历史中并不稳定，因此仅作辅助参考。">📈 {{ t('earnings beat', '盈利超预期') }}</span>{% endif %}</td>
    <td class="muted c-sector">{{ td(r.sector) }}</td>
    <td class="r c-edge {{ 'az-up' if r.alpha and r.alpha > 0 else 'az-dn' }}">{{ '%+.2f'|format(r.alpha) }}</td>
    <td class="r muted c-rank">{% if r.sector_rank %}#{{ r.sector_rank }}/{{ r.sector_n }}{% endif %}</td>
    <td class="c-buy">
      {% set sg = r.signal if (r.signal is defined and r.signal is mapping) else {} %}
      {% if sg.get('eligible') is sameas false %}
        <span class="ts-buy ent-warn">{{ t('Not eligible — wait', '不符合条件 — 等待') }}</span>
      {% elif r.get('primary_rejection_reason') == 'event_blackout' %}
        <span class="ts-buy ent-warn">{{ t('Earnings — wait', '财报期 — 等待') }}</span>
      {% elif sg.get('eligible') is not sameas true %}
        <span class="ts-buy muted">{{ t('Unverified — wait', '未核实 — 等待') }}</span>
      {% elif sg.get('tier_cascade') == 'T1' and (sg.get('sub') == 'pending' or sg.get('tier') == 'anticipation') %}
        <span class="ts-buy ent-warn" data-tip-en="The signal fired, but its forward confirmation is still pending. This is not a confirmed current entry." data-tip-zh="信号已触发，但后续确认尚未完成。当前入场仍未确认。">{{ t('Unconfirmed — wait', '未确认 — 等待') }}</span>
      {% elif sg.get('provisional') or sg.get('tier_observation_provisional') %}
        <span class="ts-buy ent-warn" data-tip-en="This observation can change before its price bar or confirmation window completes. Wait for a settled reading." data-tip-zh="K线或确认窗口结束前，这个读数仍可能变化。请等待读数确定。">{{ t('Forming — wait', '形成中 — 等待') }}</span>
      {% elif sg.get('tier_cascade') == 'T1' and sg.get('tier') == 'take' %}
        <span class="ts-buy muted" data-tip-en="The source confirmed a historical signal. Current entry availability, trend risk and invalidation are separate checks." data-tip-zh="来源已确认历史信号。当前能否入场、趋势风险及失效条件仍需单独核实。">{{ t('Signal confirmed', '信号已确认') }}</span>
      {% elif sg.get('tier_cascade') == 'T2' %}
        <span class="ts-buy muted" data-tip-en="An early signal fired. It does not establish that a current entry is open or that the price trend is intact." data-tip-zh="早期信号已触发，但不代表当前可以入场，也不代表价格趋势完好。">{{ t('Early trigger', '早期触发') }}</span>
      {% elif sg.get('tier_cascade') == 'T3' %}
        <span class="ts-buy ent-warn">{{ t('Forming — wait', '形成中 — 等待') }}</span>
      {% else %}
        <span class="ts-buy muted" data-tip-en="The source does not provide enough confirmation evidence. A tier label alone is not a confirmed entry." data-tip-zh="来源未提供足够的确认依据。仅有层级标签，不代表入场已确认。">{{ t('Unverified — wait', '未核实 — 等待') }}</span>
      {% endif %}
      <small class="ts-signal-date muted">{% if sg.get('tier_observed_date') or sg.get('asof') %}{{ t('Observed', '观测日') }} {{ sg.get('tier_observed_date') or sg.get('asof') }}{% else %}{{ t('Signal date unavailable', '信号日期不可用') }}{% endif %}</small>
      {% set pc = r.get('price_context') if r.get('price_context') is mapping else {} %}
      {% set ps = pc.get('status') if pc.get('asof') else none %}
      <small class="ts-price-context" data-tip-en="Dated daily-cycle context from the existing price analysis. This is separate from signal confirmation and does not verify current entry availability." data-tip-zh="现有价格分析给出的每日周期背景，日期单列。它与信号确认分开，不代表已核实当前可以入场。">
        {% if ps in ('blocked', 'avoid') %}<span class="ent-warn">{{ t('Decline — wait', '下行 — 等待') }}</span>
        {% elif ps == 'exit' %}<span class="ent-warn">{{ t('Rolling over — wait', '转弱 — 等待') }}</span>
        {% elif ps in ('extended', 'topping') %}<span class="ent-warn">{{ t('Extended — wait', '拉伸 — 等待') }}</span>
        {% elif ps == 'bounce_wait' %}<span class="ent-warn">{{ t('Turn unconfirmed', '转向未确认') }}</span>
        {% elif ps == 'wait_pullback' %}<span class="muted">{{ t('Awaiting pullback', '等待回撤') }}</span>
        {% elif ps == 'hold' %}<span class="muted">{{ t('Late cycle — wait', '周期后段 — 等待') }}</span>
        {% elif ps in ('await_confluence', 'buy_soon', 'watch') %}<span class="muted">{{ t('Timing not ready', '时机未成熟') }}</span>
        {% elif ps in ('buy_now', 'partial') %}<span class="muted">{{ t('Entry check needed', '入场仍需核实') }}</span>
        {% else %}<span class="muted">{{ t('Price context unavailable', '价格背景不可用') }}</span>{% endif %}
        {% if pc.get('asof') %}<span class="muted ts-price-date"> · {{ t('Price', '价格日') }} {{ pc.asof }}</span>{% endif %}
      </small>
    </td>
    <td class="c-cycle">{% if r.label %}{{ td(r.label) }}{% else %}<span class="muted">—</span>{% endif %}</td>
    <td class="c-trend">{% if r.alpha_entry == 'pullback' %}<span class="ent-warn" data-tip-en="Recent relative performance is weak despite a stronger older momentum score. This does not verify a healthy pullback or exclude a downtrend." data-tip-zh="尽管较早的动量评分较强，近期相对表现偏弱。这不代表健康回调，也不能排除下跌趋势。">{{ t('Weak month', '近期偏弱') }}</span>{% elif r.alpha_entry == 'extended' %}<span class="ent-warn">{{ t('Strong month', '近期偏强') }}</span>{% elif r.alpha_entry == 'intact' %}<span class="muted">{{ t('Middle range', '中间区间') }}</span>{% else %}<span class="muted">{{ r.alpha_entry or '—' }}</span>{% endif %}</td>
    <td class="r c-factor {{ 'az-up' if r.factor_z and r.factor_z > 0 else ('az-dn' if r.factor_z and r.factor_z < 0 else 'muted') }}">{% if r.factor_z is not none %}{{ '%+.1f'|format(r.factor_z) }}{% else %}—{% endif %}</td>
    <td class="r c-setup"><b>{{ '%+.2f'|format(r.setup) }}</b></td>
  </tr>
{% endfor %}
