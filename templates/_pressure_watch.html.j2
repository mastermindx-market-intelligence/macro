{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{%- set P = (hub.pressure if hub else None) %}
{%- if P %}
<section id="pressure" class="section-anchor" data-pw-expires="{{ P.expires_utc or '' }}" data-pw-status="{{ P.freshness_status }}">
  <div class="sec-h">
    {#- The "?" appears only with a record behind it: in warm-up the card would
        open on a heading and nothing else, which is worse than no affordance. #}
    <h2>{{ t(P.title_en, P.title_zh) }}{% if P.help %}<span class="lens-q" data-lens-kind="define" tabindex="0" role="button" aria-label="How Pressure Watch is measured">?<span class="lens-src" data-lens-kind="define" hidden>
      <span class="lens-hd">
        <span class="lens-ill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h4l3 10h11"/><circle cx="10" cy="17" r="1.4" fill="currentColor" stroke="none"/></svg></span>
        <span class="lens-hgroup">
          <span class="lens-kick">{{ t(P.help.kick_en, P.help.kick_zh) }}</span>
          <span class="lens-title">{{ t(P.help.title_en, P.help.title_zh) }}</span>
        </span>
      </span>
      <span class="lens-body pw-tipbody">
        {%- for hr in P.help.rows %}
        <span class="pw-tr">
          <span class="pw-tk">{{ t(hr.k_en, hr.k_zh) }}</span>
          <span class="pw-tv">{{ t(hr.v_en, hr.v_zh) }}</span>
        </span>
        {%- endfor %}
      </span>
      <span class="lens-receipt">{{ t(P.help.receipt_en, P.help.receipt_zh) }}</span>
    </span></span>{% endif %}</h2>
    <span class="sh-note">{{ t(P.sub_en, P.sub_zh) }}</span>
    {%- if P.asof %}<span class="pw-asof">{{ t('as of ' ~ P.asof, '截至 ' ~ P.asof) }}</span>{%- endif %}
  </div>

  <div class="pw">
    {%- if P.banner %}
    <p class="pw-banner" data-pw-current-banner{% if P.banner.tip_en %} data-tip-en="{{ P.banner.tip_en }}" data-tip-zh="{{ P.banner.tip_zh }}"{% endif %}>{{ t(P.banner.en, P.banner.zh) }}</p>
    {%- endif %}

    <p class="pw-banner" data-pw-expiry-warning hidden>{{ t('Update due — showing the last completed record.', '等待更新 — 以下为上次完成的记录。') }}</p>

    {%- if P.mode == 'warmup' %}
    <p class="pw-warm">{{ t(P.warm_en, P.warm_zh) }} <b>{{ t(P.stance_en, P.stance_zh) }}</b></p>
    {%- else %}

    {#- 1 · the frozen record — the band's headline content #}
    {%- if P.base %}
    <div class="pw-stratum">
      <div class="pw-k">{{ t('What usually happens', '通常会怎样') }}</div>
      <p class="pw-read">{{ t(P.base.headline_en, P.base.headline_zh) }}</p>
      <div class="pw-bar">
        {%- for s in P.base.segments %}
        <i class="pw-s-{{ s.cls }}" style="flex:{{ s.w }} 1 0" data-tip-en="{{ s.tip_en }}" data-tip-zh="{{ s.tip_zh }}"></i>
        {%- endfor %}
      </div>
      <div class="pw-leg">
        {%- for s in P.base.segments %}
        <span><i class="pw-sw pw-s-{{ s.cls }}"></i>{{ t(s.en, s.zh) }} <b>{{ s.pc }}</b></span>
        {%- endfor %}
      </div>
      <p class="pw-note">{{ t(P.base.null_en, P.base.null_zh) }}</p>
      <p class="pw-stance">{{ t(P.stance_en, P.stance_zh) }}</p>
    </div>
    {%- endif %}

    {#- 2 · closed episodes — the proof that the record above is kept honestly #}
    {%- if P.resolved %}
    <div class="pw-stratum">
      <div class="pw-k">{{ t('Recently resolved', '近期已了结') }}</div>
      <div class="pw-rows">
        {%- for r in P.resolved %}
        {#- No dossier, no anchor — but the row keeps every word. An episode
            outlives its name's coverage, and "stopped trading" is the ending
            this stratum exists to print (engine/stocks_hub._pw_href). #}
        {%- if r.href %}<a class="pw-row" href="{{ r.href }}">{% else %}<span class="pw-row">{% endif %}
          <span class="pw-t">{{ r.t }}</span>
          <span class="pw-mv">{{ t(r.move_en ~ ' · ' ~ r.when_en, r.move_zh ~ ' · ' ~ r.when_zh) }}</span>
          <span class="pw-end"><i class="pw-sw pw-s-{{ r.end_cls }}"></i>{{ t(r.end_en, r.end_zh) }}</span>
        {%- if r.href %}</a>{% else %}</span>{% endif %}
        {%- endfor %}
      </div>
    </div>
    {%- endif %}

    {#- 3 · open events, both sides, most recent first — deliberately last #}
    {%- if P.open %}
    <div class="pw-stratum{{ ' pw-demoted' if P.demoted else '' }}">
      <div class="pw-k">{{ t('Tracked moves', '已记录波动') }}
        <em>{{ t(P.count_en, P.count_zh) }}</em></div>
      <div class="pw-rows">
        {%- for e in P.open %}
        {%- if e.href %}<a class="pw-row" href="{{ e.href }}">{% else %}<span class="pw-row">{% endif %}
          <span class="pw-t">{{ e.t }}</span>
          <span class="pw-mv">{{ t(e.move_en, e.move_zh) }}{% if e.cmp_en %}
            <span class="pw-cmp">· {{ t(e.cmp_en, e.cmp_zh) }}</span>{% endif %}</span>
          <span class="pw-chips">
            {%- if e.fam_en %}<span class="pw-chip" data-tip-en="{{ e.fam_tip_en }}" data-tip-zh="{{ e.fam_tip_zh }}">{{ t(e.fam_en, e.fam_zh) }}</span>{% endif %}
            {%- if e.state_en %}<span class="pw-chip pw-st"{% if e.tip_en %} data-tip-en="{{ e.tip_en }}" data-tip-zh="{{ e.tip_zh }}"{% endif %}>{{ t(e.state_en, e.state_zh) }}</span>{% endif %}
          </span>
        {%- if e.href %}</a>{% else %}</span>{% endif %}
        {%- endfor %}
      </div>
    </div>
    {%- endif %}

    {#- One footnote, merged, and only where there are rows for it to qualify. #}
    <p class="pw-foot">{{ t(P.foot_en, P.foot_zh) }}</p>
    {%- endif %}
    {%- for g in P.gaps %}
    <p class="pw-gap">{{ t(g.en, g.zh) }}</p>
    {%- endfor %}
  </div>
<script data-pw-expiry>
(function () {
  const section = document.getElementById('pressure');
  if (!section) return;
  const expires = Date.parse(section.dataset.pwExpires || '');
  if (!Number.isFinite(expires)) return;
  function check() {
    if (Date.now() < expires || !['current', 'awaiting_source'].includes(section.dataset.pwStatus)) return;
    section.dataset.pwStatus = 'update_due';
    const current = section.querySelector('[data-pw-current-banner]');
    const warning = section.querySelector('[data-pw-expiry-warning]');
    if (current) current.hidden = true;
    if (warning) warning.hidden = false;
    const en = section.querySelector('.pw-stance .l-en');
    const zh = section.querySelector('.pw-stance .l-zh');
    if (en) en.textContent = 'Wait for the next update.';
    if (zh) zh.textContent = '等待下一次更新。';
  }
  check();
  const wait = expires - Date.now();
  if (wait > 0 && wait < 2147483600) setTimeout(check, wait + 20);
  document.addEventListener('visibilitychange', check);
})();
</script>
</section>
{%- endif %}
