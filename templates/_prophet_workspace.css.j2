{# Paper opportunity workspace: presentation of the existing US source rows only.
   Keep the shared macro, selection, live quote hooks, and detail owner unchanged.
   Light uses white material and shadow; dark uses panel depth and a restrained
   semantic rail. Missing reads retain the macro's neutral/dashed treatment. #}
#us-standouts :is(#us-today-grid, #us-cand-grid) {
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 296px), 1fr)) !important;
  gap: 16px;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pvcard {
  background: var(--panel);
  border-radius: var(--r-card, 12px);
  box-shadow: var(--card-shadow);
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pvcard::before {
  background: var(--pvh);
  box-shadow: none;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pvcard.pv-featured {
  background: var(--panel2);
  border-color: var(--pv-buy);
  box-shadow: var(--card-shadow);
}
html[data-theme="light"] #us-standouts :is(#us-today-grid, #us-cand-grid) .pvcard.pv-featured {
  background: var(--panel);
  border-color: var(--pv-buy);
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pvcard:hover {
  box-shadow: var(--card-shadow);
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-chart {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 10px 12px;
  padding: 16px 16px 0;
  background: transparent;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-chart > svg,
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-nochart {
  order: 3;
  flex: 1 0 100%;
  height: 68px;
  min-width: 0;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-ov {
  position: static;
  z-index: auto;
  max-width: 100%;
  gap: 6px;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-ovl {
  position: relative;
  z-index: 5;
  pointer-events: none;
  flex: 1 1 112px;
  align-items: center;
  row-gap: 6px;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-ovr {
  flex: 0 1 auto;
  margin-left: auto;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-chip {
  min-height: 30px;
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  border-radius: var(--r-ctl, 8px);
  padding: 4px 9px;
  font-size: var(--fs-sm);
  line-height: 1.3;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-quote {
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
  border: 0;
  background: transparent;
  padding: 0;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .nb-px.pv-px {
  font-size: var(--fs-num-lg);
  line-height: 1.25;
  letter-spacing: -.025em;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .nb-chg.pv-chg {
  font-size: var(--fs-sm);
  line-height: 1.45;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-ovr > .nb-px.pv-px {
  background: transparent;
  border: 0;
  padding: 0;
}
/* The shared full-card link is z4. Lift only real controls, not the chart. */
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-cau,
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-trg,
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-live:not([hidden]) {
  position: relative;
  z-index: 5;
  font-size: var(--fs-sm);
  pointer-events: auto;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-cau {
  position: static;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-live[hidden] {
  display: none;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-cau-btn {
  min-width: 44px;
  min-height: 44px;
  font-size: var(--fs-sm);
  border-radius: var(--r-ctl, 8px);
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-cau-pop {
  width: min(260px, calc(100vw - 66px));
  max-width: none;
  box-sizing: border-box;
  font-size: var(--fs-sm);
  line-height: 1.5;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-bd {
  padding: 14px 16px 16px;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-hd {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: baseline;
  gap: 8px;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-idw {
  display: contents;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-tk {
  grid-row: 1;
  grid-column: 1;
  font-size: var(--fs-num-lg);
  line-height: 1.25;
  overflow-wrap: anywhere;
  white-space: normal;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-nm {
  grid-column: 1 / -1;
  grid-row: 2;
  width: 100%;
  font-size: var(--fs-body);
  line-height: 1.5;
  font-weight: 500;
  color: var(--text);
  white-space: normal;
  overflow: visible;
  overflow-wrap: anywhere;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-edge {
  grid-row: 1;
  grid-column: 2;
  padding-top: 5px;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-edl,
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-ind,
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-mk-i,
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-mark {
  font-size: var(--fs-sm);
  line-height: 1.5;
  white-space: normal;
  overflow: visible;
  overflow-wrap: anywhere;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-edn {
  font-size: var(--fs-body);
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-ind {
  margin-top: 6px;
  opacity: 1;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-mk {
  margin-top: 10px;
  min-height: 24px;
  gap: 4px 6px;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-stp {
  margin-top: 18px;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-stl {
  margin-top: 7px;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-stl span {
  font-size: var(--fs-sm);
  line-height: 1.45;
  opacity: 1;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-setup-inline {
  margin-top: 16px;
  margin-left: auto;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-setup-inline > summary {
  min-height: 44px;
  min-width: 44px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  font-size: var(--fs-sm);
  line-height: 1.4;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-zn {
  padding: 12px 16px;
  gap: 6px;
  background: var(--bg);
  font-size: var(--fs-body);
  line-height: 1.5;
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-znl,
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-dt,
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-added {
  font-size: var(--fs-sm);
}
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-znr,
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-znm,
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-dt,
#us-standouts :is(#us-today-grid, #us-cand-grid) .pv-added {
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  overflow-wrap: anywhere;
}
@media (min-width: 1280px) {
  #us-standouts :is(#us-today-grid, #us-cand-grid) {
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
  }
}
@media (max-width: 680px) {
  #us-standouts :is(#us-today-grid, #us-cand-grid) {
    grid-template-columns: minmax(0, 1fr) !important;
  }
}

/* Selected-card study retains each original card in publisher order. */
#us-standouts .pvs-study-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px 16px;
  margin: 16px 0;
  padding: 16px;
  border: 1px solid var(--line);
  border-radius: var(--r-card, 12px);
  background: var(--panel2);
  color: var(--text);
}
html[data-theme="light"] #us-standouts .pvs-study-bar {
  background: var(--panel);
  box-shadow: var(--card-shadow);
}
#us-standouts .pvs-study-copy { flex: 1 1 220px; min-width: 0; }
#us-standouts .pvs-study-copy strong { font-size: var(--fs-body); }
#us-standouts .pvs-study-count,
#us-standouts .pvs-study-note { font-size: var(--fs-sm); line-height: 1.5; color: var(--muted); }
#us-standouts .pvs-study-count { margin: 4px 0 0; }
#us-standouts .pvs-study-note { flex: 1 1 100%; border-top: 1px solid var(--line); padding-top: 12px; }
#us-standouts .pvs-study-note p { margin: 4px 0 0; }
#us-standouts .pvs-study-actions { display: flex; flex-wrap: wrap; gap: 8px; }
#us-standouts :is(.pvs-study-actions button, .pvs-study-pick) {
  min-height: 44px;
  min-width: 44px;
  white-space: normal;
  overflow-wrap: anywhere;
  font-size: var(--fs-sm);
  line-height: 1.4;
}
#us-standouts .pvs-study-pick { position: relative; z-index: 5; margin-top: 12px; align-self: flex-start; }
#us-standouts .pvs-study-pick[aria-pressed="true"] { border-color: var(--link); color: var(--link); background: var(--panel2); }
html[data-theme="light"] #us-standouts .pvs-study-pick[aria-pressed="true"] { background: var(--bg); }
#us-standouts :is(.pvs-study-actions button, .pvs-study-pick):focus-visible { outline: 2px solid var(--link); outline-offset: 3px; }
#us-standouts .pvs-study-bar [hidden] { display: none !important; }
#us-standouts :is(#us-today-grid, #us-cand-grid).pvs-study-active {
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 296px), 1fr)) !important;
}
#us-standouts .pvs-study-active > .pvs-study-omit,
#us-standouts .pvs-study-active + .sm-bar { display: none !important; }
/* Show-more is pagination, not access: only an explicitly chosen original can stay
   visible across a column resize. Hidden/tier access remains the native owner's. */
#us-standouts .pvs-study-active > .pvcard.pvs-study-chosen.sm-hidden { display: flex !important; }
@media (min-width: 1280px) {
  #us-standouts :is(#us-today-grid, #us-cand-grid).pvs-study-active { grid-template-columns: repeat(3, minmax(0, 1fr)) !important; }
}
@media (max-width: 680px) {
  #us-standouts :is(#us-today-grid, #us-cand-grid).pvs-study-active { grid-template-columns: minmax(0, 1fr) !important; }
  #us-standouts .pvs-study-actions { width: 100%; }
  #us-standouts .pvs-study-actions button { flex: 1 1 120px; }
}
