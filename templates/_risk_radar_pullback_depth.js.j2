/* Observation expiry owner for the measured Risk Radar section. Presentation
   only: no fetch, polling feed, recomputation or trading decision. At the
   producer's valid_until the section stops claiming a current assessment and
   shows its expiry notice; the measured figures are hidden by pb-expired. */
(function () {
  'use strict';
  var timer;
  /* Only a stamp with an explicit offset is a deadline; a bare local time would
     move with the viewer's zone, so it counts as expired. */
  var ZONED = /(?:Z|[+-]\d\d:\d\d)$/;
  function expire() {
    window.clearTimeout(timer);
    var now = Date.now(), next = Infinity;
    document.querySelectorAll('.rrp.pbx[data-pb-valid-until]').forEach(function (root) {
      var raw = root.getAttribute('data-pb-valid-until') || '';
      var end = ZONED.test(raw) ? Date.parse(raw) : NaN;
      if (!Number.isFinite(end) || now >= end) {
        root.classList.add('pb-expired');
        root.setAttribute('data-pb-phase', 'unavailable');
        var heading = root.querySelector('.pbx-heading h2');
        if (heading) {
          var en = heading.querySelector('.l-en'), zh = heading.querySelector('.l-zh');
          if (en) en.textContent = 'Price update needed';
          if (zh) zh.textContent = '价格数据待更新';
        }
      } else {
        next = Math.min(next, end);
      }
    });
    /* Re-arm at the nearest deadline, but at least once a minute: a timer that
       spans a sleep resumes late, and no wake event is guaranteed to follow. */
    if (Number.isFinite(next)) timer = window.setTimeout(expire, Math.min(60000, Math.max(1, next - now + 10)));
  }
  function start() {
    expire();
    /* A sleeping laptop pauses the timer without hiding the tab, so check again
       whenever the page can be seen; the dialogs also call this as they open. */
    document.addEventListener('visibilitychange', function () { if (!document.hidden) expire(); });
    window.addEventListener('pageshow', expire);
    window.addEventListener('focus', expire);
  }
  window.mmPbExpire = expire;
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true });
  else start();
})();
