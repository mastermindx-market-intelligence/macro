.candidate-empty{display:grid;place-items:center;min-height:280px;padding:31px 27px;text-align:center;background:radial-gradient(circle at 50% 0,color-mix(in srgb,var(--gr-accent) 12%,transparent),transparent 56%);color:var(--gr-muted)}.candidate-empty .empty-mark{margin-bottom:11px}.candidate-empty strong{display:block;color:var(--text);font-size:12px}.candidate-empty p{max-width:35ch;margin:7px auto 0;font-size:9px;line-height:1.55}.candidate-empty-meta{display:flex;justify-content:center;flex-wrap:wrap;gap:5px;margin-top:13px}.candidate-empty-meta span{padding:4px 7px;border:1px solid var(--gr-line);border-radius:999px;background:var(--gr-raised);color:var(--gr-faint);font:700 7.5px var(--gr-mono)}.candidate-row{position:relative;width:100%;display:grid;grid-template-columns:4px minmax(0,1fr);gap:12px;padding:14px 15px 13px 12px;border:0;border-bottom:1px solid var(--gr-line);background:linear-gradient(105deg,color-mix(in srgb,var(--gr-accent) 4%,transparent),transparent 66%);text-align:left;cursor:pointer}.candidate-row:hover{background:linear-gradient(105deg,color-mix(in srgb,var(--gr-accent) 9%,transparent),transparent 72%)}.candidate-row.on{background:linear-gradient(105deg,color-mix(in srgb,var(--gr-accent) 13%,transparent),transparent 76%)}.candidate-row.on:after{content:"";position:absolute;right:0;top:0;bottom:0;width:2px;background:var(--gr-accent)}.candidate-rail{width:3px;min-height:69px;border-radius:4px;background:var(--gr-good)}.candidate-top,.candidate-foot{display:flex;align-items:center;justify-content:space-between;gap:8px}.candidate-state{display:inline-flex;align-items:center;gap:5px;min-width:0;color:var(--gr-good);font-size:7.4px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.candidate-state:before{content:"";width:4px;height:4px;border-radius:50%;background:currentColor}.candidate-time{color:var(--gr-faint);font:8px var(--gr-mono);white-space:nowrap}.candidate-name{margin-top:8px;color:var(--text);font-size:12px;font-weight:760;letter-spacing:-.015em}.candidate-name code{margin-right:5px;color:var(--gr-blue);font:750 9px var(--gr-mono)}.candidate-change{display:block;margin-top:5px;color:var(--gr-muted);font-size:8.8px;line-height:1.45}.candidate-foot{justify-content:flex-start;flex-wrap:wrap;margin-top:9px}.candidate-foot span{color:var(--gr-faint);font-size:7.6px}.candidate-foot .candidate-channel{color:var(--gr-accent);font-weight:720}.candidate-crosschecks{display:flex;flex-wrap:wrap;gap:4px}.candidate-crosscheck{padding:3px 5px;border:1px solid var(--gr-line);border-radius:4px;color:var(--gr-faint);font-size:6.8px}.candidate-crosscheck.ok{border-color:color-mix(in srgb,var(--gr-good) 45%,var(--gr-line));color:var(--gr-good)}.candidate-crosscheck.mixed{border-color:color-mix(in srgb,var(--gr-warn) 45%,var(--gr-line));color:var(--gr-warn)}.candidate-proof{display:grid;gap:6px;padding:10px;border-left:2px solid var(--gr-good);background:color-mix(in srgb,var(--gr-good) 6%,transparent)}.candidate-proof strong{font-size:9px;color:var(--gr-good)}.candidate-proof span,.candidate-crosscheck-grid span{color:var(--gr-muted);font-size:8.3px;line-height:1.5}.candidate-crosscheck-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}.candidate-crosscheck-grid div{display:grid;gap:3px;padding:8px;border:1px solid var(--gr-line);border-radius:7px;background:var(--gr-raised)}.candidate-crosscheck-grid b{font-size:7.4px;letter-spacing:.06em;text-transform:uppercase}.candidate-crosscheck-grid .ok b{color:var(--gr-good)}.candidate-crosscheck-grid .mixed b{color:var(--gr-warn)}.candidate-crosscheck-grid .pending b{color:var(--gr-faint)}
button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible{outline:2px solid var(--gr-accent);outline-offset:2px}
@media(max-width:1250px){.shell-body{grid-template-columns:196px minmax(470px,1fr) minmax(365px,.78fr)}.pulse-policy{display:none}}
@media(max-width:980px){body{padding-bottom:112px}.gr-wrap{width:min(100% - 24px,760px)}.gr-title-row{display:block}.gr-cut{margin-top:16px;padding:9px 0 0;border-left:0;border-top:1px solid var(--gr-line)}.gr-pulse{overflow:auto;scroll-snap-type:x proximity}.pulse-lead,.pulse-stat{scroll-snap-align:start}.pulse-lead{min-width:210px}.pulse-stat{min-width:120px}.gr-shell{min-height:650px}.shell-body,.gr-shell.dossier-open .shell-body{display:block;min-height:590px}.filter-pane,.inspector-pane,.gr-shell.dossier-open .inspector-pane{display:none;height:auto}.queue-pane{border-right:0}.queue-list{height:auto;max-height:none;min-height:530px}.mobile-only{display:inline-flex}.mobile-summary{position:fixed;z-index:50;display:flex;align-items:center;justify-content:space-between;gap:12px;left:12px;right:82px;bottom:12px;min-height:62px;padding:9px 10px 9px 13px;border:1px solid var(--gr-line2);border-radius:13px;background:color-mix(in srgb,var(--panel) 94%,transparent);box-shadow:0 18px 55px -25px rgba(0,0,0,.85);backdrop-filter:blur(18px)}.mobile-summary-copy{min-width:0}.mobile-summary-copy b,.mobile-summary-copy span{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mobile-summary-copy b{font-size:10px}.mobile-summary-copy span{margin-top:3px;color:var(--gr-muted);font-size:8px}.mobile-sheet{display:block!important;position:fixed;z-index:992;left:8px;right:8px;bottom:8px;top:auto;max-height:min(82vh,760px);height:auto;border:1px solid var(--gr-line2);border-radius:16px;background:var(--panel);box-shadow:0 -30px 90px -42px rgba(0,0,0,.92);overflow:auto}.mobile-sheet.filter-pane{border-right:1px solid var(--gr-line2);height:auto}.mobile-sheet.inspector-pane,.gr-shell.dossier-open .mobile-sheet.inspector-pane{height:min(82vh,760px);display:block}.shell-top{overflow-x:auto}.mode-tab{white-space:nowrap}}
@media(max-width:980px){.queue-list{height:clamp(240px,60vh,585px);height:clamp(240px,60dvh,585px);max-height:585px;min-height:240px}}
@media(max-width:620px){.gr-header{padding-top:25px}.gr-title h1{font-size:35px!important}.gr-title p{font-size:11.5px}.gr-pulse{margin-top:16px}.pulse-stat{min-width:105px;padding-left:13px;padding-right:13px}.pulse-stat b{font-size:14px}.company-filmstrip{display:block;margin-top:10px}.company-filmstrip-track{margin-top:8px}.shell-top{padding-left:8px;gap:8px}.mode-tab{padding-left:8px;padding-right:8px}.health{display:none}.gr-footer{display:block}.gr-footer .scope{text-align:left;margin-top:5px}.queue-row{padding-right:12px}.candidate-crosscheck-grid{grid-template-columns:1fr}.inspect-hero h2{font-size:16px}}
@media(prefers-reduced-motion:no-preference){.queue-row,.mode-tab,.tool-btn,.filter-choice{transition:background .15s ease,color .15s ease,border-color .15s ease}.pulse-orbit:after{content:"";position:absolute;inset:-7px;border:1px solid color-mix(in srgb,var(--gr-accent) 16%,transparent);border-radius:50%;animation:pulse-ring 3.1s ease-out infinite}@keyframes pulse-ring{0%,60%{transform:scale(.8);opacity:0}70%{opacity:1}100%{transform:scale(1.35);opacity:0}}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
.queue-rail.observed{background:var(--gr-blue)}.truth.observed{color:var(--gr-blue)}
.truth.conflict{color:var(--gr-bad)}.truth.historic{color:var(--gr-muted)}
.truth.late{color:var(--gr-warn)}.truth.correction{color:var(--gr-blue)}
#companyBridge>.inspect-label{margin-top:12px}#companyBridge>.inspect-label:first-child{margin-top:0}

/* Source details are above, never behind, their parent mobile sheet. */
.evidence-drawer{z-index:994}
.drawer-backdrop.above-mobile-sheet{z-index:993}
.mobile-summary[hidden]{display:none}
</style></head>
<body>
<a class="skip-link" href="#gov-workspace">{{ t('Skip to procurement intelligence','跳至政府采购情报') }}</a>
<div class="gr-wrap">
{% set nav_defer_enhancements = true %}
{% include "_site_nav.html.j2" %}
<header class="gr-header">
<div class="gr-kicker">{{ t('Procurement intelligence','政府采购情报') }}</div>
<div class="gr-title-row">
<div class="gr-title"><h1>{{ t('Government Revenue','政府收入') }} <span style="color:var(--gr-accent)">{{ t('Foresight','前瞻') }}</span></h1><p>{{ t('See the contract change, then trace the public-company exposure. Watch the evidence—do not trade the headline alone.','先看合同变化，再追踪上市公司暴露。观察证据，不要只凭标题交易。') }}</p></div>
<div class="gr-cut"><strong>{{ t('Snapshot','数据快照') }} · {{ as_of or '—' }}</strong>{{ t('Updated','最近更新') }} <time id="knownAt" data-iso="{{ known_at or '' }}">{{ known_at or '—' }}</time></div>
</div>
<div class="gr-pulse" aria-label="Procurement pulse summary">
<div class="pulse-lead"><span class="pulse-orbit" aria-hidden="true"></span><div><strong id="pulseStance">{{ t('Track procurement changes','跟踪采购变化') }}</strong><span id="pulseStatus">{{ t('Loading official records','正在读取官方记录') }}</span></div></div>
<div class="pulse-stat"><b id="statChanges">—</b><span>{{ t('tracked changes','已跟踪变化') }}</span></div>
<div class="pulse-stat"><b id="statOpps">—</b><span>{{ t('active opportunities','活跃机会') }}</span></div>
<div class="pulse-stat"><b id="statDeadlines">—</b><span>{{ t('closing in 30 days','30 天内截止') }}</span></div>
<div class="pulse-stat"><b id="statExposure">—</b><span>{{ t('linked companies','已关联公司') }}</span></div>
<div class="pulse-spacer"></div>
<div class="pulse-policy">{{ t('Use official records as research context. Company links are for investigation, not trade signals.','官方记录用于研究背景。公司关联用于调查，不是交易信号。') }}</div>
</div>
</header>
<div id="defenseInvestorHost"></div>
<div id="themeContextHost"></div>
<section class="company-filmstrip" aria-labelledby="companyFilmstripTitle">
<div class="company-filmstrip-copy">
<span class="company-filmstrip-kicker">{{ t('Company coverage','公司覆盖') }}</span>
<strong class="company-filmstrip-title" id="companyFilmstripTitle">{{ t('Follow the issuer file','追踪公司档案') }}</strong>
<span class="company-filmstrip-caption">{{ t('Linked records open Candidate Radar; every other name opens its company file.','已关联记录打开候选雷达；其他公司打开其公司档案。') }}</span>
<div class="company-filmstrip-legend"><span class="company-filmstrip-key linked"><i aria-hidden="true"></i>{{ t('Company link found','已找到公司关联') }}</span><span class="company-filmstrip-key pending"><i aria-hidden="true"></i>{{ t('Link pending','关联待核') }}</span><span class="company-filmstrip-key"><i aria-hidden="true"></i>{{ t('Company file','公司档案') }}</span></div>
</div>
<div class="company-filmstrip-track" id="companyFilmstrip" role="list"></div>
</section>
<main class="gr-shell" id="gov-workspace">
<div class="shell-top">
<div class="mode-tabs" role="tablist" aria-label="Procurement workspace mode">
<button class="mode-tab" type="button" role="tab" aria-selected="false" tabindex="-1" data-mode="candidates">{{ t('Candidate Radar','候选雷达') }}<span class="mode-count" id="countCandidates">—</span></button>
<button class="mode-tab" type="button" role="tab" aria-selected="true" tabindex="0" data-mode="changes">{{ t('Changes','变化') }}<span class="mode-count" id="countChanges">—</span></button>
<button class="mode-tab" type="button" role="tab" aria-selected="false" tabindex="-1" data-mode="awards">{{ t('Award activity','授标动态') }}<span class="mode-count" id="countAwards">—</span></button>
<button class="mode-tab" type="button" role="tab" aria-selected="false" tabindex="-1" data-mode="opportunities">{{ t('Opportunities','机会') }}<span class="mode-count" id="countOpps">—</span></button>
<button class="mode-tab" type="button" role="tab" aria-selected="false" tabindex="-1" data-mode="recompetes">{{ t('Recompete watch','再竞争观察') }}<span class="mode-count" id="countRecompetes">—</span></button>
<button class="mode-tab" type="button" role="tab" aria-selected="false" tabindex="-1" data-mode="budget">{{ t('Budget & programs','预算与项目') }}<span class="mode-count" id="countBudget">—</span></button>
<button class="mode-tab" type="button" role="tab" aria-selected="false" tabindex="-1" data-mode="programs">{{ t('Program Dossier','项目档案') }}<span class="mode-count" id="countPrograms">—</span></button>
<button class="mode-tab" type="button" role="tab" aria-selected="false" tabindex="-1" data-mode="companies">{{ t('Companies','公司') }}<span class="mode-count" id="countCompanies">—</span></button>
      <button class="mode-tab" type="button" role="tab" aria-selected="false" tabindex="-1" data-mode="fms">{{ t('FMS Congressional Notifications','FMS 国会通知') }}<span class="mode-count" id="countFms">—</span></button>
</div>
<div class="shell-tools">
<div class="health" id="sourceHealth"><i aria-hidden="true"></i><span id="healthCopy">{{ t('Checking sources','检查数据源') }}</span></div>
<button id="companyMode" type="button" hidden aria-hidden="true" tabindex="-1">{{ t('Companies','公司') }}</button>
<button class="tool-btn mobile-only" type="button" id="filterOpen" aria-controls="filterPane" aria-expanded="false">{{ t('Filters','筛选') }}</button>
</div>
</div>
<div class="workspace-degraded" id="workspaceDegraded" role="status" aria-live="polite" hidden>
<div class="workspace-degraded-copy"><i aria-hidden="true"></i><span id="workspaceDegradedCopy">{{ t('Showing a compact snapshot while the full workspace loads.','完整工作区加载期间显示精简快照。') }}</span></div>
<a class="tool-btn" id="workspaceUnlock" href="plans.html" hidden>{{ t('View membership plans','查看会员方案') }}</a>
<button class="tool-btn" type="button" id="workspaceRetry" hidden>{{ t('Retry full workspace','重试完整工作区') }}</button>
</div>
<div class="shell-body">
<aside class="filter-pane" id="filterPane" aria-label="Procurement filters">
<div class="pane-head"><strong>{{ t('Narrow the list','缩小列表范围') }}</strong><span>{{ t('Filters update this snapshot','筛选会更新当前快照') }}</span></div>
<div class="filter-body">
<div class="filter-group"><div class="filter-label"><span>{{ t('Search','搜索') }}</span><kbd>/</kbd></div><input class="field" id="deskSearch" type="search" maxlength="120" autocomplete="off" placeholder="Notice, agency or ticker" aria-label="Search notice, agency or ticker"></div>
<div class="filter-group"><div class="filter-label">{{ t('Evidence status','证据状态') }}</div><div class="filter-stack" id="truthFilters"><button class="filter-choice on" type="button" data-filter="all">{{ t('All evidence','全部证据') }}<b id="filterAllCount">—</b></button><button class="filter-choice" type="button" data-filter="official">{{ t('Official facts','官方事实') }}</button><button class="filter-choice" type="button" data-filter="linked">{{ t('Issuer-linked','已关联公司') }}</button><button class="filter-choice" type="button" data-filter="defense">{{ t('Defense only','仅国防') }}</button></div></div>
<div class="filter-group"><label class="filter-label" for="agencyFilter">{{ t('Agency','机构') }}</label><select class="field" id="agencyFilter"><option value="">All agencies</option></select></div>
<div class="filter-group"><label class="filter-label" for="tickerFilter">{{ t('Public company','上市公司') }}</label><select class="field" id="tickerFilter"><option value="">All companies</option></select></div>
<div class="filter-group briefcase" id="researchBriefcase">
<div class="filter-label"><span>{{ t('Saved research','已保存研究') }}</span><span>{{ t('this device','本设备') }}</span></div>
<select class="field" id="savedViewSelect" aria-label="Saved research views"><option value="">Current unsaved view</option></select>
<div class="briefcase-row"><input class="field" id="savedViewName" maxlength="60" autocomplete="off" placeholder="Name this view" aria-label="Name this saved view"><button class="tool-btn" type="button" id="saveView">{{ t('Save','保存') }}</button></div>
<div class="briefcase-actions"><button class="tool-btn" type="button" id="deleteView" disabled>{{ t('Delete','删除') }}</button><button class="tool-btn" type="button" id="localInbox">{{ t('Inbox','收件箱') }}<span class="briefcase-count" id="localInboxCount">0</span></button></div>
<select class="field" id="alertType" aria-label="Local alert type"><option value="opportunity">Opportunity change</option><option value="award_change">Award / action change</option><option value="recompete">Derived expiry watch</option></select>
<button class="tool-btn" type="button" id="toggleLocalAlert" disabled>{{ t('Enable local alert','启用本地提醒') }}</button>
<div class="briefcase-actions"><button class="tool-btn" type="button" id="exportViewJson">{{ t('Export JSON','导出 JSON') }}</button><button class="tool-btn" type="button" id="exportViewCsv">{{ t('Export CSV','导出 CSV') }}</button></div>
<div class="briefcase-status" id="briefcaseStatus" role="status" aria-live="polite">{{ t('Saved views and alerts stay in this browser. Alerts are checked only when you open or refresh this page.','保存的视图和提醒仅保留在此浏览器中。提醒仅在打开或刷新此页面时检查。') }}</div>
</div>
<div class="filter-group"><div class="filter-label">{{ t('Source health','数据源状态') }}</div><div id="healthDetail" class="filter-note"></div><div id="sbirSourceHost"></div></div>
</div>
</aside>
<section class="queue-pane" aria-labelledby="queueHeading">
<div class="queue-head"><div class="queue-title"><strong id="queueHeading">{{ t('Change feed','变化列表') }}</strong><span id="queueSummary">{{ t('Latest material changes first','最新重要变化优先') }}</span></div><span class="queue-sort" id="queueSort">{{ t('newest first','最新优先') }}</span></div>
<div class="queue-list" id="queueList" role="listbox" aria-label="Procurement evidence queue" tabindex="0" aria-live="polite"></div>
</section>
<aside class="inspector-pane" id="inspectorPane" aria-label="Investor inspector">
<div id="inspector" class="inspector-empty"><div><span class="empty-mark" aria-hidden="true">⌁</span><strong>{{ t('Select a change','选择一项变化') }}</strong><p>{{ t('Open a row to trace what changed, why it may matter and the official source.','打开一行，追踪变化、潜在影响及官方来源。') }}</p></div></div>
</aside>
</div>
</main>
<footer class="gr-footer"><div>{{ t('Official sources','官方来源') }} · <a href="https://sam.gov/content/opportunities" target="_blank" rel="noopener">SAM.gov</a> · <a href="https://www.usaspending.gov/" target="_blank" rel="noopener">USAspending.gov</a></div><div class="scope">{{ t('Research context only · not company guidance, GAAP backlog or a trade signal','仅作研究情境 · 非公司指引、GAAP 积压或交易信号') }}</div></footer>
</div>
<div class="mobile-summary" id="mobileSummary" hidden><div class="mobile-summary-copy"><b id="mobileTitle">{{ t('Select a change','选择一项变化') }}</b><span id="mobileMeta">{{ t('Official evidence and investor context','官方证据与投资者情境') }}</span></div><button class="tool-btn" type="button" id="inspectorOpen" aria-controls="inspectorPane" aria-expanded="false">{{ t('Inspect','查看') }}</button></div>
<div class="drawer-backdrop" id="drawerBackdrop" hidden></div>
<aside class="evidence-drawer" id="evidenceDrawer" role="dialog" aria-modal="true" aria-labelledby="drawerTitle" hidden><div class="drawer-head"><strong id="drawerTitle">{{ t('Source details','来源详情') }}</strong><button class="tool-btn" type="button" id="drawerClose">{{ t('Close','关闭') }} · Esc</button></div><div class="drawer-body" id="drawerBody"></div></aside>
<script id="gov-data" type="application/json">{{ payload_json|replace('</', '<\/')|safe }}</script><script data-sync src="supabase.js"></script><script data-sync src="{{ asset_url('theme.js') if asset_url is defined else 'theme.js' }}"></script><script data-sync src="{{ asset_url('government-revenue-investor.js') if asset_url is defined else 'government-revenue-investor.js' }}"></script><script data-sync src="{{ asset_url('government-revenue-investor-start.js') if asset_url is defined else 'government-revenue-investor-start.js' }}"></script></body>
</html>
