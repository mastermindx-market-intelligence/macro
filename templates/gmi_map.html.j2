{% extends "_gmi_base.html.j2" %}
{% from "_gmi_macros.html.j2" import t, tip, ic, arrow_long, mark, d, asof, sec, search_box, key, kind_tag, chain, tip_core, tip_ext, tip_adm, tip_held with context %}
{% import "_gmi_theme_data.html.j2" as dataset with context %}
{% set public_topics = dataset.public_topics %}{% set topic_names = dataset.topic_names %}{% set default_topic = dataset.default_topic %}
{% from "_gmi_product_macros.html.j2" import topic_answer with context %}
{% block title %}GMI Explorer — Theme research{% endblock %}
{% block seo %}{% set seo_title = 'GMI Explorer — Theme research | Mastermind' %}{% set seo_desc = 'Understand industry themes, explore documented company connections, and follow their dated sources.' %}{% set seo_path = 'gmi.html' %}{% include "_seo_head.html.j2" %}{% endblock %}
{% block body %}
<div class="gmi-explorer" data-gmi-explorer data-default-theme="{{ default_topic.value.id }}">
  <div class="gmi-browse-home" data-browse-home>
  <aside class="gmi-browse" data-gmi-browse aria-label="Browse themes" data-aria-en="Browse themes" data-aria-zh="浏览主题">
    <div class="gmi-browse-title"><h2>{{ t('Browse themes', '浏览主题') }}</h2><span>{{ model.totals.micros }}</span></div>
    <label class="gmi-topic-search">{{ ic('search', 18) }}<input type="search" id="gmi-topic-search" data-topic-search placeholder="Theme, company or product" aria-label="Search themes, companies or products" data-ph-en="Theme, company or product" data-ph-zh="主题、公司或产品" data-aria-en="Search themes, companies or products" data-aria-zh="搜索主题、公司或产品" autocomplete="off" spellcheck="false"><kbd aria-hidden="true">/</kbd></label>
    <label class="gmi-filter-label" for="gmi-category">{{ t('Category', '类别') }}</label><select id="gmi-category" data-topic-category-filter><option value="" data-option-en="All categories" data-option-zh="全部类别">All categories</option>{% for c in model.cats %}<option value="{{ c.id }}" data-option-en="{{ c.en }}" data-option-zh="{{ c.zh }}">{{ c.en }}</option>{% endfor %}</select>
    <fieldset class="gmi-scope-filter"><legend class="gmi-vh">{{ t('Topic scope', '主题范围') }}</legend>{% for value, en, zh in [('all','All','全部'),('core','Core','核心'),('extended','Extended','扩展')] %}<label><input type="radio" name="gmi-scope" value="{{ value }}"{% if value == 'all' %} checked{% endif %}><span>{{ t(en,zh) }}</span></label>{% endfor %}</fieldset>
    <label class="gmi-evidence-filter"><input type="checkbox" data-evidence-only>{{ t('With company evidence', '有公司证据') }}</label>
    <div class="gmi-results-meta"><span data-topic-count aria-live="polite" aria-atomic="true">{{ t(model.totals.micros ~ ' topics', model.totals.micros ~ ' 个主题') }}</span><button type="button" data-topic-reset>{{ t('Reset', '重置') }}</button></div>
    <div class="gmi-topic-results" data-topic-results>{% for topic in public_topics %}<a class="gmi-topic-option" href="#theme={{ topic.id|urlencode }}" data-topic-select="{{ topic.id }}"{% if topic.id == default_topic.value.id %} aria-current="true"{% endif %}><strong>{{ t(topic.en, topic.zh) }}</strong><span>{{ t(topic_names[topic.parent].en, topic_names[topic.parent].zh) }}{% if topic.connections %}<b>{{ topic.connections|length }} {{ t('connection', '条关联') }}</b>{% endif %}</span></a>{% endfor %}</div>
    <div class="gmi-no-results" data-topic-no-results hidden><h3>{{ t('No matching topics', '没有匹配的主题') }}</h3><p>{{ t('Try a broader search or clear the filters.', '请扩大搜索范围，或清除筛选条件。') }}</p><button type="button" class="gmi-action-secondary" data-topic-reset>{{ t('Clear all filters', '清除全部筛选') }}</button></div>
    <a class="gmi-browse-index" href="{{ nav_prefix }}gmi-index.html">{{ t('Open the full index', '打开完整索引') }}{{ ic('arrow', 16) }}</a>
  </aside></div>
  <div class="gmi-answer-column">
    <button type="button" class="gmi-mobile-browse" data-browse-open aria-haspopup="dialog">{{ ic('search', 18) }}<span>{{ t('Find a theme, company or product', '查找主题、公司或产品') }}</span>{{ ic('chev', 16) }}</button>
    <p class="gmi-selection-notice" data-topic-notice hidden role="status"></p>
    <section class="gmi-topic-answer" data-topic-answer aria-labelledby="gmi-topic-title">{{ topic_answer(default_topic.value) }}</section>
    <noscript><p class="gmi-noscript">{{ t('Enable JavaScript to search and switch topics here. The full index, company pages and sources remain available.', '启用 JavaScript 即可在此搜索与切换主题。完整索引、公司页面及来源仍可使用。') }} <a href="{{ nav_prefix }}gmi-index.html">{{ t('Open index', '打开索引') }}</a></p></noscript>
  </div>
</div>
<dialog class="gmi-browse-dialog" data-browse-dialog aria-labelledby="gmi-browse-dialog-title"><div class="gmi-dialog-head"><h2 id="gmi-browse-dialog-title">{{ t('Find a theme', '查找主题') }}</h2><button class="gmi-action-secondary" type="button" data-browse-close>{{ t('Done', '完成') }}</button></div><div data-browse-slot></div></dialog>
<p class="gmi-vh" role="status" aria-live="polite" aria-atomic="true" data-gmi-announcement></p>
<details class="gmi-advanced"><summary><span>{{ t('Taxonomy & value-chain census', '分类与价值链全览') }}</span><small>{{ t('All topics, review status and classification paths', '全部主题、审核状态与分类路径') }}</small>{{ ic('chev', 18) }}</summary><div class="gmi-advanced-body">{% include "_gmi_taxonomy.html.j2" %}</div></details>
{% endblock %}
{% block page_data %}<script type="application/json" id="gmi-topic-data">{{ {'topics': public_topics, 'categories': topic_names, 'asof': model.asof}|tojson }}</script>{% endblock %}
