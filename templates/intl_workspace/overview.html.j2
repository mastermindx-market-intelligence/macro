{% set projection_context = overview %}
{% set source_value = projection_context.context.source_reference if projection_context.context.source_reference is not none else '' %}
{% set quality_labels = {
  'qualified': {'en': 'Qualified', 'zh': '符合条件'},
  'stale': {'en': 'Stale data', 'zh': '数据过期'},
  'missing': {'en': 'Missing data', 'zh': '数据缺失'},
  'denied': {'en': 'Information withheld', 'zh': '信息未披露'},
  'failed': {'en': 'Calculation failed', 'zh': '计算失败'},
  'unsupported': {'en': 'Unsupported', 'zh': '不支持'},
  'unknown': {'en': 'Unavailable', 'zh': '不可用'}
} %}
{% macro quality_notice(metric) %}
  {% if metric.value is none %}
    {% set quality = quality_labels.get(metric.quality, quality_labels.unknown) %}
    <small data-im-quality><span class="l-en">{{ quality.en|e }}</span><span class="l-zh" lang="zh">{{ quality.zh|e }}</span></small>
  {% endif %}
{% endmacro %}
<section
  class="intl-overview"
  data-im-panel
  data-view="overview"
  data-horizon="{{ projection_context.context.horizon|e }}"
  data-basis="{{ projection_context.context.currency_basis|e }}"
  data-return-basis="{{ projection_context.context.return_basis|e }}"
  data-source="{{ source_value|e }}"
  {% if generation|default('') %}data-im-generation="{{ generation|e }}"{% endif %}
  id="{{ context_id|e }}-overview"
  aria-labelledby="{{ context_id|e }}-title"
>
  {# The shell header and the selected Overview tab already name this panel; the
     native h2 keeps the section's semantic heading and stays in the accessibility
     tree, visually hidden rather than removed. #}
  <h2 id="{{ context_id|e }}-title" class="intl-overview__panel-title">
    <span class="l-en">Market overview</span>
    <span class="l-zh" lang="zh">市场概览</span>
  </h2>

  <div class="intl-overview__first-read">
    <div class="intl-overview__summary" data-im-summary>
      <p class="intl-overview__eyebrow{% if overview.ranking_status != 'available' %} intl-overview__eyebrow--attention{% endif %}">
        {% if overview.ranking_status == 'available' %}
          <span class="l-en">Qualified returns</span><span class="l-zh" lang="zh">符合条件的回报</span>
        {% elif overview.ranking_reason == 'unequal_windows' %}
          <span class="l-en">Returns not comparable</span><span class="l-zh" lang="zh">回报不可比</span>
        {% else %}
          <span class="l-en">Returns unavailable</span><span class="l-zh" lang="zh">回报不可用</span>
        {% endif %}
      </p>
      <div class="intl-overview__context">
        <span class="l-en">{{ projection_context.configured_count }} configured markets, {{ projection_context.eligible_count }} qualified returns</span>
        <span class="l-zh" lang="zh">覆盖市场 {{ projection_context.configured_count }} 个，符合条件的回报 {{ projection_context.eligible_count }} 个</span>
        <span class="l-en">{{ projection_context.context.horizon|e }}</span>
        <span class="l-zh" lang="zh">{{ projection_context.context.horizon|e }}</span>
        {% if projection_context.context.currency_basis == 'usd_unhedged' %}
          <span class="l-en">USD · Unhedged</span><span class="l-zh" lang="zh">美元·未对冲</span>
        {% else %}
          <span class="l-en">Local currency</span><span class="l-zh" lang="zh">本币</span>
        {% endif %}
        <span class="l-en">Price return</span><span class="l-zh" lang="zh">价格回报</span>
      </div>

      {% if overview.summary.kind == 'highest_lowest_returns' %}
        {% set highest = overview.rows | selectattr('market_id', 'defined') | selectattr('market_id', 'equalto', overview.summary.highest_market_id) | first %}
        {% set lowest = overview.rows | selectattr('market_id', 'defined') | selectattr('market_id', 'equalto', overview.summary.lowest_market_id) | first %}
        <h3>
          <span class="l-en">Highest and lowest returns</span><span class="l-zh" lang="zh">最高与最低回报</span>
        </h3>
        <p>
          <span class="l-en"><strong>{{ highest.name_en|e }}</strong> highest, <strong>{{ lowest.name_en|e }}</strong> lowest</span>
          <span class="l-zh" lang="zh"><strong>{{ lowest.name_zh|e }}</strong> 最低，<strong>{{ highest.name_zh|e }}</strong> 最高</span>
        </p>
        {% if overview.summary.positive_count is not none or (overview.summary.fx_detracted_count is not none and projection_context.context.currency_basis == 'usd_unhedged') %}
          <dl class="intl-overview__stats">
            {% if overview.summary.positive_count is not none %}
            <div>
              <dt><span class="l-en">Positive returns</span><span class="l-zh" lang="zh">正回报</span></dt>
              <dd>{{ overview.summary.positive_count }} / {{ projection_context.eligible_count }}</dd>
            </div>
            {% endif %}
            {% if overview.summary.fx_detracted_count is not none and projection_context.context.currency_basis == 'usd_unhedged' %}
            <div>
              <dt><span class="l-en">Reduced by currency</span><span class="l-zh" lang="zh">受汇率拖累</span></dt>
              <dd>{{ overview.summary.fx_detracted_count }} / {{ overview.summary.fx_eligible_count }}</dd>
            </div>
            {% endif %}
          </dl>
        {% endif %}
      {% elif overview.ranking_reason == 'unequal_windows' %}
        <h3><span class="l-en">Available returns use different calculation windows</span><span class="l-zh" lang="zh">可用回报采用不同计算窗口</span></h3>
        <p>
          <span class="l-en">Comparable current returns cannot be shown for this selection. Some returns exist, but they were measured over different periods, so they cannot be compared side by side.</span>
          <span class="l-zh" lang="zh">此选择无法显示可比的当前回报。部分回报虽存在，但计算区间不同，无法并排比较。</span>
        </p>
      {% else %}
        <h3><span class="l-en">Current returns unavailable</span><span class="l-zh" lang="zh">当前回报不可用</span></h3>
        <p>
          <span class="l-en">Comparable current returns cannot be shown for this selection. The covered markets have not met the research standard for comparing returns right now, so no ranking, figure or market read is offered.</span>
          <span class="l-zh" lang="zh">此选择无法显示可比的当前回报。目前覆盖市场尚未达到比较回报所需的研究要求，因此不提供排名、数字或市场解读。</span>
        </p>
      {% endif %}
      <p class="intl-overview__limitation">
        {% if overview.ranking_status == 'available' %}
          <span class="l-en">Comparable price returns; not an allocation recommendation</span>
          <span class="l-zh" lang="zh">可比价格回报；不构成配置建议</span>
        {% else %}
          <span class="l-en">Unavailable evidence does not mean low risk.</span>
          <span class="l-zh" lang="zh">证据不可用不代表风险较低。</span>
        {% endif %}
      </p>
    </div>

    {% if overview.ranking_status == 'available' and overview.focus_ids %}
      {% set focus_rows = [] %}
      {% for focus_id in overview.focus_ids %}
        {% for row in overview.rows %}
          {% if row.market_id is defined and row.market_id == focus_id %}{% set _ = focus_rows.append(row) %}{% endif %}
        {% endfor %}
      {% endfor %}
      <div class="intl-overview__focus" data-im-focus>
        <div class="intl-overview__focus-head">
          <h3>
            <span class="l-en">{% if projection_context.eligible_count > 4 %}Three highest and lowest remaining{% else %}All qualified returns{% endif %}</span>
            <span class="l-zh" lang="zh">{% if projection_context.eligible_count > 4 %}最高三个及其余最低一个{% else %}全部符合条件的回报{% endif %}</span>
          </h3>
          <p class="intl-overview__focus-context">
            <span class="l-en">{{ projection_context.context.horizon|e }} · {% if projection_context.context.currency_basis == 'usd_unhedged' %}USD · Unhedged{% else %}Local currency{% endif %} · Price return</span>
            <span class="l-zh" lang="zh">{{ projection_context.context.horizon|e }} · {% if projection_context.context.currency_basis == 'usd_unhedged' %}美元 · 未对冲{% else %}本币{% endif %} · 价格回报</span>
          </p>
          <p class="intl-overview__focus-note">
            <span class="l-en">Ordered by return · Not a pick list</span>
            <span class="l-zh" lang="zh">按回报排序 · 非推荐名单</span>
          </p>
        </div>
        <ol class="intl-overview__focus-list" data-im-focus-list>
          {% for row in focus_rows %}
            <li data-im-focus-item data-market-id="{{ row.market_id|e }}" id="{{ context_id|e }}-focus-{{ row.slot|e }}">
              <span class="intl-overview__market-name"><span class="l-en">{{ row.name_en|e }}</span><span class="l-zh" lang="zh">{{ row.name_zh|e }}</span></span>
              {% if row.index_id is defined %}<span class="intl-overview__index" data-index-id="{{ row.index_id|e }}">{{ row.index_label|e }}</span>{% endif %}
              <span class="intl-overview__return{% if row.metric.value is not none and row.metric.value > 0 %} intl-overview__return--up{% elif row.metric.value is not none and row.metric.value < 0 %} intl-overview__return--down{% endif %}" data-im-return>
                {% if row.metric.value is none %}
                  <span class="l-en">Unavailable</span><span class="l-zh" lang="zh">不可用</span>
                {% else %}
                  {{ '%+.2f'|format(row.metric.value) if row.metric.value > 0 else '%.2f'|format(row.metric.value) }}%
                {% endif %}
              </span>
            </li>
          {% endfor %}
        </ol>
        <div class="intl-overview__focus-footer">
          <div class="intl-overview__focus-footer-copy">
            <p class="intl-overview__focus-footer-title">
              <span class="l-en">All {{ projection_context.configured_count }} covered markets, full attribution</span>
              <span class="l-zh" lang="zh">全部 {{ projection_context.configured_count }} 个覆盖市场与完整归因</span>
            </p>
            <p class="intl-overview__focus-footer-note">
              <span class="l-en">Expand shows every covered market with local, USD and currency-effect detail.</span>
              <span class="l-zh" lang="zh">展开后显示每个覆盖市场的本币、美元与汇率影响明细。</span>
            </p>
          </div>
          <button
            class="intl-overview__expansion-trigger"
            type="button"
            hidden
            data-im-action="set_expanded"
            data-im-expanded="true"
            data-im-expansion-trigger
            aria-controls="{{ context_id|e }}-markets"
            aria-expanded="true"
          >
            <span class="l-en">Expand all markets</span><span class="l-zh" lang="zh">展开全部市场</span>
          </button>
        </div>
      </div>
    {% else %}
      <div class="intl-overview__coverage" data-im-coverage>
        <div class="intl-overview__coverage-head">
          <h3>
            <span class="l-en">Coverage and evidence</span>
            <span class="l-zh" lang="zh">覆盖与依据</span>
          </h3>
          <p class="intl-overview__coverage-context">
            <span class="l-en">{{ projection_context.context.horizon|e }} · {% if projection_context.context.currency_basis == 'usd_unhedged' %}USD · Unhedged{% else %}Local currency{% endif %} · Price return</span>
            <span class="l-zh" lang="zh">{{ projection_context.context.horizon|e }} · {% if projection_context.context.currency_basis == 'usd_unhedged' %}美元 · 未对冲{% else %}本币{% endif %} · 价格回报</span>
          </p>
          <p class="intl-overview__coverage-note">
            <span class="l-en">Evidence status for every covered market</span>
            <span class="l-zh" lang="zh">每个覆盖市场的依据状态</span>
          </p>
        </div>
        <ul class="intl-overview__coverage-list">
          {% for row in overview.rows %}
            {% if row.quality == 'denied' %}
              <li class="intl-overview__coverage-row intl-overview__coverage-row--withheld">
                <span class="intl-overview__coverage-status">
                  <span class="l-en">Market details withheld</span><span class="l-zh" lang="zh">市场详情未披露</span>
                </span>
              </li>
            {% else %}
              {% set coverage_quality = quality_labels.get(row.quality, quality_labels.unknown) %}
              <li class="intl-overview__coverage-row">
                <span class="intl-overview__coverage-name"><span class="l-en">{{ row.name_en|e }}</span><span class="l-zh" lang="zh">{{ row.name_zh|e }}</span></span>
                <span class="intl-overview__coverage-status"><span class="l-en">{{ coverage_quality.en|e }}</span><span class="l-zh" lang="zh">{{ coverage_quality.zh|e }}</span></span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
        <div class="intl-overview__coverage-footer">
          <div class="intl-overview__coverage-footer-copy">
            <p class="intl-overview__coverage-footer-note">
              <span class="l-en">Expand lists the same roster with full detail; deeper research remains available below.</span>
              <span class="l-zh" lang="zh">展开后列出同一清单及完整明细；更深入的研究仍可在下方查看。</span>
            </p>
          </div>
          <button
            class="intl-overview__expansion-trigger"
            type="button"
            hidden
            data-im-action="set_expanded"
            data-im-expanded="true"
            data-im-expansion-trigger
            aria-controls="{{ context_id|e }}-markets"
            aria-expanded="true"
          >
            <span class="l-en">Expand all markets</span><span class="l-zh" lang="zh">展开全部市场</span>
          </button>
        </div>
      </div>
    {% endif %}
  </div>

  <section
    class="intl-overview__markets"
    id="{{ context_id|e }}-markets"
    data-im-expanded-region
    aria-labelledby="{{ context_id|e }}-markets-title"
  >
    <h3 id="{{ context_id|e }}-markets-title">
      <span class="l-en">All markets</span>
      <span class="l-zh" lang="zh">全部市场</span>
    </h3>
    <div class="intl-overview__market-list" data-im-market-list role="list">
      {% for row in overview.rows %}
        {% if row.quality == 'denied' %}
          <article class="intl-overview__market __market" data-im-market-denied id="{{ context_id|e }}-market-{{ row.slot|e }}" role="listitem">
            <p data-im-denied><span class="l-en">Market details withheld</span><span class="l-zh" lang="zh">市场详情未披露</span></p>
          </article>
        {% elif row.quality == 'unknown' %}
          <article class="intl-overview__market __market" data-im-market-unknown id="{{ context_id|e }}-market-{{ row.slot|e }}" role="listitem">
            <p><span class="l-en">{{ row.name_en|e }}</span><span class="l-zh" lang="zh">{{ row.name_zh|e }}</span></p>
            <div>
              <span><span class="l-en">Unavailable</span><span class="l-zh" lang="zh">不可用</span></span>
            </div>
          </article>
        {% else %}
          <article class="intl-overview__market __market" data-im-market id="{{ context_id|e }}-market-{{ row.slot|e }}" role="listitem">
            <p><span class="l-en">{{ row.name_en|e }}</span><span class="l-zh" lang="zh">{{ row.name_zh|e }}</span></p>
            <div>
              <span data-im-market-id>{{ row.market_id|e }}</span>
              <span data-im-index>{{ row.index_label|e }}</span>
              <div data-im-metrics>
                <div><span class="l-en">Selected return</span><span class="l-zh" lang="zh">所选回报</span> <span data-im-selected>{% if row.metric.value is none %}{{ quality_notice(row.metric) }}{% else %}{{ '%+.2f'|format(row.metric.value) if row.metric.value > 0 else '%.2f'|format(row.metric.value) }}{% if row.metric.unit == 'percent' %}%{% endif %}{% endif %}</span></div>
                <div><span class="l-en">Local</span><span class="l-zh" lang="zh">本币</span> <span data-im-local>{% if row.local.value is none %}{{ quality_notice(row.local) }}{% else %}{{ '%+.2f'|format(row.local.value) if row.local.value > 0 else '%.2f'|format(row.local.value) }}{% if row.local.unit == 'percent' %}%{% endif %}{% endif %}</span></div>
                <div><span class="l-en">USD</span><span class="l-zh" lang="zh">美元</span> <span data-im-usd>{% if row.usd.value is none %}{{ quality_notice(row.usd) }}{% else %}{{ '%+.2f'|format(row.usd.value) if row.usd.value > 0 else '%.2f'|format(row.usd.value) }}{% if row.usd.unit == 'percent' %}%{% endif %}{% endif %}</span></div>
                <div><span class="l-en">Currency effect</span><span class="l-zh" lang="zh">汇率影响</span> <span data-im-fx>{% if row.fx_contribution.value is none %}{{ quality_notice(row.fx_contribution) }}{% else %}{{ '%+.2f'|format(row.fx_contribution.value) if row.fx_contribution.value > 0 else '%.2f'|format(row.fx_contribution.value) }}{% if row.fx_contribution.unit == 'percentage_points' %} <span class="l-en">pp</span><span class="l-zh" lang="zh">个百分点</span>{% endif %}{% endif %}</span></div>
                {% if row.metric.window %}
                  <div data-im-window><span class="l-en">Calculation window</span><span class="l-zh" lang="zh">计算窗口</span> <time datetime="{{ row.metric.window.start|e }}">{{ row.metric.window.start|e }}</time>–<time datetime="{{ row.metric.window.end|e }}">{{ row.metric.window.end|e }}</time></div>
                {% endif %}
              </div>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </section>
</section>
