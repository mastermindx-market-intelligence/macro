/* Sector Central -> Prophet identity contract. Canonical sector ETF identities
   follow engine.spotlight.GICS_TO_ETF. URL context supplies identity only;
   the native Screener owner applies its filter after an explicit click. */
function sectorProphetIdentity(id) {
  var sectors = {
    XLB:['Materials','原材料'], XLC:['Communication Services','通信服务'],
    XLE:['Energy','能源'], XLF:['Financials','金融'], XLI:['Industrials','工业'],
    XLK:['Information Technology','信息技术'], XLP:['Consumer Staples','必需消费'],
    XLRE:['Real Estate','房地产'], XLU:['Utilities','公用事业'],
    XLV:['Health Care','医疗保健'], XLY:['Consumer Discretionary','可选消费']
  };
  if (typeof id !== 'string' || !Object.prototype.hasOwnProperty.call(sectors, id)) return null;
  return {id:id, name_en:sectors[id][0], name_zh:sectors[id][1]};
}
function sectorProphetHref(group, context) {
  if (!group || group.group_kind !== 'sector') return null;
  var sector = sectorProphetIdentity(group.group_id);
  if (!sector) return null;
  var href = 'us_stocks.html?si_sector=' + encodeURIComponent(sector.id);
  /* SIC-I06R: dated context rides as explicit params only. The ladder
     filter's own query param is never emitted here — arrival must not
     filter (masterplan §8.3). */
  if (context) {
    if (context.asof) href += '&si_asof=' + encodeURIComponent(context.asof);
    if (context.gen) href += '&si_gen=' + encodeURIComponent(context.gen);
    if (context.origin) href += '&si_origin=' + encodeURIComponent(context.origin);
  }
  return href + '#sector-prophet-context';
}
/* SIC-I06R optional context readers. Same parse style as si_sector
   (params.getAll), but these are display context, not identity: exactly one
   strictly-shaped value is read, and anything missing, duplicated or
   malformed is omitted — never invented. */
function sectorProphetAsof(params) {
  var values = params.getAll('si_asof');
  if (values.length !== 1) return null;
  var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(values[0]);
  if (!m) return null;
  /* Strict calendar round-trip (engine-stable): a fabricated date such as
     2026-02-30 rolls over and fails the component comparison. */
  var dt = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
  return dt.getFullYear() === Number(m[1]) && dt.getMonth() === Number(m[2]) - 1 &&
    dt.getDate() === Number(m[3]) ? values[0] : null;
}
function sectorProphetGen(params) {
  var values = params.getAll('si_gen');
  // RI06 MINOR 2: printable ASCII, 1-64 chars, no leading/trailing space (space-only is not a generation)
  if (values.length !== 1 || !/^[\x21-\x7E](?:[\x20-\x7E]{0,62}[\x21-\x7E])?$/.test(values[0])) return null;
  return values[0];
}
/* Return destinations are an allowlist of relative Sector Intelligence pages
   (Sector Central, Sector Cycles, per-ETF Dossier) with an optional fragment.
   Everything else — absolute URLs, other pages, query strings — is dropped
   and the fixed fallback return applies. */
function sectorProphetOrigin(params) {
  var values = params.getAll('si_origin');
  if (values.length !== 1) return null;
  var v = values[0];
  if (!/^(sector_central\.html|sector_cycles\.html|sectors\/[A-Z]+\.html)(#[A-Za-z0-9_-]*)?$/.test(v)) return null;
  var etf = /^sectors\/([A-Z]+)\.html/.exec(v);
  if (etf && !sectorProphetIdentity(etf[1])) return null;
  return v;
}
function sectorProphetSelection(search) {
  var params = new URLSearchParams(search);
  var values = params.getAll('si_sector');
  if (!values.length) return {status:'absent'};
  var sector = values.length === 1 ? sectorProphetIdentity(values[0]) : null;
  if (!sector) return {status:'invalid'};
  var read = {status:'selected', id:sector.id, name_en:sector.name_en, name_zh:sector.name_zh,
    return_href:'sector_central.html?g=' + encodeURIComponent(sector.id) + '#map'};
  var asof = sectorProphetAsof(params);
  if (asof) read.asof = asof;
  var gen = sectorProphetGen(params);
  if (gen) read.gen = gen;
  var origin = sectorProphetOrigin(params);
  if (origin) read.origin = origin;
  return read;
}
(function () {
  'use strict';
  var root = document.getElementById('sector-prophet-context');
  if (!root) return;
  var subject = document.getElementById('si-prophet-subject');
  var note = document.getElementById('si-prophet-note');
  var back = document.getElementById('si-prophet-return');
  var clear = document.getElementById('si-prophet-clear');
  var screener = document.getElementById('si-prophet-screener');
  if (!subject || !note || !back || !clear || !screener) return;
  /* Readback legs authored in the partial (t() carriers, hidden). Falls
     back to '' when a carrier is absent, so that segment is simply omitted. */
  function legText(id, zh) {
    var el = document.getElementById(id);
    if (!el) return '';
    var leg = el.querySelector ? el.querySelector(zh ? '.l-zh' : '.l-en') : null;
    var text = leg ? leg.textContent : el.textContent;
    return (text || '').trim();
  }
  /* Honest population: count the rows the stocks table ACTUALLY carries for
     the selected sector. The page has no sector membership roster, so this is
     a loaded-count, not a coverage claim. Null when the table has not loaded
     (or is unparseable) — then no count is shown at all. */
  function membersLoaded(nameEn) {
    var el = document.getElementById('us-stocktable-data');
    if (!el || typeof nameEn !== 'string') return null;
    try {
      var data = JSON.parse(el.textContent || el.innerText || '{}');
      var rows = data && Array.isArray(data.rows) ? data.rows : [];
      var n = 0;
      for (var i = 0; i < rows.length; i++) if (rows[i] && rows[i].sector === nameEn) n += 1;
      return n;
    } catch (err) { return null; }
  }
  function screenerReady() {
    return window.USStockTable && typeof window.USStockTable._selectSector === 'function' &&
      window.USProphetSource && typeof window.USProphetSource.set === 'function';
  }
  function render() {
    var read = sectorProphetSelection(window.location.search);
    var zh = document.documentElement.getAttribute('data-lang') === 'zh';
    root.hidden = read.status === 'absent';
    root.setAttribute('data-status', read.status);
    screener.hidden = read.status !== 'selected';
    screener.disabled = read.status !== 'selected' || !screenerReady();
    if (read.status === 'absent') return;
    var rest = new URLSearchParams(window.location.search);
    // RI06 MINOR 1: clearing the context drops EVERY si_* carrier param, not just the sector
    var siKeys = [];
    rest.forEach(function (_v, k) { if (k.indexOf('si_') === 0) siKeys.push(k); });
    siKeys.forEach(function (k) { rest.delete(k); });
    var qs = rest.toString();
    var hash = window.location.hash === '#sector-prophet-context' ? '#us-standouts' : window.location.hash;
    clear.setAttribute('href', 'us_stocks.html' + (qs ? '?' + qs : '') + hash);
    if (read.status === 'invalid') {
      subject.textContent = zh ? '无法识别所选板块' : 'Selected sector unavailable';
      note.textContent = zh ? '请返回板块证据，选择一个板块。Prophet 选股仍可查看。'
        : 'Return to sector evidence to choose a sector. Prophet Stock Signals remains available.';
      back.setAttribute('href', 'sector_central.html#map');
      return;
    }
    subject.textContent = (zh ? read.name_zh : read.name_en) + ' · ' + read.id;
    screener.textContent = zh ? '在筛选器中查看该板块 →' : 'View sector in Screener →';
    screener.setAttribute('aria-label', zh ? '在筛选器中查看' + read.name_zh : 'View ' + read.name_en + ' in Screener');
    /* Dated readback: "<sector> · members as observed <si_asof> · generation
       <si_gen>", missing fields omitted; then the honest loaded count. */
    var parts = [zh ? read.name_zh : read.name_en];
    var asofLabel = legText('si-prophet-t-asof', zh);
    if (read.asof && asofLabel) parts.push(asofLabel + ' ' + read.asof);
    var genLabel = legText('si-prophet-t-gen', zh);
    if (read.gen && genLabel) parts.push(genLabel + ' ' + read.gen);
    var guidance = zh ? '在当前已加载的股票中筛选该板块；其他筛选条件仍然适用。请结合各股的形态与入场条件，并返回板块证据查看其日期。'
      : 'View this sector among the stocks loaded on this page; other filters still apply. Review each stock’s setup and entry conditions, and return to sector evidence for its dated readings.';
    var loaded = membersLoaded(read.name_en);
    var membersLabel = legText('si-prophet-t-members', zh);
    var loadedText = loaded !== null && membersLabel ? membersLabel.replace('{n}', String(loaded)) : '';
    var prefix = [parts.join(' · '), loadedText].filter(Boolean).join(' · ');
    note.textContent = prefix ? prefix + (zh ? '。' : '.') + ' ' + guidance : guidance;
    back.setAttribute('href', read.origin || read.return_href);
  }
  screener.addEventListener('click', function () {
    var read = sectorProphetSelection(window.location.search);
    if (read.status !== 'selected') return;
    if (!screenerReady() || !window.USStockTable._selectSector(read.name_en)) {
      var zh = document.documentElement.getAttribute('data-lang') === 'zh';
      note.textContent = zh ? '本页筛选器暂不可用。您仍可返回所选板块的证据。'
        : 'The Screener is unavailable on this page. You can still return to the selected sector’s evidence.';
    }
  });
  document.addEventListener('langchange', render);
  window.addEventListener('popstate', render);
  window.addEventListener('mmx:shell-location', render);
  window.addEventListener('us-screener:availability', render);
  render();
})();
