{# CCW-owned dated comparisons. Native <details>; no ranking or monitor effects. #}
{% if cdi is defined %}
<section class="cdi" id="credit-dislocation" aria-labelledby="cdi-title" data-cdi-root>
  <header class="cdi-heading">
    <div>
      <p class="cdi-eyebrow">{{ t('Corporate credit · issuer comparison', '公司信用 · 发行人比较') }}</p>
      <h2 id="cdi-title">{{ t(cdi.title_en, cdi.title_zh) }}</h2>
      <p class="cdi-subtitle">{{ t(cdi.subtitle_en, cdi.subtitle_zh) }}</p>
    </div>
    <span class="cdi-status{% if cdi.status == 'stale' %} cdi-status-stale{% endif %}">
      {{ t('Historical only', '仅供历史参考') if cdi.status == 'stale' else t('Research context', '研究参考') }}
    </span>
  </header>
  {% if not cdi.available %}
  <div class="cdi-unavailable" role="status">
    {{ t('The dated credit comparison could not be loaded. Other bond-market observations remain separate.', '无法加载带日期的信用比较；其他债市观察独立显示。') }}
  </div>
  {% else %}
  <div class="cdi-coverage">
    <span>{{ t('Source date', '数据日期') }} <time datetime="{{ cdi.source_as_of }}">{{ cdi.source_as_of }}</time></span>
    <span>{{ cdi.paired_count }} / {{ cdi.issuers|length }} {{ t('paired issuer comparisons', '组发行人配对比较') }}</span>
    <span>{{ cdi.bond_count }} {{ t('mapped bond holdings', '条已映射债券持仓') }}</span>
    <span>{{ t('CDS: unavailable', 'CDS：暂无数据') }}</span>
    <span data-cdi-pricing="{{ 'passed' if cdi.pricing_qualified else 'unqualified' }}">{{ t(cdi.pricing_en, cdi.pricing_zh) }}</span>
  </div>
  <div class="cdi-toolbar">
    <label class="cdi-search-label" for="cdi-search">{{ t('Find issuer or bond identifier', '查找发行人或债券代码') }}
      <input id="cdi-search" type="search" autocomplete="off" spellcheck="false" data-cdi-search aria-controls="cdi-issuers">
    </label>
    <label for="cdi-grade">{{ t('Fund-grade cohort', '基金信用组别') }}
      <select id="cdi-grade" data-cdi-grade aria-controls="cdi-issuers">
        <option value="all" data-cdi-en="All cohorts" data-cdi-zh="全部组别">All cohorts</option>
        <option value="IG" data-cdi-en="Investment grade" data-cdi-zh="投资级">Investment grade</option>
        <option value="HY" data-cdi-en="High yield" data-cdi-zh="高收益">High yield</option>
      </select>
    </label>
    <label for="cdi-coverage-filter">{{ t('Comparison', '比较范围') }}
      <select id="cdi-coverage-filter" data-cdi-coverage aria-controls="cdi-issuers">
        <option value="all" data-cdi-en="All tracked issuers" data-cdi-zh="全部跟踪发行人">All tracked issuers</option>
        <option value="paired" data-cdi-en="Paired observations" data-cdi-zh="配对数据可用">Paired observations</option>
        <option value="missing" data-cdi-en="Coverage gaps" data-cdi-zh="存在数据缺口">Coverage gaps</option>
      </select>
    </label>
  </div>
  <p class="cdi-count" aria-live="polite" aria-atomic="true"><span data-cdi-count>{{ cdi.issuers|length }}</span> {{ t('issuers shown · five-session comparison', '家发行人 · 五个交易日比较') }}</p>
  <div class="cdi-column-head" aria-hidden="true">
    <span>{{ t('Issuer / holdings sample', '发行人 / 持仓样本') }}</span>
    <span>{{ t('Credit change', '信用利差变化') }}</span>
    <span>{{ t('Above peers', '相对同业变化') }}</span>
    <span>{{ t('Stock move', '股价变化') }}</span>
    <span>{{ t('Interpretation', '观察说明') }}</span>
  </div>
  <div id="cdi-issuers" class="cdi-issuers">
    {% for row in cdi.issuers %}
    <details class="cdi-issuer" data-cdi-issuer data-search="{{ row.search_text }}" data-grade="{{ row.tier }}" data-paired="{{ 'yes' if row.paired else 'no' }}">
      <summary>
        <span class="cdi-name"><strong>{{ row.issuer }}</strong><small>{{ t(row.theme_en, row.theme_zh) }} · {{ row.tier }} · {{ row.bonds|length }} {{ t('bonds', '只债券') }}</small></span>
        <span class="cdi-number{% if row.credit_direction == 'wider' %} cdi-wider{% endif %}"><small class="cdi-mobile-label">{{ t('Credit change', '信用利差变化') }}</small>{{ row.change }}</span>
        <span class="cdi-number"><small class="cdi-mobile-label">{{ t('Above peers', '相对同业变化') }}</small>{{ row.relative }}</span>
        <span class="cdi-number"><small class="cdi-mobile-label">{{ t('Stock move', '股价变化') }}</small>{{ row.equity }}</span>
        <span class="cdi-interpretation{% if row.tone == 'question' %} cdi-question{% endif %}">{{ t(row.state_en, row.state_zh) }}</span>
        <span class="cdi-chevron" aria-hidden="true">⌄</span>
      </summary>
      <div class="cdi-detail">
        <dl class="cdi-facts">
          <div><dt>{{ t('Coarse comparison', '粗略同业比较') }}</dt><dd>{{ row.peer_count }} {{ t('other issuers · grade + maturity bucket', '家其他发行人 · 信用组别及期限桶') }}</dd><dd class="cdi-small">{{ row.peers or '—' }}</dd></div>
          <div><dt>{{ t('Peer median / 21-session credit move', '同业中位数 / 21日信用变化') }}</dt><dd>{{ row.peer_change }} / {{ row.change21 }}</dd><dd class="cdi-small">{{ t('Changes in matched bond samples, not OAS', '匹配债券样本变化，非期权调整利差') }}</dd></div>
          <div><dt>{{ t('Spread-velocity change', '利差变化速度之差') }}</dt><dd>{{ row.acceleration }}</dd><dd class="cdi-small">{{ t('Recent five sessions versus previous five', '最近五日与此前五日比较') }}</dd></div>
        </dl>
        {% if row.notes %}<div class="cdi-notes">{% for en, zh in row.notes %}<p>{{ t(en, zh) }}</p>{% endfor %}</div>{% endif %}
        <details class="cdi-bond-inspector" data-cdi-bond-inspector>
          <summary>{{ t('Inspect tracked bonds', '查看跟踪债券') }} <span>({{ row.bonds|length }})</span></summary>
          <div class="cdi-bond-target" data-cdi-bond-target></div>
          <template data-cdi-bond-template>
            {% if row.bonds %}
            <div class="cdi-table-scroll" tabindex="0" role="region" aria-label="{{ row.issuer }} bond holdings">
              <table class="cdi-bond-table">
                <caption>{{ row.issuer }} · {{ cdi.source_as_of }} · {{ t('fund-held sample, not total issuer debt', '基金持仓样本，非发行人全部债务') }}</caption>
                <thead><tr><th scope="col">{{ t('Security / identifier', '债券 / 代码') }}</th><th scope="col">{{ t('Maturity', '到期日') }}</th><th scope="col">{{ t('Coupon', '票息') }}</th><th scope="col">{{ t('Clean price', '净价') }}</th><th scope="col">{{ t('G-spread', '国债相对利差') }}</th><th scope="col">{{ t('Instrument history', '债券历史') }}</th><th scope="col">{{ t('Review', '核验') }}</th></tr></thead>
                <tbody>{% for bond in row.bonds %}<tr>
                  <th scope="row">{{ bond.name }}<small>{{ bond.identifier_type }} {{ bond.identifier }}</small></th>
                  <td>{{ bond.maturity }}</td><td>{{ bond.coupon }}</td><td>{{ bond.price }}</td><td>{{ bond.spread }}</td>
                  <td class="cdi-small">
                    <div>{{ t('5 / 21 sessions', '5 / 21个交易日') }}: {{ bond.history5 }} / {{ bond.history21 }}</div>
                    <div>{{ t(bond.history_coverage_en, bond.history_coverage_zh) }}</div>
                    <div>{{ bond.history_currency }} · {{ t('Treasury observation', '美国国债观察日') }} {{ bond.history_curve_as_of }}</div>
                    {% if bond.history_reason_en %}<div>{{ t(bond.history_reason_en, bond.history_reason_zh) }}</div>{% endif %}
                  </td>
                  <td class="cdi-small">{% if not bond.identifier_valid %}{{ t('Identifier unresolved', '代码待核验') }}{% elif bond.call_review %}{{ t('Option terms need review', '期权条款待核验') }}{% else %}{{ t('Legal terms not complete', '法律条款未齐全') }}{% endif %}</td>
                </tr>{% endfor %}</tbody>
              </table>
            </div>
            <p class="cdi-small">{{ t('History covers currently mapped fund-held instruments. Recalculated observations do not establish historical publication timing or independently verified historical prices.', '历史覆盖当前已映射的基金持仓债券；重算观察不证明历史发布时点或历史价格已经独立核验。') }}</p>
            {% else %}<p>{{ t('No bond-level observations match this issuer and date.', '该发行人在此日期没有匹配的债券级观察。') }}</p>{% endif %}
          </template>
          <noscript><p>{{ t('Enable JavaScript to open the bounded bond table. The issuer comparisons above remain available.', '启用JavaScript以展开债券表；上方发行人比较仍可阅读。') }}</p></noscript>
        </details>
        <div class="cdi-countercase">
          <strong>{{ t('Test the countercase', '检验相反解释') }}</strong>
          <p>{{ t('New-issue supply, evaluated-price delays and liquidity can move spreads without a financing crisis. Check the legal borrower, actual debt obligations and an independent price before drawing a conclusion.', '新债供给、估值报价延迟或流动性均可推动利差变化，而不一定意味着融资危机。判断前应核查法律借款人、实际债务负担及独立价格。') }}</p>
        </div>
      </div>
    </details>
    {% endfor %}
  </div>
  <p class="cdi-no-results" data-cdi-no-results hidden>{{ t('No issuers match these filters. Clear the search or change the cohort.', '没有符合条件的发行人；请清空搜索或调整组别。') }}</p>
  <details class="cdi-method">
    <summary>{{ t('How to read this comparison', '如何理解这些比较') }}</summary>
    <p>{{ t('Credit changes sum the same-bond daily changes over complete common trading sessions. Peer differences are coarse comparisons, not fair-value estimates. Stock moves use source closing observations and are not certified total returns. Descriptive thresholds have not been validated as forecasts.', '信用变化累计完整共同交易日的同券日变化。同业差异属于粗略比较，而非公允价值估计。股价变化使用来源收盘观察，未经认证为总回报。描述性阈值尚未验证为预测信号。') }}</p>
    <p>{{ t('The registry maps economic parent groups; legal borrower and guarantee relationships remain separate. Holdings do not establish all outstanding debt. Historical publication vintages, live CDS quotes and loss probabilities are not supplied by this view.', '登记表映射经济母公司组别；法律借款人与担保关系须另行确认。持仓样本不能代表全部在外债务。本视图不提供已认证的历史发布版本、实时CDS报价或损失概率。') }}</p>
  </details>
  {% endif %}
</section>
<style>
.cdi{--cdi-border:var(--line);margin:28px 0;color:var(--text);font-size:14px;line-height:1.5;scroll-margin-top:80px}
.cdi *{box-sizing:border-box}.cdi [hidden]{display:none!important}
.cdi-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:18px}
.cdi-eyebrow{font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);margin:0 0 8px}
.cdi h2{font-size:25px;line-height:1.25;letter-spacing:-.025em;color:var(--ink);margin:0 0 10px}
.cdi-subtitle{margin:0;color:var(--muted);max-width:670px}.cdi-status{white-space:nowrap;border:1px solid var(--cdi-border);border-radius:var(--r-sm);padding:5px 9px;color:var(--muted);font-size:12px}
.cdi-status-stale{color:var(--ink-warn,var(--warn));background:var(--panel2);border-color:var(--ink-warn,var(--warn))}
html[data-theme="light"] .cdi .cdi-status-stale{color:color-mix(in srgb,var(--ink-warn,var(--warn)) 60%,var(--text))}
.cdi-coverage{display:flex;flex-wrap:wrap;gap:10px 22px;padding:12px 0;color:var(--muted);font-size:12px;border-top:1px solid var(--cdi-border)}
.cdi-coverage time{color:var(--text);font-variant-numeric:tabular-nums}
.cdi-toolbar{display:flex;gap:16px;align-items:flex-end;margin:12px 0}
.cdi-toolbar label{display:flex;flex-direction:column;gap:5px;font-size:12px;color:var(--muted)}
.cdi-search-label{flex:1}.cdi-toolbar input,.cdi-toolbar select{font:inherit;font-size:14px;min-height:42px;border:1px solid var(--muted);border-radius:var(--r-sm);padding:8px 12px;background:var(--card);color:var(--text);max-width:100%}
.cdi-count{font-size:12px;color:var(--muted);margin:12px 0}
.cdi-column-head,.cdi-issuer>summary{display:grid;grid-template-columns:minmax(175px,1.8fr) minmax(85px,1fr) minmax(85px,1fr) minmax(75px,.9fr) minmax(180px,1.9fr) 18px;gap:16px;align-items:center;padding:15px 18px}
.cdi-column-head{font-size:11px;color:var(--muted);border-bottom:1px solid var(--cdi-border)}
.cdi-issuers{border:1px solid var(--cdi-border);border-top:0;border-radius:0 0 var(--r-sm) var(--r-sm);background:var(--card);overflow:hidden}
.cdi-issuer+ .cdi-issuer{border-top:1px solid var(--cdi-border)}
.cdi-issuer>summary{list-style:none;cursor:pointer;min-height:78px}.cdi-issuer>summary::-webkit-details-marker{display:none}
.cdi-issuer>summary:hover{background:var(--panel2)}.cdi-issuer[open]>summary{background:var(--panel2)}
.cdi-name strong{font-size:14px;font-weight:650;color:var(--ink)}.cdi-name small{display:block;font-size:11px;color:var(--muted);margin-top:3px}
.cdi-number{font-variant-numeric:tabular-nums;white-space:nowrap;font-size:14px}.cdi-wider{color:var(--ink-down,var(--red))}
.cdi-interpretation{font-size:12px;line-height:1.4;color:var(--muted)}.cdi-question{color:var(--ink);font-weight:600}
.cdi-chevron{color:var(--muted);transition:transform .15s}.cdi-issuer[open]>.cdi-chevron,.cdi-issuer[open]>summary .cdi-chevron{transform:rotate(180deg)}
.cdi-mobile-label{display:none}.cdi-detail{padding:20px 18px;border-top:1px solid var(--cdi-border)}
.cdi-facts{display:grid;grid-template-columns:1.2fr 1.2fr 1fr;gap:20px;margin:0 0 18px}
.cdi-facts dt{font-size:11px;color:var(--muted);margin-bottom:6px}.cdi-facts dd{font-size:13px;margin:0 0 4px;color:var(--text);overflow-wrap:anywhere}
.cdi .cdi-small{font-size:11px;color:var(--muted)}.cdi-notes{font-size:12px;color:var(--muted);border-left:2px solid var(--cdi-border);padding-left:12px;margin:10px 0}.cdi-notes p{margin:4px 0}
.cdi-bond-inspector>summary,.cdi-method>summary{cursor:pointer;padding:12px 0;color:var(--ink);font-weight:600;font-size:13px;min-height:44px}
.cdi-bond-inspector{border-top:1px solid var(--cdi-border)}.cdi-table-scroll{overflow-x:auto;max-width:100%}
.cdi-bond-table{width:100%;border-collapse:collapse;font-size:12px;min-width:680px}.cdi-bond-table caption{text-align:left;color:var(--muted);font-size:11px;padding:10px 0}
.cdi-bond-table th,.cdi-bond-table td{text-align:left;padding:10px 9px;border-bottom:1px solid var(--cdi-border);font-variant-numeric:tabular-nums;vertical-align:top}
.cdi-bond-table thead th{font-weight:500;color:var(--muted);font-size:11px}.cdi-bond-table tbody th{font-weight:500;max-width:250px;overflow-wrap:anywhere}.cdi-bond-table th small{display:block;font-weight:400;color:var(--muted);font-size:10px}
.cdi-countercase{border-top:1px solid var(--cdi-border);padding-top:14px;margin-top:14px;font-size:12px}.cdi-countercase strong{color:var(--ink)}.cdi-countercase p,.cdi-method p{color:var(--muted);margin:6px 0;line-height:1.6}
.cdi-method{margin-top:10px;font-size:12px}.cdi-no-results,.cdi-unavailable{padding:22px;border:1px solid var(--cdi-border);border-radius:var(--r-sm);color:var(--muted);background:var(--card)}
.cdi :is(input,select,summary,.cdi-table-scroll):focus-visible{outline:2px solid var(--info,var(--blue));outline-offset:3px}
@media(max-width:900px){.cdi-column-head{display:none}.cdi-issuers{border-top:1px solid var(--cdi-border);border-radius:var(--r-sm)}.cdi-issuer>summary{grid-template-columns:1fr 1fr 1fr 18px;gap:12px}.cdi-name{grid-column:1/4}.cdi-chevron{grid-column:4;grid-row:1}.cdi-mobile-label{display:block;font-size:10px;color:var(--muted);margin-bottom:3px}.cdi-interpretation{grid-column:1/-1}.cdi-facts{grid-template-columns:1fr 1fr}.cdi-toolbar{flex-wrap:wrap}.cdi-search-label{flex-basis:100%}}
@media(max-width:480px){.cdi{margin:22px 0}.cdi-heading{flex-direction:column;gap:10px}.cdi h2{font-size:23px}.cdi-subtitle{font-size:13px}.cdi-toolbar{gap:12px}.cdi-toolbar label:not(.cdi-search-label){width:calc(50% - 6px)}.cdi-toolbar input,.cdi-toolbar select{font-size:16px;padding:8px;min-height:44px;width:100%}.cdi-issuer>summary,.cdi-detail{padding:14px}.cdi-facts{grid-template-columns:1fr;gap:12px}.cdi-coverage{gap:8px 16px}.cdi-number{font-size:13px}}
@media(prefers-reduced-motion:reduce){.cdi-chevron{transition:none}}
</style>
<script>
(function(){
  'use strict';
  var root=document.querySelector('[data-cdi-root]');
  if(!root||root.dataset.cdiBound)return;
  root.dataset.cdiBound='true';
  var search=root.querySelector('[data-cdi-search]');
  if(!search)return;
  var grade=root.querySelector('[data-cdi-grade]'),coverage=root.querySelector('[data-cdi-coverage]');
  var rows=Array.from(root.querySelectorAll('[data-cdi-issuer]'));
  // Native <option> cannot contain bilingual span markup.
  function localizeOptions(){
    var chinese=(document.documentElement.dataset.lang||'en').startsWith('zh');
    root.querySelectorAll('option[data-cdi-en]').forEach(function(option){
      option.textContent=chinese?option.dataset.cdiZh:option.dataset.cdiEn;
    });
  }
  localizeOptions();
  new MutationObserver(localizeOptions).observe(document.documentElement,{attributes:true,attributeFilter:['data-lang']});
  function filter(){
    var query=search.value.trim().toLocaleLowerCase(),shown=0;
    rows.forEach(function(row){
      var hit=(!query||(row.dataset.search||'').includes(query))&&
        (grade.value==='all'||row.dataset.grade===grade.value)&&
        (coverage.value==='all'||row.dataset.paired===(coverage.value==='paired'?'yes':'no'));
      row.hidden=!hit;if(hit)shown++;
    });
    root.querySelector('[data-cdi-count]').textContent=String(shown);
    root.querySelector('[data-cdi-no-results]').hidden=shown>0;
  }
  search.addEventListener('input',filter);grade.addEventListener('change',filter);coverage.addEventListener('change',filter);
  root.querySelectorAll('[data-cdi-bond-inspector]').forEach(function(details){
    details.addEventListener('toggle',function(){
      if(!details.open||details.dataset.loaded)return;
      var source=details.querySelector('[data-cdi-bond-template]'),target=details.querySelector('[data-cdi-bond-target]');
      if(source&&target){target.appendChild(source.content.cloneNode(true));details.dataset.loaded='true';}
    });
  });
})();
</script>
{% endif %}
