{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Capital Structure — MastermindX</title>
{% set seo_title = "Capital Structure — Observed Filing State | MastermindX" %}
{% set seo_desc = "A source-linked desk for reviewing observed SEC filing state, lifecycle changes, and evidence receipts." %}
{% set seo_path = "capital_structure.html" %}
{% include "_seo_head.html.j2" %}
<script src="capital_structure_boot.js"></script>
<link rel="stylesheet" href="theme.css">
<link rel="stylesheet" href="capital_structure.css">
</head>
<body class="cs-page">
{% set nav_search_placeholder_en = "Search any stock — US, China, HK, Canada & more…" %}
{% set nav_search_placeholder_zh = "搜索任意股票 — 美股、A 股、港股、加股等…" %}
{% include "_site_nav.html.j2" %}

<div class="cs-orbit" aria-hidden="true"></div>
<main class="cs-shell" id="cs-shell">
  <header class="cs-hero">
    <div class="cs-hero-copy">
      <p class="cs-kicker">{{ t('Capital structure intelligence', '资本结构情报') }}</p>
      <h1>{{ t('Observed Filing State', '已观察披露状态') }}</h1>
      <p class="cs-deck">{{ t('Follow what has reached the SEC record: filing state, lifecycle changes, and the source trail behind each observation.', '追踪已进入 SEC 记录的披露状态、生命周期变化及每项观察背后的来源链路。') }}</p>
    </div>
    <div class="cs-hero-read" aria-label="Desk guidance">
      <span class="cs-read-label">{{ t('Read', '阅读方式') }}</span>
      <strong>{{ t('Investigate filings — not a trade call', '核查披露文件 — 不是交易指令') }}</strong>
      <span>{{ t('State is observed, not inferred.', '呈现的是已观察状态，而非推断。') }}</span>
    </div>
  </header>

  <section class="cs-status" id="cs-status" aria-live="polite">
    <div class="cs-status-main">
      <span class="cs-status-dot" aria-hidden="true"></span>
      <div>
        <p class="cs-status-label">{{ t('Coverage', '覆盖范围') }}</p>
        <strong id="cs-coverage-state">{{ t('Loading observed filings', '正在加载已观察披露') }}</strong>
      </div>
    </div>
    <dl class="cs-status-meta">
      <div><dt>{{ t('As of', '截至') }}</dt><dd id="cs-as-of">—</dd></div>
      <div><dt>{{ t('Generated', '生成时间') }}</dt><dd id="cs-generated-at">—</dd></div>
      <div><dt>{{ t('Issuers', '发行人') }}</dt><dd id="cs-issuer-count">—</dd></div>
    </dl>
  </section>

  <section class="cs-unavailable" aria-label="Scope note">
    <span class="cs-unavailable-mark" aria-hidden="true">↳</span>
    <div>
      <strong>{{ t('What this desk does not calculate', '本工作台不计算的内容') }}</strong>
      <span>{{ t('Selected filing terms are shown below. Full instrument coverage, share-count expansion detail, cash timing, and financing forecasts remain unavailable.', '下方展示选定披露条款；完整工具覆盖、股数扩张细节、现金时间及融资预测仍不可用。') }}</span>
    </div>
  </section>

  {# B-F09-4 PREMIUM BLOCK START — additive, self-contained; see packet B-F09-4 #}
  {% set premium = premium if premium is defined else none %}
  <section class="cs-latest-card" id="cs-premium" aria-labelledby="cs-premium-title">
    <div class="cs-section-heading">
      <div>
        <p class="cs-kicker">{{ t('One deal, checked', '一宗交易，逐项核对') }}</p>
        <h2 id="cs-premium-title">{{ t('What the buyer is paying above the old share price', '买方出价比原股价高出多少') }}</h2>
      </div>
      <span class="cs-state-chip">{{ t('Reading only — not a trade call', '仅供查阅 — 不是交易指令') }}</span>
    </div>
    {% if premium and premium.status == 'computed' %}
    <p>{{ t('A buyer has offered', '买方出价') }} <strong>{{ premium.currency }} {{ '%.2f'|format(premium.offer_price) }}</strong>
       {{ t('a share for', '每股，收购') }} <strong>{{ premium.ticker }}</strong>{{ t('.', '。') }}
       {{ t('That is', '相当于') }} <strong>{{ '%+.1f'|format(premium.premium_pct) }}%</strong>
       {{ t('above the share price on the last trading day before the deal reached the SEC record.', '高于该交易进入 SEC 记录前最后一个交易日的股价。') }}</p>
    <div class="cs-latest-grid">
      <div><span>{{ t('Offer price', '出价') }}</span><strong>{{ premium.currency }} {{ '%.2f'|format(premium.offer_price) }}</strong></div>
      <div><span>{{ t('SEC filing type', 'SEC 披露文件类型') }}</span><strong>{{ premium.offer_form_type }}</strong></div>
      <div><span>{{ t('SEC accession number', 'SEC 文件编号') }}</span><strong>{{ premium.offer_accession }}</strong></div>
      <div><span>{{ t('That filing is dated', '该文件日期') }}</span><strong>{{ premium.offer_filing_date }}</strong></div>
      <div><span>{{ t('Deal first reached the record', '交易首次进入记录') }}</span><strong>{{ premium.announcement_filing_date }}</strong></div>
      <div><span>{{ t('Share price used', '所用股价') }}</span><strong>{{ premium.currency }} {{ '%.2f'|format(premium.unaffected_price) }}</strong></div>
      <div><span>{{ t('Price date', '股价日期') }}</span><strong>{{ premium.unaffected_price_date }}</strong></div>
      <div><span>{{ t('Filings so far', '已披露文件数') }}</span><strong>{{ premium.amendment_vintage.filings_in_deal }}</strong></div>
      <div><span>{{ t('Revisions so far', '修订次数') }}</span><strong>{{ premium.amendment_vintage.n_amendments }}</strong></div>
    </div>
    {% if premium.offer_price_provenance != 'filing_text_confirmed' %}
    <p class="cs-section-note">{{ t('The offer price is read from the filing summary and has not been re-checked against the filing body.', '出价读取自文件摘要，尚未与文件正文逐字复核。') }}</p>
    {% endif %}
    <p class="cs-section-note"><a href="{{ premium.source_url }}" rel="noopener noreferrer" target="_blank">{{ t('Open this filing on SEC EDGAR', '在 SEC EDGAR 打开该文件') }}</a></p>
    {% elif premium %}
    <div class="cs-unavailable">
      <span class="cs-unavailable-mark" aria-hidden="true">↳</span>
      <div><strong>{{ t(premium.null_en or 'No deal is ready to show right now.', premium.null_zh or '目前没有可展示的交易。') }}</strong></div>
    </div>
    {% else %}
    <div class="cs-unavailable">
      <span class="cs-unavailable-mark" aria-hidden="true">↳</span>
      <div><strong>{{ t('No deal is ready to show right now.', '目前没有可展示的交易。') }}</strong>
      <span>{{ t('When one is, its offer price, the share price it is measured against, and both dates appear here.', '一旦有，其出价、所对比的股价及两个日期都会显示在此。') }}</span></div>
    </div>
    {% endif %}
    <div class="cs-unavailable">
      <span class="cs-unavailable-mark" aria-hidden="true">↳</span>
      <div><strong>{{ t('Not covered here', '此处不涉及') }}</strong>
      <span>{{ t('This premium does not predict regulatory approval or whether the deal will close. Any separately qualified agreement terms follow below.', '本溢价不预测监管批准或交割概率。经另行核对的协议条款见下方。') }}</span></div>
    </div>
  </section>
  {# B-F09-4 PREMIUM BLOCK END #}

  {% include "_ma_agreement_context.html.j2" %}

  {# ── covenant-headroom:start — B-F09-13 (MO-PAID-062 slice 2). Keep contiguous.
     covenant_headroom is an OPTIONAL kwarg: guarded so any caller that renders
     this template under StrictUndefined without it (tests/test_capital_structure_page.py)
     still renders. The pure engine is in engine/covenant_headroom.py; the
     builder wires the parquet + statements + ledger reads. Spec R6 verbatim:
     the UI says "room left under the covenant" / "契约限额下还剩多少空间"
     and never the literal word "headroom". Zero authority: no rank, no
     score, no trade signal — only a plain reading of public filings vs
     the agreement's own numbers, with a typed refusal if either side is
     missing. ── #}
  {% set covenant_headroom = covenant_headroom if covenant_headroom is defined else none %}
  {% if covenant_headroom %}
  <section class="cs-latest-card cs-covenant-room" id="cs-covenant-room" aria-labelledby="cs-covenant-room-title">
    <div class="cs-section-heading">
      <div>
        <p class="cs-kicker">{{ t('One issuer, one covenant', '单一发行人，单一契约') }}</p>
        <h2 id="cs-covenant-room-title">{{ t('How much room is left under the covenant', '契约限额下还剩多少空间') }}</h2>
      </div>
      <span class="cs-state-chip">{{ t('Reading only — not a trade call', '仅供查阅 — 不是交易指令') }}</span>
    </div>
    {% if covenant_headroom.state == 'computed' %}
    {% for term in covenant_headroom.terms %}
    {% if term.state == 'computed' and term.room_turns is not none %}
    {% if term.limit_kind == 'minimum' and term.room_turns < 0 %}
    <p>{{ t('The credit agreement requires at least', '信贷协议要求收益与利息之比至少为') }}
       <strong>{{ '%.1f'|format(term.limit_raw) }}</strong>
       <span class="l-en">{{ t('x', '倍') }}</span><span class="l-zh">{{ '倍' }}</span>
       {{ t('of earnings to interest; the last annual report shows', '；最近的年报显示为') }}
       <strong>{{ '%.1f'|format(term.reported.value) }}</strong>
       <span class="l-en">{{ t('x', '倍') }}</span><span class="l-zh">{{ '倍' }}</span>
       {{ t('— it falls below the floor by', '— 低于下限') }}
       <strong>{{ '%.3f'|format(-term.room_turns) }}</strong>
       <span class="l-en">{{ t('x', '倍') }}</span><span class="l-zh">{{ '倍' }}</span>
       {{ t('.', '。') }}</p>
    {% elif term.limit_kind == 'minimum' %}
    <p>{{ t('The credit agreement requires at least', '信贷协议要求收益与利息之比至少为') }}
       <strong>{{ '%.1f'|format(term.limit_raw) }}</strong>
       <span class="l-en">{{ t('x', '倍') }}</span><span class="l-zh">{{ '倍' }}</span>
       {{ t('of earnings to interest; the last annual report shows', '；最近的年报显示为') }}
       <strong>{{ '%.1f'|format(term.reported.value) }}</strong>
       <span class="l-en">{{ t('x', '倍') }}</span><span class="l-zh">{{ '倍' }}</span>
       {{ t('— about', '— 还剩约') }}
       <strong>{{ '%.1f'|format(term.room_turns) }}</strong>
       <span class="l-en">{{ t('x', '倍') }}</span><span class="l-zh">{{ '倍' }}</span>
       {{ t('of room above the floor.', '的下限以上空间。') }}</p>
    {% elif term.room_turns < 0 %}
    <p>{{ t('The credit agreement allows up to', '信贷协议允许最高') }}
       <strong>{{ '%.1f'|format(term.limit_raw) }}</strong>
       <span class="l-en">{{ t('x', '倍') }}</span><span class="l-zh">{{ '倍' }}</span>
       {{ t('net debt to earnings; the last annual report shows', '净债务与盈利之比；最近的年报显示为') }}
       <strong>{{ '%.1f'|format(term.reported.value) }}</strong>
       <span class="l-en">{{ t('x', '倍') }}</span><span class="l-zh">{{ '倍' }}</span>
       {{ t('— it exceeds the limit by', '— 超出限额') }}
       <strong>{{ '%.3f'|format(-term.room_turns) }}</strong>
       <span class="l-en">{{ t('x', '倍') }}</span><span class="l-zh">{{ '倍' }}</span>
       {{ t('.', '。') }}</p>
    {% else %}
    <p>{{ t('The credit agreement allows up to', '信贷协议允许最高') }}
       <strong>{{ '%.1f'|format(term.limit_raw) }}</strong>
       <span class="l-en">{{ t('x', '倍') }}</span><span class="l-zh">{{ '倍' }}</span>
       {{ t('net debt to earnings; the last annual report shows', '净债务与盈利之比；最近的年报显示为') }}
       <strong>{{ '%.1f'|format(term.reported.value) }}</strong>
       <span class="l-en">{{ t('x', '倍') }}</span><span class="l-zh">{{ '倍' }}</span>
       {{ t('— about', '— 还剩约') }}
       <strong>{{ '%.1f'|format(term.room_turns) }}</strong>
       <span class="l-en">{{ t('x', '倍') }}</span><span class="l-zh">{{ '倍' }}</span>
       {{ t('of room.', '的空间。') }}</p>
    {% endif %}
    {% endif %}
    {% endfor %}
    <div class="cs-latest-grid">
      {% for term in covenant_headroom.terms %}
      {% if term.state == 'computed' %}
      <div>
        <span>{{ t('Limit', '限额') if term.limit_kind == 'maximum' else t('Floor', '下限') }}</span>
        <strong>{% if term.limit_raw is not none %}{% if term.limit_kind == 'maximum' %}{{ '%.1f'|format(term.limit_raw) }}{% else %}{{ '%.2f'|format(term.limit_raw) }}{% endif %}<span class="l-en">{{ t('x', '倍') }}</span><span class="l-zh">{{ '倍' }}</span>{% else %}—{% endif %}</strong>
      </div>
      <div>
        <span>{{ t('Reported figure', '披露数字') }}</span>
        <strong>{% if term.reported.value is not none %}{{ '%.1f'|format(term.reported.value) }}<span class="l-en">{{ t('x', '倍') }}</span><span class="l-zh">{{ '倍' }}</span>{% if term.reported.period_end %} {{ t('for the year ended', '截至') }} {{ term.reported.period_end }}{% endif %}{% else %}—{% endif %}</strong>
      </div>
      <div>
        <span>{{ t('Room remaining', '剩余空间') }}</span>
        <strong>{% if term.room_turns is not none %}{% if term.room_turns >= 0 %}+{% endif %}{{ '%.1f'|format(term.room_turns) }}<span class="l-en">{{ t('x', '倍') }}</span><span class="l-zh">{{ '倍' }}</span>{% else %}—{% endif %}</strong>
      </div>
      <div>
        <span>{{ t('Next step', '下一阶跃') }}</span>
        <strong>{% if term.next_step %}{{ t('the limit steps to', '限额将调整为') }} {{ '%.2f'|format(term.next_step.limit_raw) }}<span class="l-en">{{ t('x', '倍') }}</span><span class="l-zh">{{ '倍' }}</span> {{ t('from', '自') }} {{ term.next_step.start_date }}{% else %}{{ t('No next step recorded.', '尚无记录的下一阶跃。') }}{% endif %}</strong>
      </div>
      <div>
        <span>{{ t('Filing type', '披露类型') }}</span>
        <strong>{% if term.receipt.accession %}{{ term.receipt.form }}{% else %}—{% endif %}</strong>
      </div>
      <div>
        <span>{{ t('Accession', '文件编号') }}</span>
        <strong>{% if term.receipt.accession %}{{ term.receipt.accession }}{% else %}—{% endif %}</strong>
      </div>
      <div>
        <span>{{ t('Filing date', '披露日期') }}</span>
        <strong>{% if term.receipt.filing_date %}{{ term.receipt.filing_date }}{% else %}—{% endif %}</strong>
      </div>
      {% else %}
      <div>
        <span>{{ t(term.refusal_label_en, term.refusal_label_zh) }}</span>
        <strong>—</strong>
      </div>
      {% endif %}
      {% endfor %}
    </div>
    {% if covenant_headroom.terms and covenant_headroom.terms[0].receipt.source_url %}
    <p class="cs-section-note"><a href="{{ covenant_headroom.terms[0].receipt.source_url }}" rel="noopener noreferrer" target="_blank">{{ t('Open this filing on SEC EDGAR', '在 SEC EDGAR 打开该文件') }}</a></p>
    {% endif %}
    <p class="cs-section-note">{{ t(covenant_headroom.basis_en, covenant_headroom.basis_zh) }}</p>
    <p class="cs-section-note">{{ t(covenant_headroom.disclaimer_en, covenant_headroom.disclaimer_zh) }}</p>
    {% else %}
    {% if covenant_headroom.issuer.cik %}
    <p><strong>{{ covenant_headroom.issuer.name or covenant_headroom.issuer.ticker or covenant_headroom.issuer.cik }}</strong>{% if covenant_headroom.issuer.ticker %} · {{ covenant_headroom.issuer.ticker }}{% endif %}</p>
    {% endif %}
    {% for term in covenant_headroom.terms %}
    {% if term.filing_term_raw is defined and term.filing_term_raw %}
    <div class="cs-latest-grid">
      <div><span>{{ t('Term stated in the filing', '文件披露的条款') }}</span><strong>{% if term.term_name == 'minimum_fixed_charge_coverage_ratio' %}{{ t('Minimum fixed-charge coverage', '最低固定费用覆盖倍数') }}{% else %}{{ t('Covenant threshold', '契约阈值') }}{% endif %}</strong></div>
      <div><span>{{ t('Literal filing value', '披露原值') }}</span><strong>{{ term.filing_term_raw }}</strong></div>
      <div><span>{{ t('Filing date', '披露日期') }}</span><strong>{{ term.receipt.filing_date or '—' }}</strong></div>
      <div><span>{{ t('Filing type', '披露类型') }}</span><strong>{{ term.receipt.form or '—' }}</strong></div>
    </div>
    <p class="cs-section-note"><a href="{{ term.receipt.source_url }}" rel="noopener noreferrer" target="_blank">{{ t('Read the SEC credit agreement', '查看 SEC 信贷协议') }} · {{ term.receipt.accession }}</a></p>
    {% endif %}
    {% endfor %}
    <div class="cs-unavailable">
      <span class="cs-unavailable-mark" aria-hidden="true">↳</span>
      <div>
        <strong>{{ t(covenant_headroom.refusal_label_en or 'No room-left reading is ready to show right now.', covenant_headroom.refusal_label_zh or '目前没有可展示的契约下剩余空间。') }}</strong>
        <span>{{ t(covenant_headroom.null_en or '', covenant_headroom.null_zh or '') }}</span>
      </div>
    </div>
    <p class="cs-section-note">{{ t(covenant_headroom.disclaimer_en, covenant_headroom.disclaimer_zh) }}</p>
    {% endif %}
    <div class="cs-unavailable">
      <span class="cs-unavailable-mark" aria-hidden="true">↳</span>
      <div><strong>{{ t('Not covered here', '此处不涉及') }}</strong>
      <span>{{ t('Whether the company is actually in compliance, any waivers or amendments not yet on file, and the agreement\'s own defined terms are not part of this reading.', '公司是否实际合规、尚未披露的豁免或修订，以及协议自身的定义条款，均不在本次解读范围内。') }}</span></div>
    </div>
  </section>
  {% endif %}
  {# ── covenant-headroom:end ── #}

  {# B-F09 MO-PAID-066: retained public pricing facts, no current-market score. #}
  {% set bond_comparison = bond_comparison if bond_comparison is defined else none %}
  <section class="cs-latest-card cs-bond-terms" id="cs-bond-terms" aria-labelledby="cs-bond-title">
    <div class="cs-section-heading"><div>
      <p class="cs-kicker">{{ t('Filed bond pricing', '已披露债券定价') }}</p>
      <h2 id="cs-bond-title">{{ t('Apple and HP: the terms at issuance', '苹果与惠普：发行时的条款') }}</h2>
    </div></div>
    {% if bond_comparison and bond_comparison.status == 'qualified' %}
    <p>{{ t('Compare the same original tenor across two issuers. Apple priced on 5 May 2025; HP on 14 April 2025. The dates are 21 days apart: these are historical issue terms, not current quotes or a credit ranking.', '对比两家发行人相同的原始期限。苹果于 2025 年 5 月 5 日定价，惠普于 4 月 14 日定价，相隔 21 天。这是历史发行条款，不是当前报价或信用排名。') }}</p>
    {% for pair in bond_comparison.pairs %}
    <h3>{{ pair.tenor_years }}{{ t('-year original tenor', '年原始期限') }}</h3>
    <div class="cs-bond-pair">
    {% for issue in pair.issues %}
      <article class="cs-bond-issuer" aria-label="{{ issue.issuer }} {{ issue.maturity_date }}">
        <h4>{{ issue.issuer }}</h4>
        <p>{{ t('Priced', '定价日') }} {{ issue.trade_date }} · {{ t('Filed settlement', '披露交割日') }} {{ issue.settlement_date }}</p>
        <div class="cs-latest-grid">
          <div><span>{{ t('Coupon', '票面利率') }}</span><strong>{{ '%.3f'|format(issue.coupon_pct|float) }}%</strong></div>
          <div><span>{{ t('Treasury spread', '国债利差') }}</span><strong>+{{ issue.spread_bps }} {{ t('bp', '基点') }}</strong></div>
          <div><span>{{ t('Issue yield', '发行收益率') }}</span><strong>{{ '%.3f'|format(issue.yield_pct|float) }}%</strong></div>
          <div><span>{{ t('Maturity', '到期日') }}</span><strong>{{ issue.maturity_date }}</strong></div>
        </div>
        <details><summary>{{ t('Pricing basis and SEC source', '定价依据及 SEC 来源') }}</summary>
          <dl>
            <div><dt>{{ t('Benchmark Treasury', '基准美国国债') }}</dt><dd>{{ issue.benchmark }}</dd></div>
            <div><dt>{{ t('Benchmark yield', '基准收益率') }}</dt><dd>{{ '%.3f'|format(issue.benchmark_yield_pct|float) }}%</dd></div>
            <div><dt>{{ t('Price per 100 par', '每百元面值发行价') }}</dt><dd>{{ '%.3f'|format(issue.price_pct|float) }}</dd></div>
            <div><dt>{{ t('Filed principal', '披露本金') }}</dt><dd>{{ issue.currency_symbol }}{{ '{:,}'.format(issue.principal) }}</dd></div>
            <div><dt>CUSIP / ISIN</dt><dd>{{ issue.cusip }} / {{ issue.isin }}</dd></div>
            <div><dt>{{ t('SEC filing date', 'SEC 披露日期') }}</dt><dd>{{ issue.filed_date }}</dd></div>
            <div><dt>{{ t('SEC accepted', 'SEC 接收时间') }}</dt><dd>{{ issue.accepted_at }}</dd></div>
            <div><dt>{{ t('Source retained', '来源留存时间') }}</dt><dd>{{ issue.retrieved_at }}</dd></div>
          </dl>
          <p><a href="{{ issue.source_url }}" target="_blank" rel="noopener noreferrer">{{ t('Read the filed pricing sheet', '阅读已披露定价表') }} · {{ issue.accession }}</a></p>
        </details>
      </article>
    {% endfor %}
    </div>
    {% endfor %}
    <p class="cs-bond-scope">{{ t('Spread means issue yield minus the stated Treasury yield; it is not the make-whole redemption margin. Tenor uses the filed settlement and maturity dates, not confirmation of settlement. Coverage is two retained filings; the Apple 3- and 7-year notes have no HP peer here. Source retrieval in 2026 does not establish availability in our system in 2025.', '利差为发行收益率减去披露的国债收益率，不是提前赎回补偿利差。期限根据披露的交割及到期日期计算，不代表交割已获确认。覆盖仅限两份留存文件；苹果 3 年及 7 年债券在此没有惠普同期限对照。2026 年取得来源不代表本系统在 2025 年已掌握这些资料。') }}</p>
    {% else %}
    <p>{{ t('The retained pricing sheets are unavailable or do not agree with their source records. No comparison is shown.', '留存定价表不可用或与来源记录不一致，因此不展示对比。') }}</p>
    {% endif %}
  </section>


  {# ── policy-watch:start — B-F09-6 (MO-PAID-067). Keep contiguous.
     policy_watch is an OPTIONAL kwarg: guarded so any caller that renders this
     template under StrictUndefined without it (tests/test_capital_structure_page.py)
     still renders. The `present` state is a normal, live, dated public-record
     step — not an outage — so it never borrows the `.cs-unavailable` component;
     only `unavailable`/`empty` (both genuinely "nothing to show yet") do. ── #}
  {% if policy_watch is defined and policy_watch %}
  {% if policy_watch.state == 'present' %}
  <section class="cs-policy cs-policy-active" id="cs-policy" aria-label="Policy watch">
    <span class="cs-policy-mark" aria-hidden="true">◷</span>
    <div>
      <p class="cs-kicker">{{ t('Policy watch', '政策关注') }}</p>
      <strong>{{ t(policy_watch.headline_en, policy_watch.headline_zh) }}</strong>
      <span>{{ t(policy_watch.detail_en, policy_watch.detail_zh) }}</span>
    </div>
  </section>
  {% else %}
  <section class="cs-unavailable cs-policy" id="cs-policy" aria-label="Policy watch">
    <span class="cs-unavailable-mark" aria-hidden="true">◷</span>
    <div>
      <p class="cs-kicker">{{ t('Policy watch', '政策关注') }}</p>
      <strong>{{ t(policy_watch.headline_en, policy_watch.headline_zh) }}</strong>
      <span>{{ t(policy_watch.detail_en, policy_watch.detail_zh) }}</span>
    </div>
  </section>
  {% endif %}
  {% endif %}
  {# ── policy-watch:end ── #}

  {# ── policy-projection:start — B-F09-6b (MO-PAID-067). Keep contiguous.
     policy_projection is an OPTIONAL kwarg: guarded so any caller that renders
     this template under StrictUndefined without it
     (tests/test_capital_structure_page.py) still renders. Six windows always
     appear; empty is not unavailable. No window id, event token, or schema
     string reaches the screen. ── #}
  {% if policy_projection is defined and policy_projection %}
  <section class="cs-policy cs-policy-active" id="cs-policy-projection" aria-labelledby="cs-pp-kicker">
    <div>
      <p class="cs-kicker" id="cs-pp-kicker">{{ t('Dated steps', '既定日期节点') }}</p>
      <strong>{{ t('Dated steps on the public record', '公开记录上的既定日期节点') }}</strong>
      <span>{{ t(policy_projection.note_en, policy_projection.note_zh) }}</span>
      {% if policy_projection.truncated %}<span>{{ t(policy_projection.truncation_en, policy_projection.truncation_zh) }}</span>{% endif %}
      <div class="cs-policy-windows">{% for window in policy_projection.windows %}
        <div class="cs-policy-window">
          <p class="cs-kicker">{{ t(window.label_en, window.label_zh) }}</p>
          {% if window.state != 'present' %}<span>{{ t(window.reason_en, window.reason_zh) }}</span>
          {% else %}<ul class="cs-prl">{% for row in window.rows %}
            <li class="cs-pr"><strong>{{ t(row.event_en, row.event_zh) }}</strong> <time datetime="{{ row.date }}">{% if row.days_out == 0 %}{{ t('today', '今天') }}{% elif row.days_out == 1 %}{{ t('in 1 day', '1 天后') }}{% else %}{{ t('in ' ~ row.days_out ~ ' days', row.days_out ~ ' 天后') }}{% endif %}</time> <a href="{{ row.source_url }}" rel="noopener">{{ t(row.source_label_en, row.source_label_zh) }}</a></li>
          {% endfor %}</ul>{% if window.more_en %}<span>{{ t(window.more_en, window.more_zh) }}</span>{% endif %}{% endif %}
        </div>{% endfor %}
      </div>
    </div>
  </section>
  {% endif %}
  {# ── policy-projection:end ── #}

  <div class="cs-workspace">
    <aside class="cs-rail" aria-labelledby="cs-rail-title">
      <div class="cs-rail-head">
        <div>
          <p class="cs-kicker">{{ t('Issuer browser', '发行人浏览器') }}</p>
          <h2 id="cs-rail-title">{{ t('Observed issuers', '已观察发行人') }}</h2>
        </div>
        <span class="cs-rail-count" id="cs-rail-count">—</span>
      </div>
      <label class="cs-search" for="cs-search-input">
        <span class="cs-search-label">{{ t('Find a ticker or company', '查找代码或公司') }}</span>
        <input id="cs-search-input" type="search" autocomplete="off"
          data-placeholder-en="Ticker or company"
          data-placeholder-zh="股票代码或公司"
          placeholder="Ticker or company">
        <span class="cs-search-hint">{{ t('Press Enter to resolve an exact ticker', '按 Enter 精确查找代码') }}</span>
      </label>
      <div class="cs-filter-row" role="group" aria-label="Issuer filters">
        <button type="button" class="cs-filter is-active" data-filter="all" aria-pressed="true">{{ t('All', '全部') }}</button>
        <button type="button" class="cs-filter" data-filter="review" aria-pressed="false">{{ t('Needs review', '待复核') }}</button>
        <button type="button" class="cs-filter" data-filter="recent" aria-pressed="false">{{ t('Observed in 30 days', '截至日前 30 天') }}</button>
      </div>
      <div class="cs-issuer-list" id="cs-issuer-list" role="list" aria-label="Observed issuers"></div>
      <div class="cs-rail-foot" id="cs-rail-foot">{{ t('Issuers are listed by observed SEC filing state.', '发行人按已观察到的 SEC 披露状态列出。') }}</div>
    </aside>

    <section class="cs-dossier" id="cs-dossier" aria-labelledby="cs-dossier-title" tabindex="-1">
      <div class="cs-empty-dossier" id="cs-empty-dossier">
        <span class="cs-empty-glyph" aria-hidden="true">⌁</span>
        <h2 id="cs-dossier-title">{{ t('Choose an issuer', '选择一个发行人') }}</h2>
        <p>{{ t('Open an observed filing record to inspect the timeline, latest state, and SEC source receipts.', '打开已观察的披露记录，查看时间线、最新状态及 SEC 来源凭据。') }}</p>
      </div>

      <div class="cs-dossier-body" id="cs-dossier-body" hidden>
        <header class="cs-issuer-head">
          <div class="cs-issuer-identity">
            <span class="cs-issuer-symbol" id="cs-issuer-symbol">—</span>
            <div>
              <p class="cs-kicker" id="cs-issuer-cik">—</p>
              <h2 id="cs-dossier-title-live">—</h2>
              <p class="cs-issuer-alias" id="cs-issuer-alias">—</p>
            </div>
          </div>
          <button class="cs-evidence-button" id="cs-open-evidence" type="button" disabled>
            <span aria-hidden="true">↗</span> {{ t('Open evidence', '打开证据') }}
          </button>
        </header>

        <section class="cs-latest-card" aria-labelledby="cs-latest-title">
          <div class="cs-section-heading">
            <div>
              <p class="cs-kicker">{{ t('Latest observed record', '最新观察记录') }}</p>
              <h3 id="cs-latest-title">{{ t('Current filing state', '当前披露状态') }}</h3>
            </div>
            <span class="cs-state-chip" id="cs-lifecycle-state">—</span>
          </div>
          <div class="cs-latest-grid">
            <div><span>{{ t('Form', '表格') }}</span><strong id="cs-latest-form">—</strong></div>
            <div><span>{{ t('SEC accepted', 'SEC 接收') }}</span><strong id="cs-sec-accepted">—</strong></div>
            <div><span>{{ t('Observed', '观察时间') }}</span><strong id="cs-observed-at">—</strong></div>
            <div><span>{{ t('Classification', '分类') }}</span><strong id="cs-classification">—</strong></div>
          </div>
        </section>

        <section class="cs-changes" aria-labelledby="cs-changes-title">
          <div class="cs-section-heading">
            <div>
              <p class="cs-kicker">{{ t('Change log', '变化记录') }}</p>
              <h3 id="cs-changes-title">{{ t('What changed', '发生了什么变化') }}</h3>
            </div>
            <span class="cs-section-note">{{ t('Observed events only', '仅限已观察事件') }}</span>
          </div>
          <div id="cs-change-list" class="cs-change-list"></div>
        </section>

        <section class="cs-timeline" aria-labelledby="cs-timeline-title">
          <div class="cs-section-heading">
            <div>
              <p class="cs-kicker">{{ t('Filing timeline', '披露时间线') }}</p>
              <h3 id="cs-timeline-title">{{ t('Lifecycle record', '生命周期记录') }}</h3>
            </div>
            <button class="cs-more-events" id="cs-more-events" type="button" hidden>{{ t('More events', '更多事件') }}</button>
          </div>
          <ol class="cs-event-list" id="cs-event-list"></ol>
        </section>

        <section class="cs-scope-card" aria-labelledby="cs-scope-title">
          <div>
            <p class="cs-kicker">{{ t('Record scope', '记录范围') }}</p>
            <h3 id="cs-scope-title">{{ t('Coverage for this issuer', '该发行人的覆盖范围') }}</h3>
          </div>
          <dl class="cs-scope-list" id="cs-scope-list"></dl>
        </section>
      </div>
    </section>
  </div>
</main>

<aside class="cs-evidence-drawer" id="cs-evidence-drawer" aria-labelledby="cs-evidence-title" aria-hidden="true" tabindex="-1" hidden inert>
  <header class="cs-evidence-head">
    <div>
      <p class="cs-kicker">{{ t('Source receipt', '来源凭据') }}</p>
      <h2 id="cs-evidence-title">{{ t('Evidence', '证据') }}</h2>
    </div>
    <button class="cs-drawer-close" id="cs-close-evidence" type="button" aria-label="Close evidence drawer" data-label-en="Close evidence drawer" data-label-zh="关闭证据抽屉">×</button>
  </header>
  <div class="cs-evidence-body" id="cs-evidence-body"></div>
</aside>
<div class="cs-scrim" id="cs-scrim" hidden></div>

<template id="cs-loading-template"><div class="cs-loading" role="status"><span class="cs-loading-dot" aria-hidden="true"></span><span class="cs-loading-copy">{{ t('Loading observed filing state…', '正在加载已观察披露状态…') }}</span></div></template>

<script src="theme.js" defer></script>
<script src="capital_structure.js" defer></script>
</body>
</html>
