{% extends "report_base.html.j2" %}

{# XG-W7: no X follow line on the China desks — x.com is unreachable behind
   the GFW, so the CTA would be a dead link for this page's core audience. #}
{% block foot_social %}{% endblock %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}
{% macro bl(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}

{% block title %}China Intelligence — Macro Dashboard{% endblock %}

{%- block head_extra %}
{% set seo_title = "China Intelligence — Mastermind" %}
{% set seo_desc = "The China desk brief — policy, flows, sectors and narratives in one nightly intelligence read." %}
{% set seo_path = "china_intel.html" %}
{%- include "_seo_head.html.j2" %}
{%- endblock %}

{% block base_css %}
  /* ── layout ── */
  .ci-wrap { max-width:1060px; margin:0 auto; padding:0 0 60px; }
  /* ── hero ── */
  .ci-hero { max-width:1060px; margin:18px auto 0; }
  .ci-hero .eyebrow { font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:var(--ink-link, var(--link)); font-weight:600; margin:0 0 8px; }
  .ci-hero h1 { font-size:30px; margin:0 0 8px; letter-spacing:-.01em; }
  html[data-lang="zh"] .ci-hero h1 { letter-spacing:0; }
  .ci-hero .lens { font-size:12px; color:var(--muted); }
  .ci-hero .dtp { font-size:11px; color:var(--muted); margin:6px 0 0; }
  .ci-stance { font-size:12px; font-weight:700; color:var(--ink-link, var(--link)); margin:0 0 8px; }
  .brief-grid { display:flex; flex-direction:column; gap:12px; margin:12px 0 6px; }
  .ci-card-title { font-size:13px; font-weight:700; margin:0 0 6px; color:var(--text); }
  .ci-card-head { display:flex; align-items:baseline; gap:8px; flex-wrap:wrap; margin:0 0 6px; }
  .ci-card-head .ci-card-title { margin:0; }
  .ci-card-asof { font-size:11px; color:var(--muted); font-variant-numeric:tabular-nums; }
  /* ── command bar ── */
  .cmdbar { display:flex; flex-wrap:wrap; gap:8px; margin:14px 0 4px; }
  .cmdbar .mc { font-size:12px; font-weight:600; padding:6px 12px; border-radius:10px;
    display:inline-flex; gap:7px; align-items:center;
    background:color-mix(in srgb,var(--panel) 72%,transparent);
    border:1px solid color-mix(in srgb,var(--line) 75%,transparent); }
  .cmdbar .mc:not(.regime) b { color:var(--text); font-weight:700; }
  .cmdbar .mc span { color:var(--muted); }
  .cmdbar .mc.hot { border-color:color-mix(in srgb,var(--link) 50%,var(--line)); color:var(--ink-link, var(--link)); }
  .cmdbar .mc.warn { border-color:color-mix(in srgb,#e0973a 50%,var(--line)); color:var(--ink-warn, var(--warn)); }
  .mode-badge { font-size:10px; font-weight:700; padding:3px 9px; border-radius:999px;
    background:color-mix(in srgb,var(--muted) 15%,transparent);
    border:1px solid color-mix(in srgb,var(--muted) 30%,transparent); color:var(--muted); }
  .stale-chip { font-size:10px; font-weight:700; padding:3px 9px; border-radius:999px;
    background:color-mix(in srgb,#e0973a 15%,transparent);
    border:1px solid color-mix(in srgb,#e0973a 35%,transparent); color:var(--ink-warn, var(--warn)); }
  /* ── qledger honesty chips ── */
  .ql-chip { display:inline-flex; align-items:center; font:700 9px/1 ui-monospace,Menlo,monospace;
    letter-spacing:.05em; text-transform:uppercase; padding:2px 7px; border-radius:6px;
    border:1px solid; white-space:nowrap; vertical-align:middle; }
  .ql-chip-ungraded { background:color-mix(in srgb,var(--muted) 12%,transparent); color:var(--muted); border-color:color-mix(in srgb,var(--muted) 28%,transparent); }
  .ql-chip-accruing { background:color-mix(in srgb,#e0973a 14%,transparent); color:var(--ink-warn, var(--warn)); border-color:color-mix(in srgb,#e0973a 35%,transparent); }
  .ql-chip-graded-pos { background:color-mix(in srgb,var(--up) 14%,transparent); color:var(--ink-up, var(--up)); border-color:color-mix(in srgb,var(--up) 35%,transparent); }
  .ql-chip-graded-neg { background:color-mix(in srgb,var(--down) 14%,transparent); color:var(--ink-down, var(--down)); border-color:color-mix(in srgb,var(--down) 35%,transparent); }
  /* ── section headers ── */
  h2.sec { font-size:18px; margin:26px 0 8px; border-top:1px solid var(--line); padding-top:16px; display:flex; align-items:baseline; gap:9px; }
  /* ── what matters / changed ── */
  .matters { background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:14px 16px; margin:16px 0; }
  .matters ol { margin:6px 0 0; padding-left:20px; }
  .matters li { font-size:13.5px; line-height:1.6; margin:4px 0; }
  .matters .kind { font-size:9.5px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; padding:1px 6px; border-radius:5px; background:var(--panel2); color:var(--muted); margin-right:6px; }
  .changed { display:flex; flex-wrap:wrap; gap:7px; margin-top:10px; }
  .changed .ch { font-size:11.5px; padding:3px 9px; border-radius:999px; background:color-mix(in srgb,#e0973a 12%,var(--panel2)); border:1px solid #e0973a44; color:var(--text); }
  /* ── policy phrase card ── */
  .pp-card { background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:14px 16px; margin:12px 0; }
  .pp-event-list { list-style:none; margin:8px 0 0; padding:0; }
  .pp-event-list li { display:flex; align-items:flex-start; gap:9px; padding:8px 0; border-bottom:1px solid var(--line); font-size:12.5px; }
  .pp-event-list li:last-child { border-bottom:none; }
  .pp-kind { font-size:9px; font-weight:800; letter-spacing:.04em; text-transform:uppercase; padding:2px 7px; border-radius:6px; white-space:nowrap; }
  .pp-phrase { font-weight:700; font-size:13px; }
  .pp-gloss { font-size:11px; color:var(--muted); margin-top:2px; }
  .pp-meta { font-size:10px; color:var(--muted); margin-left:auto; white-space:nowrap; }
  .pp-cold { font-size:11px; color:var(--muted); padding:6px 0; font-style:italic; }
  .pp-more > summary { cursor:pointer; font-size:11px; color:var(--ink-link, var(--link)); margin-top:6px; list-style:none; }
  .pp-more > summary::-webkit-details-marker { display:none; }
  /* ── narrative divergence chip ── */
  .nd-chip { display:flex; align-items:center; gap:10px; background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:11px 14px; margin:12px 0; font-size:13px; flex-wrap:wrap; }
  .nd-z { font-size:20px; font-weight:800; font-variant-numeric:tabular-nums; }
  .nd-z.risk { color:var(--ink-warn, var(--warn)); }
  .nd-z.ok { color:var(--muted); }
  .nd-label { font-size:11.5px; color:var(--muted); line-height:1.5; flex:1; }
  .nd-badge { font-size:9px; font-weight:800; letter-spacing:.04em; text-transform:uppercase; padding:2px 8px; border-radius:6px;
    background:color-mix(in srgb,#e0973a 15%,transparent); border:1px solid color-mix(in srgb,#e0973a 35%,transparent); color:var(--ink-warn, var(--warn)); white-space:nowrap; }
  /* ── synthesis table ── */
  table.syn { border-collapse:collapse; width:100%; font-size:12.5px; margin:8px 0; }
  table.syn th { text-align:left; padding:7px 9px; background:var(--panel2); color:var(--muted); font-weight:600; border-bottom:2px solid var(--line); }
  table.syn td { padding:8px 9px; border-bottom:1px solid var(--line); vertical-align:top; }
  .cc { font-weight:800; font-variant-numeric:tabular-nums; }
  .strength { height:5px; border-radius:3px; background:var(--panel2); overflow:hidden; display:inline-block; vertical-align:middle; margin-right:4px; }
  .strength > i { display:block; height:100%; background:var(--link); }
  /* ── regime overlay ── */
  .regime { display:flex; flex-wrap:wrap; gap:14px; align-items:center; background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:11px 15px; margin:14px 0; font-size:13px; }
  .regime .rk { font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:.04em; }
  .regime .on { color:#1f9a55; font-weight:700; } .regime .off { color:#d23f3f; font-weight:700; } .regime .neu { color:var(--muted); font-weight:700; }
  html[data-lang="zh"] .regime .on { color:#d23f3f; } html[data-lang="zh"] .regime .off { color:#1f9a55; }
  .bandpill { font-size:10px; font-weight:700; padding:2px 8px; border-radius:999px; }
  .b-high{color:#1f9a55;background:color-mix(in srgb,#1f9a55 13%,transparent)}
  .b-elevated{color:#5b8def;background:color-mix(in srgb,#5b8def 13%,transparent)}
  .b-moderate,.b-low,.b-none{color:var(--muted);background:var(--panel2)}
  /* ── surfaces/flags ── */
  .surf { font-size:9.5px; font-weight:700; padding:1px 6px; border-radius:5px; background:var(--panel2); color:var(--ink-link, var(--link)); margin-right:3px; }
  .sgn-pos{color:var(--ink-up, var(--up))} .sgn-neg{color:var(--ink-down, var(--down))}
  /* --up/--down already swap under 红涨绿跌, so the manual flip is gone: one source
   of truth, and no way for the two to drift apart. */
  .flags { display:flex; flex-wrap:wrap; gap:8px; margin:10px 0; }
  .tk { display:inline-flex; flex-direction:column; gap:2px; padding:7px 12px; border-radius:10px; background:var(--panel); border:1px solid var(--line); }
  .tk .nm { font-weight:700; font-size:13px; }
  .tk .cd { font-size:10px; color:var(--muted); font-family:ui-monospace,Menlo,monospace; }
  .tk.long { border-left:3px solid #1f9a55; } .tk.short { border-left:3px solid #d23f3f; }
  html[data-lang="zh"] .tk.long { border-left-color:#d23f3f; } html[data-lang="zh"] .tk.short { border-left-color:#1f9a55; }
  /* ── chains ── */
  .chain { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:12px 15px; margin:10px 0; }
  .chain .hd { display:flex; align-items:center; gap:9px; font-weight:700; font-size:13.5px; }
  .chband { font-size:10px; font-weight:700; padding:2px 8px; border-radius:999px; }
  .ch-aligned{color:#1f9a55;background:color-mix(in srgb,#1f9a55 13%,transparent)}
  .ch-forming{color:var(--ink-warn, var(--warn));background:color-mix(in srgb,#e0973a 13%,transparent)}
  .ch-dormant{color:var(--muted);background:var(--panel2)}
  .legs { display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }
  .leg { font-size:11px; padding:3px 8px; border-radius:7px; background:var(--panel2); border:1px solid var(--line); }
  .leg.on { color:#1f9a55; border-color:#1f9a5544; } .leg.off { color:var(--muted); opacity:.6; }
  /* ── misc ── */
  .digest { white-space:pre-wrap; font:12px/1.55 ui-monospace,Menlo,monospace; background:var(--panel2); border:1px solid var(--line); border-left:4px solid var(--link); border-radius:12px; padding:13px 15px; margin:12px 0; }
  .xmit { border-radius:12px; padding:13px 16px; margin:16px 0; border:1px solid var(--line); background:var(--panel2); font-size:13px; line-height:1.6; }
  .xmit code { font-family:ui-monospace,Menlo,monospace; font-size:11.5px; color:var(--ink-link, var(--link)); }
  .strip { display:flex; flex-wrap:wrap; gap:8px; margin:8px 0; }
  .sx { font-size:11.5px; padding:4px 10px; border-radius:8px; background:var(--panel2); border:1px solid var(--line); }
  .sx b { color:var(--ink-warn, var(--warn)); }
  .band { display:inline-block; font-size:13px; font-weight:700; padding:2px 9px; border-radius:999px; }
  .band.supportive,.band.easing { color:#1f9a55; background:color-mix(in srgb,#1f9a55 13%,transparent); }
  .band.cautious,.band.tightening { color:#d23f3f; background:color-mix(in srgb,#d23f3f 13%,transparent); }
  html[data-lang="zh"] .band.supportive, html[data-lang="zh"] .band.easing { color:#d23f3f; background:color-mix(in srgb,#d23f3f 13%,transparent); }
  html[data-lang="zh"] .band.cautious, html[data-lang="zh"] .band.tightening { color:#1f9a55; background:color-mix(in srgb,#1f9a55 13%,transparent); }
  .band.steady,.band.building,.band.neutral,.band.unknown { color:var(--muted); background:var(--panel2); }
  .disc { font-size:11.5px; color:var(--muted); margin-top:14px; line-height:1.55; }
  /* ── command list ── */
  /* uses .tbl-scroll from theme.js (avoids double-wrap) */
  table.cmd-tbl { border-collapse:collapse; width:100%; min-width:680px; font-size:12.5px; }
  table.cmd-tbl th { text-align:left; padding:6px 9px; background:var(--panel2); color:var(--muted); font-weight:600; border-bottom:2px solid var(--line); white-space:nowrap; }
  table.cmd-tbl td { padding:7px 9px; border-bottom:1px solid var(--line); vertical-align:middle; }
  table.cmd-tbl tr:last-child td { border-bottom:none; }
  .cmd-ticker { font-family:ui-monospace,Menlo,monospace; font-size:11px; color:var(--ink-link, var(--link)); font-weight:700; white-space:nowrap; }
  .cmd-name { font-size:12px; font-weight:600; max-width:120px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .cmd-desk-dots { display:flex; gap:3px; align-items:center; }
  .cmd-dot { width:9px; height:9px; border-radius:50%; flex-shrink:0; }
  .cmd-dot.up { background:var(--up); }
  .cmd-dot.down { background:var(--down); }
  .cmd-dot.neutral { background:var(--muted); opacity:.35; }
  .cmd-dot.absent { background:transparent; border:1px solid var(--line); }
  .stage-chip { font-size:9.5px; font-weight:700; padding:2px 7px; border-radius:6px; text-transform:uppercase; letter-spacing:.04em; white-space:nowrap; }
  .stage-emerging { color:#1f9a55; background:color-mix(in srgb,#1f9a55 14%,transparent); border:1px solid #1f9a5540; }
  .stage-early { color:#5b8def; background:color-mix(in srgb,#5b8def 14%,transparent); border:1px solid #5b8def40; }
  .stage-consensus { color:var(--muted); background:var(--panel2); border:1px solid var(--line); }
  .stage-exhausted { color:#d23f3f; background:color-mix(in srgb,#d23f3f 12%,transparent); border:1px solid #d23f3f40; }
  .stage-faltering { color:var(--ink-warn, var(--warn)); background:color-mix(in srgb,#e0973a 12%,transparent); border:1px solid #e0973a40; }
  .stage-distribution { color:var(--ink-warn, var(--warn)); background:color-mix(in srgb,#e0973a 12%,transparent); border:1px solid #e0973a40; }
  .stage-quiet { color:var(--muted); background:var(--panel2); border:1px solid var(--line); opacity:.6; }
  .stage-discovery { color:#8b5cf6; background:color-mix(in srgb,#8b5cf6 13%,transparent); border:1px solid #8b5cf640; }
  .edge-bar { display:inline-block; width:48px; height:5px; background:var(--panel2); border-radius:3px; overflow:hidden; vertical-align:middle; margin-right:4px; }
  .edge-bar > i { display:block; height:100%; background:var(--link); border-radius:3px; }
  .opp-score { font-weight:800; font-variant-numeric:tabular-nums; font-size:13px; }
  .rs-chip { font-size:10px; font-weight:700; padding:1px 6px; border-radius:5px; white-space:nowrap; }
  .rs-pos { color:var(--ink-up, var(--up)); background:color-mix(in srgb,var(--up) 12%,transparent); }
  .rs-neg { color:var(--ink-down, var(--down)); background:color-mix(in srgb,var(--down) 12%,transparent); }
  .rs-neu { color:var(--muted); background:var(--panel2); }
  .cmd-read { font-size:11px; color:var(--muted); max-width:240px; line-height:1.4; }
  .cmd-fals { font-size:10px; color:var(--ink-warn, var(--warn)); margin-top:2px; }
  .cmd-expander { font-size:11.5px; color:var(--ink-link, var(--link)); cursor:pointer; margin-top:8px; display:inline-block; }
  /* ── discovery queue ── */
  .disc-queue { display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr)); gap:10px; margin:12px 0; }
  .disc-card { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:12px 14px; }
  .disc-card.off-desk { border-left:3px solid #8b5cf6; }
  .disc-card .disc-ticker { font-family:ui-monospace,Menlo,monospace; font-size:11px; color:var(--ink-link, var(--link)); font-weight:700; }
  .disc-card .disc-name { font-size:12.5px; font-weight:700; margin:3px 0; }
  .disc-card .disc-reason { font-size:11px; color:var(--muted); margin-top:3px; line-height:1.4; }
  .disc-card .disc-meta { display:flex; gap:5px; flex-wrap:wrap; margin-top:6px; align-items:center; }
  .lane-chip { font-size:9px; font-weight:700; padding:1px 6px; border-radius:5px; text-transform:uppercase; letter-spacing:.04em; background:var(--panel2); color:var(--muted); border:1px solid var(--line); }
  .exp-chip { font-size:9px; font-weight:700; padding:1px 6px; border-radius:5px; color:var(--ink-warn, var(--warn)); background:color-mix(in srgb,#e0973a 13%,transparent); border:1px solid #e0973a44; }
  .offdesk-chip { font-size:9px; font-weight:700; padding:1px 6px; border-radius:5px; color:#8b5cf6; background:color-mix(in srgb,#8b5cf6 13%,transparent); border:1px solid #8b5cf640; }
  /* ── cycle-context regime chips (W5) ── muted/neutral only, no up/down coloring ── */
  .regime-chips { display:flex; flex-wrap:wrap; gap:4px; margin-top:4px; }
  .rg-chip { font-size:9px; font-weight:600; padding:1px 6px; border-radius:5px; background:color-mix(in srgb,var(--muted) 10%,transparent); color:var(--muted); border:1px solid color-mix(in srgb,var(--muted) 22%,transparent); letter-spacing:.03em; }
  /* ── analogs card ── */
  .analogs-card { background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:15px 17px; margin:14px 0; }
  .analogs-query { display:flex; flex-wrap:wrap; gap:7px; margin:8px 0 12px; }
  .aq-chip { font-size:11px; padding:3px 9px; border-radius:999px; background:var(--panel2); border:1px solid var(--line); color:var(--text); }
  .fan-table { border-collapse:collapse; font-size:12px; margin:8px 0; }
  .fan-table th { padding:4px 8px; color:var(--muted); font-weight:600; border-bottom:1px solid var(--line); }
  .fan-table td { padding:5px 8px; border-bottom:1px solid var(--line); font-variant-numeric:tabular-nums; }
  .fan-table tr:last-child td { border-bottom:none; }
  /* ── suite directory ── */
  .suite { margin:14px 0 20px; }
  .suite-group { margin-bottom:18px; }
  .suite-group-title { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); margin:0 0 8px; display:flex; align-items:center; gap:8px; }
  .suite-group-title::after { content:""; flex:1; height:1px; background:var(--line); }
  .suite-links { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:8px; }
  a.slink { display:flex; align-items:flex-start; gap:9px; background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:10px 12px; color:var(--text); text-decoration:none; transition:border-color .15s; }
  a.slink:hover { border-color:var(--link); }
  a.slink .sl-name { font-size:12.5px; font-weight:700; }
  a.slink .sl-desc { font-size:11px; color:var(--muted); margin-top:2px; line-height:1.4; }

  /*
    DARK TREATMENT: command center — graphite panels, instrument-calm chips,
    restrained amber on the staleness/outage chip, luminance depth on dated
    brief cards and the method band. Regime hex is a signed instrument
    (green risk-on / red risk-off in EN; ZH flips).
    LIGHT TREATMENT: research workspace — cool canvas, white card material,
    hairline borders, shadow instead of glow; same IA, chip states, dates,
    source chips, and regime hex. Warn bloom is suppressed; ink + hairline
    carry the stale/outage state.
    Differ on purpose: glow vs shadow; warn bloom vs ink hairline.
    Shared: five-state B1 chip, dated-card identity (as-of + source chip),
    method-band directory, regime colour (ZH-flipped).
  */
  /* post-stack: consolidate */
  html[data-theme="light"] .pp-card,
  html[data-theme="light"] .nd-chip,
  html[data-theme="light"] .analogs-card,
  html[data-theme="light"] .matters {
    background:var(--panel);
    border:1px solid var(--line);
    box-shadow:0 1px 0 color-mix(in srgb, var(--text) 6%, transparent);
  }
  html[data-theme="light"] .cmdbar .mc.warn,
  html[data-theme="light"] .stale-chip {
    background:color-mix(in srgb, var(--ink-warn, var(--warn)) 8%, var(--panel));
    border-color:color-mix(in srgb, var(--ink-warn, var(--warn)) 28%, var(--line));
    box-shadow:none;
  }
  html[data-theme="light"] a.slink {
    background:var(--panel);
    box-shadow:0 1px 0 color-mix(in srgb, var(--text) 5%, transparent);
  }
  html[data-theme="light"] a.slink:hover {
    box-shadow:0 2px 8px color-mix(in srgb, var(--text) 10%, transparent);
  }
{% endblock %}

{% block content %}
{% set KIND_ZH = {'chain':'链条','news':'新闻','radar':'雷达','scheduled':'日程','policy':'政策','altdata':'另类数据'} %}
{% set STANCE_ZH = {'easing':'宽松','neutral':'中性','tightening':'收紧'} %}
{% set BAND_ZH = {'supportive':'偏积极','cautious':'偏谨慎','steady':'平稳','building':'积累中','unknown':'未知'} %}
{% set _STG = {'emerging':['Emerging','萌芽'],'early':['Early','早期'],'consensus':['Consensus','共识'],'exhausted':['Exhausted','见顶'],'distribution':['Distribution','派发'],'building':['Building','酝酿'],'faltering':['Faltering','走弱'],'quiet':['Quiet','平静'],'discovery':['Discovery','发现']} %}
{% set _LANE_EN = {'lhb_first_seat':'Dragon-tiger first seat','margin_velocity':'Margin velocity','southbound_delta':'Southbound holdings','ths_emerging_concepts':'THS concepts'} %}
{% set _LANE_ZH = {'lhb_first_seat':'龙虎榜首现','margin_velocity':'融资速度','southbound_delta':'南向持仓变化','ths_emerging_concepts':'同花顺概念'} %}
{% set SURF = {
  'news': ['News','新闻'],
  'policy': ['Policy','政策'],
  'altdata': ['Alt-Data','另类数据'],
  'radar': ['Divergence Radar','背离雷达'],
  'analysis': ['Desk synthesis','综合解读'],
  'policy_phrase': ['Policy language','政策表述'],
  'narrative_divergence': ['Onshore / offshore tape','境内外叙事'],
  'special_situations': ['Special situations','特殊情景'],
  'command': ['Command list','指挥清单'],
  'conditions': ['Risk appetite','风险偏好'],
  'board': ['Buy board','买入板'],
  'special': ['Special situations','特殊情景']
} %}
{% set EVKIND = {
  'APPEARED': ['New phrasing','新增表述'],
  'DROPPED': ['Dropped phrasing','消失表述'],
  'LEAD_SHIFT': ['Lead topic shift','头版转向']
} %}
{% set _STANCE_WATCH = t("Watch — don't chase", "观望——勿追涨") %}

<section class="ci-hero">
  <p class="eyebrow">{{ t('China Intelligence', '中国情报中心') }}</p>
  <h1>{{ t('China Intelligence Hub', '中国情报中心') }}</h1>
  <p class="lens">{{ t('Central synthesis of five China surfaces — what matters most, cross-surface conviction, flagged tickers', '五个中国面板的中央综合——最重要的事、跨面板共振、标记个股') }}</p>
  <p class="dtp">{{ t('context only','仅供参考') }} · {{ t('as of','截至') }} {{ b.asof }}</p>
</section>

<div class="ci-wrap">
  {%- set _pp_asof = b.policy_phrase.asof if b.policy_phrase else none %}
  {%- set _nd_asof = b.narrative_divergence.asof if b.narrative_divergence else none %}
  {%- set _an_asof = b.analysis.asof if b.analysis else none %}

  {# ── A. DESK HEADER (cmdbar; regime merged in — C2 / D8 hex rules kept via .regime) ── #}
  <div class="cmdbar">
    {%- if b.regime %}
      {%- set _rt = b.regime.get('risk_tilt') %}
      {%- if _rt is none %}{% set _rt = 0 %}{% endif %}
      <span class="regime mc {{ 'hot' if _rt > 0 else 'warn' if _rt < 0 else '' }}">
        <span class="rk">{{ t('Risk appetite','风险偏好') }}</span>
        <b class="{{ 'on' if _rt > 0 else ('off' if _rt < 0 else 'neu') }}">{{ t('Risk-on','偏好风险') if _rt > 0 else (t('Risk-off','避险') if _rt < 0 else t('Neutral','中性')) }}</b>
        {%- if b.regime.get('roro') is not none %}
        <span data-tip-en="Risk-on / risk-off tilt (signed reading)." data-tip-zh="风险偏好倾斜（有符号读数）。">{{ '%+.2f'|format(b.regime.roro) }}</span>
        {%- endif %}
      </span>
    {%- endif %}
    {%- set _reg = b.regime %}
    {%- if _reg and _reg.band_en %}
      <span class="mc"><span>{{ t('Fear/Euphoria','恐惧/亢奋') }}</span> <b>{{ bl(_reg.band_en, _reg.band_zh or _reg.band_en) }}</b></span>
    {%- endif %}
    {%- if b.policy and b.policy.pboc_stance %}
      <span class="mc"><span>{{ t('PBoC','央行') }}</span> <b>{{ bl(b.policy.stance_label_en or (b.policy.pboc_stance|capitalize), b.policy.stance_label_zh or b.policy.pboc_stance) }}</b></span>
    {%- endif %}
    {%- if b.news and b.news.band %}
      <span class="mc"><span>{{ t('Media','媒体') }}</span> <b>{{ bl(b.news.band_label_en or (b.news.band|capitalize), b.news.band_label_zh or b.news.band) }}</b></span>
    {%- endif %}
    {%- set _st = b.staleness_state %}
    {%- if _st and _st != 'fresh' %}
      {%- set _sk = b.max_staleness_feed %}
      {%- set _sl = SURF.get(_sk) or [_sk, _sk] %}
      {%- set _work = b.stale_working_feeds or [] %}
      {%- set _und = b.staleness_undated or [] %}
      {%- set _w0 = _work[0] if _work else none %}
      {%- set _wl = SURF.get(_w0.key) if _w0 else none %}
      {%- set _u0 = _und[0] if _und else none %}
      {%- set _ul = SURF.get(_u0) if _u0 else none %}
      <span class="mc warn{% if _st == 'outage' %} stale-chip{% endif %}"
            data-tip-en="Oldest dated feed on this desk. Other desks keep their own as-of stamps."
            data-tip-zh="本台最旧的有日期数据源。其余面板保留各自的截至日。">
        {%- if _st == 'outage' %}
          {{ t('Feed timestamps unavailable.','数据源时间不可用。') }}
        {%- elif _st == 'undated_among' %}
          {%- set _uname_en = (_ul or [_u0, _u0])[0] %}
          {%- set _uname_zh = (_ul or [_u0, _u0])[1] %}
          {{ t('Oldest dated feed · '~b.max_staleness_days~'d · '~_uname_en~': no timestamp.',
               '最旧有时间数据源 · '~b.max_staleness_days~'天 · '~_uname_zh~'：无时间戳') }}
        {%- elif _st == 'all_stale' %}
          {{ t('No feed is current — oldest '~b.max_staleness_days~'d.',
               '所有数据源均非最新——最旧 '~b.max_staleness_days~' 天。') }}
        {%- elif _st == 'mixed' and _wl %}
          {{ t('Oldest feed · '~b.max_staleness_days~'d — '~_wl[0]~' still current.',
               '最旧数据源 · '~b.max_staleness_days~'天——'~_wl[1]~'仍为最新。') }}
        {%- endif %}
      </span>
    {%- endif %}
    <span class="mode-badge">{{ t('Context only','仅供参考') }}</span>
  </div>

  {# ── LEAD BRIEF (C1: first content module; catalysts + standing calls folded in) ── #}
  <section data-l1="lead-brief">
    <h2 class="sec">{{ t('What matters most today','今日要点') }}</h2>
    <p class="ci-stance">{{ _STANCE_WATCH }}</p>
    <div class="matters">
      {% if b.salience %}
      <ol>
        {% for w in b.salience %}
        <li><span class="kind">{{ bl(w.kind, KIND_ZH.get(w.kind, w.kind)) }}</span>{{ bl(w.label_en, w.label_zh) }}{% if w.detail_en %} — <span class="mut"{% if w.detail_tip_en %} data-tip-en="{{ w.detail_tip_en }}" data-tip-zh="{{ w.detail_tip_zh or w.detail_tip_en }}" data-tip-rc-en="{{ w.detail_tip_en }}" data-tip-rc-zh="{{ w.detail_tip_zh or w.detail_tip_en }}"{% endif %}>{{ bl(w.detail_en, w.detail_zh) }}</span>{% endif %}</li>
        {% endfor %}
      </ol>
      {% else %}
      <p class="mut">{{ t('No ranked points this cycle.','本轮暂无排序要点。') }}</p>
      {% endif %}
      {% set wc = b.what_changed %}
      {% if wc and (wc.stance_change or wc.sentiment_band_change or wc.new_radar_fires or wc.new_accumulation) %}
      <div class="changed">
        {% if wc.stance_change %}<span class="ch">{{ t('PBoC stance','央行立场') }}: {{ bl(wc.stance_change.from, STANCE_ZH.get(wc.stance_change.from, wc.stance_change.from)) }} → {{ bl(wc.stance_change.to, STANCE_ZH.get(wc.stance_change.to, wc.stance_change.to)) }}</span>{% endif %}
        {% if wc.sentiment_band_change %}<span class="ch">{{ t('News mood','新闻情绪') }}: {{ bl(wc.sentiment_band_change.from, BAND_ZH.get(wc.sentiment_band_change.from, wc.sentiment_band_change.from)) }} → {{ bl(wc.sentiment_band_change.to, BAND_ZH.get(wc.sentiment_band_change.to, wc.sentiment_band_change.to)) }}</span>{% endif %}
        {% if wc.new_radar_fires %}<span class="ch">{{ t('New radar','新增雷达') }}: {{ wc.new_radar_fires|length }}</span>{% endif %}
        {% if wc.new_accumulation %}<span class="ch">{{ t('New accumulation','新增吸筹') }}: {{ wc.new_accumulation|length }}</span>{% endif %}
      </div>
      {% endif %}
      {% if b.news and b.news.scheduled_ahead %}
      <div class="strip" style="margin-top:10px">
        {% for ev in b.news.scheduled_ahead %}<span class="sx"><b>{{ ev.md }}</b> · {{ bl(ev.name_en, ev.name_zh) }}</span>{% endfor %}
      </div>
      {% endif %}
      {% if b.policy and b.policy.predictions %}
      <div class="strip" style="margin-top:8px">
        <span class="mut" style="font-size:11px">{{ t('Standing policy calls','政策预测') }}</span>
        {% for p in b.policy.predictions %}
          {%- if p is mapping %}
            {%- set _pen = p.en or p.text_en %}
            {%- set _pzh = p.zh or p.text_zh %}
            <span class="sx" data-tip-en="{{ _pen }}" data-tip-zh="{{ _pen }}">{{ bl(_pen, _pzh or '暂无中文摘要') }}</span>
          {%- else %}
            <span class="sx" data-tip-en="{{ p }}" data-tip-zh="{{ p }}">{{ bl(p, '暂无中文摘要') }}</span>
          {%- endif %}
        {% endfor %}
      </div>
      {% endif %}
      {% set _syn = b.analysis.llm_synthesis if b.analysis else none %}
      {% set _syn_why = b.llm_synthesis_degraded_why %}
      {% if _syn %}
      <div class="ci-synthesis">{{ bl(_syn.summary, _syn.summary_zh or _syn.summary) }}</div>
      {% elif _syn_why %}
      <p class="ci-syn-deg mut" style="font-size:11.5px;margin:8px 0 0">
        {{ t('AI cross-surface synthesis','AI 跨面板综合') }}
        <span>({{ t('deterministic only — AI read unavailable','仅确定性——AI解读不可用') }}
          · {{ bl(_syn_why.en, _syn_why.zh) }})</span>
      </p>
      {% endif %}
      {# Undated synthesis folds here — not a dated brief. Source-chipped, no as-of. #}
      {% if b.conviction and not _an_asof %}
      <div class="pp-card" style="margin-top:10px">
        <div class="ci-card-head">
          <div class="ci-card-title">{{ t('Cross-surface conviction','跨面板共振') }}</div>
          <span class="surf">{{ t('Desk synthesis','综合解读') }}</span>
        </div>
        <p class="mut" style="font-size:11px">{{ t('No as-of on the synthesis feed — kept on the lead brief, not as a dated card.','综合解读无截至日——留在要点，不作为带日期简报。') }}</p>
        <table class="syn"><tbody>
        {% for c in b.conviction %}
          <tr><td><b>{{ bl(c.sector_en, c.sector_zh) }}</b></td><td>{{ bl(c.rationale_en, c.rationale_zh) }}</td></tr>
        {% endfor %}
        </tbody></table>
      </div>
      {% endif %}
      {% if b.flagged_tickers and not _an_asof %}
      <div class="pp-card" style="margin-top:10px">
        <div class="ci-card-head">
          <div class="ci-card-title">{{ t('Flagged tickers','标记个股') }}</div>
          <span class="surf">{{ t('Desk synthesis','综合解读') }}</span>
        </div>
        <p class="mut" style="font-size:11px">{{ t('No as-of on the synthesis feed — kept on the lead brief, not as a dated card.','综合解读无截至日——留在要点，不作为带日期简报。') }}</p>
        <div class="flags">{% for f in b.flagged_tickers %}<span class="tk"><span class="nm">{{ f.name or f.ticker }}</span></span>{% endfor %}</div>
      </div>
      {% endif %}
      {% if b.analysis and b.analysis.chains and not _an_asof %}
      <div class="pp-card" style="margin-top:10px">
        <div class="ci-card-head">
          <div class="ci-card-title">{{ t('Transmission chains','传导链条') }}</div>
          <span class="surf">{{ t('Desk synthesis','综合解读') }}</span>
        </div>
        <p class="mut" style="font-size:11px">{{ t('No as-of on the synthesis feed — kept on the lead brief, not as a dated card.','综合解读无截至日——留在要点，不作为带日期简报。') }}</p>
        {% for ch in b.analysis.chains %}
        <div class="chain"><div class="hd">{{ bl(ch.label_en, ch.label_zh) }}</div></div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </section>

  {# ── DATED BRIEF CARDS (≤6; C1/C2) — every card is dated + source-chipped.
       A card whose feed has no as-of does not belong here; it folds into the
       lead brief (the module that owns undated synthesis). ── #}
  <section data-l1="dated-cards">
    <h2 class="sec">{{ t("Today's briefs",'今日简报') }}</h2>
    <p class="ci-stance">{{ _STANCE_WATCH }}</p>
    <div class="brief-grid">

  {# ── C. POLICY PHRASE SHIFTS CARD (new v4) ── #}
  {% if b.policy_phrase and _pp_asof %}
  {%- set _pp = b.policy_phrase %}
  <div class="pp-card">
    <div class="ci-card-head">
      <div class="ci-card-title">{{ t('Policy language shifts', '政策表述变化') }}</div>
      <span class="ci-card-asof">{{ _pp_asof }}</span>
      <span class="surf">{{ t('Policy language','政策表述') }}</span>
    </div>
    <div style="display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:8px">
      <span style="font-size:12px;color:var(--muted)">
        {{ t('Official-language new / dropped / lead-topic events, last 14d','官方文件 14 天内新增/消失/头版转向事件') }}
        · <b>{{ _pp.n_events_recent }}</b> {{ t('events','条') }}
      </span>
      <span class="ql-chip ql-chip-accruing">{{ t('Building · attention only','累积中 · 仅显著性') }}</span>
      <a href="china_policy_watch.html" style="font-size:11px;color:var(--ink-link, var(--link));text-decoration:none;margin-left:auto">{{ t('See policy watch →','查看政策观察 →') }}</a>
    </div>
    {%- if _pp.cold_start_organs %}
    <p class="pp-cold">{{ t('Newly started feeds (no prior window yet — cannot detect new or dropped phrasing):','刚启动的数据源（还没有历史窗口，无法判断新增或消失）：') }} {{ _pp.cold_start_organs | join(', ') }}</p>
    {%- endif %}
    {%- if _pp.recent_events %}
    {%- set _pp_all = _pp.recent_events[:24] %}
    <ul class="pp-event-list">
      {%- for ev in _pp_all[:8] %}
      {%- set _ek = EVKIND.get(ev.get('kind'), [ev.get('kind',''), ev.get('kind','')]) %}
      <li>
        <span class="pp-kind">{{ t(_ek[0], _ek[1]) }}</span>
        <div style="flex:1">
          {%- if ev.get('kind') == 'LEAD_SHIFT' %}
            <div class="pp-phrase">{{ t('Front-page lead domain','头版领衔议题') }}: {{ ev.get('from_domain','?') }} → {{ ev.get('to_domain','?') }}</div>
            <div class="pp-gloss">{{ ev.get('organ','') }}</div>
          {%- else %}
            <div class="pp-phrase">{{ ev.get('phrase','') }}</div>
            {%- if ev.get('gloss') %}<div class="pp-gloss">{{ ev.get('gloss','') }}</div>{%- endif %}
            <div class="pp-gloss">{{ ev.get('organ','') }}</div>
          {%- endif %}
          {%- if ev.get('regime_chip') %}{%- set _rc = ev.regime_chip %}
          <div class="regime-chips"><span class="rg-chip">{{ _rc.quad }}</span><span class="rg-chip">{{ td(_rc.quad_name) }}</span><span class="rg-chip">{{ td(_rc.liquidity) }}</span><span class="rg-chip">{{ td(_rc.cycle) }}-{{ t('cycle','周期') }}</span></div>
          {%- endif %}
        </div>
        <div class="pp-meta">{{ ev.get('asof','') }}</div>
      </li>
      {%- endfor %}
    </ul>
    {%- if _pp_all|length > 8 %}
    <details class="pp-more">
      <summary>{{ t('Show ' ~ (_pp_all|length - 8) ~ ' more', '显示更多 ' ~ (_pp_all|length - 8) ~ ' 条') }}</summary>
      <ul class="pp-event-list">
        {%- for ev in _pp_all[8:] %}
        <li>
          <span class="pp-kind {{ ev.get('kind','') }}">{{ ev.get('kind','') }}</span>
          <div style="flex:1">
            {%- if ev.get('kind') == 'LEAD_SHIFT' %}
              <div class="pp-phrase">{{ t('Front-page lead domain','头版领衔议题') }}: {{ ev.get('from_domain','?') }} → {{ ev.get('to_domain','?') }}</div>
              <div class="pp-gloss">{{ ev.get('organ','') }}</div>
            {%- else %}
              <div class="pp-phrase">{{ ev.get('phrase','') }}</div>
              {%- if ev.get('gloss') %}<div class="pp-gloss">{{ ev.get('gloss','') }}</div>{%- endif %}
              <div class="pp-gloss">{{ ev.get('organ','') }}</div>
            {%- endif %}
            {%- if ev.get('regime_chip') %}{%- set _rc = ev.regime_chip %}
            <div class="regime-chips"><span class="rg-chip">{{ _rc.quad }}</span><span class="rg-chip">{{ td(_rc.quad_name) }}</span><span class="rg-chip">{{ td(_rc.liquidity) }}</span><span class="rg-chip">{{ td(_rc.cycle) }}-{{ t('cycle','周期') }}</span></div>
            {%- endif %}
          </div>
          <div class="pp-meta">{{ ev.get('asof','') }}</div>
        </li>
        {%- endfor %}
      </ul>
    </details>
    {%- endif %}
    {%- else %}
    <p class="pp-cold">{{ t('No recent phrase-shift events in the last 14 days.','最近 14 天内无政策表述变化事件。') }}</p>
    {%- endif %}
    <p style="font-size:10.5px;color:var(--muted);margin-top:8px">{{ t('Attention only — direction unproven.','仅显著性——方向未验证。') }}</p>
  </div>
  {% endif %}

  {# ── D. NARRATIVE DIVERGENCE CHIP (new v4) ── #}
  {% if b.narrative_divergence and _nd_asof %}
  {%- set _nd = b.narrative_divergence %}
  <div class="nd-chip">
    <div>
      <div class="ci-card-head">
        <div class="ci-card-title">{{ t('Onshore / offshore tone', '境内/境外语气') }}</div>
        <span class="ci-card-asof">{{ _nd_asof }}</span>
        <span class="surf">{{ t('Onshore / offshore tape','境内外叙事') }}</span>
      </div>
      <div style="font-size:10px;color:var(--muted);margin-bottom:2px">{{ t('How far domestic coverage sits from offshore','境内报道相对境外的偏离程度') }}</div>
      <div class="nd-z {{ 'risk' if _nd.risk_flag else 'ok' }}"
           data-tip-en="Standardized onshore-minus-offshore tone reading {{ '%+.2f'|format(_nd.divergence_z) }}."
           data-tip-zh="境内减境外语气的标准化读数 {{ '%+.2f'|format(_nd.divergence_z) }}。"
           data-tip-rc-en="reading {{ '%+.2f'|format(_nd.divergence_z) }} · above +1.5 flags a quiet domestic tape"
           data-tip-rc-zh="读数 {{ '%+.2f'|format(_nd.divergence_z) }} · 高于 +1.5 提示境内偏静">{{ '%+.2f'|format(_nd.divergence_z) }}</div>
      {%- if _nd.trend_5d %}<div style="font-size:10px;color:var(--muted)">{{ t('5d trend','5日趋势') }}: {{ td(_nd.trend_5d) }}</div>{%- endif %}
    </div>
    <div class="nd-label">
      {%- if _nd.risk_flag and _nd.divergence_z > 0 %}
        {{ t('Domestic tape appears quieter than offshore coverage — a heads-up, not a call.', '境内报道较境外覆盖更平静——仅为提示，非结论。') }}
      {%- else %}
        {{ t('Onshore and offshore tone divergence within normal range.', '境内外报道语调差异在正常范围内。') }}
      {%- endif %}
    </div>
    <div style="display:flex;flex-direction:column;gap:4px">
      <span class="nd-badge">{{ t('Risk flag only','仅风险标志') }}</span>
    </div>
  </div>
  {% endif %}

  {# ── F. CENTRAL SYNTHESIS (dated card) ── #}
  {% if b.conviction and _an_asof %}
  <div class="pp-card">
  <div class="ci-card-head">
    <div class="ci-card-title">{{ t('Cross-surface conviction','跨面板共振') }}</div>
    <span class="ci-card-asof">{{ _an_asof }}</span>
    <span class="surf">{{ t('Desk synthesis','综合解读') }}</span>
  </div>
  <p style="font-size:12px;color:var(--muted);margin:2px 0 6px">{{ t('Where radar, alt-data, news and policy agree — leading ideas first, already-priced ones last. Attention only, never a position size.','雷达、另类数据、新闻与政策的重合处——领先的在前、已定价的在后。仅为注意，绝非仓位。') }}</p>
  <table class="syn">
    <thead><tr><th>{{ t('Sector','板块') }}</th><th data-tip-en="0–100. Elevated ≥70, moderate 40–69, low below 40." data-tip-zh="0–100。偏高 ≥70，中等 40–69，偏低低于 40。">{{ t('Opportunity','机会度') }}</th><th>{{ t('Stage','阶段') }}</th><th>{{ t('Conviction','置信') }}</th><th data-tip-en="Share of the move that may still be ahead. Elevated ≥70%, moderate 40–69%, low below 40%." data-tip-zh="行情可能尚未走完的比例。偏高 ≥70%，中等 40–69%，偏低低于 40%。">{{ t('Room left','剩余空间') }}</th><th>{{ t('Surfaces','面板') }}</th><th>{{ t('Read','解读') }}</th></tr></thead>
    <tbody>
    {% for c in b.conviction %}
      {% set st = c.stage or 'consensus' %}
      {% set _opp = c.opportunity_score if c.opportunity_score is not none else c.context_conviction %}
      {% set _edge_pct = (c.edge_remaining*100)|round|int if c.edge_remaining is not none else none %}
      <tr>
        <td><b>{{ bl(c.sector_en, c.sector_zh) }}</b> <span class="{{ 'sgn-pos' if c.radar_sign=='positive' else 'sgn-neg' }}">{{ '▲' if c.radar_sign=='positive' else '▼' }}</span>
          {%- if c.sector_driver_en %}
          <div class="mut" style="font-size:10.5px">{{ td(c.sector_driver_en) }}</div>
          {%- endif %}
        </td>
        <td><span class="cc">{{ _opp }}</span>
          {%- if _opp is not none %}
          <span class="bandpill b-{{ 'high' if _opp >= 70 else ('elevated' if _opp >= 40 else 'low') }}">{{ t('Elevated','偏高') if _opp >= 70 else (t('Moderate','中等') if _opp >= 40 else t('Low','偏低')) }}</span>
          {%- endif %}
        </td>
        <td><span class="bandpill b-{{ 'high' if st=='emerging' else ('elevated' if st=='early' else ('none' if st=='consensus' else 'low')) }}">{{ bl((_STG.get(st) or [st,st])[0], (_STG.get(st) or [st,st])[1]) }}</span>{% if c.leading_gap and c.leading_gap > 0 %} <span class="sgn-pos">↑{{ c.leading_gap }}</span>{% endif %}</td>
        <td><span class="cc">{{ c.composite_conviction if c.composite_conviction is not none else c.context_conviction }}</span> <span class="bandpill b-{{ (c.conviction_band[0]|lower) if c.conviction_band else 'none' }}">{{ bl(c.conviction_band[0], c.conviction_band[1]) }}</span></td>
        <td>{% if _edge_pct is not none %}<div class="strength" style="width:64px"><i style="width:{{ _edge_pct }}%"></i></div>
          <span class="bandpill b-{{ 'high' if _edge_pct >= 70 else ('elevated' if _edge_pct >= 40 else 'low') }}">{{ t('Elevated','偏高') if _edge_pct >= 70 else (t('Moderate','中等') if _edge_pct >= 40 else t('Low','偏低')) }}</span>
          {% else %}—{% endif %}</td>
        <td>{% for s in c.surfaces_confirming %}{%- set _sl = SURF.get(s) or [s, s] %}<span class="surf">{{ t(_sl[0], _sl[1]) }}</span>{% endfor %}</td>
        <td>{{ bl(c.rationale_en, c.rationale_zh) }}{% if c.members %}<br><span class="mut" style="font-size:11px">{% for m in c.members %}<span class="l-en">{{ m.name }} · {{ m.ticker }}</span><span class="l-zh">{{ m.name }} ({{ m.ticker }})</span>{% if not loop.last %} · {% endif %}{% endfor %}</span>{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {%- if b.conviction | selectattr('sign_unproven') | list %}
  <p style="font-size:10.5px;color:var(--muted);margin:8px 0 0">{{ t('News on this card is magnitude-only — direction unproven.','本卡新闻仅为幅度——方向未验证。') }}</p>
  {%- endif %}
  </div>
  {% endif %}

  {# ── G. FLAGGED TICKERS (dated card) ── #}
  {% if b.flagged_tickers and _an_asof %}
  <div class="pp-card">
  <div class="ci-card-head">
    <div class="ci-card-title">{{ t('Flagged tickers','标记个股') }}</div>
    <span class="ci-card-asof">{{ _an_asof }}</span>
    <span class="surf">{{ t('Desk synthesis','综合解读') }}</span>
  </div>
  <p style="font-size:12px;color:var(--muted);margin:2px 0 4px">{{ t('Names lit by two or more desks (alt-data accumulation inside a radar-lit, news-covered theme). Context watchlist, not a recommendation.','被两个或以上面板点亮的个股（位于雷达点亮、新闻覆盖主题内的另类数据吸筹）。背景自选，非推荐。') }}</p>
  <div class="flags">
    {% for f in b.flagged_tickers %}
    <span class="tk {{ 'long' if f.side=='long-context' else 'short' }}">
      <span class="nm"><span class="l-en">{{ f.name or f.ticker }}{% if f.name and f.name != f.ticker %} · {{ f.ticker }}{% endif %}</span><span class="l-zh">{{ f.name or f.ticker }}</span></span>
      <span class="cd">{{ f.ticker }}{% if f.surfaces %} · {% for s in f.surfaces %}{%- set _sl = SURF.get(s) or [s, s] %}{{ t(_sl[0], _sl[1]) }}{% if not loop.last %} + {% endif %}{% endfor %}{% endif %}</span>
    </span>
    {% endfor %}
  </div>
  </div>
  {% endif %}

  {# ── H. CAUSAL CHAINS (dated card) ── #}
  {% if b.analysis and b.analysis.chains and _an_asof %}
  <div class="pp-card">
  <div class="ci-card-head">
    <div class="ci-card-title">{{ t('Transmission chains','传导链条') }}</div>
    <span class="ci-card-asof">{{ _an_asof }}</span>
    <span class="surf">{{ t('Desk synthesis','综合解读') }}</span>
  </div>
  {% for ch in b.analysis.chains %}
  <div class="chain">
    <div class="hd"><span class="chband ch-{{ ch.band }}">{{ t(ch.band|capitalize, ({'aligned':'一致','forming':'形成中','dormant':'休眠'}).get(ch.band, ch.band)) }}</span> {{ bl(ch.label_en, ch.label_zh) }} <span class="mut" style="font-weight:400">{{ ch.k }}/{{ ch.n }}</span></div>
    <div class="legs">
      {% for l in ch.links %}<span class="leg {{ 'on' if l.aligned else 'off' }}">{{ '✓' if l.aligned else '·' }} {{ bl(l.detail_en, l.detail_zh) }}</span>{% endfor %}
    </div>
  </div>
  {% endfor %}
  {% if b.analysis.cross_refs %}
  {% for x in b.analysis.cross_refs %}
  <div class="xmit" style="border-left:4px solid var(--warn)">⚠ {{ bl(x.tag_en, x.tag_zh) }}</div>
  {% endfor %}
  {% endif %}
  </div>
  {% endif %}

    </div>{# /.brief-grid #}
  </section>

  {# ── K. DIGEST (Tier-3; D3/D4) ── #}
  {% if b.digest %}<details><summary style="cursor:pointer;font-size:12px;color:var(--muted);margin:8px 0">{{ t('Machine digest (what the Mastermind reads)','机器摘要（Mastermind 读取的内容）') }}</summary><div class="digest">{{ b.digest }}</div></details>{% endif %}

  {# ── K2. COMMAND LIST ── #}
  {# cmd_full is the full command.json artifact loaded separately by the builder #}
  {%- if cmd_full and cmd_full.command %}
  {%- set _cmd = cmd_full %}
  <section data-l1="watch-table">
  <h2 class="sec">{{ t('China Command List','中国指挥清单') }}</h2>
  <p class="ci-stance">{{ _STANCE_WATCH }}</p>
  <p style="font-size:12px;color:var(--muted);margin:0 0 10px">
    {{ t('Names where alt-data or radar is ahead of the crowd. Emerging = those desks leading while news and the buy-board are still quiet.','另类数据或雷达走在市场前面的个股。萌芽 = 这些台领先，新闻与买入板尚静。') }}
    <span class="mode-badge">{{ t('context only','仅供参考') }}</span>
    &nbsp;{{ t('Universe','覆盖') }}: {{ _cmd.n_universe or '—' }} &nbsp;·&nbsp;
    {{ t('Emerging','萌芽') }}: {{ (_cmd.counts or {}).get('emerging',0) }} &nbsp;·&nbsp;
    {{ t('Early','早期') }}: {{ (_cmd.counts or {}).get('early',0) }}
    {%- if (_cmd.counts or {}).get('veto_blind') %} &nbsp;·&nbsp; <span style="color:var(--ink-warn, var(--warn))">{{ t('No-price','无价格') }}: {{ (_cmd.counts or {}).get('veto_blind',0) }}</span>{%- endif %}
  </p>
  {%- set _rows = _cmd.command %}
  {%- set _show_n = [8, _rows|length]|min %}
  <div class="tbl-scroll">
    <table class="cmd-tbl">
      <thead>
        <tr>
          <th>{{ t('Ticker','代码') }}</th>
          <th>{{ t('Name','名称') }}</th>
          <th data-tip-en="news · alt-data · radar · buy-board · special situations" data-tip-zh="新闻 · 另类数据 · 雷达 · 买入板 · 特殊情景">{{ t('Desks','台') }}</th>
          <th>{{ t('Stage','阶段') }}</th>
          <th data-tip-en="Share of the move that may still be ahead." data-tip-zh="行情可能尚未走完的部分。">{{ t('Room left','剩余空间') }}</th>
          <th data-tip-en="Opportunity 0–100. Elevated ≥70, moderate 40–69, low below 40." data-tip-zh="机会 0–100。偏高 ≥70，中等 40–69，偏低低于 40。">{{ t('Opportunity','机会') }}</th>
          <th data-tip-en="20-day return vs CSI 300. Off-high is distance from the recent peak." data-tip-zh="20 日收益相对沪深300。距高点为相对近期高点的距离。">{{ t('Vs market / off high','相对市场 / 距高点') }}</th>
          <th>{{ t('What changes it','改判条件') }}</th>
        </tr>
      </thead>
      <tbody>
      {%- for d in _rows[:_show_n] %}
        {%- set _dm = d.desk_matrix or {} %}
        {%- set _traj = d.traj or {} %}
        {%- set _stage_cls = 'stage-' ~ (d.stage or 'quiet') %}
        {%- set _stage_lbl = _STG.get(d.stage, [d.stage|capitalize, d.stage|capitalize]) %}
        <tr>
          <td><span class="cmd-ticker">{{ d.ticker }}</span></td>
          <td><span class="cmd-name"{% if d.name %} data-tip-en="{{ d.name }}" data-tip-zh="{{ d.name }}"{% endif %}>{%- if d.name and d.name != d.ticker -%}<span class="l-en">{{ d.name[:18] }} · {{ d.ticker }}</span><span class="l-zh">{{ d.name[:18] }}</span>{%- else -%}{{ t('Name not on file','未录入名称') }}{%- endif -%}</span></td>
          <td>
            <div class="cmd-desk-dots">
              {%- for dk, dl in [('news','N'),('altdata','A'),('radar','R'),('board','B'),('special','S')] %}
              {%- set _di = (_dm.get(dk) or {}) %}
              {%- set _dp = _di.get('present', false) %}
              {%- set _dd = _di.get('dir') %}
              {%- if _dp and _dd == 1 %}<span class="cmd-dot up" data-tip-en="{{ dl }}:bullish" data-tip-zh="{{ dl }}:看涨"></span>
              {%- elif _dp and _dd == -1 %}<span class="cmd-dot down" data-tip-en="{{ dl }}:bearish" data-tip-zh="{{ dl }}:看跌"></span>
              {%- elif _dp %}<span class="cmd-dot neutral" data-tip-en="{{ dl }}:neutral" data-tip-zh="{{ dl }}:中性"></span>
              {%- else %}<span class="cmd-dot absent" data-tip-en="{{ dl }}:absent" data-tip-zh="{{ dl }}:缺失"></span>
              {%- endif %}
              {%- endfor %}
            </div>
          </td>
          <td><span class="{{ _stage_cls }} stage-chip">{{ t(_stage_lbl[0], _stage_lbl[1]) }}</span></td>
          <td>
            <span class="edge-bar"><i style="width:{{ (d.edge_remaining or 0)*100 }}%"></i></span>
            <span style="font-size:11px;font-variant-numeric:tabular-nums">{{ "%.0f"|format((d.edge_remaining or 0)*100) }}%</span>
          </td>
          <td><span class="opp-score">{{ "%.0f"|format(d.opportunity_score or 0) }}</span>
            {%- set _opp_n = d.opportunity_score or 0 %}
            <span class="bandpill b-{{ 'high' if _opp_n >= 70 else ('elevated' if _opp_n >= 40 else 'low') }}">{{ t('Elevated','偏高') if _opp_n >= 70 else (t('Moderate','中等') if _opp_n >= 40 else t('Low','偏低')) }}</span>
          </td>
          <td>
            {%- if d.veto_blind %}
              <span class="rs-chip rs-neg" data-tip-en="no price plane" data-tip-zh="无价格数据">{{ t('No price plane','无价格数据') }}</span>
            {%- else %}
              {#- .get() access: missing traj keys pass `is not none` as Undefined then crash on compare (house gotcha) #}
              {%- if _traj.get('rs_20d') is not none %}
                <span class="rs-chip {{ 'rs-pos' if _traj.get('rs_20d') > 3 else ('rs-neg' if _traj.get('rs_20d') < -3 else 'rs-neu') }}"
                      data-tip-en="20-day return vs CSI 300"
                      data-tip-zh="20 日收益相对沪深300">
                  {{ t('vs market','相对市场') }} {{ "%+.0f"|format(_traj.get('rs_20d')) }}%
                </span>
              {%- endif %}
              {%- if _traj.get('off_high_pct') is not none %}
                &nbsp;<span class="rs-chip rs-neu" data-tip-en="Distance from the recent peak" data-tip-zh="相对近期高点的距离">{{ "%+.0f"|format(_traj.get('off_high_pct')) }}% {{ t('off high','距高点') }}</span>
              {%- endif %}
            {%- endif %}
          </td>
          <td>
            {%- if d.falsifier %}<div class="cmd-fals">{{ t(d.falsifier[:80], (d.get('falsifier_zh') or d.falsifier)[:40]) }}</div>
            {%- else %}<div class="cmd-read">{{ t('Nothing on file that would change this read.','暂无改判条件。') }}</div>{%- endif %}
          </td>
        </tr>
      {%- endfor %}
      </tbody>
    </table>
  </div>
  {%- if _rows|length > _show_n %}
  <details>
    <summary class="cmd-expander">{{ t('Show all','展开全部') }} {{ _rows|length }} {{ t('names','只') }} ▸</summary>
    <div class="cmd-wrap" style="margin-top:8px">
      <table class="cmd-tbl">
        <thead>
          <tr>
            <th>{{ t('Ticker','代码') }}</th><th>{{ t('Name','名称') }}</th>
            <th>{{ t('Desks','台') }}</th><th>{{ t('Stage','阶段') }}</th>
            <th>{{ t('Edge','剩余边际') }}</th><th>{{ t('Opp','机会') }}</th>
            <th>{{ t('RS/Off-High','RS/偏离高点') }}</th><th>{{ t('Read','读数') }}</th>
          </tr>
        </thead>
        <tbody>
        {%- for d in _rows[_show_n:] %}
          {%- set _dm2 = d.desk_matrix or {} %}
          {%- set _traj2 = d.traj or {} %}
          {%- set _stage_cls2 = 'stage-' ~ (d.stage or 'quiet') %}
          {%- set _stage_lbl2 = _STG.get(d.stage, [d.stage|capitalize, d.stage|capitalize]) %}
          <tr>
            <td><span class="cmd-ticker">{{ d.ticker }}</span></td>
            <td><span class="cmd-name"{% if d.name %} data-tip-en="{{ d.name }}" data-tip-zh="{{ d.name }}"{% endif %}>{{ d.name[:18] }}</span></td>
            <td>
              <div class="cmd-desk-dots">
                {%- for dk, dl in [('news','N'),('altdata','A'),('radar','R'),('board','B'),('special','S')] %}
                {%- set _di2 = (_dm2.get(dk) or {}) %}
                {%- if _di2.get('present') and _di2.get('dir') == 1 %}<span class="cmd-dot up"></span>
                {%- elif _di2.get('present') and _di2.get('dir') == -1 %}<span class="cmd-dot down"></span>
                {%- elif _di2.get('present') %}<span class="cmd-dot neutral"></span>
                {%- else %}<span class="cmd-dot absent"></span>
                {%- endif %}
                {%- endfor %}
              </div>
            </td>
            <td><span class="{{ _stage_cls2 }} stage-chip">{{ t(_stage_lbl2[0], _stage_lbl2[1]) }}</span></td>
            <td><span class="edge-bar"><i style="width:{{ (d.edge_remaining or 0)*100 }}%"></i></span> {{ "%.0f"|format((d.edge_remaining or 0)*100) }}%</td>
            <td><span class="opp-score">{{ "%.0f"|format(d.opportunity_score or 0) }}</span></td>
            <td>
              {%- if d.veto_blind %}<span class="rs-chip rs-neg" data-tip-en="no price plane / veto blind" data-tip-zh="无价格数据">no price plane / 无价格数据</span>
              {%- else %}
              {%- if _traj2.get('rs_20d') is not none %}<span class="rs-chip {{ 'rs-pos' if _traj2.get('rs_20d') > 3 else ('rs-neg' if _traj2.get('rs_20d') < -3 else 'rs-neu') }}">RS {{ "%+.0f"|format(_traj2.get('rs_20d')) }}%</span>{%- endif %}
              {%- if _traj2.get('off_high_pct') is not none %}&nbsp;<span class="rs-chip rs-neu">{{ "%+.0f"|format(_traj2.get('off_high_pct')) }}%H</span>{%- endif %}
              {%- endif %}
            </td>
            <td><div class="cmd-read">{{ t(d.read, d.get('read_zh') or d.read) }}</div></td>
          </tr>
        {%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
  {%- endif %}
  </section>
  {%- endif %}

  {# ── K2c. INSTITUTIONAL VISITS — DELETED (C2 named landing: removed; duplicate of Command List rows; 13/15 cards were stale notices). ── #}

  {# ── K3. DISCOVERY QUEUE ── #}
  {%- if cmd_full and cmd_full.discovery %}
  <section data-l1="discovery">
  <h2 class="sec">{{ t('Discovery Queue','发现队列') }}</h2>
  <p class="ci-stance">{{ _STANCE_WATCH }}</p>
  <p style="font-size:12px;color:var(--muted);margin:0 0 10px">
    {{ t('Off-desk leading signals — names not yet on any desk. The margin-velocity lane is experimental and does not enter the ranking.','离板块领先信号——尚未出现在任何台的个股。融资速度栏为实验性，不计入排名。') }}
  </p>
  <div class="disc-queue">
    {%- for c in cmd_full.discovery %}
    <div class="disc-card {{ 'off-desk' if c.off_desk }}">
      <div class="disc-ticker">{{ c.ticker }}</div>
      <div class="disc-name">{%- if c.name and c.name != c.ticker -%}<span class="l-en">{{ c.name[:22] }} · {{ c.ticker }}</span><span class="l-zh">{{ c.name[:22] }}</span>{%- else -%}{{ t('Name not on file','未录入名称') }}{%- endif -%}</div>
      {#- Each language is truncated on its OWN budget: 80 latin glyphs ≈ 40 CJK
          glyph widths, so clipping the zh at the en length would overflow the card. #}
      <div class="disc-reason">{{ t((c.reason or '')[:80], (c.get('reason_zh') or c.reason or '')[:40]) }}</div>
      <div class="disc-meta">
        <span class="lane-chip">{{ t((_LANE_EN.get(c.source) or c.source), (_LANE_ZH.get(c.source) or c.source)) }}</span>
        {%- if c.experimental %}<span class="exp-chip">{{ t('Experimental','实验性') }}</span>{%- endif %}
        {%- if c.off_desk %}<span class="offdesk-chip">{{ t('Off-desk','离板块') }}</span>{%- endif %}
        {%- if c.venue %}<span class="lane-chip" style="color:var(--ink-link, var(--link))">{{ c.venue }}</span>{%- endif %}
      </div>
      {%- if c.experimental %}
      <div style="font-size:10px;color:var(--ink-warn, var(--warn));margin-top:4px">{{ t('Experimental lane — not yet in the ranking','实验栏——暂不计入排名') }}</div>
      {%- endif %}
    </div>
    {%- endfor %}
  </div>
  </section>
  {%- endif %}

  {# ── K4. ANALOGS CARD (degrade-safe; hidden when artifact absent) ── #}
  {%- if b.analogs %}
  {%- set _an = b.analogs %}
  <section data-l1="analogs">
  <h2 class="sec">{{ t('Cycle Context & Historical Analogs','周期背景与历史类比') }}</h2>
  <p class="ci-stance">{{ t('Ignore', '可忽略') }}</p>
  <div class="analogs-card">
    <div style="font-size:11px;color:var(--muted);margin-bottom:8px">
      {{ t('Historical analog periods sharing the current macro fingerprint. Descriptive fan only — not a forecast.','与当前宏观指纹相近的历史类比区间。仅为描述性分布——非预测。') }}
    </div>
    {%- if _an.query %}
    <div class="analogs-query">
      {%- set _aq = _an.query %}
      {#- Values go through td() (glossary), same as the regime chips at L340/L364 —
          the LABEL alone through t() left `Stagflation`/`contracting`/`mid` in English. #}
      {%- if _aq.quad %}<span class="aq-chip">{{ t('Quad','象限') }}: {{ td(_aq.quad_name or _aq.quad) }}</span>{%- endif %}
      {%- if _aq.liquidity %}<span class="aq-chip">{{ t('Liquidity','流动性') }}: {{ td(_aq.liquidity) }}</span>{%- endif %}
      {%- if _aq.cycle %}<span class="aq-chip">{{ t('Cycle','周期') }}: {{ td(_aq.cycle) }}</span>{%- endif %}
    </div>
    {%- endif %}
    {%- if _an.fan %}
    <table class="fan-table">
      <thead><tr>
        <th>{{ t('Horizon','期限') }}</th>
        <th data-tip-en="Lower quarter of analog forward returns (25th percentile)." data-tip-zh="类比区间远期收益的下沿（四分位）。" data-tip-rc-en="25th percentile of analog forward returns" data-tip-rc-zh="类比区间远期收益第 25 百分位">{{ t('Lower quarter','下沿') }}</th>
        <th>{{ t('Median','中位') }}</th>
        <th data-tip-en="Upper quarter of analog forward returns (75th percentile)." data-tip-zh="类比区间远期收益的上沿（四分位）。" data-tip-rc-en="75th percentile of analog forward returns" data-tip-rc-zh="类比区间远期收益第 75 百分位">{{ t('Upper quarter','上沿') }}</th>
        <th data-tip-en="Number of analog periods in this fan." data-tip-zh="该分布所含类比区间数。">{{ t('Cases','样本') }}</th>
      </tr></thead>
      <tbody>
      {%- for hz in ['h20','h60','h120'] %}
      {%- set _frow = (_an.fan or {}).get(hz) or {} %}
      <tr>
        <td>{{ {'h20':'20d','h60':'60d','h120':'120d'}[hz] }}</td>
        {%- set _p25 = _frow.get('p25') if _frow else none %}
        {%- set _med = _frow.get('median') if _frow else none %}
        {%- set _p75 = _frow.get('p75') if _frow else none %}
        <td>{{ "%+.1f%%"|format(_p25*100) if _p25 is not none else '—' }}</td>
        <td><b>{{ "%+.1f%%"|format(_med*100) if _med is not none else '—' }}</b></td>
        <td>{{ "%+.1f%%"|format(_p75*100) if _p75 is not none else '—' }}</td>
        <td>{{ _frow.get('n') or '—' }}</td>
      </tr>
      {%- endfor %}
      </tbody>
    </table>
    {%- endif %}
    {%- if _an.analogs %}
    <details style="margin-top:8px">
      <summary style="cursor:pointer;font-size:11.5px;color:var(--ink-link, var(--link))">{{ t('Analog periods','类比区间') }} ({{ _an.n_analogs or 0 }}) ▸</summary>
      <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:7px">
      {%- for a in _an.analogs[:12] %}
        <span style="font-size:11px;padding:2px 8px;border-radius:7px;background:var(--panel2);border:1px solid var(--line)">
          {{ a.date }} · {{ td(a.quad) if a.quad else '' }}
          {%- if a.fwd_shcomp %}{%- set _h20 = a.fwd_shcomp.get('h20') if a.fwd_shcomp else none %} · {{ "%+.1f%%"|format(_h20*100) if _h20 is not none else '' }}{%- endif %}
        </span>
      {%- endfor %}
      </div>
    </details>
    {%- endif %}
    {%- if _an.disclaimer_en %}
