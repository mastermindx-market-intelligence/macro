<script>
(function () {
  var q = window.__plotlyQ = [];
  function queued(method) {
    return function () {
      var args = [].slice.call(arguments);
      return new Promise(function (resolve, reject) {
        q.push([method, args, resolve, reject]);
      });
    };
  }
  window.Plotly = {
    newPlot: queued('newPlot'),
    react: queued('react'),
    relayout: queued('relayout'),
    restyle: queued('restyle')
  };
}());
</script>
<script defer src="plotly-2.32.0.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var q = window.__plotlyQ || [];
  window.__plotlyQ = null;
  q.forEach(function (call) {
    try {
      Promise.resolve(window.Plotly[call[0]].apply(window.Plotly, call[1])).then(call[2], call[3]);
    } catch (error) {
      call[3](error);
    }
  });
});
</script>