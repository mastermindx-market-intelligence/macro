{# The close-of-session snapshot owns every number in this disclosure, including its date.
   Intraday hero ticks do not carry a matching six-factor decomposition. #}
{% autoescape true %}
{% macro bi(en, zh) -%}<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh or en }}</span>{%- endmacro %}
{% set snap = MS2 if MS2 is mapping else {} %}
{% set score = snap.score %}
{% set has_score = score is number and score is not boolean and 0 <= score <= 100 %}
{% set factors = snap.components|default([], true)|select('mapping')|list %}
{% set valid = namespace(rows=[], weight=0, weights_known=true) %}
{% for c in factors if c.score is number and c.score is not boolean and 0 <= c.score <= 100 %}
  {% set valid.rows = valid.rows + [c] %}
  {% if c.weight is number and c.weight is not boolean and 0 < c.weight <= 1 %}
    {% set valid.weight = valid.weight + c.weight %}
  {% else %}{% set valid.weights_known = false %}{% endif %}
{% endfor %}
{% set freshness = snap.freshness if snap.freshness is mapping else {} %}
{% set vintages = snap.input_vintages if snap.input_vintages is mapping else (freshness.inputs if freshness.inputs is mapping else {}) %}
{% set stale = namespace(keys=(snap.stale_inputs or freshness.stale_inputs or [])|list) %}
{% for key,v in vintages.items() if v is mapping and v.stale and key not in stale.keys %}{% set stale.keys = stale.keys + [key] %}{% endfor %}
<div class="mx5-dlg" id="dlg-evidence" role="dialog" aria-modal="true" aria-labelledby="evidence-title" tabindex="-1">
  <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
  <div class="mx5-dlg-panel">
    <header class="mx5-dlg-header">
      <div><div class="ev-kicker">{{ bi('US equities / Signals', '美股 / 信号') }}</div>
        <h2 id="evidence-title">{{ bi('Evidence breakdown', '信号依据分析') }}</h2>
      </div>
      <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()"><span aria-hidden="true">×</span><span class="ev-sr">{{ bi('Close evidence breakdown', '关闭信号依据分析') }}</span></button>
    </header>
    <div class="mx5-dlg-body">
      <div class="ev-meta">
        <span>{{ bi('Session snapshot','交易日快照') }} <b>{{ snap.asof or '—' }}</b></span>
        <span>{{ bi('Factors scored','已计分因子') }} <b>{{ valid.rows|length }} / 6</b></span>
        {% if freshness.stale %}<strong>{{ bi('Snapshot behind expected session','快照落后于应有交易日') }} {{ freshness.expected_asof or '' }}</strong>{% endif %}
        {% if stale.keys %}<strong>{{ bi('Stale inputs','滞后数据项') }} · {{ stale.keys|join(', ') }}</strong>{% endif %}
      </div>
      <section class="ev-brief" aria-labelledby="ev-verdict">
        <div>
          <h3 class="ev-kicker" id="ev-verdict">{{ bi('Published verdict','公布的市场判断') }}</h3>
          <div class="ev-scoreline"><strong class="ev-score">{{ score if has_score else '—' }}</strong><span>/ 100</span>
            <b class="ev-verdict {{ snap.color if snap.color in ['green','yellow','red'] else '' }}">{{ bi(snap.label_en or 'Unavailable', snap.label_zh or ('暂无读数' if not snap.label_en else snap.label_en)) if has_score else bi('Unavailable','暂无读数') }}</b>
          </div>
          <div class="ev-scale" aria-hidden="true"><i></i><i></i><i></i>{% if has_score %}<b style="left:{{ score }}%"></b>{% endif %}</div>
          <div class="ev-scale-labels">{{ bi('0–41 Risk-off','0–41 避险') }}{{ bi('42–59 Mixed','42–59 混合') }}{{ bi('60–100 Risk-on','60–100 偏多') }}</div>
        </div>
        <div class="ev-condition">
          <h3 class="ev-kicker">{{ bi('What would change the verdict?','什么会改变判断？') }}</h3>
          <p>{{ bi(snap.flip_en, snap.flip_zh) if snap.flip_en else bi('No transition condition was published for this snapshot.','本次快照未公布转换条件。') }}</p>
        </div>
        {% if snap.capped %}<div class="ev-cap"><strong>{{ bi('Score cap applied','评分已触及上限') }}</strong>
          {{ bi('Measured blend','实测综合分') }} {{ snap.raw_score if snap.raw_score is number else '—' }} → {{ score if has_score else '—' }}
          {% for cap in snap.score_caps or [] if cap is mapping %}<span>{{ bi(cap.note_en, cap.note_zh) }}{% if cap.limit is number %} ({{ cap.limit }}){% endif %}</span>{% endfor %}
        </div>{% endif %}
        {% if snap.participation_scope and snap.headline_en %}<p class="ev-scope">{{ bi(snap.headline_en,snap.headline_zh) }}</p>{% endif %}
        {# Rank on weighted distance from neutral, not on the unweighted factor score. #}
        {% if valid.weights_known and valid.weight and valid.rows|length > 1 %}
          {% set extremes = namespace(lift=0, drag=0, lifting=[], dragging=[]) %}
          {% for c in valid.rows %}
            {% set points = ((c.score - 50) * c.weight / valid.weight)|round(2) %}
            {% if points > extremes.lift %}{% set extremes.lift = points %}{% set extremes.lifting = [c] %}
            {% elif points == extremes.lift and points > 0 %}{% set extremes.lifting = extremes.lifting + [c] %}{% endif %}
            {% if points < extremes.drag %}{% set extremes.drag = points %}{% set extremes.dragging = [c] %}
            {% elif points == extremes.drag and points < 0 %}{% set extremes.dragging = extremes.dragging + [c] %}{% endif %}
          {% endfor %}
          {% if extremes.dragging or extremes.lifting %}<div class="ev-drivers">
            {% for group, value, en, zh, tone in [(extremes.dragging,extremes.drag,'Largest drag','主要拖累','ev-neg'),(extremes.lifting,extremes.lift,'Largest lift','主要支撑','ev-pos')] if group %}
              <div class="{{ tone }}"><span class="ev-kicker">{{ bi(en,zh) }}</span>
                {% for c in group %}{{ bi(c.label_en,c.label_zh) }}{{ ' / ' if not loop.last }}{% endfor %}
                <b>{{ '%+.2f'|format(value) }}</b>
              </div>
            {% endfor %}</div>{% endif %}
        {% endif %}
      </section>
      <section class="ev-section" aria-labelledby="ev-factor-title">
        <div class="ev-section-head"><div><div class="ev-kicker">01 / {{ bi('Attribution','因子归因') }}</div>
          <h3 id="ev-factor-title">{{ bi('What shaped the score','哪些因子影响了评分') }}</h3></div>
          <span class="ev-quiet">{{ bi('Expand a factor for its inputs','展开因子查看依据') }}</span>
        </div>
        <p class="ev-note">{{ bi('Impact shows how many points each factor adds to or subtracts from a neutral blend of 50, before any cap.','影响值表示各因子相对于中性基准 50 分的加减分，按任何上限生效前计算。') }}</p>
        {% if valid.rows|length < 6 %}<p class="ev-flag">{{ bi('Partial coverage. The blend uses the weights of available factors only.','覆盖不完整。综合分仅按可用因子的权重计算。') if valid.rows else bi('Factor readings are unavailable for this snapshot.','本次快照没有可用的因子读数。') }}</p>{% endif %}
        <div class="ev-ledger">
        {% for c in valid.rows %}
          {% set impact = (c.score - 50) * c.weight / valid.weight if valid.weights_known and valid.weight else none %}
          <details class="ev-factor">
            <summary tabindex="0">
              <span class="ev-factor-info"><b>{{ bi(c.label_en or 'Unnamed factor',c.label_zh or ('未命名因子' if not c.label_en else c.label_en)) }}</b>
                <span class="ev-read">{{ bi(c.read_en,c.read_zh) }}</span>
                {% if c.degraded %}<span class="ev-flag">{{ bi('Partial inputs','部分输入缺失') }}</span>{% endif %}
              </span>
              <span class="ev-factor-value"><span class="ev-kicker">{{ bi('Score','评分') }}</span><span class="ev-track" aria-hidden="true"><i style="left:{{ [50,c.score]|min }}%;width:{{ (c.score-50)|abs }}%"></i></span><b>{{ c.score }}</b></span>
              <span class="ev-impact {{ 'ev-pos' if impact is not none and impact > 0 else ('ev-neg' if impact is not none and impact < 0 else '') }}">
                <span class="ev-kicker">{{ bi('Impact','影响') }}</span><b>{{ '%+.2f'|format(impact) if impact is not none else '—' }}</b>
              </span><span class="ev-chevron" aria-hidden="true">⌄</span>
            </summary>
            <div class="ev-detail">
              {% if c.weight is number and c.weight is not boolean and 0 < c.weight <= 1 %}<span>{{ bi('Base weight','基础权重') }} <b>{{ '%g'|format(c.weight * 100) }}%</b></span>{% endif %}
              {% if c.degraded_note_en %}<p class="ev-flag">{{ bi(c.degraded_note_en,c.degraded_note_zh) }}</p>{% endif %}
              {% if c.metrics %}<dl class="ev-metrics">{% for m in c.metrics if m is mapping and m.v is defined and m.v is not none and m.v != '' %}
                <div><dt>{{ bi(m.k_en,m.k_zh) }}</dt><dd>{{ m.v }}</dd></div>{% endfor %}</dl>
              {% elif c.key == 'trend' and snap.mtf and snap.mtf.indices %}<p>{{ bi('The index tape below supplies the trend measurements.','下方的指数读数提供趋势依据。') }}</p>
              {% else %}<p>{{ bi('No underlying measurements were published.','未公布底层测量值。') }}</p>{% endif %}
            </div>
          </details>
        {% endfor %}</div>
      </section>
      <section class="ev-section" aria-labelledby="ev-tape-title">
        <div class="ev-kicker">02 / {{ bi('Index tape','指数走势') }}</div><h3 id="ev-tape-title">{{ bi('Trend across timeframes','多周期趋势') }}</h3>
        {% if snap.mtf is mapping and snap.mtf.indices %}
        <p class="ev-note">{{ bi('Numbers are 14-period RSI. Arrows show the combined trend on each timeframe. A dot marks a missing reading.','数字为 14 周期 RSI；箭头表示各周期的综合方向。圆点表示读数缺失。') }}</p>
        <table class="mx5-dlg-mtf-tbl">
          <thead><tr><th scope="col">{{ bi('Index','指数') }}</th><th scope="col">1D</th><th scope="col">3D</th><th scope="col">1W</th><th scope="col">1M</th><th scope="col">{{ bi('Alignment','一致性') }}</th></tr></thead>
          <tbody>{% for r in snap.mtf.indices if r is mapping %}
            <tr><td>{{ bi(r.label_en,r.label_zh) }}</td>
              {% for tf in ['D','3D','W','M'] %}
                {% set cell = r.cells.get(tf) if r.cells is mapping else none %}
                {% set rsi = cell.rsi if cell is mapping else none %}
                {% set usable = rsi is number and rsi is not boolean and 0 <= rsi <= 100 %}
                <td data-sort="{{ rsi|round|int if usable else '' }}"><span class="ms-cell2 {{ cell.tone if cell is mapping and cell.tone in ['good','bad','flat'] else 'flat' }}"><span class="ar">{{ cell.arrow if cell is mapping and cell.arrow else ('·' if not usable else '') }}</span>{% if cell is mapping %}<span class="rsi">{{ rsi|round|int if usable else '·' }}</span>{% endif %}</span></td>
              {% endfor %}<td>{{ bi(r.confluence_en or '—',r.confluence_zh) }}</td>
            </tr>{% endfor %}</tbody>
        </table>
        {% else %}<p class="ev-note">{{ bi('Index readings are unavailable for this snapshot.','本次快照暂无指数读数。') }}</p>{% endif %}
      </section>
      <details class="ev-sources"><summary tabindex="0">{{ bi('Source dates and coverage','来源日期与覆盖范围') }} <span aria-hidden="true">⌄</span></summary>
        {% if vintages %}<dl class="ev-metrics">{% for key,v in vintages.items() if v is mapping %}
          <div><dt>{{ key|upper }}</dt><dd>{{ v.asof or '—' }}{% if v.stale %} · {{ bi('Stale','滞后') }}{% endif %}</dd></div>
        {% endfor %}</dl>{% else %}<p>{{ bi('Individual input dates were not supplied.','未提供各项输入的日期。') }}</p>{% endif %}
        <p>{{ bi('The score describes the observed market. Intraday updates to the dashboard can be newer than this factor snapshot.','评分描述已观测的市场状况。仪表盘的盘中更新可能晚于本次因子快照。') }}</p>
      </details>
    </div>
  </div>
</div>
{% endautoescape %}
