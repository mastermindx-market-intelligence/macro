{% extends "_gmi_base.html.j2" %}
{% from "_gmi_macros.html.j2" import t, ic with context %}
{% from "_gmi_head.html.j2" import head %}
{% import "_gmi_theme_data.html.j2" as dataset with context %}
{% from "_gmi_product_macros.html.j2" import connection with context %}
{% block title %}GMI Explorer — {{ issuer.display_name }}{% endblock %}
{% block seo %}{% set seo_title = 'GMI Explorer — ' ~ issuer.display_name ~ ' | Mastermind' %}{% set seo_desc = issuer.display_name ~ ': documented product connections, dated sources and research context.' %}{% set seo_path = 'gmi-issuer-' ~ issuer.ticker|lower ~ '.html' %}{% include "_seo_head.html.j2" %}{% endblock %}
{% block body %}
{% set ticker_line %}<div class="gmi-eyebrow">{{ issuer.ticker }}{% if issuer.exchange %} · {{ issuer.exchange }}{% endif %}</div>{% endset %}
{{ head([('Research', '研究'), ('Company evidence', '公司证据')], issuer.display_name, issuer.display_name, 'The products, themes and sources currently documented for this company.', '此公司目前有据可查的产品、主题及来源。', extra=ticker_line) }}
{% set shown = namespace(count=0) %}
<div class="gmi-company-context"><div class="gmi-connection-list">
{% for topic in dataset.public_topics %}{% for card in topic.connections if card.ticker == issuer.ticker %}
{% set shown.count = shown.count + 1 %}<div><p class="gmi-topic-meta"><a href="{{ nav_prefix }}gmi.html#theme={{ topic.id|urlencode }}">{{ t(topic.en, topic.zh) }}</a></p>{{ connection(card, topic, true) }}</div>
{% endfor %}{% endfor %}
{% if not shown.count %}<section class="gmi-topic-empty"><h2>{{ t('No reviewed product evidence', '暂无经审核产品证据') }}</h2><p>{{ t('No reviewed product connection is available for this company in this snapshot.', '此快照暂无此公司的可用经审核产品关联。') }}</p><a class="gmi-action-secondary" href="{{ nav_prefix }}gmi-companies.html">{{ t('Browse company evidence', '浏览公司证据') }}</a></section>{% endif %}</div><aside class="gmi-company-notes"><section><h2>{{ t('What this tells you', '这些信息说明什么') }}</h2><p>{{ t('Each card connects a named product to a theme and its dated source. Read the lifecycle alongside the publication date.', '每张卡片将所述产品与主题及注明日期的来源关联起来。请结合发布日期理解产品阶段。') }}</p></section><section><h2>{{ t('What remains unknown', '尚不清楚的信息') }}</h2><p>{{ t('Current delivery, deal size and revenue exposure are not established by these records. A product connection is not a complete business profile.', '这些记录不能证实当前交付、交易规模或营收敞口。产品关联也不是完整的业务画像。') }}</p></section><section><h2>{{ t('Company relationships', '公司关系') }}</h2><p>{{ t('Relationship records require their own public display clearance.', '公司关系记录需要单独获得公开展示许可。') }}</p><a href="{{ nav_prefix }}gmi-relationships.html">{{ t('View publication status', '查看发布状态') }} {{ ic('arrow',14) }}</a></section></aside></div>
{% endblock %}
