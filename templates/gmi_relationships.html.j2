{% extends "_gmi_base.html.j2" %}
{% from "_gmi_macros.html.j2" import t, ic with context %}
{% block title %}GMI Explorer — Company relationships{% endblock %}
{% block seo %}{% set seo_title = 'GMI Explorer — Company relationships | Mastermind' %}{% set seo_desc = 'Publication status for documented company relationships.' %}{% set seo_path = 'gmi-relationships.html' %}{% include "_seo_head.html.j2" %}{% endblock %}
{% block body %}
{# The current model exposes internal records, not a verified public projection.
   Fail closed at rendering: never emit parties, records, amounts, excerpts, or a
   hidden search payload. A source's public availability is not display permission.
   Publication projection remains with the existing model/data owner. #}
<section class="gmi-permission-state" aria-labelledby="gmi-publication-title"><span class="gmi-empty-symbol">{{ ic('eyeoff',24) }}</span><span class="gmi-eyebrow">{{ t('Publication status', '发布状态') }}</span><h2 id="gmi-publication-title">{{ t('Public relationship view unavailable', '暂无公开关系视图') }}</h2><p>{{ t('This snapshot does not include a verified public relationship view. Company names, relationship details and financial figures are withheld here.', '此快照尚不包含经核实的公开关系视图。相关公司名称、关系详情及财务数值暂不在此展示。') }}</p><p>{{ t('This is a publication restriction, not a statement that no relationships exist.', '这是发布限制，并不表示这些关系不存在。') }}</p><div class="gmi-state-actions"><a class="gmi-action-primary" href="{{ nav_prefix }}gmi-companies.html">{{ t('Browse company evidence', '浏览公司证据') }}{{ ic('arrow',16) }}</a><a class="gmi-action-secondary" href="{{ nav_prefix }}gmi.html">{{ t('Explore themes', '探索主题') }}</a><a class="gmi-action-secondary" href="{{ nav_prefix }}gmi-coverage.html">{{ t('Coverage & methodology', '覆盖与方法') }}</a></div></section>
<details class="gmi-topic-receipt"><summary>{{ t('How publication works', '发布机制') }}</summary><div><p>{{ t('Relationship facts, magnitudes and excerpts each require the appropriate recorded permission. Public access to a source document does not grant those permissions.', '关系事实、数值与引文分别需要相应的已记录许可。来源文件可公开访问，并不意味着已获得这些许可。') }}</p><p>{{ t('Theme research and separately cleared company evidence remain available.', '主题研究与另行获准展示的公司证据仍可使用。') }}</p></div></details>
{% endblock %}
