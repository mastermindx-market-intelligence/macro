{# Market Structure · W2 production redesign. Context only; models remain upstream. #}
{% macro t(en, zh='') -%}<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh or en }}</span>{%- endmacro %}
{% macro ord_n(value) -%}{% set n = value|round|int %}{{ t(n ~ ('th' if n % 100 in [11,12,13] else {1:'st',2:'nd',3:'rd'}.get(n % 10,'th')), '第 ' ~ n) }}{%- endmacro %}
{% macro stamp(key) -%}
{% set o = view.dates[key] %}<span class="msp-status {{ o.state }}" data-observation="{{ key }}"{% if o.expires %} data-expires="{{ o.expires }}"{% endif %}>
{% if o.date %}{{ t('Observed', '观测于') }} <time datetime="{{ o.date }}">{{ o.date }}</time>{% else %}{{ t('Observation date unavailable', '观测日期暂缺') }}{% endif %}
</span>{%- endmacro %}
{% macro ranges(key, choices, default) -%}
<div class="msp-range range-btns" id="{{ key }}-range-btns" role="group" aria-label="Chart time range" data-label-en="Chart time range" data-label-zh="图表时间范围">
{% for n,label,zh in choices %}<button type="button" class="rbtn" data-range="{{ n }}" data-chart="{{ key }}" aria-pressed="{{ 'true' if n == default else 'false' }}" aria-controls="{{ key }}-chart-group" disabled>{{ t(label,zh) }}</button>{% endfor %}
</div>{%- endmacro %}
{% macro chart_empty() -%}<p class="msp-chart-unavailable">{{ t('The interactive chart is loading. Exact values are available in observations below.', '交互图表正在加载，可在下方「观测数据」查看精确读数。') }}</p>{%- endmacro %}
{% macro range_status(key) -%}
{% set c = view.charts[key] %}<span class="msp-range-status" id="{{ key }}-range-status" role="status" aria-live="polite">
{% if c.first %}{{ c.count }} {{ t('observations', '个观测') }} · {{ c.first }} — {{ c.last }}{% if c.gaps %} · {{ c.gaps }} {{ t('missing', '个缺口') }}{% endif %}{% else %}{{ t('No chart history available', '暂无图表历史') }}{% endif %}
</span>{%- endmacro %}
{% macro observations(key, columns) -%}
<details class="mx-disc msp-method" data-observations="{{ key }}"><summary>{{ t('Explore observations & download', '查看观测数据与下载') }}</summary>
<div class="msp-method-content">
<div class="msp-table-tools" hidden><button type="button" class="gbtn" data-download="{{ key }}">{{ t('Download selected range · CSV', '下载所选范围 · CSV') }}</button></div>
<div class="msp-table-wrap" tabindex="0" aria-label="Observation table" data-label-en="Observation table" data-label-zh="观测数据表">
<table class="dtp msp-data-table" id="{{ key }}-table"><caption>{{ t('Latest 12 sessions in the selected range. A dash means unavailable.', '所选范围内最近 12 个交易日。「—」表示数据暂缺。') }}</caption>
<thead><tr><th scope="col">{{ t('Date','日期') }}</th>{% for field,en,zh,dec in columns %}<th scope="col">{{ t(en,zh) }}</th>{% endfor %}</tr></thead>
<tbody>{% for row in view.charts[key].selected[-12:] %}<tr><td>{{ row.date }}</td>{% for field,en,zh,dec in columns %}<td>{{ num(row.get(field),dec) }}</td>{% endfor %}</tr>{% else %}<tr><td colspan="{{ columns|length + 1 }}">{{ t('No observations available','暂无观测数据') }}</td></tr>{% endfor %}</tbody></table></div>
</div></details>{%- endmacro %}
{% macro scrub(key) -%}<div class="msp-scrub" hidden><label for="{{ key }}-scrub">{{ t('Inspect a session', '逐日查看') }}</label><input type="range" id="{{ key }}-scrub" min="0" max="1" value="1" data-scrub="{{ key }}" aria-label="Inspect a session" data-label-en="Inspect a session" data-label-zh="选择交易日查看读数"></div>{%- endmacro %}
{% set g = view.gamma %}{% set sys = view.systematic %}{% set vc = view.vc %}{% set cta = view.cta %}{% set d = view.dispersion %}{% set v = view.vol %}{% set w = view.week_map %}{% set week = view.week %}
{% set reg = g.get('regime') %}{% set agreement = sys.get('agreement') %}{% set cor_state = d.get('cor1m_regime') %}
{% set fund_windows = [sys.get('flow_window_n'),vc.get('flow_window_n'),cta.get('flow_window_n')] %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
{% include '_interfonts.html.j2' %}
<script>try{var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',t==='light'?'light':'dark');var l=localStorage.getItem('lang');if(!l){l=(navigator.languages||[navigator.language||'']).some(function(s){return s.toLowerCase().indexOf('zh')===0})?'zh':'en'}document.documentElement.setAttribute('data-lang',l==='zh'?'zh':'en');document.documentElement.lang=l==='zh'?'zh-CN':'en'}catch(e){}</script>
<link rel="stylesheet" href="theme.css"><link rel="stylesheet" href="illus.css?v=20261102-1"><link rel="stylesheet" href="market_structure.css?v=20261102-1">
<script defer src="theme.js"></script><script defer src="lightweight-charts.js?v=4.2.0"></script><script defer src="illus.js?v=20261102-1"></script><script defer src="market_structure.js?v=20261102-1"></script>
<title>Market Structure | Mastermind</title>
{% set seo_title = 'Market Structure — Dealer Positioning, Systematic Fund Flows & Dispersion | Mastermind' %}
{% set seo_desc = 'Dealer hedging · systematic fund flows · stock-picking conditions · options-implied weekly range. Dated observations, model context and transparent data coverage.' %}
{% set seo_path = 'market_structure.html' %}{% include '_seo_head.html.j2' %}
</head>
<body class="page-msp">
<a class="msp-skip" href="#market-structure">{{ t('Skip to market structure','跳转到市场结构') }}</a>
{% include '_site_nav.html.j2' %}
<main class="msp-main" id="market-structure">
<div class="msp-topline"><div class="msp-eyebrow">{{ t('Market Structure','市场结构') }}</div><div class="msp-scope"><strong>S&P 500</strong><span class="msp-separator" aria-hidden="true"></span><span>SPX</span><span class="msp-tag muted">{{ t('Model context','模型参考') }}</span></div></div>
<header class="mx-vh">
<div class="msp-titleline"><span class="msp-tag {{ 'warn' if reg == 'short' else 'info' if reg == 'long' else 'muted' }}">{{ t('Latest observed regime','最近观测到的状态') }}</span>{{ stamp('gamma') }}</div>
<h1>{% if reg == 'short' %}{{ t('Dealer hedging may amplify market swings.','做市商对冲可能放大市场波动。') }}{% elif reg == 'long' %}{{ t('Dealer hedging may cushion market swings.','做市商对冲可能缓冲市场波动。') }}{% else %}{{ t('The dealer picture is still incomplete.','做市商持仓信息尚不完整。') }}{% endif %}</h1>
<p class="msp-lede">{% if reg == 'short' %}{{ t('Hedging can reinforce price moves in this state. Watch the estimated switch level for a change in that backdrop.','在这一状态下，对冲交易可能顺势强化价格波动。关注预估切换位，判断这一背景是否发生变化。') }}{% elif reg == 'long' %}{{ t('Hedging can lean against price moves in this state. Watch the estimated switch level for a change in that backdrop.','在这一状态下，对冲交易可能逆势缓冲价格波动。关注预估切换位，判断这一背景是否发生变化。') }}{% else %}{{ t('Check the dated evidence below before interpreting the market backdrop. Each measure stands on its own.','解读市场环境前，请先核对下方数据的观测日期。各项指标独立呈现。') }}{% endif %}</p>
<div class="msp-stale-note" id="msp-age-warning"{% if view.dates.gamma.state != 'stale' and view.dates.gamma.state != 'unknown' %} hidden{% endif %} role="status">
<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="7.5"/><path d="M10 5.5v5M10 13.5v1"/></svg><p>{{ t('Check freshness before using this snapshot. The dealer observation is older than the expected session or its date cannot be verified.','使用此快照前请核对时效：做市商数据早于应有交易日，或其观测日期尚无法确认。') }} <a href="#data-notes">{{ t('View source dates','查看数据日期') }} ↗</a></p></div>
</header>

<div class="msp-overview">
<section class="panel" aria-labelledby="switch-level-heading">
<div class="msp-panel-head"><div><h2 id="switch-level-heading">{{ t('Where hedging changes','对冲行为的切换位') }}</h2><p>{{ t('SPX · estimated dealer switch level','SPX · 做市商对冲预估切换位') }}</p></div><span class="msp-tag muted">{{ t('Key level','关键价位') }}</span></div>
<div class="msp-levels"><div><div class="msp-label">{{ t('Observed SPX','观测时的 SPX') }}</div><div class="msp-large-number">{{ num(g.get('spot'),0) }}</div></div><div><div class="msp-label">{{ t('Switch level','切换位') }}</div><div class="msp-large-number">{{ num(g.get('gamma_flip'),0) }}</div></div></div>
<div class="msp-distance">{% if finite(g.get('dist_to_flip_pct')) is not none %}<strong>{{ num(g.dist_to_flip_pct|abs,2) }}%</strong><span>{{ t('below the switch level','低于切换位') if g.dist_to_flip_pct < 0 else t('above the switch level','高于切换位') if g.dist_to_flip_pct > 0 else t('at the switch level','位于切换位') }}</span>{% else %}<span>{{ t('Distance unavailable','距离数据暂缺') }}</span>{% endif %}<a class="msp-inline-link" href="#dealer-history">{{ t('Explore dealer history','查看做市商历史') }} <span aria-hidden="true">↗</span></a></div>
</section>
<section class="panel" id="weekly-range" aria-labelledby="weekly-range-heading"{% if week.end %} data-week-end="{{ week.end }}"{% endif %}>
<div class="msp-panel-head"><div><h2 id="weekly-range-heading">{{ t('The range options priced','期权隐含的周度区间') }}</h2><p>{% if week.valid %}{{ week.start }} — {{ week.end }}{% else %}{{ t('Waiting for a complete locked weekly range','等待完整的周度锁定区间') }}{% endif %}</p></div><span class="msp-tag muted" id="msp-week-status">{% if week.state == 'expired' %}{{ t('Archived week','历史周度') }}{% elif week.state == 'upcoming' %}{{ t('Upcoming week','下一周') }}{% elif week.state == 'active' %}{{ t('Locked for the week','本周已锁定') }}{% else %}{{ t('Unavailable','暂缺') }}{% endif %}</span></div>
{% if week.valid %}
<div class="msp-between"><div class="msp-key-number">{{ num(w.band_1sigma_lo,0) }} — {{ num(w.band_1sigma_hi,0) }}</div><div class="msp-metric-note">±{{ num(w.get('implied_weekly_pct'),2) }}%</div></div>
<div class="msp-band" role="img" aria-label="Locked weekly range with separately dated SPX and switch-level markers" data-label-en="Locked weekly range with separately dated SPX and switch-level markers" data-label-zh="锁定周度区间及分别注明观测日期的 SPX 与切换位标记" style="--lo2:{{ week.positions.band_2sigma_lo }}%;--lo1:{{ week.positions.band_1sigma_lo }}%;--hi1:{{ week.positions.band_1sigma_hi }}%;--hi2:{{ week.positions.band_2sigma_hi }}%">
<div class="msp-band-track"></div><div class="msp-band-outer"></div><div class="msp-band-inner"></div><div class="msp-band-lock" style="--x:{{ week.positions.locked_close }}%"></div>{% if 'spot' in week.positions %}<div class="msp-band-spot" style="--x:{{ week.positions.spot }}%"></div>{% endif %}{% if 'flip' in week.positions %}<div class="msp-band-flip" style="--x:{{ week.positions.flip }}%"></div>{% endif %}
</div><div class="msp-band-caption"><span>{{ num(w.band_2sigma_lo,0) }}</span><span>{{ t('Outer model range','外层模型区间') }}</span><span>{{ num(w.band_2sigma_hi,0) }}</span></div>
<div class="msp-band-legend"><span class="msp-legend-item"><i class="msp-legend-swatch" aria-hidden="true"></i>{{ t('Inner range','内层区间') }}</span><span class="msp-legend-item"><i class="msp-legend-swatch spot" aria-hidden="true"></i>SPX {{ num(g.get('spot'),0) }} · {{ view.dates.gamma.date or '—' }}</span><a href="#range-notes">{{ t('Read the assumptions','查看假设') }} ↗</a></div>
{% else %}<div class="msp-empty"><strong>{{ t('No usable weekly range','暂无可用周度区间') }}</strong>{{ t('A complete, dated range will appear after the weekly lock is available.','周度锁定数据完整且日期明确后，将在此显示。') }}</div>{% endif %}
</section>
</div>

<nav class="msp-section-nav" aria-label="On this page" data-label-en="On this page" data-label-zh="本页导航">
{% for id,no,en,zh in [('dealer-history','01','Dealer positioning','做市商持仓'),('fund-flows','02','Fund flows','系统化资金'),('stock-picking','03','Stock-picking','选股环境'),('volatility','04','Volatility','波动率'),('data-notes','05','Range & evidence','区间与依据')] %}<a href="#{{ id }}"><span class="msp-nav-number">{{ no }}</span>{{ t(en,zh) }}</a>{% endfor %}</nav>

<section class="msp-section" id="dealer-history" aria-labelledby="dealer-title">
<div class="msp-section-head"><div><h2 id="dealer-title"><span class="msp-section-number">01</span>{{ t('Dealer positioning','做市商持仓') }}</h2><p>{{ t('Estimated hedging pressure, with price and switch level on their own scale.','预估对冲压力；价格与切换位使用独立刻度。') }}</p></div>{{ ranges('gamma',[(21,'1M','1月'),(63,'3M','3月'),(126,'6M','6月'),(252,'1Y','1年'),(9999,'All','全部')],126) }}</div>
<div class="panel msp-chart-panel" id="gamma-chart-group">
<div class="msp-chart-heading"><div><h3>{{ t('Net dealer exposure','做市商净敞口') }} <span class="msp-metric-note">· {{ t('$ billions','十亿美元') }}</span></h3><p>{{ t('Options-based estimate (GEX)','基于期权数据的估计值（GEX）') }}</p></div><div class="msp-chart-legend"><span class="msp-legend-item"><i class="msp-legend-swatch" aria-hidden="true"></i>{{ t('Positive · absorbing','正值 · 缓冲波动') }}</span><span class="msp-legend-item"><i class="msp-legend-swatch warn" aria-hidden="true"></i>{{ t('Negative · amplifying','负值 · 放大波动') }}</span></div></div>
<div class="msp-chart" id="gamma-chart" role="img" aria-describedby="gamma-range-status" aria-label="Net dealer exposure history" data-label-en="Net dealer exposure history" data-label-zh="做市商净敞口历史">{{ chart_empty() }}</div>
<div class="msp-chart-divider"><div class="msp-chart-heading"><h3>{{ t('SPX & estimated switch level','SPX 与预估切换位') }} <span class="msp-metric-note">· {{ t('index points','指数点') }}</span></h3><div class="msp-chart-legend"><span class="msp-legend-item"><i class="msp-legend-swatch" aria-hidden="true"></i>SPX</span><span class="msp-legend-item"><i class="msp-legend-swatch warn" aria-hidden="true"></i>{{ t('Switch level','切换位') }}</span></div></div><div class="msp-chart price" id="gamma-price-chart" role="img" aria-describedby="gamma-range-status" aria-label="SPX and dealer switch-level history" data-label-en="SPX and dealer switch-level history" data-label-zh="SPX 与做市商切换位历史">{{ chart_empty() }}</div></div>
<div class="msp-chart-readout" id="gamma-readout" aria-live="off"><span>{{ t('Inspect the chart or use the session slider for exact values.','在图表上查看，或使用交易日滑块读取精确数据。') }}</span></div>{{ scrub('gamma') }}
<div class="msp-chart-foot">{{ range_status('gamma') }}<span>{{ t('Gaps remain gaps · no interpolation','缺失保留为空 · 不作插值') }}</span></div>
<p class="msp-coverage"><strong>{{ num(g.get('net_gex_bn'),1,'$','B',true) }}</strong> {{ t('latest model exposure','最近模型敞口') }}{% if finite(g.get('days_in_regime_observed')) is not none %} · {{ g.days_in_regime_observed|int }} {{ t('observed sessions in this state','个观测交易日处于此状态') }}{% if finite(g.get('days_in_regime')) is not none and g.days_in_regime != g.days_in_regime_observed %} {{ t('across','横跨') }} {{ g.days_in_regime|int }} {{ t('sessions','个交易日') }}{% endif %}{% endif %}{% if view.missing %} · <span class="msp-warn">{{ view.missing|length }} {{ t('recent or in-regime sessions have no chain reading','个近期或状态区间内交易日缺少期权链读数') }}</span>{% endif %}.</p>
{{ observations('gamma',[('net_gex_bn','Exposure ($B)','敞口（十亿美元）',2),('spot','SPX (pts)','SPX（点）',2),('flip','Switch (pts)','切换位（点）',2)]) }}
<details class="mx-disc msp-method"><summary>{{ t('How to read dealer positioning','如何理解做市商持仓') }}</summary><div class="msp-method-content"><p>{{ t('Positive net exposure suggests dealer hedging can absorb moves; negative exposure suggests it can reinforce them. The switch level estimates where that behavior changes. It moves as option positions and prices change.','净敞口为正时，做市商对冲可能缓冲波动；为负时，可能强化波动。切换位估计这种行为转换的位置，并会随期权持仓和价格变化。') }}</p><p>{{ t('Missing chain snapshots cannot be reconstructed later. An observed run does not prove the same state held on missing sessions.','缺失的期权链快照无法事后补建。已有观测连续处于同一状态，并不证明缺失交易日也保持该状态。') }}{% if view.missing %} {{ t('Missing dates:','缺失日期：') }} {{ view.missing|join(', ') }}.{% endif %}</p><p>{% if finite(g.get('net_gex_pctile')) is not none %}{{ t('Exposure percentile in stored history:','敞口在已存历史中的百分位：') }} {{ ord_n(g.net_gex_pctile) }}. {% endif %}{{ t('Series starts','序列起始于') }} {{ g.get('series_start') or '—' }}. <a href="https://www.tradingview.com/lightweight-charts/" target="_blank" rel="noopener">{{ t('Charts by TradingView','图表技术：TradingView') }}</a>.</p></div></details>
</div></section>

<div class="msp-grid">
<section class="msp-section panel msp-driver" id="fund-flows" aria-labelledby="fund-title">
<div class="msp-section-head"><div><h2 id="fund-title"><span class="msp-section-number">02</span>{{ t('Systematic fund flows','系统化资金流') }}</h2><p>{{ t('Model estimates · not observed transactions','模型估计 · 非实际成交资金') }}</p></div>{{ stamp('systematic') }}</div>
<p class="msp-verdict">{% if agreement == 'aligned_cutting' %}{{ t('Both models are reducing exposure.','两类模型均在减仓。') }}{% elif agreement == 'aligned_adding' %}{{ t('Both models are adding exposure.','两类模型均在加仓。') }}{% elif agreement == 'split' %}{{ t('The two models are moving apart.','两类模型的方向出现分歧。') }}{% elif agreement == 'paused' %}{{ t('Model positioning is broadly steady.','模型仓位大体稳定。') }}{% else %}{{ t('The fund picture is incomplete.','系统化资金信息尚不完整。') }}{% endif %}</p>
<p class="msp-description">{{ t('Watch the direction and size of positioning changes. These estimates describe systematic funds separately, without a combined flow score.','关注仓位变化的方向与量级。两类系统化基金分别估计，不合成为资金总评分。') }}</p>
<div class="msp-models"><div><h3>{{ t('Volatility-control funds','波动率控制基金') }}</h3><div class="msp-key-number">{{ num(vc.get('alloc_bn'),1,'$','B') }}</div><div class="msp-metric-note">{{ t('model exposure','模型敞口') }}</div><div class="msp-model-delta {{ direction(vc.get('flow_5d_bn')) }}">{{ num(vc.get('flow_5d_bn'),1,'$','B',true) }} <span class="msp-metric-note">{% if vc.get('flow_window_n',sys.get('flow_window_n')) %}{{ t('over','近') }} {{ vc.get('flow_window_n',sys.get('flow_window_n'))|int }} {{ t('sessions','个交易日') }}{% else %}{{ t('window unavailable','窗口暂缺') }}{% endif %}</span></div><div class="msp-model-meta">{{ num(vc.get('flow_1d_bn'),1,'$','B',true) }} {{ t('latest session','最近一个交易日') }} · {{ num(vc.get('alloc_frac') * 100 if finite(vc.get('alloc_frac')) is not none else none,0,'','%') }} {{ t('of target allocation','目标仓位') }}</div></div>
<div><h3>{{ t('Trend-following funds','趋势跟踪基金') }}</h3><div class="msp-key-number">{{ num(cta.get('score'),2,'','',true) }}</div><div class="msp-metric-note">{{ t('positioning score','仓位评分') }}</div><div class="msp-model-delta {{ direction(cta.get('flow_5d')) }}">{{ num(cta.get('flow_5d'),2,'','',true) }} {{ t('pts','点') }} <span class="msp-metric-note">{% if cta.get('flow_window_n',sys.get('flow_window_n')) %}{{ t('over','近') }} {{ cta.get('flow_window_n',sys.get('flow_window_n'))|int }} {{ t('sessions','个交易日') }}{% else %}{{ t('window unavailable','窗口暂缺') }}{% endif %}</span></div><div class="msp-model-meta">{{ num(cta.get('flow_1d'),2,'','',true) }} {{ t('pts · latest session','点 · 最近一个交易日') }}{% if cta.get('cta_near_flat') %} · {{ t('near flat','接近持平') }}{% endif %}</div></div></div>
<div class="msp-driver-chart" id="systematic-chart-group"><div class="msp-chart-heading"><div><label class="msp-label" for="msp-fund-series">{{ t('History','历史') }}</label><select id="msp-fund-series" class="gbtn" aria-label="Fund history series" data-label-en="Fund history series" data-label-zh="资金历史序列"><option value="vc_alloc_bn" data-en="Exposure · $B" data-zh="模型敞口 · 十亿美元">Exposure · $B</option><option value="cta_score" data-en="Trend score · points" data-zh="趋势评分 · 点">Trend score · points</option><option value="spx_close" data-en="SPX close · points" data-zh="SPX 收盘 · 点">SPX close · points</option></select></div>{{ ranges('systematic',[(63,'3M','3月'),(252,'1Y','1年'),(9999,'All','全部')],252) }}</div><div class="msp-chart small" id="systematic-chart" role="img" aria-describedby="systematic-range-status" aria-label="Systematic fund model history" data-label-en="Systematic fund model history" data-label-zh="系统化基金模型历史">{{ chart_empty() }}</div><div class="msp-chart-readout" id="systematic-readout"></div>{{ scrub('systematic') }}<div class="msp-chart-foot">{{ range_status('systematic') }}</div></div>
{{ observations('systematic',[('vc_alloc_bn','Exposure ($B)','敞口（十亿美元）',2),('cta_score','Trend score','趋势评分',2),('spx_close','SPX close','SPX 收盘',2)]) }}
<details class="mx-disc msp-method"><summary>{{ t('What the fund models measure','资金模型衡量什么') }}</summary><div class="msp-method-content"><p>{{ t('Volatility-control funds adjust exposure as realized volatility changes. Trend-following funds react to price trends. These are model estimates, not observed fund positions or cash transactions.','波动率控制基金随实际波动率变化而调整敞口；趋势跟踪基金根据价格趋势调整仓位。这里均为模型估计，并非观测到的实际基金持仓或资金交易。') }}</p><p>{{ t('Systematic-flow agreement is categorical: aligned adding, aligned cutting, divergent or quiet. Dollar exposure and trend-score points are different units and are never added together.','系统化资金共识仅作分类：同向加仓、同向减仓、分歧或平稳。美元敞口与趋势评分点数单位不同，不能相加。') }}</p><p>{{ t('Volatility-control assumptions:','波动率控制模型假设：') }} {{ num(vc.get('aum_bn'),0,'$','B') }} {{ t('model capital;','模型规模；') }} {{ num(vc.get('target_vol_pct'),0,'','%') }} {{ t('volatility target. The displayed change uses the actual number of available sessions.','波动率目标。显示的变化按实际可用交易日数计算。') }}</p></div></details>
</section>

<section class="msp-section panel msp-driver" id="stock-picking" aria-labelledby="stock-title">
<div class="msp-section-head"><div><h2 id="stock-title"><span class="msp-section-number">03</span>{{ t('Stock-picker conditions','选股环境') }}</h2><p>{{ t('How closely stocks move together','股票走势的一致程度') }}</p></div>{{ stamp('dispersion') }}</div>
<p class="msp-verdict">{% if cor_state == 'dispersion' %}{{ t('More room for individual stock stories.','个股自身因素有更大发挥空间。') }}{% elif cor_state == 'elevated' %}{{ t('Stocks are moving more as one.','股票走势的联动性更强。') }}{% elif cor_state == 'normal' %}{{ t('Stock co-movement is in the middle range.','股票联动处于中间区间。') }}{% else %}{{ t('Stock co-movement is not yet clear.','股票联动情况尚不明确。') }}{% endif %}</p>
<p class="msp-description">{{ t('Use correlation to judge the backdrop for stock selection. Lower readings suggest less index-wide co-movement.','通过相关性判断选股环境。读数较低，意味着股票随大盘同步波动的程度较弱。') }}</p>
<div class="msp-comparison"><div><div class="msp-label">{{ t('Implied correlation','隐含相关性') }}</div><div class="msp-large-number">{{ num(d.get('cor1m'),2) }}</div><div class="msp-metric-note">{{ t('COR1M · index points','COR1M · 指数点') }}</div></div><div><div class="msp-label">{{ t('Change vs one year','较一年前变化') }}</div><div class="msp-key-number">{{ num(d.get('cor1m_1y_delta'),2,'','',true) }}</div><div class="msp-metric-note">{{ t('index points','指数点') }}</div></div></div>
{% if finite(d.get('cor1m_pctile_2y')) is not none %}<div class="msp-rank"><div class="msp-between"><span class="msp-metric-note">{{ t('Position in its two-year history','在两年历史中的位置') }}</span><strong class="msp-metric-note">{{ ord_n(d.cor1m_pctile_2y) }} {{ t('percentile','百分位') }}</strong></div><div class="msp-rank-scale" style="--rank:{{ [0,[100,d.cor1m_pctile_2y]|min]|max }}%;--low:{{ d.get('cor1m_pctile_lo',20) }}%;--high:{{ d.get('cor1m_pctile_hi',80) }}%" aria-hidden="true"><i class="msp-rank-pin"></i></div><div class="msp-rank-labels"><span>{{ t('More independent','更独立') }}</span><span>{{ t('More synchronized','更同步') }}</span></div></div>{% endif %}
<div class="msp-driver-chart" id="dispersion-chart-group"><div class="msp-chart-heading"><h3>{{ t('Implied correlation history','隐含相关性历史') }}</h3>{{ ranges('dispersion',[(63,'3M','3月'),(252,'1Y','1年'),(9999,'All','全部')],252) }}</div><div class="msp-chart small" id="dispersion-chart" role="img" aria-describedby="dispersion-range-status" aria-label="One-month implied correlation history, index points" data-label-en="One-month implied correlation history, index points" data-label-zh="一个月隐含相关性历史，单位为指数点">{{ chart_empty() }}</div><div class="msp-chart-readout" id="dispersion-readout"></div>{{ scrub('dispersion') }}<div class="msp-chart-foot">{{ range_status('dispersion') }}</div></div>
{{ observations('dispersion',[('cor1m','COR1M (pts)','COR1M（点）',2)]) }}
<details class="mx-disc msp-method"><summary>{{ t('When the stock-picker window changes','选股窗口何时变化') }}</summary><div class="msp-method-content"><p>{{ t('The stock-picker window holds at or below the lower percentile threshold. Above the upper threshold, broad market moves dominate more often. Between them, the model calls conditions normal.','位于或低于下限百分位时，模型将其归为选股窗口；高于上限时，大盘联动更强；两者之间为正常状态。') }} {{ t('Current thresholds:','当前阈值：') }} {{ num(d.get('cor1m_pctile_lo'),0) }} / {{ num(d.get('cor1m_pctile_hi'),0) }}.</p><p>{{ t('The classification comes from the source model and its trailing two-year percentile. The history chart shows raw COR1M values; it does not apply today’s threshold to earlier dates.','分类来自源模型及其过去两年的百分位。历史图仅展示 COR1M 原始值，不将今天的阈值套用到历史日期。') }}</p></div></details>
</section>

<section class="msp-section panel msp-driver" id="volatility" aria-labelledby="vol-title">
<div class="msp-section-head"><div><h2 id="vol-title"><span class="msp-section-number">04</span>{{ t('Volatility backdrop','波动率背景') }}</h2><p>{{ t('Realized moves & the cost of time','已实现波动与不同期限的定价') }}</p></div><span class="msp-tag muted">{{ t('Two separate lenses','两个独立视角') }}</span></div>
<p class="msp-verdict">{% if v.get('rv_cross_state') == 'calm' %}{{ t('Recent realized volatility is easing.','近期已实现波动率正在回落。') }}{% elif v.get('rv_cross_state') == 'stress' %}{{ t('Recent realized volatility is rising.','近期已实现波动率正在上升。') }}{% else %}{{ t('Realized volatility needs more context.','已实现波动率需要更多数据。') }}{% endif %}</p><p class="msp-description">{{ t('Compare faster and slower realized volatility, then check how futures price later months.','先比较短期与中期已实现波动率，再观察期货对后续月份的定价。') }}</p>
<div class="msp-comparison"><div><div class="msp-label">{{ t('1-month realized','1个月已实现波动率') }}</div><div class="msp-large-number">{{ num(v.get('rv21') * 100 if finite(v.get('rv21')) is not none else none,1,'','%') }}</div></div><div><div class="msp-label">{{ t('3-month realized','3个月已实现波动率') }}</div><div class="msp-large-number">{{ num(v.get('rv63') * 100 if finite(v.get('rv63')) is not none else none,1,'','%') }}</div></div></div>{{ stamp('rv') }}
<div class="msp-curve-label"><h3 class="msp-label">{{ t('VIX futures term structure','VIX 期货期限结构') }}</h3><span class="msp-metric-note">{{ num(v.get('vix_curve_slope'),2,'','',true) }} {{ t('pts · M6 − M1','点 · M6 − M1') }}</span></div>
{% if view.curve_svg %}{{ view.curve_svg|safe }}{% endif %}
{% if view.curve %}<div class="msp-curve-grid">{% for c in view.curve %}<div class="msp-curve-cell"><small>{{ c.get('tenor') or '—' }}</small><strong>{{ num(c.get('settle'),1) }}</strong><small>{{ num(c.get('dte'),0) }} {{ t('days','天') }}</small></div>{% endfor %}</div>{% else %}<div class="msp-empty">{{ t('The futures curve is unavailable.','期货曲线暂缺。') }}</div>{% endif %}
{{ stamp('curve') }}<p class="msp-model-meta">{{ t('Contracts are spaced by maturity order, not calendar distance.','合约按到期月份等距排列，不代表实际日历间距。') }}</p>
<details class="mx-disc msp-method"><summary>{{ t('Volatility definitions & source dates','波动率定义与数据日期') }}</summary><div class="msp-method-content"><p>{{ t('Realized volatility is annualized from 21- and 63-session SPX returns. It describes past movement. VIX futures show the market’s pricing across contract months; they are a separate series.','已实现波动率由 SPX 最近 21 与 63 个交易日收益率年化而得，描述过去的波动。VIX 期货显示不同合约月份的市场定价，属于另一条独立序列。') }}</p><p>{{ t('Curve history starts','期货曲线历史起始于') }} {{ v.get('series_start_curve') or '—' }}. {{ t('A series start date is not an observation timestamp. Older artifacts without source timestamps remain explicitly undated.','序列起始日并非观测时间。旧数据若未提供观测时间，将明确保留为日期暂缺。') }}</p><a class="msp-inline-link" href="options.html">{{ t('Open the options workspace','打开期权工作台') }} ↗</a></div></details>
</section>

<section class="msp-section panel msp-driver" id="data-notes" aria-labelledby="notes-title">
<div class="msp-section-head"><div><h2 id="notes-title"><span class="msp-section-number">05</span>{{ t('Range & evidence','周度区间与数据依据') }}</h2><p>{{ t('Know what is dated, locked or missing','了解日期、锁定规则与数据缺口') }}</p></div><a class="msp-inline-link" href="#weekly-range">{{ t('View range','查看区间') }} ↑</a></div>
<p class="msp-verdict">{% if week.state == 'expired' %}{{ t('This weekly range has ended.','该周度区间已结束。') }}{% elif week.valid %}{{ t('A fixed reference for a dated week.','指定周度的固定参考区间。') }}{% else %}{{ t('The weekly reference is unavailable.','周度参考区间暂缺。') }}{% endif %}</p><p class="msp-description">{{ t('Treat the inner and outer bands as model scenarios. Their widths are not a promise about how often prices stay inside them.','将内外两层区间视为模型情景。区间宽度并不保证价格落在其中的实际频率。') }}</p>
<div class="msp-week-facts"><div><span class="msp-label">{{ t('Locked reference','锁定参考值') }}</span><strong>{{ num(w.get('locked_close'),1) }}</strong><span class="msp-model-meta">{{ week.locked or '—' }}</span></div><div><span class="msp-label">{{ t('Outer model range','外层模型区间') }}</span><strong>{{ num(w.get('band_2sigma_lo'),0) }} — {{ num(w.get('band_2sigma_hi'),0) }}</strong><span class="msp-model-meta">{{ t('Twice the inner-band width','内层区间宽度的两倍') }}</span></div></div>
<div class="msp-evidence-list">{% for key,en,zh in [('gamma','Dealer chain','做市商期权链'),('systematic','Fund models','系统化资金模型'),('dispersion','Implied correlation','隐含相关性'),('rv','Realized volatility','已实现波动率'),('curve','VIX futures','VIX 期货')] %}<div class="msp-evidence-row"><div><strong>{{ t(en,zh) }}</strong>{% if view.dates[key].state == 'stale' %}<small>{{ view.dates[key].behind }} {{ t('completed sessions behind at render','个已结束交易日延迟（渲染时）') }}</small>{% elif view.dates[key].state == 'unknown' %}<small>{{ t('Source date cannot be verified','源数据日期无法确认') }}</small>{% else %}<small>{{ t('Dated snapshot','带日期的快照') }}</small>{% endif %}</div>{{ stamp(key) }}</div>{% endfor %}</div>
<details class="mx-disc msp-method" id="range-notes"><summary>{{ t('Weekly range assumptions','周度区间假设') }}</summary><div class="msp-method-content"><p>{{ t('The model locks the prior week’s reference close and scales 30-day SPX implied volatility to five trading days. The inner band is one model standard deviation; the outer band is two. The lock stays fixed for the stated week and resets on the next weekly cycle.','模型锁定上周参考收盘价，将 SPX 30 天隐含波动率换算为五个交易日。内层为一个模型标准差，外层为两个。指定周内保持锁定，在下一周度周期重置。') }}</p><p>{{ t('This assumes volatility scales with the square root of time. Normal-distribution coverage is a model assumption, not measured historical accuracy. SPX and switch-level markers use the separately displayed dealer observation date.','这假设波动率按时间平方根缩放。正态分布覆盖率属于模型假设，并非实测历史准确率。SPX 与切换位标记使用单独标示的做市商观测日期。') }}</p></div></details>
<details class="mx-disc msp-method"><summary>{{ t('Recorded snapshot changes','已记录的快照变化') }}</summary><div class="msp-method-content"><p>{{ t('Compared with stored snapshot','对比已存快照') }} {{ view.comparison_date or '—' }}. {{ t('Snapshot dates do not guarantee that every underlying source was observed that day.','快照日期不代表每个底层数据源都在当日完成观测。') }}</p>{% if view.comparison_gap %}<p class="msp-warn">{{ t('The comparison date has a missing dealer-chain reading. Do not treat its dealer transition as a verified day-over-day change.','对比日期缺少做市商期权链读数，不能将做市商状态转换视为已核实的逐日变化。') }}</p>{% endif %}{% for change in view.changes %}<p>{{ t(change.get('note_en') or change.get('label_en') or 'A source state changed; detail is unavailable.',change.get('note_zh') or change.get('label_zh') or '源状态已变化，详细信息暂缺。') }}</p>{% else %}<p>{{ t('No recorded changes are available for this snapshot.','此快照暂无可用的变化记录。') }}</p>{% endfor %}</div></details>
</section>
</div>
{# ── Footer ── #}
<footer class="msp-footer"><p>{{ t('Market context, not buy or sell signals. Systematic-fund figures are model estimates, not observed positions. Read them as direction and scale, not as cash that actually moved. Dealer exposure is reconstructed from options data.','仅供市场环境参考，并非买卖信号。系统化资金数据为模型估计，并非观测到的实际持仓；请将其视为方向和量级参考，而非真实成交资金。做市商敞口根据期权数据重建。') }} {% if view.built %}{{ t('Built','构建于') }} {{ view.built }}.{% endif %}</p><a href="#market-structure">{{ t('Back to overview','返回概览') }} ↑</a></footer>
<noscript><p class="msp-empty">{{ t('Interactive charts require JavaScript. Open the observation tables above for the latest exact values.','交互图表需要 JavaScript。可打开上方观测数据表查看最近的精确读数。') }}</p></noscript>
</main>
<script type="application/json" id="msp-chart-data">{{ chart_data|tojson }}</script>
</body></html>
