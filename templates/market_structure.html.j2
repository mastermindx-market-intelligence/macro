{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{# Ordinal suffix — extracted so the hero cannot regress to "1th"/"3th"/"21th". #}
{% macro ord_n(n) -%}
{%- set _pc = n|float|round|int -%}
{%- set _ord = 'th' if (_pc % 100) in [11, 12, 13] else {1: 'st', 2: 'nd', 3: 'rd'}.get(_pc % 10, 'th') -%}
{{- _pc -}}{{- _ord -}}
{%- endmacro %}
{# Empty-chip field names — name the key that changed, never a generic hole. #}
{% macro field_en(key) -%}
{%- if key == 'gamma_regime' -%}Dealer gamma regime
{%- elif key == 'vc_state' -%}Vol-control funds
{%- elif key == 'cta_state' -%}Trend-following funds
{%- elif key == 'agreement' -%}Machine-money agreement
{%- elif key == 'rv_cross_state' -%}Vol weather
{%- elif key == 'cor1m_regime' -%}Stock-picker conditions
{%- else -%}A structure field
{%- endif -%}
{%- endmacro %}
{% macro field_zh(key) -%}
{%- if key == 'gamma_regime' -%}庄家伽马机制
{%- elif key == 'vc_state' -%}波动率控制基金
{%- elif key == 'cta_state' -%}趋势跟踪基金
{%- elif key == 'agreement' -%}机器资金共识
{%- elif key == 'rv_cross_state' -%}波动率天气
{%- elif key == 'cor1m_regime' -%}选股行情
{%- else -%}一项结构字段
{%- endif -%}
{%- endmacro %}
