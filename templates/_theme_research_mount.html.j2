{# templates/_theme_research_mount.html.j2 — T10b semiconductor vertical partial.

  THE SEMICONDUCTOR mount. Wraps the generic theme-research client (CSS + JS +
  DOM hook) and renders it ONLY when the render context provides a non-empty
  `theme_research_anchor` matching `^[a-z0-9_]+$` (the canonical theme id
  grammar). Absent or invalid → emits nothing at all.

  Laws:
    L4 — `theme_research_anchor` absent/empty → silent (no mount, no assets).
    L5 — Mount shape, asset URLs, slice list, API paths, hidden attribute and
         bilingual title/note are pinned verbatim from the reviewed f53c7c3845b3
         lane (T10 part 1). Basket pages live under site/basket/, hence the
         `../assets/...` prefix; the section stays hidden until an entitled
         client response unhides it.
    L6 — Every visible string flows through `t('en','zh')`; no raw slug.
    L7 — No analytical data, payload, figure, token or URL beyond the two
         declared asset paths and the two API paths.
#}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% set _a = theme_research_anchor %}
{% if _a %}
  {% set _ok = namespace(value=1) %}
  {% for _c in _a %}
    {% if _c not in 'abcdefghijklmnopqrstuvwxyz0123456789_' %}
      {% set _ok.value = 0 %}
    {% endif %}
  {% endfor %}
  {% if _ok.value == 1 %}
{# — L5 mount shape: hidden, bilingual, no payload, no fetch at render time — #}
<link rel="stylesheet" href="../assets/css/theme-research.css">
<section class="theme-research" id="theme-research" data-theme-research-mount data-anchor-theme-id="{{ _a }}" data-slices="hbm_packaging,sic_gan_specialty" data-api-query="/api/themes/v1/research/query" data-api-evidence="/api/themes/v1/research/evidence" hidden aria-labelledby="theme-research-title">
  <h2 id="theme-research-title" class="theme-research-title">{{ t('Semiconductor industry research', '半导体产业研究') }}</h2>
  <p class="theme-research-note">{{ t('Paid research context for members. Nothing here ranks, gates, sizes or times anything.', '会员研究内容。此处内容不构成排序、准入、仓位或时机判断。') }}</p>
</section>
<script defer src="../assets/js/theme-research.js?v=20260924a"></script>
  {% endif %}
{% endif %}
