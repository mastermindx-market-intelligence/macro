{% extends "report_base.html.j2" %}

{# XG-W7: no X follow line on the China desks — x.com is unreachable behind
   the GFW, so the CTA would be a dead link for this page's core audience. #}
{% block foot_social %}{% endblock %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}
{% macro bl(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}

{% block title %}PBoC & Policy Watch — Macro Dashboard{% endblock %}

{%- block head_extra %}
{% set seo_title = "China Policy Watch & National Team Radar — Mastermind" %}
{% set seo_desc = "Is Beijing's hand on the market? A live read on state intervention — the national team's ETF footprint, rescue impulse, and PBoC stance for A-shares. Updated daily." %}
{% set seo_path = "china_policy_watch.html" %}
{%- include "_seo_head.html.j2" %}
{%- endblock %}

{% block base_css %}
  /* ===== China Policy Watch — mx5 glass, scoped to .pw (self-contained; no shared-file edits) ===== */
  .pw{position:relative;z-index:1;max-width:1080px;margin:0 auto;
    --mx5-glass-bg:rgba(16,22,30,.55); --mx5-glass-border:rgba(255,255,255,.12);
    --mx5-pop-bg:rgba(13,18,26,.97);
    --sh-accent:var(--muted); --sh-glow:color-mix(in srgb,var(--muted) 22%,transparent);
  }
  [data-theme="light"] .pw{ --mx5-glass-bg:rgba(255,255,255,.82); --mx5-glass-border:rgba(0,0,0,.06); --mx5-pop-bg:rgba(255,255,255,.98); }
  /* State-Hand accent = NON-flipping intensity tokens (act/warn/ok/muted). Never --up/--down. */
  .pw.sh-act  { --sh-accent:var(--act);   --sh-glow:color-mix(in srgb,var(--act) 32%,transparent); }
  .pw.sh-warn { --sh-accent:var(--warn);  --sh-glow:color-mix(in srgb,var(--warn) 32%,transparent); }
  .pw.sh-ok   { --sh-accent:var(--ok);    --sh-glow:color-mix(in srgb,var(--ok) 30%,transparent); }
  .pw.sh-muted{ --sh-accent:var(--muted); --sh-glow:color-mix(in srgb,var(--muted) 22%,transparent); }

  /* aurora — auto-tints to the pressure accent */
  .pw .aurora{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden}
  .pw .aurora::before{content:"";position:absolute;top:-220px;left:10%;width:820px;height:560px;border-radius:50%;filter:blur(90px);background:radial-gradient(ellipse,color-mix(in srgb,var(--sh-accent) 13%,transparent) 0%,transparent 70%)}
  .pw .aurora::after{content:"";position:absolute;bottom:-120px;right:-100px;width:680px;height:600px;border-radius:50%;filter:blur(90px);background:radial-gradient(ellipse,rgba(99,102,241,.09) 0%,transparent 70%)}
  [data-theme="light"] .pw .aurora::before{background:radial-gradient(ellipse,color-mix(in srgb,var(--sh-accent) 6%,transparent) 0%,transparent 70%)}
  [data-theme="light"] .pw .aurora::after{background:radial-gradient(ellipse,rgba(99,102,241,.04) 0%,transparent 70%)}

  .pw .cnx-card{background:var(--mx5-glass-bg);border:1px solid var(--mx5-glass-border);border-radius:18px;backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);box-shadow:0 8px 32px rgba(0,0,0,.4),0 1.5px 0 rgba(255,255,255,.06) inset;padding:18px 20px;margin-bottom:14px}
  [data-theme="light"] .pw .cnx-card{box-shadow:0 4px 24px rgba(0,0,0,.08),0 1px 0 rgba(255,255,255,.9) inset}
  .pw .cnx-ctitle{font-size:11.5px;font-weight:650;letter-spacing:.8px;text-transform:uppercase;color:var(--text);margin:0 0 12px;display:flex;align-items:center;gap:8px}
  .pw .cnx-ctitle .sub{font-weight:500;letter-spacing:.02em;text-transform:none;color:var(--muted);font-size:11px}

  /* hero */
  .pw .pw-hero-head{margin:6px 2px 12px}
  .pw .pw-eyebrow{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--sh-accent);font-weight:700;margin:0 0 5px}
  .pw .pw-hero-head h1{font-size:27px;margin:0 0 4px;letter-spacing:-.01em;font-weight:800}
  html[data-lang="zh"] .pw .pw-hero-head h1{letter-spacing:0}
  .pw .pw-hero-head .lens{font-size:12px;color:var(--muted)}
  .pw .sh-hero{display:grid;grid-template-columns:minmax(320px,1fr) minmax(360px,1.1fr);gap:0;padding:0;position:relative;z-index:30;overflow:visible}
  .pw .sh-hero-left{padding:20px 24px;border-right:1px solid var(--mx5-glass-border);position:relative}
  .pw .sh-hero-right{padding:18px 22px}
  @media(max-width:720px){.pw .sh-hero{grid-template-columns:1fr}.pw .sh-hero-left{border-right:0;border-bottom:1px solid var(--mx5-glass-border)}}

  .pw .sh-regime-pill{display:inline-flex;align-items:center;gap:7px;border:1px solid color-mix(in srgb,var(--sh-accent) 40%,var(--mx5-glass-border));border-radius:999px;padding:4px 12px;font-size:11.5px;font-weight:600;background:color-mix(in srgb,var(--sh-accent) 10%,transparent);color:var(--sh-accent)}
  .pw .sh-regime-pill .dot{width:8px;height:8px;border-radius:50%;background:var(--sh-accent);box-shadow:0 0 7px var(--sh-glow);position:relative}
  .pw .sh-regime-pill .dot::after{content:"";position:absolute;inset:-3px;border-radius:50%;border:1px solid var(--sh-accent);opacity:0;animation:shPulse 3.6s ease-in-out infinite}
  @keyframes shPulse{0%,100%{opacity:0;transform:scale(.8)}50%{opacity:.6;transform:scale(1.5)}}
  @media(prefers-reduced-motion:reduce){.pw .sh-regime-pill .dot::after{animation:none}}
  @media(pointer:coarse){.pw .sh-regime-pill .dot::after{animation:none}}

  .pw .sh-gauge-row{display:flex;gap:16px;align-items:center;margin:14px 0 12px}
  .pw .sh-gauge-svg{flex:0 0 176px;width:176px;height:110px;overflow:visible;display:block}
  @media(max-width:560px){.pw .sh-gauge-svg{width:120px;height:76px;flex:0 0 120px}}
  .pw .sh-gauge-fill{stroke:var(--sh-accent);transition:stroke .3s}
  .pw .sh-numeral{fill:var(--sh-accent)}
  .pw .sh-needle-hub{fill:var(--panel,#0e1013);stroke:var(--sh-accent);stroke-width:1.5}
  .pw .sh-needle-core,.pw .sh-needle-tip{fill:var(--sh-accent)}
  .pw .sh-needle-tip{filter:drop-shadow(0 0 3.5px var(--sh-accent))}
  /* theme.css owns the light pointer; policy-watch supplies its direction-neutral
     pressure-state accent through --sh-accent. */
  .pw .sh-score-line{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap}
  .pw .sh-big{font-size:60px;font-weight:800;line-height:.9;letter-spacing:-.035em;font-variant-numeric:tabular-nums;color:var(--sh-accent);text-shadow:0 0 34px var(--sh-glow)}
  @media(max-width:560px){.pw .sh-big{font-size:40px}}
  .pw .sh-verdict{font-size:16px;font-weight:700;color:var(--text);white-space:nowrap}
  .pw .sh-sub{font-size:11.5px;font-weight:650;letter-spacing:.3px;color:var(--sh-accent);margin-top:4px}
  .pw .sh-stance{font-size:13px;line-height:1.6;color:var(--text);max-width:46ch;margin:6px 0 12px}
  .pw .sh-hero-btns{display:flex;gap:8px;flex-wrap:wrap;position:relative}
  .pw .sh-hbtn{background:rgba(255,255,255,.05);border:1px solid var(--mx5-glass-border);color:var(--text);border-radius:999px;padding:5px 13px;font-size:11.5px;font-weight:600;cursor:pointer;display:inline-flex;gap:6px;align-items:center;transition:background .15s,border-color .15s}
  [data-theme="light"] .pw .sh-hbtn{background:rgba(0,0,0,.03)}
  .pw .sh-hbtn:hover{background:color-mix(in srgb,var(--sh-accent) 12%,transparent);border-color:color-mix(in srgb,var(--sh-accent) 45%,var(--mx5-glass-border))}

  /* tell-stack (how we know) */
  .pw .sh-stack-h{font-size:10.5px;font-weight:700;letter-spacing:.9px;text-transform:uppercase;color:var(--muted);margin:0 0 4px}
  .pw .sh-tier{display:flex;align-items:baseline;gap:8px;margin:13px 0 3px}
  .pw .sh-tier:first-of-type{margin-top:2px}
  .pw .sh-tier-k{font-size:10.5px;font-weight:700;letter-spacing:.7px;text-transform:uppercase;color:var(--text)}
  .pw .sh-tier-c{font-size:10.5px;color:var(--muted)}
  .pw .sh-tell{display:flex;gap:10px;align-items:flex-start;padding:5px 0}
  .pw .sh-dot{flex:0 0 9px;width:9px;height:9px;border-radius:50%;margin-top:4px;border:1.5px solid var(--muted);background:transparent}
  .pw .sh-dot-firing{background:var(--sh-accent);border-color:var(--sh-accent);box-shadow:0 0 7px var(--sh-glow)}
  .pw .sh-dot-quiet{border-color:var(--muted);background:transparent}
  .pw .sh-dot-null{border-style:dashed;border-color:color-mix(in srgb,var(--muted) 55%,transparent)}
  .pw .sh-tell-txt{flex:1;min-width:0}
  .pw .sh-tell-top{display:flex;gap:8px;align-items:baseline;justify-content:space-between}
  .pw .sh-tell-label{font-size:12.5px;font-weight:600;color:var(--text)}
  .pw .sh-tell.is-null .sh-tell-label{color:var(--muted);font-weight:500}
  .pw .sh-tell-val{font-size:11.5px;font-weight:700;color:var(--sh-accent);font-variant-numeric:tabular-nums;white-space:nowrap}
  .pw .sh-tell-rc{font-size:11.5px;line-height:1.4;color:var(--muted);margin-top:1px}

  /* popover — Tier-2 receipts */
  .pw .sh-pop{position:absolute;top:calc(100% + 10px);left:0;width:min(340px,86vw);background:var(--mx5-pop-bg);border:1px solid var(--mx5-glass-border);border-radius:16px;box-shadow:0 24px 60px rgba(0,0,0,.55);padding:16px 18px;z-index:60;display:none}
  .pw .sh-pop.open{display:block;animation:shPopIn .18s ease-out}
  @keyframes shPopIn{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}
  @media(prefers-reduced-motion:reduce){.pw .sh-pop.open{animation:none}}
  .pw .sh-pop-h{font-size:10.5px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:var(--text);margin-bottom:12px}
  .pw .sh-prow{margin:9px 0}
  .pw .sh-prow-t{display:flex;justify-content:space-between;gap:8px;font-size:12px;margin-bottom:4px}
  .pw .sh-prow-t b{font-weight:650}
  .pw .sh-prow-t .st{font-size:10px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--muted)}
  .pw .sh-prow-t .st.on{color:var(--sh-accent)}
  .pw .sh-pbar{height:4px;border-radius:3px;background:rgba(255,255,255,.08);overflow:hidden}
  [data-theme="light"] .pw .sh-pbar{background:rgba(0,0,0,.08)}
  .pw .sh-pbar i{display:block;height:100%;border-radius:3px;background:var(--sh-accent)}
  .pw .sh-prow-rc{font-size:11px;color:var(--muted);margin-top:3px}
  .pw .sh-pop-flag{font-size:9.5px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:var(--ink-warn, var(--warn));margin:12px 0 4px}
  .pw .sh-pop-note{font-size:11px;line-height:1.5;color:var(--muted);margin-top:10px;border-top:1px solid var(--mx5-glass-border);padding-top:9px}

  /* pressure history sparkline */
  .pw .sh-spark{margin-top:10px}
  .pw .sh-spark svg{width:100%;height:34px;display:block;overflow:visible}
  .pw .sh-spark .ln{fill:none;stroke:var(--sh-accent);stroke-width:1.6}
  .pw .sh-spark .dot{fill:var(--sh-accent)}

  /* ---- policy context sections (glass-native) ---- */
  .pw .callout{border-radius:12px;padding:12px 15px;margin:0 0 12px;border:1px solid var(--mx5-glass-border);background:rgba(255,255,255,.03);font-size:13px;line-height:1.6}
  [data-theme="light"] .pw .callout{background:rgba(0,0,0,.02)}
  .pw .callout .co-h{font-weight:700;display:block;margin-bottom:3px}
  .pw .callout.key{border-left:3px solid var(--ok)}
  .pw .callout.warn{border-left:3px solid var(--warn)}
  .pw .stale-chip{display:inline-flex;align-items:center;gap:6px;font-size:11px;color:var(--muted);border:1px solid var(--mx5-glass-border);border-radius:999px;padding:3px 10px}
  .pw .stale-chip.old{color:var(--ink-warn, var(--warn));border-color:color-mix(in srgb,var(--warn) 40%,var(--mx5-glass-border))}
  .pw .stance-hero{display:flex;flex-wrap:wrap;gap:13px;align-items:center;margin:2px 0 4px}
  .pw .stance-badge{font-size:20px;font-weight:800;padding:5px 15px;border-radius:999px}
  .pw .st-easing{color:#1f9a55;background:color-mix(in srgb,#1f9a55 15%,transparent)}
  .pw .st-tightening{color:#d23f3f;background:color-mix(in srgb,#d23f3f 15%,transparent)}
  html[data-lang="zh"] .pw .st-easing{color:#d23f3f;background:color-mix(in srgb,#d23f3f 15%,transparent)}
  html[data-lang="zh"] .pw .st-tightening{color:#1f9a55;background:color-mix(in srgb,#1f9a55 15%,transparent)}
  .pw .st-neutral,.pw .st-on_hold{color:var(--muted);background:rgba(255,255,255,.05)}
  .pw .stance-hero .why{font-size:12.5px;color:var(--muted);flex:1;min-width:220px}
  .pw .mgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin:2px 0}
  .pw .metric{background:rgba(255,255,255,.03);border:1px solid var(--mx5-glass-border);border-radius:12px;padding:11px 13px}
  [data-theme="light"] .pw .metric{background:rgba(0,0,0,.02)}
  .pw .metric .k{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
  .pw .metric .v{font-size:20px;font-weight:750;margin-top:3px;font-variant-numeric:tabular-nums}
  .pw .metric .s{font-size:10.5px;color:var(--muted);margin-top:2px}
  .pw .moves{list-style:none;padding:0;margin:4px 0 0}
  .pw .moves li{font-size:12.5px;padding:6px 0;border-bottom:1px solid var(--mx5-glass-border);display:flex;gap:10px}
  .pw .moves li:last-child{border-bottom:0}
  .pw .moves .dt{color:var(--muted);font-variant-numeric:tabular-nums;min-width:90px}
  .pw .ease{color:#1f9a55}.pw .tighten{color:#d23f3f}
  html[data-lang="zh"] .pw .ease{color:#d23f3f}html[data-lang="zh"] .pw .tighten{color:#1f9a55}
  .pw table.pwd{border-collapse:collapse;width:100%;font-size:12.5px;margin:2px 0 0}
  .pw table.pwd th{text-align:left;padding:7px 9px;color:var(--muted);font-weight:600;border-bottom:1px solid var(--mx5-glass-border)}
  .pw table.pwd td{padding:7px 9px;border-bottom:1px solid var(--mx5-glass-border);vertical-align:top}
  .pw table.pwd tr:last-child td{border-bottom:0}
  .pw .pill{font-size:10px;font-weight:700;padding:2px 8px;border-radius:6px;white-space:nowrap}
  .pw .p-supportive{color:#1f9a55;background:color-mix(in srgb,#1f9a55 14%,transparent)}
  .pw .p-restrictive{color:#d23f3f;background:color-mix(in srgb,#d23f3f 14%,transparent)}
  html[data-lang="zh"] .pw .p-supportive{color:#d23f3f;background:color-mix(in srgb,#d23f3f 14%,transparent)}
  html[data-lang="zh"] .pw .p-restrictive{color:#1f9a55;background:color-mix(in srgb,#1f9a55 14%,transparent)}
  .pw .p-neutral,.pw .p-open{color:var(--muted);background:rgba(255,255,255,.06)}
  .pw .chips{display:flex;flex-wrap:wrap;gap:7px;margin:2px 0 0}
  .pw .nchip{font-size:12px;padding:4px 11px;border-radius:999px;background:rgba(255,255,255,.04);border:1px solid var(--mx5-glass-border)}
  .pw .nchip b{color:var(--sh-accent)}
  .pw .feed{list-style:none;padding:0;margin:2px 0 0}
  .pw .feed li{padding:8px 0;border-bottom:1px solid var(--mx5-glass-border);display:flex;gap:10px;align-items:flex-start}
  .pw .feed li:last-child{border-bottom:0}
  .pw .feed .tag{font-size:10px;font-weight:700;padding:2px 7px;border-radius:6px;background:rgba(255,255,255,.05);border:1px solid var(--mx5-glass-border);white-space:nowrap;min-width:72px;text-align:center}
  .pw .feed .tt{font-size:13px;line-height:1.45}
  .pw .feed .tt a{color:var(--text)}.pw .feed .tt a:hover{color:var(--ink-link, var(--link))}
  .pw .disc{font-size:11px;color:var(--muted);margin-top:14px;line-height:1.55}
  .pw .empty{margin:12px 0 0;font-size:14px;line-height:1.5;color:var(--text);font-weight:500}
  .pw .empty-why{margin:6px 0 0;font-size:12px;line-height:1.45;color:var(--muted)}
  .pw .warming{border-radius:14px;border:1px solid var(--mx5-glass-border);background:rgba(255,255,255,.03);padding:16px 18px;font-size:13px;color:var(--muted)}
  .pw .pw-hero-meta{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:2px 0 0}
  .pw .dtp-asof,.pw .dtp{display:inline-flex;align-items:center;gap:6px;font-size:11px;color:var(--muted);border:1px solid var(--mx5-glass-border);border-radius:999px;padding:3px 10px;font-weight:500;letter-spacing:0;text-transform:none;white-space:nowrap}
  .pw .cnx-ctitle .dtp{margin-left:auto;font-weight:500}
  .pw .pw-table-scroll{display:block;overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch}
  .pw .pw-table-scroll .pw-table-inner{min-width:520px;width:max-content}
  .pw .pw-backdrop{margin-top:16px;padding:14px 14px 4px;border:1px solid var(--mx5-glass-border);border-radius:14px;background:rgba(255,255,255,.03)}
  [data-theme="light"] .pw .pw-backdrop{background:rgba(255,255,255,.72);box-shadow:0 1px 0 rgba(255,255,255,.9) inset,0 6px 18px rgba(15,23,42,.06)}
  .pw .pw-backdrop .co-h{font-size:11.5px;letter-spacing:.04em;text-transform:uppercase}
  .pw .pw-backdrop .pw-stance{font-size:13px;line-height:1.55;color:var(--text);margin:0 0 10px}
  .pw .pw-see-all{margin:10px 0 0;font-size:12.5px}
  .pw .pw-see-all a{color:var(--ink-link, var(--link));font-weight:600}
  .pw .pw-baskets{font-size:10px;color:var(--muted)}
  .pw .metric .k{display:flex;align-items:center;gap:4px}
  .pw .pw-sector-all{margin-top:12px;border-top:1px dashed var(--mx5-glass-border);padding-top:10px}
  .pw .pw-sector-all summary{cursor:pointer;font-size:12.5px;color:var(--muted);font-weight:600}
  .pw .feed li{flex-wrap:wrap}
  .pw .pw-deep{margin:8px 0 4px;font-size:12px}
  .pw .pw-deep a{color:var(--ink-link, var(--link));font-weight:600}
{% endblock %}

{% block content %}
{% set nt = pw.national_team if pw else None %}
{% set acc = (nt.pressure.accent if nt else 'muted') %}
<div class="pw sh-{{ acc }}">
  <div class="aurora" aria-hidden="true"></div>

  <div class="pw-hero-head">
    <p class="pw-eyebrow">🇨🇳 {{ t('National Team Radar', '国家队雷达') }}</p>
    <h1>{{ t('China Policy &amp; State-Hand Watch', '中国政策与国家队监测') }}</h1>
    <p class="lens" data-ev="subtitle">{{ t('Is Beijing defending the market right now?', '北京此刻是否在护盘？') }}</p>
    <div class="pw-hero-meta">
      <span class="dtp-asof">{{ t('as of', '截至') }} {{ pw.asof if pw else '—' }}</span>
    </div>
  </div>

{% if not pw %}
  <div class="warming">{{ t('Policy data is still warming up — this page populates after the first collect + build cycle.', '政策数据仍在预热——本页将在首次采集与构建周期后填充。') }}</div>
{% else %}

  <!-- ============ SIGNATURE: National Team Radar ============ -->
  {% if nt %}
  {% set p = nt.pressure %}
  {% set arc_len = 175.93 %}
  {% set filled = (p.score / 100 * arc_len) | round(1) %}
  {% set gap = (arc_len - filled) | round(1) %}
  {% set needle = (p.score / 100 * 180 - 90) | round(1) %}
  <div class="cnx-card sh-hero" data-l1="hero">
    <div class="sh-hero-left">
      <span class="sh-regime-pill"><span class="dot"></span>{{ bl(p.band_en, p.band_zh) }} · {{ t('state-hand watch', '国家队监测') }}</span>
      <div class="sh-gauge-row">
        <svg class="sh-gauge-svg" viewBox="0 -4 140 101" fill="none"
             role="img" aria-label="{{ p.band_en }} — State-Hand pressure {{ p.score }} of 100">
          <defs>
            <filter id="shNeedleGlow" x="-80%" y="-80%" width="260%" height="260%"><feGaussianBlur stdDeviation="2.5" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
            <filter id="shArcGlow" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          </defs>
          <path d="M 14 75 A 56 56 0 0 1 126 75" stroke="rgba(255,255,255,.08)" stroke-width="10" stroke-linecap="round" fill="none"/>
          <path class="sh-gauge-fill" d="M 14 75 A 56 56 0 0 1 126 75" stroke-width="10" stroke-linecap="round" fill="none" stroke-dasharray="{{ filled }} {{ gap }}" filter="url(#shArcGlow)"/>
          <g stroke="rgba(255,255,255,.20)" stroke-width="1.2">
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(-90 70 75)"/>
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(-45 70 75)"/>
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(0 70 75)"/>
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(45 70 75)"/>
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(90 70 75)"/>
          </g>
          <text x="14" y="95" fill="rgba(255,255,255,.26)" font-size="11" text-anchor="middle" font-family="Inter,sans-serif">0</text>
          <text x="70" y="10" fill="rgba(255,255,255,.26)" font-size="11" text-anchor="middle" font-family="Inter,sans-serif">50</text>
          <text x="126" y="95" fill="rgba(255,255,255,.26)" font-size="11" text-anchor="middle" font-family="Inter,sans-serif">100</text>
          <g class="sh-needle odo-needle odo-needle--compact" style="--odo-accent:var(--sh-accent)" transform="rotate({{ needle }} 70 75)" filter="url(#shNeedleGlow)">
            <line x1="70" y1="75" x2="70" y2="24" stroke="rgba(255,255,255,.30)" stroke-width="5" stroke-linecap="round"/>
            <polygon points="69,75 71,75 70.5,24 69.5,24" fill="white" opacity=".94"/>
            <circle cx="70" cy="75" r="7" fill="rgba(255,255,255,.10)"/>
            <circle class="sh-needle-hub odo-needle-hub" cx="70" cy="75" r="4.5"/>
            <circle class="sh-needle-core" cx="70" cy="75" r="2"/>
            <circle class="sh-needle-tip" cx="70" cy="25.5" r="2.5"/>
          </g>
          <text class="sh-numeral" x="70" y="62" font-size="24" font-weight="800" text-anchor="middle" font-family="Inter,sans-serif">{{ p.score }}</text>
          <text x="70" y="73" fill="rgba(255,255,255,.32)" font-size="11" text-anchor="middle" font-family="Inter,sans-serif">/ 100</text>
        </svg>
        <div>
          <div class="sh-score-line"><span class="sh-big">{{ p.score }}</span></div>
          <div class="sh-verdict">{{ bl(p.band_en, p.band_zh) }}</div>
          <div class="sh-sub">{{ t('State-Hand pressure', '国家队干预压力') }} · {{ nt.tell_counts.firing }}/{{ nt.tell_counts.total }} {{ t('tells firing', '迹象点亮') }}</div>
          {% if nt.asof_inputs %}
          <p style="margin:8px 0 0"><span class="stale-chip {{ 'old' if nt.stale }}">{{ t('State-hand inputs', '国家队输入') }} · {{ nt.asof_inputs }}{% if nt.age_days is not none %} · {{ nt.age_days }}{{ t('d ago', '日前') }}{% endif %}{% if nt.stale %} · {{ t('may be stale', '可能过时') }}{% endif %}</span></p>
          {% endif %}
        </div>
      </div>
      <p class="sh-stance">{{ bl(nt.stance.en, nt.stance.zh) }}</p>
      <div class="sh-hero-btns">
        <button class="sh-hbtn" onclick="shPop('sh-pop-receipts',event)">⌁ {{ t('Receipts &amp; method', '依据与方法') }}</button>
        {% if nt.history and nt.history|length >= 2 %}
        {% set hmax = 100 %}
        <div class="sh-spark" style="flex-basis:100%">
          <svg viewBox="0 0 200 34" preserveAspectRatio="none" aria-hidden="true">
            {% set n = nt.history|length %}
            {% set pts = [] %}
            {% for h in nt.history %}{% set _ = pts.append('%s,%s'|format((loop.index0/(n-1)*198+1)|round(1), (32 - (h.score/hmax*30))|round(1))) %}{% endfor %}
            <polyline class="ln" points="{{ pts|join(' ') }}"/>
            {% set last = nt.history[-1] %}
            <circle class="dot" cx="199" cy="{{ (32 - (last.score/hmax*30))|round(1) }}" r="2.4"/>
          </svg>
        </div>
        {% endif %}

        <div class="sh-pop" id="sh-pop-receipts" onclick="event.stopPropagation()">
          <div class="sh-pop-h">{{ t('Detection receipts', '检测依据') }} — {{ nt.tell_counts.firing }}/{{ nt.tell_counts.total }} {{ t('firing', '点亮') }}</div>
          {% for tl in nt.tells %}
          <div class="sh-prow">
            <div class="sh-prow-t"><b>{{ bl(tl.label_en, tl.label_zh) }}</b><span class="st {{ 'on' if tl.state=='firing' else '' }}">{{ t('firing','点亮') if tl.state=='firing' else (t('null','无') if tl.state=='null' else t('quiet','平静')) }}</span></div>
            <div class="sh-pbar"><i style="width:{{ (tl.strength*100)|round|int }}%"></i></div>
            <div class="sh-prow-rc">{% if tl.state=='null' %}{{ t('No reading — data not yet available.', '暂无读数——数据尚未具备。') }}{% else %}{{ bl(tl.receipt_en, tl.receipt_zh) }}{% endif %}</div>
          </div>
          {% endfor %}
          {% if nt.gaps %}
          <div class="sh-pop-flag">{{ t('Data limits', '数据限制') }}</div>
          <div class="sh-prow-rc">{{ nt.gaps|join(' · ') }}</div>
          {% endif %}
          <div class="sh-pop-note">{{ t('Context only — a read on whether the state is defending the market, not a buy signal. State intervention is loud by design; this fuses its public footprint (ETF creation, policy impulse, index-heavyweight lift) into one intensity gauge. Nulls are shown, not hidden.', '仅供参考——用以判断国家队是否在护盘，并非买入信号。国家干预本就高调；本表将其公开足迹（ETF份额创设、政策脉冲、权重股护指数）汇成一个强度读数。空值如实显示，不予隐藏。') }}</div>
        </div>
      </div>
    </div>

    <div class="sh-hero-right">
      <p class="sh-stack-h">{{ t('How we read the hand', '我们如何读国家队之手') }}</p>
      {% for tier, cap_en, cap_zh in [('leading', 'before the buying', '买入之前'), ('coincident', 'during — the fingerprint', '买入期间——指纹'), ('confirming', 'after — the relay', '之后——接力')] %}
      <div class="sh-tier"><span class="sh-tier-k">{{ t(tier|capitalize, ({'leading':'先行','coincident':'同步','confirming':'确认'})[tier]) }}</span><span class="sh-tier-c">{{ t(cap_en, cap_zh) }}</span></div>
      {% for tl in nt.tells if tl.tier == tier %}
      <div class="sh-tell {{ 'is-null' if tl.state=='null' }}" data-ev="tell-{{ tl.key }}">
        <span class="sh-dot sh-dot-{{ tl.state }}"></span>
        <div class="sh-tell-txt">
          <div class="sh-tell-top">
            <span class="sh-tell-label">{{ bl(tl.label_en, tl.label_zh) }}</span>
            {% if tl.value_fmt_en or tl.value_fmt_zh or tl.value_fmt %}<span class="sh-tell-val">{{ bl(tl.value_fmt_en or tl.value_fmt, tl.value_fmt_zh or tl.value_fmt_en or tl.value_fmt) }}</span>{% endif %}
          </div>
          <div class="sh-tell-rc">{% if tl.state=='null' %}{{ t('No reading yet', '暂无读数') }}{% else %}{{ bl(tl.receipt_en, tl.receipt_zh) }}{% endif %}</div>
        </div>
      </div>
      {% endfor %}
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <!-- curated policy thesis + NPC chips (NPC demoted here from its own L1 card) -->
  {% if pw.intel and pw.intel.thesis %}
  <div class="cnx-card" data-l1="thesis">
    <div class="callout key" style="margin-bottom:10px"><span class="co-h">{{ t('The policy thesis', '政策核心论点') }}</span>{{ bl(pw.intel.thesis.en, pw.intel.thesis.zh) }}</div>
    {% if pw.intel.regime_read %}<div class="callout warn" style="margin-bottom:10px"><span class="co-h">{{ t('How to read it', '如何解读') }}</span>{{ bl(pw.intel.regime_read.en, pw.intel.regime_read.zh) }}</div>{% endif %}
    {% if pw.intel.npc_targets_2026 %}
    <div class="chips" data-landing="npc-2026">
      {% for tg in pw.intel.npc_targets_2026 %}
      <span class="nchip">{{ bl(tg.label_en, tg.label_zh) }} <b>{{ bl(tg.value_en or tg.value, tg.value_zh or tg.value) }}</b></span>
      {% endfor %}
    </div>
    {% endif %}
    {% set id = pw.intel_dates if pw.intel_dates else {} %}
    {% set st = id.staleness if id.staleness else {} %}
    {% if st.as_of %}
    <p style="margin:12px 0 0"><span class="stale-chip {{ 'old' if st.stale }}">{{ t('Intel substrate', '情报底稿') }} · {{ st.as_of }}{% if st.age_days is not none %} · {{ st.age_days }}{{ t('d ago', '日前') }}{% endif %}{% if st.stale %} · {{ t('may be stale', '可能过时') }}{% endif %}</span></p>
    {% endif %}
  </div>
  {% endif %}

  <!-- PBoC stance + corridor; FX/NBS nested as China macro backdrop (not a peer L1 card) -->
  {% set _ctips = {
    'fr007': ('FR007 is the 7-day repo fixing — the PBoC money-market heartbeat.', 'FR007是7天期回购定盘利率，央行货币市场的心跳。'),
    'shibor_on': ('SHIBOR O/N is the overnight Shanghai interbank offered rate.', '隔夜SHIBOR是上海银行间同业拆放隔夜利率。'),
    'shibor_3m': ('SHIBOR 3M is the 3-month Shanghai interbank offered rate.', '3个月SHIBOR是上海银行间同业拆放3个月利率。'),
    'rrr': ('RRR is the reserve requirement ratio for large banks. The why-line uses an 18-month cumulative window.', '存准率是大型银行存款准备金率。立场说明使用18个月累计窗口。'),
    'lpr_1y': ('1-year loan prime rate — the PBoC policy benchmark for most new loans.', '1年期贷款市场报价利率，多数新发放贷款的政策基准。'),
    'lpr_5y': ('5-year loan prime rate — the mortgage benchmark.', '5年期贷款市场报价利率，房贷定价基准。')
  } %}
  {% if pw.pboc %}
  <div class="cnx-card" data-l1="pboc">
    <div class="cnx-ctitle">🪙 {{ t('PBoC stance &amp; rate corridor', '央行立场与利率走廊') }}{% if pw.pboc_asof %} <span class="dtp">{{ t('as of', '截至') }} {{ pw.pboc_asof }}</span>{% endif %}</div>
    <div class="stance-hero">
      <span class="stance-badge st-{{ pw.pboc.stance }}">{{ bl(pw.pboc.stance_en, pw.pboc.stance_zh) }}</span>
      <span class="why">{{ bl(pw.pboc.rationale.en, pw.pboc.rationale.zh) }}</span>
    </div>
    <div class="mgrid">
      {% for c in pw.pboc.corridor %}
      <div class="metric">
        <div class="k">{{ bl(c.label_en, c.label_zh) }}{% if c.key in _ctips %} <button class="lens-q" type="button" tabindex="0" aria-label="Explain" data-tip-en="{{ _ctips[c.key][0] }}" data-tip-zh="{{ _ctips[c.key][1] }}">?</button>{% endif %}</div>
        <div class="v">{{ '%.2f'|format(c.value) }}{{ c.unit }}</div>
        {% if c.slice_en or c.window_en %}<div class="s">{% if c.slice_en %}{{ bl(c.slice_en, c.slice_zh) }}{% elif c.window_en %}{{ bl(c.window_en, c.window_zh) }}{% endif %}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% if pw.pboc.last_moves %}
    <ul class="moves">
      {% for m in pw.pboc.last_moves %}
      <li><span class="dt">{{ m.date }}</span><span class="{{ 'ease' if m.easing else 'tighten' }}">{{ bl(m.detail_en, m.detail_zh) }}</span></li>
      {% endfor %}
    </ul>
    {% endif %}

    {% set fx = pw.pboc.fx if pw.pboc.fx else {} %}
    {% if fx or pw.nbs_prints %}
    <div class="pw-backdrop" data-landing="china-macro-backdrop">
      <div class="cnx-ctitle" style="margin-bottom:8px">🌏 {{ t('China macro backdrop', '中国宏观背景') }}{% if pw.backdrop_asof %} <span class="dtp">{{ t('as of', '截至') }} {{ pw.backdrop_asof }}</span>{% endif %}</div>
      {% if pw.nbs_stance_en %}<p class="pw-stance">{{ bl(pw.nbs_stance_en, pw.nbs_stance_zh) }}</p>{% endif %}
      <div class="mgrid">
        {% if fx.reserves %}<div class="metric" data-ev="fx-mom"><div class="k">{{ t('FX reserves', '外汇储备') }}</div><div class="v">${{ (fx.reserves/10000)|round(2) }}T</div><div class="s">{% if fx.reserves_mom %}{{ '%+.1f'|format(fx.reserves_mom/10) }} {{ t('bn MoM', '十亿美元环比') }}{% endif %} · {{ fx.asof_reserves }}</div></div>{% endif %}
        {% if fx.gold %}<div class="metric"><div class="k">{{ t('Gold reserves', '黄金储备') }}</div><div class="v">{{ fx.gold|round(0)|int }}t</div></div>{% endif %}
        {% if fx.usd_cny %}<div class="metric"><div class="k">{{ t('USD / CNY', '美元兑人民币') }}</div><div class="v">{{ '%.3f'|format(fx.usd_cny) }}</div><div class="s">{% if fx.usd_cny_chg_20d is not none %}{{ '%+.3f'|format(fx.usd_cny_chg_20d) }} {{ t('20d', '20日') }}{% endif %} · {{ fx.asof_cny }}</div></div>{% endif %}
        {% for r in pw.nbs_prints %}
        <div class="metric">
          <div class="k">{{ bl(r.label_en, r.label_zh) }}{% if r.key == 'tsf_total' %} <button class="lens-q" type="button" tabindex="0" aria-label="Explain" data-tip-en="TSF is total social financing — the monthly credit pulse across bank and non-bank channels." data-tip-zh="社融是社会融资规模——银行与非银行渠道的当月信用脉冲。">?</button>{% endif %}</div>
          <div class="v">{{ r.value }}{{ r.unit }}</div>
          <div class="s">{% if r.dir_en %}{{ bl(r.dir_en, r.dir_zh) }} · {% endif %}{{ r.asof }}</div>
        </div>
        {% endfor %}
      </div>
      {% set _n_fx = (1 if fx.reserves else 0) + (1 if fx.gold else 0) + (1 if fx.usd_cny else 0) %}
      {% set _n_nbs = pw.nbs_prints|length %}
      <p class="pw-deep"><a href="china.html">{{ t('China desk', '中国桌面') }} →</a> <span class="l-en">{{ _n_fx + _n_nbs }} prints on this card</span><span class="l-zh">本卡 {{ _n_fx + _n_nbs }} 项读数</span></p>
    </div>
    {% endif %}
  </div>
  {% endif %}

  <!-- sector-policy tracker (capped 8; remainder lands in #pw-sector-all) -->
  {% if pw.intel and pw.intel.sector_policy %}
  {% set _sp_all = pw.intel.sector_policy %}
  {% set _sp_n = _sp_all|length %}
  {% set _sp_cap = pw.sector_table_cap if pw.sector_table_cap else 8 %}
  <div class="cnx-card" data-l1="sectors" data-ev="sector-cap">
    <div class="cnx-ctitle">🧭 {{ t('Sector-policy tracker', '行业政策追踪') }}{% if pw.intel.as_of %} <span class="dtp">{{ t('as of', '截至') }} {{ pw.intel.as_of }}</span>{% endif %}</div>
    <div class="pw-table-scroll"><div class="pw-table-inner">
    <table class="pwd">
      <thead><tr><th>{{ t('Sector', '行业') }}</th><th>{{ t('Stance', '立场') }}</th><th>{{ t('Policy read', '政策解读') }}</th></tr></thead>
      <tbody>
      {% for s in _sp_all[:_sp_cap] %}
        <tr>
          <td>{{ bl(s.sector_en, s.sector_zh) }}{% if s.basket_labels %}<br><span class="pw-baskets">{% for b in s.basket_labels %}{{ bl(b.en, b.zh) }}{% if not loop.last %} · {% endif %}{% endfor %}</span> <button class="lens-q" type="button" tabindex="0" aria-label="Explain" data-tip-en="Basket ids: {{ (s.baskets or [])|join(', ') }}" data-tip-zh="篮子编号：{{ (s.baskets or [])|join('、') }}">?</button>{% endif %}</td>
          <td><span class="pill p-{{ s.stance }}">{{ t(s.stance|capitalize, ({'supportive':'支持','restrictive':'限制','neutral':'中性'}).get(s.stance, s.stance)) }}</span></td>
          <td>{{ bl(s.note_en, s.note_zh) }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    </div></div>
    {% if _sp_n > _sp_cap %}
    <p class="pw-see-all"><a href="#pw-sector-all"><span class="l-en">See all {{ _sp_n }} →</span><span class="l-zh">查看全部 {{ _sp_n }} 条 →</span></a></p>
    <details class="pw-sector-all" id="pw-sector-all">
      <summary>{{ t('All sector-policy rows', '全部行业政策') }} ({{ _sp_n }})</summary>
      <div class="pw-table-scroll"><div class="pw-table-inner">
      <table class="pwd">
        <thead><tr><th>{{ t('Sector', '行业') }}</th><th>{{ t('Stance', '立场') }}</th><th>{{ t('Policy read', '政策解读') }}</th></tr></thead>
        <tbody>
        {% for s in _sp_all %}
          <tr>
            <td>{{ bl(s.sector_en, s.sector_zh) }}{% if s.basket_labels %}<br><span class="pw-baskets">{% for b in s.basket_labels %}{{ bl(b.en, b.zh) }}{% if not loop.last %} · {% endif %}{% endfor %}</span>{% endif %}</td>
            <td><span class="pill p-{{ s.stance }}">{{ t(s.stance|capitalize, ({'supportive':'支持','restrictive':'限制','neutral':'中性'}).get(s.stance, s.stance)) }}</span></td>
            <td>{{ bl(s.note_en, s.note_zh) }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      </div></div>
    </details>
    {% endif %}
  </div>
  {% endif %}

  <!-- policy tape -->
  <div class="cnx-card" data-l1="tape">
    <div class="cnx-ctitle">📰 {{ t('Policy tape', '政策快讯') }}</div>
    {% if pw.policy_feed %}
    <ul class="feed">
      {% for it in pw.policy_feed %}
      <li{% if loop.first %} data-ev="tape-row"{% endif %}>
        {% if it.source_chip %}<span class="tag">{{ it.source_chip }}</span>{% endif %}
        <span class="tag">{{ bl(it.theme_en, it.theme_zh) }}</span>
        <div class="tt">
          {% if it.url %}<a href="{{ it.url }}" target="_blank" rel="noopener">{{ it.title }}</a>{% else %}{{ it.title }}{% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
    {% elif pw.policy_feed_status == 'unavailable' %}
    <p class="empty">{{ t("Policy tape unavailable right now — source didn't load", '政策快讯暂不可用——数据源未加载') }}</p>
    <p class="empty-why">{{ t('This is a missing source, not a quiet tape. Other panels on this page are still current.', '这是数据源未加载，不是快讯为空。本页其他栏目仍为最新。') }}</p>
    {% else %}
    <p class="empty">{{ t('No China official policy items on the tape right now.', '当前暂无中国官方政策快讯。') }}</p>
    <p class="empty-why">{{ t('This desk only shows China-relevant official and policy rows. A quiet tape is not a missing page.', '本栏只收录与中国相关的官方与政策条目。快讯为空不等于页面缺失。') }}</p>
    {% endif %}
  </div>

  <!-- prediction ledger -->
  {% if pw.intel and pw.intel.predictions %}
  <div class="cnx-card" data-l1="ledger">
    <div class="cnx-ctitle">🔮 {{ t('Policy prediction ledger', '政策预测台账') }} <span class="sub">{{ t('dated, checkable — accountability, not a forecast service', '有日期、可检验——问责，而非预测服务') }}</span></div>
    <div class="pw-table-scroll"><div class="pw-table-inner">
    <table class="pwd">
      <thead><tr><th>{{ t('Prediction', '预测') }}</th><th>{{ t('Check by', '核查日') }}</th><th>{{ t('Status', '状态') }}</th></tr></thead>
      <tbody>
      {% for p in pw.intel.predictions %}
        <tr><td>{{ bl(p.text_en, p.text_zh) }}</td><td>{{ p.check_by }}</td><td><span class="pill p-open">{{ t(p.status|capitalize, ({'open':'未结','hit':'命中','miss':'落空'}).get(p.status, p.status)) }}</span></td></tr>
      {% endfor %}
      </tbody>
    </table>
    </div></div>
  </div>
  {% endif %}

  <p class="disc">{{ t('Context only — not a signal, score or trade. The National Team Radar is a read on what the state is doing, not a buy signal; it never gates a trade. PBoC corridor + China macro backdrop are point-in-time and may be revised; the sector matrix, NPC targets and prediction ledger are a hand-curated, dated intel substrate, not a model output.', '仅供参考，非信号、评分或交易。国家队雷达仅为国家队动向的观察，非买入信号，也从不用于交易闸口。央行利率走廊与中国宏观背景为特定时点快照，可能修订；行业矩阵、两会目标与预测台账为人工整理、有日期的情报底稿，并非模型输出。') }} <button class="lens-q" type="button" tabindex="0" aria-label="Explain" data-tip-en="A read on what the state is doing, not a buy signal." data-tip-zh="仅为国家队动向的观察，非买入信号" data-tip-rc-en="Hand-curated, dated intel substrate — not a model output." data-tip-rc-zh="人工整理、有日期的情报底稿，并非模型输出。">?</button></p>
{% endif %}
</div>
{% endblock %}

{% block body_scripts %}
<script>
(function(){
  window.shPop=function(id,e){if(e){e.stopPropagation();}var p=document.getElementById(id);if(!p)return;var open=p.classList.contains('open');document.querySelectorAll('.pw .sh-pop.open').forEach(function(x){x.classList.remove('open');});if(!open){p.classList.add('open');}};
  document.addEventListener('click',function(){document.querySelectorAll('.pw .sh-pop.open').forEach(function(x){x.classList.remove('open');});});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'){document.querySelectorAll('.pw .sh-pop.open').forEach(function(x){x.classList.remove('open');});}});
})();
</script>
{% endblock %}
