{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Filing Forensics — Understand What Changed — MastermindX</title>
{% set seo_title = "Filing Forensics — Understand What Changed — MastermindX" %}
{% set seo_desc = "Compare a company's latest filing with the prior period, understand the changes that stand out, and verify every result with its SEC source." %}
{% set seo_path = "fundamental_forensics.html" %}
{% include "_seo_head.html.j2" %}
<link rel="stylesheet" href="theme.css">
<link rel="stylesheet" href="tier_preview.css">
<link rel="stylesheet" href="fundamental_forensics.css?v=20260816-ff0r1">
<link rel="stylesheet" href="institutional_holding_research.css{% if holding_css_version is defined and holding_css_version %}?v={{ holding_css_version }}{% endif %}">
</head>
<body class="ff-page">
{% set nav_search_placeholder_en = "Search any stock — US, China, HK, Canada & more…" %}
{% set nav_search_placeholder_zh = "搜索任意股票 — 美股、A 股、港股、加股等…" %}
{% include "_site_nav.html.j2" %}

<div class="ff-workspace" id="ff-workspace" data-tab="radar">
  <main class="ff-main" id="ff-main">
    <header class="ff-desk-header" id="ff-desk-header" aria-labelledby="ff-company-label">
      <h1 class="ff-eyebrow ff-page-title">{{ t('Filing forensics', '财报取证') }}</h1>
      <div class="ff-desk-row">
        <div class="ff-company-picker">
          <label id="ff-company-label" for="ff-company-search">{{ t('Company', '公司') }}</label>
          <div class="ff-combobox-wrap">
            <span class="ff-search-icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="8.5" cy="8.5" r="5.5"></circle><path d="m12.6 12.6 4 4"></path></svg>
            </span>
            <input id="ff-company-search" class="ff-company-search" type="search" autocomplete="off"
              role="combobox" aria-autocomplete="list" aria-expanded="false"
              aria-controls="ff-company-options" aria-activedescendant=""
              data-placeholder-en="Search a ticker or company"
              data-placeholder-zh="搜索股票代码或公司"
              placeholder="Search a ticker or company">
            <button class="ff-search-clear" id="ff-search-clear" type="button" hidden
              aria-label="Clear company search" data-label-en="Clear company search" data-label-zh="清除公司搜索">
              <span aria-hidden="true">×</span>
            </button>
            <div class="ff-company-options" id="ff-company-options" role="listbox"
              aria-label="Company matches" hidden></div>
          </div>
        </div>
        <div class="ff-company-identity" id="ff-company-identity" aria-live="polite">
          <div class="ff-company-mark" aria-hidden="true">—</div>
          <div>
            <div class="ff-company-name">{{ t('Loading coverage…', '正在载入覆盖范围…') }}</div>
            <div class="ff-company-detail">—</div>
          </div>
        </div>
        <div class="ff-desk-asof" id="ff-desk-asof">
          <label for="ff-asof-input">{{ t('As of', '截止') }}</label>
          <div class="ff-asof-controls">
            <button type="button" id="ff-asof-latest" class="ff-asof-latest is-active" aria-pressed="true">{{ t('Latest', '最新') }}</button>
            <input id="ff-asof-input" class="ff-asof-input" type="date" autocomplete="off"
              data-tip-en="Rewind the filing cutoff. Both source and recorded clocks use this day, 23:59:59 UTC."
              data-tip-zh="回拨财报截止日。来源时钟与入账时钟均使用该日 23:59:59 UTC。">
          </div>
        </div>
        <dl class="ff-run-meta" id="ff-run-meta" aria-label="Source freshness" data-freshness="unavailable">
          <div>
            <dt>{{ t('Source status', '来源状态') }}</dt>
            <dd id="ff-freshness-status">{{ t('Unavailable', '不可用') }}</dd>
          </div>
          <div hidden>
            <dt>{{ t('Latest source filing', '最新来源披露日') }}</dt>
            <dd id="ff-as-of">—</dd>
          </div>
          <div hidden>
            <dt>{{ t('Source snapshot', '来源快照') }}</dt>
            <dd id="ff-source-snapshot">—</dd>
          </div>
          <div>
            <dt>{{ t('Built from', '数据来源') }}</dt>
            <dd id="ff-source-label">—</dd>
          </div>
        </dl>
        <div class="ff-desk-export" id="ff-desk-export"
          data-tip-en="Export is unavailable until this issuer, cutoff and policy can be queried."
          data-tip-zh="在可查询该发行人、截止日和策略之前，导出不可用。">
          <a class="ff-export-link" id="ff-export-link" href="#" hidden>{{ t('Export', '导出') }}</a>
          <button type="button" class="ff-export-btn" id="ff-export-btn" disabled
            data-tip-en="Export is unavailable until this issuer, cutoff and policy can be queried."
            data-tip-zh="在可查询该发行人、截止日和策略之前，导出不可用。"
            data-label-en="Export unavailable" data-label-zh="导出不可用">{{ t('Export', '导出') }}</button>
        </div>
      </div>
      {#- A43 r3 (P0 first-viewport repair): the desk band ends on ONE stamp
          line at every viewport, as the 10-12 fold receipt measured it. The
          device-local saved-views briefcase (X2-s) and the retained-holding
          reader (#9771) are desk tools, not glance modules: they sit behind
          the closed Desk tools disclosure on the stamp line, so at rest they
          add no height above the lead brief, and open at the full band width. -#}
      <div class="ff-desk-stamp-row">
      <p class="ff-desk-stamp" id="ff-desk-stamp">{{ t('As of — · Source —', '截止 — · 来源 —') }}</p>
      <p class="ff-desk-stamp" id="ff-saved-badge" hidden></p>
      <details class="ff-desk-tools" id="ff-desk-tools">
        <summary>{{ t('Desk tools', '桌面工具') }}</summary>
        <div class="ff-desk-tools-body">
      {#- X2-s saved views: the device-local briefcase lives on this desk band.
          Hidden until fif_saved_briefcase.js wires it (progressive reveal, no
          dead controls when the module is absent); the governed
          `ff-asof-controls--saved` modifier wraps the row (at 390 it folds
          into select / name / actions) and lets the select take the free row
          width at 1440. -#}
      <div class="ff-asof-controls ff-asof-controls--saved" id="ff-saved-controls" hidden>
        <label class="ff-topic-filter" for="ff-saved-select">
          <span>{{ t('Saved views', '已存视图') }}</span>
          <select id="ff-saved-select"></select>
        </label>
        <input id="ff-saved-name" class="ff-asof-input" type="text" maxlength="120" autocomplete="off"
          data-placeholder-en="Name this view" data-placeholder-zh="为视图命名"
          placeholder="Name this view">
        <button type="button" class="ff-export-btn" id="ff-saved-save" disabled
          data-tip-en="Save needs a company, a cutoff and a policy that can be queried."
          data-tip-zh="需要可查询的公司、截止日与策略后才能保存。"
          data-label-en="Save this view" data-label-zh="保存当前视图">{{ t('Save this view', '保存当前视图') }}</button>
        <button type="button" class="ff-trace-open" id="ff-saved-rename" hidden>{{ t('Rename', '重命名') }}</button>
        <button type="button" class="ff-trace-open" id="ff-saved-delete" hidden>{{ t('Delete', '删除') }}</button>
      </div>
      <details class="mx-disc ff-holding-research" id="ff-holding-research">
  <summary>{{ t('Read a reported holding', '查阅已披露持仓') }}</summary>
  <p>{{ t('Read one retained filing record. It is delayed disclosure, not current ownership or trading intent.', '查阅一条已留存的披露记录。这是滞后披露，不代表当前持仓或交易意图。') }}</p>
  <form id="ff-holding-form" method="post" action="/api/forensics/v1/institutional/reported-holding" autocomplete="off">
    <div class="ff-holding-fields">
      <label for="ff-holding-cik">{{ t('Reporting CIK', '披露机构 CIK') }}<input class="ff-asof-input" id="ff-holding-cik" name="filer_cik" value="0001904423" inputmode="numeric" required maxlength="10"></label>
      <label for="ff-holding-period">{{ t('Report period', '报告期') }}<input class="ff-asof-input" id="ff-holding-period" name="report_period" type="date" value="2026-06-30" required></label>
      <label for="ff-holding-cutoff">{{ t('Known by (UTC)', '截至时间（UTC）') }}<input class="ff-asof-input" id="ff-holding-cutoff" name="decision_cutoff" value="2026-08-27T09:22:23.700168Z" required maxlength="64"></label>
    </div>
    <details class="mx-disc"><summary>{{ t('Filing and record identifiers', '披露及记录标识') }}</summary>
      <div class="ff-holding-fields">
        <label for="ff-holding-accession">{{ t('SEC accession', 'SEC 披露编号') }}<input class="ff-asof-input" id="ff-holding-accession" name="accession" value="0001904423-26-000004" required maxlength="20"></label>
        <label for="ff-holding-row">{{ t('Holding record ID', '持仓记录标识') }}<input class="ff-asof-input" id="ff-holding-row" name="infotable_sk" value="4611686018427387905" inputmode="numeric" required maxlength="19"></label>
        <label for="ff-holding-generation">{{ t('Pinned catalog (optional)', '固定目录版本（可选）') }}<input class="ff-asof-input" id="ff-holding-generation" name="generation_id" value="i13fgen_9ae95a9de85cc0ed426b09cd7db443210c8cdc5d9178aaad5859c3f8a57527cd" maxlength="72" autocomplete="off"></label>
      </div>
    </details>
    <div class="ff-holding-actions">
      <span>{{ t('Retained Custos example:', '已留存的 Custos 示例：') }}</span>
      <button type="button" class="gbtn gbtn-quiet" data-holding-example="previous">2026-03-31</button>
      <button type="button" class="gbtn gbtn-quiet" data-holding-example="current">2026-06-30</button>
      <button type="submit" class="gbtn" id="ff-holding-read">{{ t('Read reported holding', '读取已披露持仓') }}</button>
    </div>
  </form>
  <p id="ff-holding-status" role="status" aria-live="polite">{{ t('Choose a filing, then read its source record.', '选择披露文件，再读取其来源记录。') }}</p>
  <div id="ff-holding-result" hidden></div>
      </details>
        </div>
      </details>
      </div>
      <div class="ff-company-action" id="ff-company-action" hidden>
        <span class="ff-action-glyph" aria-hidden="true">·</span>
        <span class="ff-action-copy">{{ t('Loading', '正在载入') }}</span>
      </div>
    </header>

    <section class="ff-data-notice" id="ff-data-notice" aria-live="polite" hidden></section>

    {#- X2-s: the saved-views quiet chip (newer filing generation, or the plain
        "saved view unavailable" state). One action at most, never values. -#}
    <section class="ff-data-notice" id="ff-saved-notice" aria-live="polite" hidden></section>

    {#- The access gate. It replaces the workbench whenever the desk cannot be
        read, and the ANONYMOUS variant below is server-rendered on purpose: a
        stranger (and a crawler, which never has a session) must meet the
        product rather than a loading skeleton. The other three states are
        session-only, so fundamental_forensics.js renders those at runtime and
        restores this markup verbatim from a stash. Nothing here is a finding,
        a company, or a number read out of the private state. -#}
    <section class="ff-gate" id="ff-gate" aria-labelledby="ff-gate-title" hidden>
      <div class="ff-gate-state" id="ff-gate-state" data-state="signin" aria-live="polite">
        <p class="ff-gate-chip"><span class="ff-gate-dot" aria-hidden="true"></span>{{ t('Members only', '会员可见') }}</p>
        <h2 id="ff-gate-title">{{ t('Open to Essential members', 'Essential 会员可读') }}</h2>
        <p class="ff-gate-stance">{{ t('Sign in to read it, or see what Essential includes.', '登录即可查阅，或先了解 Essential 包含哪些内容。') }}</p>
        <div class="ff-gate-actions">
          <button class="ff-gate-primary" type="button" data-gate-action="plans">{{ t('View Essential plans', '查看 Essential 方案') }}</button>
          <button class="ff-gate-secondary" type="button" data-gate-action="signin">{{ t('Sign in', '登录') }}</button>
        </div>
      </div>

      <div class="ff-gate-preview" id="ff-gate-preview">
        <dl class="ff-gate-facts">
          <div>
            <dt>{{ t('Source', '数据来源') }}</dt>
            <dd>SEC EDGAR</dd>
          </div>
          <div>
            <dt>{{ t('Scope', '覆盖范围') }}</dt>
            <dd>{{ t('Companies that file with the SEC', '在 SEC 披露的公司') }}</dd>
          </div>
          <div>
            <dt>{{ t('Basis', '数据口径') }}</dt>
            <dd>{{ t('Company Facts and filing text', '公司事实与披露原文') }}</dd>
          </div>
          {#- The only numbers on this page. Aggregate counts stay free by the
              rule templates/tier_preview.js states outright — "a count names
              nobody", while the member rows are the product — so this names no
              company, ranks nothing and reveals no finding. Both counts come
              from the build's own projection of state["summary"], never a
              literal, so they cannot outlive their recompute; when the build
              supplies no summary (fresh clone, CI checkout, first build) the
              fact is omitted whole rather than printing a zero. -#}
          {%- if state_summary.get('companies') and state_summary.get('findings') %}
          <div>
            <dt>{{ t('Last pass', '最近一轮') }}</dt>
            <dd>{{ t(
              '{:,} companies read, {:,} changes ranked for a look'.format(state_summary['companies'], state_summary['findings']),
              '读取 {:,} 家公司，排出 {:,} 项值得一看的变化'.format(state_summary['companies'], state_summary['findings'])
            ) }}</dd>
          </div>
          {%- endif %}
        </dl>

        <ol class="ff-gate-steps">
          <li>
            <span class="ff-gate-step-index" aria-hidden="true">01</span>
            <h3>{{ t('Read', '读取') }}</h3>
            <p>{{ t('Rule-based checks read each new filing and rank what deserves a look.', '基于规则的检查逐份读取新的披露文件，并对值得关注的变化排序。') }}</p>
          </li>
          <li>
            <span class="ff-gate-step-index" aria-hidden="true">02</span>
            <h3>{{ t('Compare', '对照') }}</h3>
            <p>{{ t('This filing’s wording and numbers are set against the one before it.', '把本次披露的措辞与数字，与上一次逐项对照。') }}</p>
          </li>
          <li>
            <span class="ff-gate-step-index" aria-hidden="true">03</span>
            <h3>{{ t('Trace', '溯源') }}</h3>
            <p>{{ t('Every result links back to the SEC document it was read from.', '每项结果都能回到其读取来源的 SEC 文件。') }}</p>
          </li>
        </ol>

        {#- The signature: the product's own evidence furniture, shown empty.
            Deliberately NOT a blurred or invented sample row — the withheld
            slots are ruled placeholders, which stay honest in both themes and
            put no fabricated finding into a public byte. -#}
        <section class="ff-gate-anatomy" aria-labelledby="ff-gate-anatomy-title">
          <p class="ff-kicker">{{ t('The receipt behind every result', '每项结果背后的凭据') }}</p>
          <h3 id="ff-gate-anatomy-title">{{ t('What one result opens to', '一项结果可展开查看') }}</h3>
          <ol class="ff-gate-slots">
            <li>
              <span class="ff-gate-slot-index" aria-hidden="true">01</span>
              <span class="ff-gate-slot-label">{{ t('Normalized inputs', '标准化输入') }}</span>
              <span class="ff-gate-rule" aria-hidden="true"></span>
            </li>
            <li>
              <span class="ff-gate-slot-index" aria-hidden="true">02</span>
              <span class="ff-gate-slot-label">{{ t('The rule and its threshold', '规则与阈值') }}</span>
              <span class="ff-gate-rule" aria-hidden="true"></span>
            </li>
            <li>
              <span class="ff-gate-slot-index" aria-hidden="true">03</span>
              <span class="ff-gate-slot-label">{{ t('What changed', '变化内容') }}</span>
              <span class="ff-gate-rule" aria-hidden="true"></span>
            </li>
            <li>
              <span class="ff-gate-slot-index" aria-hidden="true">04</span>
              <span class="ff-gate-slot-label">{{ t('SEC source link', 'SEC 来源链接') }}</span>
              <span class="ff-gate-rule" aria-hidden="true"></span>
            </li>
          </ol>
          <p class="ff-gate-anatomy-foot">{{ t('Values are shown as reported. Missing facts stay missing — nothing is filled in.', '数值按披露原样呈现；缺失事实保持缺失，不做填补。') }}</p>
        </section>

        <p class="ff-gate-limit">{{ t('A comparison of text and numbers — not a judgment about motive, materiality, or financial impact.', '这是文本与数字的对比，不代表对动机、重大性或财务影响的判断。') }}</p>
      </div>
    </section>

    <section class="ff-overview" id="ff-overview" aria-labelledby="ff-overview-title">
      <div class="ff-overview-lead">
        <p class="ff-kicker">{{ t('This filing', '本期财报') }}</p>
        <div class="ff-overview-heading">
          <div>
            <h2 id="ff-overview-title">{{ t('What changed', '发生了什么变化') }}</h2>
            <p>{{ t('Why it is worth reviewing, with the source one click away.', '为何值得复核，来源一键可核。') }}</p>
          </div>
          <span class="ff-overview-status" id="ff-overview-status" data-state="loading">{{ t('Building snapshot…', '正在生成速览…') }}</span>
        </div>

        <article class="ff-quick-signal" id="ff-quick-signal" data-priority="watch">
          <div class="ff-quick-signal-icon" aria-hidden="true">
            <svg viewBox="0 0 40 40" fill="none"><path d="M8 29V18m8 11V11m8 18V21m8 8V7" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="m8 13 8-6 8 8 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="ff-quick-signal-copy">
            <span class="ff-quick-signal-label" id="ff-quick-signal-label">{{ t('Why it matters', '为什么重要') }}</span>
            <h3 id="ff-quick-signal-title">{{ t('Loading the latest comparison…', '正在载入最新对比…') }}</h3>
            <p id="ff-quick-signal-summary">{{ t('We are comparing the latest filing with the prior period.', '正在将最新财报与上一期进行对比。') }}</p>
            <p class="ff-quick-signal-magnitude" id="ff-quick-signal-magnitude" hidden></p>
          </div>
          <button class="ff-quick-signal-open ff-source-control" type="button" data-open-primary-finding>
            {{ t('Open source', '打开来源') }} <span aria-hidden="true">→</span>
          </button>
        </article>
      </div>

      <div class="ff-overview-side">
        <div class="ff-snapshot-stats" aria-label="Latest filing summary">
          <div class="ff-snapshot-stat is-attention">
            <span class="ff-snapshot-stat-icon" aria-hidden="true">!</span>
            <strong id="ff-stat-attention">—</strong>
            <small>{{ t('Need attention', '需要关注') }}</small>
          </div>
          <div class="ff-snapshot-stat is-watch" hidden>
            <span class="ff-snapshot-stat-icon" aria-hidden="true">◎</span>
            <strong id="ff-stat-watch">—</strong>
            <small>{{ t('Keep an eye on', '持续观察') }}</small>
          </div>
          <div class="ff-snapshot-stat is-coverage">
            <span class="ff-snapshot-stat-icon" aria-hidden="true">◒</span>
            <strong id="ff-stat-coverage">—</strong>
            <small id="ff-stat-coverage-label">{{ t('Metrics compared', '已对比指标') }}</small>
          </div>
          <div class="ff-snapshot-stat is-source" hidden>
            <span class="ff-snapshot-stat-icon" aria-hidden="true">↗</span>
            <strong id="ff-stat-sources">—</strong>
            <small>{{ t('Source links', '来源链接') }}</small>
          </div>
        </div>

        <div class="ff-next-steps">
          <span class="ff-next-steps-title">{{ t('Explore this filing', '继续探索这份财报') }}</span>
          <button type="button" data-go-tab="compare"><span aria-hidden="true">01</span>{{ t('Compare key numbers', '对比关键数字') }}</button>
          <button type="button" data-go-tab="disclosures"><span aria-hidden="true">02</span>{{ t('Read wording changes', '阅读措辞变化') }}</button>
          <button type="button" data-go-tab="trace"><span aria-hidden="true">03</span>{{ t('Verify SEC sources', '核对 SEC 来源') }}</button>
        </div>
      </div>
    </section>

    <nav class="ff-tabs" aria-label="Forensics views">
      <div class="ff-tablist" role="tablist" aria-label="Forensics views">
        <div class="ff-tab-group">
          <span class="ff-tab-group-label">{{ t('Understand', '看懂') }}</span>
          <button class="ff-tab is-active" id="ff-tab-radar" type="button" role="tab"
            aria-selected="true" aria-controls="ff-panel-radar" tabindex="0" data-tab="radar">
            <span class="ff-tab-icon" aria-hidden="true">✦</span>{{ t('Key signals', '关键信号') }}
          </button>
          <button class="ff-tab" id="ff-tab-statements" type="button" role="tab"
            aria-selected="false" aria-controls="ff-panel-statements" tabindex="-1" data-tab="statements">
            <span class="ff-tab-icon" aria-hidden="true">▥</span>{{ t('Financials', '财务数据') }}
          </button>
        </div>
        <div class="ff-tab-group">
          <span class="ff-tab-group-label">{{ t('Read the filing', '阅读财报') }}</span>
          <button class="ff-tab" id="ff-tab-disclosures" type="button" role="tab"
            aria-selected="false" aria-controls="ff-panel-disclosures" tabindex="-1" data-tab="disclosures">
            <span class="ff-tab-icon" aria-hidden="true">◫</span>{{ t('Wording', '措辞') }}
          </button>
          <button class="ff-tab" id="ff-tab-redlines" type="button" role="tab"
            aria-selected="false" aria-controls="ff-panel-redlines" tabindex="-1" data-tab="redlines">
            <span class="ff-tab-icon" aria-hidden="true">≠</span>{{ t('Exact wording', '逐字对照') }}
          </button>
          <button class="ff-tab" id="ff-tab-timeline" type="button" role="tab"
            aria-selected="false" aria-controls="ff-panel-timeline" tabindex="-1" data-tab="timeline">
            <span class="ff-tab-icon" aria-hidden="true">◷</span>{{ t('Filing history', '披露历史') }}
          </button>
        </div>
        <div class="ff-tab-group">
          <span class="ff-tab-group-label">{{ t('Verify', '核对') }}</span>
          <button class="ff-tab" id="ff-tab-compare" type="button" role="tab"
            aria-selected="false" aria-controls="ff-panel-compare" tabindex="-1" data-tab="compare">
            <span class="ff-tab-icon" aria-hidden="true">↔</span>{{ t('Revisions', '重述对照') }}
          </button>
          <button class="ff-tab" id="ff-tab-trace" type="button" role="tab"
            aria-selected="false" aria-controls="ff-panel-trace" tabindex="-1" data-tab="trace">
            <span class="ff-tab-icon" aria-hidden="true">✓</span>{{ t('Sources', '来源凭据') }}
          </button>
          <button class="ff-tab" id="ff-tab-peers" type="button" role="tab"
            aria-selected="false" aria-controls="ff-panel-peers" tabindex="-1" data-tab="peers">
            <span class="ff-tab-icon" aria-hidden="true">▦</span>{{ t('Peers', '同业') }}
          </button>
        </div>
      </div>
      <div class="ff-view-status" id="ff-view-status" role="status" aria-live="polite">
        {{ t('Loading filing data…', '正在载入财报数据…') }}
      </div>
    </nav>

    <section class="ff-panel" id="ff-panel-radar" role="tabpanel" aria-labelledby="ff-tab-radar" tabindex="0">
      <header class="ff-panel-head">
        <div>
          <p class="ff-kicker">{{ t('Key signals', '关键信号') }}</p>
          <h2>{{ t('What changed in the latest filing', '最新财报发生了哪些变化') }}</h2>
          <p>{{ t('Start with the plain-English explanation. Open any signal to see the numbers, the rule that spotted it, and the original SEC source.', '先阅读简单解释。打开任一信号，即可查看关键数字、识别规则和 SEC 原始来源。') }}</p>
        </div>
        <div class="ff-filter-summary" id="ff-filter-summary">—</div>
      </header>

      <div class="ff-filterbar" aria-label="Finding filters">
        <div class="ff-segmented" id="ff-priority-filters" role="group" aria-label="Priority filter">
          <button type="button" class="ff-filter is-active" data-priority="all" aria-pressed="true">
            {{ t('All', '全部') }} <span class="ff-filter-count" data-count-for="all">0</span>
          </button>
          <button type="button" class="ff-filter" data-priority="high" aria-pressed="false">
            <span class="ff-filter-symbol ff-filter-symbol-review" aria-hidden="true">!</span>
            {{ t('Needs attention', '需要关注') }} <span class="ff-filter-count" data-count-for="high">0</span>
          </button>
          <button type="button" class="ff-filter" data-priority="watch" aria-pressed="false">
            <span class="ff-filter-symbol ff-filter-symbol-watch" aria-hidden="true">○</span>
            {{ t('Keep an eye on', '持续观察') }} <span class="ff-filter-count" data-count-for="watch">0</span>
          </button>
        </div>
        <label class="ff-topic-filter" for="ff-topic-select">
          <span>{{ t('Topic', '主题') }}</span>
          <select id="ff-topic-select">
            <option value="all">All topics / 全部主题</option>
          </select>
        </label>
      </div>

      <div class="ff-findings" id="ff-findings" role="list" aria-label="Filing findings"></div>
    </section>

    <section class="ff-panel" id="ff-panel-statements" role="tabpanel" aria-labelledby="ff-tab-statements" tabindex="0" hidden>
      <header class="ff-panel-head">
        <div>
          <p class="ff-kicker">{{ t('Financial history', '财务历史') }}</p>
          <h2>{{ t('See the numbers across periods', '查看各期间的财务数字') }}</h2>
          <p>{{ t('These are the SEC values used to compare filings. Some quarterly figures are calculated from year-to-date totals; open the source when you need the original.', '这些是用于对比财报的 SEC 数值。部分季度数据由年初至今总额计算而来；需要原始数据时可打开来源。') }}</p>
        </div>
      </header>
      <div id="ff-statements"></div>
    </section>

    <section class="ff-panel" id="ff-panel-disclosures" role="tabpanel" aria-labelledby="ff-tab-disclosures" tabindex="0" hidden>
      <header class="ff-panel-head ff-disclosure-head">
        <div>
          <p class="ff-kicker">{{ t('Wording changes', '措辞变化') }}</p>
          <h2>{{ t('See what the company added, removed, or rewrote', '查看公司新增、删除或改写的内容') }}</h2>
          <p>{{ t('This compares language between filings. It shows what changed—not why it changed.', '这里对比两份财报的文字，只显示发生了什么变化，不推测变化原因。') }}</p>
        </div>
        <div class="ff-filter-summary" id="ff-disclosure-summary">—</div>
      </header>
      <div class="ff-disclosure-toolbar" aria-label="Disclosure change filters">
        <label class="ff-topic-filter" for="ff-disclosure-section">
          <span>{{ t('Section', '章节') }}</span>
          <select id="ff-disclosure-section">
            <option value="all">All sections / 全部章节</option>
          </select>
        </label>
        <p class="ff-lexical-note"><span class="ff-lexical-glyph" aria-hidden="true">◇</span>{{ t('Open any change to read the before-and-after SEC excerpts.', '打开任一变化，即可阅读前后两段 SEC 原文。') }}</p>
      </div>
      <div class="ff-disclosure-feed" id="ff-disclosure-feed" role="list" aria-label="Filing disclosure changes"></div>
    </section>

    <section class="ff-panel" id="ff-panel-redlines" role="tabpanel" aria-labelledby="ff-tab-redlines" tabindex="0" hidden>
      <header class="ff-panel-head">
        <div>
          <p class="ff-kicker">{{ t('Before and after', '前后对照') }}</p>
          <h2>{{ t('Read changed wording side by side', '并列阅读变化前后的措辞') }}</h2>
          <p>{{ t('Each row shows matching passages from both SEC filings. Unchanged repeated text is hidden.', '每行显示两份 SEC 财报中的对应段落；未变化的重复文字会被隐藏。') }}</p>
        </div>
        <div class="ff-filter-summary" id="ff-redline-summary">—</div>
      </header>
      <div class="ff-redline-list" id="ff-redline-list" role="list" aria-label="Filing redlines"></div>
    </section>

    <section class="ff-panel" id="ff-panel-timeline" role="tabpanel" aria-labelledby="ff-tab-timeline" tabindex="0" hidden>
      <header class="ff-panel-head">
        <div>
          <p class="ff-kicker">{{ t('Filing history', '财报历史') }}</p>
          <h2>{{ t('See which filings are being compared', '查看正在对比的财报') }}</h2>
          <p>{{ t('Check the filing type, date, and original SEC document.', '查看财报类型、日期和 SEC 原文。') }}</p>
        </div>
      </header>
      <div class="ff-timeline" id="ff-timeline" aria-label="Filing comparison timeline"></div>
    </section>

    <section class="ff-panel" id="ff-panel-compare" role="tabpanel" aria-labelledby="ff-tab-compare" tabindex="0" hidden>
      <header class="ff-panel-head ff-compare-head">
        <div>
          <p class="ff-kicker">{{ t('Period comparison', '期间对比') }}</p>
          <h2>{{ t('Compare the numbers side by side', '并列对比财务数字') }}</h2>
          <p>{{ t('Choose any two reported periods. A rise or fall is context, not a verdict.', '选择任意两个报告期间。上升或下降只是背景信息，并非结论。') }}</p>
        </div>
        <div class="ff-period-controls" id="ff-period-controls">
          <label for="ff-current-period">
            <span>{{ t('Current', '本期') }}</span>
            <select id="ff-current-period"></select>
          </label>
          <span class="ff-period-arrow" aria-hidden="true">←</span>
          <label for="ff-prior-period">
            <span>{{ t('Prior', '上期') }}</span>
            <select id="ff-prior-period"></select>
          </label>
        </div>
      </header>
      <section class="ff-revisions" id="ff-revisions" aria-labelledby="ff-revisions-title">
        <h3 id="ff-revisions-title">{{ t('Original, latest, restated', '原始、截止最新、重述后') }}</h3>
        <p>{{ t('Same period, three source vintages. A blank column is an absence, not a zero.', '同一期间、三种来源版本。空列是缺失，不是零。') }}</p>
        <div id="ff-revisions-table"></div>
      </section>
      <div class="ff-compare-grid" id="ff-compare-grid"></div>
    </section>

    <section class="ff-panel" id="ff-panel-trace" role="tabpanel" aria-labelledby="ff-tab-trace" tabindex="0" hidden>
      <header class="ff-panel-head">
        <div>
          <p class="ff-kicker">{{ t('Verify the source', '核对来源') }}</p>
          <h2>{{ t('Follow every result back to the SEC', '追溯每项结果的 SEC 来源') }}</h2>
          <p>{{ t('The source map shows where each result came from. The run record shows how this page was produced.', '来源地图显示每项结果来自哪里；运行记录显示本页面如何生成。') }}</p>
        </div>
      </header>
      <div class="ff-source-tabs" id="ff-source-tabs" role="tablist" aria-label="Sources and receipt views">
        <button class="ff-source-tab is-active" id="ff-source-tab-map" type="button" role="tab"
          aria-selected="true" aria-controls="ff-source-panel-map" tabindex="0" data-source-mode="map">
          <span class="ff-source-tab-mark" aria-hidden="true">↗</span>{{ t('Source map', '来源地图') }}
        </button>
        <button class="ff-source-tab" id="ff-source-tab-receipt" type="button" role="tab"
          aria-selected="false" aria-controls="ff-source-panel-receipt" tabindex="-1" data-source-mode="receipt">
          <span class="ff-source-tab-mark" aria-hidden="true">◇</span>{{ t('Run record', '运行记录') }}
        </button>
      </div>
      <section id="ff-source-panel-map" role="tabpanel" aria-labelledby="ff-source-tab-map" tabindex="-1">
        <div id="ff-trace"></div>
      </section>
      <section id="ff-source-panel-receipt" role="tabpanel" aria-labelledby="ff-source-tab-receipt" tabindex="-1" hidden>
        <div class="ff-receipt-surface" id="ff-receipt" aria-live="polite"></div>
      </section>
    </section>

    <section class="ff-panel" id="ff-panel-peers" role="tabpanel" aria-labelledby="ff-tab-peers" tabindex="0" hidden>
      <header class="ff-panel-head">
        <div>
          <p class="ff-kicker">{{ t('Peer set', '同业组') }}</p>
          <h2>{{ t('Who is in, who is out', '谁在组内，谁被排除') }}</h2>
          <p>{{ t('Ranks use only companies that qualify. Exclusions are listed with a reason.', '排名只计入符合条件的公司。排除项均附原因。') }}</p>
        </div>
      </header>
      <p class="ff-peer-policy" id="ff-peer-policy"></p>
      {#- X2-s: the peers-panel save entry — saves the current desk with its
          peer cohort state. Hidden until the briefcase module wires it. -#}
      <div class="ff-asof-controls" id="ff-peer-save-row" hidden>
        <button type="button" class="ff-trace-open" id="ff-peer-save">{{ t('Save this peer view', '保存同业视图') }}</button>
      </div>
      <div id="ff-peer-included"></div>
      <div id="ff-peer-excluded"></div>
    </section>
  </main>

  <aside class="ff-evidence" id="ff-evidence" aria-labelledby="ff-evidence-title" tabindex="-1">
    <header class="ff-evidence-head">
      <div>
        <p class="ff-kicker">{{ t('Signal details', '信号详情') }}</p>
        <h2 id="ff-evidence-title">{{ t('Choose a signal', '选择一个信号') }}</h2>
      </div>
      <button class="ff-evidence-close" id="ff-evidence-close" type="button"
        aria-label="Close evidence inspector" data-label-en="Close evidence inspector" data-label-zh="关闭证据检查器">
        <span aria-hidden="true">×</span>
      </button>
    </header>
    <div class="ff-evidence-body" id="ff-evidence-body">
      <div class="ff-evidence-empty">
        <span class="ff-empty-mark" aria-hidden="true">↳</span>
        <p>{{ t('Choose a signal to understand what it means, compare the numbers, and verify the SEC source.', '选择一个信号，了解它的含义、对比关键数字并核对 SEC 来源。') }}</p>
      </div>
    </div>
  </aside>

  <aside class="ff-receipt-inspector" id="ff-receipt-inspector" aria-labelledby="ff-receipt-inspector-title" tabindex="-1">
    <header class="ff-evidence-head">
      <div>
        <p class="ff-kicker">{{ t('How this value was built', '这个数值如何生成') }}</p>
        <h2 id="ff-receipt-inspector-title">{{ t('Choose a value', '选择一个数值') }}</h2>
      </div>
      <button class="ff-evidence-close" id="ff-receipt-inspector-close" type="button"
        aria-label="Close receipt inspector" data-label-en="Close receipt inspector" data-label-zh="关闭凭据检查器">
        <span aria-hidden="true">×</span>
      </button>
    </header>
    <div class="ff-evidence-body" id="ff-receipt-inspector-body">
      <div class="ff-evidence-empty">
        <span class="ff-empty-mark" aria-hidden="true">◇</span>
        <p>{{ t('Choose a value to see its recorded source path.', '选择一个数值，查看其记录的来源路径。') }}</p>
      </div>
    </div>
  </aside>
  <div class="ff-scrim" id="ff-scrim" hidden></div>
</div>

<template id="ff-loading-template">
  <div class="ff-loading" role="status">
    <span class="ff-loading-dot" aria-hidden="true"></span>
    <span class="l-en">Comparing the latest filing…</span><span class="l-zh">正在对比最新财报…</span>
  </div>
</template>

<script src="theme.js" defer></script>
<script src="tier_preview.js" defer></script>
<script src="fif_saved_briefcase.js?v=20261012-x2s1" defer></script>
<script src="fundamental_forensics.js?v=20260816-ff0r1" defer></script>
<script src="institutional_holding_research.js{% if holding_js_version is defined and holding_js_version %}?v={{ holding_js_version }}{% endif %}" defer></script>
</body>
</html>
