{#=============================================================================
  calculators/compounding.html.j2
  Clone of position_size.html.j2 — §7 compounding formula (ordinary annuity).
  Includes per-year table (JS-rendered, ≤50 rows) and inline SVG growth curve.

  Context (CONTRACT §5): page{slug:'compounding', family:'page', title,
  description, canonical, url_path, section:'tools', breadcrumbs}, rel, site,
  toc, related, cta.
=============================================================================#}
{% extends "seo_calculator_base.html.j2" %}
{% import "_estate_glyphs.html.j2" as glyphs %}

{% block calc_glyph %}{{ glyphs.glyph('compounding', 'crown') }}{% endblock %}

{% block estate_css %}
{{ super() }}
  /* compounding-specific: table + SVG curve — terminal treatment */
  .cp-table-wrap{margin:20px 0 0; overflow-x:auto;}
  .cp-table-wrap table{width:100%; border-collapse:collapse; font-family:var(--num);
    font-size:var(--fs-sm); font-variant-numeric:tabular-nums; font-feature-settings:"tnum" 1;}
  .cp-table-wrap th{font-family:var(--num); font-size:var(--fs-micro); font-weight:700; color:var(--ink-3);
    text-transform:uppercase; letter-spacing:.08em; padding:7px 10px; text-align:right; border-bottom:1px solid var(--hair-strong);}
  .cp-table-wrap th:first-child{text-align:left;}
  .cp-table-wrap td{padding:6px 10px; text-align:right; border-bottom:1px solid var(--hair); color:var(--ink-1);}
  .cp-table-wrap td:first-child{text-align:left; color:var(--ink-3);}
  .cp-table-wrap td.pos-col{color:var(--up);}
  .cp-curve-wrap{margin:20px 0 0; border-radius:var(--r-md); border:1px solid var(--hair-strong); overflow:hidden;}
  .cp-curve-wrap svg{display:block; width:100%; height:auto; background:var(--panel2);}
  .ci input[aria-invalid="true"]{border-color:var(--warn);}
.copy-fallback{flex-basis:100%; margin:4px 0 0;}
.copy-fallback-l{display:block; font-family:var(--font-ui); font-size:var(--fs-sm); color:var(--warn); margin:0 0 6px; line-height:1.4;}
.copy-fallback-t{display:block; width:100%; box-sizing:border-box; font-family:var(--num); font-size:var(--fs-sm); line-height:1.5; color:var(--ink-1); background:var(--tile); border:1px solid var(--hair-strong); border-radius:var(--r-md); padding:9px 11px; resize:vertical;}
{% endblock %}

{% block calc_form %}
<p class="cc-lede">{{ t('Enter a starting amount, a recurring contribution, how often you contribute, an annual return, and a time horizon. The calculator shows how your money compounds year by year.',
   '填入初始金额、定期投入、投入频率、年化收益率和时间跨度。计算器将逐年展示你的资金如何复利增长。') }}</p>

<div class="calc-in">
  <label class="ci"><span class="ci-l">{{ t('Starting principal ($)', '初始本金（$）') }}</span>
    <input id="principal" inputmode="decimal" autocomplete="off" placeholder="10,000"></label>
  <label class="ci"><span class="ci-l">{{ t('Contribution per period ($)', '每期投入（$）') }}</span>
    <input id="contrib" inputmode="decimal" autocomplete="off" placeholder="500"></label>
  <div class="ci" style="flex-direction:column; gap:6px;">
    <span class="ci-l">{{ t('Contribution frequency', '投入频率') }}</span>
    <div class="ci-seg" role="radiogroup" data-name="freq" id="freq-seg">
      <button class="on" data-v="12" type="button">{{ t('Monthly', '每月') }}</button><button data-v="4" type="button">{{ t('Quarterly', '每季') }}</button><button data-v="1" type="button">{{ t('Annual', '每年') }}</button>
    </div>
  </div>
  <label class="ci"><span class="ci-l">{{ t('Annual return (%)', '年化收益率（%）') }}</span>
    <input id="rate" inputmode="decimal" autocomplete="off" placeholder="7"></label>
  <label class="ci"><span class="ci-l">{{ t('Years', '年数') }}</span>
    <input id="years" inputmode="decimal" autocomplete="off" placeholder="10"></label>
</div>

<div class="calc-out" aria-live="polite">
  <div class="co-main"><span id="out-main">—</span><span class="co-unit">{{ t('future value', '终值') }}</span></div>
  <p class="co-plain" id="out-plain">{{ t('Fill in all fields to see how your money grows.', '填入所有字段即可查看资金增长情况。') }}</p>
  <dl class="co-rows">
    <div><dt>{{ t('Total contributed', '合计投入') }}</dt><dd id="out-contrib">—</dd></div>
    <div><dt>{{ t('Growth (interest)', '增长（利息）') }}</dt><dd id="out-growth">—</dd></div>
    <div><dt>{{ t('Growth multiple', '增长倍数') }}</dt><dd id="out-mult">—</dd></div>
  </dl>
</div>

<div class="calc-actions">
  <button class="gbtn" id="copy-result" type="button">{{ t('Copy result', '复制结果') }}</button>
  <span class="copied" id="copied" role="status">{{ t('Copied', '已复制') }}</span>
  <div class="copy-fallback" id="copy-fallback" hidden>
    <label class="copy-fallback-l" for="copy-fallback-text">{{ t('Could not copy automatically. The text below is selected; press Ctrl+C or ⌘C to copy it.', '未能自动复制。下方文字已选中，请按 Ctrl+C 或 ⌘C 复制。') }}</label>
    <textarea class="copy-fallback-t" id="copy-fallback-text" readonly rows="4" spellcheck="false"></textarea>
  </div>
</div>

<div class="cp-curve-wrap" id="curve-wrap" aria-hidden="true" style="display:none;">
  <svg id="cp-curve" viewBox="0 0 600 200" preserveAspectRatio="xMidYMid meet">
    <defs>
      <linearGradient id="grad-fv" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0%" stop-color="var(--link)" stop-opacity="0.18"/>
        <stop offset="100%" stop-color="var(--link)" stop-opacity="0.02"/>
      </linearGradient>
    </defs>
    <path id="cp-area-fv"  fill="url(#grad-fv)" d=""/>
    <path id="cp-area-c"   fill="var(--panel)" d="" opacity="0.7"/>
    <path id="cp-line-fv"  fill="none" stroke="var(--link)"  stroke-width="2" stroke-linecap="round"/>
    <path id="cp-line-c"   fill="none" stroke="var(--muted)" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="4 3"/>
    <g id="cp-legend" font-family="var(--font-ui)" font-size="11" fill="var(--muted)">
      <text class="l-en" x="12" y="18">─ Total value</text><text class="l-zh" x="12" y="18">─ 总价值</text>
      <text class="l-en" x="12" y="32">‥ Contributed</text><text class="l-zh" x="12" y="32">‥ 累计投入</text>
    </g>
  </svg>
</div>

<div class="cp-table-wrap" id="year-table-wrap" style="display:none;" aria-label="Year-by-year breakdown">
  <table>
    <thead><tr>
      <th>{{ t('Year', '年份') }}</th>
      <th>{{ t('Contributed', '投入') }}</th>
      <th>{{ t('Growth', '增长') }}</th>
      <th>{{ t('Total value', '总值') }}</th>
    </tr></thead>
    <tbody id="year-tbody"></tbody>
  </table>
</div>
{% endblock %}

{% block article_body %}
<p>{{ t('Compound growth means your returns earn returns. The longer the horizon and the higher the rate, the more dominant the compounding effect becomes — a dollar of growth today adds to the base that all future periods compound on top of.',
   '复利增长意味着你的收益也在产生收益。时间跨度越长、收益率越高，复利效应就越显著——今天的一美元增长，成为未来所有周期继续复利的基础。') }}</p>

<h2 id="formula"><span class="est-h2-mark">01</span>{{ t('The formula', '公式') }}</h2>
<div class="formula">
{{ t('<strong>FV</strong> = P × (1 + i)<sup>m</sup> + c × ((1 + i)<sup>m</sup> − 1) ÷ i', '<strong>终值</strong> = P × (1 + i)<sup>m</sup> + c × ((1 + i)<sup>m</sup> − 1) ÷ i') }}<br>
{{ t('where i = annual rate ÷ 100 ÷ frequency, m = years × frequency', '其中 i = 年利率 ÷ 100 ÷ 频率，m = 年数 × 频率') }}<br>
{{ t('<em>(Ordinary annuity — contributions at the end of each period)</em>', '<em>（普通年金——每期末投入）</em>') }}
</div>
<p>{{ t('The "ordinary annuity" convention matters: contributions land at the <em>end</em> of each period, not the start. The first period\'s contribution earns one fewer period of interest than the principal. If your contributions go in at the start of each period (annuity-due), the future value would be slightly higher — but this convention is the standard baseline.',
   '"普通年金"约定很重要：投入发生在每期<em>末</em>，而非期初。第一期的投入比本金少计一期利息。如果你在每期初投入（期初年金），终值会略高——但普通年金是标准基准。') }}</p>

<h2 id="worked"><span class="est-h2-mark">02</span>{{ t('A worked example', '一个算例') }}</h2>
<div class="worked">
<span class="co-h">{{ t('Worked example', '算例') }}</span>
<p>{{ t('Suppose you start with <span class="num">$10,000</span>, add <span class="num">$500</span> every month, earn <span class="num">7%</span> per year, and let it run for <span class="num">10 years</span>.',
   '假设你以 <span class="num">$10,000</span> 起始，每月追加 <span class="num">$500</span>，年收益率 <span class="num">7%</span>，持续 <span class="num">10年</span>。') }}</p>
<ul>
<li>{{ t('Monthly rate i = <span class="num">7% ÷ 12 ≈ 0.5833%</span>', '月利率 i = <span class="num">7% ÷ 12 ≈ 0.5833%</span>') }}</li>
<li>{{ t('Number of periods m = <span class="num">10 × 12 = 120</span>', '期数 m = <span class="num">10 × 12 = 120</span>') }}</li>
<li>{{ t('FV ≈ <span class="num">$106,639</span>', '终值 ≈ <span class="num">$106,639</span>') }}</li>
<li>{{ t('Total contributed = <span class="num">$10,000 + 500 × 120 = $70,000</span>', '合计投入 = <span class="num">$10,000 + 500 × 120 = $70,000</span>') }}</li>
<li>{{ t('Growth (interest) ≈ <span class="num">$36,639</span> — over half of contributed, earned for free by staying invested.',
   '增长（利息）≈ <span class="num">$36,639</span>——超过投入的一半，靠长期持有白得的回报。') }}</li>
</ul>
</div>

<h2 id="trap"><span class="est-h2-mark">03</span>{{ t('The common trap', '常见陷阱') }}</h2>
<div class="callout warn">
<span class="co-h">{{ t('Mistaking average return for compound return', '混淆平均收益率与复合收益率') }}</span>
<p>{{ t('A 50% gain followed by a 50% loss is not a 0% net result — it\'s −25%. Compounding is multiplicative: <span class="num">1.5 × 0.5 = 0.75</span>. When you read "average annual return of X%", check whether it\'s an arithmetic average (often quoted, optimistic) or a geometric average (compound annual growth rate — what money actually does). The CAGR is always lower than or equal to the arithmetic mean.',
   '上涨50%再下跌50%，净结果不是0%，而是−25%。复利是乘法：<span class="num">1.5 × 0.5 = 0.75</span>。当你看到"年均收益率X%"时，要确认这是算术平均（常被引用，偏乐观）还是几何平均（即CAGR——资金实际经历的）。CAGR始终低于或等于算术均值。') }}</p>
</div>

<h2 id="limits"><span class="est-h2-mark">04</span>{{ t('Where this breaks', '它的局限') }}</h2>
<ul>
<li>{{ t('<strong>The rate is assumed constant.</strong> Real returns are volatile. Sequence of returns matters: a bad year early, when the balance is smaller, hurts less than a bad year late, when there\'s more to lose.',
   '<strong>收益率假设固定不变。</strong>实际回报率是波动的。回报顺序很重要：早期亏损时余额小影响较小，晚期亏损时本金已积累更多则伤害更大。') }}</li>
<li>{{ t('<strong>Taxes and inflation are not modeled.</strong> After-tax and inflation-adjusted returns can differ materially from the nominal figure used here.',
   '<strong>未计入税收和通胀。</strong>税后、通胀调整后的实际回报率与这里使用的名义数字可能相差很大。') }}</li>
<li>{{ t('<strong>Contributions are assumed uniform.</strong> Real savings rates vary. Gaps in contributions reduce FV proportionally.',
   '<strong>假设投入金额不变。</strong>实际储蓄率会变化。中断投入会按比例降低终值。') }}</li>
</ul>

<div class="callout key">
<span class="co-h">{{ t('The one line to remember', '记住这一句') }}</span>
<p>{{ t('Time is the most powerful input. Doubling your rate is hard; doubling your years is often possible.',
   '时间是最强大的变量。将收益率翻倍很难；将年数翻倍往往是可能的。') }}</p>
</div>

<p class="mut" style="font-family:var(--font-ui); font-size:13.5px;">{{ t('See how compounding interacts with drawdowns in <a href="/blog/why-a-50-percent-loss-needs-a-100-percent-gain.html">Why a 50% loss needs a 100% gain</a>, and explore growth rates with the <a href="' ~ rel ~ 'tools/calculators/cagr.html">CAGR calculator</a>. For long-run thinking, <a href="/blog/compound-growth-for-traders.html">Compound growth for traders</a> is the companion piece.',
   '在 <a href="/blog/why-a-50-percent-loss-needs-a-100-percent-gain.html">为什么亏损50%需要盈利100%才能回本</a> 中了解复利与回撤的关系，或用 <a href="' ~ rel ~ 'tools/calculators/cagr.html">CAGR计算器</a>探索增长率。长期思维的配套阅读：<a href="/blog/compound-growth-for-traders.html">交易者的复利增长</a>。') }}</p>
{% endblock %}

{% block calc_script %}
<script>
(function(){
  "use strict";

  var freq = 12;  // default monthly
  var LIMIT = 1e15;

  function parseNum(raw, unit){
    var s = String(raw == null ? "" : raw).trim();
    if(s === "") return {ok:false, why:"blank"};
    if(unit === "pct") s = s.replace(/\s*%$/, "");
    if(!/^[+-]?(?:\d{1,3}(?:,\d{3})+|\d+)?(?:\.\d*)?$/.test(s) || !/\d/.test(s)) return {ok:false, why:"format"};
    var v = Number(s.replace(/,/g, ""));
    if(!isFinite(v)) return {ok:false, why:"range"};
    return {ok:true, v:v};
  }

  function setBi(el, en, zh){
    el.textContent = "";
    var sEn = document.createElement("span");
    sEn.className = "l-en";
    sEn.textContent = en;
    var sZh = document.createElement("span");
    sZh.className = "l-zh";
    sZh.textContent = zh;
    el.appendChild(sEn);
    el.appendChild(sZh);
  }

  function curLang(){ return document.documentElement.getAttribute("data-lang") === "zh" ? "zh" : "en"; }

  function echoNum(v){ return Number(v).toLocaleString("en-US",{maximumFractionDigits:6}); }

  function tryCopy(text){
    return new Promise(function(resolve){
      function legacy(){
        var ok = false, ta = document.createElement("textarea");
        ta.value = text; ta.setAttribute("readonly", ""); document.body.appendChild(ta); ta.select();
        try { ok = document.execCommand("copy") === true; } catch(e){ ok = false; }
        document.body.removeChild(ta); resolve(ok);
      }
      var cb = (typeof navigator !== "undefined") ? navigator.clipboard : null, p = null;
      if (cb && typeof cb.writeText === "function") { try { p = cb.writeText(text); } catch(e){ p = null; } }
      if (p && typeof p.then === "function") { p.then(function(){ resolve(true); }, legacy); return; }
      legacy();
    });
  }

  function plainSentence(d){
    return {
      en: "After " + d.n + (Number(d.n) === 1 ? " year, " : " years, ") + d.contributed + " in contributions grow to " + d.fv + " — the extra " + d.growth + " is compounding doing the work.",
      zh: d.n + " 年后，" + d.contributed + " 的投入增长至 " + d.fv + "——多出的 " + d.growth + " 来自复利。"
    };
  }

  function copyText(lang, d){
    if(lang === "zh"){
      return [
        "Mastermind 复利计算器（假设情景）",
        "输入：初始本金 " + d.principal + " · 每期投入 " + d.contrib + " · " + d.freq + " · 假设年化收益率 " + d.rate + "% · " + d.years + " 年",
        "结果：终值 " + d.fv + " · 合计投入 " + d.contributed + " · 增长 " + d.growth + " · 增长倍数 " + d.mult
      ].join("\n");
    }
    return [
      "Mastermind compound interest calculator (hypothetical scenario)",
      "Inputs: " + d.principal + " starting principal · " + d.contrib + " per period · " + d.freq + " · " + d.rate + "% assumed annual return · " + d.years + " years",
      "Result: " + d.fv + " future value · " + d.contributed + " total contributed · " + d.growth + " growth · " + d.mult + " growth multiple"
    ].join("\n");
  }

  // ── pure compute (CONTRACT §7 — ordinary annuity) ──────────────────────────
  function compute(inp){
    var P=inp.P, c=inp.c, f=inp.f, r=inp.r, n=inp.n;
    if(!(P>=0)) return {ok:false, msg:{en:"Enter a starting principal (0 or more).", zh:"请输入初始本金（0 或以上）。"}};
    if(!(c>=0)) return {ok:false, msg:{en:"Enter a contribution amount (0 or more).", zh:"请输入每期投入金额（0 或以上）。"}};
    if(!(f>0))  return {ok:false, msg:{en:"Select a contribution frequency.", zh:"请选择投入频率。"}};
    if(!(r>=0)) return {ok:false, msg:{en:"Enter an annual return rate (0 or more).", zh:"请输入年化收益率（0 或以上）。"}};
    if(!(n>=1)) return {ok:false, msg:{en:"Enter a holding period of at least 1 year.", zh:"请输入至少 1 年的持有期。"}};
    if(n>50)    return {ok:false, msg:{en:"The table is capped at 50 years.", zh:"表格最多显示 50 年。"}};
    var i = r / 100 / f;
    var m = Math.round(n * f);
    var pow = Math.pow(1 + i, m);
    var FV  = i === 0 ? (P + c * m) : (P * pow + c * (pow - 1) / i);
    var contributed = P + c * m;
    var growth = FV - contributed;
    // per-year table (whole years, plus fractional final row if n is non-integer)
    var rows = [];
    var nFloor = Math.floor(n);
    for(var yr=1; yr<=nFloor; yr++){
      var mm = Math.round(yr * f);
      var pw = Math.pow(1 + i, mm);
      var fvYr = i === 0 ? (P + c * mm) : (P * pw + c * (pw - 1) / i);
      var contYr = P + c * mm;
      rows.push({ year:yr, contributed:contYr, growth:fvYr-contYr, fv:fvYr });
    }
    // if n is non-integer, append a final row at exactly n years using the same
    // m=round(n*f) as the headline FV so the last point equals the headline
    if(n !== nFloor){
      rows.push({ year:n, contributed:contributed, growth:growth, fv:FV });
    }
    var overflowMsg = {en:"Those numbers are out of range — try a smaller horizon or return.", zh:"这些数字超出可计算范围——请缩短年限或降低回报率。"};
    if(!isFinite(FV) || Math.abs(FV) > LIMIT || !isFinite(contributed) || Math.abs(contributed) > LIMIT || !isFinite(growth) || Math.abs(growth) > LIMIT) return {ok:false, msg:overflowMsg, overflow:true};
    for(var ri=0; ri<rows.length; ri++){
      var row = rows[ri];
      if(!isFinite(row.fv) || Math.abs(row.fv) > LIMIT || !isFinite(row.contributed) || Math.abs(row.contributed) > LIMIT || !isFinite(row.growth) || Math.abs(row.growth) > LIMIT) return {ok:false, msg:overflowMsg, overflow:true};
    }
    var mult = contributed > 0 ? FV / contributed : null;
    return {ok:true, FV:FV, contributed:contributed, growth:growth, rows:rows, mult:mult};
  }

  // ── §6 self-check ──────────────────────────────────────────────────────────
  var WORKED_EXAMPLES = [
    { in:{P:10000, c:500, f:12, r:7, n:10}, want:{FV:106638.65} }
  ];
  (function selfCheck(){
    WORKED_EXAMPLES.forEach(function(ex, i){
      var got = compute(ex.in), w = ex.want, k;
      if(!got.ok){ console.error("compounding self-check "+i+": compute failed", got.msg.en); return; }
      for(k in w){ if(Math.abs(got[k] - w[k]) > 1){
        console.error("compounding self-check "+i+" mismatch on "+k+": got "+got[k]+" want "+w[k]); } }
    });
  })();

  // ── SVG curve ──────────────────────────────────────────────────────────────
  function curveGeometry(P, rows){
    var W=600, H=200, PL=40, PR=20, PT=24, PB=28;
    var cw=W-PL-PR, ch=H-PT-PB;
    var points = [{t:0, fv:P, contributed:P}];
    for(var i=0; i<rows.length; i++){
      points.push({t:rows[i].year, fv:rows[i].fv, contributed:rows[i].contributed});
    }
    var tMax = points[points.length-1].t;
    function xOf(t){ return PL + (t / tMax) * cw; }
    var maxY = 0;
    for(var j=0; j<points.length; j++){
      if(points[j].fv > maxY) maxY = points[j].fv;
      if(points[j].contributed > maxY) maxY = points[j].contributed;
    }
    function yOf(v){
      if(!(maxY > 0)) return PT + ch;
      return PT + ch - (v / maxY) * ch;
    }
    var pts = [];
    for(var k=0; k<points.length; k++){
      pts.push({
        x: Number(xOf(points[k].t).toFixed(1)),
        yFv: Number(yOf(points[k].fv).toFixed(1)),
        yC: Number(yOf(points[k].contributed).toFixed(1))
      });
    }
    function linePath(key){
      var d = "";
      for(var p=0; p<pts.length; p++){
        d += (p===0?"M":" L") + pts[p].x.toFixed(1) + "," + pts[p][key].toFixed(1);
      }
      return d;
    }
    var lineFv = linePath("yFv");
    var lineC = linePath("yC");
    var lastX = pts[pts.length-1].x.toFixed(1);
    var baseY = (PT + ch).toFixed(1);
    var areaFv = lineFv + " L" + lastX + "," + baseY + " L" + PL.toFixed(1) + "," + baseY + " Z";
    var areaC  = lineC  + " L" + lastX + "," + baseY + " L" + PL.toFixed(1) + "," + baseY + " Z";
    return {lineFv:lineFv, lineC:lineC, areaFv:areaFv, areaC:areaC, pts:pts};
  }

  var reducedMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  function clearCurve(){
    ["cp-area-fv","cp-area-c","cp-line-fv","cp-line-c"].forEach(function(id){
      document.getElementById(id).setAttribute("d", "");
    });
    document.getElementById("curve-wrap").style.display = "none";
  }
  function drawCurve(P, rows){
    var g = curveGeometry(P, rows);
    var lineFV = document.getElementById("cp-line-fv");
    var lineC  = document.getElementById("cp-line-c");
    document.getElementById("cp-area-fv").setAttribute("d", g.areaFv);
    document.getElementById("cp-area-c").setAttribute("d", g.areaC);
    lineFV.setAttribute("d", g.lineFv);
    lineC.setAttribute("d", g.lineC);

    if(!reducedMotion){
      var len = lineFV.getTotalLength ? lineFV.getTotalLength() : 600;
      lineFV.style.strokeDasharray = len;
      lineFV.style.strokeDashoffset = len;
      lineFV.style.transition = "stroke-dashoffset 1.2s cubic-bezier(.33,.62,.26,1) 100ms";
      requestAnimationFrame(function(){ lineFV.style.strokeDashoffset = 0; });
    }
    document.getElementById("curve-wrap").style.display = "";
  }

  // ── DOM wiring ──────────────────────────────────────────────────────────────
  document.addEventListener("DOMContentLoaded", function(){
    var $ = function(id){ return document.getElementById(id); };
    var els = { principal:$("principal"), contrib:$("contrib"), rate:$("rate"), years:$("years") };
    var outMain=$("out-main"), outPlain=$("out-plain"),
        outContrib=$("out-contrib"), outGrowth=$("out-growth"), outMult=$("out-mult"),
        tbody=$("year-tbody"), tableWrap=$("year-table-wrap"), seg=$("freq-seg"),
        copyBtn=$("copy-result"), copied=$("copied"),
        copyFallback=$("copy-fallback"), copyFallbackText=$("copy-fallback-text");
    var FIELD_ORDER = ["principal","contrib","rate","years"];
    var FIELD_UNITS = {principal:"num", contrib:"num", rate:"pct", years:"num"};
    var FIELD_LABELS = {
      principal:{en:"Starting principal", zh:"初始本金"},
      contrib:{en:"Contribution per period", zh:"每期投入"},
      rate:{en:"Annual return", zh:"年化收益率"},
      years:{en:"Years", zh:"年数"}
    };

    seg.addEventListener("click", function(e){
      var btn=e.target.closest("[data-v]"); if(!btn) return;
      [].forEach.call(seg.querySelectorAll("button"), function(b){ b.classList.remove("on"); });
      btn.classList.add("on"); freq=parseInt(btn.dataset.v,10); render();
    });

    function money(n){ return "$" + n.toLocaleString("en-US",{maximumFractionDigits:0}); }
    function dash(){ outMain.textContent="—"; [outContrib,outGrowth,outMult].forEach(function(e){e.textContent="—";}); }

    var last=null, lastInp=null;
    var FREQ_LABELS = {12:{en:"Monthly", zh:"每月"}, 4:{en:"Quarterly", zh:"每季"}, 1:{en:"Annual", zh:"每年"}};
    function render(){
      if(copyFallback) copyFallback.hidden = true;
      if(copyFallbackText) copyFallbackText.value = "";
      tableWrap.setAttribute("aria-label", curLang() === "zh" ? "逐年明细" : "Year-by-year breakdown");
      var firstFail = null;
      var parsed = {};
      FIELD_ORDER.forEach(function(id){
        var el = els[id];
        var pn = parseNum(el.value, FIELD_UNITS[id]);
        if(pn.ok){
          parsed[id] = pn.v;
          el.removeAttribute("aria-invalid");
          el.removeAttribute("aria-describedby");
        } else if(pn.why === "blank"){
          parsed[id] = NaN;
          el.removeAttribute("aria-invalid");
          el.removeAttribute("aria-describedby");
        } else {
          parsed[id] = NaN;
          el.setAttribute("aria-invalid", "true");
          el.setAttribute("aria-describedby", "out-plain");
          if(!firstFail) firstFail = {id:id, why:pn.why, el:el};
        }
      });
      if(firstFail){
        dash();
        tableWrap.style.display = "none";
        clearCurve();
        var lab = FIELD_LABELS[firstFail.id];
        var ph = firstFail.el.getAttribute("placeholder") || "";
        var en, zh;
        if(firstFail.why === "format"){
          en = lab.en + ": enter a number such as " + ph + ".";
          zh = lab.zh + "：请输入数字，例如 " + ph + "。";
        } else {
          en = lab.en + ": that number is too large to calculate.";
          zh = lab.zh + "：数字过大，无法计算。";
        }
        setBi(outPlain, en, zh);
        outPlain.className = "co-plain warn";
        last = {ok:false};
        return;
      }

      var inp={ P:parsed.principal, c:parsed.contrib, f:freq, r:parsed.rate, n:parsed.years };
      var res=compute(inp); last=res;
      if(!res.ok){
        dash();
        setBi(outPlain, res.msg.en, res.msg.zh);
        outPlain.className = res.overflow ? "co-plain warn" : "co-plain";
        tableWrap.style.display = "none";
        clearCurve();
        return;
      }

      outMain.textContent = money(res.FV);
      outContrib.textContent = money(res.contributed);
      outGrowth.textContent  = "$" + res.growth.toLocaleString("en-US",{maximumFractionDigits:0});
      outGrowth.className    = "pos";
      if(res.mult !== null){
        outMult.textContent = res.mult.toFixed(2) + "×";
      } else {
        setBi(outMult, "— enter a principal or contribution", "— 请输入本金或投入金额");
      }

      lastInp = {P:parsed.principal, c:parsed.contrib, r:parsed.rate, n:parsed.years, f:freq};
      var s = plainSentence({
        n: String(inp.n),
        contributed: "$" + res.contributed.toLocaleString("en-US",{maximumFractionDigits:0}),
        fv: money(res.FV),
        growth: "$" + res.growth.toLocaleString("en-US",{maximumFractionDigits:0})
      });
      setBi(outPlain, s.en, s.zh);
      outPlain.className = "co-plain";

      // render year table
      tbody.innerHTML = "";
      res.rows.forEach(function(r){
        var tr=document.createElement("tr");
        var yearLabel = Number.isInteger(r.year) ? r.year : r.year.toFixed(1);
        tr.innerHTML = '<td>'+yearLabel+'</td>' +
          '<td>'+money(r.contributed)+'</td>' +
          '<td class="pos-col">$'+r.growth.toLocaleString("en-US",{maximumFractionDigits:0})+'</td>' +
          '<td>'+money(r.fv)+'</td>';
        tbody.appendChild(tr);
      });
      tableWrap.style.display = "";

      drawCurve(inp.P, res.rows);
    }

    copyBtn.addEventListener("click", function(){
      if(!last || !last.ok || !lastInp) return;
      if(copyFallback) copyFallback.hidden = true;
      copied.classList.remove("show");
      var lang = curLang();
      var fl = FREQ_LABELS[lastInp.f] || FREQ_LABELS[12];
      var d = {
        principal: "$" + echoNum(lastInp.P),
        contrib: "$" + echoNum(lastInp.c),
        freq: lang === "zh" ? fl.zh : fl.en,
        rate: echoNum(lastInp.r),
        years: echoNum(lastInp.n),
        fv: outMain.textContent,
        contributed: outContrib.textContent,
        growth: outGrowth.textContent,
        mult: (last.mult !== null) ? outMult.textContent : "—"
      };
      var text = copyText(lang, d);
      tryCopy(text).then(function(ok){
        if(ok){
          copied.classList.add("show");
          setTimeout(function(){ copied.classList.remove("show"); }, 1600);
        } else {
          if(copyFallbackText){
            copyFallbackText.value = text;
            if(copyFallback) copyFallback.hidden = false;
            copyFallbackText.focus();
            copyFallbackText.select();
          }
        }
      });
    });

    document.addEventListener("langchange", function(){ render(); });

    ["principal","contrib","rate","years"].forEach(function(id){
      els[id].addEventListener("input", render);
    });
    render();
  });
})();
</script>
{% endblock %}
