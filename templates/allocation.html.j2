<!-- ══════════════════════════════════════════════════════════════════════
     FTR W3: Tape Panel (allocation page) — live complex read + movers + disagreement
     Composes with W1 shock banner above. Display/de-escalation only (FT-R1, FT-R2).
     FT-R12: suppressed when stale; FT-R3: T+1 fade note inline.
     Regions: us + hk only (each has a live pulse artifact: basket_pulse.json /
     basket_pulse_hk.json). china/canada have no pulse — rendering the US tape
     there was misleading (GAP-3), so the block is gated off.
     ══════════════════════════════════════════════════════════════════════ -->
{% if d.region in ('us', 'hk') %}
<div id="ftr-alloc-tape-panel" style="display:none;background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:11px 14px;margin:10px 0">
  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px">
    <span id="ftr-alloc-session-pill" style="display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;padding:3px 9px;border-radius:16px"></span>
    <span style="font-size:13px;font-weight:700;color:var(--text)">{{ t('Live Basket Tape','实时篮子行情') }}</span>
    <span style="font-size:11px;color:var(--muted)">{{ t('15-min delayed','15分钟延迟') }}</span>
    <span id="ftr-alloc-cx-chip" style="margin-left:auto"></span>
    <span id="ftr-alloc-asof" style="font-size:11px;color:var(--muted)"></span>
  </div>
  <div id="ftr-alloc-movers" style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:12px"></div>
  <div id="ftr-alloc-disagree" style="margin-top:8px;font-size:12px;color:var(--muted)"></div>
  <!-- T+1 fade note (FT-R3): plain words at a glance; technical receipt in the ? tip (docs/DESIGN_DOCTRINE.md).
       The n=26 fade base rate was measured on US baskets — never claim it for another market
       (epistemics law), so HK gets the plain no-stat framing. -->
  {% if d.region == 'us' %}
  <div style="margin-top:6px;font-size:10.5px;color:var(--muted);font-style:italic"><span class="l-en">Not a buy signal: sharp one-day flips usually don&#39;t hold &mdash; in 26 past cases about 6 in 10 faded within a day.</span><span class="l-zh">非买入信号：剧烈的单日反转多难持续 — 历史26次中约六成在一天内消退。</span> <span style="display:inline-flex;align-items:center;justify-content:center;width:14px;height:14px;border-radius:50%;border:1px solid var(--line);color:var(--muted);font-size:9.5px;font-weight:700;cursor:help;line-height:1;vertical-align:middle;font-style:normal" data-tip-en="Technical receipt: T+1 violent-flip base rate 58% fade (n=26) · not a directional signal · display tier only." data-tip-zh="技术说明：T+1剧烈反转基础概率58%消退（n=26）· 非方向信号 · 仅展示层。">?</span></div>
  {% else %}
  <div style="margin-top:6px;font-size:10.5px;color:var(--muted);font-style:italic"><span class="l-en">Not a buy signal: a one-session move is tape, not trend &mdash; the strategic view above updates on the daily close.</span><span class="l-zh">非买入信号：单一交易时段的波动只是行情，并非趋势 — 上方战略视图按日收盘更新。</span></div>
  {% endif %}
</div>
<script>
(function(){
'use strict';
function isZh(){return document.documentElement.getAttribute('data-lang')==='zh';}
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function L(en,zh){return'<span class="l-en">'+en+'</span><span class="l-zh">'+(zh==null?en:zh)+'</span>';}
function fmtPct(v){if(v==null)return'—';return(v>=0?'+':'')+v.toFixed(2)+'%';}
var SESSION_LABELS={pre:{cls:'pre',en:'PREMARKET',zh:'盘前'},rth:{cls:'rth',en:'LIVE · RTH',zh:'实盘'},post:{cls:'post',en:'POST-MARKET',zh:'盘后'},closed:{cls:'closed',en:'CLOSED',zh:'休市'}};
var SESSION_COLORS={pre:'rgba(79,140,255,.12),rgba(79,140,255,.32),var(--link)',rth:'rgba(35,192,138,.14),rgba(35,192,138,.38),var(--up)',post:'rgba(139,147,167,.10),var(--line),var(--muted)',closed:'rgba(139,147,167,.08),var(--line),var(--muted)'};
// Mode pill label for non-live reads (TS-R1)
function modePillLabel(mode,delay){
  if(mode==='delayed'){
    var h=delay!=null?Math.round(delay/60):null;
    return L('DELAYED'+(h!=null?' ~'+h+'h':''),'延迟数据'+(h!=null?' ~'+h+'小时':''));
  }
  if(mode==='last_rth')return L('LAST SESSION','上一交易时段');
  if(mode==='eod')return L('EOD CLOSE','收盘价');
  return '';
}
// Display-name map (Law 2: never raw slugs; prettified fallback never blocks render)
var NAMEMAP={};
function _slugName(id){return String(id||'').replace(/_/g,' ').replace(/\b\w/g,function(c){return c.toUpperCase();});}
function nameEnOf(id){return (NAMEMAP[id]&&NAMEMAP[id].en)||_slugName(id);}
function nameZhOf(id){return (NAMEMAP[id]&&NAMEMAP[id].zh)||_slugName(id);}
fetch('{{ {"us":"basketdata","china":"chinabasketdata","hk":"hkbasketdata","canada":"canadabasketdata"}.get(d.region,"basketdata") }}/baskets.json',{cache:'no-cache'})
  .then(function(r){if(!r.ok)throw 0;return r.json();})
  .then(function(d){
    ((d&&d.baskets)||[]).forEach(function(b){
      if(b.id){ NAMEMAP[b.id]={en:b.name||_slugName(b.id), zh:b.name_zh||b.name||_slugName(b.id)}; }
    });
  })
  .catch(function(){/* absent names file → prettified-slug fallback */})
  .then(function(){ return fetch('live/{{ "basket_pulse_hk.json" if d.region == "hk" else "basket_pulse.json" }}',{cache:'no-cache'}); })
  .then(function(r){if(!r.ok)throw 0;return r.json();})
  .then(function(pulse){
    var panel=document.getElementById('ftr-alloc-tape-panel');
    if(!panel||!pulse)return;
    panel.style.display='';
    var session=pulse.session||'closed';
    var mode=pulse.mode||'live';
    var chipSuppressed=(mode!=='live');
    var hasAnyValue=(pulse.baskets||[]).some(function(b){return b.live_ew_chg_pct!=null;});
    if(!hasAnyValue){panel.style.opacity='0.65';}
    // Session pill
    var pillEl=document.getElementById('ftr-alloc-session-pill');
    if(pillEl){
      var si=SESSION_LABELS[session]||SESSION_LABELS.closed;
      var sc=SESSION_COLORS[session]||SESSION_COLORS.closed;
      var cols=sc.split(',');
      pillEl.style.background=cols[0]||'';
      pillEl.style.border='1px solid '+(cols[1]||'var(--line)');
      pillEl.style.color=cols[2]||'var(--muted)';
      pillEl.innerHTML=L(esc(si.en),esc(si.zh));
    }
    // as-of + mode label (TS-R1: never hide data when a stamped read exists)
    var asofEl=document.getElementById('ftr-alloc-asof');
    if(asofEl){
      var asofSrc=pulse.as_of_quotes||pulse.as_of_utc;
      var tsStr='';
      if(asofSrc){
        try{
          tsStr=asofSrc.length<=10?asofSrc:new Date(asofSrc).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit',timeZoneName:'short'});
        }catch(e){tsStr=asofSrc;}
      }
      var modeLabel=modePillLabel(mode,pulse.delay_min_median);
      asofEl.innerHTML=(tsStr?L('as of '+esc(tsStr),'截至 '+esc(tsStr)):'')
        +(modeLabel?' <span style="display:inline-block;padding:1px 6px;border-radius:5px;font-size:9.5px;border:1px solid var(--line);color:var(--muted)">'+modeLabel+'</span>':'');
    }
    // AI-capex complex chip: only in live mode (FT-R12)
    var cxEl=document.getElementById('ftr-alloc-cx-chip');
    if(cxEl&&!chipSuppressed){
      var cx=(pulse.complexes||[]).find(function(c){return c.complex_id==='ai_capex';});
      if(cx&&cx.live_ew_chg_pct!=null){
        var chg=cx.live_ew_chg_pct; var isG=chg>=0;
        cxEl.innerHTML='<span style="display:inline-flex;align-items:center;gap:6px;padding:3px 9px;border-radius:7px;background:'+(isG?'rgba(35,192,138,.10)':'rgba(255,92,108,.07)')+';border:1px solid '+(isG?'rgba(35,192,138,.28)':'rgba(255,92,108,.25)')+';">'
          +'<span style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em">'+L('AI-Capex','AI资本开支')+'</span>'
          +'<span style="font-size:14px;font-weight:800;font-variant-numeric:tabular-nums;color:'+(isG?'var(--up)':'var(--down)')+'">'+fmtPct(chg)+'</span>'
          +(cx.only_green_complex?'<span style="font-size:10px;color:'+(isG?'var(--up)':'var(--down)')+'">'+L('only green complex','唯一上涨复合板块')+'</span>':'')
          +'</span>';
      }
    }
    // Top 3 movers: shown in all modes when values exist (TS-R1 honest-delay law)
    var live=(pulse.baskets||[]).filter(function(b){return b.live_ew_chg_pct!=null&&b.tape_rank!=null;});
    var stratLeaderName='{{d.headline.name if d.headline else ""}}';
    var stratLeaderId='{{d.headline.id if d.headline else ""}}';
    if(live.length){
      live.sort(function(a,b){return b.tape_rank-a.tape_rank;});
      var n=live.length;
      var top3=live.slice(0,3),bot3=live.slice(-3).reverse();
      // Mover rows — .dtp idiom laws (#2208 / docs/DESIGN_DOCTRINE.md §3):
      // display names (never slugs), honest shared-scale bars, no rank numbers.
      var shown=top3.concat(bot3);
      var maxAbs=0;
      shown.forEach(function(b){var a=Math.abs(b.live_ew_chg_pct);if(a>maxAbs)maxAbs=a;});
      if(!maxAbs)maxAbs=1;
      function mrow(b){
        var isUp=b.live_ew_chg_pct>=0;
        var barW=Math.max(6,Math.round(Math.abs(b.live_ew_chg_pct)/maxAbs*44));
        // Region-aware theme link (mirrors the lifecycle-board rule): US has
        // per-basket detail pages; HK deep-links into baskets_hk.html anchors.
        var href={% if d.region == 'us' %}'basket/'+esc(b.id)+'.html'{% else %}'baskets_hk.html#b-'+esc(b.id){% endif %};
        return '<div style="display:flex;align-items:center;gap:6px;padding:2px 0">'
        +'<a href="'+href+'" style="flex:1;font-weight:500;color:inherit;text-decoration:none;min-width:0">'+L(esc(nameEnOf(b.id)),esc(nameZhOf(b.id)))+'</a>'
        +'<span style="font-weight:700;font-variant-numeric:tabular-nums;color:'+(isUp?'var(--up)':'var(--down)')+'">'+fmtPct(b.live_ew_chg_pct)+'</span>'
        +'<span style="width:44px;flex:none"><span style="display:inline-block;height:3px;border-radius:2px;min-width:6px;width:'+barW+'px;background:'+(isUp?'var(--up)':'var(--down)')+';opacity:.65"></span></span>'
        +'</div>';}
      var moversEl=document.getElementById('ftr-alloc-movers');
      if(moversEl){
        moversEl.innerHTML='<div><div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--ink-up, var(--up));margin-bottom:4px">'+L('Top 3 leaders','前3领涨')+'</div>'
          +top3.map(function(b){return mrow(b);}).join('')+'</div>'
          +'<div><div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--ink-down, var(--down));margin-bottom:4px">'+L('Bottom 3 laggards','后3领跌')+'</div>'
          +bot3.map(function(b){return mrow(b);}).join('')+'</div>';
      }
      // Disagreement vs strategic leader: only in live mode (FT-R12).
      // Plain words at a glance; the tape-rank receipt lives in the data-tip (Tier 2).
      if(!chipSuppressed&&stratLeaderId){
        var lb=live.find(function(b){return b.id===stratLeaderId;});
        if(lb){
          var leadRank=lb.tape_rank;
          var isLeaderLagging=leadRank!=null&&leadRank<n*0.33;
          if(isLeaderLagging){
            var dEl=document.getElementById('ftr-alloc-disagree');
            if(dEl)dEl.innerHTML='<span style="display:inline-flex;align-items:center;gap:5px;padding:2px 8px;border-radius:5px;background:rgba(251,146,60,.10);border:1px solid rgba(251,146,60,.38);color:var(--amber,#fb923c)" data-tip-en="Receipt: strategic leader tape rank '+leadRank+' of '+n+' this session. The allocation view is a deliberately slow 3-12 month construction · display tier, never reorders the allocation." data-tip-zh="技术说明：战略领跑者本时段行情排名 '+leadRank+'/'+n+'。配置视图为有意放慢的3-12个月构建 · 仅展示层，不改变配置。">'
              +L('Today&#39;s tape disagrees: the strategic pick is near the bottom of today&#39;s board — normal for a slow view; don&#39;t react to one session.',
                 '今日行情与战略选择相左：战略领跑者今日排名靠后 — 慢视角下属正常，勿因单日行情调整。')
              +'</span>';
          }
        }
      }
    }
  }).catch(function(){/* absent file → panel stays hidden */});
})();
</script>
{% endif %}{# FTR W3 tape panel — us/hk regions only #}

{% if d.allocation.crash_overlay.active %}
<div class="banner crash">{{ icon('alert', 'bic') }} <b>{{ t('Momentum-crash state', '动量崩盘状态') }}</b> — {{ t(
	  'broad trend is broken and volatility is high. Exposure is cut to cash.',
	  '大盘趋势破坏且波动偏高。敞口已降至现金。') }}</div>
{% endif %}

{% if d.rotation.one_narrative %}
<div class="banner dom">{{ icon('magnet', 'bic') }} <b>{{ t('One narrative vs everything', '单一叙事 vs 其他') }}</b> ({{ t('absorption', '共动') }} {{ (d.rotation.absorption*100)|round|int }}%) — {{ t(
	  'leadership is concentrated. The leader is capped; the rest goes to broadening themes.',
	  '领跑集中。领跑者封顶，其余配置给正在扩散的主题。') }}</div>
{% endif %}

<!-- ============ 01 SUGGESTED ALLOCATION ============ -->
<h2><span class="idx">01</span>{{ t('Suggested allocation', '建议配置') }}</h2>
{#- The rule sentence is MECHANICS, so it belongs on Tier 2 (DOCTRINE §1). It used
    to be printed at rest through `|truncate(150)`, which cut it mid-word — "…so
    t…" — the exact failure Law 4 names: if the copy does not fit the budget the
    content is mis-tiered, so demote it rather than compressing it. Tier 1 keeps a
    one-line plain statement of what the board is; the full rule is one hover away
    and is no longer truncated at all. -#}
<p class="sub">{{ t('The four themes with the strongest trend, held equally, one per family.',
                    '趋势最强的四个主题，等权持有，每个族系只取一个。') }}
