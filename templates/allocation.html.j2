{% if B.sectors.tsmom %}<p class="tagline"><b>{{ t('Technical receipt:','技术明细：') }}</b> Sharpe {{ B.sectors.tsmom.above_trend.sharpe }} {{ t('above trend vs','趋势上方 vs') }} {{ B.sectors.tsmom.below_trend.sharpe }} {{ t('below trend','趋势下方') }} · {{ t('bad-month tail','坏月尾部') }} {{ (B.sectors.tsmom.above_trend.p05*100)|round(1) }}% vs {{ (B.sectors.tsmom.below_trend.p05*100)|round(1) }}%.</p>{% endif %}
{% if B.verdict %}{% set VPLAIN={'relative_momentum':('Useful for focus, not a return forecast.','用于确定关注重点，不是收益预测。'),'absolute_trend_gate':('Main historical benefit: lower volatility and shallower drawdowns.','主要历史作用：降低波动并减轻回撤。'),'basket_extension':('Crowding is context, not a sell signal.','拥挤度是背景信息，不是卖出信号。'),'rotation_timing':('Wait for confirmed leadership changes; do not predict the next theme.','等待领涨变化确认，不预测下一个主题。')} %}<div class="verdict">{% for k,lab,labzh in [('relative_momentum','Momentum rank','动量排名'),('absolute_trend_gate','Trend filter','趋势过滤'),('basket_extension','Basket crowding','篮子拥挤'),('rotation_timing','Leadership timing','领涨时机')] %}{% if B.verdict.get(k) %}<div class="vcard"><b>{{ t(lab,labzh) }}</b><br><span class="muted">{{ t(VPLAIN[k][0],VPLAIN[k][1]) }}</span></div>{% endif %}{% endfor %}</div>{% endif %}
</details></div>
