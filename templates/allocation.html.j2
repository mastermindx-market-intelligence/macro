     permanently off-screen on a phone. The row re-composes instead of squeezing. */
  @media(max-width:640px){.arow{flex-wrap:wrap}.arow .nm{flex:1 1 100%;white-space:normal}.arow .bar{flex:1 1 auto;min-width:0}}
</style>
