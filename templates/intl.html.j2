            {%- if em_hy_vel is none %}
            {{ t('Unavailable', '不可用') }}
            {%- elif em_hy_vel > 0.1 %}
            {{ t('Above usual 20d change', '20日变动高于常态') }}
            {%- elif em_hy_vel < -0.1 %}
            {{ t('Below usual 20d change', '20日变动低于常态') }}
