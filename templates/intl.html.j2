            {{ t('Near usual 20d change', '20日变动接近常态') }}
            {%- endif %}
          </div>
          <div class="muted small" data-credit-observation>{{ t('Observed:', '观测日：') }}<br>{{ em_hy.get('asof')|e if em_hy.get('asof') else t('Unavailable', '不可用') }}</div>
        </div>
        <!-- Asia -->
        {%- set asia_v = asia_oas.get('value') %}
