    <!-- WHAT'S DRIVING THE DOLLAR -->
    <div class="panel">
      <div class="sec-h">
        <h2 id="intl-dollar-conditions">{{ t('Dollar rate-model read', '美元利差模型读数') }}
          {%- if sm_regime_known %}
            {{ help(('120-observation rolling regression of daily DXY log returns on changes in the US-minus-foreign rate spread. The score is the 20-observation residual sum divided by its trailing, up-to-252-observation standard deviation, without subtracting the mean. The 60-observation normalization is a separate sensitivity check, not confirmation. The five-day flag is separate. Actual available-basket weights, not causal contributions: ' + (SM.get('weights_used')|string if SM.get('weights_used') else 'Unavailable') + '. GBP uses a short-rate proxy; basket coverage and tenors differ.')|e, ('以120个观测值滚动回归每日DXY对数收益与美国减外国利差的变动。分数为20个观测值的残差之和，除以最多252个历史观测值的标准差，分子不减均值。60个观测值的标准化是独立敏感性检查，并非确认。5日标志独立。可用利率篮子的实际权重，并非因果贡献：' + (SM.get('weights_used')|string if SM.get('weights_used') else '不可用') + '。英国使用短期利率代理，篮子覆盖范围与期限不同。')|e) }}
          {%- else %}
            {{ help('No supported regime was supplied. A page build or a separate five-day signal cannot supply the missing model read or observation date.', '未提供可用制度读数。页面生成时间或独立5日信号不能补足缺失的模型读数或观测日。') }}
          {%- endif %}
        </h2>
        <span class="sub">{{ t('Residual model · separate from the five-day signal', '残差模型·与5日信号分开解读') }}</span>
      </div>

      <div class="ird-dollar-card">
        {%- if sm_regime_known %}
          {%- set regime = SM.get('regime', '') %}
          {%- if regime == 'rates-driven' %}
            <div class="regime-word">{{ t('Within residual band', '残差在区间内') }}</div>
            <div class="regime-sentence">{{ t('The cumulative residual is within one trailing standard deviation of zero (|z| < 1). This classification does not establish the cause of the dollar move.', '累计残差在零值上下一个历史标准差以内（|z| < 1）。此分类不能确定美元走势的原因。') }}</div>
          {%- elif regime == 'safety-driven' %}
            <div class="regime-word">{{ t('Above rate model', '高于利差模型') }}</div>
            <div class="regime-sentence">{{ t('The cumulative residual is positive and at least one trailing standard deviation (z ≥ 1). This classification does not establish the cause of the dollar move.', '累计残差为正，且至少达到一个历史标准差（z ≥ 1）。此分类不能确定美元走势的原因。') }}</div>
          {%- else %}
            <div class="regime-word">{{ t('Below rate model', '低于利差模型') }}</div>
            <div class="regime-sentence">{{ t('The cumulative residual is negative and at least one trailing standard deviation in magnitude (z ≤ −1). This classification does not establish the cause of the dollar move.', '累计残差为负，且绝对值至少达到一个历史标准差（z ≤ −1）。此分类不能确定美元走势的原因。') }}</div>
          {%- endif %}
          {%- if safety_bid %}
          <div style="margin-bottom:10px;">
            <span class="ird-safety-tag">
              ⚠ {{ t('Five-day flag', '5日标志') }}
              {%- if dxy5d is not none and dgs2_5d is not none %}
                {{ t(': DXY ' + ('+%.1f pts' | format(dxy5d) if dxy5d >= 0 else '%.1f pts' | format(dxy5d)) + ' while 2yr fell ' + ('%.1f bp' | format(dgs2_5d|abs)), '：DXY ' + ('+%.1f点' | format(dxy5d) if dxy5d >= 0 else '%.1f点' | format(dxy5d)) + '，2年期下降' + ('%.1f bp' | format(dgs2_5d|abs))) }}
              {%- endif %}
            </span>
            <span class="small muted" style="margin-left:8px;">{{ t('5-day signal · not structural', '5日信号·非结构性') }}</span>
          </div>
          {%- endif %}
        {%- else %}
          {# Honest null — smile is absent #}
          <div class="ird-dollar-null">
            {{ t('Unavailable — no supported dollar regime is supplied.', '不可用——未提供有效的美元制度读数。') }}
          </div>
          {%- if safety_bid %}
          <div style="margin-top:10px;">
            <span class="ird-safety-tag">
              ⚠ {{ t('Five-day flag', '5日标志') }}
              {%- if dxy5d is not none and dgs2_5d is not none %}
                {{ t(': DXY ' + ('+%.1f pts' | format(dxy5d) if dxy5d >= 0 else '%.1f pts' | format(dxy5d)) + ' while 2yr fell ' + ('%.1f bp' | format(dgs2_5d|abs)), '：DXY ' + ('+%.1f点' | format(dxy5d) if dxy5d >= 0 else '%.1f点' | format(dxy5d)) + '，2年期下降' + ('%.1f bp' | format(dgs2_5d|abs))) }}
              {%- endif %}
            </span>
            <div class="small muted" style="margin-top:6px;">{{ t('DXY rose while US 2-year yields fell over the past 5 days. This separate observation does not establish a cause or confirm a regime.', '过去5天内DXY上涨而美国2年期收益率下降。此独立观察不能确定原因，也不代表制度确认。') }}</div>
          </div>
          {%- endif %}
        {%- endif %}
      </div>
      <p class="caveat ird-asof">
        {%- if sm_regime_known %}
          {{ t('Model built: ' + ((SM.get('built') or 'Unavailable')|string|e), '模型生成：' + ((SM.get('built') or '不可用')|string|e)) }}<br>
          {{ t('Observation date: Unavailable', '观测日：不可用') }}
        {%- else %}
          {{ t('Dollar regime unavailable in supplied data.', '所提供数据中的美元制度不可用。') }}
        {%- endif %}
      </p>
    </div><!-- /dollar -->

  </div><!-- /right col -->

</div><!-- /ird-twocol -->

<!-- ===== FRAGILITY MAP (FULL WIDTH) ===== -->
<div class="panel">
  <div class="sec-h">
    <h2 id="intl-structural-fragility" tabindex="-1">{{ t('Fragility map', '脆弱性地图') }}
      {{ help('Flags countries where structural vulnerabilities coincide: debt-to-GDP above 70% and rising, fiscal deficit below −5% of GDP, or current account deficit below −3% of GDP. BIS credit gap where available. Inputs: IMF WEO and BIS where available; coverage may be partial. Countries with at least three concurrent flags are shown. The source edition and publication date are not supplied here. Berg &amp; Pattillo (1999) criterion adapted. Presence of a flag = vulnerabilities exist, not that a crisis is imminent; most historically flagged countries did not experience a crisis.', '标记存在结构性脆弱因素的国家：债务/GDP超过70%且上升、财政赤字低于GDP的−5%，或经常账户赤字低于GDP的−3%。BIS信用缺口（可用时）。输入：IMF WEO与可用的BIS数据；覆盖可能不完整。展示至少有三项并发预警的国家。此处未提供来源版本或发布日期。改编自Berg &amp; Pattillo（1999）标准。有标记 = 脆弱性存在，不代表危机即将发生；历史上大多数预警未演变为危机。') }}</h2>
    <span class="sub">{{ t('Slow-moving structural vulnerabilities — not a timing signal', '缓慢变化的结构性脆弱因素——非择时信号') }}</span>
  </div>

  {%- set VULN = RD.get('vulnerability') %}
  {%- if VULN and VULN.get('countries') %}
    {%- set flagged = VULN.get('countries') | selectattr('fragile', 'equalto', true) | list %}
    <p class="muted" style="font-size:13px;line-height:1.6;padding:12px 0;">
      {{ t('Countries with supplied data: ' ~ (VULN.get('countries')|length) ~ ' · flagged: ' ~ (flagged|length) ~ '.', '已提供数据的国家：' ~ (VULN.get('countries')|length) ~ ' · 预警国家：' ~ (flagged|length) ~ '。') }}
      {{ t('Incomplete inputs do not establish an all-clear.', '缺失输入不代表已全面排除预警。') }}
    </p>
    {%- if not flagged %}
    <p class="muted" style="font-size:13px;line-height:1.6;padding:12px 0;">
      {{ t('No supplied country has three or more flags. This describes the available sample only.', '所提供行均未达到三项预警。这仅描述可用样本。') }}
    </p>
    {%- endif %}
    {%- for c in flagged[:3] %}
    <div class="ird-frag-row">
      <span style="font-size:20px;flex-shrink:0;">{{ c.get('flag', '🌐') }}</span>
      <div>
        <div class="ird-frag-country">{{ t(c.get('name_en', c.get('cc','')), c.get('name_zh', c.get('cc',''))) }}</div>
        <span class="ird-frag-desc">{{ t(c.get('desc_en', ''), c.get('desc_zh', '')) }}</span>
        <div class="ird-frag-tags">
          {%- for tag in c.get('tags', []) %}
          <span class="chip warn" style="font-size:10px;padding:1px 6px;">{{ t(tag.get('en',''), tag.get('zh','')) }}</span>
          {%- endfor %}
        </div>
      </div>
    </div>
    {%- endfor %}
    {%- if flagged | length > 3 %}
    <details style="margin-top:8px;">
      <summary class="more-btn" style="list-style:none;cursor:pointer;">
        {{ t('View all ' + (flagged|length|string) + ' flagged countries →', '查看全部' + (flagged|length|string) + '个预警国家 →') }}
      </summary>
      <div style="margin-top:8px;">
        {%- for c in flagged[3:] %}
        <div class="ird-frag-row">
          <span style="font-size:20px;flex-shrink:0;">{{ c.get('flag', '🌐') }}</span>
          <div>
            <div class="ird-frag-country">{{ t(c.get('name_en', c.get('cc','')), c.get('name_zh', c.get('cc',''))) }}</div>
            <span class="ird-frag-desc">{{ t(c.get('desc_en',''), c.get('desc_zh','')) }}</span>
            <div class="ird-frag-tags">
              {%- for tag in c.get('tags', []) %}
              <span class="chip warn" style="font-size:10px;padding:1px 6px;">{{ t(tag.get('en',''), tag.get('zh','')) }}</span>
              {%- endfor %}
            </div>
          </div>
        </div>
        {%- endfor %}
      </div>
    </details>
    {%- endif %}
  {%- else %}
    {# vulnerability is null — honest null with plain-words explanation #}
    <p class="muted" style="font-size:13px;line-height:1.6;padding:12px 0;">
      {{ t('Fragility readings unavailable in supplied data. No coverage or delivery date is established here.', '所提供数据中的脆弱性读数不可用。此处未确立覆盖范围或交付日期。') }}
    </p>
  {%- endif %}

  <p class="caveat ird-asof">
    {{ t('Slow-moving fundamentals — flags fragility, not timing; most historical warnings did not become crises.', '缓慢变化的基本面指标——揭示脆弱性，非择时信号；历史上大多数预警并未演变为危机。') }}
    {{ help('Berg &amp; Pattillo (1999) criterion adapted: debt &gt;70% GDP and rising, fiscal balance &lt;−5%, current account &lt;−3%. Inputs: IMF WEO and BIS credit gap where available. Partial fields and different field years may occur; this is not a source-release clock.', 'Berg &amp; Pattillo（1999）改编标准：债务&gt;70% GDP且上升，财政余额&lt;−5%，经常账户&lt;−3%。输入：IMF WEO与可用的BIS信用缺口。字段可能缺失且年份不同；这不是来源发布时间。') }}
    {%- set frag_years = (VULN or {}).get('as_of_years') or {} %}
    {%- if frag_years.get('min') is integer and frag_years.get('max') is integer %}
      {{ t('Latest year within each country: ' ~ frag_years.get('min') ~ '–' ~ frag_years.get('max'), '各国所含的最新年份：' ~ frag_years.get('min') ~ '–' ~ frag_years.get('max')) }}
    {%- else %}
      {{ t('Latest year within each country: Unavailable', '各国所含的最新年份：不可用') }}
    {%- endif %}
    {{ t('Underlying values can have different years and include projections. This is not a publication date.', '底层数据年份可能不同，也可能包含预测值。这不是发布日期。') }}
  </p>
</div><!-- /fragility -->

{% endif %}{# end risk_desk section #}

{# ── CGL Directed Pressure Table (CGL W1, 2026-07-17).
   Shows supplied model pressure — one row per market, sorted by
   pressure pct descending. Outer guard: CGL is defined AND non-empty. Renders
   NOTHING when the artifact is absent (progressive enhancement; zero visual
   change to existing layout). Plain-word glance tier only: no "GFEVD", "VAR",
   "spillover matrix", no raw percentile numbers. Level → Low/Building/High pill.
   Receipts (linkage weight) live in the chip labels — each chip shows the source
   name and weight%. Nulls-printed: data gaps disclosed in a footer line. #}
{% if CGL is defined and CGL and mode != 'stocks' %}
{#- helpers -#}
{%- set _cgl_pressure = CGL.pressure if CGL.pressure is defined else {} -%}
{%- set _cgl_severity = CGL.severity if CGL.severity is defined else {} -%}
{%- set _cgl_gaps = CGL.gaps if CGL.gaps is defined else [] -%}
{#- market display names EN/ZH — covers all 11 CGL markets -#}
{%- set _cgl_mkt_names = {
  'us': ('United States', '美国'),
  'cn': ('China',         '中国'),
  'hk': ('Hong Kong',     '香港'),
  'ca': ('Canada',        '加拿大'),
  'kr': ('South Korea',   '韩国'),
  'jp': ('Japan',         '日本'),
  'tw': ('Taiwan',        '台湾'),
  'in': ('India',         '印度'),
  'au': ('Australia',     '澳大利亚'),
  'gb': ('United Kingdom','英国'),
  'ez': ('Euro area',     '欧元区')
} -%}
{#- collect + sort rows by pct desc -#}
{%- set _cgl_rows = namespace(v=[]) -%}
{%- for mkt, blk in _cgl_pressure.items() -%}
  {%- if blk -%}
    {%- set _pct = blk.pct if (blk.pct is defined and blk.pct is number and blk.pct is not boolean and 0 <= blk.pct <= 1) else -1 -%}
    {%- set _cgl_rows.v = _cgl_rows.v + [{'mkt': mkt, 'blk': blk, 'pct': _pct}] -%}
  {%- endif -%}
{%- endfor -%}
{%- set _cgl_sorted = _cgl_rows.v | sort(attribute='pct', reverse=true) -%}
<div class="panel">
  <div class="sec-h">
    <h2 id="intl-trade-supply-links" tabindex="-1">{{ t('Supplied crash-pressure readings', '所提供的冲击压力读数') }}
      {{ help('The model combines preset linkage weights with ETF volatility-model weights where available, then applies a score from each source’s 21-observation drawdown and 10-observation loss. A rebound can still carry pressure. Historical bands use up to 504 pressure observations and need at least 252. Source percentages are linkage weights; source order uses weight × loss score. These are model estimates, not causal transmission shares and not a forecast. Inputs may cover different dates; missing inputs can reduce coverage.', '模型结合预设关联权重与可用的ETF波动率模型权重，再应用各来源的21期回撤和10期跌幅评分。反弹时仍可能保留压力。历史区间最多采用504期压力观测，至少需要252期。来源百分比是关联权重；来源顺序按权重乘以跌幅评分排列。这些是模型估计，并非因果传导占比，也不是预测。输入日期可能不同；缺失输入会限制覆盖。') }}</h2>
    <span class="sub">{{ t('Modelled pressure from linked markets’ recent drawdowns and losses', '关联市场近期回撤与跌幅的模型压力') }}</span>
  </div>
  {%- if _cgl_sorted %}
  <p class="muted small">{{ t('Levels compare pressure with its history. A missing historical comparison is not a low reading.', '等级将压力与其历史比较。缺少历史比较不代表压力低。') }}</p>
  <p class="muted small">{{ t('Source percentages are linkage weights, not shares of pressure. Levels are historical bands, not a trend.', '来源百分比是关联权重，并非压力占比。等级是历史区间，并非趋势。') }}</p>
  <div style="margin-top:8px;">
    {%- for row in _cgl_sorted %}
    {%- set mkt = row.mkt -%}
    {%- set blk = row.blk -%}
    {%- set _names = _cgl_mkt_names.get(mkt, (mkt, mkt)) -%}
    {%- set _lv = blk.level if (row.pct >= 0 and blk.level is defined and blk.level in ['low', 'moderate', 'high']) else 'unknown' -%}
    {%- set _lv_chip = 'warn' if _lv == 'high' else ('caut' if _lv == 'moderate' else ('ok' if _lv == 'low' else '')) -%}
    {%- set _svr = _cgl_severity.get(mkt, {}) -%}
    {%- set _is_source = _svr and (_svr.sigma is defined) and (_svr.sigma is not none) and (_svr.sigma >= 0.5) -%}
    <div class="ird-tx-row" style="align-items:center;gap:8px;padding:5px 0;border-bottom:1px solid var(--line);">
      <span style="min-width:120px;font-size:12.5px;font-weight:600;">
        <span class="l-en">{{ _names[0] }}</span><span class="l-zh">{{ _names[1] }}</span>
      </span>
      <span class="chip {{ _lv_chip }}" style="font-size:10px;padding:1px 6px;white-space:nowrap;">
        {%- if _lv == 'high' %}<span class="l-en">High</span><span class="l-zh">高</span>
        {%- elif _lv == 'moderate' %}<span class="l-en">Building</span><span class="l-zh">升温</span>
        {%- elif _lv == 'low' %}<span class="l-en">Low</span><span class="l-zh">低</span>
        {%- else %}<span class="l-en">Unavailable</span><span class="l-zh">不可用</span>
        {%- endif %}
      </span>
      {%- if row.pct >= 0 %}
      <div class="ird-tx-bar-wrap" style="flex:1;min-width:40px;max-width:90px;">
        <div class="ird-tx-bar" style="width:{{ (row.pct * 100) | round | int }}%"></div>
      </div>
      {%- endif %}
      {%- if blk.top_exporters is defined and blk.top_exporters %}
      <span style="display:flex;flex-wrap:wrap;gap:3px;flex:1 1 120px;min-width:0;">
        {%- for exp in blk.top_exporters[:3] %}
        {%- set _en = exp.name_en if (exp.name_en is defined and exp.name_en) else (exp.market if exp.market is defined else '?') -%}
        {%- set _zh = exp.name_zh if (exp.name_zh is defined and exp.name_zh) else _en -%}
        {%- set _wt = ((exp.weight * 100) | round(0) | int | string ~ '%') if (exp.weight is defined and exp.weight is not none) else '' -%}
        <span class="rrx-rec-chip" style="font-size:10px;">
          <span class="l-en">{{ _en }}{% if _wt %} ({{ _wt }}){% endif %}</span>
          <span class="l-zh">{{ _zh }}{% if _wt %} ({{ _wt }}){% endif %}</span>
        </span>
        {%- endfor %}
      </span>
      {%- endif %}
      {%- if _is_source %}
      <span class="chip warn" style="font-size:9.5px;padding:1px 5px;white-space:nowrap;">
        <span class="l-en">exporting risk</span><span class="l-zh">风险输出方</span>
      </span>
      {%- endif %}
    </div>
    {%- endfor %}
  </div>
  {%- else %}
  <p class="muted small">{{ t('Directed pressure data not available yet', '定向传导压力数据暂不可用') }}</p>
  {%- endif %}
  {%- if _cgl_gaps %}
  <p class="caveat ird-asof" style="margin-top:8px;">
    <span class="l-en">Reported data gaps: {{ _cgl_gaps | length }}. Input dates and coverage may differ; gaps do not establish calm conditions.</span>
    <span class="l-zh">已报告数据缺口：{{ _cgl_gaps | length }}。输入日期和覆盖范围可能不同；数据缺口不代表情况平静。</span>
  </p>
  {%- endif %}
</div><!-- /cgl-directed-pressure -->
{% endif %}{# end CGL directed pressure #}

<!-- ===== ACT 4 — reference desk (deep dive) ===== -->
<div class="act-h"><span class="aq">{{ t('The deep dive', '深入细察') }}</span><span class="as">{{ t('Regime clock, cross-market correlations and league tables — the why behind the reads.', '周期时钟、跨市场相关性与排行——各项读数背后的「为什么」。') }}</span></div>
<details class="ref-fold">
  <summary><span class="rf-t">{{ t('Regimes, correlations & rankings', '周期、相关性与排名') }}</span><span class="rf-s">{{ t('Growth × inflation map · correlation heatmap · league tables', '增长×通胀图 · 相关性热力图 · 排行榜') }}</span><span class="rf-caret" aria-hidden="true">▾</span></summary>
<!-- ===== Growth × inflation regime map ===== -->
{% set regime_pairs = namespace(plotted=[], missing=[]) %}
{% for h in heatmap | default([], true) %}
  {% set growth_ok = h.growth is number and h.growth is not boolean and -1 <= h.growth <= 1 %}
  {% set inflation_ok = h.inflation is number and h.inflation is not boolean and -1 <= h.inflation <= 1 %}
  {% if growth_ok and inflation_ok %}
    {% set regime_pairs.plotted = regime_pairs.plotted + [h] %}
  {% else %}
    {% set regime_pairs.missing = regime_pairs.missing + [h] %}
  {% endif %}
{% endfor %}
<div class="panel">
  <h2 id="intl-growth-inflation" tabindex="-1">{{ t('Regime map — growth × inflation', '周期图 — 增长 × 通胀') }} {{ help('Places economies with both supplied growth and inflation scores on the clock. Right side = better growth; top = more inflation pressure. Incomplete or invalid coordinate pairs are listed separately, not plotted as zero.', '将同时提供增长与通胀分数的经济体放在周期时钟上。右侧增长更好；上方通胀压力更高。缺失或无效的坐标对单独列出，不按零值绘制。') }}</h2>
  <p class="caveat" data-regime-coverage>
    {{ regime_pairs.plotted | length }} / {{ (heatmap | default([], true)) | length }} {{ t('supplied economies plotted. Missing coordinates are not zero.', '个所供经济体已绘制。缺失坐标不等于零。') }}
  </p>
  <div class="scatter">
    <div class="axx"></div><div class="axy"></div>
    <div class="ql" style="left:8px;top:8px">↖ {{ t('Stagflation', '滞胀') }}</div>
    <div class="ql" style="right:8px;top:8px">{{ t('Reflation', '再通胀') }} ↗</div>
    <div class="ql" style="left:8px;bottom:8px">↙ {{ t('Growth-scare', '增长恐慌') }}</div>
    <div class="ql" style="right:8px;bottom:8px">{{ t('Goldilocks', '金发女孩') }} ↘</div>
    {% for h in regime_pairs.plotted %}
      {% set gx = 13 + (h.growth + 1) / 2 * 74 %}
      {% set iy = 13 + (1 - (h.inflation + 1) / 2) * 74 %}
      <div class="pt" style="left:{{ '%.1f'|format(gx) }}%;top:{{ '%.1f'|format(iy) }}%" title="{{ h.name }}: g={{ h.growth }} i={{ h.inflation }}">
        <div class="e">{{ h.flag }}</div><div class="n">{{ h.cc }}</div>
      </div>
    {% endfor %}
  </div>
  {% if not heatmap | default([], true) %}
  <p class="caveat">{{ t('No supplied growth/inflation pairs.', '暂无所供增长与通胀坐标对。') }}</p>
  {% endif %}
  {% if regime_pairs.missing %}
  <details data-regime-missing>
    <summary>{{ t('Not plotted — missing or invalid coordinates', '未绘制 — 坐标缺失或无效') }} ({{ regime_pairs.missing | length }})</summary>
    <ul class="caveat">
    {% for h in regime_pairs.missing %}
      {% set growth_ok = h.growth is number and h.growth is not boolean and -1 <= h.growth <= 1 %}
      {% set inflation_ok = h.inflation is number and h.inflation is not boolean and -1 <= h.inflation <= 1 %}
      <li data-regime-unplotted="{{ h.cc | e }}">{{ h.flag | e }} {{ h.name | e }} ({{ h.cc | e }}) · {{ t('Growth', '增长') }}: {% if growth_ok %}{{ h.growth }}{% else %}{{ t('Unavailable', '不可用') }}{% endif %} · {{ t('Inflation', '通胀') }}: {% if inflation_ok %}{{ h.inflation }}{% else %}{{ t('Unavailable', '不可用') }}{% endif %}</li>
    {% endfor %}
    </ul>
  </details>
  {% endif %}
  <p class="caveat" style="margin-top:8px">{{ t('Snapshot only, not a forecast.', '仅快照，非预测。') }}</p>
</div>

<!-- ===== Correlation & diversification heatmap ===== -->
{% if CR %}
{% set correlation_coverage = namespace(available=0) %}
{% for row in CR.cells %}
  {% set ri = loop.index0 %}
  {% for v in row %}
    {% if loop.index0 > ri and v is number and v is not boolean and -1 <= v <= 1 %}
      {% set correlation_coverage.available = correlation_coverage.available + 1 %}
    {% endif %}
  {% endfor %}
{% endfor %}
{% set correlation_total = (CR.order | length) * ((CR.order | length) - 1) // 2 %}
<div class="panel">
  <div class="sec-h"><h2 id="intl-cross-market-correlation" tabindex="-1">{{ t('Cross-market correlation', '跨市场相关性') }} {{ help('Pairwise correlations of supplied weekly USD returns. Pairs may use different overlapping observations. Missing values are unavailable, not zero or perfect correlation. Historical correlation does not establish portfolio safety or future diversification.', '所供美元周收益的成对相关性。各市场对可能使用不同的重叠观测。缺失值表示不可用，不等于零或完全相关。历史相关性不能证明组合安全或未来分散效果。') }}</h2>
    <span style="flex:1"></span>{% if CR.avg_offdiag is not none %}<span class="sub">{{ t('avg of available pairs', '可用市场对均值') }} <b style="color:var(--text)">{{ '%.2f'|format(CR.avg_offdiag) }}</b></span>{% endif %}</div>
  <p class="caveat" data-correlation-coverage>{{ correlation_coverage.available }} / {{ correlation_total }} {{ t('unique market pairs available', '个不重复市场对可用') }} · {{ t('weekly USD returns', '美元周收益') }} · {{ t('Configured window', '配置窗口') }}: {{ CR.window_d }}d</p>
  {% if not correlation_coverage.available %}
  <p class="caveat">{{ t('No available pairwise correlations.', '暂无可用的成对相关性。') }}</p>
  {% endif %}
  <div class="heatwrap tbl-scroll" data-correlation-scroll tabindex="0" role="region" aria-labelledby="intl-cross-market-correlation">
    <table class="heat">
      <thead><tr><th scope="col">{{ t('Market', '市场') }}</th>{% for k in CR.order %}<th scope="col">{{ CR.labels[k].flag }} {{ k }}</th>{% endfor %}</tr></thead>
      <tbody>
      {% for rk in CR.order %}
        {% set ri = loop.index0 %}
        <tr><th scope="row" class="l">{{ CR.labels[rk].flag }} {{ rk }}</th>
          {% for ck in CR.order %}
            {% set v = CR.cells[ri][loop.index0] %}
            {% if v is not number or v is boolean or not (-1 <= v <= 1) %}<td data-correlation-unavailable style="background:var(--panel2);color:var(--muted)">{{ t('Unavailable', '不可用') }}</td>
            {% elif rk == ck %}<td class="diag">{{ '%.2f'|format(v) }}</td>
            {% else %}{% set pct = ([[v, 0]|max, 1]|min * 100)|round|int %}
            <td style="--correlation-weight:{{ pct }}%;">{{ '%.2f'|format(v) }}</td>{% endif %}
          {% endfor %}
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="caveat" style="margin-top:9px">{{ t('The mean can conceal opposing pairwise relationships; it does not establish portfolio diversification. Historical pairwise estimates; coverage and overlapping observations may differ. Missing values are not zero. Display-only.', '平均值可能掩盖相反的成对关系，不能据此确定组合分散效果。历史成对估计；覆盖范围与重叠观测可能不同。缺失值不等于零。仅展示。') }}</p>
</div>
{% endif %}

<!-- ===== Rankings ===== -->
<div class="panel">
  <h2>{{ t('Where each economy ranks', '各经济体排名') }}</h2>
  <div class="ranks">
    {# Owner-supplied display score; no reconstruction of missing windows. #}
    {% if rotation_ranks is defined and rotation_ranks %}
    <div class="rotation-reading" style="grid-column:1 / -1;min-width:0">
      <h3 id="intl-leadership-rotation" tabindex="-1">{{ t('Leadership rotation — Composite score', '领涨轮动 — 综合分数') }} {{ help('Weights are 50% for 20 sessions, 30% for 10 and 20% for 5. The owner uses changes in the price/benchmark ratio when a benchmark is supplied, otherwise absolute price momentum. State multipliers and overbought / recent bearish MACD penalties adjust the weighted score. Ranking is descending among supplied markets. Window coverage and the benchmark basis of each row are not separately reported here.', '20期权重50%，10期30%，5期20%。提供基准时，模型采用价格与基准比值的变化；否则采用价格绝对动能。状态乘数及超买／近期看跌MACD惩罚调整加权分数。所供市场按分数降序排名。此处未单独报告各行的窗口覆盖和基准口径。') }}</h3>
      <p class="muted small">{{ t('Composite score, not a return. Missing windows enter the model as zero; a zero score does not prove flat prices or complete history.', '综合分数并非收益率。缺失窗口在模型中按零计入；零分不能证明价格持平或历史完整。') }}</p>
      <div class="heatwrap tbl-scroll" data-rotation-scroll tabindex="0" role="region" aria-labelledby="intl-leadership-rotation">
        <table class="sb">
          <thead><tr><th scope="col">{{ t('Rank','排名') }}</th><th scope="col" class="l">{{ t('Market','市场') }}</th><th scope="col">{{ t('Score','分数') }}</th><th scope="col" class="l">{{ t('Owner note','模型备注') }}</th></tr></thead>
          <tbody>{% for rr in rotation_ranks %}
          <tr data-rotation-market="{{ rr.cc|e }}"><td>{{ rr.rank }}</td><th scope="row" class="l">{{ rr.flag|default('')|e }} {{ rr.cc|e }} · {{ t(rr.name|default(rr.cc)|e, rr.name_zh|default(rr.cc)|e) }}</th><td data-rotation-score>{{ '%.3f'|format(rr.score) }}</td><td class="l">{% if rr.note_en|default(none) %}{{ t(rr.note_en|e, rr.note_zh|default(rr.note_en,true)|e) }}{% else %}{{ t('No note supplied','未提供备注') }}{% endif %}</td></tr>
          {% endfor %}</tbody>
        </table>
      </div>
      <p class="caveat">{{ t('Display-only ranking of supplied markets; no capital-flow or trade-sizing authority.', '仅展示所供市场的排名；不代表资金流，也不具备交易仓位权限。') }}</p>
    </div>
    {% endif %}
    {% for key in ['recession_score','drawdown_risk','real_yield','yield_10y'] %}
      {% set rk = rankings.get(key) %}
      {% if rk %}
      <div>
        <h3>{{ t(rk.label_en, rk.label_zh) }}</h3>
        {% set vals = rk.rows | map(attribute='value') | list %}
        {% set vmax = vals | map('abs') | max %}
        {% for row in rk.rows %}
          <div class="rb"><span class="flg">{{ row.flag }}</span><span style="width:54px" class="muted">{{ row.cc }}</span>
            <span class="bar"><span class="bf" style="width:{{ '%.0f'|format((row.value|abs) / (vmax or 1) * 100) }}%;background:{{ 'var(--down)' if rk.risk_high else 'var(--up)' }}"></span></span>
            <span class="v">{{ '%.1f'|format(row.value) }}</span></div>
        {% endfor %}
      </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

</details><!-- /ref-fold B -->

{% if intl_workspace|default(none) %}</details>{% endif %}

{% else %}{# ================= STOCK DASHBOARD ================= #}

