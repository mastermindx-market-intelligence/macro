            {%- elif emea_vel > 0.1 %}
            {{ t('Above usual 20d change', '20日变动高于常态') }}
            {%- elif emea_vel < -0.1 %}
            {{ t('Below usual 20d change', '20日变动低于常态') }}
            {%- else %}
            {{ t('Near usual 20d change', '20日变动接近常态') }}
            {%- endif %}
          </div>
          <div class="muted small" data-credit-observation>{{ t('Observed:', '观测日：') }}<br>{{ emea_oas.get('asof')|e if emea_oas.get('asof') else t('Unavailable', '不可用') }}</div>
        </div>
      </div>

      <!-- Curve Inversion Board: counts describe supplied coverage, never absent markets. -->
      {%- set inv_color_cls = ('warn' if n_inv > 0 and n_inv < n_total_inv else 'red' if n_inv == n_total_inv else '') if inv_available else '' %}
      <div class="ird-inv-row" style="{{ 'background:var(--panel2);border-color:var(--line)' if not inv_available else 'background:color-mix(in srgb,var(--up) 6%,var(--panel2));border-color:color-mix(in srgb,var(--up) 25%,var(--line))' if n_inv == 0 else 'background:color-mix(in srgb,var(--warn) 6%,var(--panel2));border-color:color-mix(in srgb,var(--warn) 25%,var(--line))' if n_inv < n_total_inv else 'background:color-mix(in srgb,var(--down) 6%,var(--panel2));border-color:color-mix(in srgb,var(--down) 25%,var(--line))' }}">
