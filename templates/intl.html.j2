        <div class="ird-spread-card">
          <div class="sc-label">{{ t('Asia credit spreads', '亚洲信用利差') }}</div>
          <div class="sc-val">{{ ('%.2f' | format(asia_v) + '%') if asia_v is not none else '—' }}</div>
          <div class="sc-vel vel-flat">
            {%- if asia_vel is none %}
            {{ t('Unavailable', '不可用') }}
            {%- elif asia_vel > 0.1 %}
            {{ t('Above usual 20d change', '20日变动高于常态') }}
            {%- elif asia_vel < -0.1 %}
            {{ t('Below usual 20d change', '20日变动低于常态') }}
            {%- else %}
            {{ t('Near usual 20d change', '20日变动接近常态') }}
            {%- endif %}
          </div>
          <div class="muted small" data-credit-observation>{{ t('Observed:', '观测日：') }}<br>{{ asia_oas.get('asof')|e if asia_oas.get('asof') else t('Unavailable', '不可用') }}</div>
        </div>
        <!-- LatAm -->
        {%- set latam_v = latam_oas.get('value') %}
