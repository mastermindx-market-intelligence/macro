            {%- endif %}
          </div>
          <div class="sc-val">{{ ('%.2f' | format(latam_v) + '%') if latam_v is not none else '—' }}</div>
          <div class="sc-vel vel-flat">
            {%- if latam_vel is none %}
            {{ t('Unavailable', '不可用') }}
            {%- elif latam_vel > 0.1 %}
            {{ t('Above usual 20d change', '20日变动高于常态') }}
            {%- elif latam_vel < -0.1 %}
            {{ t('Below usual 20d change', '20日变动低于常态') }}
            {%- else %}
            {{ t('Near usual 20d change', '20日变动接近常态') }}
            {%- endif %}
          </div>
          <div class="muted small" data-credit-observation>{{ t('Observed:', '观测日：') }}<br>{{ latam_oas.get('asof')|e if latam_oas.get('asof') else t('Unavailable', '不可用') }}</div>
        </div>
        <!-- EMEA -->
        {%- set emea_v = emea_oas.get('value') %}
        {%- set emea_vel = emea_oas.get('vel_20d_z') %}
        <div class="ird-spread-card">
          <div class="sc-label">{{ t('EMEA credit spreads', '欧非中东信用利差') }}</div>
          <div class="sc-val">{{ ('%.2f' | format(emea_v) + '%') if emea_v is not none else '—' }}</div>
          <div class="sc-vel vel-flat">
            {%- if emea_vel is none %}
