        <span class="sub">{{ t('What the major central banks are actually doing', '主要央行的实际政策动向') }}</span>
      </div>
      <div class="tbl-scroll ird-cb-scroll" role="region" tabindex="0" aria-labelledby="intl-central-banks">
      <table class="ird-cb">
        <thead><tr>
          <th>{{ t('Bank', '央行') }}</th>
          <th class="r">{{ t('Rate', '利率') }}</th>
          <th>{{ t('Stance', '立场') }}</th>
          <th>{{ t('Last move', '近期动向') }}</th>
          <th>{{ t('Balance sheet', '资产负债表') }}</th>
          <th>{{ t('Next meeting', '下次会议') }}</th>
        </tr></thead>
        <tbody>
        {%- for cb in CBD.get('cbs', []) %}
        {%- set trend = cb.get('trend_3m') %}
        {%- set stance_css = CB_STANCE_CSS.get(trend, 'muted') %}
        {%- set stance_en = CB_STANCE_EN.get(trend, 'Unavailable') %}
        {%- set stance_zh = CB_STANCE_ZH.get(trend, '不可用') %}
        {%- set last_chg = cb.get('last_change') or {} %}
        {%- set next_mtg = cb.get('next_meeting') or {} %}
        {%- set bs = cb.get('bs_impulse') %}
        {%- set days_to = next_mtg.get('days') %}
        <tr>
          <td>{{ CC_FLAG.get(cb.get('country', ''), '🌐') }} {{ t(cb.get('name_en',''), cb.get('name_zh','')) }}</td>
          <td class="r"><b>{{ '%.2f' | format(cb.get('policy_rate', 0)) }}%</b>
            <div class="muted small" data-cb-rate-observation>{{ t('Observed:', '观测日：') }} {{ cb.get('asof')|e if cb.get('asof') else t('Unavailable', '不可用') }}<br>
              {%- set cadence = (cb.get('source') or {}).get('cadence') %}
              {{ t('Daily', '日度') if cadence == 'daily' else t('Monthly', '月度') if cadence == 'monthly' else t('Cadence unavailable', '频率不可用') }}{% if cb.get('stale') is sameas true %} · {{ t('Stale', '陈旧') }}{% endif %}
            </div>
          </td>
          <td><span class="ird-stance {{ stance_css }}">{{ t(stance_en, stance_zh) }}</span></td>
          <td>
            {%- if last_chg %}
              <span class="{{ 'pos' if last_chg.get('direction') == 'cut' else 'neg' }}">{{ '↓' if last_chg.get('direction') == 'cut' else '↑' }}</span>
              {{ (last_chg.get('date', '')[:7] or '').replace('-0', '-') }}
            {%- else %}<span class="muted">—</span>{%- endif %}
          </td>
          <td>
            {%- if bs and bs.get('impulse_13w') is not none %}
              {%- set imp = bs.get('impulse_13w') %}
              <span class="ird-bs {{ 'adding' if imp > 0 else 'draining' if imp < 0 else '' }}">
                {{ t('Adding' if imp > 0 else 'Draining' if imp < 0 else 'Flat', '扩表' if imp > 0 else '缩表' if imp < 0 else '持平') }}
              </span>
            {%- else %}<span class="muted">{{ t('Unavailable', '不可用') }}</span>{%- endif %}
            {% if bs %}<div class="muted small" data-cb-balance-observation>{{ t('Observed:', '观测日：') }} {{ bs.get('asof')|e if bs.get('asof') else t('Unavailable', '不可用') }}</div>{% endif %}
          </td>
          <td>
            {%- if next_mtg.get('date') %}
              {%- set mtg_date = next_mtg.get('date', '')[:10] %}
              {%- set mtg_short = mtg_date[5:] if mtg_date else '' %}
              <span class="{{ 'chip warn' if days_to is not none and days_to <= 5 else 'small' }}">
                {{ mtg_short }}
                {%- if days_to is not none %} · {{ days_to }}d{%- endif %}
              </span>
            {%- else %}<span class="muted">—</span>{%- endif %}
          </td>
        </tr>
        {%- endfor %}
        </tbody>
      </table>
      </div>
      <p class="caveat" style="margin-top:8px;">
        {{ t('Balance-sheet sources configured for Fed, ECB, and BoJ only; missing readings remain unavailable. Latest rate observation across displayed banks:', '资产负债表来源仅配置于美联储、欧央行和日本央行；缺失读数仍不可用。所示央行中的最新利率观测日：') }} {{ CBD.get('as_of')|e if CBD.get('as_of') else t('Unavailable', '不可用') }}
      </p>
    </div>
    {%- endif %}<!-- /cb desk -->

