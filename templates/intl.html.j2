{% import "_prophet_card.html.j2" as pv %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% macro num(v, suf='', dp=2) -%}
{%- if v is none -%}<span class="muted">—</span>{%- else -%}{{ ('%.' ~ dp ~ 'f')|format(v) }}{{ suf }}{%- endif -%}
{%- endmacro %}
{% set S = summary %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ 'International Stock Boards' if mode == 'stocks' else 'International Economies' }} — {{ latest.date }}</title>
{%- if mode == 'stocks' %}
{% set seo_title = "International Stock Boards — Mastermind" %}{% set seo_desc = "Stock boards for major non-US markets — trend and regime context by country. Updated weekly." %}{% set seo_path = "intl_stocks.html" %}
{%- else %}
{% set seo_title = "International Economies — Mastermind" %}{% set seo_desc = "Major economies at a glance — growth, inflation and market regime reads beyond the US. Updated weekly." %}{% set seo_path = "intl.html" %}
{%- endif %}
{% include "_seo_head.html.j2" %}
<script>try{var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',t||'dark');var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
{% if mode != 'stocks' and intl_workspace|default(none) %}
<link rel="stylesheet" href="intl_workspace.css">
<link rel="stylesheet" href="intl_workspace_macro.css">
<link rel="stylesheet" href="intl_workspace_risk.css">
<link rel="stylesheet" href="intl_workspace_history.css">
<link rel="stylesheet" href="intl_workspace_surveillance.css">
<script defer src="intl_workspace_state.js"></script>
<script defer src="intl_library_search.js"></script>
<script defer src="intl_workspace_scenario.js"></script>
<script defer src="intl_workspace.js"></script>
<script defer src="intl_workspace_entry.js"></script>
{% endif %}
{% if mode == 'stocks' %}<link rel="stylesheet" href="dashboard-icons.css">{% endif %}
{% if mode == 'stocks' %}<script defer src="dashboard-icons.js"></script>{% endif %}
<style>
  /* Shared by Risk and Trade; keep available when either source is absent. */
  .ird-tx-row{display:flex;align-items:center;gap:8px;padding:5px 0;border-bottom:1px solid var(--line);font-size:12.5px;}
  .ird-tx-row:last-child{border-bottom:none;}
  .ird-tx-bar-wrap{width:132px;height:6px;background:var(--panel);border-radius:var(--r-pill,999px);overflow:hidden;}
  .ird-tx-bar{height:100%;border-radius:var(--r-pill,999px);background:var(--warn);}
  @media(max-width:640px){body.page-intl .ird-tx-row{flex-wrap:wrap;}}
  * { box-sizing: border-box; }
  /* ── design tokens ported from macro.html (deep command-center canvas + mono numerals) ── */
  body {
    --num: var(--font-mono, ui-monospace, "SF Mono", SFMono-Regular, "Cascadia Mono", "JetBrains Mono", "Roboto Mono", Menlo, Consolas, monospace);
    {% if mode == 'stocks' or not intl_workspace|default(none) %}
    --bg:#0a0c11; --panel:#14171e; --panel2:#1b1f28;
    {% endif %}
    --hair: color-mix(in srgb, var(--line) 74%, transparent);
    --ink-1: var(--text);
    --ink-2: color-mix(in srgb, var(--text) 64%, transparent);
    --ink-3: var(--muted);
    --ms: inset 0 1px 0 0 color-mix(in srgb, var(--text) 8%, transparent), 0 1px 1px rgba(0,0,0,.28), 0 14px 30px -18px rgba(0,0,0,.55);
    background: var(--bg); color: var(--text);
    font: 14px/1.55 var(--font-ui, Inter, -apple-system, "Segoe UI", Roboto, Helvetica, sans-serif);
    margin: 0; padding: 20px;
  }
  {% if mode == 'stocks' or not intl_workspace|default(none) %}
  html[data-theme="light"] body { --bg:#e8ebf1; --panel:#ffffff; --panel2:#eef1f6; --ms: 0 1px 3px rgba(20,30,50,.07), 0 18px 40px -26px rgba(20,30,50,.20); }
  {% endif %}
  @media (min-width: 1100px) { body { padding: 26px max(40px, calc((100vw - 1500px) / 2)); } }
  /* NO zh body-font override here — macro.html has none either. theme.css's --font-ui
     already chains PingFang SC / Hiragino / YaHei after Inter, so ZH gets native CJK
     glyphs while latin text and numerals stay on Inter (the house face). Overriding to
     a CJK-first stack is what made ZH numerals render in a different face than EN. */
  a { text-decoration: none; color: var(--ink-link, var(--link)); }
  h1 { font-size: 21px; margin: 0 0 2px; } h3 { font-size: 13px; margin: 0 0 8px; }
  /* section title: macro.html --fs-h2 (17px) + its 3px regime rail */
  h2 { display:flex; align-items:center; gap:10px; font-size: 17px; margin: 0; color: var(--ink-1); font-weight: 700; letter-spacing: -.01em; text-transform: none; line-height: 1.3; }
  h2::before { content:""; flex:none; align-self:center; width:3px; height:17px; border-radius:2px; background:linear-gradient(180deg, var(--link), color-mix(in srgb,var(--link) 30%,transparent)); }
  html[data-lang="zh"] h2 { letter-spacing: 0; }
  /* ── numeral face policy (macro.html parity) ───────────────────────────────
     The terminal mono is for FIGURES ONLY — never for words. macro.html applies
     var(--num) to `.num` and to `td:not(:first-child):not(.l)` (i.e. the numeric
     columns) and explicitly re-inherits prose inside tooltips, so its label and
     sentence slots stay on Inter. This page used to hand the mono face to slots
     that carry sentences ("growth down, inflation up", "held back — breaking
     down", "2/7 ex-US markets ahead"), which is what made it read as a different
     product from macro.html. Figures below; everything with a word in it inherits
     --font-ui. */
  .num,.lb-vals .big,.rcard .rv,.rb .v,.dc-num,.sc-val,.inv-num,.ur-num,.tb-metrics .tm-v,
  table.cmp td:not(.l):not(.eco),table.sb td:not(.l) { font-family: var(--num); font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum" 1; letter-spacing: -.01em; }
  /* prose slots that sit next to figures — keep them on the house face */
  .wc-vital .vv,.lb-vals small,.help .tip,.caveat { font-family: var(--font-ui); letter-spacing: normal;
    font-variant-numeric: tabular-nums; }
  .panel { position:relative; background: var(--panel); border: 1px solid var(--hair, var(--line)); border-radius: 14px; padding: 18px 20px; margin-bottom: 16px; box-shadow: var(--ms); }
  .muted { color: var(--muted); } .small { font-size: 12px; } .stale { color: var(--muted); font-size: 10px; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .pos { color: var(--ink-up, var(--up)); } .neg { color: var(--ink-down, var(--down)); }
  .chip { display:inline-block; padding:2px 8px; border-radius:8px; font-size:11px; font-weight:700; background:var(--panel2); border:1px solid var(--line); }
  .chip.warn { background:color-mix(in srgb,var(--down) 14%,transparent); color:var(--ink-down, var(--down)); border-color:color-mix(in srgb,var(--down) 36%,transparent); }
  .chip.caut { background:color-mix(in srgb,#d4a017 16%,transparent); color:var(--ink-warn, var(--warn)); border-color:color-mix(in srgb,#d4a017 38%,transparent); }
  .chip.ok { background:color-mix(in srgb,var(--up) 14%,transparent); color:var(--ink-up, var(--up)); border-color:color-mix(in srgb,var(--up) 34%,transparent); }
  /* quad chip */
  .quad { display:inline-flex; align-items:center; gap:6px; padding:3px 10px; border-radius:9px; font-weight:800; font-size:12px; color:#fff; }
  /* zh 红涨绿跌: q1/q3 use token vars so theme.css's html[data-lang="zh"] swap picks them up
     automatically (no per-page mirror needed). q2/q4 (amber/blue) are direction-neutral. */
  .q-Q1 { background:var(--q1,#2e9e4f); } .q-Q2 { background:#d4a017; } .q-Q3 { background:var(--q3,#d04545); } .q-Q4 { background:#3f78d8; }
  .quad.q-unknown { color:var(--text); background:var(--panel2); }
  .qdot { width:9px;height:9px;border-radius:50%;display:inline-block; }
  .qd-Q1{background:var(--q1,#2e9e4f)}.qd-Q2{background:#d4a017}.qd-Q3{background:var(--q3,#d04545)}.qd-Q4{background:#3f78d8}
  /* comparison grid */
  .gridwrap { overflow-x:auto; }
  table.cmp { border-collapse:collapse; width:100%; font-size:12.5px; min-width:1080px; }
  table.cmp th, table.cmp td { padding:7px 9px; border-bottom:1px solid var(--line); text-align:right; white-space:nowrap; }
  table.cmp th { color:var(--muted); font-weight:600; font-size:11px; text-transform:uppercase; letter-spacing:.03em; position:sticky; top:0; background:var(--panel); }
  table.cmp td.l, table.cmp th.l { text-align:left; }
  table.cmp td.eco { position:sticky; left:0; background:var(--panel); font-weight:700; z-index:2; }
  table.cmp th.eco { position:sticky; left:0; z-index:3; }
  @media(max-width:640px){table.cmp td.eco,table.cmp th.eco{position:static;}}
  table.cmp tr:hover td { background:var(--panel2); }
  table.cmp td.eco:hover, table.cmp tr:hover td.eco { background:var(--panel2); }
  .grp { border-left:2px solid var(--line); }
  .flg { font-size:16px; margin-right:5px; }
  /* gauge bar */
  .gbar { display:inline-block; width:64px; height:7px; border-radius:5px; background:var(--panel2); border:1px solid var(--line); overflow:hidden; vertical-align:middle; margin-right:6px; }
  .gfill { display:block; height:100%; }
  .g-low{background:var(--up)}.g-watch{background:#d4a017}.g-elevated{background:var(--down)}.g-na{background:var(--muted)}
  /* heatmap scatter */
  .scatter { position:relative; height:300px; border:1px solid var(--line); border-radius:10px; margin-top:8px; background:
     linear-gradient(to right, color-mix(in srgb,#3f78d8 7%,transparent), transparent 50%, color-mix(in srgb,#d4a017 7%,transparent)),
     linear-gradient(to top, color-mix(in srgb,#3f78d8 6%,transparent), transparent 50%, color-mix(in srgb,var(--q1,#2e9e4f) 6%,transparent)); }
  .scatter .axx, .scatter .axy { position:absolute; background:var(--line); }
  .scatter .axx { left:0; right:0; top:50%; height:1px; } .scatter .axy { top:0; bottom:0; left:50%; width:1px; }
  .scatter .ql { position:absolute; font-size:10px; color:var(--muted); text-transform:uppercase; letter-spacing:.05em; }
  .scatter .pt { position:absolute; transform:translate(-50%,-50%); text-align:center; }
  .scatter .pt .e { font-size:22px; line-height:1; } .scatter .pt .n { font-size:9px; color:var(--muted); }
  /* rank bars */
  .ranks { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:14px; }
  .rb { font-size:12px; padding:3px 0; display:flex; align-items:center; gap:7px; }
  .rb .bar { flex:1; height:8px; border-radius:5px; background:var(--panel2); overflow:hidden; }
  .rb .bf { display:block; height:100%; background:var(--link); }
  .rb .v { width:58px; text-align:right; font-variant-numeric:tabular-nums; }
  /* stock + sector cards */
  .cards { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:11px; }
  .card { background:var(--panel2); border:1px solid var(--line); border-radius:10px; padding:11px 13px; }
  .card .hd { display:flex; align-items:center; gap:7px; } .card .hd .tk { font-weight:800; }
  .lad { display:inline-block; padding:2px 8px; border-radius:9px; font-weight:700; font-size:11px;
         background:color-mix(in srgb, var(--c, var(--muted)) 16%, var(--panel)); color:color-mix(in srgb, var(--c, var(--muted)) 82%, var(--text)); }
  .lad.up { --c:var(--up); } .lad.down { --c:var(--down); } .lad.flat { --c:var(--muted); }
  /* volatility black hole chip + forward-cone honesty note on each standout card (China-parity) */
  .nb-vf { display:flex; flex-wrap:wrap; gap:4px; margin-top:5px; }
  .nb-vchip { font-size:8.5px; font-weight:800; padding:0 5px; border-radius:6px; border:1px solid var(--line);
              color:var(--muted); white-space:nowrap; }
  .vf-coil { color:var(--ink-link, var(--link)); border-color:color-mix(in srgb,var(--link) 38%,var(--line));
             background:color-mix(in srgb,var(--link) 10%,var(--panel)); }
  .vf-up { color:var(--ink-up, var(--up)); border-color:color-mix(in srgb,var(--up) 45%,var(--line)); }
  .vf-down { color:var(--ink-down, var(--down)); border-color:color-mix(in srgb,var(--down) 40%,var(--line)); }
  .vf-exp { color:var(--ink-warn, var(--warn)); border-color:color-mix(in srgb,var(--warn) 35%,var(--line)); }
  .nb-note { font-size:8.5px; line-height:1.3; margin-top:4px; padding:2px 5px; border-radius:6px;
             color:var(--muted); background:color-mix(in srgb,var(--text) 4%,var(--panel)); }
  .nb-note-anticipation { color:var(--ink-link, var(--link)); background:color-mix(in srgb,var(--link) 8%,var(--panel)); }
  table.sb { border-collapse:collapse; width:100%; font-size:12.5px; }
  table.sb th, table.sb td { padding:5px 9px; border-bottom:1px solid var(--line); text-align:right; }
  table.sb td.l, table.sb th.l { text-align:left; } table.sb th { color:var(--muted); font-weight:600; }
  .help { display:inline-flex; align-items:center; justify-content:center; width:15px; height:15px; border-radius:50%; border:1px solid var(--muted); color:var(--muted); font-size:10px; font-weight:600; cursor:help; position:relative; vertical-align:middle; margin-left:4px; }
  .help .tip { display:none; position:absolute; bottom:150%; left:50%; transform:translateX(-50%); width:280px; background:var(--panel); border:1px solid var(--line); padding:10px 12px; border-radius:9px; z-index:60; font-size:12px; line-height:1.5; color:var(--text); text-align:left; font-weight:400; text-transform:none; letter-spacing:normal; box-shadow:var(--popover-shadow); pointer-events:auto; cursor:auto; max-height:min(60vh,420px); overflow-y:auto; overscroll-behavior:contain; }
  /* invisible hover pad across the icon→tip gap — keeps :hover alive mid-travel (on .help, not .tip: the tip is a scroll container and clips its pseudos) */
  .help:hover::before { content:''; position:absolute; bottom:100%; left:-30px; right:-30px; height:10px; }
  .help:hover .tip { display:block; }
  .caveat { font-size:11.5px; color:var(--muted); font-style:italic; }
  .more-btn { display:inline-block; margin-top:10px; padding:5px 14px; border-radius:9px; background:var(--panel2); border:1px solid var(--line); color:var(--ink-link, var(--link)); font-weight:600; font-size:12px; cursor:pointer; }
  .hidden { display:none; }

  /* ==================== World Command hero + aurora (macro.html house) ==================== */
  :root { --acc1:#3a86ff; --acc2:#22d97a; --acc3:#6366f1;
    --acc-grad:linear-gradient(120deg, color-mix(in srgb,var(--link) 60%,transparent), color-mix(in srgb,var(--acc2) 42%,transparent)); }
  /* premium panels are frosted glass floating over the aurora (not rainbow borders) */
  .panel.accent { background: color-mix(in srgb, var(--panel) 78%, transparent);
    -webkit-backdrop-filter: blur(22px) saturate(150%); backdrop-filter: blur(22px) saturate(150%);
    border: 1px solid color-mix(in srgb, var(--text) 12%, transparent);
    box-shadow: 0 1px 0 color-mix(in srgb,#fff 8%,transparent) inset, 0 16px 40px -30px rgba(3,7,18,.34); }

  /* aurora backdrop — four soft blobs, state-tinted, compositor-safe (fixed, opacity-only) */
  .intl-aurora { position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden; }
  .intl-aurora b { position:absolute; border-radius:50%; filter:blur(90px); opacity:0; transition:opacity 1.1s ease, background 1.2s ease; }
  .intl-aurora .a1 { width:900px; height:700px; top:-220px; left:-160px; background:radial-gradient(ellipse,color-mix(in srgb,var(--acc2) 22%,transparent),transparent 70%); }
  .intl-aurora .a2 { width:720px; height:620px; bottom:-160px; right:-120px; background:radial-gradient(ellipse,color-mix(in srgb,var(--acc3) 20%,transparent),transparent 70%); }
  .intl-aurora .a3 { width:540px; height:460px; top:34%; left:44%; background:radial-gradient(ellipse,color-mix(in srgb,var(--acc1) 14%,transparent),transparent 70%); }
  body.aur-on .intl-aurora .a1 { opacity:.9; } body.aur-on .intl-aurora .a2 { opacity:.75; } body.aur-on .intl-aurora .a3 { opacity:.6; }
  /* state tint of the primary blob */
  body.aur-warn .intl-aurora .a1 { background:radial-gradient(ellipse,color-mix(in srgb,var(--warn) 20%,transparent),transparent 70%); }
  body.aur-risk .intl-aurora .a1 { background:radial-gradient(ellipse,color-mix(in srgb,var(--down) 20%,transparent),transparent 70%); }
  .intl-flow { position:relative; z-index:1; }
  /* nav must stack ABOVE the content flow or its dropdowns clip behind the hero
     (same idiom as canada/flow_desk); the dd-menu's z-index:90 is nav-scoped */
  nav.site-nav { position:relative; z-index:2; }
  @media (prefers-reduced-motion: reduce) { .intl-aurora b { transition:none; } }

  /* ── the hero card ── */
  .wc { position:relative; margin:0 0 20px; padding:0; overflow:hidden; border-radius:18px;
    background: color-mix(in srgb, var(--panel) 72%, transparent);
    -webkit-backdrop-filter: blur(24px) saturate(155%); backdrop-filter: blur(24px) saturate(155%);
    border: 1px solid color-mix(in srgb, var(--text) 13%, transparent);
    box-shadow: 0 1px 0 color-mix(in srgb,#fff 9%,transparent) inset, 0 12px 30px -22px rgba(3,7,18,.32); }
  .wc-top { display:grid; grid-template-columns: minmax(0,4.3fr) minmax(0,5.7fr); gap:0; }
  @media (max-width:820px){ .wc-top { grid-template-columns:1fr; } }
  .wc-left { padding:22px 24px; border-right:1px solid color-mix(in srgb,var(--text) 9%,transparent); display:flex; flex-direction:column; gap:12px; }
  @media (max-width:820px){ .wc-left { border-right:none; border-bottom:1px solid color-mix(in srgb,var(--text) 9%,transparent); } }
  .wc-right { padding:22px 24px; display:flex; flex-direction:column; gap:14px; min-width:0; }
  .wc-eyebrow { display:flex; align-items:center; gap:9px; flex-wrap:wrap; font:700 10.5px/1 var(--font-ui,Inter,sans-serif);
    letter-spacing:.14em; text-transform:uppercase; color:var(--ink-3); }
  .wc-eyebrow .dot { width:6px; height:6px; border-radius:50%; background:var(--up); box-shadow:0 0 8px var(--up); }
  html[data-lang="zh"] .wc-eyebrow { letter-spacing:.06em; }

  /* gauge cluster */
  .wc-gauge-wrap { display:flex; flex-wrap:wrap; align-items:center; gap:16px; }
  .wc-gauge { position:relative; width:170px; height:104px; flex:none; }
  .wc-gauge svg { width:100%; height:100%; display:block; overflow:visible; }
  .wc-gauge-track { stroke: color-mix(in srgb, var(--text) 9%, transparent); }
  .wc-gauge-fill { stroke: var(--gc, var(--up)); stroke-linecap:round; filter: drop-shadow(0 0 6px color-mix(in srgb,var(--gc,var(--up)) 55%,transparent)); }
  @media (prefers-reduced-motion: no-preference) { .wc-gauge-fill { animation: gaugeSweep 1.15s cubic-bezier(.22,.9,.26,1) .2s both; } }
  @keyframes gaugeSweep { from { stroke-dashoffset: var(--circ); } }
  /* hero score: macro.html's big-board treatment — house face, 800, tight tracking */
  .wc-gnum { fill: var(--gc, var(--up)); font-family: var(--font-ui); font-size:36px; font-weight:800; letter-spacing:-.03em; font-variant-numeric: tabular-nums; filter: drop-shadow(0 0 8px color-mix(in srgb,var(--gc,var(--up)) 45%,transparent)); }
  .wc-gnum-sub { fill: var(--ink-3); font-family: var(--font-ui); font-size:12px; font-weight:700; }
  .wc-gauge-cap { font:700 9.5px/1.3 var(--font-ui,Inter,sans-serif); letter-spacing:.1em; text-transform:uppercase; color:var(--ink-3); margin-top:5px; }
  .wc-gside { display:flex; flex-direction:column; justify-content:center; gap:3px; min-width:0; }
  .wc-verdict { font:800 22px/1.08 var(--font-ui,Inter,sans-serif); letter-spacing:-.02em; }
  .wc-verdict.v-unavailable { color:var(--ink-2); }
  .wc-verdict.v-up { color:var(--ink-up, var(--up)); } .wc-verdict.v-warn { color:var(--ink-warn, var(--warn)); } .wc-verdict.v-down { color:var(--ink-down, var(--down)); }
  .wc-substance { font-size:12.5px; color:var(--ink-2); line-height:1.4; }

  /* the read (thesis) + stance */
  .wc-kick { font:700 10.5px/1 var(--font-ui,Inter,sans-serif); letter-spacing:.14em; text-transform:uppercase; color:var(--ink-3); }
  html[data-lang="zh"] .wc-kick { letter-spacing:.06em; }
  .wc-read { font-size:14.5px; line-height:1.55; color:var(--text); margin:0; }
  .wc-read b { font-weight:700; }

  /* US-vs-World tug meter — the signature */
  .tug { margin-top:2px; }
  .tug-head { display:flex; justify-content:space-between; align-items:baseline; gap:10px; margin-bottom:9px; }
  .tug-head .th-lbl { font:700 10px/1 var(--font-ui,Inter,sans-serif); letter-spacing:.1em; text-transform:uppercase; color:var(--ink-3); }
  .tug-head .th-count { font:700 12px/1 var(--font-ui); font-variant-numeric:tabular-nums; color:var(--ink-2); }
  .tug-beam { position:relative; height:34px; border-radius:10px; background:var(--panel2);
    border:1px solid var(--hair); overflow:hidden;
    background-image:linear-gradient(90deg, color-mix(in srgb,var(--info) 16%,transparent), transparent 42%, transparent 58%, color-mix(in srgb,var(--up) 16%,transparent)); }
  .tug-mid { position:absolute; top:4px; bottom:4px; left:50%; width:1px; background:color-mix(in srgb,var(--text) 22%,transparent); }
  .tug-fill { position:absolute; top:0; bottom:0; border-radius:9px; opacity:.5; }
  .tug-fill.tf-world { right:50%; background:linear-gradient(90deg,transparent,color-mix(in srgb,var(--up) 40%,transparent)); }
  .tug-fill.tf-us { left:50%; background:linear-gradient(270deg,transparent,color-mix(in srgb,var(--info) 40%,transparent)); }
  .tug-marker { position:absolute; top:50%; left:var(--pos,50%); transform:translate(-50%,-50%);
    width:20px; height:20px; border-radius:50%; background:var(--text); border:3px solid var(--panel);
    box-shadow:0 2px 8px rgba(0,0,0,.5), 0 0 0 1px color-mix(in srgb,var(--text) 30%,transparent); z-index:2; }
  @media (prefers-reduced-motion: no-preference) { .tug-marker { animation: tugSlide 1s cubic-bezier(.22,.9,.26,1) .3s both; } }
  @keyframes tugSlide { from { left:50%; } }
  .tug-ends { display:flex; justify-content:space-between; margin-top:7px; font-size:11.5px; }
  .tug-ends .te-us { color:var(--ink-info, var(--info)); font-weight:700; } .tug-ends .te-wo { color:var(--ink-up, var(--up)); font-weight:700; }
  .tug-ends .te-us .flg, .tug-ends .te-wo .flg { font-size:14px; }

  /* hero vitals strip */
  .wc-vitals { display:grid; grid-template-columns:repeat(4,1fr); gap:0; border-top:1px solid color-mix(in srgb,var(--text) 9%,transparent); }
  @media (max-width:760px){ .wc-vitals { grid-template-columns:1fr 1fr; } }
  .wc-vital { padding:12px 16px; border-right:1px solid color-mix(in srgb,var(--text) 7%,transparent); min-width:0; }
  .wc-vital:last-child { border-right:none; }
  @media (max-width:760px){ .wc-vital:nth-child(2n){border-right:none;} .wc-vital:nth-child(-n+2){border-bottom:1px solid color-mix(in srgb,var(--text) 7%,transparent);} }
  .wc-vital .vk { font:700 9.5px/1.2 var(--font-ui,Inter,sans-serif); letter-spacing:.08em; text-transform:uppercase; color:var(--ink-3); }
  .wc-vital .vv { font-size:16px; font-weight:800; color:var(--ink-1); margin:4px 0 1px; line-height:1.15; }
  /* a vital whose value is a phrase, not a figure — one size down so it sits on one or
     two lines beside the numeric vitals (was three inline style="font-size:13px" patches) */
  .wc-vital .vv.word { font-size:13px; line-height:1.25; }
  .wc-vital .vv.up { color:var(--ink-up, var(--up)); } .wc-vital .vv.down { color:var(--ink-down, var(--down)); } .wc-vital .vv.warn { color:var(--ink-warn, var(--warn)); }
  .wc-vital .vs { font-size:11px; color:var(--ink-3); line-height:1.35; }

  /* ── act dividers (plain-word section framing) ── */
  .act-h { display:flex; align-items:baseline; gap:12px; flex-wrap:wrap; margin:30px 2px 14px; }
  .act-h:first-of-type { margin-top:24px; }
  .act-h .aq { font-size:20px; font-weight:800; letter-spacing:-.02em; color:var(--text); }
  html[data-lang="zh"] .act-h .aq { letter-spacing:0; }
  .act-h .as { font-size:12.5px; color:var(--ink-3); }
  .act-h::before { content:""; align-self:center; width:22px; height:3px; border-radius:2px; background:linear-gradient(90deg,var(--link),transparent); }
  /* reference foldables (deep-tier data, collapsed by default) */
  details.ref-fold { margin:0 0 16px; border:1px solid var(--hair); border-radius:14px; background:color-mix(in srgb,var(--panel) 55%,transparent); }
  details.ref-fold > summary { list-style:none; cursor:pointer; display:flex; align-items:center; gap:12px; padding:15px 18px; border-radius:14px; }
  details.ref-fold > summary::-webkit-details-marker { display:none; }
  details.ref-fold > summary:hover { background:color-mix(in srgb,var(--text) 4%,transparent); }
  details.ref-fold .rf-t { font-size:14px; font-weight:700; color:var(--text); }
  details.ref-fold .rf-s { font-size:12px; color:var(--ink-3); flex:1; min-width:0; }
  details.ref-fold .rf-caret { margin-left:auto; color:var(--ink-3); font-size:12px; transition:transform .22s ease; }
  details.ref-fold[open] .rf-caret { transform:rotate(180deg); }
  details.ref-fold[open] > summary { border-bottom:1px solid var(--hair); border-radius:14px 14px 0 0; }
  details.ref-fold > .panel { border:none; box-shadow:none; background:transparent; margin:6px 6px 10px; }
  @media(max-width:640px){
    body.page-intl details.ref-fold > summary{flex-wrap:wrap;}
    body.page-intl .rf-t{flex:1;min-width:0;}
    body.page-intl .rf-s{flex-basis:100%;order:1;}
    body.page-intl .rf-s{overflow-wrap:anywhere;}
  }

  /* verdict / stance band (reusable, macro.html idiom) */
  .stance { margin:12px 0 2px; padding:11px 13px; border-radius:10px; border:1px solid var(--hair); border-left:3px solid var(--muted); background:var(--panel2); }
  .stance-run { border-left-color:var(--up); background:color-mix(in srgb,var(--up) 7%,var(--panel2)); }
  .stance-v { font-size:14px; font-weight:800; letter-spacing:.01em; }

  /* scroll reveal for the flow panels */
  @media (prefers-reduced-motion: no-preference) {
    .intl-flow .reveal { opacity:0; transform:translateY(14px); }
    .intl-flow .reveal.in { opacity:1; transform:none; transition:opacity .5s ease, transform .5s cubic-bezier(.2,.7,.3,1); }
  }

  /* section heads — macro.html structured header with hairline */
  .sec-h { display:flex; align-items:center; gap:11px; flex-wrap:wrap; margin:0 0 15px; padding-bottom:12px; border-bottom:1px solid var(--hair); }
  .sec-h h2 { margin:0; } .sec-h .sub { font-size:12px; color:var(--muted); }
  .panel > h2:first-child { margin:0 0 15px; padding-bottom:12px; border-bottom:1px solid var(--hair); }
  /* segmented control */
  .seg { display:inline-flex; gap:3px; background:var(--panel2); border:1px solid var(--line); border-radius:10px; padding:3px; }
  .seg button { background:none; border:0; color:var(--muted); font:inherit; font-size:12px; font-weight:700; padding:5px 12px;
    border-radius:7px; cursor:pointer; transition:color .15s, background .15s; }
  /* white label on the fill, so the fill takes the SOLID grade — dark --link is a
     pale text-on-graphite blue (#7aa7e0) and white on it measures 2.49:1. */
  .seg button.on { background:var(--fill-link, var(--link)); color:#fff; }
  .seg button:hover:not(.on) { color:var(--text); }

  /* ===== USD performance leaderboard ===== */
  .lb { display:flex; flex-direction:column; gap:3px; margin-top:12px; }
  /* Column geometry. Before: 168px of name (which wrapped "United Kingdom", "South Korea"
     and "STOXX Europe 600" onto three lines and pushed every row to ~90px tall) against a
     bare 1fr bar column (which at desktop width parked the bars in ~800px of track with a
     ~500px gulf beside them). Now the name column is wide enough that nothing wraps, the
     bar track is a FIXED width so the zero axis lands at the same x on every row — the
     whole point of a diverging bar chart — and the row's remaining slack goes to the
     sparkline, the one cell that actually gets better with width. */
  .lb-row { display:grid; grid-template-columns:272px minmax(150px,1fr) 344px 196px; align-items:center; gap:16px;
    padding:8px 8px; border-radius:10px; transition:background .15s; }
  .lb-row:hover { background:var(--panel2); }
  .lb-row .eco { display:flex; align-items:center; gap:8px; font-weight:700; min-width:0; }
  .lb-row .eco > span { min-width:0; }
  .lb-row .eco .flg { font-size:17px; flex:none; } .lb-row .eco small { color:var(--muted); font-weight:500; font-size:11px; display:block; }
  .lb-row .eco .ts-chip { flex:none; }
  /* the sparkline svg is viewBox 200×40 / preserveAspectRatio:none / width:100%, so it
     fills whatever cell it is given — which is why the flexible column is this one */
  .lb-spark { display:flex; align-items:center; min-width:0; }
  .lb-row .nch { display:block; opacity:.9; }
  .lb-bar { position:relative; height:24px; }
  .lb-bar .axis { position:absolute; top:0; bottom:0; left:50%; width:1px; background:var(--line); }
  .lb-seg { position:absolute; top:4px; height:16px; }
  .lb-seg.equity { background:color-mix(in srgb,var(--info) 55%,transparent); border-radius:3px; }
  .lb-seg.fx-pos { background:color-mix(in srgb,var(--up) 80%,transparent); border-radius:3px; }
  .lb-seg.fx-neg { background:color-mix(in srgb,var(--down) 80%,transparent); border-radius:3px; }
  .lb-usd { position:absolute; top:-1px; width:3px; height:26px; background:var(--text); border-radius:2px; }
  .lb-vals { text-align:right; font-variant-numeric:tabular-nums; font-size:12px; line-height:1.3; }
  .lb-vals .big { font-size:16px; font-weight:800; } .lb-vals small { color:var(--muted); display:block; font-size:10.5px; }
  .lb-legend { display:flex; gap:16px; flex-wrap:wrap; font-size:11.5px; color:var(--muted); margin-top:11px; align-items:center; }
  .lb-legend i { display:inline-block; width:11px; height:11px; border-radius:3px; vertical-align:middle; margin-right:5px; }
  @media (max-width:1180px){ .lb-row { grid-template-columns:236px minmax(110px,1fr) minmax(200px,340px) 168px; gap:12px; } }
  @media (max-width:760px){ .lb-row { grid-template-columns:108px 1fr 92px; gap:9px; } .lb-spark { display:none; } }
  @media (max-width:640px){ .lb-row { grid-template-columns:minmax(0,1fr) minmax(0,1fr); } .lb-row .eco { grid-column:1;grid-row:1; } .lb-row .lb-vals { grid-column:2;grid-row:1; } .lb-row .lb-bar { grid-column:1 / -1;grid-row:2; } }

  /* ===== RRG rotation scatter ===== */
  .rrg { position:relative; height:340px; border:1px solid var(--line); border-radius:12px; margin-top:10px; overflow:hidden;
    background:
      linear-gradient(to right, color-mix(in srgb,var(--down) 6%,transparent), transparent 50%, color-mix(in srgb,var(--up) 6%,transparent)),
      linear-gradient(to top, color-mix(in srgb,var(--down) 5%,transparent), transparent 50%, color-mix(in srgb,var(--up) 5%,transparent)); }
  .rrg .ax { position:absolute; background:var(--line); }
  .rrg .ax.h { left:0; right:0; top:50%; height:1px; } .rrg .ax.v { top:0; bottom:0; left:50%; width:1px; }
  .rrg .ql { position:absolute; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; opacity:.8; }
  .rrg .ql.lead { right:10px; top:8px; color:var(--ink-up, var(--up)); } .rrg .ql.impr { left:10px; top:8px; color:var(--ink-info, var(--info)); }
  .rrg .ql.weak { right:10px; bottom:8px; color:var(--ink-warn, var(--warn)); } .rrg .ql.lag { left:10px; bottom:8px; color:var(--ink-down, var(--down)); }
  .rrg .axl { position:absolute; font-size:9.5px; color:var(--muted); }
  .rrg .pt { position:absolute; transform:translate(-50%,-50%); text-align:center; z-index:2; }
  .rrg .pt .dot { width:13px; height:13px; border-radius:50%; margin:0 auto; box-shadow:0 0 0 4px color-mix(in srgb,var(--c) 22%,transparent); background:var(--c); }
  .rrg .pt .e { font-size:19px; line-height:1; } .rrg .pt .n { font-size:9px; color:var(--muted); margin-top:1px; }
  .rrg .pt.q-lead { --c:var(--up); } .rrg .pt.q-impr { --c:var(--info); } .rrg .pt.q-weak { --c:var(--warn); } .rrg .pt.q-lag { --c:var(--down); }
  .tilt { display:inline-flex; align-items:center; gap:8px; padding:6px 13px; border-radius:10px; font-weight:700; font-size:13px;
    background:color-mix(in srgb,var(--c,var(--muted)) 14%,var(--panel2)); color:color-mix(in srgb,var(--c,var(--muted)) 84%,var(--text));
    border:1px solid color-mix(in srgb,var(--c,var(--muted)) 32%,transparent); }
  .tilt.ex_us { --c:var(--up); } .tilt.us { --c:var(--info); } .tilt.mixed { --c:var(--warn); }

  /* ===== rates desk ===== */
  .rdesk { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:12px; margin-top:12px; }
  .rcard { background:var(--panel2); border:1px solid var(--line); border-radius:13px; padding:13px 15px; }
  .rcard .rh { display:flex; align-items:center; gap:8px; margin-bottom:8px; } .rcard .rh .flg { font-size:18px; }
  .rcard .rh b { font-size:14px; } .rcard .rh .shape { margin-left:auto; font-size:10.5px; font-weight:700; padding:2px 8px; border-radius:7px;
    background:color-mix(in srgb,var(--c,var(--muted)) 16%,var(--panel)); color:color-mix(in srgb,var(--c,var(--muted)) 82%,var(--text)); }
  .rcard .shape.inverted { --c:var(--down); } .rcard .shape.flat { --c:var(--warn); } .rcard .shape.normal { --c:var(--up); } .rcard .shape.steep { --c:var(--info); }
  .rcard .rgrid { display:grid; grid-template-columns:1fr 1fr; gap:6px 12px; font-size:12px; }
  .rcard .rk { color:var(--muted); } .rcard .rv { text-align:right; font-weight:700; font-variant-numeric:tabular-nums; }
  /* Two maturity endpoints; shared yield scale, independently readable labels. */
  .curve { margin:9px 0 8px; }
  .curve-plot { position:relative; height:40px; }
  .curve-plot svg { display:block; width:100%; height:100%; overflow:visible; }
  .curve .ln { stroke:var(--c,var(--link)); stroke-width:1.5; vector-effect:non-scaling-stroke; }
  .curve .d { position:absolute; transform:translate(-50%,-50%); width:8px; height:8px; border-radius:var(--r-pill,999px); background:var(--c,var(--link)); }
  .curve-labels { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:12px; }
  .curve .lab { font-size:11px; color:var(--muted); font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
  .curve .lab:last-child { text-align:right; }
  .anchor-card { background:linear-gradient(var(--panel2),var(--panel2)) padding-box, var(--acc-grad) border-box; border:1.5px solid transparent; }

  /* ===== correlation heatmap ===== */
  .heatwrap { overflow-x:auto; margin-top:12px; }
  table.heat { border-collapse:separate; border-spacing:3px; font-size:12px; }
  table.heat th { color:var(--muted); font-weight:600; font-size:11px; padding:3px 5px; white-space:nowrap; }
  table.heat td { width:46px; height:38px; text-align:center; border-radius:7px; font-weight:700; font-variant-numeric:tabular-nums;
    color:var(--text); background:var(--intl-correlation-cell-bg); }
  table.heat td.diag { background:var(--panel2); }
  table.heat th.l { text-align:right; }

  /* ===== index spark cell ===== */
  .gridwrap .nch { display:block; width:74px; height:24px; }
  /* NOTE: the second `.panel.accent` that used to live here painted a 1.5px blue→green
     gradient border. Being later in the sheet it silently beat the frosted-glass rule
     above (line ~151) whose own comment says "not rainbow borders" — so the two flagship
     panels shipped with an outline no other surface on the site has, and macro.html has
     none. Removed: .panel.accent is now the frosted-glass treatment it was written to be. */
  .twocol { display:grid; grid-template-columns:1fr 1fr; gap:14px; } @media (max-width:860px){ .twocol { grid-template-columns:1fr; } }

  /* ===== turn board (ITR) ===== */
  /* Tiles STRETCH to their row (they used to be align-items:start, so one long tile —
     whichever market happened to carry a breadth line and a backdrop paragraph — set the
     row band and every other tile in that row left a void under it; on a 7-across grid
     that was ~180px of dead canvas per row). Now each tile is a flex column, the pullback
     strip is pinned to the floor with margin-top:auto, and the row reads as one block. */
  .tb-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(212px,1fr)); align-items:stretch; gap:10px; margin-top:12px; }
  .tb-tile { display:flex; flex-direction:column; background:var(--panel2); border:1px solid var(--line); border-radius:12px; padding:12px 14px; position:relative; }
  .tb-tile:focus-visible { outline:2px solid var(--info); outline-offset:3px; }
  .tb-tile.tb-hot { border-color:color-mix(in srgb,var(--down) 50%,var(--line)); background:color-mix(in srgb,var(--down) 5%,var(--panel2)); }
  .tb-tile.tb-warm { border-color:color-mix(in srgb,#d4a017 40%,var(--line)); background:color-mix(in srgb,#d4a017 4%,var(--panel2)); }
  .tb-tile.tb-cool { border-color:var(--line); }
  .tb-hd { display:flex; align-items:center; gap:7px; margin-bottom:7px; }
  .tb-hd .flg { font-size:18px; line-height:1; }
  .tb-hd .tb-name { font-size:12.5px; font-weight:700; line-height:1.2; }
  .tb-hd .tb-name small { display:block; font-size:10.5px; font-weight:500; color:var(--muted); }
  .tb-state { display:inline-block; padding:2px 8px; border-radius:8px; font-size:11px; font-weight:700; white-space:nowrap; margin-bottom:5px; }
  .tb-state.ts-crash { background:color-mix(in srgb,var(--down) 20%,transparent); color:var(--ink-down, var(--down)); border:1px solid color-mix(in srgb,var(--down) 40%,transparent); }
  .tb-state.ts-breaking { background:color-mix(in srgb,var(--down) 14%,transparent); color:var(--ink-down, var(--down)); border:1px solid color-mix(in srgb,var(--down) 35%,transparent); }
  .tb-state.ts-topping { background:color-mix(in srgb,#d4a017 18%,transparent); color:var(--ink-warn, var(--warn)); border:1px solid color-mix(in srgb,#d4a017 40%,transparent); }
  .tb-state.ts-parabolic { background:color-mix(in srgb,#d4a017 14%,transparent); color:var(--ink-warn, var(--warn)); border:1px solid color-mix(in srgb,#d4a017 35%,transparent); }
  .tb-state.ts-extended { background:color-mix(in srgb,#d4a017 10%,transparent); color:var(--ink-warn, var(--warn)); border:1px solid color-mix(in srgb,#d4a017 28%,transparent); }
  .tb-state.ts-uptrend { background:color-mix(in srgb,var(--up) 14%,transparent); color:var(--ink-up, var(--up)); border:1px solid color-mix(in srgb,var(--up) 34%,transparent); }
  .tb-state.ts-recovery { background:color-mix(in srgb,var(--up) 10%,transparent); color:var(--ink-up, var(--up)); border:1px solid color-mix(in srgb,var(--up) 28%,transparent); }
  .tb-state.ts-recovery-confirmed { background:color-mix(in srgb,var(--up) 12%,transparent); color:var(--ink-up, var(--up)); border:1px solid color-mix(in srgb,var(--up) 32%,transparent); }
  .tb-state.ts-repair-attempt { background:color-mix(in srgb,#d4a017 10%,transparent); color:var(--ink-warn, var(--warn)); border:1px solid color-mix(in srgb,#d4a017 30%,transparent); }
  .tb-state.ts-rollover-risk { background:color-mix(in srgb,var(--down) 11%,transparent); color:var(--ink-down, var(--down)); border:1px solid color-mix(in srgb,var(--down) 30%,transparent); }
  .tb-state.ts-failed-rebound { background:color-mix(in srgb,var(--down) 18%,transparent); color:var(--ink-down, var(--down)); border:1px solid color-mix(in srgb,var(--down) 40%,transparent); }
  .tb-state.ts-basing { background:color-mix(in srgb,var(--info) 10%,transparent); color:var(--ink-info, var(--info)); border:1px solid color-mix(in srgb,var(--info) 28%,transparent); }
  .tb-state.ts-downtrend { background:color-mix(in srgb,var(--down) 10%,transparent); color:var(--ink-down, var(--down)); border:1px solid color-mix(in srgb,var(--down) 28%,transparent); }
  .tb-state.ts-calm { background:var(--panel2); color:var(--muted); border:1px solid var(--line); }
  .tb-stance { font-size:11.5px; color:var(--text); line-height:1.35; margin-bottom:6px; font-weight:500; }
  .tb-metrics { display:flex; gap:10px; flex-wrap:wrap; font-size:11px; color:var(--muted); }
  .tb-metrics .tm-v { font-weight:700; }
  .tb-metrics .tm-v.pos { color:var(--ink-up, var(--up)); }
  .tb-metrics .tm-v.neg { color:var(--ink-down, var(--down)); }
  /* Events strip. One event is ~6 words, so a full-width row was ~90% empty and six of
     them stacked into a tall, hollow panel. Two columns on desktop: same content, half
     the height, and the panel now reads as a block instead of a ladder. */
  .te-strip { display:grid; grid-template-columns:repeat(auto-fit,minmax(340px,1fr)); gap:0 32px; margin-top:10px; }
  .te-row { display:flex; align-items:baseline; gap:8px; font-size:12px; padding:7px 0; border-bottom:1px solid var(--line); }
  .te-row:last-child { border-bottom:none; }
  /* in the 2-up layout the second-to-last row shares the final band — drop its rule too */
  @media (min-width:760px) { .te-strip > .te-row:nth-last-child(2):nth-child(odd) { border-bottom:none; } }
  .te-date { font-size:10.5px; color:var(--muted); font-variant-numeric:tabular-nums; white-space:nowrap; flex-shrink:0; }
  .te-flag { font-size:14px; flex-shrink:0; }
  .te-txt { color:var(--text); flex:1; }
  /* compact state chip for table columns */
  .ts-chip { display:inline-block; padding:1px 6px; border-radius:6px; font-size:10px; font-weight:700; white-space:nowrap; border:1px solid transparent; }
  .ts-chip.ts-crash { background:color-mix(in srgb,var(--down) 18%,transparent); color:var(--ink-down, var(--down)); border-color:color-mix(in srgb,var(--down) 35%,transparent); }
  .ts-chip.ts-breaking { background:color-mix(in srgb,var(--down) 12%,transparent); color:var(--ink-down, var(--down)); border-color:color-mix(in srgb,var(--down) 30%,transparent); }
  .ts-chip.ts-topping { background:color-mix(in srgb,#d4a017 14%,transparent); color:var(--ink-warn, var(--warn)); border-color:color-mix(in srgb,#d4a017 35%,transparent); }
  .ts-chip.ts-parabolic { background:color-mix(in srgb,#d4a017 10%,transparent); color:var(--ink-warn, var(--warn)); border-color:color-mix(in srgb,#d4a017 28%,transparent); }
  .ts-chip.ts-extended { background:color-mix(in srgb,#d4a017 8%,transparent); color:var(--ink-warn, var(--warn)); border-color:color-mix(in srgb,#d4a017 24%,transparent); }
  .ts-chip.ts-uptrend { background:color-mix(in srgb,var(--up) 12%,transparent); color:var(--ink-up, var(--up)); border-color:color-mix(in srgb,var(--up) 28%,transparent); }
  .ts-chip.ts-recovery { background:color-mix(in srgb,var(--up) 8%,transparent); color:var(--ink-up, var(--up)); border-color:color-mix(in srgb,var(--up) 24%,transparent); }
  .ts-chip.ts-basing { background:color-mix(in srgb,var(--info) 8%,transparent); color:var(--ink-info, var(--info)); border-color:color-mix(in srgb,var(--info) 24%,transparent); }
  .ts-chip.ts-downtrend { background:color-mix(in srgb,var(--down) 8%,transparent); color:var(--ink-down, var(--down)); border-color:color-mix(in srgb,var(--down) 24%,transparent); }
  .ts-chip.ts-calm { background:var(--panel2); color:var(--muted); }
  /* pullback-risk radar strip inside turn tiles (#2684 risk_radar_intl.v1, display-only) */
  .tb-rd { margin-top:auto; padding-top:8px; border-top:1px dashed var(--line); }
  .tb-rd-hd { display:flex; align-items:center; gap:6px; }
  .tb-rd-lb { font-size:10.5px; font-weight:600; color:var(--muted); letter-spacing:.02em; }
  .tb-rd-chip { display:inline-block; padding:1px 7px; border-radius:7px; font-size:10px; font-weight:700; white-space:nowrap; border:1px solid transparent; margin-left:auto; }
  .tb-rd-chip.rd-calm { background:var(--panel2); color:var(--muted); border-color:var(--line); }
  .tb-rd-chip.rd-watch { background:color-mix(in srgb,#d4a017 8%,transparent); color:var(--ink-warn, var(--warn)); border-color:color-mix(in srgb,#d4a017 22%,transparent); }
  .tb-rd-chip.rd-caution { background:color-mix(in srgb,#d4a017 14%,transparent); color:var(--ink-warn, var(--warn)); border-color:color-mix(in srgb,#d4a017 35%,transparent); }
  .tb-rd-chip.rd-elevated { background:color-mix(in srgb,var(--down) 12%,transparent); color:var(--ink-down, var(--down)); border-color:color-mix(in srgb,var(--down) 30%,transparent); }
  .tb-rd-chip.rd-risk-off { background:color-mix(in srgb,var(--down) 18%,transparent); color:var(--ink-down, var(--down)); border-color:color-mix(in srgb,var(--down) 40%,transparent); }
  .tb-rd-line { font-size:11px; color:var(--text); line-height:1.35; margin-top:5px; }
  .tb-rd-foot { margin:12px 2px 0; line-height:1.5; }
  /* turn-tile rich-lens popover: "stretch" gauge (cloned by theme.js into .lens-pop,
     so it inherits the engine's --lens-* token chain — light mode + vector-safe) */
  .tbl-gauge { margin:9px 16px 2px; }
  .tbl-gauge-top { display:flex; align-items:baseline; justify-content:space-between; gap:10px;
    font:700 8.5px/1.3 var(--font-ui,Inter,sans-serif); letter-spacing:.1em; text-transform:uppercase;
    color:color-mix(in srgb,var(--lens-mut,var(--muted,#8b93a1)) 82%,transparent); }
  .tbl-gauge-top b { font:800 12.5px/1 var(--font-ui,Inter,sans-serif); letter-spacing:0;
    color:var(--lens-text,var(--text,#e8ecf2)); font-variant-numeric:tabular-nums; }
  .tbl-gauge-top b i { font-style:normal; font-size:8px; font-weight:700; margin-left:1px;
    color:var(--lens-mut,var(--muted,#8b93a1)); }
  .tbl-gauge-track { position:relative; height:8px; margin-top:5px; border-radius:5px; overflow:hidden;
    background:color-mix(in srgb,var(--lens-mut,var(--muted,#8b93a1)) 22%,transparent); }
  .tbl-gauge-track::after { content:""; position:absolute; top:0; bottom:0; left:90%; width:1px;
    background:color-mix(in srgb,var(--lens-mut,var(--muted,#8b93a1)) 55%,transparent); }
  .tbl-gauge-fill { position:absolute; inset:0 auto 0 0; width:var(--w,50%); border-radius:5px;
    background:linear-gradient(90deg,color-mix(in srgb,var(--lens-accent,#d4a017) 42%,transparent),var(--lens-accent,#d4a017)); }
  @media (prefers-reduced-motion:no-preference) {
    .lens-pop.open .tbl-gauge-fill { transform:scaleX(0); transform-origin:0 50%;
      animation:tblGrow .62s cubic-bezier(.22,.9,.26,1.02) .12s both; }
  }
  @keyframes tblGrow { to { transform:scaleX(1); } }
</style>
</head>
<body{% if mode != 'stocks' %} class="page-intl{% if intl_workspace|default(none) %} intl-workspace-page{% endif %}"{% endif %}>
<div class="intl-aurora" aria-hidden="true"><b class="a1"></b><b class="a2"></b><b class="a3"></b></div>

{% include "_site_nav.html.j2" %}

<main class="intl-flow">
{% if mode != 'stocks' and intl_workspace|default(none) %}
{% include 'intl_workspace/shell.html.j2' %}
<details id="intl-legacy-research" open>
  <summary>{{ t('Detailed international research and existing tools', '详细国际市场研究与现有工具') }}</summary>
{% endif %}

{# Chairman-directed cross-market overview; US Macro retains its own dashboard. #}
{% if mode != 'stocks' %}
{{ global_regime_html|default('')|safe }}
{% endif %}

{% if mode == 'stocks' %}
<div class="panel">
  <div class="row">
    <h1>{{ t('International Stock Dashboard', '国际股票看板') }}</h1>
    <span style="flex:1"></span>
    <span class="muted small">{{ t('data through', '数据截至') }} {{ latest.date }} · {{ t('built', '生成') }} {{ built }}</span>
  </div>
  <p class="muted small" style="margin:6px 0 0">{{ t('Prophet signals from major non-US markets, ranked within their own market. Search any name above.', '主要非美市场 Prophet 选股，按各自市场内部排序。可在上方搜索。') }}
    <a href="intl.html" style="color:var(--ink-link, var(--link));font-weight:600">← {{ t('Macro comparison', '宏观对比') }}</a></p>
</div>
{% endif %}

{% if mode != 'stocks' %}{# ================= MACRO COMPARISON ================= #}
{% set GR = perf.global_read if perf else None %}
{% set RK = perf.risk_appetite if perf else None %}
{% set RG = perf.rrg if perf else None %}
{% set CR = perf.correlation if perf else None %}
{% set LB = perf.leaderboard if perf else [] %}

{# ---- quad plain-word translation dict (Tier-2 receipts keep internal names) ---- #}
{% set QUAD_PLAIN_EN = {
  'Goldilocks': 'growth OK, inflation calm',
  'Reflation': 'growth up, inflation up',
  'Stagflation': 'growth down, inflation up',
  'Growth-scare': 'growth down, inflation down',
  'Deflation': 'growth down, inflation down'
} %}
{% set QUAD_PLAIN_ZH = {
  'Goldilocks': '增长尚可、通胀温和',
  'Reflation': '增长回升、通胀走高',
  'Stagflation': '增长走弱、通胀走高',
  'Growth-scare': '增长与通胀双弱',
  'Deflation': '增长与通胀双弱'
} %}

{# ---- hot state set for guard logic ---- #}
{% set HOT_STATES = ['crash', 'breaking', 'topping'] %}

<!-- ===== WORLD COMMAND — hero scorecard (mx5 glass) ===== -->
{% set _rk_score = (RK.score|round|int) if (RK and RK.score is defined and RK.score is not none) else None %}
{# verdict + tone come from ENGINE truth (World Risk Appetite v2), never recomputed
   here: RK.tone maps up→up, down→down, warn/flat→warn. The score is engine-owned
   and is never floored or overridden by the verdict. Absent input has no verdict
   or gauge fill; retained metadata is not a reading. #}
{% set _rk_state = 'unavailable' if _rk_score is none else (('up' if RK.tone=='up' else 'down' if RK.tone=='down' else 'warn') if (RK and RK.tone) else ('up' if _rk_score is not none and _rk_score >= 60 else 'down' if _rk_score is not none and _rk_score < 40 else 'warn')) %}
{% set _verdict_en = 'Unavailable' if _rk_score is none else (RK.label_en if (RK and RK.label_en) else ('Risk-on' if _rk_state=='up' else 'Risk-off' if _rk_state=='down' else 'Neutral')) %}
{% set _verdict_zh = '暂无数据' if _rk_score is none else (RK.label_zh if (RK and RK.label_zh) else ('风险偏好' if _rk_state=='up' else '风险规避' if _rk_state=='down' else '中性')) %}
{% set _aur = '' if _rk_score is none else ('aur-on' if _rk_state=='up' else 'aur-on aur-warn' if _rk_state=='warn' else 'aur-on aur-risk') %}
{# gauge: true semicircle radius 82 (chord 164 = endpoints 18↔182) → arc length π·82 ≈ 257.6 #}
{% set _circ = 257.6 %}
{% set _goff = (_circ * (1 - _rk_score/100)) if _rk_score is not none else None %}
{% set _gcol = 'var(--ink-3)' if _rk_score is none else ('var(--up)' if _rk_state=='up' else 'var(--down)' if _rk_state=='down' else 'var(--warn)') %}
{# tug marker 0..100% (50 = balanced); share of ex-US markets leading pushes toward World #}
{% set _tug_pos = ((RG.n_leading / RG.n * 100)|round|int) if (RG and RG.n) else 50 %}
<div class="wc" data-aur="{{ _aur }}">
  <div class="wc-top">
    <div class="wc-left">
      <div class="wc-eyebrow"><span class="dot"></span>{{ t('Global Macro Compass', '全球宏观罗盘') }} · <span class="num">{{ latest.date }}</span><span style="flex:1"></span><a href="intl_stocks.html" style="color:var(--ink-link, var(--link));font-weight:700;text-transform:none;letter-spacing:.01em;font-size:11.5px">{{ t('Stock dashboard', '股票看板') }} →</a></div>
      <div class="wc-gauge-wrap">
        <div class="wc-gauge">
          <svg viewBox="0 0 200 112" role="img" aria-labelledby="intl-compass-caption{% if _rk_score is not none %} intl-compass-score intl-compass-scale{% endif %} intl-compass-verdict">
            <path class="wc-gauge-track" d="M 18 98 A 82 82 0 0 1 182 98" fill="none" stroke-width="12"/>
            {% if _rk_score is not none %}
            <path class="wc-gauge-fill" d="M 18 98 A 82 82 0 0 1 182 98" fill="none" stroke-width="12"
              style="--gc:{{ _gcol }};--circ:{{ _circ }};stroke-dasharray:{{ _circ }};stroke-dashoffset:{{ '%.1f'|format(_goff) }}"/>
            {% endif %}
            <text id="intl-compass-score" class="wc-gnum" x="100" y="84" text-anchor="middle" style="--gc:{{ _gcol }};">{{ _rk_score if _rk_score is not none else '—' }}</text>
            <text id="intl-compass-scale" class="wc-gnum-sub" x="100" y="102" text-anchor="middle">/ 100</text>
          </svg>
        </div>
        {# hover receipt: what the dial actually weighs (cap-weighted, US counts most).
           data-tip-en/zh only — CI forbids translated text in title= attributes. #}
        {% set _rk_cov = (RK.coverage_pct|round|int) if (_rk_score is not none and RK.coverage_pct is not none) else None %}
        {% set _rk_receipt_en = ('Weighs ' ~ RK.n_available ~ ' markets by size — the US counts most. Covers ~' ~ _rk_cov ~ '% of world market value. ' ~ (RK.breadth_above_200d ~ ' above their 200-day line' if RK.breadth_above_200d is not none else '') ~ (' · median 3-mo move ' ~ RK.median_mom_3m ~ '%' if RK.median_mom_3m is not none else '')) if (RK and _rk_cov is not none) else '' %}
        {% set _rk_receipt_zh = ('按市值加权覆盖 ' ~ RK.n_available ~ ' 个市场（美国权重最大），约占全球市值 ' ~ _rk_cov ~ '%。' ~ (RK.breadth_above_200d ~ ' 站上200日线' if RK.breadth_above_200d is not none else '') ~ (' · 3个月中位涨跌 ' ~ RK.median_mom_3m ~ '%' if RK.median_mom_3m is not none else '')) if (RK and _rk_cov is not none) else '' %}
        <div class="wc-gside"{% if _rk_receipt_en %} data-tip-en="{{ _rk_receipt_en }}" data-tip-zh="{{ _rk_receipt_zh }}"{% endif %}>
          <div id="intl-compass-verdict" class="wc-verdict v-{{ _rk_state }}"><span class="l-en">{{ _verdict_en }}</span><span class="l-zh">{{ _verdict_zh }}</span></div>
          <div id="intl-compass-caption" class="wc-gauge-cap">{{ t('World risk appetite', '全球风险偏好') }}</div>
          {% if _rk_score is not none and RK.top_drags %}
          <div class="wc-substance"><span class="l-en">Dragged by {% for d in RK.top_drags %}{{ d.flag }} {{ d.name }}{% if not loop.last %} · {% endif %}{% endfor %}</span><span class="l-zh">拖累：{% for d in RK.top_drags %}{{ d.name_zh }}{% if not loop.last %} · {% endif %}{% endfor %}</span></div>
          {% elif _rk_score is not none %}
          <div class="wc-substance"><span class="l-en">Broad strength — no major market breaking down</span><span class="l-zh">普涨——无主要市场破位</span></div>
          {% endif %}
        </div>
      </div>
    </div>
    <div class="wc-right">
      {% if GR %}
      <div>
        <div class="wc-kick">{{ t('The world right now', '当下全球') }}</div>
        <p class="wc-read">{{ t(GR.en, GR.zh) }}</p>
      </div>
      {% endif %}
      {% if RG and RG.n %}
      <div class="tug">
        <div class="tug-head">
          <span class="th-lbl">{{ t('US vs the World', '美国 vs 全球') }}</span>
          <span class="th-count">{{ RG.n_leading }}/{{ RG.n }} {{ t('ex-US markets ahead', '非美市场领先') }}</span>
        </div>
        <div class="tug-beam">
          <div class="tug-fill tf-us"></div><div class="tug-fill tf-world"></div>
          <div class="tug-mid"></div>
          <div class="tug-marker" style="--pos:{{ _tug_pos }}%"></div>
        </div>
        <div class="tug-ends">
          <span class="te-us"><span class="flg">🇺🇸</span> {{ t('US leads', '美国领先') }}</span>
          <span class="te-wo">{{ t('World leads', '全球领先') }} <span class="flg">🌍</span></span>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="wc-vitals">
    <div class="wc-vital">
      <div class="vk">{{ t('Dominant regime', '主导周期') }}</div>
      <div class="vv word"><span class="l-en">{{ QUAD_PLAIN_EN.get(S.dominant_quad, S.dominant_quad) }}</span><span class="l-zh">{{ QUAD_PLAIN_ZH.get(S.dominant_quad, S.dominant_quad) }}</span></div>
      <div class="vs">{{ S.n }} {{ t('economies', '经济体') }}</div>
    </div>
    {% set bestr = LB[0] if LB else None %}
    {% set bh = (bestr.returns.get('12m') or bestr.returns.get('6m') or bestr.returns.get('3m') or bestr.returns.get('ytd')) if bestr else None %}
    <div class="wc-vital">
      <div class="vk">{{ t('USD leader', '美元领涨') }}</div>
      {% if bestr and bh %}<div class="vv word">{{ bestr.flag }} {{ bestr.cc }}</div>
      <div class="vs">{{ '%+.0f'|format(bh.usd) }}% {{ t('in USD', '美元计') }}</div>
      {% else %}<div class="vv word">—</div><div class="vs">{{ t('building', '构建中') }}</div>{% endif %}
    </div>
    <div class="wc-vital">
      <div class="vk">{{ t('Recession-watch', '衰退观察') }}</div>
      <div class="vv {{ 'warn' if S.recession_watch else '' }}">{{ S.recession_watch }}</div>
      <div class="vs">{{ t('of', '共') }} {{ S.n }} {{ t('economies', '经济体') }}</div>
    </div>
    <div class="wc-vital">
      {% if CR and CR.avg_offdiag is not none %}
      <div class="vk">{{ t('Avg correlation', '平均相关性') }}</div>
      <div class="vv">{{ '%.2f'|format(CR.avg_offdiag) }}</div>
      <div class="vs">{{ t('weekly USD returns', '美元周收益') }}</div>
      {% else %}
      <div class="vk">{{ t('Drawdown-watch', '回撤观察') }}</div>
      <div class="vv">{{ S.drawdown_watch }}</div>
      <div class="vs">{{ t('of', '共') }} {{ S.n }} {{ t('economies', '经济体') }}</div>
      {% endif %}
    </div>
  </div>
</div>

<!-- ===== ACT 1 — What's moving now? (world turns & rotation) ===== -->
{% if turn_board %}
<div class="act-h"><span class="aq">{{ t("What's moving now?", '当下在动什么？') }}</span><span class="as">{{ t('Every market read straight from its price — hottest first.', '每个市场直接读自其价格——最紧迫者在前。') }}</span></div>
{# ---- pullback-risk radar plain-word maps (states + stances; enums stay in hover receipts) ---- #}
{% set RD_STATE_EN = {'calm': 'Calm', 'watch': 'Watch', 'caution': 'Caution', 'elevated': 'Elevated', 'risk-off': 'Risk-off'} %}
{% set RD_STATE_ZH = {'calm': '平静', 'watch': '留意', 'caution': '谨慎', 'elevated': '偏高', 'risk-off': '避险'} %}
{% set RD_STANCE_EN = {'watch': "watch, don't chase", 'caution': 'get ready to protect gains', 'elevated': 'protect gains', 'risk-off': 'protect gains, stand aside'} %}
{% set RD_STANCE_ZH = {'watch': '观察，勿追高', 'caution': '准备保护收益', 'elevated': '保护收益', 'risk-off': '保护收益，观望'} %}
{# ---- turn-tile rich-lens popover copy (plain-word reads + accent/glyph maps) ---- #}
{% set TB_READ_EN = {
  'crash':     'A fast, deep selloff still dominates the 20-day tape. Treat the trend as broken until repair signals confirm otherwise.',
  'breaking':  'It ran up, then cracked: price has snapped below its recent floor and momentum rolled over.',
  'topping':   'Still up high, but the first cracks are showing — momentum is fading right near the top.',
  'parabolic': 'Shooting almost straight up. Moves this steep rarely last, and the snap-back tends to be sharp.',
  'extended':  'Stretched well above its own trend — not broken, but priced for a lot to keep going right.',
  'downtrend': 'Grinding lower for weeks now. The path of least resistance is still downward.',
  'recovery':  'The broad index has repaired some technical damage. That price state alone does not confirm healthy leadership or a durable recovery.',
  'basing':    'The fall has stalled and it is trying to carve out a floor. No turn up is confirmed yet.',
  'uptrend':   'Climbing in good health — above its key averages with real momentum behind it.',
  'calm':      'Quiet. Nothing stretched, nothing breaking — and nothing that needs a decision today.'
} %}
{% set TB_READ_ZH = {
  'crash':     '近20日走势仍由快速深跌主导。在修复信号确认前，应视为趋势已破坏。',
  'breaking':  '先急涨、后破位：价格跌穿近期支撑，动能掉头向下。',
  'topping':   '仍在高位，但已现初步裂痕——顶部附近动能正在减弱。',
  'parabolic': '近乎垂直的拉升。如此陡峭的涨势难以持久，回落往往迅猛。',
  'extended':  '已明显高于自身趋势——尚未破位，但已计入大量利好。',
  'downtrend': '已连续数周走低。阻力最小的方向仍然向下。',
  'recovery':  '宽基指数已修复部分技术损伤。仅凭这一价格状态，不能确认领涨健康或复苏可持续。',
  'basing':    '跌势已止，正尝试筑底。尚未确认转上。',
  'uptrend':   '健康上行——站上关键均线，且有实实在在的动能支撑。',
  'calm':      '平静。既不极端，也未破位——今天没有需要做的决定。'
} %}
{# state → LENS accent kind (caution=warn · read=amber · record=green · define=blue · source=muted) #}
{% set TB_KIND = {
  'crash':'caution','breaking':'caution','downtrend':'caution',
  'topping':'read','parabolic':'read','extended':'read',
  'uptrend':'record','recovery':'record','basing':'define','calm':'source'
} %}
{# state → header glyph family #}
{% set TB_GRP = {
  'crash':'fall','breaking':'fall','downtrend':'fall',
  'topping':'stretch','parabolic':'stretch','extended':'stretch',
  'uptrend':'rise','recovery':'rise','basing':'flat','calm':'flat'
} %}
{% macro tb_glyph(grp) -%}
{%- if grp == 'fall' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6l6.5 7 4-3.2L21 18"/><path d="M15.5 18H21v-5.5"/></svg>
{%- elif grp == 'stretch' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20c6 .5 9.6-4 10.9-15.3"/><path d="M11.2 6.4l3.8-1.7 1.5 3.8"/></svg>
{%- elif grp == 'rise' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18l6.5-7 4 3.2L21 6"/><path d="M15.5 6H21v5.5"/></svg>
{%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16"/></svg>
{%- endif -%}
{%- endmacro %}
<div class="panel accent">
  <div class="sec-h">
    <h2 id="intl-market-turns">{{ t('World markets — turns & rotation', '全球市场 — 拐点与轮动') }}
      {{ help('Each market\'s trend, read straight from its price action — climbing, stretched, topping out, breaking, or falling. The hottest markets sort to the top, and every card tells you what to do. The "pullback risk" tag is a separate heads-up that a drop may be brewing — from US rates, the currency, or a stretched price. It is context only, never a forecast, and never ranks the markets. Hover any card for the full read.', '每个市场的趋势，直接读自其价格走势——上行、伸展、见顶、破位或下跌。最紧迫的市场排在最前，每张卡都会告诉你该怎么做。「回撤风险」标签是另一重提示，表示可能正在酝酿一轮下跌——来自美债利率、汇率或价格过度伸展。它仅供参考，绝非预测，也不参与市场排名。将鼠标悬停在任意卡片上可查看完整解读。') }}
    </h2>
    <span style="flex:1"></span>
    <span class="muted small">{{ t('as of', '截至') }} {{ latest.date }}</span>
  </div>
  <div class="tb-grid">
  {% for tile in turn_board %}
    {# determine tile heat class #}
    {% set _ts = tile.state %}
    {% set _qa = tile.get('recovery_assessment') or {} %}
    {% set _mb = tile.get('macro_backdrop') or {} %}
    {% set _display_ts = _qa.get('css') or _ts %}
    {% set _display_en = _qa.get('label_en') or tile.state_en or tile.state %}
    {% set _display_zh = _qa.get('label_zh') or tile.state_zh or tile.state %}
    {% set _stance_en = _qa.get('stance_en') or tile.stance_en %}
    {% set _stance_zh = _qa.get('stance_zh') or tile.stance_zh %}
    {% if _qa.get('heat') == 'hot' or _ts in ['crash', 'breaking'] %}{% set _tile_cls = 'tb-hot' %}
    {% elif _qa.get('heat') == 'warm' or _ts in ['topping', 'parabolic', 'extended'] %}{% set _tile_cls = 'tb-warm' %}
    {% else %}{% set _tile_cls = 'tb-cool' %}
    {% endif %}
    {# pullback-risk radar (#2684, display-only) — schema risk_radar_intl.v1; absent/degraded → skipped #}
    {% set _rd = tile.get('risk_radar') %}
    {% if not (_rd and _rd.get('state')) %}{% set _rd = none %}{% endif %}
    {% set _rd_state = _rd.get('state') if _rd else none %}
    {% set _rd_prob = (_rd.get('drawdown_prob') or {}) if _rd else {} %}
    {% set _rd_h21 = _rd_prob.get('h21') %}
    {% set _rd_b21 = _rd_prob.get('base_h21') %}
    {% set _rd_lift = _rd_prob.get('lift_h21') %}
    {# ---- per-tile popover helpers (dates trimmed to MM-DD; stretch pctile → int) ---- #}
    {% set _since_s = tile.since[5:] if tile.since else none %}
    {% set _peak_s = tile.peak_date[5:] if tile.peak_date else none %}
    {% set _kind = _qa.get('lens_kind') or TB_KIND.get(tile.state, 'source') %}
    {% set _grp = _qa.get('glyph') or TB_GRP.get(tile.state, 'flat') %}
    {% set _ext_i = (tile.ext_pctile|round|int) if tile.ext_pctile is not none else none %}
    {% set _cf = tile.get('confirmation') %}
    {% set _cf5 = ((_cf.get('windows') or {}).get('5d') or {}) if _cf else {} %}
    {% set _cf20 = ((_cf.get('windows') or {}).get('20d') or {}) if _cf else {} %}
    {# compact plain fallback (trigger hook + JS-off / older-cache): state + stance, one line #}
    {% set _fb_en = _display_en ~ ': ' ~ _stance_en ~ '.' %}
    {% set _fb_zh = _display_zh ~ '：' ~ _stance_zh ~ '。' %}
    <div class="tb-tile {{ _tile_cls }}" tabindex="0" role="group" aria-labelledby="intl-turn-{{ loop.index }}-name" data-lens-kind="{{ _kind }}" data-tip-en="{{ _fb_en }}" data-tip-zh="{{ _fb_zh }}">
      {# ---- rich LENS popover, cloned by theme.js on hover/focus/tap. The plain data-tip
             above is the trigger hook + fallback; the human read lives in .lens-body and the
             machine numbers are demoted to the mono receipt under the perforation. ---- #}
      <span class="lens-src" data-lens-kind="{{ _kind }}" hidden>
        <div class="lens-hd">
          <span class="lens-ill">{{ tb_glyph(_grp) }}</span>
          <span class="lens-hgroup">
            <span class="lens-kick"><span class="l-en">{{ tile.name }}</span><span class="l-zh">{{ tile.name_zh }}</span></span>
            <span class="lens-title"><span class="l-en">{{ _display_en }}</span><span class="l-zh">{{ _display_zh }}</span></span>
          </span>
        </div>
        {% if _ext_i is not none %}
        <div class="tbl-gauge">
          <div class="tbl-gauge-top">
            <span><span class="l-en">Stretch vs its 10-yr range</span><span class="l-zh">相对10年区间的伸展度</span></span>
            <b>{{ _ext_i }}<i>/100</i></b>
          </div>
          <div class="tbl-gauge-track"><span class="tbl-gauge-fill" style="--w:{{ _ext_i }}%"></span></div>
        </div>
        {% endif %}
        <div class="lens-body">
          <span class="l-en">{{ _qa.get('read_en') or TB_READ_EN.get(tile.state, '') }} <b>{{ _stance_en }}.</b></span>
          <span class="l-zh">{{ _qa.get('read_zh') or TB_READ_ZH.get(tile.state, '') }} <b>{{ _stance_zh }}。</b></span>
        </div>
        {% if _cf and _cf.get('read_en') %}
        <div class="lens-body">
          <span class="l-en">{{ _cf.get('read_en') }}</span>
          <span class="l-zh">{{ _cf.get('read_zh') }}</span>
        </div>
        {% endif %}
        {% if _mb.get('read_en') %}
        <div class="lens-body">
          <span class="l-en"><b>Macro backdrop:</b> {{ _mb.get('read_en') }}</span>
          <span class="l-zh"><b>宏观背景：</b>{{ _mb.get('read_zh') }}</span>
        </div>
        {% endif %}
        {# receipt: precise machine numbers, demoted under the perforation. Built as a list
           so a data-limited stub (all-null) drops the receipt entirely — no empty bar. #}
        {% set _rc_en = [] %}{% set _rc_zh = [] %}
        {% if _since_s %}{% set _ = _rc_en.append('<b>Since</b> ' ~ _since_s) %}{% set _ = _rc_zh.append('<b>进入状态</b> ' ~ _since_s) %}{% endif %}
        {% if _peak_s %}{% set _ = _rc_en.append('<b>Peak</b> ' ~ _peak_s) %}{% set _ = _rc_zh.append('<b>见顶</b> ' ~ _peak_s) %}{% endif %}
        {% if tile.mom20_pct is not none %}{% set _ = _rc_en.append('<b>20-day</b> ' ~ '%+.1f'|format(tile.mom20_pct) ~ '%') %}{% set _ = _rc_zh.append('<b>20日</b> ' ~ '%+.1f'|format(tile.mom20_pct) ~ '%') %}{% endif %}
        {% if tile.dd_pct is not none %}{% set _ = _rc_en.append('<b>Off high</b> ' ~ '%.1f'|format(tile.dd_pct) ~ '%') %}{% set _ = _rc_zh.append('<b>距高</b> ' ~ '%.1f'|format(tile.dd_pct) ~ '%') %}{% endif %}
        {% if tile.macd_state %}{% set _ = _rc_en.append('<b>Momentum</b> ' ~ ('improving' if tile.macd_state == 'bull' else 'fading')) %}{% set _ = _rc_zh.append('<b>动能</b> ' ~ ('转强' if tile.macd_state == 'bull' else '转弱')) %}{% endif %}
        {# pullback odds, demoted off the tile face (they were printed on every tile at rest) #}
        {% if _rd_h21 is not none %}{% set _ = _rc_en.append('<b>≥5% dip in a month</b> ~' ~ (_rd_h21*100)|round|int ~ '%' ~ (' vs ~' ~ (_rd_b21*100)|round|int ~ '% base' if _rd_b21 is not none else '')) %}{% set _ = _rc_zh.append('<b>一个月内≥5%回撤</b> 约' ~ (_rd_h21*100)|round|int ~ '%' ~ ('（基准约' ~ (_rd_b21*100)|round|int ~ '%）' if _rd_b21 is not none else '')) %}
        {# honest provenance travels WITH the number it qualifies (it used to be a Tier-1
           footer sentence describing a figure the user could no longer see at rest) #}
        {% set _ = _rc_en.append('<b>Odds from</b> ' ~ ('own history + this radar&#39;s live record' if (_rd_lift is not none and _rd_lift != 1.0) else 'own history only — radar record still building')) %}{% set _ = _rc_zh.append('<b>概率来源</b> ' ~ ('自身历史 + 该雷达实时记录' if (_rd_lift is not none and _rd_lift != 1.0) else '仅自身历史——雷达记录仍在累积')) %}{% endif %}
        {% if _rc_en %}
        <div class="lens-receipt">
          <span class="l-en">{{ _rc_en|join(' · ')|safe }}</span>
          <span class="l-zh">{{ _rc_zh|join(' · ')|safe }}</span>
        </div>
        {% endif %}
      </span>{# end .lens-src #}
      <div class="tb-hd">
        <span class="flg">{{ tile.flag }}</span>
        <div class="tb-name" id="intl-turn-{{ loop.index }}-name">
          <span class="l-en">{{ tile.name }}</span><span class="l-zh">{{ tile.name_zh }}</span>
          <small>{{ tile.cc }}</small>
        </div>
      </div>
      <div>
        <span class="tb-state ts-{{ _display_ts }}">
          <span class="l-en">{{ _display_en }}</span><span class="l-zh">{{ _display_zh }}</span>
        </span>
      </div>
      <div class="tb-stance">
        <span class="l-en">{{ _stance_en }}</span><span class="l-zh">{{ _stance_zh }}</span>
      </div>
      {# The "Tech breadth · 20d 4/4 up · 5d 1/4 up" line and the "Backdrop · …" paragraph
         used to sit here, on the glance tier. Both are Tier-2 material (raw fractions and
         a 20-word macro paragraph), both appeared on only one or two markets — so they set
         the row height for the whole grid and left every other tile with a void under it —
         and both were ALREADY carried, in fuller plain-word form, by the hover lens above
         (`_cf.read_en` / `_mb.read_en`). Removed from the face; nothing is lost. #}
      <div class="tb-metrics">
        <span>{{ t('20d', '20日') }} <span class="tm-v {{ 'pos' if tile.mom20_pct is not none and tile.mom20_pct >= 0 else 'neg' if tile.mom20_pct is not none }}">{% if tile.mom20_pct is not none %}{{ '%+.1f'|format(tile.mom20_pct) }}%{% else %}—{% endif %}</span></span>
        <span>{{ t('off-high', '距高') }} <span class="tm-v {{ 'neg' if tile.dd_pct is not none and tile.dd_pct < -2 }}">{% if tile.dd_pct is not none %}{{ '%.1f'|format(tile.dd_pct) }}%{% else %}—{% endif %}</span></span>
      </div>
      {% if _rd %}
      <div class="tb-rd">
        <div class="tb-rd-hd">
          <span class="tb-rd-lb">{{ t('Pullback risk', '回撤风险') }}</span>
          <span class="tb-rd-chip rd-{{ _rd_state }}">{{ t(RD_STATE_EN.get(_rd_state, _rd_state), RD_STATE_ZH.get(_rd_state, _rd_state)) }}</span>
        </div>
        <div class="tb-rd-line">
          {% if _rd_state == 'calm' %}
          {{ t('nothing to do', '无需操作') }}
          {% else %}
          <span class="l-en">{{ _rd.get('dominant_label_en') or 'driver elevated' }} — {{ RD_STANCE_EN.get(_rd_state, RD_STANCE_EN['watch']) }}</span><span class="l-zh">{{ _rd.get('dominant_label_zh') or _rd.get('dominant_label_en') or '驱动升高' }}——{{ RD_STANCE_ZH.get(_rd_state, RD_STANCE_ZH['watch']) }}</span>
          {% endif %}
        </div>
        {# The "≥5% dip within a month: ~29% vs ~29% base" line used to print here on EVERY
           tile. It is a bare statistic with no stance attached, and on most tiles the two
           figures are equal — i.e. it says "no lift", at the cost of a line on ten tiles.
           Moved to the hover receipt, where the precision belongs. #}
      </div>
      {% endif %}
    </div>
  {% endfor %}
  </div>
  {# One line, one job: say what the chips are not, and point at the hover. The provenance
     of the odds (own-history vs live-track-record lift) moved into the ? tip on the h2 —
     it is a receipt, and it was printing two long sentences under every grid. #}
  <p class="muted small tb-rd-foot">
    {{ t('Risk tags are context, never a ranking. Hover any market for the full read.', '风险标签仅供参考，不参与排名。将鼠标悬停在任一市场上可查看完整解读。') }}
  </p>
</div>

{% include 'intl_recovery_quality.html.j2' %}

<!-- ===== What changed strip ===== -->
{% if turn_events %}
<div class="panel">
  <div class="sec-h"><h2>{{ t('What changed', '近期变化') }}</h2></div>
  <div class="te-strip">
  {% for ev in turn_events[:6] %}
    <div class="te-row">
      <span class="te-date">{{ ev.date }}</span>
      <span class="te-flag">{{ ev.flag }}</span>
      <span class="te-txt">
        <b><span class="l-en">{{ ev.name }}</span><span class="l-zh">{{ ev.name_zh }}</span></b>
        — <span class="l-en">{{ ev.en }}</span><span class="l-zh">{{ ev.zh }}</span>
      </span>
    </div>
  {% endfor %}
  </div>
</div>
{% endif %}
{% endif %}{# end turn_board guard #}

<!-- ===== ACT 2 — Who's leading in dollars? (performance) ===== -->
<div class="act-h"><span class="aq">{{ t("Who's leading in dollars?", '谁在以美元计领先？') }}</span><span class="as">{{ t('Local return and FX contribution, shown separately.', '分别展示本币收益与汇率贡献。') }}</span></div>

<!-- ===== USD performance leaderboard (centerpiece) ===== -->
{% if LB %}
<div class="panel accent">
  <div class="sec-h"><h2 id="intl-performance-heading" tabindex="-1">{{ t('Performance in US dollars', '以美元计的表现') }} {{ help('Price returns on the same observation grid. FX contribution is USD return minus local return, in percentage points; it includes the interaction with the equity return and is not the currency return alone. Display values are rounded. Rotation order uses the separate weighted composite with state adjustments; its bars show 12m returns when available. Otherwise the default is 12m USD return. Horizon buttons sort only markets with that supplied period.', '在同一观测日期网格上计算价格收益。汇率贡献为美元收益减本币收益，以百分点计；包含与股市收益的交互项，并非单独的汇率收益。显示值已四舍五入。轮动排序采用另一个经状态调整的加权综合分数；可用时条形显示12月收益。否则默认按12月美元收益排序。期间按钮仅排序具有该期间数据的市场。') }}</h2>
    <span class="sub">{{ t('Local return + FX contribution = USD return', '本币收益 + 汇率贡献 = 美元收益') }}</span>
    {% if bench_note is defined and bench_note and 'withheld' not in bench_note %}<span class="muted small" style="margin-left:4px">{{ bench_note|e }}</span>{% endif %}
    <span style="flex:1"></span>
    <div class="seg" id="lb-seg">
      {% if rotation_ranks %}<button type="button" data-h="__rank__" class="on">{{ t('Rotation rank', '轮动排名') }}</button>{% endif %}
      {% for h in perf.horizons %}<button type="button" data-h="{{ h.key }}"{% if not rotation_ranks and h.key == '12m' %} class="on"{% endif %}>{{ t(h.en, h.zh) }}</button>{% endfor %}
    </div>
  </div>
  <div class="lb" id="lb-board" tabindex="-1" role="region" aria-labelledby="intl-performance-heading"></div>
  <p class="muted small">{{ t('FX contribution (percentage points)', '汇率贡献（百分点）') }}</p>
  <div class="lb-legend">
    <span><i style="background:color-mix(in srgb,var(--info) 55%,transparent)"></i>{{ t('local equity', '本币股票') }}</span>
    <span><i style="background:var(--up)"></i>{{ t('positive FX contribution', '正汇率贡献') }}</span>
    <span><i style="background:var(--down)"></i>{{ t('negative FX contribution', '负汇率贡献') }}</span>
    <span><i style="background:var(--text);width:3px;height:13px;border-radius:2px"></i>{{ t('net USD return', '美元净收益') }}</span>
  </div>
</div>
{% endif %}

<!-- Qualified US-relative readings never fall back to an undated benchmark.
     Preserve the independent ex-US views and explain the withheld comparison. -->
{% if not RG and bench_note is defined and bench_note and 'withheld' in bench_note %}
<div class="panel" data-us-benchmark-withheld>
  <h2 id="intl-us-benchmark-unavailable" tabindex="-1">{{ t('US-relative comparison unavailable', '对美相对比较暂不可用') }}</h2>
  <p class="muted">{{ t('No US benchmark qualifies against the international observation clock. Current US-relative rotation and US correlation values are withheld; available international results retain their own coverage.', '没有符合国际市场观测日期要求的美国基准。当前对美轮动及美股相关性数据暂不展示；仍可查看各自有数据覆盖的国际市场结果。') }}</p>
  <p class="muted small" data-us-benchmark-source>{{ bench_note|e }}</p>
</div>
{% endif %}

<!-- ===== US vs the World rotation (RRG) ===== -->
{% if RG %}
<div class="panel">
  <div class="sec-h"><h2>{{ t('US vs the World — capital rotation', '美国 vs 全球 — 资本轮动') }} {{ help('Maps who is beating the US and whether that lead is improving or fading. Display-only.', '显示谁跑赢美国，以及领先是在增强还是减弱。仅展示。') }}</h2>
    <span style="flex:1"></span><span class="tilt {{ RG.tilt }}">{{ t(RG.tilt_en, RG.tilt_zh) }}</span></div>
  <div class="twocol">
    <div class="rrg">
      <div class="ax h"></div><div class="ax v"></div>
      <div class="ql impr">↖ {{ t('Improving', '改善') }}</div><div class="ql lead">{{ t('Leading', '领先') }} ↗</div>
      <div class="ql lag">↙ {{ t('Lagging', '落后') }}</div><div class="ql weak">{{ t('Weakening', '走弱') }} ↘</div>
      <div class="axl" style="left:6px;top:50%;transform:translateY(-50%)">{{ t('behind US', '落后美国') }}</div>
      <div class="axl" style="right:6px;top:50%;transform:translateY(-50%)">{{ t('ahead', '领先') }}</div>
      {% for r in RG.rows %}
        {% set lv = [[r.rs_level, 60]|max, 140]|min %}
        {% set mo = [[r.rs_mom, -25]|max, 25]|min %}
        {% set xp = 8 + (lv - 60) / 80 * 84 %}
        {% set yp = 8 + (25 - mo) / 50 * 84 %}
        <div class="pt q-{{ r.q }}" style="left:{{ '%.1f'|format(xp) }}%;top:{{ '%.1f'|format(yp) }}%" title="{{ r.name }} · level {{ r.rs_level }} · mom {{ r.rs_mom }}">
          <div class="dot"></div><div class="e">{{ r.flag }}</div><div class="n">{{ r.cc }}</div>
        </div>
      {% endfor %}
    </div>
    <div>
      <table class="sb">
        <thead><tr><th class="l">{{ t('Market', '市场') }}</th><th class="l">{{ t('Phase', '阶段') }}</th><th>{{ t('vs US 3m', '对美3月') }}</th><th>{{ t('6m', '6月') }}</th><th>{{ t('12m', '12月') }}</th></tr></thead>
        <tbody>
        {% for r in RG.rows %}
          <tr><td class="l"><span class="flg">{{ r.flag }}</span>{{ t(r.name, r.name_zh) }}</td>
            <td class="l"><span class="tilt q-{{ r.q }}" style="padding:2px 8px;font-size:11px">{% if r.q=='lead' %}{{ t('Leading','领先') }}{% elif r.q=='impr' %}{{ t('Improving','改善') }}{% elif r.q=='weak' %}{{ t('Weakening','走弱') }}{% else %}{{ t('Lagging','落后') }}{% endif %}</span></td>
            <td class="{{ 'pos' if r.rel_ret.get('3m') is not none and (r.rel_ret['3m']|round(1)) > 0 else 'neg' if r.rel_ret.get('3m') is not none and (r.rel_ret['3m']|round(1)) < 0 else 'muted' }}">{% if r.rel_ret.get('3m') is not none %}{{ '%+.1f'|format(r.rel_ret['3m']) }}%{% else %}—{% endif %}</td>
            <td class="{{ 'pos' if r.rel_ret.get('6m') is not none and (r.rel_ret['6m']|round(1)) > 0 else 'neg' if r.rel_ret.get('6m') is not none and (r.rel_ret['6m']|round(1)) < 0 else 'muted' }}">{% if r.rel_ret.get('6m') is not none %}{{ '%+.1f'|format(r.rel_ret['6m']) }}%{% else %}—{% endif %}</td>
            <td class="{{ 'pos' if r.rel_ret.get('12m') is not none and (r.rel_ret['12m']|round(1)) > 0 else 'neg' if r.rel_ret.get('12m') is not none and (r.rel_ret['12m']|round(1)) < 0 else 'muted' }}">{% if r.rel_ret.get('12m') is not none %}{{ '%+.1f'|format(r.rel_ret['12m']) }}%{% else %}—{% endif %}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      <p class="caveat" style="margin-top:10px">{{ t('Positive = beat the S&P 500 over that window. Relative-strength lens only.', '正值 = 该周期跑赢标普500。仅相对强弱视角。') }}</p>
    </div>
  </div>
</div>
{% endif %}

<!-- ===== Reference fold A — full data tables ===== -->
<details class="ref-fold">
  <summary><span class="rf-t">{{ t('Full data tables', '完整数据表') }}</span><span class="rf-s">{{ t('Cross-country scorecard · rates & curve desk', '跨国评分卡 · 利率与曲线台') }}</span><span class="rf-caret" aria-hidden="true">▾</span></summary>
<!-- ===== Cross-country comparison grid (the reference table) ===== -->
<div class="panel">
  <h2 id="intl-cross-country" tabindex="-1">{{ t('Cross-country comparison', '跨国对比') }} {{ help('Same scorecard for every economy: regime, recession risk, rates, CPI, FX, and equity stretch.', '每个经济体用同一套表：周期、衰退风险、利率、CPI、汇率与股市拉伸。') }}</h2>
  <div class="gridwrap tbl-scroll" data-cross-country-scroll role="region" tabindex="0" aria-labelledby="intl-cross-country">
  <table class="cmp">
    <thead><tr>
      <th scope="col" class="l eco">{{ t('Economy', '经济体') }}</th>
      <th scope="col" class="l">{{ t('1Y · USD', '1年 · 美元') }}</th>
      <th scope="col" class="l">{{ t('Regime', '周期') }}</th>
      <th scope="col" class="grp">{{ t('Recession', '衰退') }}</th>
      <th scope="col" class="grp">{{ t('Policy', '政策利率') }}</th>
      <th scope="col">{{ t('10y', '10年') }}</th>
      <th scope="col">{{ t('Curve', '曲线') }}</th>
      <th scope="col">{{ t('Real 10y', '实际10年') }}</th>
      <th scope="col" class="grp">{{ t('CPI', 'CPI') }}</th>
      <th scope="col">{{ t('GDP', 'GDP') }}</th>
      <th scope="col">{{ t('Unemp', '失业') }}</th>
      <th scope="col" class="grp">{{ t('FX 3m', '汇率3月') }}</th>
      <th scope="col">{{ t('Off high', '距高点') }}</th>
      <th scope="col">{{ t('Market stress', '市场压力') }} {{ help('A descriptive 0–100 composite: 50% drawdown depth, 30% below the 200-day trend and 20% elevated volatility. Off high reports the separate distance from the high. This score is neither realized loss nor a forecast probability.', '描述性的0–100综合分：回撤深度占50%，低于200日趋势占30%，波动率升高占20%。距高点一栏单独显示距离高点的幅度。此分数既非已实现损失，也非预测概率。') }}</th>
      <th scope="col" class="l">{{ t('Market state', '市场状态') }}</th>
    </tr></thead>
    <tbody>
    {% for r in records %}
      {% set m = r.macro %} {% set e = r.equity %} {% set af = r.macro_asof %}
      {% set sb = (LB | selectattr('cc', 'equalto', r.cc) | list) %}
      {% set _rt = r.get('turn') if r is mapping else None %}
      <tr>
        <td class="l eco"><span class="flg">{{ r.flag }}</span>{{ t(r.name, r.name_zh) }}{% if r.data_limited %} <span class="chip caut">{{ t('data-limited', '数据有限') }}</span>{% endif %}</td>
        <td class="l">{% if sb and sb[0].spark_svg %}{{ sb[0].spark_svg|safe }}{% else %}<span class="muted">—</span>{% endif %}</td>
        <td class="l"><span class="quad q-{{ r.quad }}">{{ td(r.quad_name) }}</span> <span class="muted small">{{ num(r.confidence,'',2) }}</span></td>
        <td class="grp"><span class="gbar"><span class="gfill g-{{ r.recession_band }}" style="width:{{ r.recession_score or 0 }}%"></span></span>{{ num(r.recession_score,'',0) }}</td>
        <td class="grp">{{ num(m.policy_rate,'%',2) }}</td>
        <td>{{ num(m.yield_10y,'%',2) }}</td>
        <td class="{{ 'neg' if m.curve is not none and m.curve < 0 }}">{{ num(m.curve,'',2) }}</td>
        <td>{{ num(m.real_yield,'',2) }}</td>
        <td class="grp">{{ num(m.cpi_yoy,'%',1) }}{% if af.cpi_yoy %}<span class="stale"> {{ af.cpi_yoy }}</span>{% endif %}</td>
        <td>{{ num(m.gdp_yoy,'%',1) }}</td>
        <td>{{ num(m.unemployment,'%',1) }}</td>
        <td class="grp {{ 'neg' if m.fx_strength_3m is not none and m.fx_strength_3m < 0 else 'pos' if m.fx_strength_3m }}">{{ num(m.fx_strength_3m,'%',1) }}</td>
        <td class="{{ 'neg' if e.off_52w_high is not none and e.off_52w_high < -5 }}">{{ num(e.off_52w_high,'%',1) }}</td>
        <td><span class="gbar"><span class="gfill g-{{ e.drawdown_band }}" style="width:{{ e.drawdown_risk or 0 }}%"></span></span>{{ num(e.drawdown_risk,'',0) }}</td>
        <td class="l">
          {% if _rt %}
            <span class="ts-chip ts-{{ _rt.state }}">
              <span class="l-en">{{ _rt.state_en }}</span><span class="l-zh">{{ _rt.state_zh }}</span>
            </span>
          {% elif e.ext_grade == 'parabolic' %}<span class="chip warn">{{ t('parabolic', '抛物') }}</span>
          {% elif e.ext_grade == 'stretched' %}<span class="chip caut">{{ t('stretched', '拉伸') }}</span>
          {% elif e.bubble_flag %}<span class="chip caut">{{ t('hot', '过热') }}</span>
          {% elif e.ext_grade == 'intrend' %}<span class="muted small">{{ t('normal', '正常') }}</span>
          {% else %}<span class="muted small">{{ t('Unavailable', '不可用') }}</span>{% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <p class="caveat" style="margin-top:9px">{{ t("Market stress combines drawdown depth, trend and volatility; it is not realized loss or a forecast. Equity stretch uses each market's own history; unavailable history is not a normal reading.", '市场压力综合回撤深度、趋势与波动率；并非已实现损失或预测。股市拉伸按各市场自身历史衡量；历史不可用不代表正常。') }}</p>
</div>

<!-- ===== Rates & curve desk ===== -->
{% if rates %}
{% set AN = rates.anchor %}
<div class="panel">
  <div class="sec-h"><h2 id="intl-rates-curves">{{ t('Rates & curve desk', '利率与曲线室') }} {{ help('Compares yield curves, real yields, 10-year yield drift, and carry vs the US.', '比较收益率曲线、实际利率、10年利率变化，以及相对美国的套息。') }}</h2>
    <span style="flex:1"></span>
    {% if AN.y10 is not none %}<span class="sub">{{ t('US anchor', '美国锚') }}: <b style="color:var(--text)">{{ AN.y10 }}%</b> 10y · {% if AN.y2 is not none %}{{ AN.y2 }}%{% else %}—{% endif %} 2y · {{ t('curve', '曲线') }} {{ '%+.2f'|format(AN.curve) if AN.curve is not none else '—' }}</span>{% endif %}
  </div>
  {% if AN.y10 is not none %}
  <p class="muted small" data-rates-anchor-date>{{ t('US 10y observation date:', '美国10年观测日：') }} {{ AN.get('asof')|e if AN.get('asof') else t('Unavailable', '不可用') }} · {{ t('US 2y date unavailable', '美国2年日期不可用') }}</p>
  {% endif %}
  {% set scale = namespace(values=[0]) %}
  {% for r in rates.rows %}
    {% if r.short is not none and r.y10 is not none %}
      {% set scale.values = scale.values + [r.short, r.y10] %}
    {% endif %}
  {% endfor %}
  {% set yield_min = scale.values|min %}
  {% set yield_max = scale.values|max %}
  {% if yield_max == yield_min %}{% set yield_max = yield_min + 1 %}{% endif %}
  {% if scale.values|length > 1 %}
  <p class="muted small">{{ t('3m → 10y endpoints only · shared vertical yield scale:', '仅显示3月 → 10年端点 · 共用纵向收益率刻度：') }} {{ num(yield_min,'%',2) }} — {{ num(yield_max,'%',2) }}</p>
  {% endif %}
  <div class="rdesk">
    {% for r in rates.rows %}
    <div class="rcard">
      <div class="rh"><span class="flg">{{ r.flag }}</span><b>{{ t(r.name, r.name_zh) }}</b>
        <span class="shape {{ r.shape }}">{{ t(r.shape_en, r.shape_zh) }}</span></div>
      {% if r.y10 is not none %}
      {% if r.short is not none %}
      <div class="curve" style="--c:{% if r.shape=='inverted' %}var(--down){% elif r.shape=='flat' %}var(--warn){% else %}var(--link){% endif %}">
        {% set sy = 14 + (yield_max - r.short) / (yield_max - yield_min) * 72 %}
        {% set ty = 14 + (yield_max - r.y10) / (yield_max - yield_min) * 72 %}
        <div class="curve-plot" aria-hidden="true">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false"><line class="ln" x1="8" y1="{{ '%.4f'|format(sy) }}" x2="92" y2="{{ '%.4f'|format(ty) }}" /></svg>
          <div class="d" style="left:8%;top:{{ '%.4f'|format(sy) }}%"></div>
          <div class="d" style="left:92%;top:{{ '%.4f'|format(ty) }}%"></div>
        </div>
        <div class="curve-labels"><span class="lab">3m {{ num(r.short,'%',2) }}</span><span class="lab">10y {{ num(r.y10,'%',2) }}</span></div>
      </div>
      {% else %}
      <p class="muted small">{{ t('3m unavailable', '3月数据不可用') }} · 10y {{ num(r.y10,'%',1) }}</p>
      {% endif %}
      <div class="rgrid">
        <span class="rk">{{ t('Curve 10y−3m', '曲线 10年−3月') }}</span><span class="rv {{ 'neg' if r.curve is not none and r.curve < 0 }}">{{ num(r.curve,'',2) }}</span>
        <span class="rk">{{ t('Real 10y', '实际10年') }}</span><span class="rv {{ 'neg' if r.real_yield is not none and r.real_yield < 0 }}">{{ num(r.real_yield,'',2) }}</span>
        <span class="rk">{{ t('Carry vs US', '对美套息') }}</span><span class="rv {{ 'pos' if r.carry_vs_us is not none and r.carry_vs_us > 0 else 'neg' if r.carry_vs_us is not none and r.carry_vs_us < 0 }}">{% if r.carry_vs_us is not none %}{{ '%+.2f'|format(r.carry_vs_us) }}{% else %}—{% endif %}</span>
        <span class="rk">{{ t('10y · 3m drift', '10年 · 3月漂移') }}</span><span class="rv {{ 'neg' if r.y10_chg3m is not none and r.y10_chg3m > 0 else 'pos' if r.y10_chg3m is not none and r.y10_chg3m < 0 }}">{% if r.y10_chg3m is not none %}{{ '%+.2f'|format(r.y10_chg3m) }}{% else %}—{% endif %}</span>
        {# vel_20d: 20-day yield velocity — arrow + value, Tier-2 z-score tip #}
        {% if r.vel_20d_bp is defined and r.vel_20d_bp is not none %}
        {% set _vdir = '↑' if r.vel_20d_bp > 0 else '↓' if r.vel_20d_bp < 0 else '→' %}
        {% set _vcls = 'neg' if r.vel_20d_bp > 0 else 'pos' if r.vel_20d_bp < 0 else '' %}
        {% set _vz_tip_en = 'Yield moved ' ~ ('%+.1f'|format(r.vel_20d_bp)) ~ ' bp over 20 days — ' ~ ('%+.2f'|format(r.vel_20d_z) if r.vel_20d_z is defined and r.vel_20d_z is not none else '—') ~ ' against its own 3-year normal. Rising yields are a headwind for bond prices.' %}
        {% set _vz_tip_zh = '20日利率变化速度：' ~ ('%+.1f'|format(r.vel_20d_bp)) ~ ' bp。相对3年Z分数：' ~ ('%+.2f'|format(r.vel_20d_z) if r.vel_20d_z is defined and r.vel_20d_z is not none else '—') ~ '。利率上升 = 债券价格逆风。' %}
        <span class="rk">{{ t('10y vel 20d', '10年20日速度') }}</span>
        <span class="rv {{ _vcls }}" data-tip-en="{{ _vz_tip_en }}" data-tip-zh="{{ _vz_tip_zh }}">
          {{ _vdir }} {{ '%+.0f'|format(r.vel_20d_bp) }}bp
          {% if r.vel_20d_z is defined and r.vel_20d_z is not none %}<span class="muted small">(z{{ '%+.1f'|format(r.vel_20d_z) }})</span>{% endif %}
        </span>
        {% endif %}
      </div>
      {% if r.spark_svg %}<div style="margin-top:8px;opacity:.85">{{ r.spark_svg|safe }}</div>{% endif %}
      {% else %}
      <p class="muted small" style="margin:6px 0">{{ t('No keyless yield curve for this market — read leans on the equity tape.', '该市场无免密钥收益率曲线 — 读数依赖股市行情。') }}</p>
      {% endif %}
      <p class="muted small" data-rates-dates>{{ t('10y observation month:', '10年观测月：') }} {{ r.get('y10_asof')|e if r.get('y10_asof') else t('Unavailable', '不可用') }}<br>
        {{ t('CPI observation month:', 'CPI观测月：') }} {{ r.get('cpi_asof')|e if r.get('cpi_asof') else t('Unavailable', '不可用') }}{% if r.short is not none %}<br>{{ t('3m date unavailable', '3月日期不可用') }}{% endif %}</p>
    </div>
    {% endfor %}
  </div>

  <div class="twocol" style="margin-top:14px">
    <!-- Eurozone periphery -->
    {% if rates.periphery %}
    <div>
      <h3 id="intl-euro-fragmentation">🇪🇺 {{ t('Eurozone fragmentation — peripheral spreads over Bund', '欧元区分化 — 外围国相对德债利差') }} {{ help('Issuer 10-year yield minus the German Bund yield. The 3m change compares 63 supplied intervals, not a causal stress diagnosis. Changes are rounded to whole basis points; a zero with no widening flag does not distinguish an exact zero from a small negative change. The supplied widening flag retains positive direction even when the rounded change is zero.', '发行国10年期收益率减去德国国债收益率。3月变化比较63个所供观测间隔，并非压力的因果诊断。变化取整至基点；零值且未标记走阔，无法区分精确为零和微小负变化。所供走阔标志在变化取整为零时仍保留正向变化。') }}</h3>
      <table class="sb">
        <thead><tr><th class="l">{{ t('Spread', '利差') }}</th><th>{{ t('bps', '基点') }}</th><th>{{ t('3m', '3月') }}</th><th class="l">{{ t('Read', '读数') }}</th></tr></thead>
        <tbody>
        {% for sp in rates.periphery.spreads %}
          {% set measured = sp.chg3m_bps is number and sp.chg3m_bps is not boolean %}
          {% set widening = measured and sp.widening is sameas true %}
          {% set tightening = measured and sp.widening is sameas false and sp.chg3m_bps < 0 %}
          <tr><td class="l"><span class="flg">{{ sp.flag }}</span>{{ t(sp.label, sp.label_zh) }}</td>
            <td>{{ num(sp.bps,' bps',0) }}</td>
            <td{% if widening or tightening %} class="{{ 'neg' if widening else 'pos' }}"{% endif %}>{% if measured %}{{ '%+.0f'|format(sp.chg3m_bps) }}{% else %}—{% endif %}</td>
            <td class="l">{% if widening %}<span class="chip caut">{{ t('widening', '走阔') }}</span>{% elif tightening %}<span class="chip ok">{{ t('tightening', '收窄') }}</span>{% elif measured and sp.widening is sameas false and sp.chg3m_bps == 0 %}<span class="chip">{{ t('Non-widening at supplied precision', '所供精度下未走阔') }}</span>{% else %}<span class="chip">{{ t('Unavailable', '不可用') }}</span>{% endif %}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      <p class="caveat" data-periphery-date style="margin-top:6px">{{ t('Bund series date:', '德债序列日期：') }} {{ rates.periphery.asof|e if rates.periphery.asof else t('Unavailable', '不可用') }} · {{ t('Individual spread observation dates unavailable', '各项利差观测日期不可用') }}</p>
    </div>
    {% endif %}
    <!-- ECB liquidity impulse -->
    {% if rates.liquidity %}
    {% set LQ = rates.liquidity %}
    {% set lq_measured = LQ.chg_52w is number and LQ.chg_52w is not boolean %}
    <div class="rcard" style="align-self:start">
      <div class="rh"><b>{{ t('ECB balance-sheet impulse', '欧央行资产负债表脉冲') }} {{ help('Uses the last observation in each weekly bin, forward-filled where a bin is empty. Changes compare 13 and 52 weekly intervals; this is not a policy-action classification. Changes are rounded to one decimal place. Zero with no draining flag does not distinguish exact zero from a small positive change; the supplied draining flag retains negative direction even when rounded to zero.', '取每个周分箱的最后观测，空分箱向前填充。变化比较13及52个周间隔，不是政策行动分类。变化保留一位小数；零值且未标记下降，无法区分精确为零和微小正变化。所供下降标志在取整为零时仍保留负向变化。') }}</b>
        <span class="shape">{% if lq_measured and LQ.draining is sameas true %}{{ t('Lower than 52 weeks ago', '低于52周前') }}{% elif lq_measured and LQ.draining is sameas false and LQ.chg_52w > 0 %}{{ t('Higher than 52 weeks ago', '高于52周前') }}{% elif lq_measured and LQ.draining is sameas false and LQ.chg_52w == 0 %}{{ t('Non-decreasing at supplied precision', '所供精度下未下降') }}{% else %}{{ t('Unavailable', '不可用') }}{% endif %}</span></div>
      <div class="rgrid">
        <span class="rk">{{ t('Total assets', '总资产') }}</span><span class="rv">€{{ '%.2f'|format(LQ.level_eur_tn) }}T</span>
        <span class="rk">{{ t('13-week', '13周') }}</span><span class="rv">{% if LQ.chg_13w is not none %}{{ '%+.1f'|format(LQ.chg_13w) }}%{% else %}—{% endif %}</span>
        <span class="rk">{{ t('52-week', '52周') }}</span><span class="rv">{% if LQ.chg_52w is not none %}{{ '%+.1f'|format(LQ.chg_52w) }}%{% else %}—{% endif %}</span>
        <span class="rk">{{ t('Weekly bin ending', '周分箱结束日') }}</span><span class="rv">{{ LQ.asof|e if LQ.asof else t('Unavailable', '不可用') }}</span>
      </div>
      {% if LQ.spark_svg %}<div style="margin-top:8px;opacity:.85">{{ LQ.spark_svg|safe }}</div>{% endif %}
      <p class="caveat" style="margin-top:6px">{{ t('ECB only · Observation date unavailable', '仅欧央行 · 观测日期不可用') }}</p>
    </div>
    {% endif %}
  </div>
</div>
{% endif %}
</details><!-- /ref-fold A -->

<!-- ===== ACT 3 — Where is risk building? ===== -->
{% if mode != 'stocks' and risk_desk %}
<div class="act-h"><span class="aq">{{ t('Where is risk building?', '风险在何处积聚？') }}</span><span class="as">{{ t('Emerging-market stress, contagion to the US, the dollar and funding — one read each.', '新兴市场压力、对美传导、美元与融资——各给一读。') }}</span></div>
{# =====================================================================
   INTERNATIONAL RISK DESK — Variant A (board-first)
   Six panels: Hero strip → 2-col grid (Contagion+CB | Credit+Dollar) → Fragility
   All strings via the t() macro (dual-span EN/ZH). No tickers or method names
   visible at glance tier. ? tips carry Tier-2 receipts. Honest nulls throughout.
   ===================================================================== #}
{%- set RD = risk_desk %}
{%- set EMS = RD.em_stress or {} %}
{%- set SPL = RD.spillover or {} %}
{%- set TTR = RD.two_tier or {} %}
{%- set CBD = RD.cb_desk or {} %}
{%- set INV = RD.inversion_board or {} %}
{%- set SM  = RD.smile %}
{%- set sm_regime_known = SM and SM.get('regime') in ('rates-driven', 'safety-driven', 'mixed') %}
{%- set TXDISP = RD.top_transmitters_display or [] %}
{%- set SWAP = RD.get('swap_lines_bn') %}

{# ---- derive hero-chip states from payload ---- #}
{%- set ems_state = EMS.get('state', 'unknown') if EMS else 'unknown' %}
{%- set ems_legs_hot = EMS.get('legs_hot') %}
{%- set ems_available = EMS.get('n_legs_available') %}
{%- set ems_total = EMS.get('n_legs_total') %}
{%- set ems_coverage_known = ems_available is integer and ems_total is integer and ems_total > 0 and ems_available >= 0 and ems_available <= ems_total and ems_legs_hot is sequence and ems_legs_hot is not string and ems_legs_hot is not mapping and ems_legs_hot|length <= ems_available %}
{# Four owner threshold tests; the dollar five-day flag is informational. #}
{%- set t2legs = (TTR.get('tier2') or {}).get('legs') or {} %}
{%- set t2 = namespace(assessed=0, triggered=0, rows=[]) %}
{%- for key, field, en, zh in [
  ('us_hy_oas_vel', 'vel_20d_z', 'US credit spreads', '美国信用利差'),
  ('kre_spy_rs', 'value', 'Bank shares', '银行股'),
  ('move_pctile', 'pctile', 'Bond-market volatility', '债市波动'),
  ('sofr_iorb_corridor', 'value', 'Money-market plumbing', '货币市场管道')] %}
  {%- set leg = t2legs.get(key) or {} %}
  {%- set measured = leg.get(field) is number and leg.get(field) is not boolean and leg.get('hot') is boolean %}
  {%- if key == 'sofr_iorb_corridor' %}{%- set measured = measured and leg.get('last5_all_positive') is boolean %}{%- endif %}
  {%- if measured %}
    {%- set t2.assessed = t2.assessed + 1 %}
    {%- if leg.get('hot') %}{%- set t2.triggered = t2.triggered + 1 %}{%- endif %}
  {%- endif %}
  {%- set _ = t2.rows.append({'key':key, 'en':en, 'zh':zh, 'measured':measured, 'hot':leg.get('hot')}) %}
{%- endfor %}
{%- set ch_saf = t2legs.get('safety_bid_flag') or {} %}
{%- set saf_measured = ch_saf.get('safety_bid') is boolean and ch_saf.get('dxy_5d_chg') is number and ch_saf.get('dgs2_5d_chg') is number %}
{%- set safety_bid = TTR.get('safety_bid', false) %}
{%- set safety_bid_leg = ((TTR.get('tier2') or {}).get('legs') or {}).get('safety_bid_flag') or {} %}
{%- set dxy5d = safety_bid_leg.get('dxy_5d_chg') %}
{%- set dgs2_5d = safety_bid_leg.get('dgs2_5d_chg') %}
{%- set us_from = SPL.get('us_from_others') %}
{%- set total_conn = SPL.get('total_connectedness') %}

{# Keep the owner's coincident state separate from coverage and position decisions. #}
{%- if ems_coverage_known and ems_state == 'stressed' %}
  {%- set ems_word_en = 'Stressed' %}
  {%- set ems_word_zh = '压力较高' %}
{%- elif ems_coverage_known and ems_state == 'strained' %}
  {%- set ems_word_en = 'Strained' %}
  {%- set ems_word_zh = '压力显现' %}
{%- elif ems_coverage_known and ems_state == 'calm' %}
  {%- set ems_word_en = 'Calm' %}
  {%- set ems_word_zh = '平静' %}
{%- else %}
  {%- set ems_word_en = 'Unavailable' %}
  {%- set ems_word_zh = '不可用' %}
{%- endif %}

{# Numeric model outputs and supplied parameters, without causal thresholds. #}
{%- set conn_known = total_conn is number and total_conn is not boolean and total_conn >= 0 and total_conn <= 100 %}
{%- set us_share_known = us_from is number and us_from is not boolean and us_from >= 0 and us_from <= 100 %}
{%- set sp_params = SPL.get('params') or {} %}
{%- set sp_window = sp_params.get('window') %}
{%- set sp_lag = sp_params.get('var_lag') %}
{%- set sp_horizon = sp_params.get('horizon') %}
{%- set sp_params_known = sp_window is integer and sp_window > 0 and sp_lag is integer and sp_lag > 0 and sp_horizon is integer and sp_horizon > 0 %}
{%- set sp_series = SPL.get('n_series') %}
{%- set sp_date = SPL.get('as_of') %}

{# top transmitter max value for bar scaling #}
{%- set tx_max = namespace(v=1.0) %}
{%- for tx in TXDISP %}
  {%- if tx.to_others_pct is not none and tx.to_others_pct > tx_max.v %}
    {%- set tx_max.v = tx.to_others_pct %}
  {%- endif %}
{%- endfor %}

{# CB stance labels #}
{%- set CB_STANCE_EN = {'easing': 'Cutting', 'hiking': 'Raising', 'hold': 'Holding', 'holding': 'Holding'} %}
{%- set CB_STANCE_ZH = {'easing': '降息', 'hiking': '加息', 'hold': '按兵不动', 'holding': '按兵不动'} %}
{%- set CB_STANCE_CSS = {'easing': 'stance-cutting', 'hiking': 'stance-raising', 'hold': 'stance-holding', 'holding': 'stance-holding'} %}
{%- set CC_FLAG = {'US':'🇺🇸','XM':'🇪🇺','JP':'🇯🇵','GB':'🇬🇧','CH':'🇨🇭','CA':'🇨🇦','AU':'🇦🇺'} %}

{# inversion board #}
{%- set n_inv = INV.get('n_inverted') %}
{%- set n_total_inv = INV.get('n_total') %}
{%- set inv_available = n_inv is number and n_total_inv is number and n_total_inv > 0 and n_inv >= 0 and n_inv <= n_total_inv %}
{%- set inv_countries = INV.get('countries') or [] %}
{%- set inv_sync = INV.get('synchronized', false) %}

{# em_stress legs for credit panel #}
{%- set ES_LEGS = EMS.get('legs') or {} %}
{%- set em_hy = ES_LEGS.get('em_hy_oas') or {} %}
{%- set TIER1 = TTR.get('tier1') or {} %}
{%- set REG_OAS = TIER1.get('regional_oas') or {} %}
{%- set asia_oas = REG_OAS.get('asia') or {} %}
{%- set latam_oas = REG_OAS.get('latam') or {} %}
{%- set emea_oas = REG_OAS.get('emea') or {} %}

{# hottest region (for LatAm badge) #}
{%- set hottest_region = TIER1.get('hottest_region') %}

<!-- ===== IRD EXTRA CSS (scoped classes, minimal) ===== -->
<style>
  .ird-stage{position:relative;margin:0 0 16px;padding:20px 22px 18px;border-radius:16px;
    background:linear-gradient(var(--panel),var(--panel)) padding-box,var(--acc-grad) border-box;
    border:1.5px solid transparent;
    box-shadow:0 16px 48px -24px color-mix(in srgb,var(--acc1) 45%,transparent);}
  .ird-badge{display:inline-flex;align-items:center;gap:6px;font-size:10px;font-weight:800;
    letter-spacing:.13em;text-transform:uppercase;color:#fff;background:var(--acc-grad);
    padding:4px 11px;border-radius:999px;}
  .ird-title{font-size:20px;font-weight:800;letter-spacing:-.01em;margin:10px 0 4px;color:var(--text);}
  .ird-subtitle{font-size:13px;color:var(--muted);margin:0 0 14px;}
  .ird-hchips{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:4px;}
  @media(max-width:900px){.ird-hchips{grid-template-columns:1fr 1fr;}}
  .ird-hchip{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:12px 14px;}
  .ird-hchip.state-warn{border-color:color-mix(in srgb,var(--down) 45%,var(--line));background:color-mix(in srgb,var(--down) 6%,var(--panel2));}
  .ird-hchip.state-ok{border-color:color-mix(in srgb,var(--up) 35%,var(--line));background:color-mix(in srgb,var(--up) 5%,var(--panel2));}
  .ird-hchip.state-caut{border-color:color-mix(in srgb,var(--warn) 35%,var(--line));background:color-mix(in srgb,var(--warn) 5%,var(--panel2));}
  .ird-hchip .hc-lbl{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin-bottom:4px;}
  .ird-hchip .hc-state{font-size:14px;font-weight:800;line-height:1.2;margin-bottom:3px;}
  .ird-hchip .hc-state.red{color:var(--ink-down, var(--down));}
  .ird-hchip .hc-state.green{color:var(--ink-up, var(--up));}
  .ird-hchip .hc-state.info{color:var(--ink-info, var(--info));}
  .ird-hchip .hc-detail{font-size:11px;color:var(--muted);margin-top:2px;}
  .ird-hchip .hc-stance{font-size:11px;color:var(--muted);margin-top:4px;}
  .ird-hchip .hc-stance b{color:var(--text);}
  .ird-safety-tag{display:inline-block;font-size:10px;font-weight:700;padding:1px 6px;border-radius:6px;
    background:color-mix(in srgb,var(--warn) 18%,transparent);color:var(--ink-warn, var(--warn));
    border:1px solid color-mix(in srgb,var(--warn) 35%,transparent);margin-top:4px;}
  .ird-twocol{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  @media(max-width:860px){.ird-twocol{grid-template-columns:1fr;}}
  /* International-only containment belongs to this route, not shared theme.css. */
  body.page-intl .ird-twocol > *{min-width:0;}
  @media(max-width:640px){
    body.page-intl .te-strip{grid-template-columns:minmax(0,1fr);}
    body.page-intl .seg{flex-wrap:wrap;max-width:100%;}
  }
  /* §15: this row is a fixed-size dial + a text column and it never wrapped, so its
     intrinsic floor (653px) set the whole panel's width and the page was 82% wider
     than the phone reading it. Wrap + min-width:0 is the shrink pair. */
  .ird-dial-wrap{display:flex;align-items:center;gap:16px;margin:12px 0;flex-wrap:wrap;min-width:0;}
  .ird-dial-wrap > *{min-width:0;}
  @media(max-width:520px){.ird-dial-wrap{gap:10px}.ird-dial-wrap > svg{max-width:100%;height:auto}}
  .ird-dial-circle{width:80px;height:80px;border-radius:50%;display:flex;flex-direction:column;
    align-items:center;justify-content:center;border:3px solid color-mix(in srgb,var(--warn) 60%,var(--line));
    background:color-mix(in srgb,var(--warn) 8%,var(--panel2));flex-shrink:0;}
  .ird-dial-circle .dc-num{font-size:24px;font-weight:800;color:var(--ink-warn, var(--warn));line-height:1;}
  .ird-dial-circle .dc-of{font-size:10px;color:var(--muted);font-weight:600;}
  .ird-tx-rank{width:18px;font-size:11px;color:var(--muted);font-weight:700;}
  .ird-tx-flag{font-size:16px;}
  .ird-tx-name{flex:1;font-weight:600;}
  .ird-us-recv{display:flex;align-items:center;gap:10px;margin:10px 0 12px;padding:8px 12px;
    background:var(--panel2);border-radius:9px;border:1px solid var(--line);}
  .ird-us-recv .ur-num{font-size:20px;font-weight:800;color:var(--ink-info, var(--info));}
  .ird-us-recv .ur-text{font-size:12px;color:var(--muted);}
  .ird-us-recv .ur-text b{color:var(--text);}
  .ird-channels{display:flex;flex-wrap:wrap;gap:5px;margin-top:10px;}
  .ird-cb-scroll:focus-visible{outline:2px solid var(--link);outline-offset:3px;}
  table.ird-cb{border-collapse:collapse;width:100%;font-size:12.5px;}
  table.ird-cb th,table.ird-cb td{padding:7px 9px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap;}
  table.ird-cb th{color:var(--muted);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.03em;}
  table.ird-cb td.r{text-align:right;}
  table.ird-cb tr:hover td{background:var(--panel2);}
  .ird-stance{display:inline-block;padding:2px 8px;border-radius:7px;font-size:11px;font-weight:700;}
  .stance-cutting{background:color-mix(in srgb,var(--up) 14%,transparent);color:var(--ink-up, var(--up));border:1px solid color-mix(in srgb,var(--up) 34%,transparent);}
  .stance-raising{background:color-mix(in srgb,var(--down) 14%,transparent);color:var(--ink-down, var(--down));border:1px solid color-mix(in srgb,var(--down) 36%,transparent);}
  .stance-holding{background:color-mix(in srgb,var(--muted) 12%,transparent);color:var(--muted);border:1px solid color-mix(in srgb,var(--muted) 25%,transparent);}
  .ird-bs{display:inline-block;padding:1px 6px;border-radius:5px;font-size:10px;font-weight:700;
    border:1px solid var(--line);color:var(--muted);background:var(--panel2);}
  .ird-bs.adding{color:var(--ink-up, var(--up));border-color:color-mix(in srgb,var(--up) 30%,var(--line));background:color-mix(in srgb,var(--up) 8%,var(--panel2));}
  .ird-bs.draining{color:var(--ink-down, var(--down));border-color:color-mix(in srgb,var(--down) 30%,var(--line));background:color-mix(in srgb,var(--down) 8%,var(--panel2));}
  .ird-spread-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:10px 0;}
  @media(max-width:720px){.ird-spread-grid{grid-template-columns:1fr 1fr;}}
  .ird-spread-card{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:10px 12px;}
  .ird-spread-card .sc-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:5px;}
  .ird-spread-card .sc-val{font-size:20px;font-weight:800;color:var(--text);line-height:1.1;}
  .ird-spread-card .sc-vel{font-size:11px;margin-top:3px;}
  .vel-up{color:var(--ink-down, var(--down));}.vel-dn{color:var(--ink-up, var(--up));}.vel-flat{color:var(--muted);}
  .ird-inv-row{display:flex;align-items:center;gap:10px;margin:10px 0;padding:8px 12px;
    background:color-mix(in srgb,var(--up) 6%,var(--panel2));
    border:1px solid color-mix(in srgb,var(--up) 25%,var(--line));border-radius:9px;}
  .ird-inv-row .inv-num{font-size:22px;font-weight:800;color:var(--ink-up, var(--up));}
  .ird-inv-row .inv-num.warn{color:var(--ink-warn, var(--warn));}
  .ird-inv-row .inv-num.red{color:var(--ink-down, var(--down));}
  .ird-inv-row .inv-text{font-size:12px;color:var(--muted);}
  .ird-inv-row .inv-text b{color:var(--text);}
  .ird-dollar-card{background:var(--panel2);border:1px solid var(--line);border-radius:11px;padding:14px 16px;}
  .ird-dollar-card .regime-word{font-size:18px;font-weight:800;color:var(--ink-info, var(--info));margin-bottom:6px;}
  .ird-dollar-card .regime-sentence{font-size:13px;color:var(--text);line-height:1.5;margin-bottom:10px;}
  .ird-dollar-null{font-size:13px;color:var(--muted);font-style:italic;line-height:1.5;}
  .ird-frag-row{display:flex;align-items:flex-start;gap:10px;padding:9px 0;border-bottom:1px solid var(--line);}
  .ird-frag-row:last-child{border-bottom:none;}
  .ird-frag-country{font-size:13px;font-weight:700;flex:1;}
  .ird-frag-desc{font-size:12px;color:var(--muted);display:block;margin-top:1px;}
  .ird-frag-tags{display:flex;flex-wrap:wrap;gap:4px;margin-top:4px;}
  .ird-asof{font-size:11px;color:var(--muted);margin-top:8px;}
  /* §15: these two tracks stepped 4->2 at 720/900 and stopped, so at 390 they
     resolved to 653px and dragged every sibling panel to 691px — the page was
     82% wider than the phone reading it. */
  @media(max-width:520px){.ird-spread-grid,.ird-hchips{grid-template-columns:1fr}}
</style>

<!-- ===== IRD HERO STRIP ===== -->
<div class="ird-stage">
  <span class="ird-badge">🌐 {{ t('International Risk Desk', '国际风险台') }}</span>
  <div class="ird-title">{{ t('International Risk Desk', '国际风险台') }}</div>
  <div class="ird-subtitle">{{ t('Four descriptive views of supplied risk indicators.', '四个视角，描述所供风险指标。') }}</div>

  <div class="ird-hchips">

    {# CHIP 1: owner EM state with explicit supplied coverage #}
    <div class="ird-hchip state-{{ 'caut' if ems_coverage_known and ems_state in ('strained', 'stressed') else 'unknown' }}">
      <div class="hc-lbl">{{ t('Emerging Markets', '新兴市场') }}</div>
      <div class="hc-state">{{ t('Indicator state: ' ~ ems_word_en, '指标状态：' ~ ems_word_zh) }}</div>
      <div class="hc-detail">
        {%- if ems_coverage_known %}
          {{ t(ems_available|string ~ '/' ~ ems_total|string ~ ' signals available · ' ~ ems_legs_hot|length|string ~ ' triggered', ems_available|string ~ '/' ~ ems_total|string ~ '项指标可用 · ' ~ ems_legs_hot|length|string ~ '项触发') }}
        {%- else %}
          {{ t('Coverage unavailable', '覆盖数据不可用') }}
        {%- endif %}
      </div>
      <div class="hc-stance">{{ t('Coincident indicator · not a forecast', '同步指标 · 非预测') }}</div>
    </div>

    {# CHIP 2: coverage of supplied US threshold tests #}
    <div class="ird-hchip state-{{ 'caut' if t2.triggered else 'unknown' }}">
      <div class="hc-lbl">{{ t('Contagion to US', '对美传导') }}</div>
      <div class="hc-state {{ 'info' if t2.triggered else '' }}">
        {% if t2.assessed == 0 %}{{ t('Unavailable', '不可用') }}{% elif t2.assessed < 4 %}{{ t('Partial coverage', '覆盖不完整') }}{% else %}{{ t('Four tests assessed', '已评估四项指标') }}{% endif %}
      </div>
      <div class="hc-detail">{{ t(t2.triggered|string ~ ' triggered · ' ~ t2.assessed|string ~ '/4 assessed', t2.triggered|string ~ '项触发 · ' ~ t2.assessed|string ~ '/4已评估') }}</div>
      <div class="hc-stance">{{ t('Coverage of supplied readings; dollar flag is separate.', '按所供读数统计覆盖；美元标志单列。') }}</div>
    </div>

    {# CHIP 3: Dollar — honest null when smile absent #}
    <div class="ird-hchip state-{{ 'caut' if safety_bid else 'ok' if sm_regime_known else 'unknown' }}">
      <div class="hc-lbl">{{ t('Dollar', '美元') }}</div>
      {%- if sm_regime_known %}
        {%- set regime_label_en = 'Within residual band' if SM.get('regime') == 'rates-driven' else 'Above rate model' if SM.get('regime') == 'safety-driven' else 'Below rate model' %}
        {%- set regime_label_zh = '残差在区间内' if SM.get('regime') == 'rates-driven' else '高于利差模型' if SM.get('regime') == 'safety-driven' else '低于利差模型' %}
        {%- set regime_detail_en = 'Model residual score: |z| < 1' if SM.get('regime') == 'rates-driven' else 'Model residual score: z ≥ 1' if SM.get('regime') == 'safety-driven' else 'Model residual score: z ≤ −1' %}
        {%- set regime_detail_zh = '模型残差分数：|z| < 1' if SM.get('regime') == 'rates-driven' else '模型残差分数：z ≥ 1' if SM.get('regime') == 'safety-driven' else '模型残差分数：z ≤ −1' %}
        <div class="hc-state info">{{ t(regime_label_en, regime_label_zh) }}</div>
        <div class="hc-detail">{{ t(regime_detail_en, regime_detail_zh) }}</div>
      {%- else %}
        <div class="hc-state" style="color:var(--muted);font-size:12px;">{{ t('Unavailable', '不可用') }}</div>
        <div class="hc-detail">{{ t('No supported dollar regime supplied', '未提供可用的美元制度读数') }}</div>
      {%- endif %}
      {%- if safety_bid %}
        <div class="ird-safety-tag">
          ⚠ {{ t('Five-day flag', '5日标志') }}
          {%- if dxy5d is not none and dgs2_5d is not none %}
            {{ t(' (DXY ' + ('+%.1f pts' | format(dxy5d) if dxy5d >= 0 else '%.1f pts' | format(dxy5d)) + ', 2yr ' + ('%+.1f bp' | format(dgs2_5d)) + ')', '（DXY ' + ('+%.1f点' | format(dxy5d) if dxy5d >= 0 else '%.1f点' | format(dxy5d)) + '，2年期 ' + ('%+.1f bp' | format(dgs2_5d)) + '）') }}
          {%- endif %}
        </div>
      {%- endif %}
      <div class="hc-stance" style="margin-top:5px;">{{ t('Model classification · not a causal verdict', '模型分类·不代表因果结论') }}</div>
    </div>

    {# CHIP 4: independent corridor threshold and supplied swap-line balance #}
    {%- set sofr_iorb = ((TTR.get('tier2') or {}).get('legs') or {}).get('sofr_iorb_corridor') or {} %}
    {%- set fund_hot = sofr_iorb.get('hot') %}
    {%- set fund_known = fund_hot is sameas true or fund_hot is sameas false %}
    <div class="ird-hchip state-{{ 'caut' if fund_hot is sameas true else 'ok' if fund_known else 'unknown' }}">
      <div class="hc-lbl">{{ t('Dollar Funding', '美元融资') }}</div>
      <div class="hc-state {{ 'info' if fund_known else '' }}">{{ t('Threshold triggered' if fund_hot is sameas true else 'Not triggered' if fund_known else 'Unavailable', '阈值已触发' if fund_hot is sameas true else '未触发' if fund_known else '不可用') }}</div>
      <div class="hc-detail">
        {{ t('SOFR − IORB: ', 'SOFR − IORB：') }}
        {%- if sofr_iorb.get('value') is not none %}
          {{ '%+.1f bp' | format(sofr_iorb.get('value') * 100) }}
        {%- else %}
          {{ t('Unavailable', '不可用') }}
        {%- endif %}
      </div>
      <div class="hc-detail">
        {%- if SWAP is not none %}
          {{ t('Fed swap lines: $' + ('%.1f' | format(SWAP)) + 'bn', '美联储互换余额：' + ('%.1f' | format(SWAP * 10)) + '亿美元') }}
        {%- else %}
          {{ t('Fed swap lines: Unavailable', '美联储互换余额：不可用') }}
        {%- endif %}
      </div>
      <div class="hc-stance">{{ t('Rule: spread > 0 for 5 observations; quarter-end effects may be technical.', '规则：利差连续5个观测值大于0；季末影响可能属于技术因素。') }}</div>
    </div>

  </div><!-- /hero chips -->

  <div class="ird-asof" style="margin-top:14px;">
    {{ t('Desk built: ' + ((RD.get('built') or 'Unavailable')|string|e) + ' · context only, not a forecast', '风险台生成：' + ((RD.get('built') or '不可用')|string|e) + ' · 仅供参考，非预测') }}
  </div>
</div><!-- /ird-stage -->

<!-- ===== IRD 2-COL GRID ===== -->
<div class="ird-twocol">

  <!-- LEFT: Contagion board + CB desk -->
  <div>

    <!-- CONTAGION BOARD -->
    <div class="panel">
      <div class="sec-h">
        <h2 id="intl-contagion" tabindex="-1">{{ t('Contagion board', '传导看板') }} {{ help('The model fits rolling ETF volatility, not daily returns: 20-observation Garman-Klass volatility, with a close-return volatility proxy when OHLC is absent. Generalized forecast-error variance shares are row-normalized. The total is the mean share attributed to other tracked series within each series, excluding its own share. These are model variance shares, not transmission speed or causal price-move shares.', '模型拟合滚动ETF波动率，而非日度收益：20期Garman-Klass波动率；缺少OHLC时使用收盘收益波动率代理。广义预测误差方差份额逐行归一化。总指标是各序列中归于其他受监测序列份额的均值，剔除自身份额。这是模型方差份额，非传播速度或价格变动的因果占比。') }}</h2>
        <span class="sub">{{ t('Modelled volatility links', '模型波动率关联') }}</span>
      </div>

      {%- if conn_known %}
      <div class="ird-dial-wrap">
        <div class="ird-dial-circle">
          <div class="dc-num">{{ '%.0f' | format(total_conn) }}</div>
          <div class="dc-of">/ 100</div>
        </div>
        <div style="flex:1">
          <div style="font-size:13px;font-weight:700;margin-bottom:3px;">{{ t('Average cross-series variance share', '跨序列方差份额均值') }}</div>
          <div class="small muted">{{ t('Share within each tracked volatility series, then averaged; no speed or stress threshold.', '先计算各受监测波动率序列内的份额，再取均值；不代表速度或压力阈值。') }}</div>
          {%- if RD.get('spillover_spark_svg') %}
          <div style="margin-top:8px;opacity:.8;">{{ RD.get('spillover_spark_svg') | safe }}</div>
          {%- endif %}
        </div>
      </div>
      {%- else %}
      <p class="muted small">{{ t('Connectedness data not available', '关联度数据暂不可用') }}</p>
      {%- endif %}

      <div class="small muted" data-connectedness-method>
        {{ t('Model specification: ', '模型设定：') }}
        {% if sp_params_known %}{{ t(sp_window|string ~ ' aligned observations · lag ' ~ sp_lag|string ~ ' · horizon ' ~ sp_horizon|string ~ ' steps', sp_window|string ~ '期对齐观测 · 滞后' ~ sp_lag|string ~ '期 · 预测跨度' ~ sp_horizon|string ~ '步') }}{% else %}{{ t('Unavailable', '不可用') }}{% endif %}
      </div>
      <div class="small muted">{{ t('Model series: ', '模型序列：') }}{% if sp_series is integer and sp_series >= 0 %}{{ sp_series }}{% else %}{{ t('Unavailable', '不可用') }}{% endif %}</div>

      {%- if TXDISP %}
      <div style="margin:10px 0;">
        <div class="small muted" style="margin-bottom:6px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;">
          {{ t('Largest outbound model contributions', '较大的模型输出贡献') }}
        </div>
        {%- for tx in TXDISP[:3] %}
        {%- set bar_pct = (tx.to_others_pct / tx_max.v * 100) | round | int if tx_max.v > 0 else 0 %}
        {%- set tx_tip_en = tx.ticker ~ ' · ' ~ ('%.1f' | format(tx.to_others_pct)) ~ " summed percentage points across other series' normalized variance rows, excluding its own row; may exceed 100. Not stress units or a causal share." %}
        {%- set tx_tip_zh = tx.ticker ~ ' · 其他序列归一化方差行中的份额合计 ' ~ ('%.1f' | format(tx.to_others_pct)) ~ ' 个百分点，剔除自身行；可超过100。非压力单位或因果占比。' %}
        <div class="ird-tx-row" data-tip-en="{{ tx_tip_en|e }}" data-tip-zh="{{ tx_tip_zh|e }}">
          <span class="ird-tx-rank">#{{ loop.index }}</span>
          <span class="ird-tx-flag">{{ tx.flag }}</span>
          <span class="ird-tx-name">{{ t(tx.name_en, tx.name_zh) }} {{ help(tx_tip_en, tx_tip_zh) }}</span>
          <div class="ird-tx-bar-wrap">
            <div class="ird-tx-bar" style="width:{{ bar_pct }}%"></div>
          </div>
        </div>
        {%- endfor %}
      </div>
      {%- endif %}

      {%- if us_share_known %}
      <div class="ird-us-recv">
        <div class="ur-num">{{ '%.1f' | format(us_from) }}%</div>
        <div class="ur-text">
          <b>{{ t('SPY volatility variance share from other tracked series', 'SPY波动率方差份额：来自其他受监测序列') }}</b>
          <span class="help">?<span class="tip">{{ t('Share of SPY model forecast-error variance attributed to the other tracked volatility series, excluding SPY itself. Denominator: the SPY row-normalized variance decomposition; not the variance of all global markets and not a causal price-return share.', 'SPY模型预测误差方差中归于其他受监测波动率序列的份额，剔除SPY自身。分母为SPY逐行归一化的方差分解，非全球市场方差总量，也非价格收益的因果占比。') }}</span></span>
        </div>
      </div>
      {%- endif %}

      <div class="small muted" style="margin-bottom:6px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;">
        {{ t('Four US indicator threshold tests', '四项美国指标阈值检查') }}
      </div>
      <div class="ird-channels">
        {%- for row in t2.rows %}
        <span class="chip {{ 'caut' if row.measured and row.hot else '' }}" data-transmission-leg="{{ row.key }}">{{ t(row.en, row.zh) }}: {% if not row.measured %}{{ t('Unavailable', '不可用') }}{% elif row.hot %}{{ t('Triggered', '已触发') }}{% else %}{{ t('Not triggered', '未触发') }}{% endif %}</span>
        {%- endfor %}
        <span class="chip {{ 'caut' if saf_measured and ch_saf.get('safety_bid') else '' }}" data-transmission-safety>{{ t('Dollar five-day flag · Informational', '美元五日标志 · 信息项') }}: {% if not saf_measured %}{{ t('Unavailable', '不可用') }}{% elif ch_saf.get('safety_bid') %}{{ t('Flagged', '已标记') }}{% else %}{{ t('Not flagged', '未标记') }}{% endif %}</span>
      </div>
      <p class="caveat ird-asof">
        <span data-connectedness-clock>{{ t('Model snapshot date: ', '模型快照日期：') }}{% if sp_date and sp_date not in ('n/a', 'unknown') %}{{ sp_date|string|e }}{% else %}{{ t('Unavailable', '不可用') }}{% endif %}</span>.

        {{ t('The five-day flag is informational and excluded from the four threshold tests.', '五日标志为信息项，不计入四项阈值检查。') }}
