{# Display-only detail for one already-authorized source row. No cross-row lookup,
   gate, source request, strategy assignment, target calculation or plan creation. #}
{% from '_us_prophet_plan_cards.html.j2' import life_label_en, life_label_zh %}
{% macro t(en, zh) -%}<span class="l-en">{{ en|e }}</span><span class="l-zh">{{ zh|e }}</span>{%- endmacro %}
{% macro value(v, money=false, boolean=false) -%}
{%- if boolean and v is sameas true -%}{{ t('Yes','是') }}
{%- elif boolean and v is sameas false -%}{{ t('No','否') }}
{%- elif money and v is number and v is not boolean and v == v and (v-v) == 0 -%}${{ '%.2f'|format(v) }}
{%- elif not money and v is string and v|trim -%}{{ v|e }}
{%- else -%}{{ t('Not supplied','来源未提供') }}{%- endif -%}
{%- endmacro %}
{% macro field(en, zh, v, path, money=false, boolean=false) -%}
<div class="pvs-field" data-source-field="{{ path|e }}"><dt>{{ t(en,zh) }}</dt><dd>{{ value(v,money,boolean) }}</dd></div>
{%- endmacro %}
{% macro original(v) -%}
{%- if v is string and v|trim -%}<span class="pvs-original-source">{{ t('Original source','来源原文') }} · {{ v|e }}</span>
{%- else -%}{{ value(v) }}{%- endif -%}
{%- endmacro %}
{% macro status_name(v, names) -%}
{%- if v is string and v|trim -%}{{ t(names[v][0],names[v][1]) if v in names else t('Unmapped status','状态未映射') }}
{%- else -%}{{ value(none) }}{%- endif -%}
{%- endmacro %}
{% macro body(row, kind, as_of=none, plan_rel={'state': 'none', 'plans': []}, display=none) -%}
{% set es = row.get('entry_signal') if kind == 'board' and row.get('entry_signal') is mapping else {} %}
{% set sig = row.get('signal') if kind == 'board' and row.get('signal') is mapping else {} %}
{% set hold = row.get('hold') if kind == 'board' and row.get('hold') is mapping else {} %}
{% set zone = es.get('buy_zone') if es.get('buy_zone') is mapping else {} %}
<div class="pv-setup-body" data-setup-kind="{{ kind|e }}" data-native-id="{{ row.ticker|e }}"{% if display %} data-opportunity-detail{% endif %}>
  {% if display %}
  <header class="pvs-opportunity-identity">
    <div><p class="pvs-company">{{ t(row.get('name') or row.ticker, row.get('name_zh') or row.get('name') or row.ticker) }}</p>
    {% if row.get('industry') or row.get('sector') %}<p class="pvs-note">{{ t(row.get('industry') or row.get('sector'), row.get('industry_zh') or row.get('sector_zh') or row.get('industry') or row.get('sector')) }}</p>{% endif %}</div>
    <div class="pvs-snapshot"><span>{{ t('Snapshot price','快照价格') }}</span><strong>{{ value(row.get('price'),true) }}</strong><span>{{ value(row.get('price_as_of')) }}</span></div>
  </header>
  {% endif %}
  <p class="pvs-note pvs-summary-clock">{{ t("Source as-of","来源日期") }} {{ value(as_of) }}{% if kind == "board" %} · {{ t("Quote time","报价时间") }} {{ value(row.get("price_as_of")) }}{% endif %}</p>
  <div class="pvs-grid">
    <div class="pvs-group" data-pvs-section="structure">
      <section class="pvs-section">
        <h3>{{ t('Entry conditions','入场条件') if kind == 'board' else t('Research candidate','研究候选') }}</h3>
        {% if kind == 'board' %}
        <p class="pvs-read" data-entry-status="{{ (es.get('status') or '')|e }}"><span class="l-en">{{ es.get('headline')|e if es.get('headline') is string and es.get('headline')|trim else 'Entry read not supplied' }}</span><span class="l-zh">{% if es.get('headline_zh') is string and es.get('headline_zh')|trim %}{{ es.get('headline_zh')|e }}{% elif es.get('headline') is string and es.get('headline')|trim %}来源原文 · {{ es.get('headline')|e }}{% else %}未提供入场读数{% endif %}</span></p>
        <p class="pvs-assessment-clock" data-assessment-asof="">{{ t('Entry read date not supplied','入场判读日期来源未提供') }} · {{ t('Quote time','报价时间') }} {{ value(row.get('price_as_of')) }}</p>
        {% if row.get('signal_asof') is string and row.get('signal_asof')|trim %}<p class="pvs-signal-clock" data-signal-asof="{{ row.get('signal_asof')|e }}">{{ t('Signal session','信号交易日') }} {{ row.get('signal_asof')|e }}</p>{% endif %}
        <p class="pvs-note">{{ t('The signal session is not the date of the entry assessment. A later quote inside the zone does not renew the entry read.','信号交易日不是入场评估日期。之后报价处于区间内并不会更新入场判读。') }}</p>
        {% if display %}<p class="pvs-chart-clock">{{ t('Daily closes','每日收盘') }} · {{ value((display.get('chart') or {}).get('asof')) }}</p>{% endif %}
        <div class="pvs-chart-slot" data-pvs-chart><p>{{ t('Chart available on the setup card.','可在形态卡片上查看图表。') }}</p></div>
        {% else %}
        <p class="pvs-read">{{ t('Research only · entry details unavailable','仅供研究 · 入场详情暂缺') }}</p>
        {% endif %}
      </section>
      {% if kind == 'board' %}
      <section class="pvs-section"><h3>{{ t('Price levels','关键价位') }}</h3>
      <dl class="pvs-levels">
        {{ field('Snapshot price','快照价格',row.get('price'),'price',true) }}
        {{ field('Entry zone · low','入场区间下沿',zone.get('low'),'entry_signal.buy_zone.low',true) }}
        {{ field('Entry zone · high','入场区间上沿',zone.get('high'),'entry_signal.buy_zone.high',true) }}
        {{ field('Entry-method stop','入场方法止损位',es.get('stop'),'entry_signal.stop',true) }}
        {{ field('Base invalidation','筑底失效位',hold.get('invalidation'),'hold.invalidation',true) }}
        {{ field('Chase boundary','追高边界',es.get('chase_above'),'entry_signal.chase_above',true) }}
      </dl><p class="pvs-note">{{ t('Entry stop and base invalidation are different. Chase boundary is not a target.','入场止损与筑底失效不同；追高边界不是目标价。') }}</p></section>
      {% endif %}
    </div>
    <div class="pvs-group" data-pvs-section="evidence">
      {% if display and display.get('cautions') %}
      <section class="pvs-section pvs-opportunity-cautions"><h3>{{ t('Risks to review','待审阅风险') }}</h3>
        <ul>{% for caution in display.cautions %}<li>{{ t(caution.en, caution.zh) }}</li>{% endfor %}</ul>
      </section>
      {% endif %}
      <section class="pvs-section"><h3>{{ t('Why it is here','入选理由') }}</h3>
        {% if display and display.get('assessment_detail') %}<p class="pvs-assessment-detail">{{ t(display.assessment_detail.en,display.assessment_detail.zh) }}</p>
        {% else %}<p>{{ original(sig.get('reason') if kind == 'board' else row.get('headline_reason')) }}</p>{% endif %}
      </section>
      {% if display and display.get('evidence_profile') %}
      <section class="pvs-section pvs-evidence-profile"><h3>{{ t('Evidence profile','证据概览') }}</h3>
        <p class="pvs-note">{{ t('Published relative family scores · 0–100. Present families receive equal weight. These are not probabilities or entry permission.','已发布的类别相对评分 · 0–100。已有评分的类别等权计入；这些数值并非概率或入场许可。') }}</p>
        <dl class="pvs-facts">{% for family in display.evidence_profile.scores %}
          <div class="pvs-field" data-evidence-family="{{ family.key }}"><dt>{{ t(family.label.en,family.label.zh) }}</dt><dd>{{ '%.1f'|format(family.value) }}</dd></div>
        {% endfor %}</dl>
        {% if display.evidence_profile.abstaining %}<p class="pvs-note pvs-evidence-absent">{{ t('Not scored','未计分') }}: {% for label in display.evidence_profile.abstaining %}{{ t(label.en,label.zh) }}{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
      </section>
      {% endif %}
      {% if kind == 'board' %}
      <section class="pvs-section"><h3>{{ t('Technical context','技术背景') }}</h3><dl class="pvs-facts">
        {{ field('Above 200-day trend','高于 200 日趋势',sig.get('above200'),'signal.above200',boolean=true) }}
        {{ field('Weekly confirmation','周线确认',sig.get('weekly_bull'),'signal.weekly_bull',boolean=true) }}
        {{ field('Provisional observation','暂定观察',sig.get('provisional'),'signal.provisional',boolean=true) }}
      </dl></section>{% endif %}
      <p class="pvs-availability">{{ t('Target and holding period unavailable in this view. Reward/risk and win probability are not calculated.','此视图暂无目标价与持有周期，不计算收益风险比或成功概率。') }}</p>
    </div>
    {%- if display and (display.get('context') or display.get('memory_href')) %}
    <div class="pvs-group" data-pvs-section="research">
      <section class="pvs-section pvs-research-links"><h3>{{ t('Explore the context','探索背景') }}</h3>
        {% if display.get('context') %}<p><a class="pvs-context-link" href="{{ display.context.href|e }}" target="_blank" rel="noopener">{{ t(display.context.label.en,display.context.label.zh) }} · {{ t('new tab','新标签页') }} ↗</a></p>{% endif %}
        {% if display.get('memory_href') %}<p><a class="pvs-memory-link l-en" href="{{ display.memory_href|e }}&amp;mm_lang=en" target="_blank" rel="noopener">Market Memory · recomputed history · new tab ↗</a><a class="pvs-memory-link l-zh" href="{{ display.memory_href|e }}&amp;mm_lang=zh" target="_blank" rel="noopener">市场记忆 · 重算历史 · 新标签页 ↗</a></p>
        <p class="pvs-note">{{ t('Explore this security using currently available history. This is separate research, not evidence matched to this setup. Your setup stays open here.','使用当前可得历史探索这只证券。这是独立研究，并非与本形态匹配的证据；此处保留当前形态。') }}</p>{% endif %}
      </section>
    </div>
    {%- endif %}
    <div class="pvs-group" data-pvs-section="sources">
      <details class="pvs-audit"><summary>{{ t('Evidence & source details','证据与来源详情') }}</summary>
        <section class="pvs-section"><h3>{{ t('Setup information','形态信息') }}</h3>
        <p class="pvs-status-read">{{ status_name(row.get('stage'), {'live': ('Active setups','活跃形态'), 'setting_up': ('Developing','形态形成中'), 'ran': ('Ran — don’t chase','已启动 — 勿追'), 'basing': ('Basing','筑底中'), 'blocked': ('Blocked','受阻')}) }} · {{ status_name(row.get('lane') if kind == 'board' else none, {'bottoming': ('Base formation','筑底'), 'continuation': ('Continuation','延续'), 'trend': ('Trend','趋势'), 'recovery': ('Recovery','复苏'), 'watch': ('Watch','观察')}) }}</p>
        <dl class="pvs-facts">
          {{ field('Source setup type','来源形态类别',row.get('lane') if kind == 'board' else none,'lane') }}
          {{ field('Source stage','来源阶段',row.get('stage'),'stage') }}
          {{ field('Strategy sleeve','策略分组',none,'canonical strategy binding not supplied') }}
          {{ field('Holding horizon','持有周期',none,'holding duration not supplied') }}
        </dl><p class="pvs-note">{{ t('Selection is not entry permission. Setup type is not an assigned strategy.','精选不等于入场许可，形态类别不是已分配的策略。') }}</p></section>
        <section class="pvs-section pvs-plan-relation" data-plan-relation="{{ ((plan_rel.get('state') if plan_rel is mapping else none) or 'none')|e }}" data-plan-exact="unavailable">
          {% set _plan_state = (plan_rel.get('state') if plan_rel is mapping else none) or 'none' %}
          {% if _plan_state == 'related_security' %}
          <h3>{{ t('Related model record','相关模型记录') }}</h3>
          {% for plan in (plan_rel.get('plans') or []) %}
          <div class="pvs-plan-rec" data-plan-id="{{ (plan.get('id') or '')|e }}" data-plan-lifecycle="{{ (plan.get('lifecycle_state') or '')|e }}">
            <p><code>{{ (plan.get('id') or '')|e }}</code></p>
            <p>{{ t('Status','状态') }} {{ t(life_label_en(plan.get('lifecycle_state')),life_label_zh(plan.get('lifecycle_state'))) }}</p>
            <p>{{ t('Formation anchor','形成锚点') }} {{ value(plan.get('formation_date')) }}</p>
            {% if plan.get('signal_date_basis') == 'tier_event_date' %}
            <p>{{ t('Signal event session','信号事件交易日') }} {{ value(plan.get('signal_date')) }}</p>
            {% elif plan.get('signal_date_basis') == 'legacy_formation_alias' %}
            <p>{{ t('Formation alias · signal event unverified','形成日期别名 · 信号事件未核实') }} {{ value(plan.get('signal_date')) }}</p>
            {% elif plan.get('signal_date_basis') == 'tier_observation' %}
            <p>{{ t('Observation only · no signal event recorded','仅有观测 · 未记录信号事件') }}</p>
            {% else %}
            <p>{{ t('Source signal date · basis unavailable','来源信号日期 · 日期依据不可用') }} {{ value(plan.get('signal_date')) }}</p>
            {% endif %}
            <p>{{ t('Price observations through','价格观测截至') }} {{ value(plan.get('observed_date')) }}</p>
            <p>{{ t('Plan price basis','计划价格基准日') }} {{ value(plan.get('price_basis_date')) }}</p>
            <p>{{ t('Recorded date','记录日期') }} {{ value(plan.get('recorded_at')) }}</p>
            <p>{{ t('Plan as of','计划截至') }} {{ value(plan.get('plan_asof')) }}</p>
            <button type="button" class="pvs-plan-link" data-pvs-plan-target="pv-{{ (plan.get('id') or '')|e }}"><span class="l-en">View in Plans</span><span class="l-zh">在计划中查看</span></button>
          </div>
          {% endfor %}
          <p class="pvs-note">{{ t('Dates describe sessions or calendar days. Publication / first-visible time not supplied. A historical signal or record status does not establish current entry availability.','日期表示交易日或日历日。未提供发布／首次可见时间。历史信号或记录状态不代表当前可入场。') }}</p>
          <p class="pvs-note">{{ t("A model record for the same security. It is not this candidate's plan and not a position you hold.",'这是同一证券的模型记录，不是此候选的计划，也不是您持有的仓位。') }}</p>
          <p class="pvs-note">{{ t('Exact plan relation: not available from the source.','精确计划关联：来源未提供。') }}</p>
          {% elif _plan_state == 'unknown' %}
          <h3>{{ t('Plan connection','计划关联') }}</h3><p class="pvs-note">{{ t('Plan records could not be read for this candidate.','无法读取此候选的计划记录。') }}</p>
          {% else %}
          <h3>{{ t('Plan connection','计划关联') }}</h3><p class="pvs-note">{{ t('No open same-security model record found. No plan or position is created here.','未找到同一证券的未平仓模型记录，不在此创建计划或持仓。') }}</p>
          <p class="pvs-note">{{ t('Exact plan relation: not available from the source.','精确计划关联：来源未提供。') }}</p>
          {% endif %}
        </section>
        <section class="pvs-section"><h3>{{ t('Source dates','来源时间') }}</h3><dl class="pvs-facts">
          {{ field('Source as-of','来源日期',as_of,'envelope.as_of') }}
          {{ field('Signal as-of','信号日期',row.get('signal_asof') if kind == 'board' else none,'signal_asof') }}
          {{ field('Price observations through','价格观测截至',sig.get('tier_observed_date'),'signal.tier_observed_date') }}
          {{ field('Quote timestamp','报价时间',row.get('price_as_of') if kind == 'board' else none,'price_as_of') }}
        </dl><p class="pvs-note">{{ t('Source date is not a quote timestamp. Missing clocks remain missing.','来源日期不是报价时间，缺失时间保持缺失。') }}</p></section>
      </details>
    </div>
  </div>
</div>
{%- endmacro %}
{% macro action(content) -%}
<details class="pv-setup-inline"><summary>{{ t('Setup detail','形态详情') }}</summary>{{ content }}</details>
{%- endmacro %}

{# Same one-row presenter, serialized only with an already-entitled table row.
   Chart text remains inert until the bounded display guard validates its geometry. #}
{% macro table_action(row, as_of=none, plan_rel={'state': 'none', 'plans': []}, display=none) -%}
<details class="pv-setup-inline pv-setup-table" data-setup-ticker="{{ row.ticker|e }}" data-setup-asof="{{ as_of|e if as_of else '' }}">
<summary>{{ t('Setup detail','形态详情') }}</summary>
<template class="pvs-body-source">{{ body(row, 'board', as_of, plan_rel, display=display) }}</template>
<p class="pvs-fallback-note">{{ t('If detail is unavailable, use the stock link in this row.','若详情不可用，请使用本行的个股链接。') }}</p>
<template class="pvs-chart-source">{{ row.get('spark_svg')|e if row.get('spark_svg') is string else '' }}</template>
</details>
{%- endmacro %}

{# Production table uses the same row presenter and caution fold as its card.
   The legacy action remains usable by read-only callers without a rich display. #}
{% macro opportunity_table_action(row, as_of=none, plan_rel={'state': 'none', 'plans': []}) -%}
{% import "_prophet_board_cautions.html.j2" as board_cautions %}
{% set folded = namespace(rows=[]) %}
{% set ignored = board_cautions.fold(row, folded) %}
{% set display = present_us_candidate(row, occurrence_id='table-detail', board_asof=as_of, folded_cautions=folded.rows) %}
{{ table_action(row, as_of, plan_rel, display=display) }}
{%- endmacro %}
