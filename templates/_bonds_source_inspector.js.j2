    const content=S.pending?'<div class="source-empty"><h3>'+T(S.origin==='import'?'Reading local publication…':'Reading site publication…',S.origin==='import'?'正在读取本地数据…':'正在读取站点发布数据…')+'</h3><p>'+T('Source values remain unavailable until validation finishes.','验证完成前，来源值保持不可用。')+'</p></div>':!S.model.ok?UB():S.field?FLD():({overview:OV,fields:FV,dates:DV,missing:MV}[S.section]||OV)();
