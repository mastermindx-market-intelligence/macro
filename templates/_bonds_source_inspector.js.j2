  function UB(){const er=(S.model&&S.model.errors)||[];let m=T('This publication could not be loaded','无法载入这份发布数据');if(er.indexOf('signin_required')>=0)m=T('Sign-in required to view the publication','查看此发布数据需要登录');else if(er.indexOf('access_required')>=0)m=T('Access required to view the publication','查看此发布数据需要相应权限');else if(er.indexOf('not_published')>=0)m=T('No publication available at the configured path','配置路径下没有可用的发布数据');else if(er.indexOf('timeout')>=0)m=T('Loading the publication timed out. Try again.','载入发布数据超时，请重试。');else if(er.indexOf('publication_too_large')>=0)m=T('Publication exceeds the 1.5 MB limit','发布数据超过 1.5 MB 上限');else if(er.indexOf('file_read_failed')>=0)m=T('Could not read the imported file','无法读取导入的文件');else if(er.indexOf('invalid_json')>=0)m=T('Publication JSON could not be parsed','发布数据 JSON 无法解析');else if(er.indexOf('unsupported_media_type')>=0)m=T('The response is not publication JSON','响应不是发布数据 JSON');else if(er.indexOf('invalid_utf8')>=0)m=T('Publication text is not valid UTF-8','发布数据文本不是有效的 UTF-8');else if(er.indexOf('network_or_redirect')>=0)m=T('The publication is unreachable or redirected','发布数据无法连接或发生重定向');else if(er.some(c=>c.startsWith('http_')))m=T('The publication service is unavailable','发布数据服务暂不可用');else if(er.indexOf('network')>=0)m=T('Could not reach the publication endpoint','无法连接发布数据接口');else if(er.some(c=>c.indexOf('unsupported_')===0)||er.some(c=>c.indexOf('malformed_')===0)||er.some(c=>c==='missing_provenance'))m=T('Publication schema not recognised','发布数据格式无法识别');
