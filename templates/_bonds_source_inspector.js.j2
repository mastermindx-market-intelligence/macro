  function GB(){return document.getElementById(CT);}
  function RF(focusSelector){
    const body=GB();
    if(!body)return;
    const active=document.activeElement;
    const preserveFocus=body.contains(active);
    const loadbarFocus=active?.matches('[data-source-file]')?'[data-source-file]':
      active?.matches('[data-source-action="reload-site"]')?'[data-source-action="reload-site"]':null;
    const title=document.getElementById(TTL);
    if(title)title.textContent=T('Bonds transmission sources','债券传导来源');
    const close=document.getElementById(CLS);
    if(close)close.setAttribute('aria-label',T('Close source inspector','关闭来源检查器'));
    body.setAttribute('aria-busy',String(S.pending));
    body.innerHTML=VW();
    BD(body);
    const status=document.getElementById('bonds-source-status');
    if(status)status.textContent=S.pending?T('Reading publication.','正在读取发布数据。'):S.model.ok?T('Publication loaded. Display context only.','发布数据已载入，仅用于显示背景。'):T('Source unavailable.','来源不可用。');
    const selector=focusSelector||loadbarFocus;
    const target=selector?body.querySelector(selector):null;
    if(target)target.focus();
    else if(preserveFocus)body.focus({preventScroll:true});
  }
  function SR(body){
    const query=S.query.toLowerCase().trim();
    let count=0;
    body.querySelectorAll('[data-source-search-text]').forEach(el=>{
      el.hidden=!el.dataset.sourceSearchText.includes(query);
      if(!el.hidden)count++;
    });
    const empty=body.querySelector('[data-source-no-results]');
    if(empty)empty.hidden=count>0;
  }
  function cancelPending(reason){
    S.request++;
    const controller=S.controller;
    S.controller=null;
    S.pending=false;
    if(controller)controller.abort(reason);
  }
  function beginRead(origin,filename){
    cancelPending('superseded');
    S.origin=origin;
    S.filename=filename||null;
    S.pending=true;
    S.model=A.parse(null);
    S.field=null;
    S.section='overview';
    RF();
    return S.request;
  }
  function completeRead(request,model){
    if(request!==S.request)return;
    S.model=model;
    S.pending=false;
    S.controller=null;
    RF();
  }
  async function readFile(file){
    const request=beginRead('import',file.name);
    if(file.size>CAP){completeRead(request,F('publication_too_large'));return;}
    let bytes;
    try{bytes=await file.arrayBuffer();}
    catch(_){completeRead(request,F('file_read_failed'));return;}
    if(request!==S.request)return;
    let model;
    try{model=A.parse(new TextDecoder('utf-8',{fatal:true}).decode(bytes));}
    catch(_){model=F('invalid_utf8');}
    completeRead(request,model);
  }
  function BD(body){
    SR(body);
    body.querySelector('[data-source-search]')?.addEventListener('input',event=>{
      S.query=event.target.value;
      SR(body);
    });
    body.querySelectorAll('[data-source-action]').forEach(el=>el.addEventListener('click',()=>{
      const action=el.dataset.sourceAction;
      if(action==='section'){
        S.section=el.dataset.section;S.field=null;RF();body.focus();
      }else if(action==='field'){
        S.returnSection=S.section;S.field=el.dataset.field;RF('[data-source-action="back"]');
      }else if(action==='back'){
        const field=S.field;S.field=null;S.section=S.returnSection;RF('[data-field="'+field+'"]');
      }else if(action==='reload-site'){FS();}
    }));
    body.querySelector('[data-source-file]')?.addEventListener('change',event=>{
      const file=event.target.files?.[0];
      if(file)readFile(file);
    });
  }
  async function boundedResponseText(response){
    const declared=Number(response.headers.get('content-length'));
    if(Number.isFinite(declared)&&declared>CAP)throw new Error('publication_too_large');
    let bytes;
    if(response.body?.getReader){
      const reader=response.body.getReader(),chunks=[];
      let length=0;
      try{
        while(true){
          const next=await reader.read();
          if(next.done)break;
          length+=next.value.byteLength;
          if(length>CAP){await reader.cancel();throw new Error('publication_too_large');}
          chunks.push(next.value);
        }
      }finally{reader.releaseLock();}
      bytes=new Uint8Array(length);
      let offset=0;
      for(const chunk of chunks){bytes.set(chunk,offset);offset+=chunk.byteLength;}
    }else{
      const buffer=await response.arrayBuffer();
      if(buffer.byteLength>CAP)throw new Error('publication_too_large');
      bytes=new Uint8Array(buffer);
    }
    try{return new TextDecoder('utf-8',{fatal:true}).decode(bytes);}
    catch(_){throw new Error('invalid_utf8');}
  }
  async function FS(){
    const request=beginRead('site');
    const controller=new AbortController();
    S.controller=controller;
    let timedOut=false;
    const timeout=setTimeout(()=>{timedOut=true;controller.abort();},MS);
    let model=F('network');
    try{
      const response=await fetch(URL,{
        credentials:'same-origin',cache:'no-store',redirect:'error',
        signal:controller.signal,headers:{Accept:'application/json'}
      });
      if(request!==S.request)return;
      if(response.status===401)model=F('signin_required');
      else if(response.status===403)model=F('access_required');
      else if(response.status===404)model=F('not_published');
      else if(!response.ok)model=F('http_'+response.status);
      else if((response.headers.get('content-type')||'').split(';')[0].trim().toLowerCase()!=='application/json'){
        model=F('unsupported_media_type');
      }else{
        const text=await boundedResponseText(response);
        if(request!==S.request)return;
        model=A.parse(text);
      }
    }catch(error){
      if(request!==S.request)return;
      model=F(timedOut?'timeout':['publication_too_large','invalid_utf8'].includes(error?.message)?error.message:'network_or_redirect');
    }finally{
      clearTimeout(timeout);
      if(S.controller===controller)S.controller=null;
      completeRead(request,model);
    }
  }
  function OD(){
    const dialog=document.getElementById(DLG),opener=document.getElementById(OPN);
    if(!dialog)return;
    S.lang=document.documentElement.getAttribute('data-lang')==='zh'?'zh':'en';
    S.opener=opener;
    if(!dialog.open)dialog.showModal();
    opener?.setAttribute('aria-expanded','true');
    if(!S.model.ok&&!S.pending)FS();else RF();
  }
  function CD(){
    const dialog=document.getElementById(DLG);
    cancelPending('dialog_closed');
    if(dialog?.open)dialog.close();
  }
  function BDL(){
    const dialog=document.getElementById(DLG),opener=document.getElementById(OPN),close=document.getElementById(CLS);
    opener?.addEventListener('click',event=>{event.preventDefault();OD();});
    close?.addEventListener('click',event=>{event.preventDefault();CD();});
    if(!dialog)return;
    // Keep keyboard cycling within the active dialog, including Chromium's
    // last-control boundary. Native modal inertness still owns the background.
    dialog.addEventListener('keydown',event=>{
      if(event.key!=='Tab'||!dialog.open)return;
      const controls=Array.from(dialog.querySelectorAll(
        'a[href],button:not([disabled]),input:not([disabled]):not([type="hidden"]),select:not([disabled]),textarea:not([disabled]),summary,[tabindex]:not([tabindex="-1"])'
      )).filter(el=>el.tabIndex>=0&&el.getClientRects().length&&getComputedStyle(el).visibility==='visible');
      const first=controls[0],last=controls.at(-1),active=document.activeElement;
      if(!first){event.preventDefault();GB()?.focus();return;}
      if(event.shiftKey&&(active===first||!dialog.contains(active))){
        event.preventDefault();last.focus();
      }else if(!event.shiftKey&&(active===last||!dialog.contains(active))){
        event.preventDefault();first.focus();
      }
    });
    dialog.addEventListener('cancel',event=>{event.preventDefault();CD();});
    dialog.addEventListener('close',()=>{
      cancelPending('dialog_closed');
      opener?.setAttribute('aria-expanded','false');
      if(S.opener&&document.contains(S.opener))S.opener.focus();
      S.opener=null;
    });
    dialog.addEventListener('click',event=>{
      if(event.target!==dialog)return;
      const rect=dialog.getBoundingClientRect();
      if(event.clientX<rect.left||event.clientX>rect.right||event.clientY<rect.top||event.clientY>rect.bottom)CD();
    });
    document.addEventListener('langchange',()=>{
      S.lang=document.documentElement.getAttribute('data-lang')==='zh'?'zh':'en';
      RF();
    });
  }
  function init(){BDL();RF();}
  window.MMXSourceInspector=Object.freeze({
    view:VW,bind:body=>BD(body||GB()),close:CD,open:OD,
    getState:()=>JSON.parse(JSON.stringify({
      model:S.model,section:S.section,field:S.field,returnSection:S.returnSection,
      lang:S.lang,query:S.query,pending:S.pending,filename:S.filename,origin:S.origin,request:S.request
    }))
  });
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});
  else init();
})();
