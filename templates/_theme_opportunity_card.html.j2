{# Shared Lane E presentation. It receives only validated owner-derived display data. #}
{% macro toc_bi(en, zh) -%}<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>{%- endmacro %}
{% macro toc_clock(label, value, reason=none) -%}<span class="toc-clock"><b>{{ label }}</b> {{ value if value else '—' }}{% if reason %}<small>{{ reason }}</small>{% endif %}</span>{%- endmacro %}
{% macro toc_bar(status) -%}<span class="toc-clock"><b>BAR</b> closed={{ status.closed if status.closed is not none else '—' }} · provisional={{ status.provisional if status.provisional is not none else '—' }}</span>{%- endmacro %}
{% macro theme_opportunity_card(card) -%}
<article class="toc-card" id="theme-{{ card.theme.theme_id }}"
  data-component-version="{{ card.component_version }}"
  data-source-contract="{{ card.source_contract }}"
  data-source-record-ref="{{ card.source_record_ref }}"
  data-fixture="{{ 'true' if card.fixture else 'false' }}">
  <header class="toc-head">
    <div>
      <p class="toc-eyebrow">{{ toc_bi(card.surface.source_lens_en, card.surface.source_lens_zh) }}</p>
      <h3>{{ toc_bi(card.theme.name_en, card.theme.name_zh) }}</h3>
      <p class="toc-meta">{{ card.theme.market if card.theme.market else '—' }} · {{ card.theme.horizon if card.theme.horizon else '—' }} · {{ card.theme.relationship_kind if card.theme.relationship_kind else '—' }}{% if card.theme.basket_id %} · {{ card.theme.basket_id }}{% endif %}</p>
      <div class="toc-specialist">
        <span>{{ toc_bi('Lane', '分组') }}: {{ card.specialist_context.lane if card.specialist_context.lane else '—' }}</span>
        <span>{{ toc_bi('Stage', '阶段') }}: {{ card.specialist_context.stage if card.specialist_context.stage else '—' }}</span>
        <span>{{ toc_bi('Divergence', '背离') }}: {{ card.specialist_context.divergence if card.specialist_context.divergence else '—' }}</span>
      </div>
    </div>
    {% if card.fixture %}<span class="toc-fixture">{{ toc_bi('Fixture — not live data', '样例——非实时数据') }}</span>{% endif %}
  </header>

  <section class="toc-answer" aria-label="Decision summary">
    <div><b>{{ toc_bi('What changed', '发生了什么变化') }}</b><p>{{ toc_bi(card.summary.what_changed_en, card.summary.what_changed_zh) }}</p></div>
    <div><b>{{ toc_bi('Why it matters', '为何重要') }}</b><p>{{ toc_bi(card.summary.why_matters_en, card.summary.why_matters_zh) }}</p></div>
    <div><b>{{ toc_bi('Opportunity condition', '机会条件') }}</b><p>{{ toc_bi(card.summary.opportunity_en, card.summary.opportunity_zh) }}</p></div>
    <div><b>{{ toc_bi('Risk / invalidation', '风险／失效条件') }}</b><p>{{ toc_bi(card.summary.risk_en, card.summary.risk_zh) }}</p></div>
    <div class="toc-wide"><b>{{ toc_bi('Disagreement', '分歧') }}</b><p>{{ toc_bi(card.summary.disagreement_en, card.summary.disagreement_zh) }}</p></div>
  </section>

  <div class="toc-axes">
    {% for axis_name in card.axis_order %}{% set axis = card.axes[axis_name] %}{% set axis_label = card.axis_labels[axis_name] %}
    <section class="toc-axis" data-axis="{{ axis_name }}" data-owner-state="{{ axis.state }}" data-tone="{{ axis.tone }}">
      <div class="toc-axis-top"><span>{{ toc_bi(axis_label[0], axis_label[1]) }}</span><strong class="toc-owner-state">{{ axis.state }}</strong></div>
      {% if axis.owner_details %}<div class="toc-owner-details">{% for field, value in axis.owner_details.items() %}<span class="toc-owner-detail" data-owner-field="{{ field }}"><b>{{ field }}</b> {{ value if value is not none else '—' }}</span>{% endfor %}</div>{% endif %}
      <p class="toc-axis-explanation"><strong>{{ toc_bi(axis.label_en, axis.label_zh) }}</strong> · {{ toc_bi(axis.reason_en, axis.reason_zh) }}</p>
      <div class="toc-receipt">{% for code in axis.reason_codes %}<code>{{ code }}</code>{% endfor %}{% for ref in axis.source_refs %}<code>{{ ref }}</code>{% endfor %}</div>
      <div class="toc-clocks">{{ toc_clock('O', axis.clocks.observation, axis.clock_reasons.observation) }}{{ toc_clock('A', axis.clocks.availability, axis.clock_reasons.availability) }}{{ toc_clock('C', axis.clocks.computation, axis.clock_reasons.computation) }}{{ toc_clock('P', axis.clocks.publication, axis.clock_reasons.publication) }}{{ toc_bar(axis.bar_status) }}</div>
    </section>
    {% endfor %}
  </div>

  <section class="toc-names">
    <b>{{ toc_bi('Subtheme and names', '子主题与标的') }}</b>
    <div class="toc-name-list">{% for name in card.names %}<span class="toc-namechip" data-instrument-id="{{ name.instrument_id }}" data-relationship-kind="{{ name.relationship_kind }}" data-membership-basis="{{ name.membership_basis }}" data-membership-as-of="{{ name.membership_as_of }}"><strong>{{ name.symbol }}</strong> {{ toc_bi(name.name_en, name.name_zh) }}</span>{% else %}<span class="toc-null">{{ toc_bi('No owner-qualified names', '暂无所有者确认的标的') }}</span>{% endfor %}</div>
  </section>

  <section class="toc-setups" aria-label="Individual setups">
    <div class="toc-setups-head"><b>{{ toc_bi('Individual setups', '个股形态') }}</b><span>{{ toc_bi('Stock qualification is independent from the theme-level entry read.', '个股资格独立于主题层入场读数。') }}</span></div>
    {% for setup in card.entry_setups %}
    <article class="toc-setup" data-routing-state="{{ setup.routing_state }}" data-qualified="{{ 'true' if setup.qualified else 'false' }}" data-headwind-warning="{{ 'true' if setup.headwind_warning else 'false' }}" data-tone="{{ setup.tone }}">
      <div class="toc-setup-copy"><strong>{{ setup.instrument_id }} · {{ toc_bi(setup.label_en, setup.label_zh) }}</strong><p>{{ toc_bi(setup.reason_en, setup.reason_zh) }}</p><small>{{ setup.relationship_kind }} · confirmation={{ setup.confirmation_state if setup.confirmation_state else '—' }} · extended={{ setup.group_extended }} · headwind={{ setup.group_headwind }}</small></div>
      {% if setup.may_navigate %}<div class="toc-setup-links"><a href="{{ setup.href }}" data-entry-record-ref="{{ setup.record_ref if setup.record_ref else '' }}" data-entry-record-id="{{ setup.record_id if setup.record_id else '' }}">{{ toc_bi(setup.cta_en, setup.cta_zh) }}</a><a href="{{ setup.group_href }}">{{ toc_bi('Open group context', '打开群组背景') }}</a></div>{% endif %}
      <details class="toc-setup-detail"><summary>{{ toc_bi('Levels, clocks and receipt', '价位、时钟与依据') }}</summary><div class="toc-levels"><span>trigger={{ setup.levels.trigger if setup.levels.trigger is not none else '—' }}</span><span>zone={{ setup.levels.zone if setup.levels.zone is not none else '—' }}</span><span>invalidation={{ setup.levels.invalidation if setup.levels.invalidation is not none else '—' }}</span><span>chase_above={{ setup.levels.chase_above if setup.levels.chase_above is not none else '—' }}</span></div><div class="toc-receipt"><code>{{ setup.record_ref if setup.record_ref else '—' }}</code>{% if setup.record_id %}<code>{{ setup.record_id }}</code>{% endif %}<code>{{ setup.routing_state }}</code></div><div class="toc-setup-clocks">{% for owner, clock_set in setup.clocks.items() %}<div class="toc-setup-clock-row" data-clock-owner="{{ owner }}"><b>{{ owner }}</b>{% for clock_name in ['observation', 'availability', 'computation', 'publication'] %}{% set clock = clock_set[clock_name] %}<span><strong>{{ clock_name }}</strong> {{ clock.value if clock.value is not none else '—' }}{% if clock.reason %}<small>{{ clock.reason }}</small>{% endif %}</span>{% endfor %}</div>{% endfor %}</div><p class="toc-setup-lineage">state={{ setup.lineage.state }} · source_revision={{ setup.lineage.source_revision if setup.lineage.source_revision is not none else '—' }} · correction_of={{ setup.lineage.correction_of if setup.lineage.correction_of else '—' }} · supersedes={{ setup.lineage.supersedes if setup.lineage.supersedes else '—' }} · source_content_sha256={{ setup.lineage.source_content_sha256 if setup.lineage.source_content_sha256 else '—' }}{% if setup.lineage.reason %} · reason={{ setup.lineage.reason }}{% endif %}</p></details>
    </article>
    {% else %}<p class="toc-null">{{ toc_bi('No owner-authorized individual setup records supplied.', '未提供所有者授权的个股形态记录。') }}</p>{% endfor %}
  </section>

  <nav class="toc-routes" aria-label="Theme intelligence routes">
    <a href="{{ card.routes.tracker }}">{{ toc_bi('Theme Tracker', '主题追踪') }}</a>
    <a href="{{ card.routes.foresight }}">{{ toc_bi('Foresight', '前瞻') }}</a>
    <a href="{{ card.routes.radar }}">{{ toc_bi('Divergence Radar', '背离雷达') }}</a>
    <a href="{{ card.routes.sector }}">{{ toc_bi('Sector Confluence', '行业汇聚') }}</a>
  </nav>

  <details class="toc-evidence">
    <summary>{{ toc_bi('Evidence, clocks and capability ceiling', '证据、时钟与能力上限') }}</summary>
    <div class="toc-clocks">{{ toc_clock('O', card.receipts.clocks.observation) }}{{ toc_clock('A', card.receipts.clocks.availability) }}{{ toc_clock('C', card.receipts.clocks.computation) }}{{ toc_clock('P', card.receipts.clocks.publication) }}{{ toc_bar(card.receipts.bar_status) }}</div>
    <div class="toc-watermarks"><b>{{ toc_bi('Snapshot', '快照') }}</b> {{ card.receipts.watermarks.snapshot if card.receipts.watermarks.snapshot else '—' }}{% for key, value in card.receipts.watermarks.inputs.items() %}<span><b>{{ key }}</b> {{ value if value else '—' }}</span>{% endfor %}</div>
    <div class="toc-receipt">{% for ref in card.receipts.source_records %}<code>{{ ref }}</code>{% endfor %}{% for family in card.receipts.independent_evidence_families %}<code>family:{{ family }}</code>{% endfor %}</div>
    <p class="toc-evidence-identity" data-evidence-identity-available="{{ 'true' if card.receipts.evidence_identity.available else 'false' }}">{{ toc_bi('Evidence identity', '证据身份') }}: available={{ card.receipts.evidence_identity.available }} · reason={{ card.receipts.evidence_identity.reason_code if card.receipts.evidence_identity.reason_code else '—' }}{% for ref in card.receipts.evidence_identity_refs %} · {{ ref }}{% endfor %}</p>
    <p class="toc-lineage">{{ toc_bi('Correction lineage', '更正沿革') }}: supersedes={{ card.receipts.correction_lineage.supersedes if card.receipts.correction_lineage.supersedes else '—' }} · first_observed={{ card.receipts.correction_lineage.first_observed if card.receipts.correction_lineage.first_observed else '—' }} · first_displayed={{ card.receipts.correction_lineage.first_displayed if card.receipts.correction_lineage.first_displayed else '—' }}</p>
    <p class="toc-ceiling">context=on · display=on · signal=off · rank=off · gate=off · size=off · escalate=off · trade=off</p>
  </details>
</article>
{%- endmacro %}
