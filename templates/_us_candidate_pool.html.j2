{% autoescape true %}
{# Lossless candidate visibility through the existing US payload/auth path. #}
{% if us_candidate_visibility is defined and us_candidate_visibility %}
{% set _pool = us_candidate_visibility %}
{% set _pc = _pool.counts %}
{% set _pool_gate = pgate.get('candidate_pool') if pgate else none %}
<style>
.ucp{margin:14px 0;border:1px solid var(--line);border-radius:var(--r-card,12px);background:var(--panel);color:var(--text);font-size:12px}
.ucp>summary{padding:12px 14px;cursor:pointer;line-height:1.6;font-weight:650}.ucp>summary:focus-visible{outline:2px solid var(--link);outline-offset:2px}
.ucp-summary-count{font-weight:400;color:var(--muted);margin-left:12px}.ucp-body{padding:0 14px 12px}.ucp-note{color:var(--muted);margin:4px 0 12px;line-height:1.6}
.ucp-controls{display:flex;gap:14px;flex-wrap:wrap;align-items:end;margin:10px 0}.ucp-search{display:grid;gap:5px;flex:1;min-width:180px}.ucp-search input{width:100%;box-sizing:border-box;background:var(--panel);color:var(--text);border:1px solid var(--line);border-radius:var(--r-ctl,8px);padding:9px;font:inherit}
.ucp-controls input:focus-visible{outline:2px solid var(--link);outline-offset:2px}.ucp-toggle{display:flex;gap:7px;align-items:center;padding:9px 0}
.ucp-list{max-height:420px;overflow:auto;overscroll-behavior:contain}.ucp-row{display:grid;grid-template-columns:minmax(150px,1fr) minmax(180px,1.25fr) 100px;gap:12px;padding:12px 0;border-top:1px solid var(--line);align-items:start}.ucp-row[hidden]{display:none!important}
.ucp-identity,.ucp-decision,.ucp-score{display:flex;flex-direction:column;gap:4px;min-width:0}.ucp-identity a{color:var(--link);font-weight:700;width:fit-content}.ucp-name{overflow-wrap:anywhere}.ucp-placement{font-weight:600}.ucp-score{text-align:right}.ucp-receipt{color:var(--muted);font-size:11px;line-height:1.6}.ucp-receipt summary{cursor:pointer}.ucp-receipt code{display:block;overflow-wrap:anywhere;font-size:10px}.ucp-status{margin:8px 0;color:var(--muted)}
@media(max-width:600px){.ucp-row{grid-template-columns:minmax(0,1fr) 82px;gap:8px}.ucp-decision{grid-column:1/-1;grid-row:2}.ucp-score{grid-column:2;grid-row:1}.ucp-summary-count{display:block;margin-left:0}.ucp-controls{gap:6px}.ucp-list{max-height:520px}}
</style>
<details class="ucp" id="us-candidate-pool" data-status="{{ _pool.status|e }}" data-total="{{ _pc.eligible if _pc.eligible is not none else 0 }}" data-as-of="{{ _pool.as_of or '' }}" data-source-digest="{{ _pool.source_digest or '' }}">
  <summary><span class="l-en">All eligible candidates</span><span class="l-zh">全部候选股票</span>
    {% if _pc.eligible is not none %}<span class="ucp-summary-count">{{ _pc.eligible }} <span class="l-en">eligible</span><span class="l-zh">个候选</span> · {{ _pc.off_buy_lane }} <span class="l-en">outside main list</span><span class="l-zh">个不在主榜</span></span>{% endif %}
  </summary>
  <div class="ucp-body">
    <p class="ucp-note"><span class="l-en">Eligibility is not an entry recommendation. Display limits do not remove names from this view.</span><span class="l-zh">候选资格并非入场推荐。展示上限不会使候选从此视图消失。</span>
      {% if _pool.as_of %}<span class="l-en">As of</span><span class="l-zh">截至</span> {{ _pool.as_of }}.{% endif %}</p>
    {% if _pool.get('archive') %}
    {% set _arc = _pool.archive %}{% set _ac = _arc.counts %}
    <details class="ucp-receipt ucp-archive" data-archive-status="{{ _arc.status|e }}">
      <summary><span class="l-en">Saved history</span><span class="l-zh">历史记录</span> ·
        {% if _ac.matched is not none %}{{ _ac.matched }}/{{ _ac.expected }} <span class="l-en">candidate records match</span><span class="l-zh">个候选记录匹配</span>
        {% else %}<span class="l-en">not verified</span><span class="l-zh">尚未核实</span>{% endif %}
      </summary>
      <p>{% if _arc.status == 'matched_fields' %}<span class="l-en">Saved candidate fields match this screen. The archive does not establish the exact build version.</span><span class="l-zh">已保存的候选字段与此筛选结果匹配，但档案无法确认完全相同的构建版本。</span>
      {% elif _arc.status == 'unavailable' %}<span class="l-en">Saved records could not be verified. Historical comparisons are not established.</span><span class="l-zh">无法核实已保存记录，历史对比依据尚未确立。</span>
      {% else %}<span class="l-en">Some candidate records are missing or differ. Do not treat this archive as a complete replay of this screen.</span><span class="l-zh">部分候选记录缺失或不一致，不能将此档案视为本次筛选的完整回放。</span>{% endif %}</p>
    </details>
    {% endif %}
    {% if _pool.status == 'unavailable' %}
    <p><span class="l-en">Candidate coverage cannot be verified for this board. No missing values have been filled in.</span><span class="l-zh">无法核实当前榜单的候选覆盖情况。缺失值未被补造。</span></p>
    {% elif _pool.status == 'empty' %}
    <p><span class="l-en">No eligible candidates in this snapshot.</span><span class="l-zh">此快照中暂无符合条件的候选。</span></p>
    {% else %}
    <div class="ucp-controls">
      <label class="ucp-search" for="ucp-search"><span><span class="l-en">Find ticker, company or sector</span><span class="l-zh">查找代码、公司或板块</span></span><input id="ucp-search" type="search" autocomplete="off"></label>
      <label class="ucp-toggle"><input id="ucp-outside" type="checkbox"><span><span class="l-en">Outside main list only</span><span class="l-zh">仅看主榜之外</span></span></label>
    </div>
    <p class="ucp-status" aria-live="polite"><span data-ucp-matched>{{ _pool.rows|length }}</span> <span class="l-en">shown of</span><span class="l-zh">个匹配，共加载</span> <span data-ucp-loaded>{{ _pool.rows|length }}</span> <span class="l-en">loaded</span><span class="l-zh">个</span> · {{ _pc.unscored }} <span class="l-en">without a final score in the full pool</span><span class="l-zh">个候选尚无最终评分</span></p>
    <div class="ucp-list">{% with rows=_pool.rows %}{% include "_us_candidate_pool_rows.html.j2" %}{% endwith %}</div>
    <p class="ucp-no-match muted" hidden><span class="l-en">No matches in the loaded candidates.</span><span class="l-zh">已加载的候选中没有匹配结果。</span></p>
    {% if _pool_gate %}<div class="pg-more ucp-more"><span class="l-en">{{ _pool_gate.locked }} more candidates are available with full access.</span><span class="l-zh">完整访问权限可查看另外 {{ _pool_gate.locked }} 个候选。</span></div>{% endif %}
    {% endif %}
  </div>
</details>
<script>
(function(){
  'use strict';
  var root=document.getElementById('us-candidate-pool');
  if(!root || root.dataset.filterBound) return;
  var search=root.querySelector('#ucp-search'), outside=root.querySelector('#ucp-outside');
  if(!search || !outside) return;
  root.dataset.filterBound='true';
  function filter(){
    var term=search.value.trim().toLocaleLowerCase(), rows=root.querySelectorAll('.ucp-row'), shown=0;
    for(var i=0;i<rows.length;i++){
      var row=rows[i], match=(!outside.checked || row.dataset.offBoard==='true') && (!term || row.textContent.toLocaleLowerCase().indexOf(term)!==-1);
      row.hidden=!match; if(match) shown++;
    }
    root.querySelector('[data-ucp-matched]').textContent=String(shown);
    root.querySelector('[data-ucp-loaded]').textContent=String(rows.length);
    root.querySelector('.ucp-no-match').hidden=shown!==0;
  }
  search.addEventListener('input',filter); outside.addEventListener('change',filter);
  root.addEventListener('candidate-pool-hydrated',filter);
  filter();
})();
</script>
{% endif %}

{% endautoescape %}
