      <div class="mx-sec">
        <h3 class="l-en">Why — the three things moving this read</h3><h3 class="l-zh">为什么 — 推动本次判读的三件事</h3>
        <span class="ud-driver-count" aria-hidden="true"><span class="l-en">1 of 3</span><span class="l-zh">1 / 3</span></span>
      </div>
      <div class="ud-driver-grid">

        {# Driver 1 — Trend & breadth. binds to market_state.mtf.indices[*].confluence_en
           (engine/market_state.py:172 publishes confluence_en per row; no top-level
           stance_en). When the leg is absent the row prints the designed-null sentence.
           R-K: carry the mtf leg the live page itself renders into the hero slice so
           driver 1 prints the same word the page already shows elsewhere. #}
        {%- set _tape = _ms.get('mtf') or {} -%}
        {%- set _tape_row = (_tape.get('indices') or [{}])[0] -%}
        <div class="panel ud-driver" data-driver="mtf">
          <b class="ud-driver-head">
            {%- if _tape_row.get('confluence_en') -%}
            <span class="l-en">{{ _tape_row.confluence_en }}</span><span class="l-zh">{{ _tape_row.get('confluence_zh') or _tape_row.confluence_en }}</span>
            {%- else -%}
            <span class="l-en">{{ _null_word_en }}</span><span class="l-zh">{{ _null_word_zh }}</span>
            {%- endif -%}
          </b>
          {# R1 / census #6: leadership context folds INTO this breadth
             driver as the defense-vs-cyclical read — one of three live
             tiles, not a fourth card. Spec §6/§7 driver 4 stays TierLock.
             SIGNAL-ORIGINATION LAW: no dedicated leadership view-model
             key exists. The live strip in templates/dashboard.html.j2
             reads MS.radar.cycle.sector_bias (favor/avoid lists with
             .en + .zh), composed by engine.election_cycle.sector_bias()
             → risk_radar.cycle_context →
             engine.market_state._radar_to_rd()['cycle']. When that key
             is absent the leg is designed-null — never an invented
             rotation read. #}
          {%- set _radar = _ms.get('radar') or {} -%}
          {%- set _cyc = _radar.get('cycle') or {} -%}
          {%- set _sb = _cyc.get('sector_bias') -%}
          {%- set _sb_favor_en = (_sb.favor | map(attribute='en') | join(' / ')) if (_sb and _sb.favor) else '' -%}
          {%- set _sb_avoid_en = (_sb.avoid | map(attribute='en') | join(' / ')) if (_sb and _sb.avoid) else '' -%}
          {%- set _sb_favor_zh = (_sb.favor | map(attribute='zh') | join('／')) if (_sb and _sb.favor) else '' -%}
          {%- set _sb_avoid_zh = (_sb.avoid | map(attribute='zh') | join('／')) if (_sb and _sb.avoid) else '' -%}
          <div class="ud-driver-leg" data-driver="leadership" data-contract="market_state.radar.cycle.sector_bias"{% if not (_sb and _sb_favor_en) %} data-designed-null="1"{% endif %}>
            {%- if _sb and _sb_favor_en and _sb_avoid_en %}
            <p class="ud-driver-body l-en">Under the surface: {{ _sb_favor_en }} have held while {{ _sb_avoid_en }} faded — a rotation read, not a chase cue.</p>
            <p class="ud-driver-body l-zh">表面之下：{{ _sb_favor_zh }}相对坚挺，{{ _sb_avoid_zh }}走弱 — 这是轮动观察，并非追高的信号。</p>
            {%- else %}
            <p class="ud-driver-body l-en">{{ _null_word_en }} — rotation read re-draws nightly.</p>
            <p class="ud-driver-body l-zh">{{ _null_word_zh }}——轮动观察每晚重绘。</p>
            {%- endif %}
          </div>
          {# R6: AI / non-AI breadth split relocated to advanced.html. The hero
             keeps a chip link from this breadth driver surface; the module
             itself is not duplicated here. #}
          <a class="ud-depth ud-driver-chip" href="advanced.html#vsb-breadth-split-section">
            <span class="l-en">See how AI names compare with everyone else.</span><span class="l-zh">查看 AI 相关个股与其他个股相比如何。</span>
          </a>
        </div>

        {# Driver 2 — Risk envelope. R-K: risk_envelope publishes
           provenance.sources[].label_en / label_zh (engine/risk_envelope.py:553-571).
           No top-level `sources` key, no `stance_en` fallback — invented keys are
           gone. When sources is empty the row prints the designed-null sentence. #}
        {%- set _re = risk_envelope or {} -%}
        {%- set _re_prov = ((_re.get('provenance') or {}).get('sources') or []) -%}
        {%- set _re_src = _re_prov[0] if _re_prov|length > 0 else {} -%}
        <div class="panel ud-driver" data-driver="risk_envelope">
          <b class="ud-driver-head">
            {%- if _re_src.get('label_en') -%}
            <span class="l-en">{{ _re_src.label_en }}</span><span class="l-zh">{{ _re_src.get('label_zh') or _re_src.label_en }}</span>
            {%- else -%}
            <span class="l-en">{{ _null_word_en }}</span><span class="l-zh">{{ _null_word_zh }}</span>
            {%- endif -%}
          </b>
          <p class="ud-driver-body l-en">{{ _null_word_en }} — three reads below, never a fused score.</p>
          <p class="ud-driver-body l-zh">{{ _null_word_zh }}——下方为三项读数，非融合评分。</p>
        </div>

        {# Driver 3 — Sentiment. Census #33 Fear/Euphoria dial + #34 Froth/Fragility
           bar fold into ONE tile (#34 is the counterpart inside #33). Display-tier;
           never a signal. Head still reads fear_greed.label_en/label_zh (B1 R-K);
           the body binds the live fear_euphoria + froth_fragility keys the isle
           already renders. Glance prints WORDS only (one-integer law); rail/bar
           geometry is not a competing integer. #}
        {%- set _fg = fear_greed or {} -%}
        {%- set _fe = fear_euphoria if (fear_euphoria is defined and fear_euphoria) else {} -%}
        {%- set _ff = froth_fragility if (froth_fragility is defined and froth_fragility) else {} -%}
        {%- set _fe_sc = _fe.get('fe_score') if _fe else none -%}
        {%- set _fe_band = _fe.get('band') if _fe else none -%}
        {%- set _fe_band_zh = {'Panic':'恐慌','Fear':'恐惧','Neutral':'中性','Greed':'贪婪','Euphoria':'欣喜'}.get(_fe_band, _fe_band) if _fe_band else none -%}
        {%- set _ff_quad_en = _ff.get('quadrant_en') if _ff else none -%}
        {%- set _ff_quad_zh = (_ff.get('quadrant_zh') or _ff_quad_en) if _ff else none -%}
        {%- set _ff_band = _ff.get('band') if _ff else none -%}
        {%- set _ff_band_en = {'calm':'Calm','watch':'Watch','elevated':'Elevated','high':'High','extreme':'Extreme'}.get(_ff_band, _ff_band) if _ff_band else none -%}
        {%- set _ff_band_zh = (_ff.get('band_zh') or _ff_band) if _ff else none -%}
        {%- set _ff_a = ((_ff.get('face_a') or {}).get('score')) if _ff else none -%}
        {%- set _ff_b = ((_ff.get('face_b') or {}).get('score')) if _ff else none -%}
        <div class="panel ud-driver" data-driver="fear_greed" data-fold="sentiment-33-34">
          <b class="ud-driver-head">
            {%- if _fg.get('label_en') -%}
            <span class="l-en">{{ _fg.label_en }}</span><span class="l-zh">{{ _fg.get('label_zh') or _fg.label_en }}</span>
            {%- else -%}
            <span class="l-en">{{ _null_word_en }}</span><span class="l-zh">{{ _null_word_zh }}</span>
            {%- endif -%}
          </b>
          {%- if _fe_band or _ff_band or _ff_quad_en %}
          <div class="ud-sent-lenses">
            {%- if _fe_band %}
            <div class="ud-sent-lens" data-driver-leg="fear_euphoria"
                 data-tip-en="Fear and euphoria context — display only, not a signal."
                 data-tip-zh="恐惧与亢奋背景——仅供展示，不是信号。">
              <span class="ud-sent-lens-name"><span class="l-en">{{ _fe_band }}</span><span class="l-zh">{{ _fe_band_zh }}</span></span>
              {%- if _fe_sc is not none %}
              <div class="ud-sent-rail" aria-hidden="true"><span class="ud-sent-pin" style="left:{{ _fe_sc }}%"></span></div>
              {%- endif %}
            </div>
            {%- endif %}
            {%- if _ff_band or _ff_quad_en %}
            <div class="ud-sent-lens" data-driver-leg="froth_fragility"
                 data-tip-en="{{ _ff_quad_en or 'Froth and fragility context — display only, not a signal.' }}"
                 data-tip-zh="{{ _ff_quad_zh or '狂热与脆弱背景——仅供展示，不是信号。' }}">
              <span class="ud-sent-lens-name"><span class="l-en">{{ _ff_band_en if _ff_band_en else _null_word_en }}</span><span class="l-zh">{{ _ff_band_zh if _ff_band_zh else _null_word_zh }}</span></span>
              {%- if _ff_a is not none and _ff_b is not none %}
              <div class="ud-froth-row" aria-hidden="true">
                <span class="ud-froth-lbl"><span class="l-en">Euphoria</span><span class="l-zh">亢奋度</span></span>
                <div class="ud-froth-track"><div class="ud-froth-fill" style="width:{{ [_ff_a,100]|min }}%"></div></div>
              </div>
              <div class="ud-froth-row" aria-hidden="true">
                <span class="ud-froth-lbl"><span class="l-en">Hidden selling</span><span class="l-zh">暗中派发</span></span>
                <div class="ud-froth-track"><div class="ud-froth-fill ud-froth-fill--b" style="width:{{ [_ff_b,100]|min }}%"></div></div>
              </div>
              {%- endif %}
            </div>
            {%- endif %}
          </div>
          {%- else %}
          <p class="ud-driver-body l-en">{{ _null_word_en }} — sentiment context, display only.</p>
          <p class="ud-driver-body l-zh">{{ _null_word_zh }}——情绪背景，仅展示。</p>
          {%- endif %}
        </div>

        {# Driver 4 — TierLock / sector narrative. locked tier preview per
           spec §4 / §7 (driver 4 = TierLock; 390 hides .ud-driver--locked,
           counter 1 / 3). R1 folds leadership into the breadth tile above,
           not into this locked slot. #}
        <div class="panel ud-driver ud-driver--locked">
          <div class="mx-tier-blurred--spec" aria-hidden="true">
            <div class="ud-driver"><b class="ud-driver-head">██████</b><p class="ud-driver-body">████ ████ ████████ ████ ███████</p></div>
          </div>
          <div class="ud-driver-lock">
            <span class="l-en" aria-label="Full sector narrative is locked.">Full sector narrative is locked.</span>
            <span class="l-zh" aria-label="完整板块叙事已锁定。">完整板块叙事已锁定。</span>
          </div>
        </div>

      </div>
    </div>

    {# === 5 · Watching (spec §6) — three conditions phrased if → what.
       Bound to vm["event_strip"] (real engine data via event_calendar label/label_zh).
       Designed-null fallback surfaces the same shape.

       Spec §7 row 5: at 390, three full cards collapse into ONE DISCLOSURE ROW
       (the <summary>) carrying title + count `3` + chevron + a one-line preview
       of the first condition. The full list lives inside the <details> wrapper
       for tap-open.

       R-L (1440 watching, BLOCKER-1 fix): a closed <details> hides its non-summary
       children at the USER-AGENT level — CSS display rules on the children CANNOT
       override that, which is why the force-open :not([open]) hack failed in the
       capture browser. Fix the DOM state, not the CSS: render
       <details class="ud-watch-details" open> server-side (always open), hide
       the summary chrome at >640px via CSS, and the inline state JS in
       templates/dashboard.html.j2 removes the `open` attribute when the viewport
       is ≤640px so the summary disclosure row takes over. #}
    <div class="ud-watching">
      <div class="mx-sec">
        <h3 class="l-en">What we’re watching next</h3><h3 class="l-zh">接下来我们在盯什么</h3>
        <small class="mx-asof l-en">Three conditions, each phrased as if → what it would change.</small>
        <small class="mx-asof l-zh">三项条件，每条格式为「若 X，则将如何变化」。</small>
      </div>
      <details class="ud-watch-details" open>
        <summary class="ud-watch-summary">
          <div class="ud-watch-summary-row">
            <span class="ud-watch-summary-h">
              <span class="l-en">{{ _w_en[0] }}</span><span class="l-zh">{{ _w_zh[0] }}</span>
            </span>
            <span class="ud-watch-summary-ct tnum">3 <span class="l-en">conditions</span><span class="l-zh">项</span></span>
            <span class="ud-watch-summary-chev" aria-hidden="true">›</span>
          </div>
          <span class="ud-watch-summary-preview l-en">{{ _body_en }}</span>
          <span class="ud-watch-summary-preview l-zh">{{ _body_zh }}</span>
        </summary>
        <ul class="ud-watch-list">
          {%- for i in range(3) %}
          <li class="ud-watch-item">
            <span class="ud-watch-item-head l-en">{{ _w_en[i] }}</span>
            <span class="ud-watch-item-body l-en">{{ _body_en }}</span>
            <span class="ud-watch-item-head l-zh">{{ _w_zh[i] }}</span>
            <span class="ud-watch-item-body l-zh">{{ _body_zh }}</span>
          </li>
          {%- endfor %}
        </ul>
      </details>
      <p class="ud-spine-foot">
        <span class="l-en">Windows, not certainties — re-drawn nightly.</span>
        <span class="l-zh">是窗口，不是定论——每晚重新校准。</span>
      </p>
    </div>

    {# === 6 · Go deeper (spec §6) — chip rail for #29 / #30 / #18 / #54 === #}
    <div class="ud-deeper">
      <div class="mx-sec">
        <h3 class="l-en">Go deeper</h3><h3 class="l-zh">深入了解</h3>
      </div>
      <div class="ud-deeper-rail">
        <a class="ud-depth" href="macro_context.html"><span class="l-en">Macro weather</span><span class="l-zh">宏观气候</span></a>
        <a class="ud-depth" href="sector_central.html"><span class="l-en">Sector rotation</span><span class="l-zh">板块轮动</span></a>
        <a class="ud-depth" href="signal_lab.html"><span class="l-en">Signal Lab</span><span class="l-zh">信号实验室</span></a>
        <a class="ud-depth" href="macro_signals.html"><span class="l-en">Macro signals</span><span class="l-zh">宏观信号</span></a>
        <a class="ud-depth" href="news.html"><span class="l-en">News feed</span><span class="l-zh">新闻流</span></a>
        <a class="ud-depth" href="macro_monetary.html"><span class="l-en">Macro &amp; Monetary hub</span><span class="l-zh">宏观与货币中心</span></a>
      </div>
    </div>

    {# === Page footer (spec §6) === #}
    <footer class="ud-foot">
      <span class="l-en">Re-drawn nightly. Windows and stances are our read of the evidence, not advice.</span>
      <span class="l-zh">每晚重新校准。窗口与立场是我们对证据的判读，不构成投资建议。</span>
    </footer>

  </div>
</section>

{% if ud_international|default(false) %}
<script>
(function(){
  var hero=document.getElementById('ud-hero');
  if(hero&&window.matchMedia&&window.matchMedia('(max-width:640px)').matches){
    hero.querySelectorAll('.ud-watch-details[open]').forEach(function(d){d.removeAttribute('open');});
  }
})();
</script>
{% endif %}
