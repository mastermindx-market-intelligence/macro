/* Risk Envelope: compact context inside the existing Risk Radar, never a page panel.
   Dark: subtle luminance inset. Light: quiet structured inset with a hairline, no glow. */
#dlg-risk .riskdlg-context {
  margin-top:12px; padding:12px 16px;
  border:1px solid var(--line); border-radius:var(--r-card);
  background:var(--panel2); color:var(--ink-2);
}
html[data-theme="light"] #dlg-risk .riskdlg-context {
  background:color-mix(in srgb,var(--panel2) 60%,var(--panel));
  box-shadow:none;
}
#dlg-risk .gde-head {display:flex; align-items:baseline; justify-content:space-between; gap:8px; flex-wrap:wrap;}
#dlg-risk .gde-head h3 {margin:0; font-size:var(--fs-sm); font-weight:650; color:var(--ink-1);}
#dlg-risk .gde-coherence {font-size:var(--fs-label); color:var(--ink-2);}
#dlg-risk .gde-reads {display:flex; gap:20px; flex-wrap:wrap; margin-top:8px;}
#dlg-risk .gde-read {display:flex; align-items:baseline; gap:8px;}
#dlg-risk .gde-q {font-size:var(--fs-label); color:var(--ink-3);}
#dlg-risk .gde-a {font-size:var(--fs-md); font-weight:650; color:var(--gde-c);}
#dlg-risk .gde-arr {font-size:var(--fs-label); margin-left:4px;}
#dlg-risk .gde-context-line {margin:8px 0 0; font-size:var(--fs-sm); line-height:1.45;}
#dlg-risk .gde-meta {display:flex; flex-wrap:wrap; gap:8px 12px; margin-top:8px; font-size:var(--fs-label); color:var(--ink-3);}
#dlg-risk .gde-meta [hidden], #dlg-risk .gde-receipt[hidden] {display:none;}
#dlg-risk .gde-prob-evidence {color:var(--ink-2); font-variant-numeric:tabular-nums;}
#dlg-risk .gde-prob-evidence .gde-prob-k {font-weight:650; color:var(--ink-1);}
#dlg-risk .gde-prob-evidence.is-thin, #dlg-risk .gde-prob-evidence.is-thin .gde-prob-k {color:var(--ink-warn);}
#dlg-risk .gde-stamp-live, #dlg-risk .gde-pending {color:var(--ink-2);}
#dlg-risk .gde-disc {margin-top:4px;}
#dlg-risk .gde-disc > summary {cursor:pointer; min-height:40px; align-content:center; font-size:var(--fs-label); color:var(--ink-2);}
#dlg-risk .gde-disc > summary:focus-visible {outline:2px solid var(--link); outline-offset:2px; border-radius:var(--r-ctl);}
#dlg-risk .gde-disc-body {padding-top:8px; border-top:1px solid var(--line);}
#dlg-risk .gde-tblwrap {max-width:100%; overflow-x:auto;}
#dlg-risk .gde-tbl {width:100%; border-collapse:collapse; font-size:var(--fs-label);}
#dlg-risk .gde-tbl th, #dlg-risk .gde-tbl td {padding:8px; text-align:left; border-bottom:1px solid var(--line); vertical-align:top;}
#dlg-risk .gde-tbl th {color:var(--ink-2); font-weight:600;}
#dlg-risk .gde-tbl td {color:var(--ink-1);}
#dlg-risk .gde-warn {color:var(--ink-warn);}
#dlg-risk .gde-req {color:var(--ink-3);}
#dlg-risk .gde-disc-h {font-size:var(--fs-sm); font-weight:600; margin:12px 0 4px;}
#dlg-risk .gde-conflicts {padding-left:16px; margin:0; font-size:var(--fs-label); line-height:1.5;}
#dlg-risk .gde-receipt, #dlg-risk .gde-policy {font-size:var(--fs-label); line-height:1.5; color:var(--ink-3); overflow-wrap:anywhere; margin:8px 0 0;}
@media(max-width:640px) {
  #dlg-risk .riskdlg-context {padding:12px;}
  #dlg-risk .gde-reads {gap:8px 16px;}
  #dlg-risk .gde-tbl {min-width:460px;}
}

/* The legacy band must not impose its rails or large spacing inside Risk Radar. */
#dlg-risk .gde-head {border:0; padding:0; margin:0;}
#dlg-risk .gde-read {border:0; padding:0; margin:0;}
#dlg-risk .gde-disc > summary {display:flex; gap:6px; align-items:center; padding:0;}
#dlg-risk .gde-disc > summary::before {content:"+";}
#dlg-risk .gde-disc[open] > summary::before {content:"−";}

/* The existing button carries a separate stress caveat, never a changed radar score. */
#mx5BtnRisk {max-width:100%; flex-wrap:wrap;}
#mx5BtnRisk .gde-button-context {border-left:1px solid var(--line); padding-left:6px; white-space:normal;}
.gde-button-context[data-gde-stage="FRAGILE"] {color:var(--ink-warn);}
.gde-button-context[data-gde-stage="TRANSMITTING"], .gde-button-context[data-gde-stage="BREAKDOWN"] {color:var(--ink-act);}
#mx5BtnRisk .gde-button-context[hidden], #dlg-risk .gde-live-reading[hidden], #dlg-risk .gde-input-caveat[hidden] {display:none;}
#dlg-risk .gde-causes {margin:8px 0 0; font-size:var(--fs-sm); line-height:1.45; color:var(--ink-1);}
#dlg-risk .gde-input-caveat {margin:4px 0 0; font-size:var(--fs-label); color:var(--ink-warn);}
#dlg-risk .gde-live-reading {display:flex; gap:4px 10px; flex-wrap:wrap; margin-top:8px; font-size:var(--fs-sm); line-height:1.4;}
#dlg-risk .gde-live-reading strong {font-weight:650; color:var(--ink-1);}
#dlg-risk .gde-live-reading > span {color:var(--ink-2);}

#dlg-risk .gde-live-source-rows {white-space:pre-line; font-size:var(--fs-label); line-height:1.6; overflow-wrap:anywhere;}
#dlg-risk #gde-live-sources[hidden] {display:none;}

/* ── EW-P4.T1 descriptive early-warning observation (consumer-only). Chairman
   2026-10-18 rule: even one-piece borders on ALL four sides, neutral or
   surface-warn-subtle backgrounds from tokens, no edge stripe / accent rail /
   inset shadow bar; state carried by text + ink color, never color alone. ── */
#dlg-risk .gde-scope {font-size:var(--fs-label); color:var(--ink-3);}
#dlg-risk .gde-ew {margin-top:8px; padding:10px 12px; border:1px solid var(--line); border-radius:var(--r-card); background:var(--esurf-neutral-soft); overflow-wrap:anywhere;}
#dlg-risk .gde-ew[data-ew-state="stale"],
#dlg-risk .gde-ew[data-ew-state="unavailable"],
#dlg-risk .gde-ew[data-ew-state="unreadable"],
#dlg-risk .gde-ew[data-ew-state="withdrawn"],
#dlg-risk .gde-ew[data-ew-state="partial"],
#dlg-risk .gde-ew[data-ew-state="conflicting"] {background:var(--surface-warn-subtle);}
#dlg-risk .gde-ew-head {margin:0; display:flex; gap:8px; align-items:baseline; flex-wrap:wrap; font-size:var(--fs-sm); color:var(--ink-1);}
#dlg-risk .gde-ew-scope {font-weight:600;}
#dlg-risk .gde-ew-state {font-weight:600; color:var(--text);}
#dlg-risk .gde-ew[data-ew-state="stale"] .gde-ew-state,
#dlg-risk .gde-ew[data-ew-state="unavailable"] .gde-ew-state,
#dlg-risk .gde-ew[data-ew-state="unreadable"] .gde-ew-state,
#dlg-risk .gde-ew[data-ew-state="withdrawn"] .gde-ew-state,
#dlg-risk .gde-ew[data-ew-state="partial"] .gde-ew-state,
#dlg-risk .gde-ew[data-ew-state="conflicting"] .gde-ew-state {color:var(--ink-warn);}
#dlg-risk .gde-ew[data-ew-state="corrected"] .gde-ew-state {color:var(--ink-info);}
#dlg-risk .gde-ew-what {margin:6px 0 0; font-size:var(--fs-sm); line-height:1.45; color:var(--ink-1);}
#dlg-risk .gde-ew-note {margin:4px 0 0; font-size:var(--fs-label); color:var(--ink-2);}
#dlg-risk .gde-ew-when {margin:4px 0 0; font-size:var(--fs-label); color:var(--ink-3);}
#dlg-risk .gde-ew-built {color:var(--muted); font-size:var(--fs-label);}
#dlg-risk .gde-ew-means {margin:4px 0 0; font-size:var(--fs-label); color:var(--ink-3);}
#dlg-risk .gde-ew-next {display:inline-block; margin-top:6px; font-size:var(--fs-label); color:var(--link);}
#dlg-risk .gde-ew-next:focus-visible, #dlg-risk .gde-ew-study > summary:focus-visible {outline:2px solid var(--link); outline-offset:2px; border-radius:var(--r-ctl);}
#dlg-risk .gde-ew-brief-h {margin-top:4px;}
#dlg-risk .gde-ew-tablewrap {margin-top:8px; max-width:100%;}
#dlg-risk .gde-ew-legs {width:100%; border-collapse:collapse; font-size:var(--fs-label);}
#dlg-risk .gde-ew-legs caption {caption-side:top; text-align:left; padding:0 8px 4px; color:var(--ink-3); font-size:var(--fs-label);}
#dlg-risk .gde-ew-legs th, #dlg-risk .gde-ew-legs td {padding:6px 8px; text-align:left; border-bottom:1px solid var(--line); vertical-align:top; overflow-wrap:anywhere;}
#dlg-risk .gde-ew-legs th {color:var(--ink-2); font-weight:600;}
#dlg-risk .gde-ew-legs td {color:var(--ink-1); font-variant-numeric:tabular-nums;}
#dlg-risk .gde-ew-contextline {margin:6px 0 0; font-size:var(--fs-sm); line-height:1.45;}
#dlg-risk .gde-ew-horizons {display:flex; gap:10px; flex-wrap:wrap; margin-top:8px;}
#dlg-risk .gde-ew-hz {flex:1 1 150px; min-width:0; border:1px solid var(--line); border-radius:var(--r-ctl); padding:8px 10px; font-size:var(--fs-label); color:var(--ink-2); display:flex; gap:6px 10px; align-items:baseline; flex-wrap:wrap;}
#dlg-risk .gde-ew-hz-k {font-weight:600; color:var(--ink-1);}
#dlg-risk .gde-ew-hz-v {font-size:var(--fs-md); font-weight:650; color:var(--ink-1);}
#dlg-risk .gde-ew-hz-q {color:var(--ink-3);}
#dlg-risk .gde-ew-against {padding-left:16px; margin:0; font-size:var(--fs-label); line-height:1.5; color:var(--ink-2);}
#dlg-risk .gde-ew-study {margin-top:10px; font-size:var(--fs-label);}
#dlg-risk .gde-ew-study > summary {cursor:pointer; min-height:32px; align-content:center; color:var(--ink-2);}
#dlg-risk .gde-ew-dl {margin:4px 0 0;}
#dlg-risk .gde-ew-dl > div {display:flex; gap:4px 12px; flex-wrap:wrap; padding:5px 0; border-bottom:1px solid var(--line);}
#dlg-risk .gde-ew-dl dt {flex:0 0 auto; color:var(--ink-3); font-weight:600;}
#dlg-risk .gde-ew-dl dd {margin:0; min-width:0; flex:1 1 120px; color:var(--ink-1); overflow-wrap:anywhere;}
#dlg-risk .gde-ew-id {user-select:all;}
@media(max-width:640px) {
  #dlg-risk .gde-ew {padding:10px;}
  #dlg-risk .gde-ew-horizons {flex-direction:column;}
  #dlg-risk .gde-ew-hz {flex-basis:100%;}
  #dlg-risk .gde-ew-legs th, #dlg-risk .gde-ew-legs td {display:block; width:100%; box-sizing:border-box; border-bottom:none; padding:2px 8px;}
  #dlg-risk .gde-ew-legs tr {display:block; border-bottom:1px solid var(--line); padding:4px 0;}
  #dlg-risk .gde-ew-legs {border-bottom:1px solid var(--line);}
}
