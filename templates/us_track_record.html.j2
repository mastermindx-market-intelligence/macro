<script>
// Inline sparkline charts from embedded JSON — no chart libraries.
// Draws win-rate line + 50% reference on a small SVG canvas.
(function(){
  var seriesH5 = {{ chart_series_h5_json|safe }};
  var seriesH10 = {{ chart_series_h10_json|safe }};

  function drawChart(svgId, series, color) {
    var svg = document.getElementById(svgId);
    if (!svg || !series || series.length < 2) return;
    var W = 800, H = 160, PAD = 20;
    var vals = series.map(function(d){ return d.win_rate; });
    // Draw 50% reference line
    var y50 = H - PAD - (0.5) * (H - PAD * 2);
    var dashed = document.createElementNS('http://www.w3.org/2000/svg','line');
    dashed.setAttribute('x1', PAD); dashed.setAttribute('y1', y50);
    dashed.setAttribute('x2', W - PAD); dashed.setAttribute('y2', y50);
    dashed.setAttribute('stroke', 'var(--muted)');
    dashed.setAttribute('stroke-width', '1');
    dashed.setAttribute('stroke-dasharray', '4 4');
    svg.appendChild(dashed);
    // Draw win-rate line
    var n = vals.length;
    var xStep = (W - PAD * 2) / Math.max(n - 1, 1);
    var pts = vals.map(function(v, i){
      var x = PAD + i * xStep;
      var y = H - PAD - Math.max(0, Math.min(1, v)) * (H - PAD * 2);
      return x.toFixed(1) + ',' + y.toFixed(1);
    });
    var poly = document.createElementNS('http://www.w3.org/2000/svg','polyline');
    poly.setAttribute('points', pts.join(' '));
    poly.setAttribute('fill', 'none');
    poly.setAttribute('stroke', color);
    poly.setAttribute('stroke-width', '2');
    poly.setAttribute('stroke-linejoin', 'round');
    svg.appendChild(poly);
    // Dots
    vals.forEach(function(v, i){
      var x = PAD + i * xStep;
      var y = H - PAD - Math.max(0, Math.min(1, v)) * (H - PAD * 2);
      var wr = Math.round(v * 100);
      var c = document.createElementNS('http://www.w3.org/2000/svg','circle');
      c.setAttribute('cx', x.toFixed(1));
      c.setAttribute('cy', y.toFixed(1));
      c.setAttribute('r', '4');
      c.setAttribute('fill', color);
      c.setAttribute('opacity', '0.85');
      c.setAttribute('title', series[i].week + ': ' + wr + '% (' + series[i].raw_n + ' names)');
      svg.appendChild(c);
    });
  }

  var upColor = getComputedStyle(document.documentElement).getPropertyValue('--up').trim() || '#34d17a';
  var lnkColor = getComputedStyle(document.documentElement).getPropertyValue('--link').trim() || '#4c8bf5';
  drawChart('chart-h5', seriesH5, upColor);
  drawChart('chart-h10', seriesH10, lnkColor);
})();
</script>
</body>
</html>
