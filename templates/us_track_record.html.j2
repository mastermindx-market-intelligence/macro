<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{#
  US Track Record — Prophet W1 depth page.
  Spec: research/PROPHET_MASTERPLAN_BY_FABLE.md §PR-R9.
  Data: site/factordata/us_track_history.json (builder: scripts/build_track_record_page.py)
        site/factordata/us_board_track.json
        site/factordata/us_board_outcomes.json
        site/factordata/us_audit_scoreboard.json
  Authority: display_only, accruing. No scoring / promotion here.
  The word "validated" never appears (CI-guarded).
  Design: Tier-3 depth page; top-of-page header follows Tier-1 rules (docs/DESIGN_DOCTRINE.md).
#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>try{var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',t||'dark');var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>US Buy Board — Track Record</title>
{% set seo_title = "US Buy Board — Track Record — Mastermind" %}{% set seo_desc = "The full record of US buy-board calls — every entry, how it played out, and what the numbers say about signal quality." %}{% set seo_path = "us_track_record.html" %}
{% include "_seo_head.html.j2" %}
<link rel="stylesheet" href="theme.css">
<style>
  *{box-sizing:border-box}
  body{margin:0;padding-top:24px;background:var(--bg);color:var(--text);font-family:var(--font-ui);font-size:14px;line-height:1.5}
  a{text-decoration:none;color:inherit}
  .tr-wrap{max-width:1200px;margin:0 auto;padding:0 20px 80px}

  /* ── page header ── */
  .tr-hd{padding:18px 0 14px}
  .tr-back{font-size:12px;color:var(--ink-link, var(--link));display:inline-flex;align-items:center;gap:4px;margin-bottom:10px}
  .tr-back:hover{opacity:.8}
  .tr-eyebrow{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin:0 0 4px}
  .tr-title{font-size:clamp(22px,3vw,30px);font-weight:800;letter-spacing:-.02em;margin:0 0 6px}
  .tr-sub{color:var(--muted);font-size:13px;max-width:80ch;margin:0 0 4px}
  .tr-asof{color:var(--muted);font-size:12px}

  /* ── glance hero card ── */
  .tr-hero{display:flex;flex-wrap:wrap;gap:16px;margin:20px 0 28px;
    padding:18px 20px;border:1px solid var(--line);border-radius:14px;background:var(--panel)}
  .tr-hero-stat{display:flex;flex-direction:column;gap:2px;min-width:120px}
  .tr-hero-stat .val{font-size:28px;font-weight:800;letter-spacing:-.02em}
  .tr-hero-stat .lbl{font-size:12px;color:var(--muted);font-weight:600}
  .tr-hero-stat.up .val{color:var(--ink-up, var(--up))}
  .tr-hero-stat.dn .val{color:var(--ink-down, var(--down))}
  .tr-hero-divider{width:1px;background:var(--line);align-self:stretch}
  .tr-hero-stance{flex:1;min-width:220px}
  .tr-hero-stance .stance-main{font-size:14.5px;font-weight:700;line-height:1.5}
  .tr-hero-stance .stance-sub{font-size:12.5px;color:var(--muted);margin-top:4px}
  /* ── measurement-change comparison (era break, 2026-08-07) ──────────────────
     Two readings of the SAME trades, so the visual job is the opposite of the
     hero's: invite comparison, refuse a verdict. Three rules follow from that —
       1. the "before" column is muted with a hairline rail, NOT struck through.
          A strikethrough reads as retracted, and these numbers were never wrong;
          they were measured on a grid that moved. The visual must not contradict
          the sentence above it;
       2. neither column takes .val's 28px or the up/down inks — the hero above
          still owns the headline, and colouring a comparison turns a measurement
          note into a performance claim;
       3. one plain sentence carries the reason, and a second says how much of the
          move is simply more trades finishing. Without it a reader reads the whole
          drop as the measurement change, which is false. */
  /* background is var(--panel) FLAT, not a muted wash over it. The wash reads fine on
     dark (panel #181b21 lifts off canvas #0f1115) but in light it lands on
     rgb(247,248,250) — the page canvas itself — so the whole block dissolved into the
     page while the hero above it stayed white. That is the panel≈bg flatness bug the
     doctrine names (§5.8). The block still reads quieter than the hero, but through
     type and the rail, not through a background that only works in one theme. */
  .tr-basis{margin:-8px 0 26px;padding:16px 18px;border:1px solid var(--line);
    border-left:3px solid color-mix(in srgb,var(--muted) 45%,transparent);
    border-radius:12px;background:var(--panel)}
  .tr-basis-hd{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 10px;margin-bottom:8px}
  .tr-basis-tag{font-size:10.5px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;
    color:var(--muted)}
  .tr-basis-dt{font-size:11.5px;color:var(--muted);font-variant-numeric:tabular-nums}
  .tr-basis-line{margin:0 0 14px;font-size:12.5px;line-height:1.55;color:var(--text);max-width:80ch}
  .tr-basis-cmp{display:flex;flex-wrap:wrap;gap:10px 28px;align-items:flex-start}
  .tr-basis-col{min-width:170px;padding-left:11px;
    border-left:1px solid color-mix(in srgb,var(--muted) 30%,transparent)}
  .tr-basis-col-k{font-size:11px;font-weight:700;color:var(--muted);margin-bottom:5px}
  .tr-basis-row{display:flex;justify-content:space-between;gap:14px;font-size:13px;line-height:1.75}
  .tr-basis-row .n{font-weight:700;font-variant-numeric:tabular-nums}
  .tr-basis-row .w{color:var(--muted);font-size:12px}
  .tr-basis-then{color:var(--muted)}
  .tr-basis-ft{margin:12px 0 0;font-size:11.5px;line-height:1.5;color:var(--muted);max-width:80ch}
  @media (max-width:560px){ .tr-basis-cmp{gap:14px} .tr-basis-col{min-width:0;flex:1 1 140px} }

  .accruing-chip{display:inline-block;font-size:10px;font-weight:700;padding:2px 8px;border-radius:6px;
    border:1px solid color-mix(in srgb,var(--warn) 50%,var(--line));
    color:var(--ink-warn, var(--warn));background:color-mix(in srgb,var(--warn) 10%,transparent);
    margin-left:6px;vertical-align:middle}

  /* ── section headers ── */
  .tr-section{margin-top:32px;padding-top:24px;border-top:1px solid var(--line)}
  .tr-section:first-of-type{border-top:none;margin-top:0;padding-top:0}
  .tr-section-hd{font-size:15px;font-weight:750;margin:0 0 4px}
  .tr-section-sub{font-size:12.5px;color:var(--muted);margin:0 0 14px;max-width:72ch}

  /* ── chart canvas ── */
  .tr-chart-wrap{position:relative;width:100%;height:160px;margin:0 0 8px;
    border:1px solid var(--line);border-radius:10px;background:var(--panel);overflow:hidden}
  .tr-chart-wrap svg{position:absolute;inset:0;width:100%;height:100%}
  .tr-chart-legend{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:16px;font-size:11.5px;color:var(--muted)}
  .tr-chart-legend span{display:flex;align-items:center;gap:5px}
  .tr-chart-legend .dot{width:10px;height:10px;border-radius:50%}
  .chart-accruing{display:flex;align-items:center;justify-content:center;
    height:160px;border:1px solid var(--line);border-radius:10px;background:var(--panel);
    color:var(--muted);font-size:13px;font-style:italic;margin-bottom:8px}

  /* ── horizon ladder table ── */
  .tbl-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
  table.tr-tbl{width:100%;border-collapse:collapse;font-size:12.5px;font-variant-numeric:tabular-nums;white-space:nowrap}
  table.tr-tbl th{text-align:right;padding:7px 10px;border-bottom:1.5px solid var(--line);
    color:var(--muted);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.04em}
  table.tr-tbl th:first-child{text-align:left}
  table.tr-tbl td{text-align:right;padding:7px 10px;border-bottom:1px solid var(--line)}
  table.tr-tbl td:first-child{text-align:left;font-weight:700}
  table.tr-tbl tr:last-child td{border-bottom:none}
  .pos{color:var(--ink-up, var(--up))} .neg{color:var(--ink-down, var(--down))} .neu{color:var(--muted)}
  .ci-range{font-size:10.5px;color:var(--muted)}
  .n-col{font-size:11px;color:var(--muted)}

  /* ── outcomes table ── */
  table.tr-out-tbl{width:100%;border-collapse:collapse;font-size:12.5px;font-variant-numeric:tabular-nums}
  table.tr-out-tbl th{text-align:right;padding:6px 9px;border-bottom:1.5px solid var(--line);
    color:var(--muted);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.04em}
  table.tr-out-tbl th:first-child{text-align:left}
  table.tr-out-tbl td{text-align:right;padding:6px 9px;border-bottom:1px solid var(--line)}
  table.tr-out-tbl td:first-child{text-align:left}
  table.tr-out-tbl td.tk-cell{font-weight:700}
  table.tr-out-tbl tr:last-child td{border-bottom:none}
  .oc-dot{display:inline-block;width:8px;height:8px;border-radius:50%;vertical-align:middle}
  .oc-dot.running{background:var(--up)}
  .oc-dot.stopped{background:var(--down)}
  .oc-dot.flat{background:var(--muted)}
  .autopsy-col{color:var(--muted);font-size:11px}

  /* ── coverage / loss ledger cards ── */
  .tr-row-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:0 0 14px}
  @media(max-width:620px){.tr-row-grid{grid-template-columns:1fr}}
  .tr-card{border:1px solid var(--line);border-radius:12px;padding:14px 16px;background:var(--panel)}
  .tr-card-title{font-size:12.5px;font-weight:700;margin:0 0 8px}
  .tr-card-val{font-size:22px;font-weight:800;letter-spacing:-.02em}
  .tr-card-sub{font-size:11.5px;color:var(--muted);margin-top:3px}
  .tr-gap-note{font-size:12px;color:var(--muted);font-style:italic;padding:10px 0 0}

  /* ── accrual clock banner ── */
  .tr-clock{display:flex;align-items:flex-start;gap:10px;padding:12px 15px;
    border:1.5px solid color-mix(in srgb,var(--warn) 40%,var(--line));
    border-radius:10px;background:color-mix(in srgb,var(--warn) 6%,var(--panel));
    margin-bottom:16px;font-size:12.5px}
  .tr-clock-icon{font-size:18px;flex-shrink:0;margin-top:1px}
  .tr-clock-body{color:var(--muted)}
  .tr-clock-body b{color:var(--text)}

  /* ── disclosure footnote ── */
  .tr-footnote{font-size:11.5px;color:var(--muted);border-top:1px solid var(--line);
    padding-top:14px;margin-top:28px;max-width:90ch;line-height:1.65}
  .tr-footnote b{color:var(--text)}

  /* ── data-gap placeholder ── */
  .tr-gap-block{padding:18px;border:1px dashed var(--line);border-radius:10px;
    background:color-mix(in srgb,var(--muted) 4%,var(--panel));color:var(--muted);
    font-size:12.5px;font-style:italic;text-align:center}
</style>
</head>
<body>
<div class="tr-wrap">

  <!-- ── Back link + page header ── -->
  <div class="tr-hd">
    <a class="tr-back" href="us_stocks.html">← <span class="l-en">Buy Board</span><span class="l-zh">买入榜</span></a>
    <div class="tr-eyebrow">{{ t('US Buy Board', '美股买入榜') }}</div>
    <h1 class="tr-title">{{ t('Track Record', '往绩记录') }}</h1>
    <p class="tr-sub">{{ t('How names that left the buy board have performed since they were first surfaced — updated each night.', '离开买入榜的标的自首次上榜以来的表现——每晚更新。') }}</p>
    <div class="tr-asof">{{ t('as of', '截至') }} {{ outcomes_as_of }}{% if cohort_accruing %} <span class="accruing-chip">{{ t('ACCRUING', '积累中') }}</span>{% endif %}</div>
  </div>

  <!-- ── Section 1: Glance hero ── -->
  <div class="tr-hero">
    {% if win_rate_pct is not none %}
    <div class="tr-hero-stat up">
      <span class="val">{{ win_rate_pct|round|int }}%</span>
      <span class="lbl">{{ t('of finished trades made money', '已完成交易中盈利占比') }}</span>
    </div>
    <div class="tr-hero-divider"></div>
    {% if avg_pct is not none %}
    <div class="tr-hero-stat {{ 'up' if avg_pct > 0 else 'dn' if avg_pct < 0 else '' }}">
      <span class="val">{{ '%+.1f'|format(avg_pct) }}%</span>
      <span class="lbl">{{ t('average trade', '每笔平均') }}</span>
    </div>
    <div class="tr-hero-divider"></div>
    {% endif %}
    {% if n_outcomes is not none %}
    <div class="tr-hero-stat">
      <span class="val">{{ n_outcomes }}</span>
      <span class="lbl">{{ t('finished trades', '已完成交易') }}</span>
    </div>
    <div class="tr-hero-divider"></div>
    {% endif %}
    <div class="tr-hero-stance">
      <div class="stance-main">
        {#- Stance follows the INTERVAL. While the average-trade range still spans a
            loss, no win rate — however high — earns a following verdict. -#}
        {% if hero_ci and hero_ci[0] is not none and hero_ci[0] < 50 %}
        {% if win_rate_pct is not none and win_rate_pct < 50 %}
        {{ t('Fewer than half of finished trades made money so far — and on a record '
             'this short the honest range still reaches below a coin flip.',
             '目前已完成交易中盈利不足一半——且记录尚短，诚实的区间仍低于五五开。') }}
        {% else %}
        {{ t('More often right than wrong so far — but on a record this short the honest range still reaches below a coin flip.', '目前胜多于负——但记录尚短，诚实的区间仍低于五五开。') }}
        {% endif %}
        {% elif hero_exp_lo is defined and hero_exp_lo is not none and hero_exp_lo <= 0 %}
        {#- The interval governs, not the point estimate: while the honest range for what a
            trade returns still spans a loss, no win rate earns a following verdict. Same
            rule the Track-record dialog applies. -#}
        {{ t('More winners than losers so far — but the honest range for what a trade returns still reaches below zero. Watch, don\'t chase.', '目前盈多于亏——但单笔回报的诚实区间仍可能低于零。观察，勿追。') }}
        {% elif win_rate_pct is not none and win_rate_pct >= 55 %}
        {{ t('More winners than losers — watch, do not chase new entries.', '盈多于亏——观察，勿追新入场机会。') }}
        {% else %}
        {{ t('Watch — results accruing. Enough data to show direction but not enough for strong conclusions.', '观察——数据积累中。已有初步方向，但尚不足以得出明确结论。') }}
        {% endif %}
      </div>
      <div class="stance-sub">{{ t('Display-only context. These outcomes show past board members — not a return forecast.', '仅供展示参考。以上为历史上榜标的表现，不构成收益预测。') }}</div>
    </div>
    {% else %}
    <div class="tr-gap-block" style="flex:1">
      {{ t('Track record accruing — first board members surfaced in mid-June 2026.', '往绩积累中——买入榜首批标的于2026年6月中旬首次上榜。') }}
    </div>
    {% endif %}
  </div>
  {% if win_rate_pct is not none %}
  <p style="font-size:11.5px;color:var(--muted);margin:-12px 0 20px"><span class="l-en">Each pick is bought at the next session&#39;s close and sold {{ hero_horizon or 10 }} sessions later, or sooner if it runs hot or breaks its base.{% if hero_ci and hero_ci[0] is not none %} The win rate is likely between {{ hero_ci[0] }}% and {{ hero_ci[1] }}%{% if hero_board_days %} — {{ n_outcomes }} trades, but only {{ hero_board_days }} separate board days behind them{% endif %}.{% endif %}{% if hero_inflight %} {{ hero_inflight }} picks are still running and are not counted.{% endif %}</span><span class="l-zh">每个标的以次日收盘价买入，持有 {{ hero_horizon or 10 }} 个交易日后卖出；若提前冲高或跌破底部则提早离场。{% if hero_ci and hero_ci[0] is not none %}胜率大致介于 {{ hero_ci[0] }}% 与 {{ hero_ci[1] }}% 之间{% if hero_board_days %}——共 {{ n_outcomes }} 笔交易，但仅来自 {{ hero_board_days }} 个不同上榜日{% endif %}。{% endif %}{% if hero_inflight %} 另有 {{ hero_inflight }} 个标的仍在进行中，不计入。{% endif %}</span></p>
  {% endif %}

  {#- ── Measurement-change comparison (era break ruled 2026-08-07) ──────────────
      The record was re-measured on a corrected timeframe grid. Nothing pre-change is
      deleted: the previous headline sits beside the current one with the reason, so a
      reader who saw the old numbers can reconcile them. Glance-tier wording only — the
      grid, the anchor, and the attribution split live in
      reports/us_track_ledger_era_recompute_2026-08-07.md, not on this page. -#}
{% if prior_era is defined and prior_era and win_rate_pct is not none %}
  <div class="tr-basis">
    <div class="tr-basis-hd">
      <span class="tr-basis-tag">{{ t('Measurement updated', '计量方式已更新') }}</span>
      {% if era_from is defined and era_from %}<span class="tr-basis-dt">{{ era_from }}</span>{% endif %}
    </div>
    <p class="tr-basis-line"><span class="l-en">The timing used to decide when a trade is sold used to shift as older price history rolled out of our window — which moved the results of trades that had already closed. It no longer shifts. How picks are chosen, bought and sold has not changed.</span><span class="l-zh">判断卖出时点所用的时间刻度，过去会随着更早的价格数据滚出窗口而移动，令已经结束的交易的成绩也跟着改变。现在不会了。选股、买入和卖出的规则没有任何改动。</span></p>
    <div class="tr-basis-cmp">
      <div class="tr-basis-col tr-basis-then">
        <div class="tr-basis-col-k"><span class="l-en">Before · to {{ prior_era.as_of }}</span><span class="l-zh">此前 · 截至 {{ prior_era.as_of }}</span></div>
        <div class="tr-basis-row"><span class="w">{{ t('made money', '盈利占比') }}</span><span class="n">{{ prior_era.win_pct|round|int }}%</span></div>
        <div class="tr-basis-row"><span class="w">{{ t('average trade', '每笔平均') }}</span><span class="n">{{ '%+.1f'|format(prior_era.expectancy_pct) }}%</span></div>
        <div class="tr-basis-row"><span class="w">{{ t('finished trades', '已完成交易') }}</span><span class="n">{{ prior_era.n_matured }}</span></div>
      </div>
      <div class="tr-basis-col">
        <div class="tr-basis-col-k">{{ t('Now', '现在') }}</div>
        <div class="tr-basis-row"><span class="w">{{ t('made money', '盈利占比') }}</span><span class="n">{{ win_rate_pct|round|int }}%</span></div>
        <div class="tr-basis-row"><span class="w">{{ t('average trade', '每笔平均') }}</span><span class="n">{% if avg_pct is not none %}{{ '%+.1f'|format(avg_pct) }}%{% else %}—{% endif %}</span></div>
        <div class="tr-basis-row"><span class="w">{{ t('finished trades', '已完成交易') }}</span><span class="n">{{ n_outcomes if n_outcomes is not none else '—' }}</span></div>
      </div>
    </div>
{% if n_outcomes is not none and prior_era.n_matured is not none and n_outcomes != prior_era.n_matured %}
    <p class="tr-basis-ft"><span class="l-en">More than the measurement separates these two columns: {{ n_outcomes }} trades have finished now against {{ prior_era.n_matured }} on {{ prior_era.as_of }}, so part of the move is simply more results, not a different ruler.</span><span class="l-zh">两列之间的差异不止来自计量方式：现已走完 {{ n_outcomes }} 笔交易，而 {{ prior_era.as_of }} 时为 {{ prior_era.n_matured }} 笔，因此部分变化只是结果变多，并非换了尺子。</span></p>
{% endif %}
  </div>
{% endif %}

  <!-- ── Section 2: Record over time ── -->
  <div class="tr-section">
    <div class="tr-section-hd">{{ t('Weekly win rate over time', '每周胜率走势') }}</div>
    <div class="tr-section-sub">
      {{ t('Rolling win rate by entry cohort — share of names still above their surfacing price at the 5-day mark.', '按入场批次的滚动胜率——5日时点仍高于上榜价的标的占比。') }}
      <span class="accruing-chip">{{ t('ACCRUING', '积累中') }}</span>
    </div>

    <!-- Inline chart rendered by vanilla JS from embedded JSON -->
    <div class="tr-clock">
      <div class="tr-clock-icon">⏳</div>
      <div class="tr-clock-body">
        <b>{{ t('Trend verdicts unlock later.', '趋势判断稍后开放。') }}</b>
        {% set _en = clock_h21.effective_n if clock_h21 and clock_h21.raw_n else none %}
        {% if _en is not none and _en < 3 %}
        {% set _ck = '21-day grades so far come from only ' ~ _en %}
        {% set _ck = _ck ~ ' independent entry windows; a trend needs at least 3.' %}
        {% set _cz = '21日成绩目前仅来自' ~ _en ~ '个独立入场窗口；趋势判断至少需要3个。' %}
        {% elif _en is not none %}
        {% set _ck = '21-day grades come from ' ~ _en ~ ' independent entry windows.' %}
        {% set _cz = '21日成绩来自' ~ _en ~ '个独立入场窗口。' %}
        {% else %}
        {% set _ck = '21-day grades are still accruing.' %}
        {% set _cz = '21日成绩仍在积累中。' %}
        {% endif %}
        {{ t('First full 5-day report cards are already in — weekly trend unlocks once 4+ '
             'independent entry weeks have graded results. ' ~ _ck,
             '5日成绩单已陆续出炉——需累计4个以上独立入场周方可作出每周趋势判断。' ~ _cz) }}
