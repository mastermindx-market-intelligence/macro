{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% set ML = ['J','F','M','A','M','J','J','A','S','O','N','D'] %}
{% macro mosaic(win) -%}
{% set cm = (seas.now.month if seas.now is not none and seas.now else none) -%}
<table class="mosaic"><thead><tr><th class="mosf">{{ t('Factor','因子') }}</th>
{%- for m in range(1,13) %}<th class="mosh{{ ' curm' if m == cm else '' }}" data-m="{{ m }}">
{{- ML[m-1] }}</th>{% endfor %}</tr></thead><tbody>
{% for f in seas.factors %}<tr><td class="mosf">{{ t(f.label_en, f.label_zh) }}
{%- if f.context_only %} <span class="ctx">{{ t('ref','参考') }}</span>{% endif -%}
{%- if f.start %} <span class="muted sm">{{ t('since ' ~ f.start,
  '自 ' ~ f.start ~ ' 起') }}</span>{% endif %}</td>
{% for m in range(1,13) %}{% set s=(f[win] or {}).get(m) %}
{%- set c=' curm' if m == cm else '' %}
{%- if s %}{% set a=[(s.mean|abs)/3.0,0.82]|min %}{% set bg=('rgba(35,134,54,' ~ a|round(2) ~ ')')
  if s.mean>0 else ('rgba(218,54,51,' ~ a|round(2) ~ ')') %}
{%- set ttl=ML[m-1] ~ ' · mean ' ~ ('%+.2f'|format(s.mean)) ~ '% · median '
  ~ ('%+.2f'|format(s.median)) ~ '% · up ' ~ (s.hit|int) ~ '% (n=' ~ s.n ~ ')' -%}
<td class="mos{{ c }}" data-m="{{ m }}" style="background:{{ bg }}" title="{{ ttl }}"
><span class="mm">{{ '%+.1f'|format(s.mean) }}</span><span class="mh">{{ s.hit|int }}%</span></td>
{%- else %}<td class="mos muted{{ c }}" data-m="{{ m }}">·</td>{% endif -%}
{% endfor %}</tr>{% endfor %}
</tbody></table>
{%- endmacro %}
{% macro monthbars(stats) -%}
{% set vmax = (stats.values()|map(attribute='mean')|map('abs')|max) or 1 %}
<svg viewBox="0 0 360 100" class="seasbars" preserveAspectRatio="xMidYMid meet">
  <line x1="6" y1="44" x2="354" y2="44" stroke="var(--line)" stroke-width="1"/>
  {% for m in range(1,13) %}
  {% set cx = 6 + (348/12)*(m-0.5) %}
  <rect class="mcol" data-m="{{ m }}" x="{{ (cx-348/24)|round(1) }}" y="2" width="{{ (348/12)|round(1) }}" height="96" fill="var(--text)" opacity="0"></rect>
  {% set s = stats.get(m) %}
  {% if s %}
  {% set h = [(s.mean|abs)/vmax*34, 1.5]|max %}
  {% set up = s.mean >= 0 %}
  <rect x="{{ (cx-7)|round(1) }}" y="{{ (44-h)|round(1) if up else 44 }}" width="14" height="{{ h|round(1) }}" rx="1.5" fill="{{ 'var(--up)' if up else 'var(--down)' }}"><title>{{ ML[m-1] }} · mean {{ '%+.2f'|format(s.mean) }}% · median {{ '%+.2f'|format(s.median) }}% · up {{ s.hit }}% of years (n={{ s.n }})</title></rect>
  {% endif %}
  <text x="{{ cx|round(1) }}" y="94" text-anchor="middle" font-size="8" fill="var(--muted)">{{ ML[m-1] }}</text>
  {% endfor %}
</svg>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Factor seasonality — Ken French monthly factors</title>
{% set seo_title = "Factor Seasonality — Mastermind" %}{% set seo_desc = "Which equity factors work in which months — Ken French monthly factor data turned into a practical seasonal map." %}{% set seo_path = "seasonality.html" %}
{% include "_seo_head.html.j2" %}
<script>try{var th=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',th||'dark');var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,"Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body{ padding:26px max(40px,calc((100vw - 1320px)/2)); } }
  a { text-decoration:none; color:inherit; }
  h1 { font-size:20px; margin:0; }
  h2 { font-size:13px; margin:0 0 4px; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:14px 16px; margin-bottom:14px; }
  .topline { display:flex; flex-wrap:wrap; align-items:center; gap:12px; }
  .muted { color:var(--muted); } .sm { font-size:12px; }
  .seg button { font-size:12.5px; padding:5px 11px; border-radius:8px; border:1px solid var(--line); background:var(--panel2); color:var(--text); cursor:pointer; }
  .help { display:inline-flex; align-items:center; justify-content:center; width:15px; height:15px; border-radius:50%; border:1px solid var(--muted); color:var(--muted); font-size:10px; font-weight:600; cursor:help; position:relative; vertical-align:middle; margin-left:5px; }
  .help .tip { display:none; position:absolute; top:140%; left:50%; transform:translateX(-50%); width:300px; background:var(--panel); border:1px solid var(--line); padding:9px 11px; border-radius:8px; z-index:60; font-size:12px; line-height:1.45; color:var(--text); font-weight:400; box-shadow:var(--popover-shadow); pointer-events:auto; cursor:auto; max-height:min(60vh,420px); overflow-y:auto; overscroll-behavior:contain; }
  /* invisible hover pad across the icon→tip gap — keeps :hover alive mid-travel (on .help, not .tip: the tip is a scroll container and clips its pseudos) */
  .help:hover::before { content:''; position:absolute; top:100%; left:-30px; right:-30px; height:10px; }
  .help:hover .tip { display:block; }
  .seg { display:inline-flex; gap:0; border:1px solid var(--line); border-radius:8px; overflow:hidden; }
  .seg button { border:0; border-radius:0; background:var(--panel); }
  .seg button.on { background:var(--panel2); color:var(--text); font-weight:600; }
  .cardgrid { display:grid; grid-template-columns:repeat(auto-fill,minmax(330px,1fr)); gap:14px; }
  .fcard { background:var(--panel2); border:1px solid var(--line); border-radius:9px; padding:11px 12px; }
  .fcard h3 { font-size:13px; margin:0 0 6px; display:flex; align-items:center; gap:6px; }
  .fcard .badge { font-size:10.5px; padding:1px 7px; border-radius:8px; background:var(--panel); border:1px solid var(--line); color:var(--muted); }
  .ctx { font-size:10.5px; padding:1px 7px; border-radius:8px; background:transparent; border:1px dashed var(--line); color:var(--muted); }
  .seasbars { width:100%; height:auto; display:block; }
  .seasgrid[data-win="full"] .win-t30, .seasgrid[data-win="full"] .win-t10 { display:none; }
  .seasgrid[data-win="t30"] .win-full, .seasgrid[data-win="t30"] .win-t10 { display:none; }
  .seasgrid[data-win="t10"] .win-full, .seasgrid[data-win="t10"] .win-t30 { display:none; }
  .now-strip { display:flex; flex-wrap:wrap; align-items:flex-start; gap:14px; margin-bottom:14px; padding:12px 14px; background:var(--panel2); border:1px solid var(--line); border-radius:9px; }
  .now-hl { flex:1 1 auto; min-width:220px; }
  .now-hl .hl-text { font-size:14px; line-height:1.45; margin:0 0 5px; }
  .now-hl .stance { font-size:12px; color:var(--muted); margin:0; }
  .now-chip { font-size:11.5px; padding:3px 9px; border-radius:7px; background:var(--panel); border:1px solid var(--line); color:var(--muted); white-space:nowrap; align-self:flex-start; }
  .mosaic { border-collapse:separate; border-spacing:2px; font-size:11px; }
  .mosaic th { color:var(--muted); font-weight:500; padding:2px 6px; text-align:center; }
  .mosaic th.mosf, .mosaic td.mosf { text-align:left; white-space:nowrap; padding-right:12px; font-size:12.5px; }
  .mosaic td.mos { width:46px; height:38px; text-align:center; border-radius:5px; color:var(--text); cursor:default; }
  .mosaic td.mos .mm { display:block; font-size:12px; font-weight:600; font-variant-numeric:tabular-nums; }
  .mosaic td.mos .mh { display:block; font-size:9px; opacity:.75; }
  .mosaic td.mos.muted { background:var(--panel2); }
  .mosaic .curm { outline:2px solid var(--text); outline-offset:-2px; }
  .mosaic th.curm { outline:0; color:var(--text); font-weight:700; }
  .secthead { display:flex; align-items:baseline; gap:10px; margin:4px 0 8px; }
</style>
</head>
<body>
{% include "_site_nav.html.j2" %}

  <div class="panel">
    <div class="topline">
      <h1>{{ t('Factor seasonality', '因子季节性') }}</h1>
      <span class="muted sm">{{ t('which calendar months each factor style has tended to pay'
        ~ ' — Ken French monthly data, each row from its own start',
        '各因子风格在哪些月份历史上更易获得回报 — Ken French 月度数据，每行自各自起始年月计') }}</span>
    </div>
    <p class="muted sm" style="margin:6px 0 0">{{ t(seas.disclosure_en, seas.disclosure_zh) }}</p>
    <p class="muted sm" style="margin:6px 0 0"><a href="factors.html">← {{ t('Factors & seasonality overview', '因子与季节性概览') }}</a></p>
  </div>
{% if seas.now is not none and seas.now %}
  <div class="now-strip">
    <div class="now-hl">
      <p class="hl-text"><strong>{{ t(seas.now.month_label_en, seas.now.month_label_zh) }}</strong> · {{ t(seas.now.headline_en, seas.now.headline_zh) }}</p>
      <p class="stance">{{ t(seas.now.stance_en, seas.now.stance_zh) }}</p>
    </div>
    {% if seas.now.chip_en %}
    <span class="now-chip">{{ t(seas.now.chip_en, seas.now.chip_zh) }}</span>
    {% endif %}
  </div>
{% endif %}
{% if seas.now and seas.now.factors %}
{% set M = seas.now.month_label_en %}{% set Mz = seas.now.month_label_zh %}
  <div class="panel">
    <div class="secthead">
      <h2 style="margin:0">{{ t(M ~ ', style by style', Mz ~ ' · 逐个风格') }}
        {{ help("Each style's lean for this month by the page's own rule: tailwind = up in"
          ~ " at least 70% of years with a positive average; headwind = up in 40% or less"
          ~ " with a negative average; otherwise no clear lean. Graded on the last 10 years"
          ~ " when the month has at least 8 of them, else the last 30. Descriptive context"
          ~ " only, never part of a score.",
          '按本页规则给出各风格本月倾向：至少 70% 的年份上涨且平均为正记为偏强；'
          ~ '上涨年份不超过 40% 且平均为负记为偏弱；其余为无明显倾向。近 10 年样本'
          ~ '不少于 8 个时按近 10 年判定，否则按近 30 年。仅作描述性参考，不纳入任何评分。') }}
      </h2>
    </div>
    <div class="cardgrid">
    {% for f in seas.now.factors %}
      {% set st = f.y10 if f.window_used == 'trailing_10y' else f.y30 %}
      {% set sk = f.streak or {} %}{% set up = (sk.sign or 0) > 0 %}
      <div class="fcard">
        <h3>{{ t(f.plain_en, f.plain_zh) }} <span class="badge">
        {%- if f.verdict == 'tailwind' %}{{ t('Seasonal tailwind', '季节性偏强') }}
        {%- elif f.verdict == 'headwind' %}{{ t('Seasonal headwind', '季节性偏弱') }}
        {%- else %}{{ t('No clear seasonal lean', '无明显季节性倾向') }}{% endif -%}
        </span></h3>
        {% if st and st.n %}{% set avg = '%+.2f'|format(st.mean) %}
        <p class="muted sm" style="margin:0">{{ t('Graded on the last ' ~ st.n ~ ' ' ~ M
          ~ 's: average ' ~ avg ~ '%, up in ' ~ st.hit|int ~ '% of them', '按近 ' ~ st.n
          ~ ' 个' ~ Mz ~ '判定：平均 ' ~ avg ~ '%，其中 ' ~ st.hit|int ~ '% 上涨') }}</p>
        {% endif %}
        {% if sk.len and sk.sign %}
        <p class="muted sm" style="margin:4px 0 0">
        {%- if sk.len >= 2 %}{{ t(('Up ' if up else 'Down ') ~ sk.len ~ ' ' ~ M ~ 's in a row',
          '连续 ' ~ sk.len ~ ' 年' ~ Mz ~ ('上涨' if up else '下跌')) }}
        {%- else %}{{ t('Last ' ~ M ~ (': up' if up else ': down'),
          '上一个' ~ Mz ~ ('：上涨' if up else '：下跌')) }}{% endif -%}
        </p>
        {% endif %}
        {% if f.recent %}
        <details><summary class="muted sm">{{ t('The last ' ~ f.recent|length ~ ' ' ~ M
          ~ 's, year by year', '近 ' ~ f.recent|length ~ ' 个' ~ Mz ~ '逐年明细') }}</summary>
          <ul class="muted sm" style="margin:4px 0 0;padding-left:16px">
          {% for r in f.recent %}<li>{{ r.year }} {{ '%+.2f'|format(r.ret) }}%</li>{% endfor %}
          </ul>
        </details>
        {% endif %}
      </div>
    {% endfor %}
    </div>
  </div>
{% endif %}

  <div class="panel">
    <div class="secthead">
      <h2 style="margin:0">{{ t('Seasonality mosaic — mean return × hit-rate by month', '季节性矩阵 — 各月平均回报 × 命中率') }}
        {{ help("A factor × calendar-month grid. The big number is that month's average factor return across all years (green = positive, red = negative; deeper = larger); the small number is the hit-rate (% of years that month was positive). Hover any cell for mean, median, hit-rate and sample size. The current month column is outlined. Median + hit-rate matter because a single crisis month can swing a 30-year average.", '因子 × 日历月份网格。大数为该月历年平均因子回报（绿=正、红=负；越深越大）；小数为命中率（该月为正的年份比例）。悬停查看均值、中位数、命中率与样本量。当前月份列已描边。中位数与命中率很重要，因为单个危机月可大幅扭曲 30 年均值。') }}
      </h2>
      <span style="flex:1"></span>
      <span class="seg" id="winseg">
        <button data-win="t10" class="on">{{ t('Past 10 years', '近 10 年') }}</button>
        <button data-win="t30">{{ t('Trailing 30y', '近 30 年') }}</button>
        <button data-win="full">{{ t('Full history', '全历史') }}</button>
      </span>
    </div>
    <div class="seasgrid" data-win="t10" id="grid" style="overflow-x:auto">
      <div class="win win-t10">{{ mosaic('trailing_10y') }}</div>
      <div class="win win-t30">{{ mosaic('trailing_30y') }}</div>
      <div class="win win-full">{{ mosaic('full') }}</div>
    </div>
  </div>

  <div class="panel">
    <p class="muted" style="font-size:12px;margin:0">{{ t(
      'Source: ' ~ seas.source ~ ', as of ' ~ seas.as_of ~ '. Factors mapping to one of'
      ~ ' our live legs (Value→HML, Profitability→RMW, Investment→CMA) are shown first;'
      ~ ' Momentum, Size and Market are reference styles we do not rank cross-sectionally.'
      ~ ' Seasonality is descriptive context only and is deliberately kept out of every'
      ~ ' calibrated score.',
      '来源：' ~ seas.source ~ '，截至 ' ~ seas.as_of ~ '。映射到我们在用因子的（价值→HML、'
      ~ '盈利→RMW、投资→CMA）排在前面；动量、规模与市场为我们未做横截面排名的参考风格。'
      ~ '季节性仅为描述，刻意不纳入任何校准评分。') }}
      <a href="methodology.html#seasonality">{{ t('Methodology', '方法说明') }} →</a>
      {{ t('Generated', '生成于') }} {{ built }}</p>
  </div>

  <script>
    (function(){
      var seg=document.getElementById('winseg'), grid=document.getElementById('grid');
      if(seg&&grid) seg.addEventListener('click', function(e){
        var b=e.target.closest('button[data-win]'); if(!b) return;
        grid.setAttribute('data-win', b.dataset.win);
        seg.querySelectorAll('button').forEach(function(x){x.classList.toggle('on', x===b);});
      });
    })();
  </script>
  <script src="theme.js"></script>
</body>
</html>
