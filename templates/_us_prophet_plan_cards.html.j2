{#- US plan records: one immutable setup episode per row, not current recommendations.
   Both the public shell and entitled remainder render this same partial. The
   candidate population, historical order, plan ids and input objects are untouched.
   Current decisions belong to Candidates and the existing entry-availability owner.
   Attached stock-library identity is independent of current shortlist membership.
   record_only defends the shared renderer against accidentally passed action hints.
   Original priority/zone/creation are history; board_read.as_of is a SCREEN clock,
   not the build date, current quote, or management-evaluation timestamp. -#}
{% import "_prophet_card.html.j2" as pv %}
{%- set _LIFE_LABEL_EN = {'watch':'Watch','ready':'Ready','entered':'Entered','delivering':'Delivering','overtime':'Overtime','invalidated':'Invalidated','resolved':'Resolved'} -%}
{%- set _LIFE_LABEL_ZH = {'watch':'观察','ready':'就绪','entered':'入场','delivering':'达标','overtime':'超时','invalidated':'失效','resolved':'已结'} -%}
{% for p in items %}
{%- set _candidate = cand_map.get(p.asset) -%}
{%- set cand = _candidate if _candidate is mapping else {} -%}
{%- set _br = p.get('board_read') if p.get('board_read') is mapping else {} -%}
{%- set _fields = _br.get('fields') if _br.get('fields') is mapping else {} -%}
{%- set _name_field = _fields.get('name') if _fields.get('name') is mapping else {} -%}
{%- set _sector_field = _fields.get('sector') if _fields.get('sector') is mapping else {} -%}
{%- set _name = (_name_field.value|trim) if (_name_field.get('state') == 'available' and _name_field.get('value') is string) else '' -%}
{%- set _sector = (_sector_field.value|trim) if (_sector_field.get('state') == 'available' and _sector_field.get('value') is string) else '' -%}
{%- if not _name and cand.get('name') is string -%}{%- set _name = cand.name|trim -%}{%- endif -%}
{%- if not _sector and cand.get('sector') is string -%}{%- set _sector = cand.sector|trim -%}{%- endif -%}
{%- set _life = p.get('lifecycle_state') -%}
{%- set _ez = p.get('entry_zone') if p.get('entry_zone') is mapping else {} -%}
{%- set _lo = _ez.get('low') -%}
{%- set _hi = _ez.get('high') -%}
{%- set _zone_ok = _lo is number and _hi is number and _lo is not boolean and _hi is not boolean and _lo > 0 and _hi >= _lo and (_lo - _lo) == 0 and (_hi - _hi) == 0 -%}
{%- set _priority = p.get('_priority_score') -%}
{%- set _priority_txt = ('%.0f'|format(_priority)) if (_priority is number and _priority is not boolean and (_priority - _priority) == 0) else 'unavailable' -%}
{%- set _screen = _br.get('as_of') -%}
{%- set _screen_ok = _screen is string and _screen|length == 10 and _screen[4] == '-' and _screen[7] == '-' and _screen[:4].isdigit() and _screen[5:7].isdigit() and _screen[8:10].isdigit() and 1 <= _screen[5:7]|int <= 12 and 1 <= _screen[8:10]|int <= 31 -%}
{%- set _marks = namespace(rows=[{'k':'lane',
    'en': ('Last screen ' ~ _screen|e) if _screen_ok else 'Screen date unavailable',
    'zh': ('上次筛查 ' ~ _screen|e) if _screen_ok else '筛查日期暂缺'}]) -%}
{%- set _epi = episode_map.get(p.id) -%}
{%- if _epi -%}
  {%- set _marks.rows = _marks.rows + [{'k':'lane',
    'en': ('Episode ' ~ _epi.ep ~ (' · opened ' ~ _epi.dopen_en if _epi.get('dopen_en') else ''))|e,
    'zh': ('第 ' ~ _epi.ep ~ ' 轮' ~ (' · ' ~ _epi.dopen_zh ~ '启动' if _epi.get('dopen_zh') else ''))|e}] -%}
{%- endif -%}
{#- Packet 2: source-safe plan detail. Everything below already rides on the
   canonical plans[] row; no new fetch, identity join, management owner, or
   user-position state is introduced. The disclosure is collapsed by default. -#}
{%- set _rd_targets = p.get('targets') if p.get('targets') is sequence and p.get('targets') is not string else [] -%}
{#- Outcome history intentionally stays unavailable until the existing private
    effective-ledger producer (#7399) is accepted and wired by its consumer.
    This is presentation state only; it creates no history computation/store. -#}
{{ pv.pv_card({
  'record_only': true,
  'href': 'stock.html#' ~ p.asset, 'tk': p.asset|e, 'mkt': 'us', 'id': p.id,
  'name': _name|e if _name else 'Company name unavailable',
  'name_zh': _name|e if _name else '公司名称暂缺',
  'sec': _sector|e if _sector else none,
  'sec_zh': tr(_sector)|e if _sector else none,
  'verb': none, 'stance_basis': 'historical_plan',
  'stance_tip_en': ('Historical model setup, not a current entry instruction or your brokerage position. Original priority: ' ~ _priority_txt ~ '; saved when created, not a current rank. See Candidates for the latest screening read.')|e,
  'stance_tip_zh': ('历史模型计划，并非当前入场指令或您的实际持仓。建立时优先级：' ~ (_priority_txt if _priority_txt != 'unavailable' else '暂缺') ~ '；不是当前排名。最新筛查请查看候选。')|e,
  'spark': cand.get('spark_svg') if cand.get('spark_svg') is string else none,
  'zone_lo': ('$' ~ ('%.2f'|format(_lo))) if _zone_ok else none,
  'zone_hi': ('$' ~ ('%.2f'|format(_hi))) if _zone_ok else none,
  'date': p.get('plan_asof') or p.get('recorded_at'),
  'life': _life,
  'lifecycle': {'state': _life or 'unknown',
    'label_en': _LIFE_LABEL_EN.get(_life, 'State unavailable'),
    'label_zh': _LIFE_LABEL_ZH.get(_life, '状态暂缺'),
    'newer': (_epi.newer if _epi else none)},
  'marks': _marks.rows,
  'record_detail': {
    'plan_id': p.id,
    'created_date': p.get('plan_asof') or p.get('recorded_at'),
    'horizon_days': p.get('horizon_days'),
    'lifecycle_en': _LIFE_LABEL_EN.get(_life, 'State unavailable'),
    'lifecycle_zh': _LIFE_LABEL_ZH.get(_life, '状态暂缺'),
    'pulse_en': p.get('pulse') if p.get('pulse') is string else none,
    'pulse_zh': p.get('pulse_zh') if p.get('pulse_zh') is string else none,
    'entry': p.get('entry'),
    'invalidation': p.get('invalidation'),
    't1': (_rd_targets[0] if _rd_targets|length > 0 else none),
    't2': (_rd_targets[1] if _rd_targets|length > 1 else none),
    'action_unavailable': ('recommended_action' in p) and p.get('recommended_action') is none,
    'history_available': false,
    'management_available': p.get('management_status') == 'available' and not p.get('management_error')
  }
}, allow_no_read=true) }}
{% endfor %}
