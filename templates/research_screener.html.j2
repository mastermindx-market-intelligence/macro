{# =====================================================================
   Research screener v1 (B-F06-4 / MO-DELTA-002).

   Archetype: discovery_board. Answers "which names deserve a look first,
   and why" over owner-attributed security_state.v1 facts. Never a ranker.
   Default order is alphabetical by name. The only other order is next
   catalyst date. Theme lens has no owner — chip is disabled.
   ===================================================================== #}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% set rows = payload.rows if payload is defined and payload.rows is defined else [] %}
{% set nulls = payload.nulls if payload is defined and payload.nulls is defined else [] %}
{% set as_of = as_of if as_of is defined else (payload.as_of if payload is defined else none) %}
{% set n_names = rows|length %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>try{var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',t||'dark');var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>Research list{% if as_of %} — {{ as_of }}{% endif %} | MastermindX</title>
{# seo_title / seo_desc are EN-only meta tags. _seo_head.html.j2 renders them as
   plain text into <meta content=""> for social scrapers; it has no bilingual
   mechanism for seo vars. This is the documented exception (m4 META-CEO ruling
   h_7102_r2, 2026-09-19). #}
{% set seo_title = 'Research list — which names deserve a look first, and why' %}
{% set seo_desc = 'A research list of companies, ordered by name. Each line says why, and which panel produced that fact.' %}
{% set seo_path = 'research_screener.html' %}
{% include "_seo_head.html.j2" %}
<link rel="stylesheet" href="theme.css">
<link rel="stylesheet" href="research_screener.css">
</head>
<body class="page-research-screener">
{% include "_site_nav.html.j2" %}
<main class="rs" id="rs-main">
  <header class="rs-hero">
    <p class="rs-kicker">{{ t('Discovery', '发现') }}</p>
    <h1 class="rs-title">{{ t('Research list', '研究名单') }}</h1>
    <p class="rs-lead">{{ t("Which names deserve a look first, and why.", "哪些公司值得先看，以及原因。") }}</p>
    <p class="rs-note">{{ t('This is a reading list. It orders names alphabetically, or by the next estimated window. The catalyst lens keeps names whose next earnings window opens in about 30 trading days. Every line names a checkable fact and the record that produced it.', '这是一份阅读名单。按名称排列，或按下一项估计窗口排列。催化事项视角只保留下一份财报窗口大约 30 个交易日内开启的公司。每一行都写明一项可核对的事实，以及产生该事实的记录。') }}</p>
    <p class="rs-count">{% if n_names == 1 %}{{ t('1 name in this list.', '本名单共 1 家公司。') }}{% else %}{{ t('%s names in this list.'|format(n_names), '本名单共 %s 家公司。'|format(n_names)) }}{% endif %}{% if as_of %} <span class="rs-asof">{{ t('Data as of %s.'|format(as_of), '数据截至 %s。'|format(as_of)) }}</span>{% endif %}</p>
  </header>

  <div class="rs-toolbar">
    <div class="rs-chips" role="group" aria-label="Lenses · 视角">
      <button type="button" class="rs-chip is-disabled" disabled aria-disabled="true" data-lens="theme" aria-describedby="rs-theme-hint">{{ t('Theme', '主题') }}</button>
      <button type="button" class="rs-chip" data-lens="catalyst" aria-pressed="false">{{ t('Catalyst', '催化事项') }}</button>
      <button type="button" class="rs-chip" data-lens="exposure" aria-pressed="false">{{ t('Exposure', '持仓') }}</button>
      <button type="button" class="rs-chip" data-lens="valuation" aria-pressed="false">{{ t('Valuation posture', '估值姿态') }}</button>
    </div>
    <div class="rs-order" role="group" aria-label="Order · 排列方式">
      <span class="rs-order-label">{{ t('Order by', '排列方式') }}</span>
      <button type="button" class="rs-order-btn is-on" data-order="name" aria-pressed="true">{{ t('Name', '名称') }}</button>
      <button type="button" class="rs-order-btn" data-order="next_catalyst_date" aria-pressed="false">{{ t('Next estimated window', '下一项估计窗口') }}</button>
    </div>
  </div>

  <p class="rs-theme-null" id="rs-theme-hint" data-rs-theme-null>{{ t("Theme lens isn't available yet.", "主题视角尚未提供。") }}</p>
  <p class="rs-exposure-null" data-rs-exposure-null data-state="signedout" hidden><span class="l-en">Sign in to see which of these you hold.</span><span class="l-zh">登录后即可看到你持有其中哪些。</span> <a class="rs-portfolio-link" data-rs-portfolio-link href="watchlist.html" hidden><span class="l-en">Open Portfolio</span><span class="l-zh">打开投资组合</span></a></p>
  <p class="rs-empty" data-rs-empty hidden>{{ t('No names match these lenses right now.', '目前没有公司符合这些视角。') }}</p>

  <ol class="rs-list" data-rs-list>
    {% for row in rows %}
    <li class="rs-row"
        data-listing-key="{{ row.listing_key }}"
        data-ticker="{{ row.ticker }}"
        data-name="{{ row.name }}"
        data-catalyst-date="{{ row.catalyst.window_start if row.catalyst else '' }}"
        data-has-catalyst="{{ '1' if row.catalyst else '0' }}"
        data-has-valuation="{{ '1' if row.valuation_posture else '0' }}"
        data-has-exposure="0">
      <div class="rs-glance">
        <a class="rs-name" href="stocks/{{ row.ticker }}.html">{{ row.name }} <span class="rs-ticker">{{ row.ticker }}</span></a>
        <p class="rs-why">
          <span class="rs-why-text">
            <span class="l-en">{{ row.why_glance.en }}</span>
            <span class="l-zh">{{ row.why_glance.zh }}</span>
          </span>
          <span class="help" tabindex="0" role="button">?<span class="tip"><span class="l-en">{{ row.why.en }}</span><span class="l-zh">{{ row.why.zh }}</span></span></span>
        </p>
      </div>
      <details class="rs-receipt">
        <summary>{{ t('Receipt', '凭证') }}</summary>
        <ul>
          {% if row.catalyst %}
          <li><span class="l-en">{{ row.catalyst.window_label.en }}</span><span class="l-zh">{{ row.catalyst.window_label.zh }}</span> · <span class="l-en">{{ row.catalyst.tag.en }}</span><span class="l-zh">{{ row.catalyst.tag.zh }}</span> · <span class="l-en">{{ row.catalyst.owner.en }}</span><span class="l-zh">{{ row.catalyst.owner.zh }}</span></li>
          {% endif %}
          {% if row.valuation_posture %}
          <li><span class="l-en">{{ row.valuation_posture.label.en }}</span><span class="l-zh">{{ row.valuation_posture.label.zh }}</span> · <span class="l-en">{{ row.valuation_posture.assumptions_text.en }}</span><span class="l-zh">{{ row.valuation_posture.assumptions_text.zh }}</span> · <span class="l-en">{{ row.valuation_posture.owner.en }}</span><span class="l-zh">{{ row.valuation_posture.owner.zh }}</span></li>
          {% endif %}
          <li>{{ t("Theme lens isn't available yet.", "主题视角尚未提供。") }}</li>
          <li>{{ t('Full why', '完整原因') }} — <span class="l-en">{{ row.why.en }}</span><span class="l-zh">{{ row.why.zh }}</span></li>
          <li class="rs-hold-line" data-rs-hold hidden>{{ t('You hold this name.', '你持有这家公司。') }}</li>
        </ul>
        <p class="rs-more"><a href="stocks/{{ row.ticker }}.html">{{ t('Open the company page for the full technical read.', '打开公司页面查看完整技术细节。') }}</a></p>
      </details>
    </li>
    {% endfor %}
  </ol>
</main>
<script>
(function () {
  var list = document.querySelector("[data-rs-list]");
  if (!list) return;
  var rows = Array.prototype.slice.call(list.querySelectorAll(".rs-row"));
  var empty = document.querySelector("[data-rs-empty]");
  var exposureNull = document.querySelector("[data-rs-exposure-null]");
  var lenses = { catalyst: false, exposure: false, valuation: false };
  var order = "name";

  /* ---- Exposure integrity (B-F06-4 repair) ------------------------------
     An MDXAuth session alone is NOT authority for "you hold this".
     WatchStore's init is deliberately dormant without a sync host, and its
     public portfolio.list() then answers with the ANONYMOUS local book — the
     old loadHoldings() labeled that book (and every null/error/loading
     answer) as known holdings. Each read below captures the owner id, the
     WatchStore instance and a monotonically increasing generation, and a
     completion publishes holdings only while ALL of these still hold at
     settle time: still signed in, same store instance, same owner, CLOUD
     authority, a ready readState and an Array answer. Anything else —
     local/unknown/degraded/error/null/malformed/superseded — paints an
     honest notice state and never a known zero. No polling, no timers, no
     writes, no sync host of our own: readiness arrives through the page's
     existing wl-auth event and MDXAuth.onChange.
     ----------------------------------------------------------------------- */
  var NOTICE_COPY = {
    signedout: { en: 'Sign in to see which of these you hold.',
                 zh: '登录后即可看到你持有其中哪些。', link: false },
    loading: { en: 'Loading your holdings…', zh: '正在读取你的持仓…', link: false },
    unavailable: { en: 'Holdings are unavailable here.',
                   zh: '此处暂时无法读取持仓。', link: true },
    degraded: { en: 'Current holdings could not be verified.',
                zh: '暂时无法确认当前持仓。', link: true }
  };
  var verified = null;    // { owner, store, held } — only ever a
                          // verified cloud-ready read; unknown stays null, never {}
  var gen = 0;            // increasing request generation
  var current = null;     // { gen, owner, store } — the only read allowed to publish
  var inFlight = false;
  var lastReadState = ""; // unavailable | loading | degraded after a settled read
  var wired = false;

  function sessionOn() {
    try {
      return !!(window.MDXAuth && window.MDXAuth.hasSession && window.MDXAuth.hasSession());
    } catch (e) { return false; }
  }
  function storeUser() {
    try {
      var s = window.WatchStore;
      if (s && typeof s.user === "function") return s.user();
    } catch (e) {}
    return null;
  }
  function ownerId() {
    var u = storeUser();
    if (!u) return "";
    try { return String(u.id == null ? "" : u.id); } catch (e) { return ""; }
  }
  function portfolioApi() {
    var s = window.WatchStore;
    if (!s || !s.portfolio || typeof s.portfolio !== "object") return null;
    if (typeof s.portfolio.list !== "function" ||
        typeof s.portfolio.readState !== "function") return null;
    return s.portfolio;
  }
  function readStateOf(api) {
    try {
      return (api && typeof api.readState === "function") ? api.readState() : null;
    } catch (e) { return null; }
  }
  function verifiedHere() {
    if (!verified || !sessionOn() || verified.owner !== ownerId() ||
        verified.store !== window.WatchStore) return false;
    var rs = readStateOf(portfolioApi());
    return rs && rs.authority === "cloud" && rs.state === "ready";
  }

  function clearMarks() {
    rows.forEach(function (row) {
      row.setAttribute("data-has-exposure", "0");
      var line = row.querySelector("[data-rs-hold]");
      if (line) line.hidden = true;
    });
  }
  function applyHeld(held) {
    rows.forEach(function (row) {
      var on = !!(held && held[(row.getAttribute("data-ticker") || "").toUpperCase()]);
      row.setAttribute("data-has-exposure", on ? "1" : "0");
      var line = row.querySelector("[data-rs-hold]");
      if (line) line.hidden = !on;
    });
  }

  /* Exposure never filters on an unverified answer: while the lens is on but
     the holdings are not verified-ready, every row keeps its ordinary
     (other-lens) visibility and the notice names the state instead. */
  function noticeState() {
    if (!lenses.exposure) return "";
    if (!sessionOn()) return "signedout";
    if (!ownerId() || !portfolioApi()) return "unavailable";
    if (verifiedHere()) return "ready";
    if (inFlight) return "loading";
    return lastReadState || "degraded";
  }
  function paintNotice(state) {
    if (!exposureNull) return;
    if (!state) {
      exposureNull.hidden = true;
      exposureNull.setAttribute("data-state", "");
      return;
    }
    var copy = NOTICE_COPY[state] || null;
    exposureNull.hidden = false;
    exposureNull.setAttribute("data-state", state);
    if (copy) {
      var en = exposureNull.querySelector(".l-en");
      var zh = exposureNull.querySelector(".l-zh");
      if (en) en.textContent = copy.en;
      if (zh) zh.textContent = copy.zh;
    }
    var link = exposureNull.querySelector("[data-rs-portfolio-link]");
    if (link) link.hidden = !(copy && copy.link);
  }

  function apply() {
    if (verified && !verifiedHere()) {
      verified = null;
      clearMarks();
    }
    var vis = 0;
    rows.sort(function (a, b) {
      if (order === "next_catalyst_date") {
        var da = a.getAttribute("data-catalyst-date") || "";
        var db = b.getAttribute("data-catalyst-date") || "";
        if (!da && !db) return (a.getAttribute("data-name") || "").localeCompare(b.getAttribute("data-name") || "");
        if (!da) return 1;
        if (!db) return -1;
        if (da === db) return (a.getAttribute("data-name") || "").localeCompare(b.getAttribute("data-name") || "");
        return da < db ? -1 : 1;
      }
      return (a.getAttribute("data-name") || "").localeCompare(b.getAttribute("data-name") || "");
    });
    var gate = noticeState();
    var held = (verified && verified.held) || {};
    rows.forEach(function (row) {
      list.appendChild(row);
      var ok = true;
      if (lenses.catalyst && row.getAttribute("data-has-catalyst") !== "1") ok = false;
      if (lenses.valuation && row.getAttribute("data-has-valuation") !== "1") ok = false;
      if (lenses.exposure && gate === "ready" &&
          !held[(row.getAttribute("data-ticker") || "").toUpperCase()]) ok = false;
      row.hidden = !ok;
      if (ok) vis += 1;
    });
    if (empty) empty.hidden = vis !== 0;
    paintNotice(gate === "ready" ? "" : gate);
  }

  function fail(meta, kind) {
    if (!current || current.gen !== meta.gen) return;   // superseded
    current = null;
    inFlight = false;
    lastReadState = kind;
    verified = null;
    clearMarks();          // a failed read confirms nothing; never keep its marks
    apply();
  }
  function publish(meta, items) {
    if (!current || current.gen !== meta.gen) return;   // superseded completion
    if (!sessionOn() || ownerId() !== meta.owner || !meta.owner ||
        window.WatchStore !== meta.store) { fail(meta, "unavailable"); return; }
    var rs = readStateOf(portfolioApi());
    if (rs && rs.authority === "cloud" && rs.state === "loading") {
      fail(meta, "loading"); return;
    }
    // Cloud authority + a ready readState + an Array answer, or nothing is claimed.
    if (!rs || rs.authority !== "cloud" || rs.state !== "ready" || !Array.isArray(items)) {
      fail(meta, "degraded"); return;
    }
    var heldMap = Object.create(null);
    for (var i = 0; i < items.length; i++) {
      var item = items[i];
      if (!item || typeof item !== "object" || typeof item.ticker !== "string" ||
          !item.ticker.trim()) { fail(meta, "degraded"); return; }
      if (item.status === "closed") continue;           // closed lots are not holdings
      heldMap[item.ticker.trim().toUpperCase()] = true;
    }
    current = null;
    inFlight = false;
    lastReadState = "";
    verified = { owner: meta.owner, store: meta.store, held: heldMap };
    applyHeld(heldMap);
    apply();
  }
  function attempt() {
    if (verifiedHere()) { apply(); return; }
    gen += 1;
    current = null;
    inFlight = false;
    verified = null;
    lastReadState = "";
    clearMarks();
    if (!sessionOn() || !ownerId() || !portfolioApi()) {
      apply();
      return;
    }
    var uid = ownerId();
    var meta = { gen: gen, owner: uid, store: window.WatchStore };
    current = meta;
    inFlight = true;
    apply();                                           // paints the loading state
    var pending;
    try { pending = portfolioApi().list(); }
    catch (e) { fail(meta, "degraded"); return; }      // synchronous throw
    Promise.resolve(pending).then(
      function (items) { publish(meta, items); },
      function () { fail(meta, "degraded"); }          // promise rejection
    );
  }
  function onAuthEvent() {
    // Readiness can change without a new owner id. Revalidate a published book
    // as well as a pending one, clearing its marks before the replacement read.
    verified = null;
    attempt();               // re-read when eligible; wl-auth also carries readiness
  }
  function wire() {
    if (wired) return;
    wired = true;
    document.addEventListener("wl-auth", onAuthEvent);
    try {
      if (window.MDXAuth && typeof window.MDXAuth.onChange === "function") {
        window.MDXAuth.onChange(function () { onAuthEvent(); });
      }
    } catch (e) {}
  }
  function boot() {
    wire();
    attempt();
  }
  // Scripts later in the page (watchstore.js) must load first: always wait for
  // DOMContentLoaded while the document is still loading, whatever MDXAuth says.
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }

  document.querySelectorAll(".rs-chip[data-lens]").forEach(function (btn) {
    if (btn.disabled) return;
    btn.addEventListener("click", function () {
      var lens = btn.getAttribute("data-lens");
      if (lens === "theme") return;
      lenses[lens] = !lenses[lens];
      btn.classList.toggle("is-on", lenses[lens]);
      btn.setAttribute("aria-pressed", lenses[lens] ? "true" : "false");
      if (lens === "exposure" && lenses.exposure) attempt();
      else apply();
    });
  });
  document.querySelectorAll(".rs-order-btn").forEach(function (btn) {
    btn.addEventListener("click", function () {
      order = btn.getAttribute("data-order") || "name";
      document.querySelectorAll(".rs-order-btn").forEach(function (other) {
        var on = other === btn;
        other.classList.toggle("is-on", on);
        other.setAttribute("aria-pressed", on ? "true" : "false");
      });
      apply();
    });
  });
})();
</script>
<script src="theme.js"></script>
<script src="watchstore.js"></script>
</body>
</html>
