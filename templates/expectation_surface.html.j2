<script type="application/json" id="es-strings">{{ ES_STR | tojson }}</script>
<script type="application/json" id="es-default-series">{{ {"ticker": def_t, "horizon": def_h, "securities": s.census.securities, "unresolved": s.identity.unresolved if s.identity.unresolved is not none else 0} | tojson }}</script>
<script>
(function () {
  'use strict';
  var d = document, docEl = d.documentElement;
  function $(id) { return d.getElementById(id); }
  function qsa(sel, root) { return Array.prototype.slice.call((root || d).querySelectorAll(sel)); }
  function mqMobile() { return window.matchMedia('(max-width:767px)').matches; }
  function reduced() { return window.matchMedia('(prefers-reduced-motion: reduce)').matches; }
  var NS = 'http://www.w3.org/2000/svg';

  /* ---- strings ---- */
  var STR = { en: {}, zh: {} };
  try { STR = JSON.parse($('es-strings').textContent); } catch (e) {}
  function lang() { return docEl.getAttribute('data-lang') === 'zh' ? 'zh' : 'en'; }
  function fill(tpl, vars) {
    return String(tpl == null ? '' : tpl).replace(/\{(\w+)\}/g, function (m, k) {
      return vars && Object.prototype.hasOwnProperty.call(vars, k) ? String(vars[k]) : m;
    });
  }
  function Tp(key, vars) { var L = STR[lang()] || {}; return fill(L[key], vars); }
  function twoSpan(el, en, zh) {
    el.textContent = '';
    var a = d.createElement('span'); a.className = 'l-en'; a.textContent = en;
    var b = d.createElement('span'); b.className = 'l-zh'; b.textContent = zh;
    el.appendChild(a); el.appendChild(b);
  }
  function setT(el, key, vars) {
    if (!el) return;
    twoSpan(el, fill(STR.en && STR.en[key], vars), fill(STR.zh && STR.zh[key], vars));
  }
  function hzKey(raw) { return (raw === '0q' || raw === '+1q' || raw === '0y' || raw === '+1y') ? raw : null; }
  function hzText(raw) { var k = hzKey(raw); return k ? Tp(k) : String(raw); }

  /* ---- formatting (spec §8.9 + G4) ---- */
  function fmtInt(v) { return String(Math.round(v)).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
  function minus(s) { return s.replace('-', '−'); }
  function fmtVal(metric, v) {
    if (v == null || isNaN(v)) return '—';
    var a = Math.abs(v), s;
    if (metric === 'revenue') {
      if (a >= 1e9) s = (a / 1e9).toFixed(2) + 'B';
      else if (a >= 1e6) s = (a / 1e6).toFixed(1) + 'M';
      else if (a >= 1e3) s = (a / 1e3).toFixed(1) + 'k';
      else s = fmtInt(a);
    } else s = a.toFixed(2);
    return minus((v < 0 ? '-' : '') + s);
  }
  function fmtPct(c) {
    if (c == null || isNaN(c)) return '—';
    if (c > 0) return '+' + (c * 100).toFixed(1) + '%';
    if (c < 0) return '−' + (-c * 100).toFixed(1) + '%';
    return '0.0%';
  }
  function md(at) { return at ? String(at).slice(5, 10) : '—'; }
  function ymd(at) { return at ? String(at).slice(0, 10) : '—'; }

  /* ---- 1. language attributes ---- */
  function applyLang() {
    var zh = lang() === 'zh';
    qsa('[data-a-en]').forEach(function (n) {
      n.setAttribute('aria-label', zh ? (n.getAttribute('data-a-zh') || '') : (n.getAttribute('data-a-en') || ''));
    });
    qsa('[data-ph-en]').forEach(function (n) {
      n.setAttribute('placeholder', zh ? (n.getAttribute('data-ph-zh') || '') : (n.getAttribute('data-ph-en') || ''));
    });
    var q = $('es-q');
    if (q && q.value) syncClear(q);
  }
  try { applyLang(); d.addEventListener('langchange', applyLang); } catch (e) {}

  /* ---- 2. STALE chip (rendered_at − latest session > 9 days) ---- */
  try {
    var st = $('es-stale');
    var srcAt = $('es-src-at'), renAt = $('es-rendered-at');
    if (st && st.hidden && srcAt && renAt) {
      var days = (Date.parse(renAt.getAttribute('datetime')) - Date.parse(srcAt.getAttribute('datetime'))) / 86400000;
      if (isFinite(days) && days > 9) {
        setT($('es-stale-text'), 'stale', { d: Math.floor(days) });
        st.hidden = false;
      }
    }
  } catch (e) {}
  function bootData() {
    try { return JSON.parse($('es-default-series').textContent); } catch (e) { return {}; }
  }

  /* ---- 3. identity chip collapse ---- */
  try {
    var idBtn = $('es-id-btn'), idNote = $('es-id-note');
    if (idBtn && idNote) {
      idBtn.addEventListener('click', function () {
        var open = idBtn.getAttribute('aria-expanded') === 'true';
        idBtn.setAttribute('aria-expanded', open ? 'false' : 'true');
        idNote.hidden = open;
      });
      if (mqMobile()) { idBtn.setAttribute('aria-expanded', 'false'); idNote.hidden = true; }
    }
  } catch (e) {}

  /* ---- 4. method accordions (§10.8) ---- */
  try {
    var accs = qsa('#es-method details.es-acc');
    function syncAcc() {
      var mob = mqMobile();
      accs.forEach(function (de) {
        var sum = de.querySelector('summary');
        if (!mob) {
          de.open = true;
          sum.setAttribute('tabindex', '-1');
          sum.setAttribute('aria-disabled', 'true');
        } else {
          sum.removeAttribute('tabindex');
          sum.removeAttribute('aria-disabled');
          if (de.getAttribute('data-m') === 'closed') de.open = false;
        }
      });
    }
    accs.forEach(function (de) {
      de.querySelector('summary').addEventListener('click', function (ev) {
        if (!mqMobile()) ev.preventDefault();
      });
    });
    syncAcc();
    if (window.matchMedia) {
      var mql = window.matchMedia('(max-width:767px)');
      var onMq = function () { try { syncAcc(); } catch (e) {} };
      if (mql.addEventListener) mql.addEventListener('change', onMq);
      else if (mql.addListener) mql.addListener(onMq);
    }
  } catch (e) {}

  /* ---- 5. metric segmented (breadth, movers) ---- */
  try {
    [['breadth', '#es-breadth'], ['movers', '#es-movers']].forEach(function (pair) {
      var panel = d.querySelector(pair[1]);
      if (!panel) return;
      qsa('input[name]', panel).filter(function (r) {
        var fs = r.closest('fieldset');
        return fs && fs.getAttribute('data-target') === pair[0];
      }).forEach(function (r) {
        r.addEventListener('change', function () {
          qsa('[data-metric]', panel).forEach(function (body) {
            body.hidden = body.getAttribute('data-metric') !== r.value;
          });
        });
      });
    });
  } catch (e) {}

  /* ---- 6. expanders ---- */
  try {
    qsa('[data-more="breadth"]').forEach(function (btn) {
      var bt = btn.closest('.es-btable');
      var n = btn.getAttribute('data-n');
      btn.addEventListener('click', function () {
        var on = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', on ? 'false' : 'true');
        if (bt) bt.classList.toggle('is-expanded', !on);
        setT(btn, on ? 'all_sessions' : 'fewer_sessions', { n: fmtInt(Number(n)) });
      });
    });
    qsa('[data-more="movers"]').forEach(function (btn) {
      var side = btn.closest('.es-side');
      var n = Number(btn.getAttribute('data-n'));
      var cnt = side ? side.querySelector('.es-side-count') : null;
      function setCount(k) { if (cnt) setT(cnt, 'k_of_n', { k: k, n: fmtInt(n) }); }
      btn.addEventListener('click', function () {
        var on = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', on ? 'false' : 'true');
        if (side) side.classList.toggle('is-expanded', !on);
        setT(btn, on ? 'show_more' : 'show_fewer', { n: fmtInt(n - 6) });
        setCount(on ? Math.min(6, n) : n);
      });
    });
  } catch (e) {}

  /* ---- 7. "Show the numbers" ---- */
  var view = $('es-view'), viewBody = $('es-view-body');
  var cur = { doc: null, metric: 'EPS', horizon: null, sel: -1, committed: -1 };
  try {
    var numBtn = $('es-num-btn'), numBox = $('es-num');
    if (numBtn && numBox) numBtn.addEventListener('click', function () {
      var on = numBtn.getAttribute('aria-expanded') === 'true';
      numBtn.setAttribute('aria-expanded', on ? 'false' : 'true');
      numBox.hidden = on;
      setT(numBtn, on ? 'show_numbers' : 'hide_numbers');
    });
  } catch (e) {}

  /* ---- 8. explorer ---- */
  var q = $('es-q'), lbWrap = $('es-lb-wrap'), lb = $('es-lb'), lbNote = lbWrap ? lbWrap.querySelector('.es-lb-note') : null;
  var qHint = $('es-q-hint'), qStatus = $('es-q-status'), nomatch = $('es-nomatch');
  var cardT = $('es-card-t'), cardPill = $('es-card-pill');
  var idxCache = null, idxLoading = false, active = -1, openArgs = null, lastOpts = null;
  var VALID = /^[A-Z0-9.\-]{1,12}$/;

  function syncClear(input) {
    var c = $('es-q-clear');
    if (c) c.hidden = !input.value;
  }
  function closeLb() {
    if (!lbWrap) return;
    lbWrap.hidden = true;
    if (q) q.setAttribute('aria-expanded', 'false');
    active = -1;
    if (q) q.removeAttribute('aria-activedescendant');
  }
  function hideNomatch() {
    if (nomatch) nomatch.hidden = true;
    if (qHint) qHint.hidden = false;
  }
  function announce(s) { if (qStatus) qStatus.textContent = s; }

  function ensureIndex() {
    if (idxCache || idxLoading || typeof fetch !== 'function') return;
    idxLoading = true;
    fetch('expectation_surface/tickers/index.json')
      .then(function (r) { if (!r.ok) throw new Error(String(r.status)); return r.json(); })
      .then(function (list) { idxCache = Array.isArray(list) ? list : []; idxLoading = false; })
      .catch(function () { idxCache = []; idxLoading = false; });
  }
  function matchList(v) {
    if (!idxCache || !v) return [];
    var pre = [], sub = [];
    idxCache.forEach(function (e) {
      var t = String(e.ticker || '');
      if (t.indexOf(v) === 0) pre.push(e);
      else if (t.indexOf(v) !== -1) sub.push(e);
    });
    pre.sort(function (a, b) { return a.ticker < b.ticker ? -1 : 1; });
    sub.sort(function (a, b) { return a.ticker < b.ticker ? -1 : 1; });
    return pre.concat(sub).slice(0, 8);
  }
  function renderOptions(list) {
    if (!lb) return;
    lb.textContent = '';
    list.forEach(function (e, i) {
      var li = d.createElement('li');
      li.id = 'es-opt-' + e.ticker;
      li.setAttribute('role', 'option');
      li.setAttribute('aria-selected', 'false');
      var tt = d.createElement('span'); tt.className = 'f'; tt.textContent = e.ticker;
      var mm = d.createElement('span'); mm.className = 'es-lb-m';
      mm.textContent = Tp('opt_meta', { n: e.sessions, md: md(e.latest_at) });
      li.appendChild(tt); li.appendChild(mm);
      li.addEventListener('mousedown', function (ev) { ev.preventDefault(); choose(i); });
      lb.appendChild(li);
    });
    if (lbNote) lbNote.textContent = list.length === 1 ? Tp('match_one') : Tp('matches', { k: list.length });
    if (list.length && q) {
      lbWrap.hidden = false;
      q.setAttribute('aria-expanded', 'true');
    } else closeLb();
    announce(list.length === 1 ? Tp('match_one') : Tp('matches', { k: list.length }));
  }
  function setActive(i) {
    if (!lb) return;
    var opts = qsa('li', lb);
    if (!opts.length) return;
    active = (i + opts.length) % opts.length;
    opts.forEach(function (o, j) { o.setAttribute('aria-selected', j === active ? 'true' : 'false'); });
    q.setAttribute('aria-activedescendant', opts[active].id);
    opts[active].scrollIntoView({ block: 'nearest' });
  }
  function choose(i) {
    var opts = qsa('li', lb);
    var opt = opts[i];
    if (!opt) return;
    var t = opt.querySelector('.f').textContent;
    open(t, { metric: cur.metric, from: 'search' });
  }
  if (q) {
    var debT = null;
    q.addEventListener('focus', ensureIndex);
    q.addEventListener('input', function () {
      syncClear(q);
      hideNomatch();
      var v = q.value.trim().toUpperCase();
      if (debT) clearTimeout(debT);
      debT = setTimeout(function () {
        if (!v) { closeLb(); return; }
        renderOptions(matchList(v));
      }, 80);
    });
    q.addEventListener('keydown', function (ev) {
      var opts = qsa('li', lb);
      var isOpen = lbWrap && !lbWrap.hidden;
      if (ev.key === 'ArrowDown' || ev.key === 'ArrowUp') {
        ev.preventDefault();
        if (!isOpen) { if (q.value.trim()) renderOptions(matchList(q.value.trim().toUpperCase())); return; }
        setActive((active < 0 ? (ev.key === 'ArrowDown' ? -1 : 0) : active) + (ev.key === 'ArrowDown' ? 1 : -1));
      } else if (ev.key === 'Enter') {
        ev.preventDefault();
        if (isOpen && active >= 0 && opts[active]) { choose(active); return; }
        var v = q.value.trim().toUpperCase();
