    });
    qsa('.es-pick').forEach(function (b) {
      b.addEventListener('click', function () {
        open(b.getAttribute('data-ticker'), { metric: 'EPS', horizon: b.getAttribute('data-horizon'), from: 'pick' });
      });
    });
    qsa('input[name="es-xm"],input[name="es-xh"]').forEach(function (r) {
      r.addEventListener('change', function () {
        if (!cur.doc) return;
        if (r.name === 'es-xm') cur.metric = r.value;
        else cur.horizon = r.value;
        if (!cur.doc.series[cur.metric]) cur.doc.series[cur.metric] = {};
        cur.horizon = pickHorizon(cur.doc, cur.metric, cur.horizon);
        updateRadios(cur.doc, cur.metric, cur.horizon);
        cur.sel = -1;
        renderView();
        fillNumbers();
      });
    });
  } catch (e) {}
  wireChart();

  /* ---- 9. boot ---- */
  try {
    var boot = bootData();
    var deep = null;
    try { deep = new URLSearchParams(window.location.search).get('t'); } catch (e) {}
    if (deep) deep = deep.trim().toUpperCase();
    if (deep && VALID.test(deep)) open(deep, { metric: 'EPS', from: 'deep' });
    else if (boot.ticker) open(boot.ticker, { metric: 'EPS', horizon: boot.horizon, from: 'default' });
  } catch (e) {}
})();
</script>
<script src="theme.js"></script>
</body>
</html>
