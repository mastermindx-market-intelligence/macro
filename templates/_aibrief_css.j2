{# ABX3 editorial composition. All container boundaries are neutral and even.
   Dark: luminance separation. Light: white paper, crisp hairlines, outer shadow.
   This remains the only shared brief stylesheet; no parallel token palette. #}
.aib2{font-family:var(--font-ui);font-size:var(--fs-body,14px);line-height:1.6;color:var(--text);min-width:0;overflow-wrap:anywhere;}
.aib2 *{box-sizing:border-box;}
.aib2-hdr{display:flex;align-items:flex-start;justify-content:space-between;gap:var(--sp-6,24px);padding-bottom:var(--sp-5,20px);border-bottom:1px solid var(--line);margin-bottom:var(--sp-4,16px);}
.aib2-hdr-meta{min-width:0;flex:1;}
.aib2-kicker,.aib2-sec-label{font-size:var(--fs-label,11px);font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);}
.aib2-kicker{margin-bottom:var(--sp-1,4px);}
.aib2 .aib2-hdr-title{font:700 var(--fs-h2,17px)/1.35 var(--font-ui);color:var(--text);margin:0 0 var(--sp-2,8px);}
.aib2-hdr-sub{display:flex;flex-wrap:wrap;gap:var(--sp-1,4px) var(--sp-4,16px);font-size:var(--fs-sm,12.5px);color:var(--muted);}
.aib2 time{font-variant-numeric:tabular-nums;}
.aib2-badge{max-width:220px;font-size:var(--fs-sm,12.5px);color:var(--muted);text-align:right;line-height:1.5;}
.aib2-cadence{color:var(--muted);}
.aib2-freshness,.aib2-degraded{padding:var(--sp-3,12px) var(--sp-4,16px);margin:0 0 var(--sp-4,16px);background:var(--panel2);border:1px solid var(--line);border-radius:var(--r-ctl,8px);font-size:var(--fs-sm,12.5px);color:var(--text);}
.aib2-freshness[data-state="old"]{color:var(--ink-warn,var(--text));}
.aib2-opening{margin:var(--sp-6,24px) 0;}
.aib2 .aib2-sec-label{margin:0 0 var(--sp-3,12px);line-height:1.4;}
.aib2-lead{font-size:var(--fs-num-lg,22px);font-weight:700;letter-spacing:-.015em;line-height:1.45;margin:0 0 var(--sp-4,16px);max-width:66ch;color:var(--text);}
.aib2-gist-list{list-style:none;padding:0;margin:0 0 var(--sp-5,20px);display:grid;gap:var(--sp-2,8px);}
.aib2-gist-list li{font-size:var(--fs-body,14px);line-height:1.65;}
.aib2-gist-list b{font-weight:650;}
.aib2-stance{display:flex;align-items:center;justify-content:space-between;gap:var(--sp-4,16px);padding:var(--sp-4,16px);border:1px solid var(--line);border-radius:var(--r-ctl,8px);background:var(--panel2);}
.aib2-stance .aib2-eyebrow{margin:0;flex-shrink:0;color:var(--muted);font-size:var(--fs-sm,12.5px);font-weight:500;}
.aib2-stance-body{font-weight:700;font-size:var(--fs-md,15px);text-align:right;}
.aib2-conf{display:flex;align-items:baseline;flex-wrap:wrap;gap:var(--sp-2,8px);font-size:var(--fs-sm,12.5px);color:var(--muted);padding-top:var(--sp-3,12px);}
.aib2-conf strong{color:var(--text);font-weight:650;}
.aib2-conf-note{margin-left:auto;}
.aib2-section{padding:var(--sp-5,20px) 0;border-top:1px solid var(--line);}
.aib2-meta,.aib2-empty{font-size:var(--fs-sm,12.5px);line-height:1.65;color:var(--muted);margin:0;}
.aib2-kf-rail{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 var(--sp-6,24px);margin:0;}
.aib2-kf{display:flex;align-items:baseline;justify-content:space-between;gap:var(--sp-3,12px);padding:var(--sp-2,8px) 0;border-bottom:1px solid var(--line);min-width:0;}
.aib2-kf-k{color:var(--muted);font-size:var(--fs-sm,12.5px);}
.aib2-kf-v{margin:0;text-align:right;font-size:var(--fs-sm,12.5px);font-weight:650;}
.aib2-kf--good .aib2-kf-v{color:var(--ink-ok,var(--text));}
.aib2-kf--warn .aib2-kf-v{color:var(--ink-warn,var(--text));}
.aib2-kf--bad .aib2-kf-v{color:var(--ink-act,var(--text));}
.aib2-kf--info .aib2-kf-v{color:var(--text);}
.aib2-watch,.aib2-items{padding:0;margin:0;list-style:none;}
.aib2-watch-row{padding:var(--sp-3,12px) 0;border-bottom:1px solid var(--line);font-size:var(--fs-body,14px);}
.aib2-watch-row:first-child{padding-top:0;}
.aib2-watch-row:last-child{border-bottom:0;padding-bottom:0;}
.aib2-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--sp-6,24px);}
.aib2-grid:has(> :only-child){grid-template-columns:1fr;}
.aib2-card{min-width:0;padding:0;border:0;border-radius:0;background:none;box-shadow:none;}
.aib2 .aib2-eyebrow{font-size:var(--fs-body,14px);line-height:1.45;font-weight:700;color:var(--text);margin:0 0 var(--sp-2,8px);letter-spacing:0;text-transform:none;}
.aib2-items li{font-size:var(--fs-sm,12.5px);line-height:1.7;margin-bottom:var(--sp-2,8px);}
.aib2-card--playbook{margin-top:var(--sp-5,20px);padding-top:var(--sp-4,16px);border-top:1px solid var(--line);}
.aib2-prose,.aib2-regime{font-size:var(--fs-body,14px);line-height:1.7;max-width:74ch;margin:0;}
.aib2-regime{white-space:pre-line;padding-top:var(--sp-4,16px);}
.aib2-details{border-top:1px solid var(--line);padding:var(--sp-4,16px) 0;}
.aib2-details summary{cursor:pointer;font-size:var(--fs-body,14px);font-weight:650;min-height:40px;align-content:center;}
.aib2-details summary>span:not(.l-en):not(.l-zh){font-size:var(--fs-sm,12.5px);font-weight:400;color:var(--muted);margin-left:var(--sp-2,8px);}
.aib2-details[open] summary{margin-bottom:var(--sp-3,12px);}
.aib2-details summary:focus-visible,.aib2 a:focus-visible{outline:2px solid var(--link);outline-offset:4px;border-radius:var(--r-ctl,8px);}
.aib2-events{list-style:none;margin:0;padding:0;}
.aib2-events li{display:flex;flex-wrap:wrap;gap:var(--sp-3,12px);padding:var(--sp-2,8px) 0;border-bottom:1px solid var(--line);font-size:var(--fs-sm,12.5px);}
.aib2-event-state{margin-left:auto;color:var(--muted);}
html[data-theme="light"] .aib2-stance,html[data-theme="light"] .aib2-freshness,html[data-theme="light"] .aib2-degraded{background:var(--bg);box-shadow:none;}
html[data-theme="light"] .aib2 .aib2-card{background:transparent;box-shadow:none;}
html[data-lang="zh"] .aib2-kicker,html[data-lang="zh"] .aib2-sec-label,html[data-lang="zh"] .aib2-lead{letter-spacing:0;text-transform:none;}
@media(max-width:760px){.aib2-grid{grid-template-columns:1fr;gap:var(--sp-5,20px);}}
@media(max-width:560px){.aib2-hdr{display:block;}.aib2-badge{display:block;text-align:left;max-width:none;margin-top:var(--sp-3,12px);}.aib2-kf-rail{grid-template-columns:1fr;}.aib2-stance{display:block;}.aib2-stance-body{text-align:left;margin-top:var(--sp-1,4px);}.aib2-conf-note{flex-basis:100%;margin-left:0;}.aib2-lead{font-size:var(--fs-h2,17px);}.aib2-details summary>span:not(.l-en):not(.l-zh){display:block;margin-left:0;}}
@media(prefers-reduced-motion:reduce){.aib2 *,.aib2 *::before,.aib2 *::after{animation:none!important;transition:none!important;}}
