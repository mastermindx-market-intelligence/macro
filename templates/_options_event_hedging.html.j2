{# Display-only snapshot. Values come from the existing Python analytical owner. #}
{% if event_hedging_view %}
<section class="oew-panel oew-eh" aria-labelledby="event-hedging-heading" data-event-hedging-research>
  <style>
  .oew-eh .eh-intro{margin:0 0 16px;max-width:78ch;color:var(--muted)}
  .oew-eh .eh-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr));gap:12px}
  .oew-eh .eh-metric{background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:14px;min-width:0}
  .oew-eh .eh-metric dt{font-size:12px;color:var(--muted);margin-bottom:7px}
  .oew-eh .eh-metric dd{margin:0;font-size:22px;overflow-wrap:anywhere}
  .oew-eh .eh-evidence{margin-top:16px;border-top:1px solid var(--line);padding-top:12px}
  .oew-eh summary{cursor:pointer;min-height:36px;display:list-item;align-content:center}
  .oew-eh summary:focus-visible{outline:2px solid var(--oew-accent);outline-offset:3px}
  .oew-eh .eh-facts{display:grid;grid-template-columns:minmax(120px,1fr) minmax(0,3fr);gap:8px 16px;margin:12px 0}
  .oew-eh .eh-facts dt{color:var(--muted)}
  .oew-eh .eh-facts dd{margin:0;overflow-wrap:anywhere}
  .oew-eh .eh-reasons{overflow-wrap:anywhere;color:var(--muted)}
  @media(max-width:560px){.oew-eh .eh-facts{grid-template-columns:1fr;gap:4px}.oew-eh .eh-facts dd{margin-bottom:8px}}
  </style>
  <div class="oew-phead">
    <h2 class="oew-ph-title" id="event-hedging-heading">{{ t('Event hedging research', '事件对冲研究') }}</h2>
    <span>{{ t('Recorded scenario · not live flow', '记录情景 · 非实时资金流') }}</span>
  </div>
  <div class="oew-pbody">
    <p class="eh-intro">{{ t('Explore how a stated event and option-book assumption change risk. These calculations do not establish dealer ownership, executed orders or a directional forecast.', '研究指定事件与期权持仓假设如何改变风险。这些计算不能证明交易商真实持仓、已执行订单或价格方向预测。') }}</p>
    {% if event_hedging_view.as_of %}
    <p>{{ t('Decision snapshot', '决策快照') }}: <time class="mono" datetime="{{ event_hedging_view.as_of }}">{{ event_hedging_view.as_of }}</time></p>
    {% endif %}
    {% if event_hedging_view.available %}
    <dl class="eh-grid">
      {% for row in event_hedging_view.rows %}
      <div class="eh-metric"><dt>{{ t(row.en, row.zh) }}</dt>
        <dd>{% if row.value is not none %}<span class="mono">{{ row.value }}</span>{% else %}{{ t('Not available', '暂不可用') }}{% endif %}</dd>
      </div>
      {% endfor %}
    </dl>
    {% if event_hedging_view.kind == 'variance' %}
    <p>{{ t('Variance is measured in squared decimal returns. The event amount depends on the supplied baseline and known overlap coverage; a negative difference is retained, not hidden.', '方差以小数收益的平方计量。事件量取决于给定基准和已知重叠事件覆盖；负差值将保留，不会隐藏。') }}</p>
    <p>{{ t('The RMS move is a conditional scale, not a probability, expected absolute return or target price.', '均方根波幅是条件尺度，不是概率、预期绝对收益或目标价格。') }}</p>
    {% else %}
    <p>{{ t('Positive means hypothetical hedge buying; negative means hypothetical selling. SPX risk units are not executable shares or futures contracts.', '正值表示假设的对冲买入，负值表示假设卖出。SPX风险单位不是可执行股票或期货合约。') }}</p>
    {% endif %}
    {% else %}
    <p class="oew-empty">{{ t('This calculation is unavailable. Missing evidence is not zero exposure or a quiet market.', '此项计算暂不可用。证据缺失不等于零敞口或市场平静。') }}</p>
    {% endif %}
    {% if event_hedging_view.reasons %}
    <p class="eh-reasons">{{ t('Evidence limits', '证据限制') }}: {% for reason in event_hedging_view.reasons %}<code>{{ reason }}</code>{% if not loop.last %} · {% endif %}{% endfor %}</p>
    {% endif %}
    <details class="eh-evidence">
      <summary>{{ t('Inspect assumptions and source identities', '查看假设与来源标识') }}</summary>
      <dl class="eh-facts">
        {% for row in event_hedging_view.evidence %}<dt>{{ t(row.en, row.zh) }}</dt><dd>{{ row.value }}</dd>{% endfor %}
        <dt>{{ t('Calculation identity', '计算标识') }}</dt><dd>{{ event_hedging_view.content_id or t('Not available', '暂不可用') }}</dd>
      </dl>
      <p>{{ t('Content hashes identify supplied records; they do not independently verify the market data.', '内容哈希标识给定记录，并不独立核实市场数据。') }}</p>
    </details>
  </div>
  <div class="oew-pfoot">{{ t('Directional-turn probabilities: not yet qualified. No trading, ranking or position-sizing effect.', '方向转折概率：尚未通过资格验证。不影响交易、排名或仓位规模。') }}</div>
</section>
{% endif %}
