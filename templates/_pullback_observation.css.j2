/* Settled-price observation: scoped tokens, no new theme or charting system. */
.pbx{--pbx-accent:var(--warn);--pbx-ink:var(--ink-warn,var(--warn));color:var(--text);font-family:var(--font-ui);font-size:var(--fs-sm);font-variant-numeric:tabular-nums;min-width:0;box-sizing:border-box}
.pbx *, .pbx *::before, .pbx *::after{box-sizing:border-box}
.pbx-down{--pbx-accent:var(--down);--pbx-ink:var(--ink-down,var(--down))}
.pbx-info{--pbx-accent:var(--info);--pbx-ink:var(--ink-info,var(--info))}
.pbx.pbx-card{padding:var(--sp-5,20px);border:1px solid var(--line);background:linear-gradient(145deg,var(--panel2),var(--panel) 60%);border-radius:var(--r-panel,18px);box-shadow:var(--card-shadow);display:flex;flex-direction:column;gap:var(--sp-3,12px);overflow:hidden}
.pbx-heading{display:flex;align-items:center;justify-content:space-between;gap:var(--sp-3,12px);min-width:0}
.pbx h2,.pbx h3,.pbx p{margin:0}
.pbx h3{font-size:var(--fs-h3);font-weight:700;line-height:1.4;letter-spacing:0;text-transform:none;color:var(--text)}
.pbx h2{font-size:var(--fs-h1);font-weight:800;letter-spacing:-.025em;line-height:1.2;color:var(--text)}
.pbx-eyebrow{font-size:var(--fs-label);letter-spacing:.08em;font-weight:600;color:var(--muted);margin-bottom:var(--sp-2,8px)}
.pbx-state{font-size:var(--fs-label);letter-spacing:.07em;font-weight:600;padding:var(--sp-1,4px) var(--sp-2,8px);border-radius:var(--r-pill,999px);border:1px solid var(--line);color:var(--pbx-ink);background:var(--panel2);white-space:nowrap}
.pbx-number{font-size:var(--fs-num-xl);line-height:1.05;font-weight:800;letter-spacing:-.04em;color:var(--ink-down,var(--down));margin:var(--sp-1,4px) 0 var(--sp-2,8px)}
.pbx[data-pb-phase="unavailable"] .pbx-number{color:var(--muted)}
.pbx-basis{font-size:var(--fs-sm);color:var(--muted);line-height:1.55}
.pbx-chart{min-width:0;overflow:hidden}
.pbx-card .pbx-chart{margin:var(--sp-2,8px) 0 var(--sp-3,12px)}
.pbx .pbx-chart .ilx{width:100%;margin:0;background:transparent;border:0;border-radius:0;box-shadow:none}
.pbx .ilx-corner{font-size:var(--fs-micro)}
.pbx-line{display:flex;align-items:baseline;justify-content:space-between;gap:var(--sp-3,12px);min-width:0;line-height:1.5}
.pbx-line>span:first-child{color:var(--muted);min-width:0}
.pbx-line strong{white-space:nowrap;font-weight:650;font-size:inherit;color:var(--text)}
.pbx small{font-size:var(--fs-label);font-weight:500;color:var(--muted)}
.pbx-ruler{height:6px;border-radius:var(--r-pill,999px);background:var(--panel2);border:1px solid var(--line);margin:var(--sp-2,8px) 0;position:relative}
.pbx-ruler>span{opacity:.65;height:100%;display:block;border-radius:inherit;background:var(--info)}
.pbx-ruler>i{position:absolute;top:50%;width:9px;height:9px;border-radius:var(--r-pill,999px);border:2px solid var(--panel);background:var(--info);transform:translate(-50%,-50%);box-shadow:0 0 0 1px var(--line)}
.pbx-ruler-labels{display:flex;justify-content:space-between;gap:var(--sp-2,8px);font-size:var(--fs-label);color:var(--muted)}
.pbx-forecast{display:grid;gap:var(--sp-2,8px);padding-top:var(--sp-3,12px);border-top:1px solid var(--line)}
.pbx-footer{display:flex;align-items:center;justify-content:space-between;gap:var(--sp-2,8px);margin-top:auto}
.pbx-stamp{font-size:var(--fs-label);color:var(--muted);line-height:1.5}
.pbx-stamp time{white-space:nowrap}
.pbx-open{min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:var(--sp-2,8px);padding:var(--sp-2,8px) var(--sp-3,12px);font:inherit;font-weight:600;color:var(--ink-info,var(--info));background:transparent;border:1px solid var(--line);border-radius:var(--r-btn,10px);cursor:pointer;transition:background .14s var(--ease-std,ease),border-color .14s var(--ease-std,ease)}
.pbx-open svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.pbx-open:hover{background:var(--panel2);border-color:var(--info)}
.pbx-open:focus-visible,.pbx-method summary:focus-visible{outline:2px solid var(--ink-info,var(--info));outline-offset:3px}
.pbx-meaning{font-size:var(--fs-body);line-height:1.6;color:var(--text)}
.pbx-card .pbx-meaning{margin:var(--sp-2,8px) 0}
.pbx-detail{padding:var(--sp-6,24px);border:1px solid var(--line);border-radius:var(--r-panel,18px);background:var(--panel);margin-bottom:var(--sp-5,20px)}
.pbx-detail-grid{display:grid;grid-template-columns:minmax(155px,.85fr) minmax(0,1.65fr);align-items:center;gap:var(--sp-6,24px);padding:var(--sp-5,20px) 0}
.pbx-detail .pbx-number{font-size:var(--fs-display)}
.pbx-read .pbx-meaning{margin-top:var(--sp-3,12px);max-width:30ch}
.pbx-evidence-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-6,24px);padding:var(--sp-5,20px) 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.pbx-note{font-size:var(--fs-sm);color:var(--muted);line-height:1.55;margin-top:var(--sp-2,8px)!important}
.pbx-index-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--sp-1,4px);margin:var(--sp-2,8px) 0;height:6px}
.pbx-index-strip>span{border-radius:var(--r-pill,999px)}
.pbx-declining{opacity:.65;background:var(--down)}
.pbx-neutral{opacity:.32;background:var(--info)}
.pbx-missing{background:repeating-linear-gradient(135deg,var(--line) 0,var(--line) 2px,transparent 2px,transparent 5px);border:1px solid var(--line)}
.pbx-history-heading{display:flex;align-items:baseline;justify-content:space-between;gap:var(--sp-3,12px);padding-top:var(--sp-5,20px)}
.pbx-history-heading>span{font-size:var(--fs-label);color:var(--muted);text-align:right}
.pbx-timeline{list-style:none;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));padding:0;margin:var(--sp-4,16px) 0 var(--sp-5,20px);gap:0}
.pbx-timeline li{position:relative;display:flex;flex-direction:column;gap:var(--sp-1,4px);padding:var(--sp-5,20px) var(--sp-2,8px) 0 0;min-width:0}
.pbx-timeline li::before{content:"";position:absolute;top:5px;left:0;right:0;height:1px;background:var(--line)}
.pbx-timeline li:last-child::before{display:none}
.pbx-event-dot{position:absolute;width:11px;height:11px;top:0;left:0;border-radius:var(--r-pill,999px);border:2px solid var(--panel);background:var(--muted);box-shadow:0 0 0 1px var(--line)}
.pbx-event-confirmed .pbx-event-dot,.pbx-event-low .pbx-event-dot{background:var(--down)}
.pbx-event-latest .pbx-event-dot{background:var(--info);box-shadow:0 0 0 3px var(--panel2)}
.pbx-event-label{font-size:var(--fs-sm);line-height:1.4;color:var(--text)}
.pbx-timeline time{font-size:var(--fs-label);color:var(--muted);white-space:nowrap}
.pbx-timeline strong{font-size:var(--fs-md);font-weight:650;color:var(--text)}
.pbx-index-table{border-top:1px solid var(--line)}
.pbx-index-table .pbx-line{padding:var(--sp-2,8px) 0;border-bottom:1px solid var(--line)}
.pbx-table-head{font-size:var(--fs-label);color:var(--muted)}
.pbx-table-head>span:last-child{text-align:right}
.pbx-method{margin-top:var(--sp-3,12px)}
.pbx-method summary{min-height:44px;display:flex;align-items:center;justify-content:space-between;gap:var(--sp-3,12px);font-size:var(--fs-sm);font-weight:600;cursor:pointer;color:var(--text);list-style:none}
.pbx-method summary::-webkit-details-marker{display:none}
.pbx-method summary::after{content:"+";font-size:var(--fs-h2);font-weight:400;color:var(--muted)}
.pbx-method[open] summary::after{content:"−"}
.pbx-method-copy{font-size:var(--fs-sm);line-height:1.7;color:var(--muted)}
.pbx-method-copy p{margin-bottom:var(--sp-3,12px)}
.pbx-limit{margin-top:var(--sp-3,12px);padding:var(--sp-3,12px) 0 0;border-top:1px solid var(--line);font-size:var(--fs-sm);color:var(--muted);line-height:1.6}
.pbx-compact{padding-bottom:var(--sp-3,12px);margin-bottom:var(--sp-3,12px);border-bottom:1px solid var(--line)}
.pbx-compact strong{font-size:var(--fs-num-lg);color:var(--ink-down,var(--down));white-space:nowrap}
.pbx-compact p{line-height:1.6;margin:var(--sp-2,8px) 0}
.pbx-null-art{display:flex;align-items:center;gap:var(--sp-3,12px);height:104px;opacity:.7}
.pbx-null-art span{height:1px;background:var(--line);flex:1}
.pbx-null-art i{height:18px;width:18px;border:1px dashed var(--muted);border-radius:var(--r-pill,999px)}
.pbx-expiry{display:none;font-size:var(--fs-sm);line-height:1.6;color:var(--ink-warn,var(--warn));padding:var(--sp-3,12px) 0}
.pbx.pb-expired .pbx-expiry{display:block}
.pbx.pb-expired .pbx-current{display:none}
html[data-theme="light"] .pbx.pbx-card{background:var(--panel);border-color:var(--line);box-shadow:var(--card-shadow)}
html[data-theme="light"] .pbx-state{background:var(--panel2)}
@media(max-width:600px){.pbx-detail{padding:var(--sp-4,16px)}.pbx-detail>.pbx-heading{align-items:flex-start;flex-direction:column}.pbx h2{font-size:var(--fs-h1)}.pbx-detail-grid{grid-template-columns:1fr;gap:var(--sp-3,12px);padding:var(--sp-4,16px) 0}.pbx-read .pbx-meaning{max-width:none}.pbx-evidence-grid{grid-template-columns:1fr;gap:var(--sp-5,20px)}.pbx-timeline{grid-template-columns:1fr 1fr;row-gap:var(--sp-4,16px)}.pbx-timeline li:nth-child(2)::before{display:none}.pbx-history-heading{align-items:flex-start;flex-direction:column;gap:var(--sp-1,4px)}.pbx-history-heading>span{text-align:left}.pbx-detail .pbx-number{font-size:var(--fs-num-xl)}}
@media(prefers-reduced-motion:reduce){.pbx *{animation:none!important;transition:none!important}.pbx .ilx-path{stroke-dashoffset:0!important}}

.pbx.pb-expired .pbx-heading>strong{display:none}
@media(scripting:none){.pbx .ilx-path{stroke-dashoffset:0!important}.pbx .ilx-area,.pbx .ilx-water,.pbx .ilx-ref,.pbx .ilx-tag,.pbx .ilx-d,.pbx .ilx-reflab{opacity:1!important}.pbx .ilx-dot{transform:scale(1)!important}}
