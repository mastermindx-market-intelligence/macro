{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro lens(en, zh='') -%}
<button type="button" class="lens-q" aria-label="{{ en }}" data-tip-en="{{ en }}" data-tip-zh="{{ zh if zh else en }}">?</button>
{%- endmacro %}
{% macro kpi(label, zh, val, unit='', sub='') -%}
<div class="kpi">{{ t(label, zh) }}<b>{% if val is none %}<span class="faint">—</span>{% else %}{{ val }}{{ unit }}{% endif %}</b>{% if sub %}<span class="ksub">{{ sub }}</span>{% endif %}</div>
{%- endmacro %}
{% macro gauge(score, color) -%}
{%- set sc = ([0,[100,(score if score is not none else 0)]|min]|max)|float -%}
{%- set arc = 175.93 -%}
{%- set filled = (sc/100*arc)|round(2) -%}
{%- set gap = (arc-filled)|round(2) -%}
{%- set deg = (sc/100*180-90)|round(1) -%}
<figure class="bhg" style="--sc:{{ color }};--arc:{{ arc }};--arc-gap:{{ gap }}" role="img" aria-label="Bond health score {{ sc|int }} of 100">
<svg viewBox="0 -6 140 104" fill="none" aria-hidden="true">
<path class="bhg-track" d="M14 75 A56 56 0 0 1 126 75"/>
<path class="bhg-fill" d="M14 75 A56 56 0 0 1 126 75"/>
<g class="bhg-needle" transform="rotate({{ deg }} 70 75)">
<line class="bhg-ptr" x1="70" y1="75" x2="70" y2="26"/>
<circle class="bhg-hub" cx="70" cy="75" r="6.5"/>
<circle class="bhg-hub2" cx="70" cy="75" r="3"/>
</g>
</svg>
<span class="bhg-ends"><span>0</span><span>100</span></span>
</figure>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% include "_interfonts.html.j2" %}
<script>document.documentElement.classList.add('js');try{var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',t||'dark');var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>Bonds & Bond Health — {{ as_of }}</title>
{% set seo_title = 'Bonds and Bond Health — Yields, Curve and Credit | Mastermind' %}{% set seo_desc = 'A bonds hub tracking Treasury yields, the yield curve, credit spreads and bond-market health with regime-aware reads.' %}{% set seo_path = 'bonds.html' %}
{% include "_seo_head.html.j2" %}
<link rel="stylesheet" href="illus.css">
<style>
/* ═══════════════════════════════════════════════════════════════════════════
   BONDS & BOND HEALTH — design system (Signal-Ink era)
   Ported from the macro dashboard's glass / aurora / gauge language, given a
   distinct bond identity: an indigo→blue→teal "cost-of-capital" accent, with the
   live yield curve as the hero signature. Health/credit semantics stay
   green·amber·red. Scoped to .wrap so the shared nav (_vector_polish) is untouched.
   ═══════════════════════════════════════════════════════════════════════════ */
:root{
  /* palette (shared Glassnode light base) */
  --blue:{{C.blue}}; --indigo:{{C.indigo}}; --ink:{{C.ink}}; --text:{{C.text}}; --muted:{{C.muted}};
  --faint:{{C.faint}}; --red:{{C.red}}; --amber:{{C.amber}}; --green:{{C.green}}; --teal:{{C.teal}};
  --grid:{{C.grid}}; --card:{{C.card}}; --bg:{{C.bg}}; --gold:{{C.gold}};
  /* illus + component vars the vector shell never defined (fixes the credit-cycle
     table's undefined var(--up/--down/--line) too) */
  --info:#3f74e6; --warn:{{C.amber}}; --orange:#e0883c;
  --up:{{C.green}}; --down:{{C.red}}; --line:{{C.grid}}; --panel:{{C.card}}; --panel2:#eef1f6;
  /* bond accent ramp — the page signature */
  --accent:#4d6be0; --accent2:#1f8a70;
  --accent-grad:linear-gradient(115deg,var(--indigo) 0%,var(--blue) 48%,var(--teal) 100%);
  /* elevation + glass */
  --card-brd:#e7ebf2;
  --card-shadow:0 1px 2px rgba(20,30,50,.05), 0 10px 26px -14px rgba(20,32,64,.16);
  --card-shadow-lg:0 2px 8px rgba(20,30,50,.07), 0 26px 54px -22px rgba(20,32,64,.26);
  --glass-bg:rgba(255,255,255,.72);
  --glass-blur:saturate(160%) blur(14px);
  --ring:color-mix(in srgb, var(--blue) 40%, transparent);
  /* type + rhythm */
  --fs-hero:56px; --r-lg:18px; --r-md:13px; --r-sm:9px;
}
html[data-theme="dark"]{
  --bg:#0a0d12; --card:#141821; --grid:#242a36; --ink:#eaeff6; --text:#d3d9e2; --muted:#8b93a1;
  --faint:#828b9c; --red:#e06464; --green:#45b873; --teal:#3bb597;
  --info:#5b9bf0; --orange:#e0955a; --panel:#141821; --panel2:#1b2029; --line:#242a36;
  --accent:#6f8bf0; --card-brd:#232a37;
  --card-shadow:0 1px 0 rgba(255,255,255,.03), 0 14px 34px -18px rgba(0,0,0,.66);
  --card-shadow-lg:0 1px 0 rgba(255,255,255,.05), 0 30px 64px -24px rgba(0,0,0,.78);
  --glass-bg:color-mix(in srgb, var(--card) 78%, transparent);
  --up:var(--green); --down:var(--red);
}
*{box-sizing:border-box}
html:not([data-lang="zh"]) .l-zh{display:none}
html[data-lang="zh"] .l-en{display:none}
html[data-lang="zh"] body{font-family:"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",Inter,sans-serif}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,sans-serif;font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
a{color:var(--ink-link, var(--blue));text-decoration:none}
.wrap{max-width:1200px;margin:0 auto;padding:0 22px 72px;position:relative;z-index:1}
/* ambient aurora backdrop — quiet, tuned to the bond accent (indigo/teal), never loud */
body::before{content:"";position:fixed;inset:0;z-index:0;pointer-events:none;
  background:
    radial-gradient(760px 460px at 8% -6%, color-mix(in srgb,var(--indigo) 15%,transparent), transparent 66%),
    radial-gradient(680px 460px at 96% 0%, color-mix(in srgb,var(--teal) 12%,transparent), transparent 70%),
    radial-gradient(820px 520px at 50% 118%, color-mix(in srgb,var(--blue) 9%,transparent), transparent 72%);}
html[data-theme="dark"] body::before{
  background:
    radial-gradient(760px 460px at 8% -6%, color-mix(in srgb,var(--indigo) 26%,transparent), transparent 64%),
    radial-gradient(680px 460px at 96% 0%, color-mix(in srgb,var(--teal) 20%,transparent), transparent 68%),
    radial-gradient(820px 520px at 50% 120%, color-mix(in srgb,var(--blue) 16%,transparent), transparent 72%);}

/* grids ------------------------------------------------------------------- */
.grid{display:grid;gap:18px;align-items:start}
.cols-2{grid-template-columns:1.05fr .95fr}.cols-3{grid-template-columns:repeat(3,1fr)}
@media(max-width:900px){.cols-2,.cols-3{grid-template-columns:1fr}}

/* section headers — quiet kicker + colored rail + hairline fading to the edge --- */
.sec-head{display:flex;align-items:center;gap:12px;margin:44px 0 16px;padding:0;
  font-size:11.5px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.11em}
.sec-head::before{content:"";flex:none;width:3px;height:16px;border-radius:2px;
  background:var(--accent-grad)}
.sec-head::after{content:"";flex:1;height:1px;background:linear-gradient(90deg,var(--grid),transparent)}

/* cards — glass, floating, gentle hover lift ------------------------------ */
.card{background:var(--card);border:1px solid var(--card-brd);border-radius:var(--r-lg);
  padding:22px;min-width:0;overflow-wrap:break-word;box-shadow:var(--card-shadow);
  transition:box-shadow .24s ease,transform .24s ease,border-color .24s ease}
.card:hover{box-shadow:var(--card-shadow-lg)}
.card h2{margin:0 0 10px;font-size:11.5px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.07em}
.card h2 .h2q{color:var(--faint);font-weight:600;text-transform:none;letter-spacing:0}

/* page header ------------------------------------------------------------- */
.brand{font-weight:800;font-size:30px;color:var(--ink);letter-spacing:-.025em;margin:14px 0 6px;line-height:1.1}
.brand .gn{background:var(--accent-grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.lead{color:var(--muted);font-size:14.5px;line-height:1.55;max-width:820px;margin:0 0 16px}
.sub{font-size:13px;color:var(--muted);min-width:0}.faint{color:var(--faint)}

/* jump-nav → floating pill row -------------------------------------------- */
.jump-nav{display:flex;flex-wrap:wrap;gap:7px;margin:6px 0 26px}
.jump-nav a{font-size:12px;font-weight:600;color:var(--muted);background:var(--card);
  border:1px solid transparent;border-radius:999px;padding:6px 13px;white-space:nowrap;
  box-shadow:var(--card-shadow);transition:color .15s,box-shadow .2s,transform .15s}
.jump-nav a:hover{color:var(--ink);box-shadow:var(--card-shadow-lg);transform:translateY(-1px)}

/* ═══════ HERO — Bond Health command scorecard ═══════════════════════════ */
.bh-hero{border-radius:22px;padding:0;overflow:hidden;border:1px solid var(--card-brd);
  background:var(--glass-bg);-webkit-backdrop-filter:var(--glass-blur);backdrop-filter:var(--glass-blur);
  box-shadow:var(--card-shadow-lg);display:grid;grid-template-columns:1.02fr .98fr;margin:2px 0 8px}
.bh-hero>div{padding:26px 28px;min-width:0}
.bh-hero-left{position:relative;border-right:1px solid var(--card-brd)}
.bh-eyebrow{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.14em;margin-bottom:6px}
.bh-scorewrap{display:flex;align-items:center;gap:20px;margin:6px 0 2px}
.bh-score{font-size:64px;font-weight:900;line-height:.92;letter-spacing:-.04em;color:var(--sc,var(--ink));
  text-shadow:0 0 46px color-mix(in srgb,var(--sc,var(--ink)) 30%,transparent);font-variant-numeric:tabular-nums}
.bh-score small{display:block;font-size:15px;font-weight:700;color:var(--muted);letter-spacing:0;margin-top:6px}
.bh-band-word{font-size:20px;font-weight:800;color:var(--sc,var(--ink));letter-spacing:-.01em}
.bh-phase{margin:12px 0 2px;display:flex;gap:7px;flex-wrap:wrap;align-items:center}
.bh-verdict{font-size:14.5px;color:var(--text);line-height:1.55;margin:12px 0 0;max-width:52ch}
.bh-hero-right{display:flex;flex-direction:column}
.bh-curve-read{font-size:14px;color:var(--text);line-height:1.5;margin:4px 0 0}
.bh-curve-read b{color:var(--ink)}

/* the semicircle gauge (SSR SVG; needle + arc baked by Jinja, drawn by CSS) */
.bhg{position:relative;width:180px;height:112px;flex:none}
.bhg svg{width:100%;height:100%;overflow:visible;display:block}
.bhg-track{fill:none;stroke:color-mix(in srgb,var(--muted) 20%,transparent);stroke-width:11;stroke-linecap:round}
.bhg-fill{fill:none;stroke:var(--sc,var(--blue));stroke-width:11;stroke-linecap:round;
  stroke-dasharray:var(--arc,176);stroke-dashoffset:var(--arc-gap,0);
  filter:drop-shadow(0 0 6px color-mix(in srgb,var(--sc,var(--blue)) 55%,transparent))}
.bhg-ptr{stroke:var(--ink);stroke-width:3;stroke-linecap:round}
.bhg-hub{fill:var(--ink)}
.bhg-hub2{fill:var(--sc,var(--blue))}
.bhg-ends{position:absolute;left:6px;right:6px;bottom:20px;display:flex;justify-content:space-between;
  font-size:10px;font-weight:600;color:var(--faint)}
@media(prefers-reduced-motion:no-preference){
  .bhg-fill{stroke-dashoffset:var(--arc,176);animation:bhgSweep 1.15s cubic-bezier(.33,.62,.26,1) .2s forwards}
  .bhg-needle{opacity:0;transform:scale(.55);transform-origin:70px 75px;transform-box:view-box;
    animation:bhgPop .55s cubic-bezier(.34,1.28,.5,1) .55s forwards}
}
@keyframes bhgSweep{to{stroke-dashoffset:var(--arc-gap,0)}}
@keyframes bhgPop{to{opacity:1;transform:scale(1)}}

/* alarm flags + chips ----------------------------------------------------- */
.pill{display:inline-block;max-width:100%;padding:4px 11px;border-radius:999px;font-size:12px;font-weight:600;
  background:var(--panel2);color:var(--ink);border:1px solid transparent;margin:2px 4px 2px 0;
  white-space:normal;overflow-wrap:anywhere}
html[data-theme="dark"] .pill{background:#222836}
.band-chip{display:inline-block;max-width:100%;padding:4px 13px;border-radius:999px;font-size:13px;font-weight:700;
  color:#fff;letter-spacing:.01em;white-space:normal;overflow-wrap:anywhere;box-shadow:0 1px 3px rgba(20,30,50,.18)}
.bias-chip{display:inline-block;padding:4px 13px;border-radius:999px;font-size:13px;font-weight:700;color:#fff;
  box-shadow:0 1px 3px rgba(20,30,50,.18)}
.flag{display:inline-block;max-width:100%;padding:9px 13px;border-radius:11px;font-size:12.5px;font-weight:600;
  margin-top:12px;line-height:1.45;white-space:normal;overflow-wrap:anywhere}
.flag.warn{background:color-mix(in srgb,var(--amber) 16%,transparent);color:#9a6a10}
.flag.alarm{background:color-mix(in srgb,var(--red) 14%,transparent);color:var(--ink-act, var(--red))}
.flag.info{background:color-mix(in srgb,var(--blue) 11%,transparent);color:var(--ink-link, var(--blue))}
.flag.ok{background:color-mix(in srgb,var(--green) 13%,transparent);color:var(--ink-ok, var(--green))}
html[data-theme="dark"] .flag.warn{color:#e0a840}

/* ═══════ GLANCE — the bottom line, every pillar at a glance ══════════════ */
.glance{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin:2px 0 6px}
@media(max-width:900px){.glance{grid-template-columns:repeat(3,1fr)}}
@media(max-width:560px){.glance{grid-template-columns:repeat(2,1fr)}}
.gl-tile{display:grid;grid-template-columns:3px 1fr;background:var(--card);border:1px solid var(--card-brd);
  border-radius:var(--r-md);overflow:hidden;box-shadow:var(--card-shadow);text-decoration:none;
  transition:box-shadow .2s,transform .15s}
.gl-tile:hover{box-shadow:var(--card-shadow-lg);transform:translateY(-2px)}
.gl-tile::before{content:"";background:var(--sc,var(--muted))}
.gl-body{padding:12px 13px;min-width:0}
.gl-name{font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:5px}
.gl-state{font-size:16px;font-weight:800;color:var(--sc,var(--ink));line-height:1.1;letter-spacing:-.01em}
.gl-mean{font-size:11.5px;color:var(--muted);line-height:1.4;margin-top:4px}
/* --sc is the state hue for the big score and the band word — TEXT, at 64px and 20px
   and 16px. The raw tokens are fill grade (the amber measured 1.92:1 on white), so
   the text consumers read the ink rungs; anything that FILLS still takes --sc. */
.gl-good{--sc:var(--ink-ok, var(--green))} .gl-mid{--sc:var(--ink-link, var(--blue))}
.gl-warn{--sc:var(--ink-warn, var(--amber))} .gl-bad{--sc:var(--ink-act, var(--red))}

/* ═══════ KEY LEVELS strip ════════════════════════════════════════════════ */
.klv{display:grid;grid-template-columns:repeat(7,1fr);gap:10px;margin:2px 0}
@media(max-width:900px){.klv{grid-template-columns:repeat(4,1fr)}}
@media(max-width:560px){.klv{grid-template-columns:repeat(2,1fr)}}
.klv-tile{background:var(--panel2);border-radius:var(--r-md);padding:11px 13px;min-width:0}
html[data-theme="dark"] .klv-tile{background:var(--panel2)}
.klv-lab{font-size:10.5px;font-weight:600;color:var(--muted);letter-spacing:.02em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.klv-val{font-size:20px;font-weight:800;color:var(--ink);font-variant-numeric:tabular-nums;margin-top:3px;letter-spacing:-.02em}
.klv-val .u{font-size:12px;color:var(--muted);font-weight:700}
.klv-sub{font-size:10.5px;color:var(--faint);margin-top:2px;font-variant-numeric:tabular-nums}

/* KPI group -------------------------------------------------------------- */
.kpis{display:flex;gap:11px 12px;flex-wrap:wrap;margin-top:14px}
.kpi{font-size:12.5px;color:var(--muted);min-width:96px;background:var(--panel2);border-radius:12px;padding:11px 14px}
html[data-theme="dark"] .kpi{background:var(--panel2)}
.kpi b{display:block;font-size:19px;color:var(--ink);font-weight:700;font-variant-numeric:tabular-nums;margin-top:3px}
.kpi .ksub{font-size:11px;color:var(--faint)}

/* stress-leg + factor mini bars ------------------------------------------ */
.legs{margin-top:14px;display:flex;flex-direction:column;gap:8px}
.leg{display:grid;grid-template-columns:118px 1fr 34px;align-items:center;gap:10px;font-size:12px}
.leg .lname{color:var(--text);min-width:0}
.leg .lbar{position:relative;height:8px;background:var(--panel2);border-radius:5px;overflow:hidden}
.leg .lfill{position:absolute;left:0;top:0;bottom:0;border-radius:5px;transform-origin:left;
  transition:width .5s cubic-bezier(.33,.62,.26,1)}
.leg .lval{text-align:right;color:var(--muted);font-variant-numeric:tabular-nums}
.lvg{margin-left:5px;font-weight:800;font-size:11px;cursor:help}
.vg-measured{color:var(--ink-ok, var(--green))}.vg-directional{color:var(--ink-warn, var(--amber))}.vg-context{color:var(--faint)}.vg-inverted{color:var(--indigo)}
.measured-edge{margin-top:12px;padding:11px 13px;border-radius:12px;background:color-mix(in srgb,var(--green) 9%,transparent);font-size:13px;line-height:1.5;color:var(--text)}
.measured-edge b{color:var(--ink-ok, var(--green))}
.tax-note{font-size:13px;color:var(--muted);margin:8px 0 0;line-height:1.5}

/* compass gauge ----------------------------------------------------------- */
.compass-wrap{margin:12px 0 4px}
.compass-track{position:relative;height:30px;border-radius:9px;background:linear-gradient(90deg,color-mix(in srgb,var(--red) 18%,transparent),color-mix(in srgb,var(--muted) 10%,transparent) 50%,color-mix(in srgb,var(--green) 18%,transparent));border:1px solid var(--grid)}
.compass-mid{position:absolute;left:50%;top:0;bottom:0;width:1px;background:var(--faint);opacity:.6}
.compass-marker{position:absolute;top:-5px;width:3px;height:40px;border-radius:2px;background:var(--ink);transition:left .5s cubic-bezier(.34,1.2,.5,1)}
.compass-ends{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-top:5px}
.leg-state{margin-left:auto;font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.02em}

/* bonds→everything transmission rows ------------------------------------- */
.xa-row{display:grid;grid-template-columns:154px 1fr 94px;align-items:center;gap:12px;padding:11px 0;border-bottom:1px solid var(--grid)}
.xa-row:last-child{border-bottom:none}
.xa-asset{font-weight:700;color:var(--ink);font-size:13.5px}
.xa-asset .xa-sub{display:block;font-size:11px;color:var(--muted);font-weight:500}
.xa-note{margin-top:5px;font-size:12px;color:var(--muted);line-height:1.45;overflow-wrap:anywhere}
.xa-bar{position:relative;height:9px;background:var(--panel2);border-radius:5px}
.xa-mid{position:absolute;left:50%;top:-3px;bottom:-3px;width:1px;background:var(--faint);opacity:.5}
.xa-fill{position:absolute;top:0;bottom:0;border-radius:5px}
.xa-verd{text-align:right;font-size:12px;font-weight:700}

/* scorecard + generic tables --------------------------------------------- */
.table-wrap,.sc-wrap{overflow-x:auto}
.sc-tbl,.supply-tbl,.credit-cycle-tbl{width:100%;border-collapse:collapse;font-size:13px;min-width:620px}
.sc-tbl th{text-align:right;padding:6px 8px;border-bottom:1px solid var(--grid);color:var(--muted);font-size:10.5px;text-transform:uppercase;letter-spacing:.03em;font-weight:700;white-space:nowrap}
.sc-tbl th:first-child,.sc-tbl td:first-child{text-align:left}
.sc-tbl td{text-align:right;padding:7px 8px;border-bottom:1px solid var(--grid);font-variant-numeric:tabular-nums;white-space:nowrap}
.sc-tbl tr:hover td{background:color-mix(in srgb,var(--blue) 5%,transparent)}
.sc-tbl .cty{font-weight:700;color:var(--ink)}
.dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;vertical-align:middle}
.mini-tag{display:inline-block;padding:2px 8px;border-radius:6px;font-size:11px;font-weight:700;color:#fff}
.stale-tag{font-size:9.5px;color:var(--ink-warn, var(--amber));font-weight:700;margin-left:4px}

/* cross-asset drivers + timeline + notes --------------------------------- */
.drv{display:grid;grid-template-columns:120px 1fr;gap:10px 16px;align-items:start;padding:12px 0;border-bottom:1px solid var(--grid);min-width:0}
.drv:last-child{border-bottom:none}
.drv .dasset{font-weight:700;color:var(--ink);font-size:14px}
.drv .dnote{font-size:13px;color:var(--muted);line-height:1.5;min-width:0;overflow-wrap:anywhere}
.drv .dnote b{color:var(--text)}
.timeline{margin-top:6px}
.tl-day{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin:14px 0 4px}
.tl-ev{display:flex;align-items:baseline;gap:10px;padding:7px 0;border-bottom:1px solid var(--grid);font-size:13px}
.tl-type{flex:none;min-width:78px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.02em}
.tl-head{color:var(--text)}
.sev-high .tl-type{color:var(--ink-act, var(--red))}.sev-medium .tl-type{color:#9a6a10}.sev-info .tl-type{color:var(--muted)}
.note{font-size:13px;color:var(--muted);line-height:1.6}.note b{color:var(--ink)}
.meta-foot{font-size:12px;color:var(--faint);margin-top:8px}

/* illus figures fill their card + get a hairline frame ------------------- */
.chart-frame{margin-top:14px}
.chart-cap{font-size:11px;font-weight:600;color:var(--muted);letter-spacing:.02em;margin:0 0 4px}

/* footer ------------------------------------------------------------------ */
.site-footer{max-width:1200px;margin:34px auto 0;padding:18px 22px;border-top:1px solid var(--grid);display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;color:var(--muted);font-size:12.5px}

/* ═══════ scroll reveal (cards rise as they enter) ═══════════════════════ */
@media(prefers-reduced-motion:no-preference){
  html.js .reveal{opacity:0;transform:translateY(14px);transition:opacity .6s ease,transform .6s cubic-bezier(.22,.9,.26,1.02)}
  html.js .reveal.in{opacity:1;transform:none}
}

/* ═══════ responsive ═════════════════════════════════════════════════════ */
@media(max-width:820px){
  .bh-hero{grid-template-columns:1fr}
  .bh-hero-left{border-right:none;border-bottom:1px solid var(--card-brd)}
}
@media(max-width:560px){
  .wrap{padding:0 13px 56px}
  .card{padding:16px;border-radius:15px}
  .bh-hero>div{padding:20px}
  .brand{font-size:23px}
  .bh-score{font-size:50px}
  .bhg{width:150px;height:96px}
  .drv{grid-template-columns:1fr}
  .tl-ev{align-items:flex-start}.tl-type{min-width:62px}
  .leg{grid-template-columns:minmax(0,1fr) 44px;row-gap:6px}
  .leg .lname{grid-column:1/2}.leg .lval{grid-column:2/3}.leg .lbar{grid-column:1/3}
  .xa-row{grid-template-columns:1fr auto;column-gap:10px;row-gap:7px}
  .xa-row>.xa-asset{grid-area:1/1;min-width:0}.xa-row>.xa-verd{grid-area:1/2;min-width:0}.xa-row>.xa-bar{grid-area:2/1/3/3}
  .kpi{min-width:0;flex:1 1 42%}
  .sec-head{margin:32px 0 13px}
}

/* light: bloom off (DESIGN_DOCTRINE §5.8) — a coloured glow behind text is a jewel on graphite
     and a stain on white; dark keeps every one of these). */
html[data-theme="light"] :is(
  .bh-score
) { text-shadow:none; }

/* post-stack: consolidate */
/* Archetype-D primitives (reference class names). Dark = luminance depth, no shadow.
   Light = white material + hairline + soft shadow. Token-derived only. */
.mx-vh{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:22px;align-items:start;
  padding:18px 0 8px;background:transparent;border:none;box-shadow:none}
.mx-vh-word{font-size:42px;font-weight:800;letter-spacing:-.03em;line-height:.95;margin:4px 0 8px;color:var(--ink)}
.mx-vh-clause{font-size:15px;max-width:56ch;color:var(--text);margin:0 0 4px;line-height:1.45}
.mx-vh-meta{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:12px}
.mx-stance{display:inline-flex;align-items:center;gap:6px;font-weight:700;font-size:13px;
  padding:4px 11px;border-radius:var(--r-sm);border:1px solid color-mix(in srgb,var(--muted) 34%,transparent);
  background:color-mix(in srgb,var(--muted) 12%,var(--panel));color:var(--muted)}
.mx-stance-up{color:var(--ink-up);border-color:color-mix(in srgb,var(--ink-up) 34%,transparent);background:color-mix(in srgb,var(--ink-up) 12%,var(--panel))}
.mx-stance-warn{color:var(--ink-warn);border-color:color-mix(in srgb,var(--ink-warn) 34%,transparent);background:color-mix(in srgb,var(--ink-warn) 12%,var(--panel))}
.mx-stance-down{color:var(--ink-down);border-color:color-mix(in srgb,var(--ink-down) 34%,transparent);background:color-mix(in srgb,var(--ink-down) 12%,var(--panel))}
.mx-stance-muted{color:var(--muted);border-color:color-mix(in srgb,var(--muted) 34%,transparent);background:color-mix(in srgb,var(--muted) 12%,var(--panel))}
.mx-callout{border-left:2px solid var(--ink-warn);background:var(--panel2);padding:8px 12px;
  margin-top:12px;max-width:56ch;font-size:13px;border-radius:0 var(--r-sm) var(--r-sm) 0}
.mx-callout b{color:var(--ink-warn)}
html[data-theme="light"] .mx-vh{
  background:var(--card);border:1px solid var(--line);
  box-shadow:0 1px 2px color-mix(in srgb,var(--ink) 6%,transparent);
  border-radius:var(--r-lg);padding:22px 24px}
html[data-theme="light"] .mx-vh-word{color:var(--ink)}
html[data-theme="light"] .mx-callout{
  background:color-mix(in srgb,var(--ink-warn) 4%,var(--card));
  box-shadow:0 1px 2px color-mix(in srgb,var(--ink) 6%,transparent);border-left-width:3px}
html[data-theme="dark"] .bhg-fill{stroke:color-mix(in srgb,var(--up) 55%,transparent);filter:none}
html[data-theme="light"] .bhg-fill{stroke:var(--up);filter:none}

.band{margin-top:28px}
.band-label{font-size:11.5px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;
  color:var(--muted);margin:0 0 12px}
html[data-lang="zh"] .band-label{letter-spacing:0;text-transform:none}
.mx-sec{display:flex;align-items:baseline;gap:8px;margin:0 0 10px}
.mx-sec h2{font-size:17px;font-weight:700;letter-spacing:-.01em;margin:0;color:var(--ink);text-transform:none}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--r-lg);padding:16px 18px}
html[data-theme="light"] .panel{background:var(--card);box-shadow:0 1px 2px color-mix(in srgb,var(--ink) 6%,transparent)}
html[data-theme="dark"] .panel{box-shadow:none}

.mx-chg-when{flex:none;width:56px;color:var(--muted);font-size:10.5px;font-variant-numeric:tabular-nums}
html[data-theme="dark"] .mx-chg-row{border-bottom-color:color-mix(in srgb,var(--ink) 12%,transparent)}
html[data-theme="light"] .mx-chg-row{border-bottom-color:color-mix(in srgb,var(--ink) 14%,transparent)}

.drivers{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.drv-read{font-size:13.5px;margin:0 0 10px;max-width:64ch;color:var(--text);line-height:1.45}
.drv-read b{font-weight:700;color:var(--ink)}
.mtiles2{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.mtile{background:var(--panel2);border-radius:var(--r-md);padding:10px 12px;min-width:0}
.mtile-lbl{font-size:10.5px;font-weight:600;color:var(--muted)}
.mtile-val{font-size:18px;font-weight:800;color:var(--ink);font-variant-numeric:tabular-nums;margin-top:2px;letter-spacing:-.02em}
html[data-theme="dark"] .watch-cond{background:var(--panel2)}
.watch{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.watch-cond{font-size:13px}
.watch-cond b{display:block;font-size:14.5px;margin-bottom:4px;color:var(--ink)}
.watch-foot{color:var(--muted);font-size:12px;margin-top:10px}
.depth{display:flex;flex-wrap:wrap;gap:10px}
.depth a{display:inline-flex;align-items:center;gap:7px;text-decoration:none;color:var(--text);
  border:1px solid var(--line);background:var(--panel);border-radius:var(--r-md);padding:9px 14px;
  font-size:13px;font-weight:600}
html[data-theme="dark"] .depth a:hover{background:var(--panel2);box-shadow:none}
html[data-theme="light"] .depth a:hover{box-shadow:0 2px 6px color-mix(in srgb,var(--ink) 10%,transparent)}
.depth a small{color:var(--muted);font-weight:400}
.empty-why{color:var(--muted);font-size:13px;margin-top:6px;line-height:1.45}
.cc-delayed, .cc-delayed:hover{background:var(--panel2);box-shadow:none}
html[data-theme="light"] .cc-delayed{background:var(--card);box-shadow:none;border:1px solid var(--line)}
.world-list{margin:8px 0 0;padding:0;list-style:none;max-width:36rem}
.world-list li{display:flex;justify-content:space-between;gap:12px;padding:7px 0;border-bottom:1px solid var(--line);font-size:13px}
.world-list li:last-child{border-bottom:none}
.landing{margin-top:36px}
.landing-kicker{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0 0 8px}
@media(max-width:820px){.mx-vh{grid-template-columns:1fr}.drivers{grid-template-columns:1fr}.watch{grid-template-columns:1fr}}
@media(max-width:640px){
  .drivers{display:flex;align-items:start;overflow-x:auto;scroll-snap-type:x mandatory;gap:12px;padding-bottom:6px}
  .drivers>.panel{flex:0 0 86%;scroll-snap-align:start}
  .mtiles2{grid-template-columns:repeat(2,1fr)}
  .mx-vh-word{font-size:32px}
}
@media(prefers-reduced-motion:reduce){.depth a,.depth a:hover{transform:none}}

/* Floor pass (G8): DecisionRow flex lives in theme.css, but this vector page
   does not link it — port the row contract here. Dark/light border colour
   stays on the rules above. */
.mx-chg-row{display:flex;align-items:center;gap:10px;padding:9px 2px;
  border-bottom:1px solid var(--line);text-decoration:none;color:inherit}
.mx-chg-name{font-weight:700;flex:none}
.mx-chg-what{color:var(--text);flex:1;min-width:0}
.mx-chg-chev{color:var(--muted);flex:none}
@media(max-width:640px){
  .mx-chg-row{flex-wrap:wrap;row-gap:4px}
  .mx-chg-what{flex-basis:100%;order:3}
}

/* LIVE / as-of chips — same contract as theme.css .dtp-*, page-scoped because
   bonds does not load that sheet. */
.dtp-chip{display:inline-flex;align-items:center;gap:5px;flex:none;font-size:11px;
  font-weight:700;letter-spacing:.035em;color:var(--muted);padding:4px 8px;
  border:1px solid var(--line);border-radius:var(--r-sm);
  background:color-mix(in srgb,var(--panel2) 70%,transparent)}
.dtp-chip>i{width:6px;height:6px;border-radius:var(--r-sm);flex:none;background:currentColor}
.dtp-chip--live{color:var(--ink-up,var(--green))}
.dtp-asof{font-size:11px;color:var(--muted)}

/* Skeleton plates at true geometry. Reduced-motion kills the shimmer, not the box. */
.mx-skel{display:block;border-radius:var(--r-sm);min-height:58px;width:100%;
  background:linear-gradient(90deg,var(--panel2) 25%,color-mix(in srgb,var(--text) 7%,var(--panel2)) 45%,var(--panel2) 65%);
  background-size:200% 100%;animation:mxSkel 1.2s linear infinite}
@keyframes mxSkel{to{background-position:-200% 0}}
@media(prefers-reduced-motion:reduce){.mx-skel{animation-name:none}}

/* LENS `?` — dedicated tap target so data-tip is not on a whole row (S1 flash-and-vanish).
   Size via .wrap .lens-q so it outranks theme.js's injected 17px rule. */
.wrap .lens-q{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;
  margin-left:4px;padding:0;vertical-align:middle;flex:none;border-radius:var(--r-lg);
  border:1px solid var(--line);background:transparent;color:var(--muted);
  font-size:11px;font-weight:700;cursor:help;line-height:1;position:relative}
.wrap .band-chip .lens-q{color:inherit;border-color:color-mix(in srgb,currentColor 45%,transparent)}
.wrap .lens-q::after{content:attr(data-tip-en);display:none;position:absolute;right:0;bottom:calc(100% + 6px);
  z-index:8;max-width:min(42ch,90vw);padding:8px 10px;border-radius:var(--r-sm);font-size:12px;font-weight:500;
  line-height:1.45;letter-spacing:0;text-transform:none;color:var(--text);background:var(--panel);
  border:1px solid var(--line);box-shadow:0 8px 24px color-mix(in srgb,var(--ink) 18%,transparent);
  white-space:normal;text-align:left}
html[data-lang="zh"] .wrap .lens-q::after{content:attr(data-tip-zh)}
.wrap .lens-q.cnx-tip-open::after,.wrap .lens-q:focus-visible::after{display:block}
@media(max-width:640px){.wrap .lens-q{width:32px;height:32px;font-size:13px}}

/* Focus-visible rings on interactive hosts. */
.mx-chg-row:focus-visible,.depth a:focus-visible,.jump-nav a:focus-visible,
.wrap .lens-q:focus-visible,a:focus-visible{
  outline:2px solid color-mix(in srgb,var(--blue) 70%,transparent);outline-offset:2px}

/* Wide tables scroll inside .sc-wrap, never the page.
   Chromium does not let a CSS table's min-width expand a block's scrollWidth;
   the inner .sc-scroll is a block with min-width so the wrap is a real scrollport. */
.sc-wrap{overflow-x:auto;width:100%;max-width:100%;min-width:0;-webkit-overflow-scrolling:touch}
.sc-scroll{min-width:640px}
.sc-tbl{width:100%;min-width:0;max-width:none}
</style>
{% include "_state_inks.html.j2" %}
{% include "_vector_polish.html.j2" %}
</head>
<body>
{% include "_site_nav.html.j2" %}

<div class="wrap">
  <div class="brand">🏛️ Bonds <span class="gn">&amp; Bond Health</span></div>
  <p class="lead">{{ t('A compact read on bond-market health: curve, credit, real rates, rates volatility, funding stress, global yields and cross-asset spillovers. Context first; trade signals elsewhere.', '债市健康度速览：曲线、信用、实际利率、利率波动、资金压力、全球收益率与跨资产传导。先看背景；交易信号另列。') }}</p>

  <!-- ===================== SECTION JUMP-NAV — six L1 anchors only ===================== -->
  <div class="jump-nav">
    <a href="#health">{{ t('Regime', '格局') }}</a>
    <a href="#changed">{{ t('What changed', '最近变化') }}</a>
    <a href="#drivers">{{ t('Why', '原因') }}</a>
    <a href="#world">{{ t('Bonds & the world', '债券与全球') }}</a>
    <a href="#watching">{{ t('Watching', '观察') }}</a>
    <a href="#deeper">{{ t('Go deeper', '深入研究') }}</a>
  </div>

  {% set hero = hero if hero is defined else {} %}
  {% set changed = changed if changed is defined else [] %}
  {% set watching = watching if watching is defined else [] %}
  {% set div_card = div_card if div_card is defined else {'state':'delayed'} %}
  {% set glance_map = {} %}
  {% for gt in glance or [] %}{% if glance_map.update({gt.href: gt}) %}{% endif %}{% endfor %}
  {% set LEG_TIP = {
    'trend': ('Long-Treasury price momentum across 3-, 6- and 12-month horizons.', '长久期美债价格在3、6、12个月三个区间的动量。'),
    'carry': ('A steep curve pays you to hold duration, through carry and roll-down; an inverted curve charges you for it.', '曲线陡峭时，持有久期可获得套息与滚动收益；曲线倒挂时则须付出成本。'),
    'value': ('A high real yield means bonds are cheap — a good entry. A negative real yield means they are expensive: the 2022 regime.', '实际收益率高=债券便宜，是较好的入场点；实际收益率为负=债券昂贵，即2022年的情形。'),
    'term_premium': ('A high term premium means you are paid to bear duration risk; a negative one means you are not.', '期限溢价高=承担久期风险能获得补偿；期限溢价为负=没有补偿。'),
    'macro': ('Rising copper-to-gold and breakevens signal reflation — a headwind for duration.', '铜金比与盈亏平衡通胀率上行=再通胀迹象——对久期不利。')
  } %}
  {% set LEG_LAB = {
    'trend': ('Trend', '趋势'),
    'carry': ('Carry & roll (10y−3m)', '套息与滚动（10年−3月）'),
    'value': ('Value (real 10-year)', '价值（10年实际利率）'),
    'term_premium': ('Term premium', '期限溢价'),
    'macro': ('Macro impulse (reflation)', '宏观动能（再通胀）')
  } %}
  {% set VG_TIP = {
    'measured': ('Measured — this factor has been calibrated against forward drawdowns.', '已校准——该分项已通过前瞻回撤校准。'),
    'directional': ('Directional — the sign has held up; the size has not been calibrated.', '有方向——方向性成立，但幅度未经校准。'),
    'context': ('Context only — this factor has not been calibrated against forward drawdowns.', '仅供参考——该分项未经前瞻回撤校准。')
  } %}

  <!-- ===================== L1-1 HERO ===================== -->
  <header class="mx-vh" id="health" data-l1="hero">
    <div>
      <h1 class="mx-vh-word"><span class="l-en">{{ hero.word_en }}</span><span class="l-zh">{{ hero.word_zh }}</span></h1>
      <p class="mx-vh-clause"><span class="l-en">{{ hero.clause_en }}</span><span class="l-zh">{{ hero.clause_zh }}</span></p>
      <div class="mx-vh-meta">
        <span class="mx-stance {{ hero.stance_cls }}"><span class="l-en">{{ hero.stance_en }}</span><span class="l-zh">{{ hero.stance_zh }}</span></span>
        {% if vm.health.recession_risk is not none %}
        <span class="pill">{% if hero.rec_rail %}{{ t('Recession risk', '衰退风险') }}{% else %}{{ t('Recession risk: ' ~ (hero.rec_band_en or ''), '衰退风险：' ~ (hero.rec_band_zh or '')) }}{% endif %}{% if hero.rec_score is not none %}{{ lens('Scored ' ~ hero.rec_score ~ ' out of 100, where 100 is the highest risk this model measures.', '评分 ' ~ hero.rec_score ~ '/100，100 为该模型可测的最高风险。') }}{% endif %}</span>
        {% endif %}
        {% if vm.health.drawdown_risk is not none %}
        <span class="pill">{% if hero.dd_rail %}{{ t('Drawdown risk', '回撤风险') }}{% else %}{{ t('Drawdown risk: ' ~ (hero.dd_band_en or ''), '回撤风险：' ~ (hero.dd_band_zh or '')) }}{% endif %}{% if hero.dd_score is not none %}{{ lens('Scored ' ~ hero.dd_score ~ ' out of 100, where 100 is the highest risk this model measures.', '评分 ' ~ hero.dd_score ~ '/100，100 为该模型可测的最高风险。') }}{% endif %}</span>
        {% endif %}
        <span class="dtp-chip dtp-chip--live"><i></i><span class="l-en">LIVE</span><span class="l-zh">实时</span></span>
        <span class="dtp-asof"><span class="l-en">As of {{ hero.as_of or as_of }}</span><span class="l-zh">截至 {{ hero.as_of_zh or as_of_zh or as_of }}</span></span>
      </div>
      {% if hero.caveat_en %}<div class="mx-callout"><b class="l-en">Read the score with care:</b><b class="l-zh">读数注意：</b>
        <span class="l-en">{{ hero.caveat_en.split(':', 1)[1] if ':' in (hero.caveat_en or '') else hero.caveat_en }}</span>
        <span class="l-zh">{{ hero.caveat_zh.split('：', 1)[1] if '：' in (hero.caveat_zh or '') else hero.caveat_zh }}</span></div>{% endif %}
      <div class="bh-scorewrap" style="margin-top:14px">{{ gauge(vm.health.score, vm.health.color) }}
        <div class="chart-frame" style="flex:1;min-width:0">{% if charts.health %}{{ charts.health | safe }}{% else %}<div class="mx-skel" style="height:58px" aria-hidden="true"></div>{% endif %}</div>
      </div>
    </div>
    <div>
      <h2>{{ t('The yield curve', '收益率曲线') }} <span class="h2q">{{ t('— today vs 3 months / 1 year ago', '— 当前 vs 3月前 / 1年前') }}</span></h2>
      {% if charts.curve_now %}{{ charts.curve_now | safe }}{% else %}<div class="mx-skel" style="height:120px" aria-hidden="true"></div>{% endif %}
      {% if vm.curve.tax_en %}<p class="bh-curve-read"><b><span class="l-en">{{ vm.curve.tax_en }}</span><span class="l-zh">{{ vm.curve.tax_zh }}</span></b><span class="l-en"> — {{ vm.curve.tax_note_en }}</span><span class="l-zh"> — {{ vm.curve.tax_note_zh }}</span></p>{% endif %}
      <div style="margin-top:12px">
        {% if vm.curve.nyfed_prob is not none %}<span class="pill">{{ t('NY Fed recession odds', '纽约联储衰退概率') }} {{ vm.curve.nyfed_prob }}%</span>{% endif %}
        {% if vm.curve.spread_10y3m is not none %}<span class="pill">{{ t('10y−3m', '10年−3月') }} {{ '%+.2f'|format(vm.curve.spread_10y3m) }}pp</span>{% endif %}
      </div>
    </div>
  </header>

  <!-- ===================== L1-2 WHAT CHANGED ===================== -->
  <section class="band panel" id="changed" data-l1="changed">
    <div class="mx-sec"><h2 class="l-en">What changed</h2><h2 class="l-zh">最近变化</h2></div>
    {% if changed %}
    {% for row in changed %}
    <a class="mx-chg-row" href="{{ row.href }}">
      <span class="mx-chg-when tnum">{{ row.when }}</span>
      <span class="mx-chg-name">{{ t(row.name_en, row.name_zh) }}</span>
      <span class="mx-chg-what">{{ t(row.what_en, row.what_zh) }}</span>
      <span class="mx-stance mx-stance-muted"><span class="l-en">{{ row.stance_en }}</span><span class="l-zh">{{ row.stance_zh }}</span></span>
      <span class="mx-chg-chev">›</span>
    </a>
    {% endfor %}
    {% else %}
    <p class="mx-empty-line"><span class="l-en">No state changes in the last 120 days — the bond regime has been steady.</span><span class="l-zh">近120天无状态变化——债市格局保持平稳。</span></p>
    {% endif %}
  </section>

  <!-- ===================== L1-3 DRIVERS ===================== -->
  {% set g_curve = glance_map.get('#curve') %}
  {% set g_credit = glance_map.get('#credit') %}
  {% set g_real = glance_map.get('#real') %}
  {% set g_stress = glance_map.get('#stress') %}
  {% if compass %}
  {% set dur = compass.duration %}
  {% set BUCKET = {'lean_long': (C.green, 'Lean long duration', '偏多久期'), 'neutral': (C.muted, 'Neutral duration', '久期中性'), 'lean_short': (C.red, 'Lean short duration', '偏空久期')} %}
  {% set bk = BUCKET.get(dur.bucket, (C.muted, dur.bucket, dur.bucket)) %}
  {% set markpos = ((dur.lean + 1) / 2 * 100) if dur.lean is not none else 50 %}
  {% endif %}
  <section class="band" id="drivers" data-l1="drivers">
    <h2 class="band-label"><span class="l-en">Why — four drivers</span><span class="l-zh">为什么 — 四大驱动</span></h2>
    <div class="drivers">

      <div class="panel" id="curve">
        <div class="mx-sec"><h2 class="l-en">Curve &amp; growth</h2><h2 class="l-zh">曲线与增长</h2></div>
        <p class="drv-read"><b>{{ t((g_curve.state_en if g_curve else 'Normal'), (g_curve.state_zh if g_curve else '正常')) }}.</b>
          {{ t((g_curve.mean_en if g_curve else 'growth signal'), (g_curve.mean_zh if g_curve else '增长信号')) }}{% if fed_path and fed_path.headline_en %} · <span class="l-en">{{ fed_path.headline_en }}</span><span class="l-zh">{{ fed_path.headline_zh }}</span>{% endif %}</p>
        <div class="mtiles2">
          <div class="mtile"><div class="mtile-lbl">{{ t('Curve slope (10y−3m)', '曲线斜率（10年−3月）') }}</div><div class="mtile-val tnum">{% if vm.curve.spread_10y3m is not none %}{{ vm.curve.spread_10y3m }}pp{% else %}—{% endif %}</div></div>
          <div class="mtile"><div class="mtile-lbl">{{ t('Recession odds (NY Fed)', '衰退概率（纽约联储）') }}</div><div class="mtile-val tnum">{% if vm.curve.nyfed_prob is not none %}{{ vm.curve.nyfed_prob }}%{% else %}—{% endif %}</div></div>
          {% if fed_path and fed_path.implied and fed_path.implied.get('m12') is not none %}
          <div class="mtile"><div class="mtile-lbl">{{ t('Priced landing', '定价落点') }}</div><div class="mtile-val tnum">{{ '%.2f'|format(fed_path.implied.get('m12')) }}%</div></div>
          {% endif %}
        </div>
        {% if vm.curve.tax_en %}<p class="tax-note" style="margin-top:10px"><span class="l-en">{{ vm.curve.tax_en }}</span><span class="l-zh">{{ vm.curve.tax_zh }}</span></p>{% endif %}
        <span class="pill" style="margin-top:10px">{{ t('Other curve reads', '其他曲线读数') }}{{ lens('Near-term forward spread ' ~ vm.curve.ntfs ~ 'pp — the front-end version of the slope, cleaner when markets are pricing Fed cuts. 2s10s ' ~ vm.curve.spread_2s10s ~ 'pp — the 2-year against the 10-year. Term-premium-adjusted slope ' ~ vm.curve.curve_tp_adj ~ 'pp — the slope with low-term-premium noise removed.', '近端远期利差 ' ~ vm.curve.ntfs ~ 'pp——斜率的前端版本，在市场为降息定价时更清晰。2年/10年利差 ' ~ vm.curve.spread_2s10s ~ 'pp——2年期对10年期。期限溢价调整斜率 ' ~ vm.curve.curve_tp_adj ~ 'pp——剔除低期限溢价噪音后的斜率。') }}</span>
        <div class="dtp-asof" style="margin-top:10px"><span class="l-en">As of {{ as_of }}</span><span class="l-zh">截至 {{ as_of_zh or as_of }}</span></div>
      </div>

      <div class="panel" id="credit">
        <div class="mx-sec"><h2 class="l-en">Credit</h2><h2 class="l-zh">信用</h2></div>
        <p class="drv-read"><b>{{ t((g_credit.state_en if g_credit else vm.credit.band_en), (g_credit.state_zh if g_credit else vm.credit.band_zh)) }}.</b>
          {{ t((g_credit.mean_en if g_credit else 'risk appetite'), (g_credit.mean_zh if g_credit else '风险偏好')) }}{% if cc_vm is defined %} · <span class="l-en">{{ cc_vm.hero.subtitle_en }}</span><span class="l-zh">{{ cc_vm.hero.subtitle_zh }}</span> <a href="#corpcredit">{{ t('Corporate bond desk →', '公司债观察台 →') }}</a>{% endif %}</p>
        <div class="mtiles2">
          <div class="mtile"><div class="mtile-lbl">{{ t('HY OAS', '高收益利差') }}</div><div class="mtile-val tnum">{% if vm.credit.hy_oas is not none %}{{ vm.credit.hy_oas }}%{% else %}—{% endif %}</div></div>
          <div class="mtile"><div class="mtile-lbl">{{ t('IG OAS', '投资级利差') }}</div><div class="mtile-val tnum">{% if vm.credit.ig_oas is not none %}{{ vm.credit.ig_oas }}%{% else %}—{% endif %}</div></div>
          <div class="mtile"><div class="mtile-lbl">{{ t('Excess bond premium', '超额债券溢价') }}</div><div class="mtile-val tnum">{% if vm.credit.ebp is not none %}{{ vm.credit.ebp }}%{% else %}—{% endif %}</div></div>
        </div>
        <div class="dtp-asof" style="margin-top:10px"><span class="l-en">As of {{ as_of }}</span><span class="l-zh">截至 {{ as_of_zh or as_of }}</span></div>
      </div>

      <div class="panel" id="real">
        <span id="compass"></span>
        <div class="mx-sec"><h2 class="l-en">Real rates &amp; duration</h2><h2 class="l-zh">实际利率与久期</h2></div>
        <p class="drv-read"><b>{{ t((g_real.state_en if g_real else '—'), (g_real.state_zh if g_real else '—')) }}.</b>
          {{ t((g_real.mean_en if g_real else ''), (g_real.mean_zh if g_real else '')) }}</p>
        <div class="mtiles2">
          <div class="mtile"><div class="mtile-lbl">{{ t('10y real (TIPS)', '10年实际利率') }}</div><div class="mtile-val tnum">{% if vm.real.real_10y is not none %}{{ vm.real.real_10y }}%{% else %}—{% endif %}</div></div>
          <div class="mtile"><div class="mtile-lbl">{{ t('10y breakeven', '10年盈亏平衡') }}</div><div class="mtile-val tnum">{% if vm.real.breakeven_10y is not none %}{{ vm.real.breakeven_10y }}%{% else %}—{% endif %}</div></div>
          {% if compass %}
          <div class="mtile">
            <div class="mtile-lbl">{{ t(bk[1], bk[2]) }}{{ lens('Blended duration lean ' ~ ('%+.2f'|format(dur.lean) if dur.lean is not none else '—') ~ ' on a scale from −1 (lean short) to +1 (lean long); ' ~ ((dur.agreement*100)|round|int if dur.agreement is not none else '—') ~ '% of the five factors point the same way.', '久期倾向综合分 ' ~ ('%+.2f'|format(dur.lean) if dur.lean is not none else '—') ~ '，量表由 −1（偏空）到 +1（偏多）；五项因子中 ' ~ ((dur.agreement*100)|round|int if dur.agreement is not none else '—') ~ '% 指向同一方向。') }}</div>
            <div class="mtile-val" style="font-size:13px;font-weight:700">{{ t(agree_en if agree_en is defined else 'factors are split', agree_zh if agree_zh is defined else '各因子存在分歧') }}</div>
          </div>
          {% endif %}
        </div>
        {% if compass and dur.legs %}
        <p class="sub faint" style="margin:10px 0 4px">{{ t('Each factor scored 0–100: 0 argues to be short duration, 100 to be long.', '各因子评分 0–100：0=支持偏空久期，100=支持偏多久期。') }}</p>
        <div class="legs">
          {% for leg in dur.legs %}
          {% set v = leg.value %}{% set score100 = ((v + 1) / 2 * 100) if v is not none else none %}
          {% set lab = LEG_LAB.get(leg.key, (leg.label_en, leg.label_zh)) %}
          {% set tip = LEG_TIP.get(leg.key, (leg.note_en, leg.note_zh)) %}
          <div class="leg"><span class="lname">{{ t(lab[0], lab[1]) }}{{ lens(tip[0], tip[1]) }}</span>
            <span class="lbar"><span class="lfill" style="width:{{ score100|round(1) if score100 is not none else 0 }}%;background:{{ C.green if v > 0.15 else (C.red if v < -0.15 else C.muted) }}"></span></span>
            <span class="lval">{{ score100|round(1) if score100 is not none else '—' }}</span></div>
          {% endfor %}
        </div>
        <div class="flag info" style="margin-top:10px">ℹ {{ t('Context only. The same factors helped most with drawdown control, not precise return timing.', '仅供参考。同类因子主要帮助控制回撤，而非精确择时收益。') }}</div>
        {% endif %}
        <div class="dtp-asof" style="margin-top:10px"><span class="l-en">As of {{ as_of }}</span><span class="l-zh">截至 {{ as_of_zh or as_of }}</span></div>
      </div>

      <div class="panel" id="stress">
        <div class="mx-sec"><h2 class="l-en">Stress &amp; the hedge</h2><h2 class="l-zh">压力与对冲</h2></div>
        <p class="drv-read"><b>{{ t(vm.stress.band_en, vm.stress.band_zh) }}.</b>
          {{ t('Rates vol ' ~ (vm.stress.band_en or '') ~ '; the stock-bond hedge is ' ~ (vm.cross.regime_en or ''), '利率波动' ~ (vm.stress.band_zh or '') ~ '；股债对冲为' ~ (vm.cross.regime_zh or '')) }}</p>
        <div class="mtiles2">
          <div class="mtile"><div class="mtile-lbl">{{ t('MOVE (rates vol)', 'MOVE 利率波动') }}</div><div class="mtile-val tnum">{% if vm.stress.move is not none %}{{ vm.stress.move }}{% else %}—{% endif %}</div></div>
          <div class="mtile"><div class="mtile-lbl">{{ t('SOFR − IORB', 'SOFR − 准备金利率') }}</div><div class="mtile-val tnum">{% if vm.stress.sofr_iorb_bp is not none %}{{ vm.stress.sofr_iorb_bp }}bp{% else %}—{% endif %}</div></div>
          <div class="mtile"><div class="mtile-lbl">{{ t('Stock-bond corr', '股债相关') }}</div><div class="mtile-val tnum">{% if vm.cross.corr is not none %}{{ vm.cross.corr }}{% else %}—{% endif %}</div></div>
        </div>
        {% if vm.health.stress_legs %}
        <div class="legs" style="margin-top:12px">
          {% for leg in vm.health.stress_legs %}
          <div class="leg"><span class="lname">{{ t(leg.en, leg.zh) }}</span>
            <span class="lbar"><span class="lfill" style="width:{{ leg.val }}%;background:{{ C.green if leg.val < 50 else C.amber if leg.val < 75 else C.red }}"></span></span>
            <span class="lval">{{ leg.val }}{% if leg.vg[0] %}{% set vgt = VG_TIP.get(leg.vg[1], ('','')) %}<span class="lvg vg-{{ leg.vg[1] }}">{{ leg.vg[0] }}</span>{{ lens(vgt[0], vgt[1]) }}{% endif %}</span></div>
          {% endfor %}
        </div>
        {% endif %}
        {% if vm.health.calib %}
        <div class="measured-edge"><span class="pill">{{ t('Measured', '已校准') }}{% if vm.health.calib.ic_recession is not none and vm.health.calib.span and vm.health.calib.n %}{{ lens('Recession-IC ' ~ vm.health.calib.ic_recession ~ ' — rank correlation between this stress reading and recessions ' ~ vm.health.calib.ic_horizon_en ~ ' ahead. 1.0 = perfect ordering, 0 = none. Window ' ~ vm.health.calib.span ~ ', n=' ~ vm.health.calib.n ~ '.', '衰退IC ' ~ vm.health.calib.ic_recession ~ ' — 该压力读数与未来' ~ vm.health.calib.ic_horizon_zh ~ '衰退的秩相关。1.0=完全一致，0=无关。样本区间' ~ vm.health.calib.span ~ '，n=' ~ vm.health.calib.n ~ '。') }}{% else %}{{ lens('Recession-IC ' ~ vm.health.calib.ic_recession ~ ' — a rank-correlation score for how well this reading has ordered recession risk. Higher is better; 1.0 is perfect.', '衰退IC ' ~ vm.health.calib.ic_recession ~ ' — 该读数对衰退风险排序能力的秩相关评分。数值越高越好，1.0 为完全准确。') }}{% endif %}</span>
          {{ t('top-stress readings were followed by a 10%+ S&P drawdown within 63 days', '压力最高档读数之后，63天内出现标普10%+回撤的概率为') }}
          <b>{{ vm.health.calib.hi_dd10 }}%</b> {{ t('of the time vs a', '，而基准为') }} <b>{{ vm.health.calib.base_dd10 }}%</b><span class="l-en"> baseline</span>
          (<b>{% if (vm.health.calib.edge_pp or 0) >= 0 %}+{% endif %}{{ vm.health.calib.edge_pp }}pp</b>).
          <span class="faint">{{ t('Glyphs: ✓ measured · ~ directional · · context.', '符号：✓ 已校准 · ~ 有方向 · · 仅背景。') }}</span></div>
        {% endif %}
        <div class="dtp-asof" style="margin-top:10px"><span class="l-en">As of {{ as_of }}</span><span class="l-zh">截至 {{ as_of_zh or as_of }}</span></div>
      </div>
    </div>
    <details style="margin-top:14px">
      <summary>{{ t('How these four drivers are scored', '这四项驱动如何评分') }}</summary>
      <p class="note" style="margin-top:8px">{{ t('Start with the health score, then check which leg is driving it: curve, credit, real rates, rates volatility, funding stress or stock-bond correlation.', '先看健康度评分，再看驱动分项：曲线、信用、实际利率、利率波动、资金压力或股债相关性。') }}
      <a href="#how-to-read">{{ t('How to read this page →', '如何解读本页 →') }}</a></p>
    </details>
  </section>

  <!-- curve-trade card moved to landing #rates-curve; keep vars for that landing -->
  {% if compass %}
  {% set ct = compass.curve_trade %}
  {% set CT = {'steepener': (C.amber, 'Steepener bias', '偏陡峭'), 'flattener': (C.teal, 'Flattener bias', '偏平坦'), 'neutral': (C.muted, 'Neutral', '中性')} %}
  {% set ctc = CT.get(ct.lean, (C.muted, ct.lean, ct.lean)) %}
  {% endif %}
  <!-- ===================== L1-4 WORLD ===================== -->
  <section class="band" id="world" data-l1="world">
    <h2 class="band-label"><span class="l-en">Bonds &amp; the world</span><span class="l-zh">债券与全球市场</span></h2>
    {% if intl %}
    {% set g = intl.global %}{% set uw = intl.us_vs_world %}
    {% set GDIR = {
      'rising': (C.red, 'rising', '上行', 'tightening', '在收紧', '且持续上行'),
      'falling': (C.green, 'falling', '下行', 'easing', '在放松', '且持续下行'),
      'stable': (C.muted, 'stable', '平稳', 'steady', '持稳', '且走势平稳')
    } %}
    {% set gd = GDIR.get(g.direction) %}
    {% set GAPDIR = {'rising': ('widening', '走阔'), 'falling': ('narrowing', '收窄'), 'stable': ('stable', '平稳')} %}
    {% set gapw = GAPDIR.get(uw.premium_direction, ('unresolved', '待确认')) %}
    {% set emw = GAPDIR.get(intl.em.direction if intl.em else none, ('unresolved', '待确认')) %}
    <p class="drv-read"><b>{% if gd %}<span class="l-en">Global 10-year yields average {{ g.avg_10y }}% and are {{ gd[1] }} — the world is {{ gd[3] }}.</span><span class="l-zh">全球10年期收益率均值{{ g.avg_10y }}%{{ gd[5] }}——全球融资成本{{ gd[4] }}。</span>{% else %}<span class="l-en">Global 10-year yields average {{ g.avg_10y }}% — world direction still reading.</span><span class="l-zh">全球10年期收益率均值{{ g.avg_10y }}%——全球方向仍在读数。</span>{% endif %}</b></p>
    <div style="margin:6px 0 10px">
      <span class="band-chip" style="background:{{ (gd[0] if gd else C.muted) }}">{{ t('Global 10y', '全球10年期') }} {{ g.avg_10y }}% · {{ t((gd[1] if gd else 'unresolved'), (gd[2] if gd else '待定')) }} {{ '%+.0f'|format(g.avg_10y_chg_63d_bp) if g.avg_10y_chg_63d_bp is not none else '' }}bp/3m</span>
      {% if uw.us_premium_bp is not none %}<span class="band-chip" style="background:{{ C.blue }};margin-left:6px">{{ t('US vs world', '美国 vs 世界') }} {{ '%+.0f'|format(uw.us_premium_bp) }}bp{{ lens('The US 10-year sits ' ~ ('%+.0f'|format(uw.us_premium_bp)) ~ 'bp above the GDP-weighted rest of the world and the gap is ' ~ gapw[0] ~ ' — the dollar rate-differential anchor. Emerging-market hard-currency spread ' ~ (intl.em.em_oas if intl.em and intl.em.em_oas is not none else '—') ~ '% (' ~ emw[0] ~ ').', '美国10年期较GDP加权的世界其余部分高' ~ ('%+.0f'|format(uw.us_premium_bp)) ~ '基点，且利差' ~ gapw[1] ~ '——这是美元的利差之锚。新兴市场硬通货利差' ~ (intl.em.em_oas if intl.em and intl.em.em_oas is not none else '—') ~ '%（' ~ emw[1] ~ '）。') }}</span>{% endif %}
    </div>
    <div class="sc-wrap"><div class="sc-scroll">
    <table class="sc-tbl">
      <tr>
        <th>{{ t('sovereign', '主权') }}</th>
        <th>{{ t('10y', '10年') }}</th>
        <th>{{ t('real', '实际') }}</th>
        <th>{{ t('slope', '斜率') }}</th>
        <th>{{ t('3m Δ', '3月变化') }}</th>
        <th>{{ t('vs 1-yr normal', '对比一年常态') }}{{ lens("How far today's yield sits from its own past-year average, in standard deviations. +1 = one standard deviation above; 0 = exactly average.", '当前收益率偏离自身过去一年均值的程度，以标准差计。+1 = 高出一个标准差；0 = 正好等于均值。') }}</th>
        <th>{{ t('vs US', '对美') }}</th>
        <th>{{ t('curve', '曲线') }}</th>
      </tr>
      {% set SST = {'steep': (C.amber, 'steep', '陡峭'), 'normal': (C.blue, 'normal', '正常'), 'flat': (C.muted, 'flat', '平坦'), 'inverted': (C.red, 'inverted', '倒挂')} %}
      {% set DIR = {'rising': C.red, 'falling': C.green, 'stable': C.muted} %}
      {% for r in intl.countries %}
      {% set ss = SST.get(r.slope_state, (C.muted, r.slope_state or '—', r.slope_state or '—')) %}
      <tr>
        <td class="cty"><span class="dot" style="background:{{ {'US':C.blue,'DE':C.amber,'JP':C.red,'GB':C.teal,'CA':C.indigo,'AU':C.gold,'CH':C.muted}.get(r.code, C.muted) }}"></span>{{ t(r.en, r.zh) }}{% if r.stale %}<span class="stale-tag">{{ t('lag','滞后') }}{{ lens('OECD monthly series — lags ~1 month', 'OECD月度序列 · 滞后约1个月') }}</span>{% elif r.cadence == 'monthly' %}<span class="faint" style="font-size:10px;margin-left:4px">{{ t('mo','月') }}</span>{% endif %}</td>
        <td><b>{{ '%.2f'|format(r.y10) }}%</b></td>
        <td>{{ ('%.2f'|format(r.real_10y) ~ '%') if r.real_10y is not none else '—' }}</td>
        <td>{{ ('%+.2f'|format(r.slope)) if r.slope is not none else '—' }}</td>
        <td style="color:{{ DIR.get(r.direction, C.muted) }}">{{ ('%+.0f'|format(r.chg_63d_bp) ~ 'bp') if r.chg_63d_bp is not none else '—' }}</td>
        <td>{{ ('%+.1f'|format(r.z1y)) if r.z1y is not none else '—' }}</td>
        <td style="color:{{ C.green if (r.diff_vs_us_bp or 0) < 0 else C.text }}">{{ ('%+.0f'|format(r.diff_vs_us_bp)) if r.diff_vs_us_bp is not none else '—' }}</td>
        <td><span class="mini-tag" style="background:{{ ss[0] }}">{{ t(ss[1], ss[2]) }}</span></td>
      </tr>
      {% endfor %}
      {% if intl.em and intl.em.em_oas is not none %}
      <tr>
        <td class="cty"><span class="dot" style="background:{{ C.gold }}"></span>{{ t('EM (hard-ccy OAS)', '新兴市场（硬通货利差）') }}</td>
        <td><b>{{ '%.2f'|format(intl.em.em_oas) }}%</b></td>
        <td colspan="2" style="text-align:left;color:var(--muted)">{{ t('pctile', '百分位') }} {{ intl.em.pctile }}%{% if intl.em.emb_trend %} · EMB {{ t(intl.em.emb_trend, {'up':'上行','down':'下行'}.get(intl.em.emb_trend,'')) }}{% endif %}</td>
        <td style="color:{{ DIR.get(intl.em.direction, C.muted) }}">{{ t(intl.em.direction or '', {'rising':'走阔','falling':'收窄','stable':'平稳'}.get(intl.em.direction,'')) }}</td>
        <td colspan="3"></td>
      </tr>
      {% endif %}
    </table>
    </div></div>
    <div class="sub faint" style="margin-top:8px">{{ t('Level = 10y yield. Real = 10y minus market-priced inflation. Slope = curve shape. 3m Δ = 63-day move. vs 1-yr normal = standard deviations from its own past-year average. vs US = 10y rate gap. Monthly OECD series are tagged.', '水平=10年收益率；实际=10年减去市场定价通胀；斜率=曲线形态；3月变化=63日变动；对比一年常态=较自身过去一年均值的标准差；对美=10年利差。OECD月度序列已标注。') }}</div>
    <p style="margin-top:8px"><a href="#global-detail">{{ t('All sovereign yields →', '全部主权收益率 →') }}</a></p>
    {% endif %}
    {% if xasset_vm %}
    <p class="drv-read" style="margin-top:16px"><b><span class="l-en">Bonds are a tailwind for {{ n_tailwind }} markets and a headwind for {{ n_headwind }}.</span><span class="l-zh">当前债券为{{ n_tailwind }}个市场提供顺风，对{{ n_headwind }}个市场构成逆风。</span></b></p>
    <ul class="world-list">
      {% for a in xasset_vm.assets[:8] %}
      <li><span>{{ t(a.en, a.zh) }}</span><span style="color:{{ a.vcolor }}">{{ t(a.verdict_en, a.verdict_zh) }}</span></li>
      {% endfor %}
    </ul>
    <p style="margin-top:8px"><a href="transmission.html">{{ t('Bonds → each market →', '债券 → 各市场 →') }}</a></p>
    {% endif %}
  </section>

  <!-- ===================== L1-5 WATCHING ===================== -->
  <section class="band" id="watching" data-l1="watching">
    <h2 class="band-label"><span class="l-en">What we’re watching</span><span class="l-zh">我们在盯什么</span></h2>
    <div class="watch">
      {% for w in watching %}
      <div class="panel watch-cond">
        <b>{{ t(w.cond_en, w.cond_zh) }}</b>
        <span>{{ t(w.then_en, w.then_zh) }}</span>
      </div>
      {% endfor %}
    </div>
    <p class="watch-foot l-en">Windows, not certainties — re-drawn nightly.</p>
    <p class="watch-foot l-zh">是窗口，不是定论——每晚重新校准。</p>
  </section>

  <!-- ===================== L1-6 GO DEEPER ===================== -->
  <section class="band" id="deeper" data-l1="deeper">
    <h2 class="band-label"><span class="l-en">Go deeper</span><span class="l-zh">深入研究</span></h2>
    <div class="depth">
      <a href="#corpcredit"><span class="l-en">Corporate bond desk</span><span class="l-zh">公司债观察台</span><small>→</small></a>
      <a href="#rates-curve"><span class="l-en">Rates &amp; curve detail</span><span class="l-zh">利率与曲线详情</span><small>→</small></a>
      <a href="#fed-path"><span class="l-en">Fed path &amp; policy</span><span class="l-zh">美联储路径与政策</span><small>→</small></a>
      <a href="#global-detail"><span class="l-en">Global rates &amp; sovereign detail</span><span class="l-zh">全球利率与主权详情</span><small>→</small></a>
      <a href="transmission.html"><span class="l-en">Bonds → each market</span><span class="l-zh">债券 → 各市场</span><small>→</small></a>
      <a href="#supply"><span class="l-en">Treasury supply &amp; absorption</span><span class="l-zh">美债供给与吸收</span><small>→</small></a>
      <a href="#timeline"><span class="l-en">State changes · last 120 days</span><span class="l-zh">状态变化 · 近120天</span><small>→</small></a>
      <a href="#how-to-read"><span class="l-en">How to read this page</span><span class="l-zh">如何解读本页</span><small>→</small></a>
    </div>
  </section>

  <!-- ===================== LANDINGS (demoted, not deleted) ===================== -->
  {% if compass %}
  <section class="landing" id="rates-curve">
    <p class="landing-kicker">{{ t('Rates & curve detail', '利率与曲线详情') }}</p>
    <div class="card">
      <h2>{{ t('Curve trade & expected return', '曲线交易与预期回报') }}</h2>
      {% set ct = compass.curve_trade %}
      {% set CT = {'steepener': (C.amber, 'Steepener bias', '偏陡峭'), 'flattener': (C.teal, 'Flattener bias', '偏平坦'), 'neutral': (C.muted, 'Neutral', '中性')} %}
      {% set ctc = CT.get(ct.lean, (C.muted, ct.lean, ct.lean)) %}
      <div style="margin:8px 0 4px"><span class="bias-chip" style="background:{{ ctc[0] }}">{{ t('Curve', '曲线') }} · {{ t(ctc[1], ctc[2]) }}</span></div>
      <p class="tax-note"><span class="l-en">{{ ct.rationale_en }}</span><span class="l-zh">{{ ct.rationale_zh }}</span></p>
      {% if compass.expected %}
      {% set ex = compass.expected %}
      <div class="kpis" style="margin-top:14px">
        {{ kpi('10y carry', '10年套息', ex.carry_pct, '%') }}
        {{ kpi('Roll-down (1y)', '滚动收益(1年)', ex.rolldown_pct, '%') }}
        {{ kpi('Carry + roll', '套息+滚动', ex.carry_roll_pct, '%') }}
        {{ kpi('Yield-rise cushion', '收益率上行缓冲', ex.cushion_bp, 'bp') }}
      </div>
      <div class="sub faint" style="margin-top:8px">{{ t('Cushion = how much the 10y yield can rise before one year of carry + roll-down is erased (duration ≈ ' ~ ex.duration ~ ').', '缓冲 = 10年期收益率还能上行多少，才会抹掉一年套息+滚动收益（久期约 ' ~ ex.duration ~ '）。') }}</div>
      {% endif %}
      <div class="sub" style="margin-top:12px"><b><span class="l-en">{{ compass.verdict_en }}</span><span class="l-zh">{{ compass.verdict_zh }}</span></b></div>
    </div>
    <div class="card" style="margin-top:14px">
      <h2>{{ t('Recession spreads & TP-adjusted slope', '衰退利差与期限溢价调整斜率') }}</h2>
    <div class="kpis">
      {{ kpi('10y−3m (NY Fed)', '10年−3月（纽约联储）', vm.curve.spread_10y3m, 'pp') }}
      {{ kpi('Near-term fwd spread', '近端远期利差', vm.curve.ntfs, 'pp') }}
      {{ kpi('2s10s', '2年/10年', vm.curve.spread_2s10s, 'pp') }}
      {{ kpi('TP-adjusted slope', '期限溢价调整斜率', vm.curve.curve_tp_adj, 'pp') }}
      {{ kpi('NY Fed recession prob', '纽约联储衰退概率', vm.curve.nyfed_prob, '%') }}
    </div>
    <div style="margin-top:14px">
      <span class="band-chip" style="background:{{ vm.curve.tax_color }}"><span class="l-en">{{ vm.curve.tax_en }}</span><span class="l-zh">{{ vm.curve.tax_zh }}</span></span>
      <span class="tax-note"><span class="l-en">{{ vm.curve.tax_note_en }}</span><span class="l-zh">{{ vm.curve.tax_note_zh }}</span></span>
    </div>
    {% if vm.curve.bull_steepener_uninversion %}
    <div class="flag alarm">⚑ {{ t('Bull-steepening un-inversion — the curve dis-inverted while short rates fall (cuts being priced). Historically the late-cycle handoff: recessions have begun ~13 months (range ~8–19) after the curve re-steepens.', '牛市陡峭式解除倒挂 — 曲线在短端利率下行（市场定价降息）时解除倒挂。历史上为周期晚段交接：衰退在曲线重新陡峭后约13个月（区间约8–19个月）开始。') }}</div>
    {% elif vm.curve.uninversion %}
    <div class="flag warn">⚑ {{ t('Curve un-inverted after a prior inversion — the dis-inversion, not the inversion, tends to lead recession.', '曲线在此前倒挂后解除 — 引领衰退的往往是解除倒挂而非倒挂本身。') }}</div>
    {% elif vm.curve.tp_adj_inverted %}
    <div class="flag warn">⚑ {{ t('Term-premium-adjusted curve is inverted (a "real" inversion, not a low-term-premium artifact).', '期限溢价调整后的曲线倒挂（“真实”倒挂，非低期限溢价造成的假象）。') }}</div>
    {% endif %}
    <div style="margin-top:16px">
      <div class="sub" style="margin-bottom:4px">{{ t('Recession spreads & TP-adjusted slope over time — zero = flat, below zero = inverted', '衰退利差与期限溢价调整斜率走势 · 0=平坦，负值=倒挂') }}</div>
      {{ charts.spreads | safe }}
    </div>
    <div class="sub faint" style="margin-top:8px">{{ t('10y−3m feeds the NY Fed model. The near-term forward spread is cleaner when markets price Fed cuts. The TP-adjusted slope removes low-term-premium noise.', '10年−3月用于纽约联储模型。近端远期利差更能反映降息定价。期限溢价调整斜率剔除低期限溢价噪音。') }}</div>
    </div>
  </section>
  {% endif %}

  <!-- ===================== LANDING: FED PATH ===================== -->
  {% if fed_path %}
  <section class="landing" id="fed-path">
    <p class="landing-kicker">{{ t('Fed path & policy', '美联储路径与政策') }}</p>
  <div class="card">
    <h2>{{ t('Where the market prices the funds rate — and where the Fed projects it', '市场为基金利率定价之处 · 以及美联储的预测') }}</h2>
    {% if fed_path.headline_en %}<div class="sub" style="margin:2px 0 8px"><b><span class="l-en">{{ fed_path.headline_en }}</span><span class="l-zh">{{ fed_path.headline_zh }}</span></b></div>{% endif %}
    {% if fed_path.gap %}
    <div style="margin:6px 0 10px">
      <span class="band-chip" style="background:var(--muted)">{{ fed_path.gap.horizon_label }} · {{ t('market', '市场') }} {{ '%.2f'|format(fed_path.gap.market) }}% · {{ t('Fed dot', '美联储点阵') }} {{ '%.2f'|format(fed_path.gap.fed_dot) }}%</span>
      <span class="pill"><span class="l-en">{{ '%+d'|format(fed_path.gap.gap_bp) }}bp · {{ fed_path.gap.lean_en }}</span><span class="l-zh">{{ '%+d'|format(fed_path.gap.gap_bp) }}基点 · {{ fed_path.gap.lean_zh }}</span></span>
    </div>
    {% endif %}
    <div class="kpis">
      {{ kpi('Target range', '目标区间', (('%.2f'|format(fed_path.target_low)) ~ '–' ~ ('%.2f'|format(fed_path.target_high))) if fed_path.target_low is not none else none, '%') }}
      {{ kpi('EFFR (policy now)', '有效联邦基金利率', fed_path.policy_rate, '%') }}
      {{ kpi('Implied 12m', '隐含12个月', fed_path.implied.get('m12'), '%') }}
      {{ kpi('Implied 25bp moves (12m)', '隐含25基点变动(12月)', fed_path.implied_cuts_12m, '', t('+ = cuts', '正=降息')) }}
      {{ kpi('Near-term fwd spread', '近端远期利差', fed_path.ntfs, 'pp') }}
      {{ kpi('us2y − funds', 'us2y − 基金利率', fed_path.rate_exp_proxy, 'pp') }}
    </div>
    {% if fed_path.implied_source_en %}<div class="sub faint" style="margin-top:6px">{{ t('Implied path source', '隐含路径来源') }}: <span class="l-en">{{ fed_path.implied_source_en }}</span><span class="l-zh">{{ fed_path.implied_source_zh }}</span></div>{% endif %}
    {% if charts.policy_path %}<div style="margin-top:14px">{{ charts.policy_path | safe }}</div>{% endif %}
    {% if fed_path.read_en %}<div class="sub" style="margin-top:8px"><span class="l-en">{{ fed_path.read_en }}</span><span class="l-zh">{{ fed_path.read_zh }}</span></div>{% endif %}
    <div class="sub faint" style="margin-top:8px">{{ t('Market-implied rates are prices, not forecasts. Use this as policy-path context.', '市场隐含利率是价格，不是预测。此处仅作政策路径背景。') }}</div>
  </div>
  </section>
  {% endif %}

  <!-- ===================== LANDING extras: credit/real charts (not L1) ===================== -->
  <div class="sec-head">{{ t('Credit & real rates — detail', '信用与实际利率 · 详情') }}</div>
  <div class="grid cols-2">
    <div class="card">
      <h2>{{ t('Credit — the "smart money" canary', '信用 · “聪明钱”预警') }}</h2>
      <div style="margin:6px 0 4px"><span class="band-chip" style="background:{{ vm.credit.band_color }}">{{ t(vm.credit.band_en, vm.credit.band_zh) }}</span>
        {% if vm.credit.direction %}<span class="pill"><span class="l-en">{{ vm.credit.direction }}</span><span class="l-zh">{{ vm.credit.direction_zh }}</span></span>{% endif %}</div>
      <div class="kpis">
        {{ kpi('HY OAS', '高收益OAS', vm.credit.hy_oas, '%') }}
        {{ kpi('IG OAS', '投资级OAS', vm.credit.ig_oas, '%') }}
        {{ kpi('HY / IG ratio', '高收益/投资级', vm.credit.hy_ig_ratio, '×') }}
        {{ kpi('Baa−Aaa', 'Baa−Aaa', vm.credit.baa_aaa, '%') }}
        {{ kpi('Excess bond premium', '超额债券溢价', vm.credit.ebp, '%') }}
        {{ kpi('HY %ile (2y)', '高收益百分位(2年)', vm.credit.pctile, '%') }}
      </div>
      <div style="margin-top:14px">{{ charts.credit | safe }}</div>
      <div class="sub faint" style="margin-top:6px">{{ t('HY OAS shows default stress; EBP is the extra spread not explained by default risk. Credit usually weakens before equities.', '高收益OAS显示违约压力；EBP是违约风险解释不了的额外利差。信用通常早于股票走弱。') }}</div>
    </div>
    <div class="card">
      <h2>{{ t('Real rates & inflation — the discount rate', '实际利率与通胀 · 贴现率') }}</h2>
      <div class="kpis" style="margin-top:2px">
        {{ kpi('10y real (TIPS)', '10年实际利率', vm.real.real_10y, '%') }}
        {{ kpi('5y real', '5年实际利率', vm.real.real_5y, '%') }}
        {{ kpi('10y breakeven', '10年盈亏平衡通胀', vm.real.breakeven_10y, '%') }}
        {{ kpi('5y5y fwd breakeven', '5年5年远期通胀', vm.real.breakeven_5y5y, '%') }}
        {{ kpi('Term premium', '期限溢价', vm.real.term_premium, '%') }}
      </div>
      {% if vm.real.tp_positive %}<div class="flag info">ℹ {{ t('Term premium repriced positive (the 2023–25 shift) — more of any long-yield move is now supply / fiscal / risk, a bear-steepening force.', '期限溢价重新定价转正（2023–25年的转变）——长端收益率变动中更多源于供给/财政/风险，构成熊市陡峭力量。') }}</div>{% endif %}
      <div style="margin-top:14px">{{ charts.real | safe }}</div>
      {% if charts.tp_decomp %}
      <div class="sub" style="margin:12px 0 4px">{{ t('10y yield decomposed — real + breakeven = nominal, term premium overlaid', '10年收益率分解 · 实际+盈亏平衡=名义，叠加期限溢价') }}</div>
      {{ charts.tp_decomp | safe }}
      {% endif %}
      <div class="sub faint" style="margin-top:6px">{{ t('Real yields are the discount rate; breakevens are the inflation read; term premium is the extra reward for duration risk.', '实际利率是贴现率；盈亏平衡通胀是通胀读数；期限溢价是承担久期风险的额外回报。') }}</div>
    </div>
  </div>

  <!-- ===================== CCW-W4: CORPORATE CREDIT DESK ===================== -->
<style>
/* ── CCW-W4 corporate credit desk — page-scoped styles ───────────────────── */
/* card base overrides (bonds.html already defines .card; these extend it) */
.cc-sec-head{font-size:12px;font-weight:700;color:var(--ink);text-transform:uppercase;letter-spacing:.05em;margin:26px 0 12px;padding-bottom:6px;border-bottom:1px solid var(--grid)}
/* 3px top-stripe severity accent — uses severity tokens (--red/--amber/--green/--faint)
   NOT direction tokens, so zh directional colour swap NEVER fires here (R13). */
.cs-card{position:relative;overflow:hidden}
.cs-card::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;border-radius:16px 16px 0 0;pointer-events:none;opacity:0}
.cs-amber::before{background:linear-gradient(90deg,var(--amber),color-mix(in srgb,var(--amber) 30%,transparent));opacity:1}
.cs-red::before{background:linear-gradient(90deg,var(--red),color-mix(in srgb,var(--red) 30%,transparent));opacity:1}
.cs-calm::before{background:linear-gradient(90deg,var(--green),color-mix(in srgb,var(--green) 30%,transparent));opacity:1}
.cs-neutral::before{background:linear-gradient(90deg,var(--faint),color-mix(in srgb,var(--faint) 30%,transparent));opacity:1}
/* hero */
.cc-hero-state{font-size:40px;font-weight:800;letter-spacing:-.02em;margin:6px 0 4px;line-height:1;color:var(--ink)}
.cc-verdict-lead{font-size:15px;color:var(--text);line-height:1.5;margin:8px 0 0}
.cc-as-of{font-size:12px;color:var(--faint);margin-top:8px}
/* stance pill — severity, not direction */
.stance-pill{display:inline-block;padding:5px 16px;border-radius:999px;font-size:14px;font-weight:700;color:#fff;letter-spacing:.02em;margin:6px 0}
.stance-amber{background:var(--ink-warn, var(--amber));color:#fff}
.stance-red{background:var(--ink-act, var(--red))}
.stance-calm{background:var(--ink-ok, var(--green))}
.stance-neutral{background:var(--faint);color:#fff}
/* market strip chips */
.cc-mkt-strip{display:flex;flex-wrap:wrap;gap:10px;margin-top:4px}
.cc-mkt-chip{display:inline-flex;flex-direction:column;gap:2px;padding:10px 14px;border-radius:12px;border:1px solid var(--grid);background:var(--card);cursor:help;flex:1;min-width:160px}
.cc-mkt-chip .chip-label{font-size:13px;font-weight:700;color:var(--ink)}
/* Bottom-align the sub-line: chip labels are state-dependent copy that changes
   nightly, so some wrap to two lines at a given chip width and others don't.
   margin-top:auto pins every sub to the foot of its (equal-height) chip, keeping
   the row of values on one baseline whatever the labels do. */
.cc-mkt-chip .chip-sub{font-size:11px;color:var(--muted);margin-top:auto}
.cc-mkt-chip.chip-amber{border-color:color-mix(in srgb,var(--amber) 55%,var(--grid));background:color-mix(in srgb,var(--amber) 7%,var(--card))}
.cc-mkt-chip.chip-red{border-color:color-mix(in srgb,var(--red) 45%,var(--grid));background:color-mix(in srgb,var(--red) 6%,var(--card))}
.cc-mkt-chip.chip-calm{border-color:color-mix(in srgb,var(--green) 40%,var(--grid));background:color-mix(in srgb,var(--green) 5%,var(--card))}
/* m3 fix: chip-sub color classes for dark-mode-safe coloring (no inline hex) */
.cc-sub-amber{color:#8a5c00}
.cc-sub-red{color:var(--ink-act, var(--red))}
.cc-sub-calm{color:var(--ink-ok, var(--green))}
html[data-theme="dark"] .cc-sub-amber{color:#e0a030}
html[data-theme="dark"] .cc-sub-red{color:#ff6b6b}
html[data-theme="dark"] .cc-sub-calm{color:#4ade80}
/* theme tiles */
.cc-theme-tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:4px}
.cc-tile{background:var(--card);border:1px solid var(--grid);border-radius:14px;padding:16px;position:relative;overflow:hidden;cursor:help}
.cc-tile::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;border-radius:14px 14px 0 0;pointer-events:none;opacity:0}
.cc-tile.t-amber::before{background:linear-gradient(90deg,var(--amber),color-mix(in srgb,var(--amber) 30%,transparent));opacity:1}
.cc-tile.t-red::before{background:linear-gradient(90deg,var(--red),color-mix(in srgb,var(--red) 30%,transparent));opacity:1}
.cc-tile.t-calm::before{background:linear-gradient(90deg,var(--green),color-mix(in srgb,var(--green) 30%,transparent));opacity:1}
.cc-tile.t-neutral::before{background:linear-gradient(90deg,var(--faint),color-mix(in srgb,var(--faint) 30%,transparent));opacity:1}
.cc-tile .t-name{font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin:0 0 6px}
.cc-tile .t-val{font-size:26px;font-weight:800;color:var(--ink);letter-spacing:-.02em;line-height:1;margin-bottom:4px}
.cc-tile .t-sub{font-size:11.5px;color:var(--muted);margin-top:3px;line-height:1.4}
.cc-tile .t-stance{display:inline-block;margin-top:8px;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700}
.cc-tile .ts-amber{background:color-mix(in srgb,var(--amber) 18%,transparent);color:#8a5c00}
.cc-tile .ts-red{background:color-mix(in srgb,var(--red) 15%,transparent);color:var(--ink-act, var(--red))}
.cc-tile .ts-calm{background:color-mix(in srgb,var(--green) 13%,transparent);color:var(--ink-ok, var(--green))}
.cc-tile .ts-neutral{background:color-mix(in srgb,var(--faint) 20%,transparent);color:var(--faint)}
html[data-theme="dark"] .cc-tile .ts-amber{color:#e0a030}
html[data-theme="dark"] .cc-tile .ts-red{color:#ff6b6b}
html[data-theme="dark"] .cc-tile .ts-calm{color:#4ade80}
html[data-theme="dark"] .cc-tile .ts-neutral{color:var(--faint)}
/* watch strip */
.cc-watch-strip{display:flex;flex-wrap:wrap;gap:10px;margin-top:4px}
.cc-watch-chip{display:inline-block;padding:8px 14px;border-radius:12px;font-size:13px;font-weight:600;color:var(--ink);border:1px solid var(--grid);flex:1;min-width:200px;line-height:1.45}
.cc-watch-chip.wc-amber{border-color:color-mix(in srgb,var(--amber) 55%,var(--grid));background:color-mix(in srgb,var(--amber) 7%,var(--card));color:#6b4300}
.cc-watch-chip.wc-neutral{background:var(--card)}
html[data-theme="dark"] .cc-watch-chip.wc-amber{color:#e0a030}
/* tape card */
.cc-tape-line{font-size:14px;font-weight:600;color:var(--ink);line-height:1.5;margin:6px 0 10px}
.cc-source-chip{display:inline-block;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700;background:var(--grid);color:var(--muted)}
/* maturity wall mini bars */
.cc-mat-wall{display:flex;flex-direction:column;gap:10px;margin-top:4px}
.cc-mat-row{display:grid;grid-template-columns:128px 1fr;gap:10px;align-items:center;font-size:12px}
.cc-mat-label{color:var(--text);font-weight:600;min-width:0}
.cc-mat-bars{display:flex;gap:2px;height:14px;border-radius:4px;overflow:hidden}
.cc-mat-seg{display:block;height:100%;min-width:2px}
.cc-seg-0{background:color-mix(in srgb,var(--amber) 80%,var(--red))}
.cc-seg-1{background:var(--amber)}
.cc-seg-2{background:color-mix(in srgb,var(--blue) 60%,var(--faint))}
.cc-seg-3{background:var(--blue)}
.cc-seg-4{background:var(--indigo)}
.cc-mat-legend{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;font-size:10.5px;color:var(--muted)}
.cc-mat-legend span{display:flex;align-items:center;gap:4px}
.cc-mat-legend .cc-dot{width:8px;height:8px;border-radius:2px;flex:none}
.cc-placeholder-bar{padding:12px 20px;background:color-mix(in srgb,var(--faint) 8%,var(--bg));border:1px dashed var(--grid);border-radius:10px;text-align:center;font-size:13px;color:var(--faint);font-style:italic;margin:10px 0}
.cc-foot-note{font-size:12px;color:var(--faint);margin-top:12px;line-height:1.6;border-top:1px solid var(--grid);padding-top:10px}
@media(max-width:900px){
  .cc-theme-tiles{grid-template-columns:repeat(2,1fr)}
  .cc-mkt-strip,.cc-watch-strip{flex-direction:column}
}
@media(max-width:560px){
  .cc-hero-state{font-size:32px}
  .cc-theme-tiles{grid-template-columns:1fr}
  .cc-mat-row{grid-template-columns:100px 1fr}
}
</style>

{% if cc_vm is defined %}
  {# 1. SECTION HEAD #}
  <div class="cc-sec-head" id="corpcredit">
    <span class="l-en">Company bonds — credit watch</span><span class="l-zh">公司债 · 信用观察</span>
  </div>

  {# 2. HERO STANCE CARD #}
  <div class="card cs-card {{ cc_vm.hero.hero_cs }}">
    <h2>{{ t('Overall read', '整体研判') }}</h2>
    <div class="cc-hero-state">
      <span class="l-en">{{ cc_vm.hero.state_en }}</span><span class="l-zh">{{ cc_vm.hero.state_zh }}</span>
    </div>
    <div>
      <span class="stance-pill {{ cc_vm.hero.pill_css }}">
        <span class="l-en">{{ cc_vm.hero.pill_en }}</span><span class="l-zh">{{ cc_vm.hero.pill_zh }}</span>
      </span>
    </div>
    <div class="cc-verdict-lead">
      <span class="l-en">{{ cc_vm.hero.subtitle_en }}</span><span class="l-zh">{{ cc_vm.hero.subtitle_zh }}</span>
    </div>
    <div class="cc-as-of">{{ t('as of', '截至') }} {{ cc_vm.as_of }}</div>
  </div>

  {# 3. SPREAD GAUGES (4 chips) #}
  <div class="card" style="margin-top:0">
    <h2>{{ t('Spread gauges', '利差仪表') }}</h2>
    <div class="cc-mkt-strip">
      {% for g in cc_vm.gauges %}
      <div class="cc-mkt-chip {{ g.chip_css }}"
           data-tip-en="{{ g.tip_en }}"
           data-tip-zh="{{ g.tip_zh }}">
        <span class="chip-label">
          <span class="l-en">{{ g.label_en }}</span><span class="l-zh">{{ g.label_zh }}</span>
        </span>
        <span class="chip-sub {{ g.sub_color }}">
          <span class="l-en">{{ g.sub_en }}</span><span class="l-zh">{{ g.sub_zh }}</span>
        </span>
      </div>
      {% endfor %}
      {% if not cc_vm.gauges %}
      <span class="faint" style="font-size:13px">{{ t('Building history — check back soon.', '数据积累中，稍后查看。') }}</span>
      {% endif %}
    </div>
  </div>

  {# 4. THEME TILES (7 tiles) #}
  <div class="card" style="margin-top:0">
    <h2>{{ t('AI & tech themes', 'AI与科技主题') }}</h2>
    <div class="cc-theme-tiles">
      {% for tile in cc_vm.themes %}
      <div class="cc-tile {{ tile.tile_stripe }}"
           data-tip-en="{{ tile.tip_en }}"
           data-tip-zh="{{ tile.tip_zh }}">
        <div class="t-name">
          {% if tile.equity_link %}
          <a href="{{ tile.equity_link }}" style="color:var(--muted);text-decoration:none">
            <span class="l-en">{{ tile.en }}</span><span class="l-zh">{{ tile.zh }}</span>
          </a>
          {% else %}
          <span class="l-en">{{ tile.en }}</span><span class="l-zh">{{ tile.zh }}</span>
          {% endif %}
        </div>
        <div class="t-val">
          {% if tile.level_disp %}{{ tile.level_disp }}{% else %}<span class="faint" style="font-size:16px">—</span>{% endif %}
        </div>
        <div class="t-sub">
          {# M2 fix: always show ratified static descriptor as the primary sub line.
             The Δ21 delta is only rendered as a separate small line once d21 is present.
             Never overwrite the descriptor with "building history". #}
          {% if tile.sub_en %}
          <span class="l-en">{{ tile.sub_en }}</span><span class="l-zh">{{ tile.sub_zh }}</span>
          {% else %}
          <span style="min-height:18px;display:block"></span>
          {% endif %}
          {% if not tile.accruing and tile.d21_disp %}
          <span style="font-size:10px;color:var(--faint);display:block;margin-top:2px">{{ tile.d21_disp }}</span>
          {% endif %}
        </div>
        <span class="t-stance {{ tile.stance_css }}">
          <span class="l-en">{{ tile.stance_en }}</span><span class="l-zh">{{ tile.stance_zh }}</span>
        </span>
      </div>
      {% endfor %}
    </div>
  </div>

  {# 5. WATCH STRIP #}
  <div class="card" style="margin-top:0">
    <h2>{{ t('On the watch list', '观察名单') }}</h2>
    <div class="cc-watch-strip">

      {% if cc_vm.watch.orcl and cc_vm.watch.orcl.g_spread_bp is not none %}
      {% set orcl = cc_vm.watch.orcl %}
      {# B1 fix: guard requires both orcl truthy AND g_spread_bp not None before division.
         Defect 2 fix: display in plain % form (+0.7%), not raw bp (banned Tier-1 vocab).
         g_spread_bp and premium_bp are in basis points; divide by 100 for % display. #}
      <div class="cc-watch-chip wc-amber"
           data-tip-en="Oracle bonds yield {{ '%.2f'|format(orcl.g_spread_bp / 100) }}% over Treasuries{% if orcl.premium_bp is not none %} vs {{ '%.2f'|format((orcl.g_spread_bp - orcl.premium_bp) / 100) }}% for quality-grade peers at the same maturities{% endif %}; all three rating agencies have Oracle on negative outlook. A downgrade to junk would be the largest such event in history."
           data-tip-zh="甲骨文债券相对国债收益率高{{ '%.2f'|format(orcl.g_spread_bp / 100) }}%{% if orcl.premium_bp is not none %}，同期限投资级同行仅{{ '%.2f'|format((orcl.g_spread_bp - orcl.premium_bp) / 100) }}%{% endif %}；三大评级机构均给予负面展望。若降至高收益级将成史上最大规模降级事件。">
        <span style="font-weight:700">ORCL</span> —
        {% if orcl.premium_bp is not none %}
        <span class="l-en">Oracle pays +{{ '%.1f'|format(orcl.premium_bp / 100) }}% over similar bonds — the market votes before the raters</span><span class="l-zh">甲骨文比同级债券多付{{ '%.1f'|format(orcl.premium_bp / 100) }}% · 市场先于评级机构投票</span>
        {% else %}
        <span class="l-en">Oracle pays a premium over similar bonds — the market votes before the raters</span><span class="l-zh">甲骨文比同级债券利率更高 · 市场先于评级机构投票</span>
        {% endif %}
      </div>
      {% endif %}

      {% if cc_vm.watch.fallen_angel_accruing %}
      <div class="cc-watch-chip wc-neutral">
        <span class="l-en">No downgrades-in-motion visible yet — history building</span><span class="l-zh">尚未见降级迹象 · 数据积累中</span>
      </div>
      {% else %}
      {% for candidate in cc_vm.watch.fallen_angel_candidates %}
      <div class="cc-watch-chip wc-amber">
        <span style="font-weight:700">{{ candidate.issuer }}</span> — {{ t('downgrade candidate', '降级候选') }}
      </div>
      {% endfor %}
      {% if not cc_vm.watch.fallen_angel_candidates %}
      <div class="cc-watch-chip wc-neutral">
        <span class="l-en">No fallen-angel candidates in motion</span><span class="l-zh">暂无天使跌落候选</span>
      </div>
      {% endif %}
      {% endif %}

      {% if cc_vm.watch.new_issuance_accruing %}
      <div class="cc-watch-chip wc-neutral">
        <span class="l-en">New-issue tracking starts 14 Jul 2026</span><span class="l-zh">新发债跟踪自2026年7月14日起</span>
      </div>
      {% endif %}

    </div>
  </div>

  {# 6. FINRA TAPE CARD #}
  {% if cc_vm.finra %}
  {% set finra = cc_vm.finra %}
  <div class="card cs-card cs-amber"
       data-tip-en="Market-wide bond tape from actual trades. Price lows can reflect Treasury yields rising rather than company stress — read alongside the extra-yield gauges above. Our own fund-level tape ships separately once history accrues; the two are never blended."
       data-tip-zh="基于真实成交的全市场债券行情。价格新低可能源于国债收益率上行而非公司风险——请结合上方额外收益指标解读。我们自建的基金层面行情将在数据积累后单独展示，两者不混合。">
    <h2>{{ t('Bond market tape', '债券市场行情') }}</h2>
    {% if finra.accruing %}
    <div class="cc-tape-line">
      <span class="l-en">Bond market breadth — building history</span><span class="l-zh">债券市场广度 · 数据积累中</span>
    </div>
    {% else %}
    <div class="cc-tape-line">
      <span class="l-en">{{ t('Latest:', '最新：') }} {{ finra.advance_pct }}% {{ t('of bonds rose', '债券上涨') }} · {{ finra.lows_pct }}% {{ t('touched 1-year lows', '创一年新低') }} · {{ t('as of', '截至') }} {{ finra.date }}</span>
      <span class="l-zh">最新：{{ finra.advance_pct }}%债券上涨 · {{ finra.lows_pct }}%创一年新低 · 截至{{ finra.date }}</span>
    </div>
    {% endif %}
    <span class="cc-source-chip"><span class="l-en">FINRA trade data</span><span class="l-zh">FINRA成交数据</span></span>
  </div>
  {% else %}
  <div class="card cs-card cs-neutral">
    <h2>{{ t('Bond market tape', '债券市场行情') }}</h2>
    <div class="cc-tape-line">
      <span class="l-en">Bond market breadth — building history</span><span class="l-zh">债券市场广度 · 数据积累中</span>
    </div>
    <span class="cc-source-chip"><span class="l-en">FINRA trade data</span><span class="l-zh">FINRA成交数据</span></span>
  </div>
  {% endif %}

  {# 7. MATURITY WALL MINI-CARD #}
  {% if cc_vm.maturity_wall %}
  <div class="card cs-card cs-neutral">
    <h2>{{ t('When the debt comes due', '债务到期分布') }}</h2>
    <div class="cc-mat-wall">
      {% for row in cc_vm.maturity_wall %}
      <div class="cc-mat-row">
        <span class="cc-mat-label">
          <span class="l-en">{{ row.en }}</span><span class="l-zh">{{ row.zh }}</span>
        </span>
        <div class="cc-mat-bars">
          {% for seg in row.segs %}
          <span class="cc-mat-seg cc-{{ seg.css_class }}" style="flex:{{ seg.flex }}"></span>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
    <div class="cc-mat-legend">
      <span><span class="cc-dot" style="background:color-mix(in srgb,var(--amber) 80%,var(--red))"></span><span class="l-en">0–1y</span><span class="l-zh">0–1年</span></span>
      <span><span class="cc-dot" style="background:var(--amber)"></span><span class="l-en">1–3y</span><span class="l-zh">1–3年</span></span>
      <span><span class="cc-dot" style="background:color-mix(in srgb,var(--blue) 60%,var(--faint))"></span><span class="l-en">3–5y</span><span class="l-zh">3–5年</span></span>
      <span><span class="cc-dot" style="background:var(--blue)"></span><span class="l-en">5–10y</span><span class="l-zh">5–10年</span></span>
      <span><span class="cc-dot" style="background:var(--indigo)"></span><span class="l-en">10y+</span><span class="l-zh">10年+</span></span>
    </div>
    <p class="sub faint" style="margin:8px 0 0;font-size:11px">{{ t('All themes had zero bonds maturing within 1 year as of ' ~ cc_vm.as_of ~ '.', '截至' ~ cc_vm.as_of ~ '，所有主题均无1年内到期债券。') }}</p>
  </div>
  {% endif %}

  {# 8. STOCKS VS BONDS — fail-closed stale-date gate (§3) #}
  <div class="card cs-card {% if div_card.state == 'delayed' %}cc-delayed cs-neutral{% else %}cs-neutral{% endif %}" data-card="stocks-vs-bonds">
    <h2>{{ t('Stocks vs their bonds', '股票与其债券') }}</h2>
    {% if div_card.state == 'ready' %}
    {# scored read is out of scope this packet; placeholder yields #}
    {% elif div_card.state == 'building' %}
    <p class="cc-verdict-lead">
      <span class="l-en">The divergence read builds after ~1 month of daily history — the risk sign is stocks rising while their bonds weaken.</span><span class="l-zh">该背离指标需约1个月的日度数据积累——风险信号为股价上涨而债券走弱。</span>
    </p>
    <span class="faint" style="font-size:12px;display:block;margin-top:8px">
      <span class="l-en">History building · read opens {{ div_card.ready_date }}</span><span class="l-zh">数据积累中 · {{ div_card.ready_date }} 起可查看</span>
    </span>
    {% else %}
    <p class="cc-verdict-lead">
      {% if div_card.cause == 'stale' and div_card.last_obs %}
      <span class="l-en">Data delayed since {{ div_card.last_obs }}</span><span class="l-zh">数据自 {{ div_card.last_obs_zh }} 起未更新</span>
      {% elif div_card.cause == 'unbuilt' %}
      <span class="l-en">This read isn't live yet — the comparison engine hasn't produced it</span><span class="l-zh">该读数尚未上线——比较引擎尚未产出</span>
      {% elif div_card.cause == 'unknown' %}
      <span class="l-en">Data delayed — this comparison can't be scored right now.</span><span class="l-zh">数据延迟——该比较暂无法评分。</span>
      {% else %}
      <span class="l-en">Data delayed — awaiting the daily series</span><span class="l-zh">数据延迟——等待日度序列</span>
      {% endif %}
    </p>
    <p class="empty-why">
      {% if div_card.cause == 'stale' %}
      <span class="l-en">The daily series has not updated, so the divergence read cannot be scored.</span><span class="l-zh">日度序列尚未更新，因此无法计算背离读数。</span>
      {% elif div_card.cause == 'unbuilt' %}
      <span class="l-en">No scored comparison is on this page until that engine run exists.</span><span class="l-zh">在该引擎产出之前，本页不会显示已评分的比较读数。</span>
      {% elif div_card.cause == 'unknown' %}
      <span class="l-en">This comparison can't be scored right now.</span><span class="l-zh">该比较暂无法评分。</span>
      {% else %}
      <span class="l-en">The daily series isn't available yet, so the divergence read cannot be scored.</span><span class="l-zh">日度序列尚不可用，因此无法计算背离读数。</span>
      {% endif %}
    </p>
    {% endif %}
  </div>

  {# 9. FOOTER NOTE #}
  <div class="cc-foot-note">
    <span class="l-en">Prices are fund-reported estimates · covers bonds inside major index funds only · daily prices start 14 Jul 2026</span><span class="l-zh">价格为基金披露估值 · 仅覆盖主要指数基金持仓债券 · 日度价格自2026年7月14日起</span>
  </div>
{% endif %}
{# END CCW-W4 corporate credit desk #}

  <!-- ===================== STRESS + CROSS-ASSET ===================== -->
  <div class="sec-head">{{ t('Stress, plumbing & the stock-bond hedge — detail', '压力、资金管道与股债对冲 · 详情') }}</div>
  <div class="grid cols-2">
    <div class="card">
      <h2>{{ t('Rates volatility & funding plumbing', '利率波动与资金管道') }}</h2>
      <div style="margin:6px 0 4px"><span class="band-chip" style="background:{{ vm.stress.color }}">MOVE {{ vm.stress.move }} · {{ t(vm.stress.band_en, vm.stress.band_zh) }}</span></div>
      <div class="kpis">
        {{ kpi('MOVE %ile (1y)', 'MOVE百分位(1年)', vm.stress.pctile, '%') }}
        {{ kpi('SOFR − IORB', 'SOFR − 准备金利率', vm.stress.sofr_iorb_bp, 'bp') }}
        {{ kpi('Repo spike (SOFR99)', '回购跳升(SOFR99)', vm.stress.repo_spike_bp, 'bp') }}
      </div>
      {% if vm.stress.move_leads_vix %}<div class="flag warn">⚑ {{ t('Rates vol (MOVE) leading equity vol (VIX) — stress often transmits this way.', '利率波动（MOVE）领先股票波动（VIX）——压力常以此路径传导。') }}</div>{% endif %}
      {% if vm.stress.repo_stress %}<div class="flag alarm">⚑ {{ t('Repo-stress spike — funding plumbing under strain.', '回购市场承压——资金管道紧张。') }}</div>
      {% elif vm.stress.reserve_scarcity %}<div class="flag warn">⚑ {{ t('SOFR drifting above IORB — creeping reserve scarcity.', 'SOFR持续高于准备金利率——准备金趋于稀缺。') }}</div>{% endif %}
      <div style="margin-top:14px">{{ charts.move | safe }}</div>
      <div class="sub faint" style="margin-top:6px">{{ t('MOVE is rates stress. SOFR−IORB and SOFR spikes flag funding pressure.', 'MOVE衡量利率压力。SOFR−准备金利率与SOFR跳升提示资金压力。') }}</div>
    </div>
    <div class="card">
      <h2>{{ t('Stock-bond correlation — is the hedge working?', '股债相关性 · 对冲是否有效？') }}</h2>
      <div style="margin:6px 0 4px"><span class="band-chip" style="background:{{ vm.cross.color }}">{{ t(vm.cross.regime_en, vm.cross.regime_zh) }}</span></div>
      <div class="kpis">
        {{ kpi('63d stock-bond corr', '63日股债相关性', vm.cross.corr) }}
      </div>
      <div style="margin-top:14px">{{ charts.corr | safe }}</div>
      <div class="sub faint" style="margin-top:6px">{{ t('Negative correlation means bonds are diversifying equities. Positive correlation means the hedge is weak.', '负相关表示债券能分散股票风险；正相关表示对冲变弱。') }}</div>
    </div>
  </div>

  <!-- ===================== SOVEREIGN / GLOBAL ===================== -->
  <section class="landing" id="global-detail">
  <p class="landing-kicker">{{ t('Global rates & sovereign detail', '全球利率与主权详情') }}</p>
  <div class="sec-head">{{ t('⑥ Global sovereign bonds — the world\'s cost of capital', '⑥ 全球主权债券 · 世界的资金成本') }}</div>

  {% if intl %}
  {% set g = intl.global %}{% set uw = intl.us_vs_world %}
  {% set GDIR = {'rising': (C.red, 'rising', '上行'), 'falling': (C.green, 'falling', '下行'), 'stable': (C.muted, 'stable', '平稳')} %}
  {% set gd = GDIR.get(g.direction, (C.muted, g.direction, g.direction)) %}
  <div class="card" style="margin-bottom:18px">
    <h2>{{ t('Global sovereign scorecard — G10 + EM', '全球主权记分卡 · G10 + 新兴市场') }}</h2>
    <div style="margin:6px 0 4px">
      <span class="band-chip" style="background:{{ gd[0] }}">{{ t('Global 10y', '全球10年期') }} {{ g.avg_10y }}% · {{ t(gd[1], gd[2]) }} {{ '%+.0f'|format(g.avg_10y_chg_63d_bp) if g.avg_10y_chg_63d_bp is not none else '' }}bp/3m</span>
      {% if uw.us_premium_bp is not none %}<span class="band-chip" style="background:{{ C.blue }};margin-left:6px">{{ t('US vs world', '美国 vs 世界') }} {{ '%+.0f'|format(uw.us_premium_bp) }}bp</span>{% endif %}
    </div>
    <div class="sub" style="margin:4px 0 10px"><b><span class="l-en">{{ intl.verdict_en }}</span><span class="l-zh">{{ intl.verdict_zh }}</span></b></div>
    <div class="sc-wrap"><div class="sc-scroll">
    <table class="sc-tbl">
      <tr>
        <th>{{ t('sovereign', '主权') }}</th>
        <th>{{ t('10y', '10年') }}</th>
        <th>{{ t('real', '实际') }}</th>
        <th>{{ t('slope', '斜率') }}</th>
        <th>{{ t('3m Δ', '3月变化') }}</th>
        <th data-tip-en="How far today's yield sits from its own past-year average, in standard deviations. +1 = one standard deviation above; 0 = exactly average." data-tip-zh="当前收益率偏离自身过去一年均值的程度，以标准差计。+1 = 高出一个标准差；0 = 正好等于均值。">{{ t('vs 1-yr normal', '对比一年常态') }}</th>
        <th>{{ t('vs US', '对美') }}</th>
        <th>{{ t('curve', '曲线') }}</th>
      </tr>
      {% set SST = {'steep': (C.amber, 'steep', '陡峭'), 'normal': (C.blue, 'normal', '正常'), 'flat': (C.muted, 'flat', '平坦'), 'inverted': (C.red, 'inverted', '倒挂')} %}
      {% set DIR = {'rising': C.red, 'falling': C.green, 'stable': C.muted} %}
      {% for r in intl.countries %}
      {% set ss = SST.get(r.slope_state, (C.muted, r.slope_state or '—', r.slope_state or '—')) %}
      <tr>
        <td class="cty"><span class="dot" style="background:{{ {'US':C.blue,'DE':C.amber,'JP':C.red,'GB':C.teal,'CA':C.indigo,'AU':C.gold,'CH':C.muted}.get(r.code, C.muted) }}"></span>{{ t(r.en, r.zh) }}{% if r.stale %}<span class="stale-tag" data-tip-en="OECD monthly series — lags ~1 month" data-tip-zh="OECD月度序列 · 滞后约1个月">{{ t('lag','滞后') }}</span>{% elif r.cadence == 'monthly' %}<span class="faint" style="font-size:10px;margin-left:4px">{{ t('mo','月') }}</span>{% endif %}</td>
        <td><b>{{ '%.2f'|format(r.y10) }}%</b></td>
        <td>{{ ('%.2f'|format(r.real_10y) ~ '%') if r.real_10y is not none else '—' }}</td>
        <td>{{ ('%+.2f'|format(r.slope)) if r.slope is not none else '—' }}</td>
        <td style="color:{{ DIR.get(r.direction, C.muted) }}">{{ ('%+.0f'|format(r.chg_63d_bp) ~ 'bp') if r.chg_63d_bp is not none else '—' }}</td>
        <td>{{ ('%+.1f'|format(r.z1y)) if r.z1y is not none else '—' }}</td>
        <td style="color:{{ C.green if (r.diff_vs_us_bp or 0) < 0 else C.text }}">{{ ('%+.0f'|format(r.diff_vs_us_bp)) if r.diff_vs_us_bp is not none else '—' }}</td>
        <td><span class="mini-tag" style="background:{{ ss[0] }}">{{ t(ss[1], ss[2]) }}</span></td>
      </tr>
      {% endfor %}
      {% if intl.em and intl.em.em_oas is not none %}
      <tr>
        <td class="cty"><span class="dot" style="background:{{ C.gold }}"></span>{{ t('EM (hard-ccy OAS)', '新兴市场（硬通货利差）') }}</td>
        <td><b>{{ '%.2f'|format(intl.em.em_oas) }}%</b></td>
        <td colspan="2" style="text-align:left;color:var(--muted)">{{ t('pctile', '百分位') }} {{ intl.em.pctile }}%{% if intl.em.emb_trend %} · EMB {{ t(intl.em.emb_trend, {'up':'上行','down':'下行'}.get(intl.em.emb_trend,'')) }}{% endif %}</td>
        <td style="color:{{ DIR.get(intl.em.direction, C.muted) }}">{{ t(intl.em.direction or '', {'rising':'走阔','falling':'收窄','stable':'平稳'}.get(intl.em.direction,'')) }}</td>
        <td colspan="3"></td>
      </tr>
      {% endif %}
    </table>
    </div></div>
    {% if charts.intl_yields %}<div style="margin-top:14px">{{ charts.intl_yields | safe }}</div>{% endif %}
    <div class="sub faint" style="margin-top:8px">{{ t('Level = 10y yield. Real = 10y minus market-priced inflation. Slope = curve shape. 3m Δ = 63-day move. vs 1-yr normal = standard deviations from its own past-year average. vs US = 10y rate gap. Monthly OECD series are tagged.', '水平=10年收益率；实际=10年减去市场定价通胀；斜率=曲线形态；3月变化=63日变动；对比一年常态=较自身过去一年均值的标准差；对美=10年利差。OECD月度序列已标注。') }}</div>
  </div>
  {% endif %}

  <div class="card">
    <h2>{{ t('Euro-area fragmentation & the JGB curve', '欧元区分化与日债曲线') }}</h2>
    <div style="margin:6px 0 4px">
      <span class="band-chip" style="background:{{ vm.sovereign.frag_color }}">{{ t('Euro fragmentation', '欧元分化') }} · {{ t(vm.sovereign.frag_en, vm.sovereign.frag_zh) }}</span>
      {% if vm.sovereign.frag_direction %}<span class="pill"><span class="l-en">{{ vm.sovereign.frag_direction }}</span><span class="l-zh">{{ vm.sovereign.frag_direction_zh }}</span></span>{% endif %}
      {% if vm.sovereign.jgb_2s10s is not none %}<span class="band-chip" style="background:{{ vm.sovereign.jgb_color }};margin-left:6px">JGB 2s10s · {{ t(vm.sovereign.jgb_en, vm.sovereign.jgb_zh) }}</span>{% endif %}
    </div>
    <div class="kpis">
      {{ kpi('Euro frag (all−AAA 10y)', '欧元分化（全体−AAA 10年）', vm.sovereign.euro_frag, 'pp') }}
      {{ kpi('Bund 10y (euro core)', '德债10年（欧元核心）', vm.sovereign.bund_10y, '%') }}
      {{ kpi('JGB 2s10s', '日债 2年/10年', vm.sovereign.jgb_2s10s, 'pp') }}
    </div>
    <div style="margin-top:14px">{{ charts.sovereign | safe }}</div>
    <div class="sub faint" style="margin-top:6px">{{ t('Euro fragmentation tracks periphery-vs-core stress. JGB 2s10s tracks Japan normalization and possible capital repatriation.', '欧元分化跟踪外围与核心压力；日债2/10年跟踪日本正常化及资本回流风险。') }}</div>
  </div>

  {% if credit_cycle %}
  <div class="card">
    <h2>{{ t('Global credit cycle — the crisis early-warning (BIS)', '全球信用周期 · 危机预警 (BIS)') }}</h2>
    <div class="sub faint" style="margin:4px 0 8px">{{ t('Private-sector leverage vs trend.', '私人部门杠杆相对趋势。') }} <b>{{ t('Latest read', '最新读数') }}</b> · {{ t('as of', '截至') }} {{ credit_cycle.asof }}</div>
    <div class="table-wrap">
    <table class="credit-cycle-tbl">
      <tr style="color:var(--muted);font-size:11px;text-transform:uppercase">
        <th style="text-align:left;padding:4px 8px;border-bottom:1px solid var(--line)">{{ t('economy', '经济体') }}</th>
        <th style="text-align:right;padding:4px 8px;border-bottom:1px solid var(--line)">{{ t('credit-to-GDP gap', '信贷/GDP 缺口') }}</th>
        <th style="text-align:left;padding:4px 8px;border-bottom:1px solid var(--line)">{{ t('state', '状态') }}</th>
        <th style="text-align:right;padding:4px 8px;border-bottom:1px solid var(--line)">{{ t('debt-service ratio', '偿债比率') }}</th>
      </tr>
      {% for r in credit_cycle.rows %}
      {% set gc = 'var(--down)' if (r.gap or 0) >= 10 else '#d9a03c' if (r.gap or 0) >= 2 else 'var(--up)' if (r.gap or 0) <= -2 else 'var(--muted)' %}
      <tr>
        <td style="padding:5px 8px;border-bottom:1px solid var(--line)"><b>{{ t(r.label_en, r.label_zh) }}</b></td>
        <td style="text-align:right;padding:5px 8px;border-bottom:1px solid var(--line);color:{{ gc }};font-weight:700">{{ '%+.1f'|format(r.gap) }}pp{% if r.gap_chg_1y is not none %} <span class="sub faint" style="font-weight:400">{{ '%+.1f'|format(r.gap_chg_1y) }}/yr</span>{% endif %}</td>
        <td style="padding:5px 8px;border-bottom:1px solid var(--line);color:{{ gc }}">{{ t(r.gap_state, {'elevated risk':'风险偏高','building':'累积中','deleveraging':'去杠杆','neutral':'中性'}.get(r.gap_state, r.gap_state)) }}</td>
        <td style="text-align:right;padding:5px 8px;border-bottom:1px solid var(--line)">{{ r.dsr }}%{% if r.dsr_chg_1y is not none %} <span class="sub faint">{{ '%+.1f'|format(r.dsr_chg_1y) }}/yr</span>{% endif %}</td>
      </tr>
      {% endfor %}
    </table>
    </div>
    <div class="sub faint" style="margin-top:8px">{{ t('BIS credit-to-GDP gap: private credit versus trend. Big positive gaps warn of banking-cycle risk; negative gaps show deleveraging. Slow structural context only.', 'BIS信贷/GDP缺口：私人信贷相对趋势。大幅正缺口提示银行周期风险；负缺口表示去杠杆。仅为慢变量背景。') }}</div>
  </div>
  {% endif %}
  </section>

  <!-- ===================== BONDS → EVERYTHING (measured transmission) ===================== -->
  {% if xasset_vm %}
  {% set xa = xasset_vm %}{% set dn = xa.drivers_now %}
  <div class="sec-head">{{ t('Bonds → everything — the measured transmission map', '债券 → 各市场 · 实测传导图') }}</div>
  <div class="card">
    <h2>{{ t('What bonds are doing to each market — right now', '当前债券对各市场的影响') }}</h2>
    <div class="sub" style="margin:2px 0 10px"><b><span class="l-en">{{ xa.verdict_en }}</span><span class="l-zh">{{ xa.verdict_zh }}</span></b></div>
    <div class="kpis" style="margin-bottom:6px">
      {{ kpi('Real 10y', '10年实际利率', dn.real_10y, '%', (('%+.0f'|format(dn.real_chg_bp)) ~ 'bp/3m') if dn.real_chg_bp is not none else '') }}
      {{ kpi('Curve 10y−3m', '曲线10年−3月', dn.slope, 'pp', (('%+.0f'|format(dn.slope_chg_bp)) ~ 'bp/3m') if dn.slope_chg_bp is not none else '') }}
      {{ kpi('HY OAS', '高收益利差', dn.hy_oas, '%', (('%+.0f'|format(dn.hy_chg_bp)) ~ 'bp/3m') if dn.hy_chg_bp is not none else '') }}
      {{ kpi('10y breakeven', '10年盈亏平衡', dn.breakeven, '%') }}
      {{ kpi('MOVE', 'MOVE', dn.move, '') }}
    </div>
    {% if charts.xasset_betas %}<div style="margin:8px 0 6px">{{ charts.xasset_betas | safe }}</div>{% endif %}
    <div style="margin-top:8px">
      {% for a in xa.assets %}
      {% set sc = C.blue if a.sign == 'pos' else C.amber %}
      {% set w = ((a.corr|abs) / 0.7 * 50) %}{% set w = 50 if w > 50 else w %}
      <div class="xa-row">
        <div class="xa-asset">{{ a.icon }} {{ t(a.en, a.zh) }}<span class="xa-sub" data-tip-en="Correlation coefficient r = {{ '%+.2f'|format(a.corr) }}. −1 = moves exactly opposite, 0 = unrelated, +1 = moves exactly together." data-tip-zh="相关系数 r = {{ '%+.2f'|format(a.corr) }}。−1=完全反向，0=无关，+1=完全同向。">{{ t('via', '经') }} {{ t(a.driver_en, a.driver_zh) }} · {{ a.beta_disp }} · {{ t('co-movement', '联动度') }} {{ '%+.2f'|format(a.corr) }} ({{ t(a.conf_label, {'strong':'强','moderate':'中','weak':'弱'}.get(a.conf_label,'')) }})</span></div>
        <div>
          <div class="xa-bar"><span class="xa-mid"></span>
            <span class="xa-fill" style="{% if a.corr >= 0 %}left:50%{% else %}left:{{ (50 - w)|round(1) }}%{% endif %};width:{{ w|round(1) }}%;background:{{ sc }}"></span></div>
          <div class="xa-note"><span class="l-en">{{ a.story_en }}</span><span class="l-zh">{{ a.story_zh }}</span></div>
        </div>
        <div class="xa-verd" style="color:{{ a.vcolor }}">{{ t(a.verdict_en, a.verdict_zh) }}<span class="xa-sub" style="color:var(--muted);font-weight:500;font-size:11px">{{ a.impulse_en }}</span></div>
      </div>
      {% endfor %}
    </div>
    <div class="sub faint" style="margin-top:10px">{{ t('These numbers show how much each market typically moves in a week when its main bond driver moves. They describe today\'s headwind or tailwind — they are not forecasts. More chains: ', '这些数字显示：当主要债券驱动变动时，各市场在典型一周内的联动幅度。它们描述当前的顺风或逆风——不是预测。更多传导链见') }} <a href="transmission.html">{{ t('Rate & Inflation Transmission', '利率与通胀传导') }}</a>.</div>
  </div>
  {% endif %}

  <!-- ===================== TREASURY SUPPLY ABSORPTION (display-only) ===================== -->
  {% if treasury_supply %}
  {% set ts = treasury_supply %}
  {% set TAG = {'strong': (C.green, '强劲'), 'soft': (C.red, '偏弱'), 'in-line': (C.muted, '中性'), 'n/a': (C.faint, '—')} %}
  <div class="card" id="supply">
    <h2>{{ t('Treasury supply absorption — is the market digesting the debt?', '美债供给吸收 · 市场能否顺利消化债务？') }}</h2>
    <div style="margin:6px 0 6px">
      {% set sc = C.green if ts.n_strong > ts.n_soft else (C.red if ts.n_soft >= 2 else C.muted) %}
      <span class="band-chip" style="background:{{ sc }}">{{ t('Recent coupon demand', '近期票息需求') }} · {{ ts.n_soft }}/{{ ts.n_scored }} {{ t('soft', '偏弱') }}</span>
      {% if ts.supply %}
      {% set pc = C.amber if ts.supply.pressure == 'coupon supply rising' else (C.teal if ts.supply.pressure == 'coupon supply easing' else C.muted) %}
      <span class="band-chip" style="background:{{ pc }};margin-left:6px">{{ t('Duration supply', '久期供给') }} · {{ t({'coupon supply rising': 'rising', 'coupon supply easing': 'easing', 'stable': 'stable', 'neutral': 'n/a'}.get(ts.supply.pressure, ts.supply.pressure), {'coupon supply rising': '上升', 'coupon supply easing': '回落', 'stable': '平稳', 'neutral': '—'}.get(ts.supply.pressure, '')) }}</span>
      {% endif %}
    </div>
    <div class="sub faint" style="margin:2px 0 10px"><b>{{ t(ts.headline, '') }}</b> · {{ t('as of', '截至') }} {{ ts.asof }}</div>
    {% if ts.supply %}
    <div class="kpis" style="margin-bottom:4px">
      {{ kpi('Coupon issuance (90d)', '票息发行(90日)', ts.supply.coupon_bn, ' $bn') }}
      {{ kpi('vs prior 90d', '较前90日', ('%+.1f'|format(ts.supply.coupon_chg_pct)) if ts.supply.coupon_chg_pct is not none else none, '%') }}
    </div>
    {% endif %}
    <div class="table-wrap">
    <table class="supply-tbl" style="margin-top:6px">
      <tr style="color:var(--muted);font-size:11px;text-transform:uppercase">
        <th style="text-align:left;padding:4px 8px;border-bottom:1px solid var(--grid)">{{ t('auction', '拍卖') }}</th>
        <th style="text-align:left;padding:4px 8px;border-bottom:1px solid var(--grid)">{{ t('tenor', '期限') }}</th>
        <th style="text-align:right;padding:4px 8px;border-bottom:1px solid var(--grid)">{{ t('bid-to-cover', '认购倍数') }}</th>
        <th style="text-align:right;padding:4px 8px;border-bottom:1px solid var(--grid)">{{ t('indirect', '间接') }}</th>
        <th style="text-align:right;padding:4px 8px;border-bottom:1px solid var(--grid)">{{ t('dealer', '交易商') }}</th>
        <th style="text-align:right;padding:4px 8px;border-bottom:1px solid var(--grid)">{{ t('demand', '需求') }}</th>
      </tr>
      {% for r in ts.rows %}
      {% set tg = TAG.get(r.tag, (C.muted, r.tag)) %}
      <tr>
        <td style="padding:5px 8px;border-bottom:1px solid var(--grid);color:var(--muted)">{{ r.date }}{% if r.reopening %} <span class="faint" style="font-size:10px">re</span>{% endif %}</td>
        <td style="padding:5px 8px;border-bottom:1px solid var(--grid)"><b>{{ r.tenor }}</b> <span class="faint" style="font-size:11px">{{ r.type }}</span></td>
        <td style="text-align:right;padding:5px 8px;border-bottom:1px solid var(--grid)">{{ '%.2f'|format(r.bid_to_cover) if r.bid_to_cover is not none else '—' }}</td>
        <td style="text-align:right;padding:5px 8px;border-bottom:1px solid var(--grid)">{{ ('%.0f'|format(r.indirect_pct) ~ '%') if r.indirect_pct is not none else '—' }}</td>
        <td style="text-align:right;padding:5px 8px;border-bottom:1px solid var(--grid)">{{ ('%.0f'|format(r.dealer_pct) ~ '%') if r.dealer_pct is not none else '—' }}</td>
        <td style="text-align:right;padding:5px 8px;border-bottom:1px solid var(--grid);color:{{ tg[0] }};font-weight:700">{{ t(r.tag, tg[1]) }}{% if r.absorption_z is not none %} <span class="faint" style="font-weight:400;font-size:11px">{{ '%+.1f'|format(r.absorption_z) }}σ</span>{% endif %}</td>
      </tr>
      {% endfor %}
    </table>
    </div>
    <div class="sub faint" style="margin-top:8px">{{ t('Auction demand is scored versus recent same-tenor auctions. Higher bid-to-cover and indirect share are stronger; higher dealer share is weaker.', '拍卖需求相对近期同期限拍卖评分。认购倍数与间接占比越高越强；交易商占比越高越弱。') }}</div>
    <div class="sub faint" style="margin-top:6px">{{ t('Supply context only; not scored.', '仅为供给背景，不参与评分。') }}</div>
  </div>
  {% endif %}

  <!-- ===================== ALERT TIMELINE ===================== -->
  {% if timeline %}
  <div class="card" id="timeline" style="margin-top:20px">
    <h2>{{ t('Bond state-change timeline', '债券状态变化时间线') }} <span class="faint">· {{ n_alerts }} {{ t('events · last', '事件 · 近') }} {{ timeline_days }}d</span></h2>
    <div class="timeline">
    {% for day in timeline %}
      <div class="tl-day"><span class="l-en">{{ day.daylabel }}</span><span class="l-zh">{{ day.daylabel_zh }}</span></div>
      {% for e in day.events %}
      <div class="tl-ev sev-{{ e.severity }}">
        <span class="tl-type"><span class="l-en">{{ e.label }}</span><span class="l-zh">{{ e.label_zh }}</span></span>
        <span class="tl-head"><span class="l-en">{{ e.headline }}</span><span class="l-zh">{{ e.headline_zh }}</span></span>
      </div>
      {% endfor %}
    {% endfor %}
    </div>
    <div class="sub faint" style="margin-top:10px">{{ t('Daily state changes, debounced to reduce whipsaw. Context only.', '每日状态变化，经去抖以减少噪音。仅供参考。') }}</div>
  </div>
  {% endif %}

  <!-- ===================== METHODOLOGY / HONESTY ===================== -->
  <div class="card" id="how-to-read" style="margin-top:22px">
    <h2>{{ t('How to read this page', '如何解读本页') }}</h2>
    <div class="note">
      <p>{{ t('Start with the health score, then check which leg is driving it: curve, credit, real rates, rates volatility, funding stress or stock-bond correlation.', '先看健康度评分，再看驱动分项：曲线、信用、实际利率、利率波动、资金压力或股债相关性。') }}</p>
      <p>{{ t('The compass and transmission sections are context. They summarize duration lean and cross-asset pressure, but they are not standalone trade calls.', '罗盘与传导部分是背景信息。它们概括久期倾向与跨资产压力，但不是独立交易信号。') }}</p>
      <p>{{ t('Thresholds use practitioner levels; calibration only labels how useful each leg has been. Data comes mainly from FRED, Yahoo, ECB, Japan MoF, BIS, OECD and Treasury auction results.', '阈值采用常用市场水平；校准只标注各分项过去有多有用。数据主要来自FRED、Yahoo、欧洲央行、日本财务省、BIS、OECD与美债拍卖结果。') }}</p>
      <p class="meta-foot">{{ t('History', '历史') }} {{ span }} · {{ t('built', '构建于') }} {{ built }}</p>
    </div>
  </div>
</div>

<script src="theme.js"></script>
<script defer src="illus.js"></script>
<script>
/* scroll reveal — cards + hero rise into view (reduced-motion parks them shown) */
(function(){var els=document.querySelectorAll('.reveal');if(!('IntersectionObserver' in window)||window.matchMedia('(prefers-reduced-motion:reduce)').matches){els.forEach(function(e){e.classList.add('in');});return;}
var io=new IntersectionObserver(function(en){en.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:.12});
els.forEach(function(e){io.observe(e);});})();
/* LENS `?` — pointerdown toggle so tap at 390 does not flash-and-vanish (S1). */
(function(){
  document.addEventListener('pointerdown', function(e){
    var q = e.target && e.target.closest && e.target.closest('.wrap .lens-q');
    if(!q) return;
    e.preventDefault();
    e.stopPropagation();
    var was = q.classList.contains('cnx-tip-open');
    document.querySelectorAll('.wrap .lens-q.cnx-tip-open').forEach(function(el){
      el.classList.remove('cnx-tip-open');
    });
    if(!was) q.classList.add('cnx-tip-open');
  }, true);
  document.addEventListener('keydown', function(e){
    var t = e.target;
    if(!t || !t.classList || !t.classList.contains('lens-q')) return;
    if(e.key === 'Enter' || e.key === ' '){
      e.preventDefault();
      t.classList.toggle('cnx-tip-open');
    }
  });
})();
</script>
<footer class="site-footer">
  <span>© 2026 Mastermind Inc</span>
</footer>
</body>
</html>
