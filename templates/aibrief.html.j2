{% macro help(en, zh='') -%}
<details class="help"><summary><span class="l-en">Details</span><span class="l-zh">说明</span></summary><span class="tip"><span class="l-en">{{ en | e }}</span><span class="l-zh">{{ (zh if zh else en) | e }}</span></span></details>
{%- endmacro %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en | e }}</span><span class="l-zh">{{ (zh if zh else en) | e }}</span>
{%- endmacro %}
{% autoescape true %}
{% import "_aibrief_body.html.j2" as aib %}{# ABX v2 — the ONE shared AI-brief body renderer #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>try{var th=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',th||'dark');var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>AI Daily Brief — {{ as_of }}</title>
{% set seo_title = "AI Daily Brief — Mastermind" %}{% set seo_desc = "The market day in plain words — an AI-drafted, engine-grounded daily brief covering regimes, movers and what changed." %}{% set seo_path = "aibrief.html" %}
{% include "_seo_head.html.j2" %}
<link rel="stylesheet" href="theme.css">
<style>
body{background:var(--bg);color:var(--text);font-family:var(--font-ui);margin:0;padding:var(--sp-4,16px);}
.aib-page{max-width:960px;margin:var(--sp-7,32px) auto;min-width:0;}
.aib-page-header{margin-bottom:var(--sp-6,24px);}
.aib-page-header h1{font-size:var(--fs-h1,28px);letter-spacing:-.02em;margin:0 0 var(--sp-2,8px);font-weight:800;}
.aib-page-header p{color:var(--muted);margin:0;font-size:var(--fs-body,14px);max-width:70ch;}
.aib-page .panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--r-panel,14px);padding:var(--sp-6,24px);margin-bottom:var(--sp-5,20px);box-shadow:none;min-width:0;}
html[data-theme="light"] .aib-page>.panel{box-shadow:var(--card-shadow);}
.aib-page .muted,.aib-page .sm{color:var(--muted);font-size:var(--fs-sm,12.5px);}
.brief-tabs{display:flex;gap:var(--sp-1,4px);overflow-x:auto;white-space:nowrap;margin:0 0 var(--sp-4,16px);padding:var(--sp-1,4px);background:var(--panel2);border:1px solid var(--line);border-radius:var(--r-btn,10px);}
.brief-tab-btn{border:1px solid transparent;background:transparent;color:var(--muted);min-height:44px;padding:var(--sp-2,8px) var(--sp-4,16px);font:600 var(--fs-body,14px)/1.4 var(--font-ui);border-radius:var(--r-ctl,8px);cursor:pointer;flex:1;}
.brief-tab-btn.active{background:var(--panel);color:var(--text);border-color:var(--line);}
.brief-tab-btn:focus-visible,.aib-support>summary:focus-visible,.aib-page a:focus-visible{outline:2px solid var(--link);outline-offset:2px;}
.brief-tab{display:none;}.brief-tab.active{display:block;}
.aib-support{border-top:1px solid var(--line);padding-top:var(--sp-4,16px);margin:var(--sp-6,24px) 0;}
.aib-support>summary{font-size:var(--fs-h2,17px);font-weight:700;min-height:44px;cursor:pointer;}
.aib-support[open]>summary{margin-bottom:var(--sp-4,16px);}
.aib-source-links{display:flex;flex-wrap:wrap;gap:var(--sp-4,16px);font-size:var(--fs-sm,12.5px);margin:var(--sp-4,16px) 0;}
.aib-page h2{font-size:var(--fs-h2,17px);margin:0 0 var(--sp-3,12px);}
.help{display:inline-block;font-size:var(--fs-sm,12.5px);color:var(--muted);margin-left:var(--sp-2,8px);}
.help>summary{cursor:pointer;display:inline;}.help .tip{display:block;max-width:70ch;padding:var(--sp-3,12px);font-weight:400;line-height:1.6;}
.ctx-strip{display:grid;gap:var(--sp-3,12px);}.ctx-row{display:flex;flex-wrap:wrap;gap:var(--sp-3,12px);font-size:var(--fs-sm,12.5px);}.ctx-label{font-weight:600;min-width:90px;color:var(--muted);}.ctx-chip{color:var(--text);}
.fwd-list,.cortex-list{padding:0;list-style:none;margin:var(--sp-3,12px) 0;}
.fwd-list li,.open-lean{display:flex;flex-wrap:wrap;gap:var(--sp-3,12px);border-bottom:1px solid var(--line);padding:var(--sp-3,12px) 0;font-size:var(--fs-sm,12.5px);}
.fwd-date{font-variant-numeric:tabular-nums;color:var(--muted);}.record-cal,.mb-deg{color:var(--muted);font-size:var(--fs-sm,12.5px);}
.cortex-label{font-size:var(--fs-label,11px);font-weight:700;color:var(--muted);}.cortex-section{margin:var(--sp-4,16px) 0;}.cortex-h{font-weight:650;}.cortex-list li{padding:var(--sp-2,8px) 0;}
@media(max-width:560px){.aib-page{margin-top:var(--sp-5,20px);}.aib-page .panel{padding:var(--sp-4,16px);}.brief-tab-btn{padding:var(--sp-2,8px) var(--sp-3,12px);flex-shrink:0;}.aib-page-header h1{font-size:var(--fs-num-lg,22px);}}
html[data-lang="zh"] .aib-page-header h1{letter-spacing:0;}
{% include "_aibrief_css.j2" %}
{% include "_mor2b_blocks_css.j2" %}
</style>
</head>
<body>

{% include "_site_nav.html.j2" %}
<main class="aib-page">
<header class="aib-page-header">
<h1>{{ t('AI Daily Brief', 'AI每日简报') }}</h1>
<p>{{ t('The cross-market read. What changed, what conflicts, and what to watch next.', '跨市场解读：哪些变化、哪些分歧、接下来关注什么。') }}</p>
</header>
{# ── Brief tabs ───────────────────────────────────────────────────────────────── #}
<div class="brief-tabs" role="tablist" aria-label="Market · 市场">
  <button class="brief-tab-btn active" data-lens="macro" id="tab-macro" aria-controls="brief-macro" tabindex="0" role="tab" aria-selected="true">{{ t('Macro', '宏观') }}</button>
  <button class="brief-tab-btn" data-lens="china" id="tab-china" aria-controls="brief-china" tabindex="-1" role="tab" aria-selected="false">{{ t('China & Hong Kong', '中国与香港') }}</button>
  <button class="brief-tab-btn" data-lens="btc" id="tab-btc" aria-controls="brief-btc" tabindex="-1" role="tab" aria-selected="false">{{ t('Bitcoin', '比特币') }}</button>
</div>

{# Bodies are SERVER-rendered by the shared macro (build_aibrief.py loads the three
   lens JSONs into master_brief / china_brief / btc_brief). aibrief.js now handles
   only the cortex panel. Absent brief → an honest "not generated yet" note. #}
{% set _absent_en = 'This brief has not generated yet. It rebuilds on its own cadence from the dashboards — check back after the next run.' %}
{% set _absent_zh = '该简报尚未生成。它按自身节奏由看板重新生成 — 请在下次运行后再查看。' %}

<div class="panel ai-brief brief-tab active" data-lens="macro" id="brief-macro" role="tabpanel" aria-labelledby="tab-macro">
  {% if master_brief is defined and master_brief is mapping and master_brief and (master_brief.get('summary') or master_brief.get('tldr') or master_brief.get('regime_read') or master_brief.get('degraded_reason')) %}
  {{ aib.aibrief_body(master_brief, 'macro', show_catalysts=True) }}
  {% else %}
  <p class="muted sm">{{ t(_absent_en, _absent_zh) }}</p>
  {% endif %}
</div>

<div class="panel ai-brief brief-tab" data-lens="china" id="brief-china" role="tabpanel" aria-labelledby="tab-china">
  {% if china_brief is defined and china_brief is mapping and china_brief and (china_brief.get('summary') or china_brief.get('tldr') or china_brief.get('regime_read') or china_brief.get('degraded_reason')) %}
  {{ aib.aibrief_body(china_brief, 'china', show_catalysts=False) }}
  {% else %}
  <p class="muted sm">{{ t(_absent_en, _absent_zh) }}</p>
  {% endif %}
</div>

<div class="panel ai-brief brief-tab" data-lens="btc" id="brief-btc" role="tabpanel" aria-labelledby="tab-btc">
  {% if btc_brief is defined and btc_brief is mapping and btc_brief and (btc_brief.get('summary') or btc_brief.get('tldr') or btc_brief.get('regime_read') or btc_brief.get('degraded_reason')) %}
  {{ aib.aibrief_body(btc_brief, 'btc', show_catalysts=False) }}
  {% else %}
  <p class="muted sm">{{ t(_absent_en, _absent_zh) }}</p>
  {% endif %}
</div>

<details class="aib-support"><summary>{{ t('Sources & calendar', '来源与日程') }}</summary>
<nav class="aib-source-links" aria-label="Source dashboards">{{ t('Check the underlying dashboards:', '核实底层看板：') }} <a href="macro.html">{{ t('Macro', '宏观') }}</a><a href="china.html">{{ t('China', '中国') }}</a><a href="hk.html">{{ t('Hong Kong', '香港') }}</a><a href="vector.html">{{ t('Bitcoin', '比特币') }}</a></nav>
<p class="muted">{{ t('Macro and China are scheduled daily; Bitcoin every three days. A schedule does not establish freshness.', '宏观与中国计划每日更新，比特币每三天更新。计划不代表内容已更新。') }}</p>
{# ── MOR-2b Lane C: Morning Orientation band (sits directly under the h1).
       Reads site/am_edition.json (or data/regime/am_edition.json fallback) via the
       same fail-open loader build_aibrief.py uses for its siblings. Renders a
       .mx-empty state when the JSON is absent — never blocks the brief.

       BLOCKER 2 round 2: the chip maps the producer's session_state to the
       seat-pinned .dtp-chip primitive — OPEN → --live (with the pulsing dot),
       CLOSED → --stale (no pulse), NOT_YET_OPEN → --pre, anything else →
       --warn. The prior round rendered "Live" in all three branches and pulsed
       on weekends / pre-open. ── #}
{% set _ame = am_edition if (am_edition is defined and am_edition) else None %}
{% set _ame_present = _ame and not _ame.get('absent') %}
{% set _ame_chip = (
  ('live',   t('Live', '实时'),                       True)  if _ame_present and _ame.get('session_state') == 'OPEN'
  else ('stale',  t('After the close', '已收盘'),    False) if _ame_present and _ame.get('session_state') == 'CLOSED'
  else ('pre',    t('Not yet open', '尚未开盘'),     False) if _ame_present and _ame.get('session_state') == 'NOT_YET_OPEN'
  else ('warn',   t('Unavailable', '不可用'),         False)
) %}
<div class="panel">
  <div class="mx-block-header">
    <span class="eyebrow">{{ t('Morning Orientation', '盘前导读') }}</span>
    <h2>{{ t('Before the US open — one read', '美股开盘前 — 一览') }}</h2>
    <span class="mx-chip-slot">
      <span class="dtp-chip dtp-chip--{{ _ame_chip[0] }}">
        {% if _ame_chip[2] %}<i class="dtp-dot"></i>{% endif %}
        {{ _ame_chip[1] }}
      </span>
    </span>
    {% if _ame_present and _ame.get('generated_at') %}
    <span class="dtp-asof">{{ t('Built at', '构建时间') }} {{ _ame.generated_at[:16] }}</span>
    {% endif %}
  </div>
  {% if _ame_present %}
  <div class="mx-band">
    {% if _ame.get('first_tape_en') %}
    <span class="mx-band-lead">
      {{ t(_ame.first_tape_en, _ame.first_tape_zh or _ame.first_tape_en) }}
    </span>
    {% else %}
    <span class="mx-band-lead">{{ t('The morning orientation page has built.', '今晨导读页面已生成。') }}</span>
    {% endif %}
    <a class="brief-link" href="am_edition.html">{{ t('Open the morning orientation page →', '打开今晨导读页面 →') }}</a>
  </div>
  {% else %}
  <div class="mx-empty">
    <div class="mx-empty-line">{{ t('Morning orientation unavailable.', '今晨导读暂不可用。') }}</div>
    {% if _ame and (_ame.get('reason_en') or _ame.get('reason_zh')) %}
    <div class="mx-empty-why">{{ t(_ame.get('reason_en') or '', _ame.get('reason_zh') or _ame.get('reason_en') or '') }}</div>
    {% endif %}
  </div>
  {% endif %}
</div>

{# ── Panel A: Context strip (server-side, fail-open) ──────────────────────────── #}
{% if ctx_strip is defined and not ctx_strip.get('absent', True) %}
<div class="panel" style="padding:10px 16px">
  <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
    <h2 style="margin:0">{{ t('Right now', '当前状态') }}</h2>
    {% if ctx_strip.get('strip_asof') %}
    <span class="muted" style="font-size:11px">{{ t('as of', '数据截至') }} {{ ctx_strip.strip_asof }}</span>
    {% endif %}
    {{ help(
      'Snapshot of the deterministic dashboards at build time — regime, any signals pointing in different directions, and what liquidity is doing. Research context only.',
      '构建时的确定性看板快照 — 周期状态、有无方向分歧信号，以及流动性动向。仅供研究参考。'
    ) }}
  </div>
  <div class="ctx-strip">
    {% if ctx_strip.get('regime_label_en') %}
    <div class="ctx-row">
      <span class="ctx-label">{{ t('Regime', '市场格局') }}</span>
      <span class="ctx-chip regime">
        <span class="l-en">{{ ctx_strip.regime_label_en }}</span>
        <span class="l-zh">{{ ctx_strip.regime_label_zh or ctx_strip.regime_label_en }}</span>
      </span>
    </div>
    {% endif %}
    {% if ctx_strip.get('contradiction_line_en') %}
    <div class="ctx-row">
      <span class="ctx-label">{{ t('Signals', '信号') }}</span>
      <span data-tip-en="{{ ctx_strip.contradiction_tip_en or '' }}" data-tip-zh="{{ ctx_strip.contradiction_tip_zh or ctx_strip.contradiction_tip_en or '' }}">
        <span class="l-en">{{ ctx_strip.contradiction_line_en }}</span>
        <span class="l-zh">{{ ctx_strip.contradiction_line_zh or ctx_strip.contradiction_line_en }}</span>
      </span>
    </div>
    {% endif %}
    {% if ctx_strip.get('liquidity_en') %}
    <div class="ctx-row">
      <span class="ctx-label">{{ t('Money', '流动性') }}</span>
      <span>
        <span class="l-en">{{ ctx_strip.liquidity_en }}</span>
        <span class="l-zh">{{ ctx_strip.liquidity_zh or ctx_strip.liquidity_en }}</span>
      </span>
    </div>
    {% endif %}
    {% if ctx_strip.get('cortex_status') %}
    <div class="ctx-row">
      <span class="ctx-label">{{ t('AI review', 'AI复盘') }}</span>
      <span class="ctx-chip {{ 'cortex-ok' if ctx_strip.cortex_status == 'ok' else 'cortex-deg' }}">
        <span class="l-en">{{ ctx_strip.cortex_en or 'Review unavailable' }}</span>
        <span class="l-zh">{{ ctx_strip.cortex_zh or '复盘不可用' }}</span>
      </span>
    </div>
    {% endif %}
  </div>
</div>
{% endif %}

{# ── Panel B: What's ahead (server-side, deterministic) ──────────────────────── #}
{% if fwd_panel is defined and not fwd_panel.get('absent', True) and (fwd_panel.get('events') or fwd_panel.get('rebal_note_en')) %}
<div class="panel">
  <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">
    <h2 style="margin:0">{{ t("What's ahead", '近期日程') }}</h2>
    {{ help(
      'Scheduled macro events and data releases in the next two weeks. Dates are deterministic — no forecasts on the visible tier. Hover any row for model leans and market-implied reads; all annotated with no accuracy record yet while the scoreboard is empty.',
      '未来两周的宏观事件与数据发布。日期为确定性信息，可见层不含预测。悬停行可查看模型倾向与市场隐含读数，评分板为空时注明尚无记录。'
    ) }}
  </div>
  {% if fwd_panel.get('rebal_note_en') %}
  <p class="muted sm" style="margin:6px 0 8px">
    <span class="l-en">{{ fwd_panel.rebal_note_en }}</span>
    <span class="l-zh">{{ fwd_panel.rebal_note_zh or fwd_panel.rebal_note_en }}</span>
  </p>
  {% endif %}
  {% if fwd_panel.get('events') %}
  <ul class="fwd-list">
    {% for ev in fwd_panel.events %}
    <li>
      <span class="fwd-date">{{ ev.date }}</span>
      <span data-tip-en="{{ ev.tip_en or '' }}" data-tip-zh="{{ ev.tip_zh or ev.tip_en or '' }}">
        <span class="l-en">{{ ev.label_en }}</span>
        <span class="l-zh">{{ ev.label_zh or ev.label_en }}</span>
      </span>
    </li>
    {% endfor %}
  </ul>
  {% endif %}
</div>
{% endif %}

</details>
<details class="aib-support"><summary>{{ t('Track record & AI review', '判断记录与AI复盘') }}</summary>
<p class="muted">{{ t('Historical research. Check each edition and evaluation date before drawing conclusions.', '历史研究，请先核对各期日期和评估时间再作判断。') }}</p>
{# ── Panel C: The brief's own record (server-side) ────────────────────────────── #}
{% if record_panel is defined and not record_panel.get('absent', True) %}
<div class="panel">
  <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
    <h2 style="margin:0">{{ t("The brief's own record", '简报自身记录') }}</h2>
    {{ help(
      "The AI brief logs a lean for each major call — subject, direction, horizon, and the condition that would change it. These are scored against realized prices. Below 20 graded calls the scoreboard shows the artifact's own calibration note, not a hit-rate.",
      '简报为每次主要判断记录倾向 — 标的、方向、时间窗口与改判条件，并依据实际价格评分。评分次数不足20次时不显示命中率，仅显示校准说明。'
    ) }}
  </div>
  {# n-floor law (ADB-R12c): fixed plain-word sentence on visible tier when n < 20;
     raw artifact calibration_note moves to hover receipt only. #}
  {% if record_panel.get('calibration_note_en') %}
  <div class="record-cal">
    <span class="l-en">{{ record_panel.calibration_note_en }}</span>
    <span class="l-zh">{{ record_panel.calibration_note_zh or record_panel.calibration_note_en }}</span>
    {% if record_panel.get('calibration_note_raw_en') %}
    {{ help(record_panel.calibration_note_raw_en, record_panel.calibration_note_raw_zh or record_panel.calibration_note_raw_en) }}
    {% endif %}
  </div>
  {% endif %}
  {% if record_panel.get('open_leans') %}
  <div style="margin-top:6px">
    <div class="muted sm" style="margin-bottom:4px;font-weight:600;text-transform:uppercase;font-size:11px;letter-spacing:.05em">
      {{ t('Open leans', '待验证判断') }}
    </div>
    {% for lean in record_panel.open_leans %}
    <div class="open-lean">
      <span class="l-en">{{ lean.stance_en }}</span>
      <span class="l-zh">{{ lean.stance_zh or lean.stance_en }}</span>
      {% if lean.get('falsifier_en') %}
      {{ help('Changes this read: ' + lean.falsifier_en + (' · Check by: ' + lean.check_by if lean.get('check_by') else ''),
              '改判条件：' + lean.falsifier_en + (' · 截止：' + lean.check_by if lean.get('check_by') else '')) }}
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% if not record_panel.get('open_leans') and not record_panel.get('calibration_note_en') %}
  <p class="muted sm">{{ t('No graded calls yet.', '暂无已评分判断。') }}</p>
  {% endif %}
</div>
{% endif %}

{# ── Panel D: Overnight deliberation (client-side, aibrief.js) ───────────────── #}
<div class="panel" id="cortex-panel">
  <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
    <h2 style="margin:0">{{ t('Overnight deliberation', '隔夜AI复盘') }}</h2>
    {{ help(
      'The overnight AI reviewer reads the dashboards with a set of read-only tools. This is AI-generated deliberation — labelled as such. When unavailable, it shows an explicit absence note rather than invented conclusions.',
      '隔夜 AI 审阅者使用一组只读工具读取看板内容。这是 AI 生成的审议结果，已明确标注。不可用时明确说明缺失，不编造结论。'
    ) }}
  </div>
  <div id="cortex-body"></div>
</div>

</details>

<div class="panel">
  <p class="muted" style="font-size:12px;margin:0">{{ t('AI research context, not investment advice — generated by an LLM from the available source data and the dashboards\' own outputs.', 'AI 研究背景，非投资建议 — 由大模型根据可用源数据及各看板自身输出生成。') }}
    {% if as_of %} · {{ t('Page built', '页面生成于') }} {{ as_of }}{% endif %}</p>
</div>

</main>
<script src="theme.js"></script>
<script src="aibrief.js"></script>

<footer class="site-footer">
  <span class="made">© 2026 Mastermind Inc</span>
</footer>
</body>
</html>

{% endautoescape %}
