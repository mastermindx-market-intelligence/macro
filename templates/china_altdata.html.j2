{% extends "report_base.html.j2" %}
{% block foot_social %}{% endblock %}
{% block base_css %}/* Presentation lives in china-altdata-desk.css. */{% endblock %}
{% macro b(en,zh='') -%}<span class="l-en">{{ en|e }}</span><span class="l-zh">{{ (zh or en)|e }}</span>{%- endmacro %}
{% macro val(v,signed=false) -%}{% if v is number %}{{ ('%+.2f' if signed else '%.2f')|format(v) }}{% else %}—{% endif %}{%- endmacro %}
{% macro side(s) -%}{{ b({'constructive':'Constructive','cautionary':'Cautionary','mixed':'Mixed','insufficient':'Insufficient'}.get(s,'Unavailable'),{'constructive':'偏积极','cautionary':'偏谨慎','mixed':'混合','insufficient':'不足'}.get(s,'不可用')) }}{%- endmacro %}
{% macro status(s) -%}{{ b({'current':'Available at observation','partial':'Partial coverage','delayed':'Older observation','unavailable':'Unavailable','observed':'Dated','undated':'Date not supplied','future':'Future date — check source'}.get(s,'Unknown'),{'current':'该观察日期可用','partial':'覆盖不完整','delayed':'较早观察','unavailable':'不可用','observed':'已注明日期','undated':'未提供日期','future':'未来日期 — 请核对'}.get(s,'未知')) }}{%- endmacro %}
{% macro opt(v,en,zh) -%}<option value="{{ v }}" data-en="{{ en|e }}" data-zh="{{ zh|e }}">{{ en|e }}</option>{%- endmacro %}
{% macro company(r) -%}
<tr><td>{% if r.href %}<a class="ced-company" href="{{ r.href|e }}">{{ b(r.name,r.name_zh) }}</a>{% else %}<span class="ced-company">{{ b(r.name,r.name_zh) }}</span>{% endif %}<span class="ced-ticker">{{ r.ticker|e }}</span></td>
<td><span class="ced-mobile-label">{{ b('Evidence','证据') }}</span><span class="{{ 'ced-positive' if r.side=='constructive' else 'ced-negative' if r.side=='cautionary' else 'ced-muted' }}">{{ side(r.side) }}</span><br><small>{% if r.agreeing is not none %}{{ b(r.agreeing|string ~ ' support · ' ~ r.conflicting|string ~ ' conflict',r.agreeing|string ~ '项支持 · ' ~ r.conflicting|string ~ '项冲突') }}{% else %}{{ b(r.constructive|string ~ ' positive · ' ~ r.cautionary|string ~ ' negative',r.constructive|string ~ '项积极 · ' ~ r.cautionary|string ~ '项谨慎') }}{% endif %}</small></td>
<td><span class="ced-mobile-label">{{ b('Coverage','覆盖') }}</span><b>{{ r.available }}/7</b><div class="ced-source-dots" aria-hidden="true">{% for s in r.sources %}<span class="{{ s.direction|e }}"></span>{% endfor %}</div><small>{{ b('available inputs','项输入可用') }}</small></td>
<td><span class="ced-mobile-label">{{ b('Research notes','研究提示') }}</span>{% for f in r.flags[:2] %}<span class="ced-badge ced-warning">{{ b(f.label_en,f.label_zh) }}</span>{% else %}<small>{{ b('No supplied flags','未提供标记') }}</small>{% endfor %}<br>{% if r.href %}<a class="ced-evidence-button" href="{{ r.href|e }}">{{ b('Open company →','查看公司 →') }}</a>{% endif %}</td></tr>
{%- endmacro %}
{% macro event(e) -%}<article class="ced-event"><div class="ced-event-date">{{ e.date or b('Date not supplied','未提供日期') }}<small>{{ b({'upcoming':'Upcoming','recent':'Recent','undated':'Undated','archive':'Earlier'}.get(e.horizon,''),{'upcoming':'即将发生','recent':'近期','undated':'无日期','archive':'较早'}.get(e.horizon,'')) }}</small></div><div><h3>{% if e.href %}<a href="{{ e.href|e }}">{{ e.name|e }}</a>{% else %}{{ e.name|e }}{% endif %} <small>{{ e.ticker|e }}</small></h3><span class="ced-badge">{{ b(e.label_en,e.label_zh) }}</span><p>{{ b(e.detail_en,e.detail_zh) }}</p><small>{{ b('Source snapshot: ','数据快照：') }}{{ e.observed_at or b('unknown','未知') }}</small><details><summary>{{ b('Disclosure details','披露详情') }}</summary>{% if e.disclosure_title %}<p>{{ e.disclosure_title|e }}</p>{% endif %}{% if e.reported_metric %}<p>{{ b('Reported metric: ','披露指标：') }}{{ e.reported_metric|e }}</p>{% endif %}{% if e.reported_period %}<p>{{ b('Reporting period: ','报告期：') }}{{ e.reported_period|e }}</p>{% endif %}{% if e.stage %}<p>{{ b('Reported stage: ','披露阶段：') }}{{ e.stage|e }}</p>{% endif %}{% if e.reported_change is not none %}<p>{{ b('Reported change: ','披露变动：') }}{{ val(e.reported_change,true) }}% · {{ b('Check metric, period and comparison base in the filing.','请在公告核对指标、报告期与比较基数。') }}</p>{% endif %}{% if e.filing_href %}<a href="{{ e.filing_href|e }}" target="_blank" rel="noopener noreferrer">{{ b('Open source filing ↗','查看原始公告 ↗') }}</a>{% else %}<p>{{ b('No filing link supplied by this feed. Check the original disclosure before relying on the record.','本数据未提供公告链接；使用此记录前请核对原始披露。') }}</p>{% endif %}</details></div></article>{%- endmacro %}
{% block title %}China Evidence Desk — Alternative Data | Mastermind{% endblock %}
{% block head_extra %}
{% set seo_title="China Evidence Desk — Alternative Data | Mastermind" %}{% set seo_desc="Explore dated China market participation, company evidence, source coverage and disclosed events. Search the eligible A-share research universe and inspect conflicting inputs." %}{% set seo_path="china_altdata.html" %}{% include "_seo_head.html.j2" %}
<link rel="stylesheet" href="navigation-refresh.css">
<link rel="stylesheet" href="china-altdata-desk.css">
{% endblock %}
{% block body_scripts %}<script src="china-altdata-desk.js" defer></script>{% endblock %}
{% block content %}
{% set desk=desk if desk is defined else {'schema':'china_altdata.desk.v1','generated_at':none,'data_health':{'state':'unavailable','available':0,'expected':6},'participation':{'metrics':[],'trend':[]},'universe':{'total':0,'counts':{}},'rows':[],'sources':[],'events':[],'briefing':[]} %}
{% set p=desk.participation %}{% set health=desk.data_health %}
<main class="ced" id="china-evidence-desk" data-schema="china_altdata.desk.v1">
<section class="ced-hero ced-surface" aria-labelledby="ced-title">
<div class="ced-hero-top"><div><p class="ced-eyebrow">{{ b('Alternative data / China','另类数据 / 中国') }}</p><h1 id="ced-title">{{ b('China Evidence Desk','中国市场证据台') }}</h1><p class="ced-dek">{{ b('Read the market. Investigate a company. See the evidence and what is missing.','解读市场，研究公司，查看证据与缺口。') }}</p></div><div class="ced-stamp">{{ b('Market observation','市场观察日期') }}<time>{{ desk.observation_date or '—' }}</time>{{ b('Build','构建') }} {{ (desk.generated_at or '')[:16]|e }} UTC</div></div>
<div class="ced-actions"><a class="ced-primary" href="#companies">{{ b('Explore companies','研究公司') }} ↗</a><a class="ced-secondary" href="#catalysts">{{ b('View event calendar','查看事件日历') }} →</a></div>
<dl class="ced-status-grid"><div><dt>{{ b('Participation','市场参与度') }}</dt><dd>{{ b(p.regime_en|default('Unavailable'),p.regime_zh|default('不可用')) }}</dd></div><div><dt>{{ b('Company evidence','公司证据') }}</dt><dd>{{ desk.universe.total }} {{ b('eligible names','只合资格公司') }}</dd></div><div><dt>{{ b('Data health','数据状态') }}</dt><dd>{{ status(health.state) }}<br><small>{{ health.available }}/{{ health.expected }} {{ b('market readings','项市场读数') }}</small></dd></div><div><dt>{{ b('Validation','验证状态') }}</dt><dd>{{ b('Context only','仅供研究参考') }}<br><small>{{ b('No validated forecast','非已验证预测') }}</small></dd></div></dl>
</section>
<div class="ced-briefing">{% for item in desk.briefing %}<article class="ced-brief ced-surface"><h3>{{ b(item.title_en,item.title_zh) }}</h3><p>{{ b(item.detail_en,item.detail_zh) }}</p><a href="{{ item.href|e }}">{{ b('Inspect evidence','查看依据') }} →</a></article>{% endfor %}</div>
<nav class="ced-jump" aria-label="On this page"><a href="#participation">{{ b('01 Market read','01 市场读数') }}</a><a href="#companies">{{ b('02 Companies','02 公司') }}</a><a href="#catalysts">{{ b('03 Events','03 事件') }}</a><a href="#sources">{{ b('04 Sources','04 数据来源') }}</a><a href="#research">{{ b('05 Further research','05 深入研究') }}</a></nav>

<section id="participation" class="ced-section" aria-labelledby="ced-market-label">
<div class="ced-section-head"><div><p class="ced-index">01 / {{ b('MARKET READ','市场读数') }}</p><h2 id="ced-market-label">{{ b('What is the tape saying?','市场数据说明什么？') }}</h2><p>{{ b('The observation date belongs to the data. The build time belongs to this page.','观察日期属于数据；构建时间属于本页面。') }}</p></div></div>
<div class="ced-participation ced-surface"><div class="ced-market-head"><div><p class="ced-market-title">{{ b(p.headline_en|default('Market read unavailable'),p.headline_zh|default('市场读数不可用')) }}</p><p>{{ b(p.detail_en|default(''),p.detail_zh|default('')) }}</p></div><span class="ced-badge">{{ status(health.state) }}</span></div>
<div class="ced-health-note">{{ b('Selected observation: ','所选观察日期：') }}<b>{{ desk.observation_date or '—' }}</b>. {% if health.latest_date and health.latest_date!=desk.observation_date %}{{ b('Newer partial session: ','较新但不完整的交易日：') }}<b>{{ health.latest_date }}</b>. {{ b('Calendar gap: ','日历间隔：') }}{{ health.lag_calendar_days }} {{ b('days. This is not a trading-session delay estimate.','天；不等于交易日延迟。') }}{% endif %} {{ b(health.summary_en|default(''),health.summary_zh|default('')) }}{% if p.projection_kind!='current_source_recomputation' %}<br>{{ b('Archival fallback — the current source recomputation is unavailable.','历史存档回退 — 当前来源重算不可用。') }}{% endif %}</div>
<div class="ced-metrics">{% for metric in p.metrics %}<article class="ced-metric"><h3>{{ b(metric.label_en,metric.label_zh) }}</h3><div class="ced-metric-value">{{ val(metric.value,metric.key in ['turnover_z20','margin_chg_5d','qvix_z','broker_rs','southbound_net']) }}</div><span class="ced-metric-unit">{{ b(metric.unit_en,metric.unit_zh) }}</span><small>{{ metric.asof or b('Unavailable','不可用') }}</small><p class="ced-metric-change">{% if metric.change is not none %}Δ {{ val(metric.change,true) }} {{ b(metric.change_unit_en,metric.change_unit_zh) }} {{ b('vs ','较') }}{{ metric.comparison_date }}{% else %}{{ b('Prior comparison unavailable','无可比的上一期读数') }}{% endif %}</p><details><summary>{{ b('How to read','如何解读') }}</summary><p>{{ b(metric.explanation_en,metric.explanation_zh) }}{% if metric.key=='zt_breadth' and p.observed_universe %} {{ b('Observed names: ','观测股票数：') }}{{ p.observed_universe|int }}.{% endif %}</p></details></article>{% endfor %}</div>
<div id="ced-trend" class="ced-trend" hidden><h3>{{ b('Trading intensity through time','成交强度变化') }}</h3><svg role="img" aria-label="Trading intensity, relative to the 20-session average" viewBox="0 0 900 100" preserveAspectRatio="none"></svg><div class="ced-trend-footer"><span id="ced-trend-start"></span><span>{{ b('Dashed line = 20-session average','虚线 = 20日均值') }}</span><span id="ced-trend-end"></span></div></div>
<p class="ced-footnote">{{ b('Current source recomputation is descriptive and may incorporate later corrections. It is not a point-in-time backtest. The original historical archive is preserved.','当前来源重算用于描述，可能包含后续修订，不是时点回测；原始历史存档保持不变。') }}</p></div>
</section>

<section id="companies" class="ced-section" aria-labelledby="ced-company-label">
<div class="ced-section-head"><div><p class="ced-index">02 / {{ b('COMPANY RESEARCH','公司研究') }}</p><h2 id="ced-company-label">{{ b('Find a name. Examine the evidence.','找到公司，检查证据。') }}</h2><p>{{ b(desk.universe.scope_en|default(''),desk.universe.scope_zh|default('')) }} {{ b('Availability, agreement and validation are different things.','可用性、一致性与验证是不同概念。') }}</p></div></div>
<div class="ced-board ced-surface">
<fieldset id="ced-controls" disabled data-js-only><legend class="ced-sr">{{ b('Company filters','公司筛选') }}</legend><div class="ced-controls">
<div class="ced-control-search"><label for="ced-search">{{ b('Company or ticker','公司或代码') }}</label><input id="ced-search" type="search" autocomplete="off" placeholder="600519 · 贵州茅台" maxlength="100"></div>
<div><label for="ced-side">{{ b('Evidence direction','证据方向') }}</label><select id="ced-side">{{ opt('all','All directions','全部方向') }}{{ opt('constructive','Constructive','偏积极') }}{{ opt('cautionary','Cautionary','偏谨慎') }}{{ opt('mixed','Mixed','混合') }}</select></div>
<div><label for="ced-coverage">{{ b('Minimum coverage','最低覆盖') }}</label><select id="ced-coverage">{{ opt('2','2+ inputs','2项以上') }}{{ opt('3','3+ inputs','3项以上') }}{{ opt('5','5+ inputs','5项以上') }}{{ opt('7','All 7 inputs','全部7项') }}</select></div>
<div><label for="ced-sort">{{ b('Sort by','排序') }}</label><select id="ced-sort">{{ opt('alignment','Alignment ↓','一致方向 ↓') }}{{ opt('coverage','Coverage ↓','覆盖 ↓') }}{{ opt('conflict','Conflict ↓','冲突 ↓') }}{{ opt('ticker','Ticker A–Z','代码 A–Z') }}</select></div></div>
<div class="ced-tools"><label><input id="ced-flagged" type="checkbox">{{ b('Show flagged names only','仅显示有标记的公司') }}</label><button id="ced-reset" type="button">{{ b('Reset filters','重置筛选') }}</button></div></fieldset>
<div class="ced-tools"><p id="ced-results" class="ced-result" role="status" aria-live="polite">{{ b('Preview of ' ~ desk.rows|length|string ~ ' eligible companies','预览合资格公司，共' ~ desk.rows|length|string ~ '只') }}</p><button id="ced-load" type="button" data-js-only>{{ b('Load full universe','载入完整范围') }}</button></div>
<p id="ced-load-error" class="ced-health-note" role="alert" hidden></p>
<div class="ced-table-wrap"><table class="ced-company-table"><caption class="ced-sr">{{ b('Company evidence board','公司证据列表') }}</caption><thead><tr><th scope="col">{{ b('Company','公司') }}</th><th scope="col">{{ b('Signed evidence','有符号证据') }}</th><th scope="col">{{ b('Coverage','覆盖') }}</th><th scope="col">{{ b('Research notes','研究提示') }}</th></tr></thead><tbody id="ced-rows">{% for row in desk.rows[:8] %}{{ company(row) }}{% endfor %}</tbody></table></div>
<p id="ced-no-results" class="ced-empty" {% if desk.rows %}hidden{% endif %}>{{ b('No eligible company rows are available. Check source coverage below.','暂无合资格公司数据，请查看下方来源覆盖。') }}</p>
<div class="ced-pager" data-js-only><button type="button" id="ced-prev" disabled>{{ b('Previous','上一页') }}</button><span id="ced-page"></span><button type="button" id="ced-next" disabled>{{ b('Next','下一页') }}</button></div>
<noscript><p class="ced-footnote">{{ b('JavaScript is off. This preview shows up to eight names; company links still work. Enable JavaScript to search and filter the full eligible universe.','JavaScript已关闭。预览最多显示8家公司，公司链接仍可使用；启用后可搜索和筛选全部合资格公司。') }}</p></noscript>
<p class="ced-footnote">{{ b('Constructive / cautionary describe signed contributions under existing weights. They are research context, not buy / sell recommendations. A missing input is never treated as zero.','积极／谨慎描述现有权重下的有符号贡献，仅作研究背景，并非买卖建议；缺失输入不视为零。') }}</p></div></section>

<section id="catalysts" class="ced-section" aria-labelledby="ced-event-label">
<div class="ced-section-head"><div><p class="ced-index">03 / {{ b('DISCLOSED EVENTS','已披露事件') }}</p><h2 id="ced-event-label">{{ b('Put the next event in context','理解下一项事件') }}</h2><p>{{ b('Dates, disclosure types and execution stages from the available feed. An undated record is never presented as an upcoming event.','展示现有数据中的日期、披露类型与执行阶段；无日期记录不会被当作未来事件。') }}</p></div></div>
<div class="ced-board ced-surface">
{% set eh=desk.event_health|default({}) %}
{% if eh and eh.all_fresh is sameas false %}<div class="ced-health-note">{{ b(eh.n_fresh|string ~ ' of ' ~ eh.n_planes|string ~ ' event sources up to date.',eh.n_planes|string ~ '项事件来源中有' ~ eh.n_fresh|string ~ '项已更新。') }} {% for s in eh.stale_labels %}<span class="ced-badge ced-warning">{{ b(s.en,s.zh) }}</span>{% endfor %}{% if eh.oldest_stale_asof %} {{ b('Oldest lagging source: ','最早滞后来源：') }}{{ eh.oldest_stale_asof }}{% endif %}{% if eh.n_unreadable %} · {{ eh.n_unreadable }} {{ b('unreadable sources','项来源无法读取') }}{% endif %}</div>{% endif %}
<fieldset id="ced-event-filters" disabled data-js-only><legend class="ced-sr">{{ b('Event filters','事件筛选') }}</legend><div class="ced-event-controls">
<div><label for="ced-horizon">{{ b('Time horizon','时间范围') }}</label><select id="ced-horizon">{{ opt('all','All available records','全部现有记录') }}{{ opt('upcoming','Upcoming','未来') }}{{ opt('recent','Recent 30 days','近30天') }}{{ opt('undated','Date not supplied','未提供日期') }}{{ opt('archive','Earlier records','较早记录') }}</select></div>
<div><label for="ced-event-type">{{ b('Event type','事件类型') }}</label><select id="ced-event-type">{{ opt('all','All types','全部类型') }}{{ opt('unlock','Share unlocks','限售解禁') }}{{ opt('inquiry','Exchange inquiries','交易所问询') }}{{ opt('buyback','Buybacks','回购') }}{{ opt('earnings','Earnings outlook','业绩预告') }}{{ opt('pledge','Pledges','质押') }}{{ opt('st','Special treatment','特别处理') }}</select></div></div></fieldset>
<p class="ced-result" id="ced-event-results" role="status" aria-live="polite">{{ desk.events|length }} {{ b('available records','条现有记录') }}</p>
<div id="ced-events">{% for e in desk.events[:8] %}{{ event(e) }}{% else %}<p class="ced-empty">{{ b('No event feed is available for this build. This does not mean there are no market events.','本次构建无事件数据，不代表市场没有事件。') }}</p>{% endfor %}</div>
<div class="ced-pager" data-js-only><button type="button" id="ced-event-prev" disabled>{{ b('Previous','上一页') }}</button><span id="ced-event-page"></span><button type="button" id="ced-event-next" disabled>{{ b('Next','下一页') }}</button></div></div></section>

<section id="sources" class="ced-section" aria-labelledby="ced-source-label">
<div class="ced-section-head"><div><p class="ced-index">04 / {{ b('SOURCE COVERAGE','来源覆盖') }}</p><h2 id="ced-source-label">{{ b('Know what is behind each reading','了解每项读数的来源') }}</h2><p>{{ b('Coverage counts are for the eligible company universe. Source snapshots and observation dates are distinguished. A date range shows differing company vintages; build time is never substituted.','覆盖数量针对合资格公司范围；分别列示来源快照与观察日期；日期范围表示各公司数据时点不同，构建时间不会替代来源日期。') }}</p></div></div>
<div class="ced-sources ced-surface"><div class="ced-table-wrap"><table><thead><tr><th>{{ b('Source / interpretation','来源 / 解读') }}</th><th>{{ b('Covered names','覆盖公司') }}</th><th>{{ b('Source date','来源日期') }}</th><th>{{ b('Signed weight','有符号权重') }}</th></tr></thead><tbody>
{% for s in desk.sources %}<tr><td><b>{{ b(s.label_en,s.label_zh) }}</b><p>{{ b(s.description_en,s.description_zh) }}</p></td><td>{{ s.available }} / {{ desk.universe.total }}</td><td>{% if s.oldest_asof and s.oldest_asof != s.asof %}{{ s.oldest_asof }} – {% endif %}{{ s.asof or '—' }}<p>{% if s.date_kind == 'observation' %}{{ b('Observation dates','观察日期') }}{% elif s.date_kind == 'snapshot' %}{{ b('Source snapshots','来源快照') }}{% else %}{{ status(s.state) }}{% endif %} · {{ s.dated }}/{{ s.available }} {{ b('dated','有日期') }}</p></td><td>{{ val(s.weight,true) }}</td></tr>{% endfor %}
</tbody></table></div><p class="ced-footnote">{{ b('Company values are centered cross-sectional ranks from −1 to +1, not raw currency or percentages. Weighted alignment is a display composite, not a probability. Sources may overlap and are not assumed independent.','公司数值是−1至+1的横截面中心化排名，不是原始金额或百分比；加权一致方向为展示组合，不是概率；来源可能重叠，不假设相互独立。') }}</p></div></section>

<section id="research" class="ced-section" aria-labelledby="ced-research-label">
<div class="ced-section-head"><div><p class="ced-index">05 / {{ b('FURTHER RESEARCH','深入研究') }}</p><h2 id="ced-research-label">{{ b('Explore the wider picture','查看更完整的背景') }}</h2><p>{{ b('Supporting context, with methods and limits kept close to the evidence.','补充背景，方法与局限随证据一起展示。') }}</p></div></div>
<div class="ced-secondary-grid">
<details class="ced-disclosure ced-surface" id="limitup"><summary>{{ b('Limit-up activity','涨停活动') }}</summary><p>{{ b('A provider snapshot of limit-up activity; empty coverage is not proof of no activity.','供应商涨停活动快照；覆盖为空并不证明没有活动。') }}</p>{% if zt %}<table><thead><tr><th>{{ b('Company','公司') }}</th><th>{{ b('Consecutive boards','连续涨停') }}</th><th>{{ b('Seal size · CNY 100m','封单 · 亿元') }}</th></tr></thead><tbody>{% for r in zt[:8] %}<tr><td>{{ r.name|e }} <small>{{ r.ticker|e }}</small></td><td>{{ r.consec_boards }}</td><td>{{ val(r.seal_fund_yi) }}</td></tr>{% endfor %}</tbody></table>{% else %}<p>{{ b('No source snapshot available.','暂无来源快照。') }}</p>{% endif %}<a href="china.html">{{ b('Open the China market desk','打开中国市场台') }} →</a></details>
<details class="ced-disclosure ced-surface" id="baskets"><summary>{{ b('Narrative rotation','题材轮动') }}</summary><p>{{ b('Concept baskets ranked by three-month return. Momentum is descriptive, not a forecast.','概念板块按三个月收益排序，动量仅作描述，不是预测。') }} {{ narr_asof or '' }}</p>{% if narr %}<table><thead><tr><th>{{ b('Basket','板块') }}</th><th>{{ b('3-month return','3个月收益') }}</th></tr></thead><tbody>{% for r in narr[:8] %}<tr><td>{{ b(r.name,r.name_zh) }}</td><td>{{ val(r.ret_63d,true) }}%</td></tr>{% endfor %}</tbody></table>{% else %}<p>{{ b('No basket snapshot available.','暂无板块快照。') }}</p>{% endif %}<a href="china_narrative_radar.html">{{ b('Open the narrative radar','打开题材雷达') }} →</a></details>
<details class="ced-disclosure ced-surface" id="sellside"><summary>{{ b('Sell-side context','卖方背景') }}</summary><p>{{ b('Broker recommendation counts reflect opinion and coverage, not a validated expected return.','券商推荐次数反映观点与覆盖，不是经验证的预期收益。') }}</p>{% if broker_gold %}<table><thead><tr><th>{{ b('Company','公司') }}</th><th>{{ b('Brokers','券商数') }}</th><th>{{ b('Month','月份') }}</th></tr></thead><tbody>{% for r in broker_gold[:8] %}<tr><td>{{ r.name|e }}</td><td>{{ r.n_brokers }}</td><td>{{ r.month|e }}</td></tr>{% endfor %}</tbody></table>{% else %}<p>{{ b('No broker list available.','暂无券商名单。') }}</p>{% endif %}</details>
<details class="ced-disclosure ced-surface" id="lab"><summary>{{ b('Signal Lab & methodology','信号实验室与方法') }}</summary><p>{{ b('The wider China engine assigns validation tiers to individual signals. Those tiers do not validate this desk or turn company alignment into a trading signal.','中国引擎为各项信号划分验证层级；这些层级并不验证本页面，也不会把公司一致方向转化为交易信号。') }}</p>{% if lab %}{% for tier,items in lab.tiers.items() %}<details><summary>{{ b(tier|capitalize,{'scored':'已评分','confirmer':'确认器','display':'展示','pending':'待验证','killed':'已停用'}.get(tier,tier)) }} · {{ items|length }}</summary><ul>{% for r in items %}<li><b>{{ b(r.name_en,r.name_zh) }}</b><br>{{ b(r.note_en,r.note_zh) }}</li>{% endfor %}</ul></details>{% endfor %}{% else %}<p>{{ b('The validation ledger is unavailable in this build.','本次构建无验证台账。') }}</p>{% endif %}</details>
</div></section>
<p class="ced-footnote">{{ b('Research context only. Check the underlying disclosure and its observation period before drawing a conclusion. Northbound daily flow is not used as a live input. Southbound means mainland-to-Hong-Kong trading.','仅供研究参考。形成结论前，请核对原始披露及其观察期；北向每日资金流不作为实时输入；南向指内地至香港交易。') }}</p>
<dialog id="ced-detail" aria-labelledby="ced-detail-title"><div class="ced-dialog-head"><div><p class="ced-eyebrow">{{ b('COMPANY EVIDENCE','公司证据') }}</p><h2 id="ced-detail-title"></h2><span id="ced-detail-code" class="ced-muted"></span></div><form method="dialog"><button aria-label="Close" id="ced-detail-close">×</button></form></div><div class="ced-dialog-body" id="ced-detail-body"></div></dialog>
<script id="ced-preview" type="application/json">{{ {'schema':desk.schema,'generated_at':desk.generated_at,'rows':desk.rows[:8],'sources':desk.sources,'events':desk.events,'participation':desk.participation}|tojson }}</script>
</main>
{% endblock %}
