  "examples_script": "from pathlib import Path\nimport json\nimport numpy as np\nimport pandas as pd\nfrom engine import short_volume as sv\nfrom engine import stock_fundamentals as sf\ndef panel(n=20):\n    return pd.DataFrame({\"date\":pd.bdate_range(\"2026-10-01\",periods=n),\"ticker\":[\"AAA\"]*n,\"short_vol\":[50.0]*n,\"total_vol\":[100.0]*n,\"short_ratio\":[0.5]*n})\ncases={}\nfor name in [\"missing_numerators\",\"missing_totals\",\"all_missing\",\"invalid_infinite_total\",\"old_invalid_pair\",\"invalid_stored_ratio\",\"genuine_zero\",\"rounded_positive\",\"optional_latest_absent\",\"healthy\"]:\n    p=panel(25 if name==\"old_invalid_pair\" else 20)\n    if name==\"missing_numerators\":p.loc[16:19,\"short_vol\"]=np.nan\n    elif name==\"missing_totals\":p.loc[16:19,\"total_vol\"]=np.nan\n    elif name==\"all_missing\":p[\"short_vol\"]=np.nan\n    elif name==\"invalid_infinite_total\":p.loc[19,\"total_vol\"]=np.inf\n    elif name==\"old_invalid_pair\":p.loc[0,\"short_vol\"]=-1\n    elif name==\"invalid_stored_ratio\":p.loc[19,\"short_ratio\"]=0.8\n    elif name==\"genuine_zero\":p[[\"short_vol\",\"short_ratio\"]]=0.0\n    elif name==\"rounded_positive\":p[\"short_vol\"],p[\"total_vol\"],p[\"short_ratio\"]=1.0,1e8,0.0\n    elif name==\"optional_latest_absent\":p.loc[19,[\"short_vol\",\"short_ratio\"]]=[70,np.nan]\n    sig=sv.signal_map(p)[\"AAA\"]\n    cases[name]={\"signal\":sig,\"state\":sv.ticker_state(sig),\"positioning\":sf._positioning(\"AAA\",{},None,None,sig)}\nroot=Path.cwd().resolve()\n(root.parent/(root.name+\"-examples.json\")).write_text(json.dumps(cases,indent=2,sort_keys=True,allow_nan=False)+\"\\n\")\nprint(json.dumps({\"source\":root.name,\"examples\":len(cases)}))\n",
