{
  "audit_script": "from pathlib import Path\nimport collections,hashlib,json,time\nimport numpy as np\nimport pandas as pd\nfrom engine import short_volume as sv\nfrom engine import stock_fundamentals as sf\nfrom lib import config\nroot=Path.cwd().resolve()\nconfig.data_dir=lambda:root/\"data\"\nstarted=time.monotonic()\nraw=pd.read_parquet(config.data_dir()/\"finra_short_volume/panel.parquet\")\npanel,state=sv.panel_state()\nassert state==sv.OBSERVED and panel is not None\ndirect=sv.signal_map(panel)\nloaded=sf._load_short_volume()\nassert direct and direct==loaded,\"catch-all reader hid an error or changed the map\"\npositioning={ticker:sf._positioning(ticker,{},None,None,sig) for ticker,sig in loaded.items()}\nout=root.parent/(root.name+\"-audit\")\nout.mkdir()\nfor name,value in [(\"signals\",direct),(\"positioning\",positioning)]:\n    (out/(name+\".json\")).write_text(json.dumps(value,sort_keys=True,allow_nan=False)+\"\\n\")\ns=pd.to_numeric(raw.short_vol,errors=\"coerce\").to_numpy(dtype=float)\nt=pd.to_numeric(raw.total_vol,errors=\"coerce\").to_numpy(dtype=float)\nbad=(~np.isfinite(s)|~np.isfinite(t)|(s<0)|(t<=0)|(s>t))\nsummary={\"source\":root.name,\"input_rows\":len(raw),\"input_tickers\":int(raw.ticker.nunique()),\"input_start\":str(raw.date.min()),\"input_end\":str(raw.date.max()),\"input_bad_pairs\":int(bad.sum()),\"signals\":len(direct),\"positioning\":len(positioning),\"states\":dict(collections.Counter(sv.ticker_state(x) for x in direct.values())),\"coverage_signals\":sum(bool(x.get(\"coverage\")) for x in direct.values()),\"seconds\":round(time.monotonic()-started,3),\"strict_json\":True,\"actual_reader_matches_direct\":True,\"hashes\":{}}\nfor name in [\"signals\",\"positioning\"]:\n    summary[\"hashes\"][name]=hashlib.sha256((out/(name+\".json\")).read_bytes()).hexdigest()\n(out/\"summary.json\").write_text(json.dumps(summary,indent=2)+\"\\n\")\nprint(json.dumps(summary),flush=True)\n",
